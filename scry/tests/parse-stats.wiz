-- test: run
import Scry.Cli
-- The small corpus: three JSON fact stores (a call, a loop, a broken function) and one
-- native scry-cst spill of the first. `parse --stats` reads the format from the first
-- line, so the JSON and native paths print the same shape; the last line is the total.
def main : IO Unit := Scry.mainArgs ["parse", "--stats",
  "corpus/hello.facts.json", "corpus/loop.facts.json", "corpus/broken.facts.json",
  "corpus/hello.cst"]
