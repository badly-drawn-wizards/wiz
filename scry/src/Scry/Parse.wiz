import Scry.Facts
/-!
# Scry.Parse: the `scry parse --stats` stub

S1 parses source with tree-sitter through one C shim (`native/ts_shim.c`): the shim walks
the tree with a `TSTreeCursor` and appends rows to the CST columns, returning a
`foreign_type` store; no `TSNode` crosses into Wiz (design §4.1, and the
`uint32_t[4]`-field gap in §2). None of that exists yet. In the skeleton `parse` reads a
hand-written (or synthetic) fact store and prints the same stats `facts` does, so the
command, its key and the CI shape are already there.

What S1 replaces, in this module:

* `Scry.parseSource` gets a real implementation (grammar handle + bytes → `Scry.Facts`),
  with the native columns converted through `Scry.Facts.ofNative`;
* `--stats` counts what the shim walked (nodes, kinds, errors, bytes) and may time the
  parse (the perf agent measures it: no timing claims here);
* the source file's bytes and the CST spans come from the shim, not from JSON.
-/

/-- What the stub says it did: the banner of `scry parse --stats`. -/
def Scry.parseBanner : String :=
  "parse: synthetic facts store (tree-sitter shim not built: S1)\n"
  ++ "note: no source file was parsed; --stats reads the store's columns\n"

/-- The report `scry parse --stats` prints: the banner, then the store's stats. -/
def Scry.renderParseStats (f : Scry.Facts) : String :=
  Scry.parseBanner ++ Scry.renderFacts f

/-- The S1 entry point, stubbed: parsing `path` as `lang` needs the tree-sitter shim. -/
def Scry.parseSource (lang : String) (path : String) : Except String Scry.Facts :=
  .error ("parse " ++ path ++ " (" ++ lang ++ "): the tree-sitter shim is not built "
    ++ "(S1; pass a facts file instead)")
