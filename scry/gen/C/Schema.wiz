  | .sized_type_specifier => [
      C.FieldSpec.mk C.Field.type .false .false [C.Kind.primitive_type, C.Kind.type_identifier]
    ]
  | .sizeof_expression => [
      C.FieldSpec.mk C.Field.type .false .false [C.Kind.type_descriptor],
      C.FieldSpec.mk C.Field.value .false .false (List.append [C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false, C.Kind.field_expression] [C.Kind.generic_expression, C.Kind.gnu_asm_expression, C.Kind.identifier])
    ]
  | .storage_class_specifier => .nil
  | .string_literal => .nil
  | .struct_specifier => [
      C.FieldSpec.mk C.Field.body .false .false [C.Kind.field_declaration_list],
      C.FieldSpec.mk C.Field.name_ .false .false [C.Kind.type_identifier]
    ]
  | .subscript_designator => .nil
  | .subscript_expression => [
      C.FieldSpec.mk C.Field.argument .true .false (List.append [C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false, C.Kind.field_expression] [C.Kind.generic_expression, C.Kind.gnu_asm_expression, C.Kind.identifier]),
      C.FieldSpec.mk C.Field.index .true .false (List.append [C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false, C.Kind.field_expression] [C.Kind.generic_expression, C.Kind.gnu_asm_expression, C.Kind.identifier])
    ]
  | .subscript_range_designator => [
      C.FieldSpec.mk C.Field.end_ .true .false (List.append [C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false, C.Kind.field_expression] [C.Kind.generic_expression, C.Kind.gnu_asm_expression, C.Kind.identifier]),
      C.FieldSpec.mk C.Field.start .true .false (List.append [C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false, C.Kind.field_expression] [C.Kind.generic_expression, C.Kind.gnu_asm_expression, C.Kind.identifier])
    ]
  | .switch_statement => [
      C.FieldSpec.mk C.Field.body .true .false [C.Kind.compound_statement],
      C.FieldSpec.mk C.Field.condition .true .false [C.Kind.parenthesized_expression]
    ]
  | .translation_unit => .nil
  | .type_definition => [
      C.FieldSpec.mk C.Field.declarator .true .true [C.Kind.array_declarator, C.Kind.attributed_declarator, C.Kind.function_declarator, C.Kind.parenthesized_declarator, C.Kind.pointer_declarator, C.Kind.primitive_type, C.Kind.type_identifier],
      C.FieldSpec.mk C.Field.type .true .false [C.Kind.enum_specifier, C.Kind.macro_type_specifier, C.Kind.primitive_type, C.Kind.sized_type_specifier, C.Kind.struct_specifier, C.Kind.type_identifier, C.Kind.union_specifier]
    ]
  | .type_descriptor => [
      C.FieldSpec.mk C.Field.declarator .false .false [C.Kind.abstract_array_declarator, C.Kind.abstract_function_declarator, C.Kind.abstract_parenthesized_declarator, C.Kind.abstract_pointer_declarator],
      C.FieldSpec.mk C.Field.type .true .false [C.Kind.enum_specifier, C.Kind.macro_type_specifier, C.Kind.primitive_type, C.Kind.sized_type_specifier, C.Kind.struct_specifier, C.Kind.type_identifier, C.Kind.union_specifier]
    ]
  | .type_qualifier => .nil
  | .unary_expression => [
      C.FieldSpec.mk C.Field.argument .true .false (List.append [C.Kind.preproc_defined, C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false] [C.Kind.field_expression, C.Kind.generic_expression, C.Kind.gnu_asm_expression, C.Kind.identifier]),
      C.FieldSpec.mk C.Field.operator .true .false .nil
    ]
  | .union_specifier => [
      C.FieldSpec.mk C.Field.body .false .false [C.Kind.field_declaration_list],
      C.FieldSpec.mk C.Field.name_ .false .false [C.Kind.type_identifier]
    ]
  | .update_expression => [
      C.FieldSpec.mk C.Field.argument .true .false (List.append [C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false, C.Kind.field_expression] [C.Kind.generic_expression, C.Kind.gnu_asm_expression, C.Kind.identifier]),
      C.FieldSpec.mk C.Field.operator .true .false .nil
    ]
  | .variadic_parameter => .nil
  | .while_statement => [
      C.FieldSpec.mk C.Field.body .true .false (List.append [C.Kind.attributed_statement, C.Kind.break_statement, C.Kind.case_statement, C.Kind.compound_statement, C.Kind.continue_statement, C.Kind.do_statement, C.Kind.expression_statement, C.Kind.for_statement, C.Kind.goto_statement, C.Kind.if_statement, C.Kind.labeled_statement, C.Kind.return_statement] [C.Kind.seh_leave_statement, C.Kind.seh_try_statement, C.Kind.switch_statement]),
      C.FieldSpec.mk C.Field.condition .true .false [C.Kind.parenthesized_expression]
    ]
  | .character => .nil
  | .comment => .nil
  | .escape_sequence => .nil
  | .false => .nil
  | .field_identifier => .nil
  | .identifier => .nil
  | .ms_restrict_modifier => .nil
  | .ms_signed_ptr_modifier => .nil
  | .ms_unsigned_ptr_modifier => .nil
  | .number_literal => .nil
  | .preproc_arg => .nil
  | .preproc_directive => .nil
  | .primitive_type => .nil
  | .statement_identifier => .nil
  | .string_content => .nil
  | .system_lib_string => .nil
  | .true => .nil
  | .type_identifier => .nil

/-- The first spec of `f` in `specs`, if any. -/
def C.findSpec (f : C.Field) : List C.FieldSpec → Option C.FieldSpec
  | .nil => .none
  | .cons s rest => match C.Field.beq s.field f with
    | .true => .some s
    | .false => C.findSpec f rest

/-- The spec of field `f` on kind `k`, if the grammar has one. -/
def C.fieldSpec (k : C.Kind) (f : C.Field) : Option C.FieldSpec :=
  C.findSpec f (C.fields k)

/-- Whether kind `k` allows field `f` to hold a child of kind `c`. -/
def C.allows (k : C.Kind) (f : C.Field) (c : C.Kind) : Bool := match C.fieldSpec k f with
  | .none => .false
  | .some s => List.any (fun x => C.Kind.beq x c) s.kinds
