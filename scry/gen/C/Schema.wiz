  | start
  | symbol
  | type
  | underlying_type
  | update
  | value

/-- The field's tree-sitter name (`declarator`, `body`, …). -/
def C.Field.name : C.Field → String
  | .alternative => "alternative"
  | .argument => "argument"
  | .arguments => "arguments"
  | .assembly_code => "assembly_code"
  | .body => "body"
  | .clobbers => "clobbers"
  | .condition => "condition"
  | .consequence => "consequence"
  | .constraint => "constraint"
  | .declarator => "declarator"
  | .designator => "designator"
  | .directive => "directive"
  | .end_ => "end"
  | .field => "field"
  | .filter => "filter"
  | .function => "function"
  | .goto_labels => "goto_labels"
  | .index => "index"
  | .initializer => "initializer"
  | .input_operands => "input_operands"
  | .label => "label"
  | .left => "left"
  | .member => "member"
  | .name_ => "name"
  | .operand => "operand"
  | .operator => "operator"
  | .output_operands => "output_operands"
  | .parameters => "parameters"
  | .path => "path"
  | .prefix => "prefix"
  | .register => "register"
  | .right => "right"
  | .size => "size"
  | .start => "start"
  | .symbol => "symbol"
  | .type => "type"
  | .underlying_type => "underlying_type"
  | .update => "update"
  | .value => "value"

/-- The generated field ordinal (`U32`). -/
def C.Field.idx : C.Field → U32
  | .alternative => U32.ofNat 0
  | .argument => U32.ofNat 1
  | .arguments => U32.ofNat 2
  | .assembly_code => U32.ofNat 3
  | .body => U32.ofNat 4
  | .clobbers => U32.ofNat 5
  | .condition => U32.ofNat 6
  | .consequence => U32.ofNat 7
  | .constraint => U32.ofNat 8
  | .declarator => U32.ofNat 9
  | .designator => U32.ofNat 10
  | .directive => U32.ofNat 11
  | .end_ => U32.ofNat 12
  | .field => U32.ofNat 13
  | .filter => U32.ofNat 14
  | .function => U32.ofNat 15
  | .goto_labels => U32.ofNat 16
  | .index => U32.ofNat 17
  | .initializer => U32.ofNat 18
  | .input_operands => U32.ofNat 19
  | .label => U32.ofNat 20
  | .left => U32.ofNat 21
  | .member => U32.ofNat 22
  | .name_ => U32.ofNat 23
  | .operand => U32.ofNat 24
  | .operator => U32.ofNat 25
  | .output_operands => U32.ofNat 26
  | .parameters => U32.ofNat 27
  | .path => U32.ofNat 28
  | .prefix => U32.ofNat 29
  | .register => U32.ofNat 30
  | .right => U32.ofNat 31
  | .size => U32.ofNat 32
  | .start => U32.ofNat 33
  | .symbol => U32.ofNat 34
  | .type => U32.ofNat 35
  | .underlying_type => U32.ofNat 36
  | .update => U32.ofNat 37
  | .value => U32.ofNat 38

/-- The field named `s`, if the grammar has it. -/
def C.Field.ofName (s : String) : Option C.Field :=
if String.eq s "alternative" then .some (C.Field.alternative)
else if String.eq s "argument" then .some (C.Field.argument)
else if String.eq s "arguments" then .some (C.Field.arguments)
else if String.eq s "assembly_code" then .some (C.Field.assembly_code)
else if String.eq s "body" then .some (C.Field.body)
else if String.eq s "clobbers" then .some (C.Field.clobbers)
else if String.eq s "condition" then .some (C.Field.condition)
else if String.eq s "consequence" then .some (C.Field.consequence)
else if String.eq s "constraint" then .some (C.Field.constraint)
else if String.eq s "declarator" then .some (C.Field.declarator)
else if String.eq s "designator" then .some (C.Field.designator)
else if String.eq s "directive" then .some (C.Field.directive)
else if String.eq s "end" then .some (C.Field.end_)
else if String.eq s "field" then .some (C.Field.field)
else if String.eq s "filter" then .some (C.Field.filter)
else if String.eq s "function" then .some (C.Field.function)
else if String.eq s "goto_labels" then .some (C.Field.goto_labels)
else if String.eq s "index" then .some (C.Field.index)
else if String.eq s "initializer" then .some (C.Field.initializer)
else if String.eq s "input_operands" then .some (C.Field.input_operands)
else if String.eq s "label" then .some (C.Field.label)
else if String.eq s "left" then .some (C.Field.left)
else if String.eq s "member" then .some (C.Field.member)
else if String.eq s "name" then .some (C.Field.name_)
else if String.eq s "operand" then .some (C.Field.operand)
else if String.eq s "operator" then .some (C.Field.operator)
else if String.eq s "output_operands" then .some (C.Field.output_operands)
else if String.eq s "parameters" then .some (C.Field.parameters)
else if String.eq s "path" then .some (C.Field.path)
else if String.eq s "prefix" then .some (C.Field.prefix)
else if String.eq s "register" then .some (C.Field.register)
else if String.eq s "right" then .some (C.Field.right)
else if String.eq s "size" then .some (C.Field.size)
else if String.eq s "start" then .some (C.Field.start)
else if String.eq s "symbol" then .some (C.Field.symbol)
else if String.eq s "type" then .some (C.Field.type)
else if String.eq s "underlying_type" then .some (C.Field.underlying_type)
else if String.eq s "update" then .some (C.Field.update)
else if String.eq s "value" then .some (C.Field.value)
else .none


/-- The field with generated ordinal `i`, if any. -/
def C.Field.ofIdx (i : Nat) : Option C.Field := match i with
  | 0 => .some .alternative
  | 1 => .some .argument
  | 2 => .some .arguments
  | 3 => .some .assembly_code
  | 4 => .some .body
  | 5 => .some .clobbers
  | 6 => .some .condition
  | 7 => .some .consequence
  | 8 => .some .constraint
  | 9 => .some .declarator
  | 10 => .some .designator
  | 11 => .some .directive
  | 12 => .some .end_
  | 13 => .some .field
  | 14 => .some .filter
  | 15 => .some .function
  | 16 => .some .goto_labels
  | 17 => .some .index
  | 18 => .some .initializer
  | 19 => .some .input_operands
  | 20 => .some .label
  | 21 => .some .left
  | 22 => .some .member
  | 23 => .some .name_
  | 24 => .some .operand
  | 25 => .some .operator
  | 26 => .some .output_operands
  | 27 => .some .parameters
  | 28 => .some .path
  | 29 => .some .prefix
  | 30 => .some .register
  | 31 => .some .right
  | 32 => .some .size
  | 33 => .some .start
  | 34 => .some .symbol
  | 35 => .some .type
  | 36 => .some .underlying_type
  | 37 => .some .update
  | 38 => .some .value
  | _ => .none

/-- The field with generated ordinal `i`, if any. -/
def C.Field.ofU32 (i : U32) : Option C.Field := C.Field.ofIdx (UIntN.toNat i)

/-- Field equality, by generated ordinal. -/
def C.Field.beq (a b : C.Field) : Bool :=
  Nat.beq (UIntN.toNat (C.Field.idx a)) (UIntN.toNat (C.Field.idx b))

/-- The number of generated fields. -/
def C.fieldCount : Nat := 39

inductive C.Supertype where
  | _abstract_declarator
  | _declarator
  | _field_declarator
  | _type_declarator
  | expression
  | statement
  | type_specifier

/-- The supertype's grammar name. -/
def C.Supertype.name : C.Supertype → String
  | ._abstract_declarator => "_abstract_declarator"
  | ._declarator => "_declarator"
  | ._field_declarator => "_field_declarator"
  | ._type_declarator => "_type_declarator"
  | .expression => "expression"
  | .statement => "statement"
  | .type_specifier => "type_specifier"

/-- Its concrete subtypes (transitively; supertypes are not node kinds). -/
def C.Supertype.subtypes : C.Supertype → List C.Kind
  | ._abstract_declarator => [C.Kind.abstract_array_declarator, C.Kind.abstract_function_declarator, C.Kind.abstract_parenthesized_declarator, C.Kind.abstract_pointer_declarator]
  | ._declarator => [C.Kind.array_declarator, C.Kind.attributed_declarator, C.Kind.function_declarator, C.Kind.identifier, C.Kind.parenthesized_declarator, C.Kind.pointer_declarator]
  | ._field_declarator => [C.Kind.array_declarator, C.Kind.attributed_declarator, C.Kind.field_identifier, C.Kind.function_declarator, C.Kind.parenthesized_declarator, C.Kind.pointer_declarator]
  | ._type_declarator => [C.Kind.array_declarator, C.Kind.attributed_declarator, C.Kind.function_declarator, C.Kind.parenthesized_declarator, C.Kind.pointer_declarator, C.Kind.primitive_type, C.Kind.type_identifier]
  | .expression => (List.append [C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false, C.Kind.field_expression] [C.Kind.generic_expression, C.Kind.gnu_asm_expression, C.Kind.identifier, C.Kind.null])
  | .statement => (List.append [C.Kind.attributed_statement, C.Kind.break_statement, C.Kind.case_statement, C.Kind.compound_statement, C.Kind.continue_statement, C.Kind.do_statement, C.Kind.expression_statement, C.Kind.for_statement, C.Kind.goto_statement, C.Kind.if_statement, C.Kind.labeled_statement, C.Kind.return_statement] [C.Kind.seh_leave_statement, C.Kind.seh_try_statement, C.Kind.switch_statement, C.Kind.while_statement])
  | .type_specifier => [C.Kind.enum_specifier, C.Kind.macro_type_specifier, C.Kind.primitive_type, C.Kind.sized_type_specifier, C.Kind.struct_specifier, C.Kind.type_identifier, C.Kind.union_specifier]

/-- The supertype named `s`, if the grammar has it. -/
def C.Supertype.ofName (s : String) : Option C.Supertype :=
if String.eq s "_abstract_declarator" then .some (C.Supertype._abstract_declarator)
else if String.eq s "_declarator" then .some (C.Supertype._declarator)
else if String.eq s "_field_declarator" then .some (C.Supertype._field_declarator)
else if String.eq s "_type_declarator" then .some (C.Supertype._type_declarator)
else if String.eq s "expression" then .some (C.Supertype.expression)
else if String.eq s "statement" then .some (C.Supertype.statement)
else if String.eq s "type_specifier" then .some (C.Supertype.type_specifier)
else .none


/-- The supertype with generated ordinal `i`, if any. -/
def C.Supertype.ofIdx (i : Nat) : Option C.Supertype := match i with
  | 0 => .some ._abstract_declarator
  | 1 => .some ._declarator
  | 2 => .some ._field_declarator
  | 3 => .some ._type_declarator
  | 4 => .some .expression
  | 5 => .some .statement
  | 6 => .some .type_specifier
  | _ => .none

/-- The number of generated supertypes. -/
def C.supertypeCount : Nat := 7

/-- A typed node id: the row index, with the kind in the type only (22e). -/
structure C.NodeId (k : C.Kind) where
  n : U32

/-- A typed field id: the field label's ordinal, with the field in the type only. -/
structure C.FieldId (f : C.Field) where
  n : U32

/-- A node whose kind is known only at run time (a Σ of kind and row). -/
structure C.AnyNode where
  kind : C.Kind
  id : U32

/-- A typed edge: source kind, field label, target kind. -/
structure C.Edge (src : C.Kind) (f : C.Field) (dst : C.Kind) where
  id : U32

/-- One field of one kind: its label, cardinality and allowed concrete kinds. -/
structure C.FieldSpec where
  field : C.Field
  required : Bool
  multiple : Bool
  kinds : List C.Kind

/-- Every field of a kind, in `node-types.json` order. `ERROR`/`MISSING` may
appear where a spec does not allow: check with `C.allows`. -/
def C.fields : C.Kind → List C.FieldSpec
  | .abstract_array_declarator => [
      C.FieldSpec.mk C.Field.declarator .false .false [C.Kind.abstract_array_declarator, C.Kind.abstract_function_declarator, C.Kind.abstract_parenthesized_declarator, C.Kind.abstract_pointer_declarator],
      C.FieldSpec.mk C.Field.size .false .false (List.append [C.Kind.alignof_expression, C.Kind.assignment_expression, C.Kind.binary_expression, C.Kind.call_expression, C.Kind.cast_expression, C.Kind.char_literal, C.Kind.compound_literal_expression, C.Kind.concatenated_string, C.Kind.conditional_expression, C.Kind.extension_expression, C.Kind.false, C.Kind.field_expression] [C.Kind.generic_expression, C.Kind.gnu_asm_expression])
    ]
  | .abstract_function_declarator => [
      C.FieldSpec.mk C.Field.declarator .false .false [C.Kind.abstract_array_declarator, C.Kind.abstract_function_declarator, C.Kind.abstract_parenthesized_declarator, C.Kind.abstract_pointer_declarator],
      C.FieldSpec.mk C.Field.parameters .true .false [C.Kind.parameter_list]
    ]
  | .abstract_parenthesized_declarator => .nil
  | .abstract_pointer_declarator => [
      C.FieldSpec.mk C.Field.declarator .false .false [C.Kind.abstract_array_declarator, C.Kind.abstract_function_declarator, C.Kind.abstract_parenthesized_declarator, C.Kind.abstract_pointer_declarator]
    ]
  | .alignas_qualifier => .nil
  | .alignof_expression => [
      C.FieldSpec.mk C.Field.type .true .false [C.Kind.type_descriptor]
    ]
  | .argument_list => .nil
  | .array_declarator => [
      C.FieldSpec.mk C.Field.declarator .true .false [C.Kind.array_declarator, C.Kind.attributed_declarator, C.Kind.function_declarator, C.Kind.parenthesized_declarator, C.Kind.pointer_declarator, C.Kind.primitive_type, C.Kind.type_identifier, C.Kind.field_identifier, C.Kind.identifier],
