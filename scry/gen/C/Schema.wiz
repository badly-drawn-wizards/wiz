/-- The kind with generated ordinal `i`, if any. -/
def C.Kind.ofSym (i : U16) : Option C.Kind := C.Kind.ofIdx (UIntN.toNat i)

/-- The kind with generated ordinal `i`, if any. -/
def C.Kind.ofU32 (i : U32) : Option C.Kind := C.Kind.ofIdx (UIntN.toNat i)

/-- The kind named `s`, if the grammar has it. -/
def C.Kind.ofName (s : String) : Option C.Kind :=
if String.eq s "abstract_array_declarator" then .some (C.Kind.abstract_array_declarator)
else if String.eq s "abstract_function_declarator" then .some (C.Kind.abstract_function_declarator)
else if String.eq s "abstract_parenthesized_declarator" then .some (C.Kind.abstract_parenthesized_declarator)
else if String.eq s "abstract_pointer_declarator" then .some (C.Kind.abstract_pointer_declarator)
else if String.eq s "alignas_qualifier" then .some (C.Kind.alignas_qualifier)
else if String.eq s "alignof_expression" then .some (C.Kind.alignof_expression)
else if String.eq s "argument_list" then .some (C.Kind.argument_list)
else if String.eq s "array_declarator" then .some (C.Kind.array_declarator)
else if String.eq s "assignment_expression" then .some (C.Kind.assignment_expression)
else if String.eq s "attribute" then .some (C.Kind.attribute_)
else if String.eq s "attribute_declaration" then .some (C.Kind.attribute_declaration)
else if String.eq s "attribute_specifier" then .some (C.Kind.attribute_specifier)
else if String.eq s "attributed_declarator" then .some (C.Kind.attributed_declarator)
else if String.eq s "attributed_statement" then .some (C.Kind.attributed_statement)
else if String.eq s "binary_expression" then .some (C.Kind.binary_expression)
else if String.eq s "bitfield_clause" then .some (C.Kind.bitfield_clause)
else if String.eq s "break_statement" then .some (C.Kind.break_statement)
else if String.eq s "call_expression" then .some (C.Kind.call_expression)
else if String.eq s "case_statement" then .some (C.Kind.case_statement)
else if String.eq s "cast_expression" then .some (C.Kind.cast_expression)
else if String.eq s "char_literal" then .some (C.Kind.char_literal)
else if String.eq s "comma_expression" then .some (C.Kind.comma_expression)
