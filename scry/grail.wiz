import Grail
-- scry, the code-analysis package (S1 skeleton; design: wiz-notes/code-analysis-design.md
-- §4, §6, layout notes: wiz-notes/scry-package.md). grail reads `grail.wiz`, so the
-- build file is this one even though the design calls the package "scry".
--
--   grail build                 check src/, build .grail/bin/scry, run every command
--   grail build scry            just the CLI
--   grail run scry -- facts fixtures/demo.facts.json
--   grail test                  the pure loader/stats tests (tests/*.expected)
--
-- There is no tree-sitter yet: `parse --stats` reads a hand-written synthetic store.
def package : Package := Package.new "scry"
  |> Package.lib "src" "src"
  |> Package.exe "scry" "App.wiz"
  |> Package.tests "tests" "tests"
  -- the S1 skeleton's end-to-end checks: each command runs the CLI over the fixture.
  -- They are ordinary build jobs (keyed by the exe, the fixture and the arguments), so
  -- `grail build` exercises the loader and a second build runs none of them.
  |> Package.command (Command.new "facts" (Tool.exe "scry")
       |> Command.arg "facts"
       |> Command.input "fixtures/demo.facts.json"
       |> Command.stdout "build/facts.txt")
  |> Package.command (Command.new "query" (Tool.exe "scry")
       |> Command.arg "query"
       |> Command.input "fixtures/demo.facts.json"
       |> Command.arg "--kind"
       |> Command.arg "call_expression"
       |> Command.stdout "build/query.txt")
  |> Package.command (Command.new "explain" (Tool.exe "scry")
       |> Command.arg "explain"
       |> Command.input "fixtures/demo.facts.json"
       |> Command.arg "4"
       |> Command.stdout "build/explain.txt")
  |> Package.command (Command.new "parse" (Tool.exe "scry")
       |> Command.arg "parse"
       |> Command.arg "--stats"
       |> Command.input "fixtures/demo.facts.json"
       |> Command.stdout "build/parse-stats.txt")
