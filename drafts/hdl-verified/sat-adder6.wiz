-- DRAFT repro of finding F5 (H14 V1): 6-bit adder commutativity, plain sat_decide;
-- about 40 s, almost all of it after the solver (the certificate check).
import SatTactic
def maj (a b c : Bool) : Bool := Bool.or (Bool.and a b) (Bool.and c (Bool.xor a b))
def comm (a0 a1 a2 a3 a4 a5 b0 b1 b2 b3 b4 b5 : Bool) : (Bool.and (Sat.boolEq (Bool.xor (Bool.xor a5 b5) (maj a4 b4 (maj a3 b3 (maj a2 b2 (maj a1 b1 (maj a0 b0 Bool.false)))))) (Bool.xor (Bool.xor b5 a5) (maj b4 a4 (maj b3 a3 (maj b2 a2 (maj b1 a1 (maj b0 a0 Bool.false))))))) (Bool.and (Sat.boolEq (Bool.xor (Bool.xor a4 b4) (maj a3 b3 (maj a2 b2 (maj a1 b1 (maj a0 b0 Bool.false))))) (Bool.xor (Bool.xor b4 a4) (maj b3 a3 (maj b2 a2 (maj b1 a1 (maj b0 a0 Bool.false)))))) (Bool.and (Sat.boolEq (Bool.xor (Bool.xor a3 b3) (maj a2 b2 (maj a1 b1 (maj a0 b0 Bool.false)))) (Bool.xor (Bool.xor b3 a3) (maj b2 a2 (maj b1 a1 (maj b0 a0 Bool.false))))) (Bool.and (Sat.boolEq (Bool.xor (Bool.xor a2 b2) (maj a1 b1 (maj a0 b0 Bool.false))) (Bool.xor (Bool.xor b2 a2) (maj b1 a1 (maj b0 a0 Bool.false)))) (Bool.and (Sat.boolEq (Bool.xor (Bool.xor a1 b1) (maj a0 b0 Bool.false)) (Bool.xor (Bool.xor b1 a1) (maj b0 a0 Bool.false))) (Bool.and (Sat.boolEq (Bool.xor (Bool.xor a0 b0) Bool.false) (Bool.xor (Bool.xor b0 a0) Bool.false)) Bool.true)))))) = .true := by sat_decide
