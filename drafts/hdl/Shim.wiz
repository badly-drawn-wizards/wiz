import Prelude
import Vec
-- Stand-ins for library features other agents are adding right now. Everything in this
-- file is a *shim*: it gives the planned surface a (slow, kernel-level) definition so
-- that the HDL drafts check as far as they can. Delete each section when its feature
-- lands on `solutions` (a duplicate-definition error is the signal).
--
--   section                     wishful entry               landing on
--   `if … then … else`          prelude-if-bool-ops         (nobody yet)
--   Add/Sub/Mul/… classes       numeric-classes-bitvec      (HD9 decided, not scheduled)
--   Vec/Fin extras              (library work)              lib/Vec.wiz has the rest
--   #v[…]                       vec-literal                 (this shim's macro works today)
--   Functor/Applicative         prelude-functor-applicative (nobody yet)

------------------------------------------------------------------------------------
-- `if`, Boolean operators                     -- wishful: prelude-if-bool-ops (shim)
syntax "if" term "then" term "else" term : term
macro_rules
  | `(term| if $c then $t else $e) => `(term| match $c with | .true => $t | .false => $e)
infixl:35 " && " => Bool.and
infixl:30 " || " => Bool.or
def Bool.beq : Bool → Bool → Bool
  | .true, b => b
  | .false, b => Bool.not b

------------------------------------------------------------------------------------
-- Nat division, powers and bitwise operations are the Prelude's (`builtin nat.<op>`
-- natives). Only `clog2` is missing there.
-- ⌈log₂ n⌉, the width of an index into `n` things (`clog2 1 = 0`)
def Nat.clog2Aux : Nat → Nat → Nat → Nat
  | .zero, _, k => k
  | .succ f, n, k => match Nat.lt (Nat.pow 2 k) n with
    | .true => Nat.clog2Aux f n (Nat.succ k)
    | .false => k
def Nat.clog2 (n : Nat) : Nat := Nat.clog2Aux n n 0

------------------------------------------------------------------------------------
-- Numeric classes                              -- wishful: numeric-classes-bitvec (shim, HD9)
-- HD9 puts these in the Prelude with `+`/`-`/`*` resolved through them (Nat stays fast:
-- `instance : Add Nat := ⟨Nat.add⟩` is a builtin). Re-declaring the infixes here makes
-- the later macro win, which is what the Prelude change will do.
class Add (A : Type) where
  add : A → A → A
class Sub (A : Type) where
  sub : A → A → A
class Mul (A : Type) where
  mul : A → A → A
class Neg (A : Type) where
  neg : A → A
class AndOp (A : Type) where
  and : A → A → A
class OrOp (A : Type) where
  or : A → A → A
class XorOp (A : Type) where
  xor : A → A → A
class Complement (A : Type) where
  complement : A → A
class BEq (A : Type) where
  beq : A → A → Bool
class Ord (A : Type) where
  lt : A → A → Bool
  le : A → A → Bool
instance : Add Nat := Add.mk Nat.add
instance : Sub Nat := Sub.mk Nat.sub
instance : Mul Nat := Mul.mk Nat.mul
instance : BEq Nat := BEq.mk Nat.beq
instance : Ord Nat := Ord.mk Nat.lt Nat.le
instance : BEq Bool := BEq.mk Bool.beq
infixl:65 " + " => Add.add
infixl:65 " - " => Sub.sub
infixl:70 " * " => Mul.mul
infixl:58 " ^^^ " => XorOp.xor
infixl:60 " &&& " => AndOp.and
infixl:55 " ||| " => OrOp.or
infix:50 " == " => BEq.beq
infix:50 " < " => Ord.lt
infix:50 " <= " => Ord.le

------------------------------------------------------------------------------------
-- Functor / Applicative                        -- wishful: prelude-functor-applicative (shim)
class Functor (f : Type → Type) where
  map : {A B : Type} → (A → B) → f A → f B
class Applicative (f : Type → Type) where
  pure : {A : Type} → A → f A
  seq : {A B : Type} → f (A → B) → f A → f B
infixr:100 " <$> " => Functor.map
infixl:60 " <*> " => Applicative.seq

------------------------------------------------------------------------------------
-- Vec and Fin are lib/Vec.wiz's (HD7: the length is erased). What the drafts use and the
-- library doesn't have: lookups and updates by a plain `Nat`, and `iterate`.
-- the element at `i`, or `d` past the end (the shim's `get`; vec-lib proves it in range)
def Vec.nthD {A : Type} {0 n : Nat} : Vec A n → Nat → A → A
  | .nil, _, d => d
  | .cons x xs, i, d => match i with
    | .zero => x
    | .succ k => Vec.nthD xs k d
-- `v` with element `i` replaced (unchanged past the end)
def Vec.setD {A : Type} {0 n : Nat} : Vec A n → Nat → A → Vec A n
  | .nil, _, _ => .nil
  | .cons x xs, i, y => match i with
    | .zero => .cons y xs
    | .succ k => .cons x (Vec.setD xs k y)
-- `x, f x, f (f x), …`
def Vec.iterate {A : Type} (f : A → A) : (ω n : Nat) → A → Vec A n
  | .zero, _ => .nil
  | .succ n, x => .cons x (Vec.iterate f n (f x))
def Vec.indices : (ω n : Nat) → Vec Nat n := fun n => Vec.iterate Nat.succ n 0

-- `#v[a, b, c]`                                -- wishful: vec-literal (works here)
syntax (name := vecLit) "#v[" sepBy(term, ",") "]" : term
def vecLitGo {b : Bool} : SyntaxF b → Syntax
  | .cons t ts => match t with
    | .atom _ => vecLitGo ts
    | _ => let rest := vecLitGo ts; `(term| Vec.cons $t $rest)
  | _ => `(term| Vec.nil)
def vecLitMacro : Macro := fun stx => match Syntax.getArg stx 1 with
  | .node _ ts => MacroM.pure (vecLitGo ts)
  | _ => MacroM.pure `(term| Vec.nil)
attribute [macro term.vecLit] vecLitMacro

------------------------------------------------------------------------------------
-- Integers and numerals at any type            -- wishful: prelude-int, numeric-classes-bitvec
inductive Int where
  | ofNat (n : Nat)
  | negSucc (n : Nat)
-- HD9: a numeral `5 : A` elaborates to `OfNat.ofNat A 5` when `A` is not `Nat`. The class
-- and its instances check today; the elaborator change is the gap.
class OfNat (A : Type) (n : Nat) where
  ofNat : A
