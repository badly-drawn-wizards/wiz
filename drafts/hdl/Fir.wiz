import Signal
-- E2: an FIR filter over `Vec` (HDL plan §6). `WIZ_PATH=drafts/hdl wiz check drafts/hdl/Fir.wiz`
-- y(t) = Σₖ cₖ · x(t − k). The number of taps is a compile-time `Nat`: the Vec recursion
-- unrolls during synthesis, so the netlist has n multipliers and n − 1 adders.

def Vec.dot {A : Type} [Add A] [Mul A] (zero : A) {0 n : Nat} (xs ys : Vec A n) : A :=
  Vec.foldr Add.add zero (Vec.zipWith Mul.mul xs ys)

-- `x, x delayed by 1, …, x delayed by n−1`: a chain of registers.
def window {ω d : Domain} {A : Type} [BitPack A] (dflt : A) : (ω n : Nat) → Signal d A → Vec (Signal d A) n
  | .zero, _ => .nil
  | .succ m, x => .cons x (window dflt m (register dflt x))

-- Clash's direct style: a window of registers, bundled, then a combinational dot product.
def fir {ω d : Domain} {A : Type} [BitPack A] [Add A] [Mul A] {ω n : Nat}
    (zero : A) (cs : Vec A n) (x : Signal d A) : Signal d A :=
  Signal.map (Vec.dot zero cs) (Signal.bundleVec (window zero n x))

-- The same filter as a Mealy machine whose state is the last n samples.
def firM {ω d : Domain} {A : Type} [BitPack A] [Add A] [Mul A] {ω n : Nat}
    (zero : A) (cs : Vec A (.succ n)) (x : Signal d A) : Signal d A :=
  mealy (fun (st : Vec A n) (xi : A) => (Vec.shiftIn xi st, Vec.dot zero cs (Vec.cons xi st)))
        (Vec.replicate zero n) x

-- A 4-tap filter on 16-bit signed samples, as it should read:
def fir4 {ω d : Domain} (x : Signal d (Signed 16)) : Signal d (Signed 16) :=
  fir 0 #v[1, 2, 3, 4] x                                   -- wishful: numeric-classes-bitvec
def smooth {ω d : Domain} (x : Signal d (Signed 16)) : Signal d (Signed 16) :=
  fir 0 #v[1, Neg.neg 2, 1] x                              -- wishful: numeric-classes-bitvec (and a prefix `-`)

-- Today's spelling, and simulations
def s16 (k : Nat) : Signed 16 := Signed.ofNat 16 k
def taps : Vec (Signed 16) 4 := #v[s16 1, s16 2, s16 3, s16 4]
def impulse : Signal System (Signed 16) := Signal.fromList (s16 0) (Vec.toList #v[s16 1])
def step : Signal System (Signed 16) := Signal.pure (s16 1)
def toInts (s : Signal System (Signed 16)) : List Int := sample 6 (Signal.map Signed.toInt s)
#eval toInts (fir (s16 0) taps impulse)
-- expect: 1, 2, 3, 4, 0, 0 (the impulse response is the taps)  [as .cons (.ofNat 1) …]
#eval toInts (fir (s16 0) taps step)
-- expect: 1, 3, 6, 10, 10, 10
#eval toInts (firM (s16 0) taps step)
-- expect: the same as `fir` (the two styles agree)
#eval toInts (fir (s16 0) #v[s16 1, Signed.ofInt 16 (Int.negSucc 1), s16 1] step)
-- expect: 1, -1, 0, 0, 0, 0   [.ofNat 1, .negSucc 0, .ofNat 0, …]

