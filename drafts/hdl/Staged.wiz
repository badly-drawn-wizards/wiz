import Synth
import Uart
-- L3 of the HD5 proposal (see Synth.wiz): two-level type theory for circuits.
-- Nothing in this file checks today; every construct is   -- wishful: hdl-staging-2ltt
--
-- Two stages. The *meta* level is ordinary Wiz (Nat, List, functions, classes, proofs).
-- The *object* level holds only circuit values: `⇑A` is "a wire carrying an A" for `A`
-- in the object universe `Hw`, which is closed under BitVec n, Bool, products, enums
-- with BitPack, Vec of object types, and `Signal d` — and NOT under Π or Nat. `⟨t⟩`
-- quotes object code, `~e` splices a meta computation of object code into it.
--
-- Elaboration produces L2 terms: `⇑A` ↦ `r (code A)` under `{r} [Hw r]`, object
-- operations ↦ `Hw` methods, `match` on a `⇑Bool`/`⇑enum` ↦ a `Hw.mux` tree (the
-- staged pattern-matching rule), object `let` ↦ `Hw.share`. So the guarantees of L2 hold
-- by construction, and code reads like Clash.

-- Object-level types: a universe of codes with decoding (the Hw universe)
--   Hw : Type 1;  (BitVec n : Hw) for meta n;  (A B : Hw) → (A × B : Hw);  BitPack A → (A : Hw)
--   ⇑ : Hw → Type        -- lifting an object type to a meta type of object terms

-- A combinational function: meta parameter `k`, object argument `x`.
def addK (k : Nat) (x : ⇑(Unsigned 8)) : ⇑(Unsigned 8) :=
  ⟨~x + ~(Unsigned.ofNat 8 k)⟩               -- the constant is computed at the meta level

-- Staged matching: a `match` on an object value is a mux, not a branch.
def clampedInc (x : ⇑(Unsigned 8)) : ⇑(Unsigned 8) :=
  ⟨if ~x == 255 then 255 else ~x + 1⟩         -- elaborates to Hw.mux (Hw.eq x 255) 255 (x + 1)

-- Meta recursion unrolls; object recursion is a type error (no eliminator on ⇑Nat:
-- `Nat` is not in Hw).
def popCount {n : Nat} : (ω m : Nat) → ⇑(BitVec n) → ⇑(Unsigned 8)
  | .zero, _ => ⟨0⟩
  | .succ i, x => ⟨(if BitVec.getBit ~i ~x then 1 else 0) + ~(popCount i x)⟩

-- Sequential code: signals are object values; `register` is the only feedback; mealy
-- steps are object functions written as meta functions on ⇑ types.
def counter {ω d : Domain} : ⇑(Signal d (Unsigned 8)) :=
  ⟨moore (fun s _ => s + 1) (fun s => s) 0 (Signal.pure ())⟩

-- A step function's body is ordinary-looking code at object types.
def txStep (clksPerBit : Nat) (s : ⇑TxState) (inp : ⇑(Option (BitVec 8))) : ⇑(TxState × (Bool × Bool)) :=
  ⟨let tick := (~s).baud == ~(Unsigned.ofNat 16 (clksPerBit - 1))
   match (~s).phase with
   | .idle => …⟩

