import Signal
-- HD5 (a static synthesisability discipline) and HD6 (our own netlist IR, Verilog out),
-- in Wiz types, as far as they go today. `wiz check -I drafts/hdl drafts/hdl/Synth.wiz`
--
-- The question HD5 asks: how do the library's *types* say "this is a circuit"? The plan's
-- answer (§4) is dynamic: the symbolic evaluator defines the fragment. The proposal here
-- has three layers, each checkable earlier than the last:
--
-- L1  (types, today) Everything that crosses a port or sits in a register has `[BitPack A]`;
--     feedback only through `register`/`mealy`/`moore`. `Signal.head/tail` are private
--     to Signal.wiz (13b), so observation can't be written outside simulation.
-- L2  (types, today; this file) A circuit's *combinational logic* is a function polymorphic
--     in its representation: `{r : HwTy → Type} → [Hw r] → r a → r b` (tagless final).
--     Such a function can only combine wires with `Hw`'s operations, so it is
--     synthesisable by construction: no recursion on a wire, no `Nat` from a wire, no
--     observation of signals, no loops. Everything else (`Nat` parameters, `Vec`s of
--     constants, functions, type classes) is the *meta level*, computed away before the
--     wires exist. Two instances: `HwTy.El` (values: simulation) and `Wire` (netlist
--     nodes: synthesis). A sequential circuit is a `Circuit i o`, a Mealy machine whose
--     step is such a function; that is the only feedback.
--     Cost: `case` on a wire is an explicit `Hw.mux`, and sharing an explicit `Hw.share`.
-- L3  (types, wishful) Two-level type theory (Kovács 2022) makes L2 implicit: object types
--     `⇑A` for `A` in a universe of hardware types, quotes `⟨t⟩` and splices `~t`, and the
--     elaborator stages `match` on an object Bool/enum into `mux`. Clash-style code then
--     typechecks *as* L2 code. See Staged.wiz.            -- wishful: hdl-staging-2ltt
--
-- What the type system needs, per layer: L1 module privacy; L2 nothing new (the
-- elaborator works today, minus the gaps marked below); L3 a stage modality (not a
-- quantity: 0/1/ω is about use, not time), quote/splice, staged pattern matching, and an
-- object universe closed under BitVec, products and Signal — and *not* under Π.
--
-- How it meets HD4 (synthesis by symbolic evaluation of erased code): the `Wire` instance
-- below *is* a symbolic evaluator, restricted to L2 code; L3 code elaborates to L2 code;
-- the general evaluator (Wiz/Hdl/Sym.lean) remains for L1-only code, and its dynamic
-- errors become the fallback rather than the definition.

------------------------------------------------------------------------------------
-- Hardware types (codes) and their values

inductive HwTy where
  | bits (n : Nat)
  | prod (a b : HwTy)

def HwTy.El : HwTy → Type
  | .bits n => BitVec n
  | .prod a b => HwTy.El a × HwTy.El b

def HwTy.width : HwTy → Nat
  | .bits n => n
  | .prod a b => HwTy.width a + HwTy.width b

def HwTy.pack : (ω t : HwTy) → HwTy.El t → Nat
  | .bits n, v => v.toNat
  | .prod a b, v => Nat.shiftLeft (HwTy.pack a v.1) (HwTy.width b) + HwTy.pack b v.2

------------------------------------------------------------------------------------
-- L2: the combinational operations, tagless final

-- (`HwTy.bit` rather than `HwTy.bits 1`: a numeral in a class field's type fails with
--  "numerals need `builtin nat`"; likewise `m + n` is written `Nat.add m n`: the
--  field types are elaborated without macro expansion.)   -- wishful: numerals-in-class-decls
def HwTy.bit : HwTy := HwTy.bits 1

class Hw (r : HwTy → Type) where
  lit : (ω n : Nat) → Nat → r (HwTy.bits n)
  add : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  sub : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  and : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  xor : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  eq : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r HwTy.bit
  ult : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r HwTy.bit
  mux : {ω t : HwTy} → r HwTy.bit → r t → r t → r t
  cat : {ω m n : Nat} → r (HwTy.bits m) → r (HwTy.bits n) → r (HwTy.bits (Nat.add m n))
  slice : (ω lo w : Nat) → {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits w)
  pair : {ω a b : HwTy} → r a → r b → r (HwTy.prod a b)
  fst : {ω a b : HwTy} → r (HwTy.prod a b) → r a
  snd : {ω a b : HwTy} → r (HwTy.prod a b) → r b
  share : {ω a b : HwTy} → r a → (r a → r b) → r b

-- Simulation: the values themselves.
instance : Hw HwTy.El where
  lit := fun n k => BitVec.ofNat n k
  add := fun a b => BitVec.add a b
  sub := fun a b => BitVec.sub a b
  and := fun a b => BitVec.and a b
  xor := fun a b => BitVec.xor a b
  eq := fun a b => Bool.toBits (BitVec.eq a b)
  ult := fun a b => Bool.toBits (BitVec.ult a b)
  mux := fun c t e => if Bool.ofBits c then t else e
  cat := fun a b => BitVec.append a b
  slice := fun lo w a => BitVec.slice lo w a
  pair := fun a b => (a, b)
  fst := fun p => p.1
  snd := fun p => p.2
  share := fun a f => f a

------------------------------------------------------------------------------------
-- HD6: the netlist IR (plan §3.3), flat, widths concrete

inductive Op where
  | input (port : Nat)
  | const (v : Nat)
  | reg (r : Nat)
  | add
  | sub
  | and
  | xor
  | eq
  | ult
  | mux
  | concat
  | slice (lo : Nat)

structure Node where
  op : Op
  width : Nat
  args : List Nat

structure Reg where
  width : Nat
  init : Nat
  next : Nat

structure Port where
  name : String
  width : Nat
  node : Nat

structure Netlist where
  name : String
  nodes : List Node        -- node k is the k-th; arguments refer to earlier nodes
  regs : List Reg
  inputs : List Port
  outputs : List Port

def List.reverseAux {A : Type} : List A → List A → List A
  | .nil, acc => acc
  | .cons x xs, acc => List.reverseAux xs (List.cons x acc)

-- Building netlists: a state monad over (next id, nodes in reverse).
def NetM (A : Type) : Type := Nat × List Node → A × (Nat × List Node)
def NetM.pure {A : Type} (a : A) : NetM A := fun s => (a, s)
def NetM.bind {A B : Type} (x : NetM A) (f : A → NetM B) : NetM B := fun s =>
  let r := x s
  f r.1 r.2
instance : Monad NetM where
  pure := NetM.pure
  bind := NetM.bind
def NetM.emit (op : Op) (w : Nat) (args : List Nat) : NetM Nat := fun s =>
  (s.1, (Nat.succ s.1, List.cons (Node.mk op w args) s.2))

-- Synthesis: a wire is a computation that emits nodes and returns the id of its output.
-- Products are flattened into one bus (first component in the high bits, as BitPack).
def Wire (t : HwTy) : Type := NetM Nat
def Wire.op2 (op : Op) (w : Nat) (a b : NetM Nat) : NetM Nat := do
  x ← a;
  y ← b;
  NetM.emit op w (List.cons x (List.cons y List.nil))
def Wire.op1 (op : Op) (w : Nat) (a : NetM Nat) : NetM Nat := do
  x ← a;
  NetM.emit op w (List.cons x List.nil)

-- The operations that need an implicit width are named functions: a lambda can't bind
-- an implicit argument (`add := fun {n} a b => Wire.op2 Op.add n a b`).
--                                                         -- wishful: implicit-lambda-binders
def Wire.lit (ω n : Nat) (k : Nat) : Wire (HwTy.bits n) := NetM.emit (Op.const (Nat.mod k (Nat.pow 2 n))) n List.nil
def Wire.add {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 Op.add n a b
def Wire.sub {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 Op.sub n a b
def Wire.and {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 Op.and n a b
def Wire.xor {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 Op.xor n a b
def Wire.eq {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire HwTy.bit := Wire.op2 Op.eq 1 a b
def Wire.ult {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire HwTy.bit := Wire.op2 Op.ult 1 a b
-- (`do` in a definition of type `Wire t` resolves `Monad Wire`: the first-order
-- approximation stops at the name. So the NetM code lives in NetM-typed helpers.)
def NetM.op3 (op : Op) (w : Nat) (a b c : NetM Nat) : NetM Nat := do
  x ← a;
  y ← b;
  z ← c;
  NetM.emit op w (List.cons x (List.cons y (List.cons z List.nil)))
def NetM.share (x : NetM Nat) (f : NetM Nat → NetM Nat) : NetM Nat := do
  id ← x;
  f (NetM.pure id)
def Wire.mux {ω t : HwTy} (c : Wire HwTy.bit) (x y : Wire t) : Wire t := NetM.op3 Op.mux (HwTy.width t) c x y
def Wire.cat {ω m n : Nat} (a : Wire (HwTy.bits m)) (b : Wire (HwTy.bits n)) : Wire (HwTy.bits (m + n)) :=
  Wire.op2 Op.concat (m + n) a b
def Wire.slice (ω lo w : Nat) {ω n : Nat} (a : Wire (HwTy.bits n)) : Wire (HwTy.bits w) := Wire.op1 (Op.slice lo) w a
def Wire.pair {ω a b : HwTy} (x : Wire a) (y : Wire b) : Wire (HwTy.prod a b) :=
  Wire.op2 Op.concat (HwTy.width a + HwTy.width b) x y
def Wire.fst {ω a b : HwTy} (p : Wire (HwTy.prod a b)) : Wire a := Wire.op1 (Op.slice (HwTy.width b)) (HwTy.width a) p
def Wire.snd {ω a b : HwTy} (p : Wire (HwTy.prod a b)) : Wire b := Wire.op1 (Op.slice 0) (HwTy.width b) p
-- `share` runs the wire's computation once and hands on its id: observable sharing.
def Wire.share {ω a b : HwTy} (x : Wire a) (f : Wire a → Wire b) : Wire b := NetM.share x f

instance : Hw Wire where
  lit := Wire.lit
  add := Wire.add
  sub := Wire.sub
  and := Wire.and
  xor := Wire.xor
  eq := Wire.eq
  ult := Wire.ult
  mux := Wire.mux
  cat := Wire.cat
  slice := Wire.slice
  pair := Wire.pair
  fst := Wire.fst
  snd := Wire.snd
  share := Wire.share

------------------------------------------------------------------------------------
-- Circuits: Mealy machines whose step is L2 code. The only way to make feedback.

structure Circuit (i o : HwTy) where
  st : HwTy
  init : HwTy.El st
  step : {r : HwTy → Type} → [Hw r] → r st → r i → r (HwTy.prod st o)

-- the step at a given instance (the representation is found from the result type)
def Circuit.stepEl {i o : HwTy} (c : Circuit i o) (s : HwTy.El c.st) (x : HwTy.El i) : HwTy.El (HwTy.prod c.st o) := c.step s x
def Circuit.stepWire {i o : HwTy} (c : Circuit i o) (s : Wire c.st) (x : Wire i) : Wire (HwTy.prod c.st o) := c.step s x

-- simulation: the same step at the value instance
def Circuit.sim {ω d : Domain} {ω i o : HwTy} (c : Circuit i o) (x : Signal d (HwTy.El i)) : Signal d (HwTy.El o) :=
  Signal.mealyRaw (fun (s : HwTy.El c.st) (v : HwTy.El i) => (Circuit.stepEl c s v : HwTy.El c.st × HwTy.El o)) c.init x

-- synthesis: the same step at the wire instance
def Circuit.netlist {ω i o : HwTy} (name : String) (c : Circuit i o) : Netlist :=
  let build : NetM (Nat × Nat × Nat × Nat) := do
    inp ← NetM.emit (Op.input 0) (HwTy.width i) List.nil;
    cur ← NetM.emit (Op.reg 0) (HwTy.width c.st) List.nil;
    res ← (Circuit.stepWire c (NetM.pure cur) (NetM.pure inp) : NetM Nat);
    nxt ← NetM.emit (Op.slice (HwTy.width o)) (HwTy.width c.st) (List.cons res List.nil);
    out ← NetM.emit (Op.slice 0) (HwTy.width o) (List.cons res List.nil);
    NetM.pure (inp, cur, nxt, out)
  let r := build (0, List.nil)
  Netlist.mk name (List.reverseAux r.2.2 List.nil)
    (List.cons (Reg.mk (HwTy.width c.st) (HwTy.pack c.st c.init) r.1.2.2.1) List.nil)
    (List.cons (Port.mk "x" (HwTy.width i) r.1.1) List.nil)
    (List.cons (Port.mk "y" (HwTy.width o) r.1.2.2.2) List.nil)

------------------------------------------------------------------------------------
-- Verilog-2005 (plan §3.4): one wire per node, one register per Reg.

infixr:67 " <+> " => String.append
def Nat.digitsAux : Nat → Nat → List Char → List Char
  | .zero, _, acc => acc
  | .succ f, n, acc => match Nat.lt n 10 with
    | .true => List.cons (Char.mk (48 + n)) acc
    | .false => Nat.digitsAux f (Nat.div n 10) (List.cons (Char.mk (48 + Nat.mod n 10)) acc)
def Nat.show (n : Nat) : String := String.mk (Nat.digitsAux (Nat.succ n) n List.nil)

def Verilog.node (k : Nat) : String := "n" <+> Nat.show k
def Verilog.range (w : Nat) : String := "[" <+> Nat.show (w - 1) <+> ":0] "
def Verilog.bin (o : String) : List Nat → String
  | .cons a (.cons b _) => Verilog.node a <+> " " <+> o <+> " " <+> Verilog.node b
  | _ => "?"
def Verilog.expr (n : Node) : String := match n.op with
  | .input p => "x"
  | .const v => Nat.show n.width <+> "'d" <+> Nat.show v
  | .reg r => "r" <+> Nat.show r
  | .add => Verilog.bin "+" n.args
  | .sub => Verilog.bin "-" n.args
  | .and => Verilog.bin "&" n.args
  | .xor => Verilog.bin "^" n.args
  | .eq => Verilog.bin "==" n.args
  | .ult => Verilog.bin "<" n.args
  | .concat => "{" <+> Verilog.bin "," n.args <+> "}"
  | .slice lo => match n.args with
    | .cons a _ => Verilog.node a <+> "[" <+> Nat.show (lo + n.width - 1) <+> ":" <+> Nat.show lo <+> "]"
    | _ => "?"
  | .mux => match n.args with
    | .cons c (.cons a (.cons b _)) => Verilog.node c <+> " ? " <+> Verilog.node a <+> " : " <+> Verilog.node b
    | _ => "?"
def Verilog.nodes : Nat → List Node → String
  | _, .nil => ""
  | k, .cons n ns => "  wire " <+> Verilog.range n.width <+> Verilog.node k <+> " = " <+> Verilog.expr n <+> ";\n"
                     <+> Verilog.nodes (Nat.succ k) ns
def Verilog.regs : Nat → List Reg → String
  | _, .nil => ""
  | k, .cons r rs => "  reg " <+> Verilog.range r.width <+> "r" <+> Nat.show k <+> "; initial r" <+> Nat.show k
      <+> " = " <+> Nat.show r.init <+> ";\n  always @(posedge clk) r" <+> Nat.show k <+> " <= "
      <+> Verilog.node r.next <+> ";\n" <+> Verilog.regs (Nat.succ k) rs
def Verilog.emit (n : Netlist) : String :=
  "module " <+> n.name <+> "(input clk, input [" <+> "...], output [...]);\n"
  <+> Verilog.regs 0 n.regs <+> Verilog.nodes 0 n.nodes
  <+> "  assign y = " <+> (match n.outputs with
    | .cons p _ => Verilog.node p.node
    | .nil => "0") <+> ";\nendmodule\n"

------------------------------------------------------------------------------------
-- Example: the counter as L2 code, simulated and synthesised from one definition.

def counterC : Circuit (HwTy.bits 0) (HwTy.bits 8) :=
  Circuit.mk (HwTy.bits 8) (BitVec.ofNat 8 0)
    (fun s u => Hw.pair (Hw.add s (Hw.lit 8 1)) s)

-- (`BitVec.toNat` alone is read as a field of the function `BitVec`, not as the
--  projection function: written as a lambda)               -- wishful: projection-functions
#eval sample 5 (Signal.map (fun (v : BitVec 8) => v.toNat) (Circuit.sim counterC (Signal.pure (BitVec.ofNat 0 0)) : Signal System (BitVec 8)))
-- expect: .cons 0 (.cons 1 (.cons 2 (.cons 3 (.cons 4 .nil))))
#eval List.length (Circuit.netlist "counter" counterC).nodes
-- expect: 7  (input, reg, const 1, add, concat, two slices)
#eval Verilog.emit (Circuit.netlist "counter" counterC)
-- expect:
-- module counter(…);
--   reg [7:0] r0; initial r0 = 0;
--   always @(posedge clk) r0 <= n5;
--   wire [-1:0] n0 = x; … wire [7:0] n3 = n1 + n2; wire [15:0] n4 = {n3 , n1}; …

-- What L2 rules out, by typing: `fun s u => if (s : HwTy.El …).toNat …` does not typecheck
-- at an arbitrary `r` (no `toNat` on `r (bits 8)`), so "a Nat from a wire" is a type
-- error, not a synthesis-time error. Recursion on a wire is likewise impossible: `r t`
-- has no eliminator. A meta-level loop is fine: e.g. an n-input adder tree by recursion
-- on a compile-time `n`:
def sumTree {r : HwTy → Type} [Hw r] {ω w : Nat} : (ω n : Nat) → Vec (r (HwTy.bits w)) n → r (HwTy.bits w)
  | .zero, _ => Hw.lit w 0
  | .succ m, v => Vec.foldr (fun (a b : r (HwTy.bits w)) => Hw.add a b) (Hw.lit w 0) v
