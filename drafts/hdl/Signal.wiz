import Bits
-- Signals: synchronous streams in a clock domain (HDL plan §2.3, H1).
--
-- A `Signal d A` is the value of a wire in each clock cycle of domain `d`. It is an
-- ordinary coinductive stream; `d` is an (erased) parameter, so signals of different
-- domains don't mix. Simulation runs the stream (`sample`); synthesis evaluates the
-- erased program symbolically with the primitives below as netlist nodes (HD4).
--
-- Conventions (HD1, HD2):
-- * feedback only through `register`, `mealy`, `moore` (each inserts a register), so a
--   combinational loop can't be written; sized `Signal.fix` comes later;
-- * registers have a power-on value (Verilog `initial`), no implicit reset; `registerR`
--   is the explicit synchronous reset.
-- * what synthesis needs at runtime (domain, widths) is `{ω …}`; `[BitPack A]` on every
--   register and port gives the width and the encoding.

structure Domain where
  name : String
  periodPs : Nat

def System : Domain := Domain.mk "System" 10000          -- 100 MHz

coinductive Signal (d : Domain) (A : Type) where
  private head : A
  private tail : Signal d A
-- `head`/`tail` are simulation-only: synthesis rejects them on a symbolic signal. They
-- are private to this module (docs/stages/13-*.md, 13b), with the coconstructor
-- `Signal.mk`, and elsewhere `Signal` is opaque: other modules build and observe signals
-- only through the combinators below and `sample`/`Signal.at` (and can't define one by
-- copatterns). drafts/hdl/rejected/observe_signal.wiz.

------------------------------------------------------------------------------------
-- Combinational lifting
-- (Lambda binders are annotated throughout: a lambda argument is elaborated before the
-- later arguments fix its domain, so `match`/`if` on an unannotated binder fails.
--                                                         -- wishful: elab-postpone-lambdas)

def Signal.pure {d : Domain} {A : Type} (a : A) : Signal d A
  | .head => a
  | .tail => Signal.pure a

def Signal.map {d : Domain} {A B : Type} (f : A → B) (s : Signal d A) : Signal d B
  | .head => f s.head
  | .tail => Signal.map f s.tail

def Signal.zipWith {d : Domain} {A B C : Type} (f : A → B → C) (a : Signal d A) (b : Signal d B) : Signal d C
  | .head => f a.head b.head
  | .tail => Signal.zipWith f a.tail b.tail

def Signal.zipWith3 {d : Domain} {A B C D : Type} (f : A → B → C → D)
    (a : Signal d A) (b : Signal d B) (c : Signal d C) : Signal d D
  | .head => f a.head b.head c.head
  | .tail => Signal.zipWith3 f a.tail b.tail c.tail

def Signal.ap {d : Domain} {A B : Type} (f : Signal d (A → B)) (a : Signal d A) : Signal d B :=
  Signal.zipWith (fun (g : A → B) (x : A) => g x) f a

instance {d : Domain} : Functor (Signal d) where
  map := fun f s => Signal.map f s
instance {d : Domain} : Applicative (Signal d) where
  pure := fun a => Signal.pure a
  seq := fun f a => Signal.ap f a

-- Clash's `Num (Signal d a)`: arithmetic on signals is pointwise.
instance {d : Domain} {A : Type} [Add A] : Add (Signal d A) := Add.mk (Signal.zipWith Add.add)
instance {d : Domain} {A : Type} [Sub A] : Sub (Signal d A) := Sub.mk (Signal.zipWith Sub.sub)
instance {d : Domain} {A : Type} [Mul A] : Mul (Signal d A) := Mul.mk (Signal.zipWith Mul.mul)
instance {d : Domain} {A : Type} {k : Nat} [OfNat A k] : OfNat (Signal d A) k := OfNat.mk (Signal.pure OfNat.ofNat)
-- comparisons can't reuse `==` (its result is a `Bool`, not a `Signal d Bool`): dotted ops
def Signal.eq {d : Domain} {A : Type} [BEq A] (a b : Signal d A) : Signal d Bool := Signal.zipWith BEq.beq a b
def Signal.lt {d : Domain} {A : Type} [Ord A] (a b : Signal d A) : Signal d Bool := Signal.zipWith Ord.lt a b
def Signal.and {d : Domain} (a b : Signal d Bool) : Signal d Bool := Signal.zipWith Bool.and a b
def Signal.mux {d : Domain} {A : Type} (c : Signal d Bool) (t e : Signal d A) : Signal d A :=
  Signal.zipWith3 (fun (b : Bool) (x y : A) => if b then x else y) c t e

------------------------------------------------------------------------------------
-- State

-- `delay x s` is `x` followed by `s` (a corecursive tail: a `coit`).
def Signal.delay {d : Domain} {A : Type} (x : A) (s : Signal d A) : Signal d A
  | .head => x
  | .tail => Signal.delay s.head s.tail

-- A D flip-flop with a power-on value: `register i s = i, s₀, s₁, …`. A copattern with no
-- corecursive observation is one `cocon` cell in front of `s` (H0a, agent/copatterns).
def register {ω d : Domain} {A : Type} [BitPack A] (init : A) (s : Signal d A) : Signal d A
  | .head => init
  | .tail => s

-- Synchronous reset: `out(0) = init`, `out(t+1) = if rst(t) then init else s(t)`.
def registerR {ω d : Domain} {A : Type} [BitPack A] (init : A) (rst : Signal d Bool) (s : Signal d A) : Signal d A :=
  register init (Signal.zipWith (fun (r : Bool) (x : A) => if r then init else x) rst s)

-- A Mealy machine: state `S` in a register, output from state and input.
-- (`mealyRaw` has no BitPack constraint and is the simulation model; `mealy` is the
-- synthesisable primitive.)
def Signal.mealyRaw {d : Domain} {S I O : Type} (f : S → I → S × O) (s : S) (i : Signal d I) : Signal d O
  | .head => (f s i.head).2
  | .tail => Signal.mealyRaw f (f s i.head).1 i.tail

def mealy {ω d : Domain} {S I O : Type} [BitPack S] (f : S → I → S × O) (s0 : S) (i : Signal d I) : Signal d O :=
  Signal.mealyRaw f s0 i

-- A Moore machine: the output depends on the state only.
def moore {ω d : Domain} {S I O : Type} [BitPack S] (f : S → I → S) (o : S → O) (s0 : S) (i : Signal d I) : Signal d O :=
  mealy (fun (s : S) (x : I) => (f s x, o s)) s0 i

-- Clock enable: the register keeps its value while `en` is low.
def registerEn {ω d : Domain} {A : Type} [BitPack A] (init : A) (en : Signal d Bool) (s : Signal d A) : Signal d A :=
  Signal.mealyRaw (fun (cur : A) (p : Bool × A) => (if p.1 then p.2 else cur, cur)) init (Signal.zipWith (fun (e : Bool) (x : A) => (e, x)) en s)

------------------------------------------------------------------------------------
-- Bundling: a signal of a product ↔ a product of signals (Clash's `Bundle`).

def Signal.unbundle2 {d : Domain} {A B : Type} (s : Signal d (A × B)) : Signal d A × Signal d B :=
  (Signal.map (fun (p : A × B) => p.1) s, Signal.map (fun (p : A × B) => p.2) s)
def Signal.bundle2 {d : Domain} {A B : Type} (p : Signal d A × Signal d B) : Signal d (A × B) :=
  Signal.zipWith (fun (a : A) (b : B) => (a, b)) p.1 p.2

def Signal.unbundleVec {d : Domain} {A : Type} : (ω n : Nat) → Signal d (Vec A n) → Vec (Signal d A) n
  | .zero, _ => .nil
  | .succ m, s => .cons (Signal.map Vec.head s) (Signal.unbundleVec m (Signal.map Vec.tail s))
def Signal.bundleVec {d : Domain} {A : Type} {0 n : Nat} (v : Vec (Signal d A) n) : Signal d (Vec A n)
  | .head => Vec.map (fun (s : Signal d A) => s.head) v
  | .tail => Signal.bundleVec (Vec.map (fun (s : Signal d A) => s.tail) v)

class Bundle (A : Type) where
  0 Unbundled : Domain → Type
  bundle : {d : Domain} → Unbundled d → Signal d A
  unbundle : {d : Domain} → Signal d A → Unbundled d
instance {A B : Type} : Bundle (A × B) where
  Unbundled := fun d => Signal d A × Signal d B
  bundle := fun p => Signal.bundle2 p
  unbundle := fun s => Signal.unbundle2 s
instance {A : Type} {ω n : Nat} : Bundle (Vec A n) where
  Unbundled := fun d => Vec (Signal d A) n
  bundle := fun v => Signal.bundleVec v
  unbundle := fun s => Signal.unbundleVec n s

------------------------------------------------------------------------------------
-- Simulation

def Signal.at {d : Domain} {A : Type} : Signal d A → Nat → A
  | s, .zero => s.head
  | s, .succ n => Signal.at s.tail n
def sample {d : Domain} {A : Type} : Nat → Signal d A → List A
  | .zero, _ => .nil
  | .succ n, s => .cons s.head (sample n s.tail)
-- the list, then `dflt` forever
def Signal.fromList {d : Domain} {A : Type} (dflt : A) (xs : List A) : Signal d A
  | .head => match xs with
    | .nil => dflt
    | .cons x _ => x
  | .tail => Signal.fromList dflt (match xs with
    | .nil => List.nil
    | .cons _ r => r)
-- run a circuit on a list of inputs
def simulate {d : Domain} {A B : Type} (f : Signal d A → Signal d B) (dflt : A) (xs : List A) : List B :=
  sample (List.length xs) (f (Signal.fromList dflt xs))

------------------------------------------------------------------------------------
-- Checks (kernel-evaluated samples)

def nat3 (n : Nat) : Unsigned 3 := Unsigned.ofNat 3 n
-- (kernel tests `sample … = … := refl …` hit the same problem as in Bits.wiz:
--  holes in the statement are solved too late)            -- wishful: elab-solve-type-before-body
def inputs : Signal System (Unsigned 3) := Signal.fromList (nat3 0) (Vec.toList #v[nat3 1, nat3 2, nat3 3])
#eval sample 5 (Signal.map Unsigned.toNat (register (nat3 7) inputs))
-- expect: .cons 7 (.cons 1 (.cons 2 (.cons 3 (.cons 0 .nil))))
#eval sample 4 (Signal.map Unsigned.toNat (registerR (nat3 0) (Signal.fromList Bool.false (Vec.toList #v[Bool.false, Bool.true])) (Signal.pure (nat3 5)) : Signal System (Unsigned 3)))
-- expect: .cons 0 (.cons 5 (.cons 0 (.cons 5 .nil)))
#eval sample 3 (Signal.map Unsigned.toNat (Signal.unbundle2 (Signal.map (fun (x : Unsigned 3) => (x, x + nat3 1)) inputs)).2)
-- expect: .cons 2 (.cons 3 (.cons 4 .nil))
#eval Vec.toList (Vec.map (fun (s : Signal System (Unsigned 3)) => Unsigned.toNat (Signal.at s 2)) (Signal.unbundleVec 2 (Signal.pure (Vec.cons (nat3 4) (Vec.cons (nat3 5) Vec.nil)))))
-- expect: .cons 4 (.cons 5 .nil)
#eval sample 5 (Signal.map Unsigned.toNat (registerEn (nat3 1) (Signal.fromList Bool.true (Vec.toList #v[Bool.false, Bool.false, Bool.true])) (Signal.pure (nat3 6)) : Signal System (Unsigned 3)))
-- expect: .cons 1 (.cons 1 (.cons 1 (.cons 6 (.cons 6 .nil))))  (enable low in cycles 0–1)

------------------------------------------------------------------------------------
-- Clash-style feedback (HD1, later): a recursive signal through a sized fixed point.
-- `register` is the only size bump, so `Signal.fix (fun i s => s + 1)` is a size error:
-- the combinational loop is a type error.
--   def Signal.fix {ω d : Domain} {A : Type} [BitPack A]
--       (f : (i : Size) → Signal^i d A → Signal^(↑i) d A) : Signal d A   -- wishful: sized-signal-fix
-- Domains must not mix. Today they do: `Signal`'s description doesn't mention `d`, so
-- `Signal System A` and `Signal Fast A` are the same type. This should be an error:
def Fast : Domain := Domain.mk "Fast" 5000
def crossDomain (s : Signal System Nat) : Signal Fast Nat := s     -- wishful: phantom-parameters (accepted today!)
-- Multiple clock domains (H10): `dualFlipFlop : Signal d₁ A → Signal d₂ A` is the only
-- crossing; mixing `Signal System A` with `Signal Fast A` elsewhere is a type error.
