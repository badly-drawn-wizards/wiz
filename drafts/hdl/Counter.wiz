import Signal
-- E1: counters (HDL plan §6). `wiz check -I drafts/hdl drafts/hdl/Counter.wiz`

-- An 8-bit counter, Moore style: the state is the count and is also the output.
def counter {ω d : Domain} : Signal d (Unsigned 8) :=
  moore (fun (s : Unsigned 8) (u : Unit) => s + 1) (fun (s : Unsigned 8) => s) 0 (Signal.pure ())   -- wishful: numeric-classes-bitvec

-- With enable and synchronous reset (reset wins).
def counterER {ω d : Domain} (en rst : Signal d Bool) : Signal d (Unsigned 8) :=
  mealy (fun (s : Unsigned 8) (i : Bool × Bool) =>
           (if i.2 then 0 else if i.1 then s + 1 else s, s))          -- wishful: numeric-classes-bitvec
        0 (Signal.bundle2 (en, rst))

-- Clash's spelling: a recursive signal through a register. Needs the sized fixed point
-- (HD1: later), and numerals on signals (`OfNat (Signal d A)` from `OfNat A`).
def counterFix {ω d : Domain} : Signal d (Unsigned 8) :=
  Signal.fix (fun i c => register 0 (c + 1))                        -- wishful: sized-signal-fix, numeric-classes-bitvec

-- The same counter in today's spelling (no numerals at Unsigned), generic in the width.
def counterN {ω d : Domain} (ω n : Nat) : Signal d (Unsigned n) :=
  moore (fun (s : Unsigned n) (u : Unit) => s + Unsigned.ofNat n 1) (fun (s : Unsigned n) => s)
        (Unsigned.ofNat n 0) (Signal.pure ())

-- Simulation (`sample`), with expectations.
#eval sample 5 (Signal.map Unsigned.toNat (counter : Signal System (Unsigned 8)))
-- expect: .cons 0 (.cons 1 (.cons 2 (.cons 3 (.cons 4 .nil))))
#eval sample 6 (Signal.map Unsigned.toNat (counterN 2 : Signal System (Unsigned 2)))
-- expect: .cons 0 (.cons 1 (.cons 2 (.cons 3 (.cons 0 (.cons 1 .nil)))))   (wraps)
def enIn : Signal System Bool := Signal.fromList Bool.true (Vec.toList #v[Bool.true, Bool.false, Bool.true, Bool.true])
def rstIn : Signal System Bool := Signal.fromList Bool.false (Vec.toList #v[Bool.false, Bool.false, Bool.false, Bool.true])
#eval sample 6 (Signal.map Unsigned.toNat (counterER enIn rstIn))
-- expect: .cons 0 (.cons 1 (.cons 1 (.cons 2 (.cons 0 (.cons 1 .nil)))))

-- Properties (H11), stated pointwise because equality at ν is stuck:
--   def counter_at : (t : Nat) → Signal.at (counter : Signal System (Unsigned 8)) t = Unsigned.ofNat 8 t
-- by recursion on t, generalising the state, with `Unsigned.ofNat 8 t + 1 = Unsigned.ofNat 8 (t+1)`.
axiom counter_at (t : Nat) :
  Signal.at (counterN 8 : Signal System (Unsigned 8)) t = Unsigned.ofNat 8 t      -- wishful: nat-arith-proofs

