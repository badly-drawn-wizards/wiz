import Shim
import BitVec
-- Bit vectors, Unsigned/Signed numbers and the `BitPack` class (HDL plan §2.2, H2).
--
-- `BitVec n` is lib/BitVec.wiz's (H0c, stage 22h): `BitVec n := UIntN n`, a `Nat` below
-- 2^n, normalised by construction (HD3), with Word's natives in compiled code. Widths
-- that code needs at runtime are `{ω n : Nat}`; after erasure the synthesiser sees them
-- as concrete numbers. Below: what the drafts use beyond the library.

-- Clash's names for the library's operations
def BitVec.eq {0 n : Nat} (a b : BitVec n) : Bool := BitVec.beq a b
def BitVec.append {0 m : Nat} {ω n : Nat} (hi : BitVec m) (lo : BitVec n) : BitVec (m + n) :=
  BitVec.concat hi lo
infixl:67 " +++ " => BitVec.append            -- `++` is List.append (pitfall)
-- `w` bits starting at bit `lo` (Verilog `x[lo+w-1:lo]`)
def BitVec.slice (ω lo w : Nat) {0 n : Nat} (a : BitVec n) : BitVec w :=
  BitVec.ofNat w (Nat.shiftRight a.toNat lo)

-- Shifts by a bit vector
def BitVec.shlBy {ω n : Nat} {0 m : Nat} (a : BitVec n) (k : BitVec m) : BitVec n := BitVec.shl a k.toNat
def BitVec.lshrBy {0 n m : Nat} (a : BitVec n) (k : BitVec m) : BitVec n := BitVec.lshr a k.toNat

-- Reductions (library code over the bits, not primitives)
def BitVec.reduceOr {0 n : Nat} (a : BitVec n) : Bool := Bool.not (Nat.beq a.toNat 0)
def BitVec.reduceAnd {ω n : Nat} (a : BitVec n) : Bool := Nat.beq a.toNat (Nat.pow 2 n - 1)
def BitVec.parityAux (x : Nat) : Nat → Bool
  | .zero => .false
  | .succ i => Bool.xor (Nat.testBit x i) (BitVec.parityAux x i)
def BitVec.reduceXor {ω n : Nat} (a : BitVec n) : Bool := BitVec.parityAux a.toNat n

instance {ω n : Nat} : Add (BitVec n) := Add.mk BitVec.add
instance {ω n : Nat} : Sub (BitVec n) := Sub.mk BitVec.sub
instance {ω n : Nat} : Mul (BitVec n) := Mul.mk BitVec.mul
instance {0 n : Nat} : AndOp (BitVec n) := AndOp.mk BitVec.and
instance {0 n : Nat} : OrOp (BitVec n) := OrOp.mk BitVec.or
instance {0 n : Nat} : XorOp (BitVec n) := XorOp.mk BitVec.xor
instance {ω n : Nat} : Complement (BitVec n) := Complement.mk BitVec.not
instance {0 n : Nat} : BEq (BitVec n) := BEq.mk BitVec.eq
instance {ω n k : Nat} : OfNat (BitVec n) k := OfNat.mk (BitVec.ofNat n k)

------------------------------------------------------------------------------------
-- Unsigned and Signed numbers: the same bits, different arithmetic views (RD9 shares
-- them with the Rust DSL's uN/iN).

structure Unsigned (n : Nat) where
  bits : BitVec n
structure Signed (n : Nat) where
  bits : BitVec n

def Unsigned.ofNat (ω n : Nat) (x : Nat) : Unsigned n := Unsigned.mk (BitVec.ofNat n x)
def Unsigned.toNat {0 n : Nat} (x : Unsigned n) : Nat := x.bits.toNat
def Unsigned.resize (ω m : Nat) {0 n : Nat} (x : Unsigned n) : Unsigned m :=
  Unsigned.mk (BitVec.zeroExtend m x.bits)
instance {ω n : Nat} : Add (Unsigned n) := Add.mk (fun a b => Unsigned.mk (BitVec.add a.bits b.bits))
instance {ω n : Nat} : Sub (Unsigned n) := Sub.mk (fun a b => Unsigned.mk (BitVec.sub a.bits b.bits))
instance {ω n : Nat} : Mul (Unsigned n) := Mul.mk (fun a b => Unsigned.mk (BitVec.mul a.bits b.bits))
instance {0 n : Nat} : BEq (Unsigned n) := BEq.mk (fun a b => BitVec.eq a.bits b.bits)
instance {0 n : Nat} : Ord (Unsigned n) := Ord.mk (fun a b => BitVec.ult a.bits b.bits) (fun a b => BitVec.ule a.bits b.bits)
instance {ω n k : Nat} : OfNat (Unsigned n) k := OfNat.mk (Unsigned.ofNat n k)

def Signed.ofNat (ω n : Nat) (x : Nat) : Signed n := Signed.mk (BitVec.ofNat n x)
def Signed.ofInt (ω n : Nat) : Int → Signed n
  | .ofNat x => Signed.ofNat n x
  | .negSucc x => Signed.mk (BitVec.neg (BitVec.ofNat n (Nat.succ x)))
def Signed.toInt {ω n : Nat} (x : Signed n) : Int :=
  if BitVec.msb x.bits then Int.negSucc (Nat.pow 2 n - x.bits.toNat - 1) else Int.ofNat x.bits.toNat
def Signed.resize (ω m : Nat) {ω n : Nat} (x : Signed n) : Signed m := Signed.mk (BitVec.signExtend m x.bits)
instance {ω n : Nat} : Add (Signed n) := Add.mk (fun a b => Signed.mk (BitVec.add a.bits b.bits))
instance {ω n : Nat} : Sub (Signed n) := Sub.mk (fun a b => Signed.mk (BitVec.sub a.bits b.bits))
instance {ω n : Nat} : Mul (Signed n) := Mul.mk (fun a b => Signed.mk (BitVec.mul a.bits b.bits))
instance {ω n : Nat} : Neg (Signed n) := Neg.mk (fun a => Signed.mk (BitVec.neg a.bits))
instance {0 n : Nat} : BEq (Signed n) := BEq.mk (fun a b => BitVec.eq a.bits b.bits)
instance {ω n : Nat} : Ord (Signed n) := Ord.mk (fun a b => BitVec.slt a.bits b.bits) (fun a b => BitVec.sle a.bits b.bits)
instance {ω n k : Nat} : OfNat (Signed n) k := OfNat.mk (Signed.ofNat n k)

------------------------------------------------------------------------------------
-- BitPack: the types that can cross a port or live in a register.

class BitPack (A : Type) where
  width : Nat
  pack : A → BitVec width
  unpack : BitVec width → A
  0 unpack_pack : (x : A) → unpack (pack x) = x

-- `BitPack.width A` with the type explicit. Wanted: `bitWidth A ()`, but a trailing
-- instance argument is not inserted (`bitWidth B () : [BitPack B] → Nat`), and `@C.f A _`
-- does not run resolution for the `_`. So the call site passes a dummy `()`.
--                                                         -- wishful: trailing-instance-args
def bitWidth (0 A : Type) [BitPack A] (u : Unit) : Nat := BitPack.width
-- `BitPack.unpack` at an explicit type (with the type only ascribed, the width `?inst.1`
-- is unified with the argument's before the instance is found)
def BitPack.unpackAs (0 A : Type) [ia : BitPack A] (v : BitVec (bitWidth A ())) : A := @BitPack.unpack A ia v

-- Instances are written `@BitPack.mk T …` with named parts: in `BitPack.mk w p u law` the
-- class argument is not unified with the expected type before the arguments are
-- elaborated, so the law's type still has holes (`?p (?u x) = x`) and a `refl` proof at
-- the concrete type does not match it.          -- wishful: ctor-params-from-expected-type
def BitVec.packId {0 n : Nat} (x : BitVec n) : BitVec n := x
def BitVec.packId_law {0 n : Nat} (x : BitVec n) : BitVec.packId (BitVec.packId x) = x := refl x
instance {ω n : Nat} : BitPack (BitVec n) :=
  @BitPack.mk (BitVec n) n BitVec.packId BitVec.packId BitVec.packId_law
def Unsigned.pack {0 n : Nat} (x : Unsigned n) : BitVec n := x.bits
def Unsigned.unpack {0 n : Nat} (b : BitVec n) : Unsigned n := Unsigned.mk b
def Unsigned.unpack_pack {0 n : Nat} (x : Unsigned n) : Unsigned.unpack (Unsigned.pack x) = x := refl x
instance {ω n : Nat} : BitPack (Unsigned n) :=
  @BitPack.mk (Unsigned n) n Unsigned.pack Unsigned.unpack Unsigned.unpack_pack
def Signed.pack {0 n : Nat} (x : Signed n) : BitVec n := x.bits
def Signed.unpack {0 n : Nat} (b : BitVec n) : Signed n := Signed.mk b
def Signed.unpack_pack {0 n : Nat} (x : Signed n) : Signed.unpack (Signed.pack x) = x := refl x
instance {ω n : Nat} : BitPack (Signed n) :=
  @BitPack.mk (Signed n) n Signed.pack Signed.unpack Signed.unpack_pack
def Unit.pack (u : Unit) : BitVec 0 := BitVec.mk 0
def Unit.unpack (b : BitVec 0) : Unit := ()
def Unit.unpack_pack (u : Unit) : Unit.unpack (Unit.pack u) = u := refl u
instance : BitPack Unit := @BitPack.mk Unit 0 Unit.pack Unit.unpack Unit.unpack_pack

def Bool.toBits (b : Bool) : BitVec 1 := if b then BitVec.mk 1 else BitVec.mk 0
def Bool.ofBits (v : BitVec 1) : Bool := Nat.beq v.toNat 1
def Bool.unpack_pack : (b : Bool) → Bool.ofBits (Bool.toBits b) = b
  | .true => refl Bool.true
  | .false => refl Bool.false
instance : BitPack Bool := @BitPack.mk Bool 1 Bool.toBits Bool.ofBits Bool.unpack_pack

-- Facts about the Nat arithmetic behind slices of appends. They need the logic library
-- (verification 22a) and Nat lemmas; stated as axioms here.
axiom BitVec.slice_append_lo {m n : Nat} (a : BitVec m) (b : BitVec n) :
  BitVec.slice 0 n (BitVec.append a b) = b                  -- wishful: nat-arith-proofs
axiom BitVec.slice_append_hi {m n : Nat} (a : BitVec m) (b : BitVec n) :
  BitVec.slice n m (BitVec.append a b) = a                  -- wishful: nat-arith-proofs

-- A pair packs as `pack a +++ pack b` (first component in the high bits, as Clash).
-- (instances named and passed: with `BitPack.pack p.1` the instance is a meta when the
-- width `inst.1` is unified with `bitWidth A ()`, outside the pattern fragment)
def Prod.packBits {A B : Type} [ia : BitPack A] [ib : BitPack B] (p : A × B) : BitVec (bitWidth A () + bitWidth B ()) :=
  @BitPack.pack A ia p.1 +++ @BitPack.pack B ib p.2
def Prod.unpackBits {A B : Type} [ia : BitPack A] [ib : BitPack B] (v : BitVec (bitWidth A () + bitWidth B ())) : A × B :=
  (@BitPack.unpack A ia (BitVec.slice (bitWidth B ()) (bitWidth A ()) v), @BitPack.unpack B ib (BitVec.slice 0 (bitWidth B ()) v))
axiom Prod.unpack_pack {A B : Type} [BitPack A] [BitPack B] (p : A × B) :
  Prod.unpackBits (Prod.packBits p) = p                     -- wishful: nat-arith-proofs
-- (the parts are applied explicitly: unifying the law's type with metas for the implicit
-- arguments is outside the pattern fragment)
instance {A B : Type} [ia : BitPack A] [ib : BitPack B] : BitPack (A × B) :=
  @BitPack.mk (A × B) (bitWidth A () + bitWidth B ()) (@Prod.packBits A B ia ib) (@Prod.unpackBits A B ia ib)
    (@Prod.unpack_pack A B ia ib)

-- `Option A`: a valid bit on top of the payload; `none` is all zeros.
def Option.packBits {A : Type} [ia : BitPack A] : Option A → BitVec (1 + bitWidth A ())
  | .none => BitVec.mk 0
  | .some a => BitVec.ofNat 1 1 +++ @BitPack.pack A ia a
def Option.unpackBits {A : Type} [ia : BitPack A] (v : BitVec (1 + bitWidth A ())) : Option A :=
  if BitVec.msb v then Option.some (@BitPack.unpack A ia (BitVec.slice 0 (bitWidth A ()) v)) else Option.none
axiom Option.unpack_pack {A : Type} [BitPack A] (x : Option A) :
  Option.unpackBits (Option.packBits x) = x                 -- wishful: nat-arith-proofs
instance {A : Type} [ia : BitPack A] : BitPack (Option A) :=
  @BitPack.mk (Option A) (1 + bitWidth A ()) (@Option.packBits A ia) (@Option.unpackBits A ia) (@Option.unpack_pack A ia)

-- `Vec A n`: element 0 in the high bits. HD7 erases the length inside the vector, so the
-- instance takes `{ω n}` and recursion runs on the number, not the vector.
def Vec.packBits {A : Type} [ia : BitPack A] : (ω n : Nat) → Vec A n → BitVec (n * bitWidth A ())
  | .zero, .nil => BitVec.mk 0
  | .succ m, .cons x xs => @BitPack.pack A ia x +++ Vec.packBits m xs
def Vec.unpackBits {A : Type} [ia : BitPack A] : (ω n : Nat) → BitVec (n * bitWidth A ()) → Vec A n
  | .zero, _ => .nil
  | .succ m, v => .cons (@BitPack.unpack A ia (BitVec.slice (m * bitWidth A ()) (bitWidth A ()) v))
                        (Vec.unpackBits m (BitVec.slice 0 (m * bitWidth A ()) v))
axiom Vec.unpack_pack {A : Type} [BitPack A] {n : Nat} (v : Vec A n) :
  Vec.unpackBits n (Vec.packBits n v) = v                   -- wishful: nat-arith-proofs
instance {A : Type} [ia : BitPack A] {ω n : Nat} : BitPack (Vec A n) :=
  @BitPack.mk (Vec A n) (n * bitWidth A ()) (@Vec.packBits A ia n) (@Vec.unpackBits A ia n) (@Vec.unpack_pack A ia n)

-- `Fin n` in ⌈log₂ n⌉ bits; out-of-range codes wrap.
axiom Nat.mod_lt_succ (x m : Nat) : Nat.lt (Nat.mod x (Nat.succ m)) (Nat.succ m) = .true   -- wishful: nat-arith-proofs
def Fin.ofNat (ω m : Nat) (x : Nat) : Fin (Nat.succ m) := Fin.mk (Nat.mod x (Nat.succ m)) (Nat.mod_lt_succ x m)
def Fin.pack {ω m : Nat} (i : Fin (Nat.succ m)) : BitVec (Nat.clog2 (Nat.succ m)) := BitVec.ofNat (Nat.clog2 (Nat.succ m)) i.val
def Fin.unpack {ω m : Nat} (v : BitVec (Nat.clog2 (Nat.succ m))) : Fin (Nat.succ m) := Fin.ofNat m v.toNat
axiom Fin.unpack_pack {m : Nat} (i : Fin (Nat.succ m)) : Fin.unpack (Fin.pack i) = i   -- wishful: nat-arith-proofs
instance {ω m : Nat} : BitPack (Fin (Nat.succ m)) :=
  @BitPack.mk (Fin (Nat.succ m)) (Nat.clog2 (Nat.succ m)) Fin.pack Fin.unpack Fin.unpack_pack

------------------------------------------------------------------------------------
-- User types: an enum or a small inductive gets its instance derived (HD8). The tag is
-- ⌈log₂ #ctors⌉ bits in the high bits; the fields are packed as a product, padded to the
-- widest constructor.
--
--   inductive Light where | red | amber | green
--   deriving instance BitPack for Light                  -- wishful: deriving-bitpack
--
-- (The examples below write the derive line, and a hand-written instance until it lands.)

-- Checks. Wanted as kernel tests (`def t : (…).toNat = 44 := refl 44`), but holes in a
-- definition's *type* (the implicit width of `BitVec.add`, a pending `BitPack` instance)
-- are solved only at the end of the command, after the body has been checked against
-- the type with the holes in it.                          -- wishful: elab-solve-type-before-body
#eval (BitVec.add (BitVec.ofNat 8 200) (BitVec.ofNat 8 100)).toNat      -- 44
#eval (BitVec.sub (BitVec.ofNat 8 3) (BitVec.ofNat 8 5)).toNat          -- 254
#eval (BitVec.append (BitVec.ofNat 4 10) (BitVec.ofNat 4 5)).toNat      -- 165
#eval BitVec.slt (BitVec.ofNat 8 255) (BitVec.ofNat 8 1)                -- .true (-1 < 1)
#eval (BitVec.ashr (BitVec.ofNat 8 128) 2).toNat                        -- 224
#eval (BitPack.pack (Bool.true, Unsigned.ofNat 3 5)).toNat              -- 13
#eval (BitPack.unpackAs (Bool × Unsigned 3) (BitVec.ofNat 4 13)).2.bits.toNat   -- 5
#eval (BitPack.pack (Option.some (Unsigned.ofNat 3 5))).toNat           -- 13
#eval (BitPack.pack (Vec.cons (Unsigned.ofNat 4 1) (Vec.cons (Unsigned.ofNat 4 2) Vec.nil))).toNat   -- 18
#eval Signed.toInt (Signed.ofInt 8 (Int.negSucc 4))                     -- .negSucc 4 (-5)
-- the one that does check as a kernel test: no implicit widths, no instances
def bits_ofNat_wraps : (BitVec.ofNat 8 300).toNat = 44 := refl 44

-- Numerals and operators, as HD9 will let us write them
def u8sum : Unsigned 8 := 200 + 100                           -- wishful: numeric-classes-bitvec
def s8neg : Signed 8 := 3 - 5                                 -- wishful: numeric-classes-bitvec
#eval Unsigned.toNat u8sum                                    -- 44
