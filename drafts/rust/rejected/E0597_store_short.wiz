import RsCore
-- REJECTED (Rust E0597: a reference stored into a longer-lived place). check.sh expects
-- a type error.
-- fn remember {'a 'b 'm} {'a : 'b} (slot : &'m mut Option (&'b U64)) (x : &'a U64) : Unit
-- fn bad () : Unit := { let a := 3; let mut slot := .some (&a);
--                       { let b := 5; remember (&mut slot) (&b) }; … }
-- `slot` holds references of a's region ρa; storing `&b : Shr ρb U64` needs
-- `Outlives ρb ρa`, and the only evidence in scope is the other way round.
def remember {ρa ρb ρm : Region} (0 h : Outlives ρa ρb) (slot : Uniq ρm (Option (Shr ρb U64))) (x : Shr ρa U64) :
    Result (Unit × Uniq ρm (Option (Shr ρb U64))) :=
  .ok ((), Uniq.set slot (Option.some (Shr.weaken h x)))
def bad : Result Unit :=
  Shr.borrow Region.static (U64.lit 3) (fun ρa ha a =>
    let slot := Option.some a;
    Shr.borrow ρa (U64.lit 5) (fun ρb hb b =>
      match Uniq.borrow ρb slot (fun ρm hm slot rs => remember hb rs b) with
      | .ok q => .ok ()
      | .err e => .err e))
