import RsCore
-- REJECTED (Rust E0597: `b` does not live long enough). check.sh expects a type error.
-- fn longest {'a 'b} {'a : 'b} (x : &'a U64) (y : &'b U64) : &'b U64
-- fn bad () : U64 := { let a := 3; let r := { let b := 5; longest (&a) (&b) }; *r }
-- The result of `longest` is a `Shr ρb U64`; it can't leave b's scope, whose result
-- type is chosen outside it (where ρb doesn't exist).
def longest {ρa ρb : Region} (0 h : Outlives ρa ρb) (x : Shr ρa U64) (y : Shr ρb U64) : Result (Shr ρb U64) :=
  match U64.lt x.val y.val with
  | .true => .ok y
  | .false => .ok (Shr.weaken h x)
def bad : Result U64 :=
  Shr.borrow Region.static (U64.lit 3) (fun ρa ha a =>
    match Shr.borrow ρa (U64.lit 5) (fun ρb hb b => longest hb a b) with
    | .ok r => .ok r.val
    | .err e => .err e)
