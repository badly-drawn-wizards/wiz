import RsCore
-- REJECTED (not a Rust program: hand-written Wiz). check.sh expects it to fail.
-- A borrow handle can't be forged: `Shr.mk` is private to lib/Region.wiz (docs/stages/13-language.md, 13b),
-- so `&'a U64` for an arbitrary `'a` (here one that outlives everything the caller has)
-- can't be made from a value. Elsewhere `Shr ρ A` is opaque, so a tuple or a look-alike
-- structure doesn't convert to it either.
def forge {ρ : Region} (x : U64) : Shr ρ U64 := Shr.mk x
