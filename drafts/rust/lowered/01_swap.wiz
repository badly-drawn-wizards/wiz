import RsCore
-- Lowering of drafts/rust/surface/01_swap.wiz (rules: drafts/rust/LOWERING.md).
-- `&mut` arguments are values in and values out (L3); regions are erased indices (L1).

-- fn swap {'a 'b} (x : &'a mut U64) (y : &'b mut U64) : Unit
def swap {ρ₁ ρ₂ : Region} (x : U64) (y : U64) : Result (Unit × U64 × U64) :=
  let t := x;                        -- let t := *x        (U64 is Copy)
  let x := y;                        -- *x := *y
  let y := t;                        -- *y := t
  .ok ((), x, y)                     -- hand back the two borrows, in order

-- fn mem_swap {'a 'b} {T : Type} (x : &'a mut T) (y : &'b mut T) : Unit := mem.swap x y
-- (a move out of a borrow is only allowed through `mem.swap`/`mem.replace`; lowered,
-- it is just exchanging the two values)
def mem_swap {ρ₁ ρ₂ : Region} {T : Type} (x : T) (y : T) : Result (Unit × T × T) :=
  .ok ((), y, x)

-- fn main () : (U64 × U64) := { let mut a := 1; let mut b := 2; swap (&mut a) (&mut b); (a, b) }
def main : Result (U64 × U64) :=
  let a := U64.lit 1;
  let b := U64.lit 2;
  match @swap Region.static Region.static a b with   -- the call's regions end here
  | .ok r => (let a := r.2.1;
    let b := r.2.2;
    .ok (a, b))
  | .err e => .err e

#eval Result.map (fun (p : U64 × U64) => (p.1.val, p.2.val)) main
-- (2, 1)
#eval Result.map (fun (r : Unit × List Nat × List Nat) => r.2) (@mem_swap Region.static Region.static (List Nat) (List.cons 1 List.nil) List.nil)
