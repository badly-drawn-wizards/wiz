import RsCore
-- Lowering of drafts/rust/surface/01_swap.wiz (rules: drafts/rust/LOWERING.md).
-- `&'a mut T` arguments are `Uniq ρ T` handles, values in and values out (L3); `'a` is
-- an erased region `ρ`, part of the handle's type (L1). Call sites borrow locals in
-- scopes with fresh regions (L20), and the callee's regions are inferred from the
-- handles (L17).

-- fn swap {'a 'b} (x : &'a mut U64) (y : &'b mut U64) : Unit
def swap {ρ₁ ρ₂ : Region} (x : Uniq ρ₁ U64) (y : Uniq ρ₂ U64) : Result (Unit × Uniq ρ₁ U64 × Uniq ρ₂ U64) :=
  let t := x.val;                    -- let t := *x        (U64 is Copy)
  let x := Uniq.set x y.val;         -- *x := *y
  let y := Uniq.set y t;             -- *y := t
  .ok ((), x, y)                     -- hand back the two borrows, in order

-- fn mem_swap {'a 'b} {T : Type} (x : &'a mut T) (y : &'b mut T) : Unit := mem.swap x y
-- (a move out of a borrow is only allowed through `mem.swap`/`mem.replace`; lowered,
-- it is just exchanging the two values)
def mem_swap {ρ₁ ρ₂ : Region} {T : Type} (x : Uniq ρ₁ T) (y : Uniq ρ₂ T) : Result (Unit × Uniq ρ₁ T × Uniq ρ₂ T) :=
  let t := x.val;
  .ok ((), Uniq.set x y.val, Uniq.set y t)

-- fn main () : (U64 × U64) := { let mut a := 1; let mut b := 2; swap (&mut a) (&mut b); (a, b) }
-- Each `&mut` is a scope with a fresh region (`ρa`, then `ρb` inside it); inside, the
-- lender's name is a `Lent` token. A scope's body hands its borrow back last; the
-- outer borrow `ra` leaves the inner scope as part of its result (its region `ρa` is
-- in scope there).
def main : Result (U64 × U64) :=
  let a := U64.lit 1;
  let b := U64.lit 2;
  match Uniq.borrow Region.static a (fun ρa ha a ra =>       -- &mut a
    match Uniq.borrow ρa b (fun ρb hb b rb =>                -- &mut b
      match swap ra rb with                                  -- swap {ρa ρb}
      | .ok r => let (u, rarb) := r; let (ra, rb) := rarb; .ok (ra, rb)          -- (ra, rb) handed back
      | .err e => .err e) with
    | .ok q => let (ra, b) := q; .ok (b, ra)                -- the borrow of b ended: (b, ra)
    | .err e => .err e) with
  | .ok p => let (b, a) := p; .ok (a, b)                    -- the borrow of a ended: (a, b)
  | .err e => .err e

#eval Result.map (fun (p : U64 × U64) => (p.1.val, p.2.val)) main
-- (2, 1)

def swapLists (xs ys : List Nat) : Result (List Nat × List Nat) :=
  match Uniq.borrow Region.static xs (fun ρx hx xs rx =>
    match Uniq.borrow ρx ys (fun ρy hy ys ry =>
      match mem_swap rx ry with
      | .ok r => let (u, rxry) := r; let (rx, ry) := rxry; .ok (rx, ry)
      | .err e => .err e) with
    | .ok q => let (rx, ys) := q; .ok (ys, rx)
    | .err e => .err e) with
  | .ok p => let (ys, xs) := p; .ok (xs, ys)
  | .err e => .err e
#eval swapLists (List.cons 1 List.nil) List.nil
-- .ok (.nil, .cons 1 .nil)
