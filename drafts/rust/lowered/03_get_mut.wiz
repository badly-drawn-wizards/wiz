import RsCore
-- Lowering of drafts/rust/surface/03_get_mut.wiz (rules: drafts/rust/LOWERING.md).
-- A function returning `&'a mut` (L4): its result is a `Mut ρ A S`, a borrowed value and
-- the backward function to the lender. Its body is a place expression, so it is a place
-- function (L10): the front end also emits its lens laws and its spec.

-- fn get_mut {'a} (v : &'a mut Vec U64) (i : USize) : &'a mut U64 := &mut v[i]
def get_mut {ρ : Region} (v : Vec U64) (i : U64) : Result (Mut ρ U64 (Vec U64)) :=
  Vec.indexMut i v

-- generated: `get_mut` is a lawful partial lens (a place function), at quantity 0
def get_mut.lawful {ρ : Region} (i : U64) : PLens.Lawful (fun (v : Vec U64) => @get_mut ρ v i) :=
  Vec.indexMut_lawful i

-- the spec, `ensures *result = old(v)[i] ∧ final(v) = old(v).set i final(result)`:
-- `final(v)` desugars to the backward function applied to `final(result)`, a variable
-- `fin` (no prophecy axiom). `Vec.index`/`set` are the model's.
def List.set {A : Type} : Nat → List A → A → List A
  | _, .nil, _ => .nil
  | .zero, .cons _ xs, y => .cons y xs
  | .succ i, .cons x xs, y => .cons x (List.set i xs y)
def get_mut.spec {ρ : Region} (v : Vec U64) (i : U64) : Prop :=
  Result.All (fun (r : Mut ρ U64 (Vec U64)) =>
    (Vec.index v i = .ok r.1) × ((fin : U64) → (r.2 fin).items = List.set i.val v.items fin))
    (@get_mut ρ v i)

-- fn bump (v : &mut Vec U64) : Unit := { *get_mut (&mut v) 1 += 10 }
def bump {ρ : Region} (v : Vec U64) : Result (Unit × Vec U64) :=
  match @get_mut Region.static v (U64.lit 1) with   -- the borrow `r` of v (v is frozen)
  | .ok r =>
    match U64.add r.1 (U64.lit 10) with             -- *r + 10 (may overflow)
    | .ok x =>
      let v := r.2 x;                               -- the borrow ends: put the final value
      .ok ((), v)
    | .err e => .err e                              -- a panic drops `r` (and its hole)
  | .err e => .err e

def run (xs : List Nat) : Result (List Nat) :=
  match @bump Region.static (Vec.ofList (List.map U64.mk xs)) with
  | .ok r => .ok (List.map U64.toNat r.2.items)
  | .err e => .err e

#eval run (List.cons 1 (List.cons 2 (List.cons 3 List.nil)))
-- .ok [1, 12, 3]
#eval run (List.cons 1 List.nil)
-- .err .outOfBounds

-- The spec's proof. (The front end would emit these from the place expression `v[i]`;
-- they are library lemmas about `List.atL`, instantiated.)
def List.atL_set_under {A : Type} (x : A) (i : Nat) (xs : List A) : (r : Result (Store A (List A))) →
    Result.All (fun (st : Store A (List A)) => (fin : A) → st.2 fin = List.set i xs fin) r →
    Result.All (fun (st : Store A (List A)) => (fin : A) → st.2 fin = List.cons x (List.set i xs fin))
      (Store.underR (List.cons x) r)
  | .ok st, h => fun fin => @Optic.congrArg (List A) (List A) (List.cons x) (st.2 fin) (List.set i xs fin) (h fin)
  | .err e, h => ()
def List.atL_set {A : Type} : (i : Nat) → (s : List A) →
    Result.All (fun (st : Store A (List A)) => (fin : A) → st.2 fin = List.set i s fin) (List.atL i s)
  | _, .nil => ()
  | .zero, .cons x xs => fun fin => refl (List.cons fin xs)
  | .succ i, .cons x xs => List.atL_set_under x i xs (List.atL i xs) (List.atL_set i xs)
def List.atL_get_under {A : Type} (x : A) (g : Option A) : (r : Result (Store A (List A))) →
    Result.All (fun (st : Store A (List A)) => g = Option.some st.1) r →
    Result.All (fun (st : Store A (List A)) => g = Option.some st.1) (Store.underR (List.cons x) r)
  | .ok st, h => h
  | .err e, h => ()
def List.atL_get {A : Type} : (i : Nat) → (s : List A) →
    Result.All (fun (st : Store A (List A)) => List.getOpt i s = Option.some st.1) (List.atL i s)
  | _, .nil => ()
  | .zero, .cons x xs => refl (Option.some x)
  | .succ i, .cons x xs => List.atL_get_under x (List.getOpt i xs) (List.atL i xs) (List.atL_get i xs)

def get_mut.spec_under {ρ : Region} (v : Vec U64) (i : U64) : (r : Result (Store U64 (List U64))) →
    Result.All (fun (st : Store U64 (List U64)) => List.getOpt i.val v.items = Option.some st.1) r →
    Result.All (fun (st : Store U64 (List U64)) => (fin : U64) → st.2 fin = List.set i.val v.items fin) r →
    Result.All (fun (r : Mut ρ U64 (Vec U64)) =>
      (Vec.index v i = .ok r.1) × ((fin : U64) → (r.2 fin).items = List.set i.val v.items fin))
      (Store.underR Vec.mkL r)
  | .ok st, hg, hs =>
    (@Optic.subst (Option U64) (fun (o : Option U64) => Option.okOr .outOfBounds o = Result.ok st.1)
       (Option.some st.1) (List.getOpt i.val v.items) (Optic.sym hg) (refl (Result.ok st.1)),
     hs)
  | .err e, hg, hs => ()
def get_mut.spec_holds {ρ : Region} (v : Vec U64) (i : U64) : get_mut.spec v i :=
  @get_mut.spec_under ρ v i (@List.atL U64 i.val v.items) (@List.atL_get U64 i.val v.items) (@List.atL_set U64 i.val v.items)
