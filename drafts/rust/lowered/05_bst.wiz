import RsCore
-- Lowering of drafts/rust/surface/05_bst.wiz (rules: drafts/rust/LOWERING.md).
-- Three lowerings of BST insertion: recursive (an `&mut` argument handed back), a cursor
-- loop as a chain of borrows (`Store.comp`: closures), and the same loop with the chain
-- defunctionalised into a zipper (frames as data, R6c), which reuses every node.

-- enum Tree where | leaf | node (key : U64) (left : Box Tree) (right : Box Tree)
inductive Tree where
  | leaf
  | node (key : U64) (left : Tree) (right : Tree)

-- fn insert {'a} (t : &'a mut Tree) (k : U64) : Unit := match t with ...
-- Matching on `&mut Tree` binds `left`, `right` as `&mut Tree` reborrows of the fields
-- (and `key` as `&U64`): the node is unpacked, the reborrow is handed back, the node is
-- rebuilt in the same block (so Perceus reuses the cell).
def insert {ρ : Region} : Tree → U64 → Result (Unit × Tree)
  | .leaf, k =>
    let t := Tree.node k .leaf .leaf;           -- *t := .node k .leaf .leaf
    .ok ((), t)
  | .node key left right, k => match U64.lt k key with
    | .true => (match insert left k with      -- insert left k
      | .ok r =>
        let left := r.2;
        .ok ((), Tree.node key left right)
      | .err e => .err e)
    | .false => match U64.lt key k with
      | .true => (match insert right k with   -- insert right k
        | .ok r =>
          let right := r.2;
          .ok ((), Tree.node key left right)
        | .err e => .err e)
      | .false => .ok ((), Tree.node key left right)

-- fn insert_loop {'a} (t : &'a mut Tree) (k : U64) : Unit := {
--   let mut cur := t;                                        -- cur : &'a mut Tree
--   while let .node key left right := cur do {
--     if k < *key then cur := left else if *key < k then cur := right else return () };
--   *cur := .node k .leaf .leaf }
-- `cur` is a borrow of the whole tree (`Mut ρ Tree Tree`, starting as `Lens.id`); each
-- step composes it with a borrow of a child, whose backward function rebuilds the node.
partial def insert_loop.loop0 {ρ : Region} (k : U64) (cur : Mut ρ Tree Tree) :
    Result (Flow (Mut ρ Tree Tree) (Unit × Tree)) :=
  match cur.1 with
  | .node key left right => (match U64.lt k key with
    | .true =>
      let cur := Store.comp cur (fun (_ : Tree) => (left, fun (l : Tree) => Tree.node key l right));
      @insert_loop.loop0 ρ k cur
    | .false => match U64.lt key k with
      | .true =>
        let cur := Store.comp cur (fun (_ : Tree) => (right, fun (r : Tree) => Tree.node key left r));
        @insert_loop.loop0 ρ k cur
      | .false =>
        let t := Store.extract cur;            -- return (): every borrow ends unchanged
        .ok (.ret ((), t)))
  | .leaf => .ok (.brk cur)

def insert_loop {ρ : Region} (t : Tree) (k : U64) : Result (Unit × Tree) :=
  let cur := Lens.id t;
  match @insert_loop.loop0 ρ k cur with
  | .ok fl => (match fl with
    | .brk cur =>
      let cur := Store.mk (Tree.node k .leaf .leaf) cur.2;  -- *cur := .node k .leaf .leaf
      let t := Store.extract cur;                           -- the borrow of t ends
      .ok ((), t)
    | .ret r => .ok r)
  | .err e => .err e

-- The same loop with the chain of backward closures defunctionalised: a frame per
-- step (the node with a hole), `plug` is the backward function. Every frame reuses
-- the node it came from, and `plug` reuses the frame.
inductive Path where
  | top
  | inLeft (key : U64) (right : Tree) (up : Path)
  | inRight (key : U64) (left : Tree) (up : Path)

def Path.plug : Path → Tree → Tree
  | .top, t => t
  | .inLeft key right up, t => Path.plug up (Tree.node key t right)
  | .inRight key left up, t => Path.plug up (Tree.node key left t)

partial def insert_zip.loop0 (k : U64) (cur : Tree) (path : Path) : Result (Flow (Tree × Path) (Unit × Tree)) :=
  match cur with
  | .node key left right => (match U64.lt k key with
    | .true => insert_zip.loop0 k left (Path.inLeft key right path)
    | .false => match U64.lt key k with
      | .true => insert_zip.loop0 k right (Path.inRight key left path)
      | .false => .ok (.ret ((), Path.plug path (Tree.node key left right))))
  | .leaf => .ok (.brk (cur, path))

def insert_zip {ρ : Region} (t : Tree) (k : U64) : Result (Unit × Tree) :=
  match insert_zip.loop0 k t Path.top with
  | .ok fl => (match fl with
    | .brk cp => .ok ((), Path.plug cp.2 (Tree.node k .leaf .leaf))
    | .ret r => .ok r)
  | .err e => .err e

-- running them
def Tree.toNats : Tree → List Nat
  | .leaf => .nil
  | .node k l r => List.append (Tree.toNats l) (.cons k.val (Tree.toNats r))
def build (ins : Tree → U64 → Result (Unit × Tree)) : List Nat → Tree → Result Tree
  | .nil, t => .ok t
  | .cons k ks, t => match ins t (U64.mk k) with
    | .ok r => build ins ks r.2
    | .err e => .err e
def keys : List Nat := .cons 5 (.cons 2 (.cons 8 (.cons 2 (.cons 7 (.cons 1 .nil)))))

#eval Result.map Tree.toNats (build (@insert Region.static) keys .leaf)
#eval Result.map Tree.toNats (build (@insert_loop Region.static) keys .leaf)
#eval Result.map Tree.toNats (build (@insert_zip Region.static) keys .leaf)
-- all three: .ok [1, 2, 5, 7, 8]
