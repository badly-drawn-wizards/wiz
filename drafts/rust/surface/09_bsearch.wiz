import Rust                                          -- wishful: command-proc-macros
-- Binary search through a shared borrow, with a spec. Lowered: drafts/rust/lowered/09_bsearch.wiz

rust                                                 -- wishful: command-proc-macros
  fn bsearch {'a} (v : &'a Vec U64) (x : U64) : Option USize   -- wishful: region-indices
    requires sorted v                                -- wishful: spec-clauses
    ensures match result with                        -- wishful: spec-clauses
      | .some i => v[i] = x
      | .none => ¬ (x ∈ v)                           -- wishful: prop-connectives
  := {
    let mut lo : USize := 0;                         -- wishful: machine-int-literals
    let mut hi := v.len;
    while lo < hi
      invariant lo ≤ hi ∧ hi ≤ v.len                 -- wishful: prop-connectives
      decreases hi - lo                              -- wishful: decreases-loops
    do {
      let mid := lo + (hi - lo) / 2;
      if v[mid] < x then lo := mid + 1
      else if x < v[mid] then hi := mid
      else return .some mid
    };
    .none
  }
end
