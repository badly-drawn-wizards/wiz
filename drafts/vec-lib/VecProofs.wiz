-- Facts about particular vectors by `rfl`: the kernel gets stuck on the casts in
-- `Vec.get`/`head`/`tail`/`splitAt`/`reverse` (same cause as above: match motives
-- without sorts). Move to the `vec` test group after agent/elab-sorts lands.
def v3 : Vec Nat 3 := .cons 10 (.cons 20 (.cons 30 .nil))
def t1 : Vec.get v3 (Fin.of 3 1 rfl) = 20 := rfl
def t2 : Vec.head (Vec.tail v3) = 20 := rfl
def t3 : Vec.toList (Vec.splitAt 2 v3).1 = .cons 10 (.cons 20 .nil) := rfl
def t4 : Vec.reverse (Vec.reverse v3) = v3 := rfl
def t5 : BitVec.ofVec (BitVec.toVec (BitVec.ofNat 8 173)) = BitVec.ofNat 8 173 := rfl   -- needs `import BitVec`

-- rfl at an equation the elaborator and the kernel compute to different shapes (a
-- numeral on one side, a constructor on the other). Kept as a `vec` test of today's
-- behaviour ("known bug: …"); it should check once fixed.
def w3 : Vec Nat 3 := .cons 1 (.cons 2 (.cons 3 .nil))
def t6 : Vec.length (Vec.map Nat.succ w3) = 3 := rfl          -- wishful: unify-computed-equations
