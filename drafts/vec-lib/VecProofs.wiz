import Vec
-- `get_set` and `get_map` moved to lib/Vec.wiz once agent/elab-sorts landed (match
-- motives with sorts). `get_replicate` and the `rfl` facts below are rejected by the
-- kernel because of the `rfl` shape bug (wishful: unify-computed-equations).

def Vec.get_replicate {A : Type} (x : A) : (n : Nat) → (i : Fin n) → Vec.get (Vec.replicate n x) i = x
  | .succ _, .mk .zero _ => rfl
  | .succ n, .mk (.succ i) h => Vec.get_replicate x n (@Fin.mk _ i h)
  | .zero, .mk .zero h => absurd h.1
  | .zero, .mk (.succ _) h => absurd h.1

