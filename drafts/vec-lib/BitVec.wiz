import BitVec
-- BitVec as it should read once the missing features land; lib/BitVec.wiz has the
-- working equivalents (named functions).

-- Numerals and operators by type class (HD9; lib: `BitVec.add`, `BitVec.ofNat 8 200`).
instance {n : Nat} : Add (BitVec n) := ⟨BitVec.add⟩              -- wishful: numeric-classes-bitvec
instance {n : Nat} : Mul (BitVec n) := ⟨BitVec.mul⟩              -- wishful: numeric-classes-bitvec
instance {n : Nat} : OfNat (BitVec n) := ⟨BitVec.ofNat n⟩        -- wishful: numeric-classes-bitvec
def mac {n : Nat} (a b c : BitVec n) : BitVec n := a * b + c    -- wishful: numeric-classes-bitvec
def x : BitVec 8 := 200 + 100                                   -- wishful: numeric-classes-bitvec

-- Native words when the width is small (RD9/RD10).
attribute [implemented_by wiz_u64_add_wrap] BitVec.add           -- wishful: implemented-by
