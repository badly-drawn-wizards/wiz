import Vec
-- Vec code as it should read once the missing features land; lib/Vec.wiz has the
-- working equivalents.

-- Direct `last`/`init` (lib: `Vec.lastFrom`, `Vec.initFrom` helpers).
def Vec.last' {A : Type} {0 n : Nat} : Vec A (Nat.succ n) → A
  | .cons x .nil => x
  | .cons _ xs@(.cons _ _) => Vec.last' xs                      -- wishful: as-patterns

-- Constructor parameters from the expected type (lib: `@Fin.mk (Nat.succ n) …`).
def Fin.succ' {0 n : Nat} : Fin n → Fin (Nat.succ n)
  | .mk i h => .mk (Nat.succ i) h                                -- wishful: ctor-params-from-expected-type
def three : Fin 5 := 3                                           -- wishful: numeric-classes-bitvec

-- Vector literals (a macro over `sepBy`; lib: nested `.cons`).
def v3 : Vec Nat 3 := #v[1, 2, 3]                                -- wishful: vec-literal

-- Native vectors: the inductive `Vec` is the model, an `Array` the implementation
-- (RD10; `n` stays erased: the array knows its size).
attribute [implemented_by wiz_array_get] Vec.get                 -- wishful: implemented-by
attribute [implemented_by wiz_array_set] Vec.set                 -- wishful: implemented-by
attribute [implemented_by wiz_array_size] Vec.length             -- wishful: implemented-by
