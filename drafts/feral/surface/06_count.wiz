import Feral                                          -- wishful: command-proc-macros
-- A counter loop with `?` on a user-level Result. Lowered: drafts/feral/lowered/06_count.wiz

feral                                                 -- wishful: command-proc-macros
  struct Overflow where

  fn sum_from (s0 : U64) (n : U64) : Result U64 Overflow := {
    let mut i : U64 := 0;                            -- wishful: machine-int-literals
    let mut s := s0;
    while i < n
      invariant s0.val + i.val * (i.val - 1) / 2 = s.val   -- wishful: spec-clauses
      decreases n - i                                -- wishful: decreases-loops
    do {
      s := (s.checked_add i).ok_or Overflow ?;       -- a returned error, not a panic
      i += 1                                         -- a panic on overflow (can't happen: i < n)
    };
    .ok s
  }
end
