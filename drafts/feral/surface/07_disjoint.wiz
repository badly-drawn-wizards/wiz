import FeralCore
import Feral
-- Two mutable borrows of disjoint fields, live at once. Hand-lowered: drafts/feral/lowered/07_disjoint.wiz

feral
  struct Stats where
    hits : U64
    misses : U64

  fn bump2 (a : &mut U64) (b : &mut U64) : Unit := {
    *a += 1;
    *b += 2
  }

  fn record (s : &mut Stats) : Unit := {
    let h := &mut s.hits;                            -- s.hits and s.misses are disjoint places (L11)
    let m := &mut s.misses;
    *h += 10;
    bump2 h m                                        -- reborrows; h and m die here
  }
end

def show (r : Result (Unit × Stats)) : Result (Nat × Nat) := Result.map (fun (r : Unit × Stats) => (r.2.hits.val, r.2.misses.val)) r
def s12 : Stats := Stats.mk (U64.lit 1) (U64.lit 2)
#eval show (Uniq.borrow Region.static s12 (fun ρ h s r => record r))
-- .ok (12, 4)
