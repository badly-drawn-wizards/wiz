import FeralCore
import Feral
-- Traversing a linked list through mutable borrows. Hand-lowered: drafts/feral/lowered/11_list.wiz

feral
  enum LList where
    | nil
    | cons (head : U64) (tail : Box LList)
  struct Overflow where

  -- recursion through a reborrow of each tail
  fn incr_all {'a} (l : &'a mut LList) : Result Unit Overflow := {
    match l with
    | .nil => .ok ()
    | .cons head tail => {                           -- head, tail: places behind `l` (L15)
      *head := (head.checked_add 1).ok_or Overflow ?;
      incr_all tail
    }
  }

  -- a cursor that moves down the list: `cur := tail` shortens nothing, it reborrows
  fn push_back {'a} (l : &'a mut LList) (x : U64) : Unit := {
    let mut cur := l;
    while let .cons _ tail := cur do { cur := tail };
    *cur := .cons x .nil
  }

  fn main () : Result LList Overflow := {
    let mut l := LList.cons 1 (.cons 2 .nil);
    incr_all (&mut l) ?;
    push_back (&mut l) 7;
    .ok l                                            -- [2, 3, 7]
  }
end

def LList.toNats : LList → List Nat
  | .nil => .nil
  | .cons h t => .cons h.val (LList.toNats t)
def show : Result (Except Overflow LList) → Result (List Nat)
  | .ok (.ok l) => .ok (LList.toNats l)
  | .ok (.error _) => .err (.panic "Overflow")
  | .err e => .err e

#eval show main
-- .ok [2, 3, 7]
