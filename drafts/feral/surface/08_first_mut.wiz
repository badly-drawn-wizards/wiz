import Feral                                          -- wishful: command-proc-macros
-- Option (&mut T): a borrow that may not exist. Lowered: drafts/feral/lowered/08_first_mut.wiz

feral                                                 -- wishful: command-proc-macros
  fn first_mut {'a} (v : &'a mut Vec U64) : Option (&'a mut U64) :=   -- wishful: region-indices
    v.get_mut 0

  fn zero_first (v : &mut Vec U64) : Bool :=
    if let .some x := first_mut v then { *x := 0; true } else false
end
