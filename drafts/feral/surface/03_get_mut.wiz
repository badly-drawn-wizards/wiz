import Feral                                          -- wishful: command-proc-macros
-- Returning a mutable borrow, with a spec about its final value.
-- Lowered: drafts/feral/lowered/03_get_mut.wiz (with the generated lens laws and the spec's proof)

feral                                                 -- wishful: command-proc-macros
  fn get_mut {'a} (v : &'a mut Vec U64) (i : USize) : &'a mut U64   -- wishful: region-indices
    ensures *result = old(v)[i]                      -- wishful: spec-clauses
    ensures final(v) = old(v).set i final(result)    -- wishful: final-specs
  := &mut v[i]                                       -- a place expression: a lawful partial lens

  fn bump (v : &mut Vec U64) : Unit := {
    *get_mut (&mut v) 1 += 10                        -- wishful: machine-int-literals
  }                                                  -- the borrow ends at the `;`: v is usable again
end
