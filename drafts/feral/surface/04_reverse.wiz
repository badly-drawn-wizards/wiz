import FeralCore
import Feral
-- In-place list reversal: every cell is reused. Hand-lowered: drafts/feral/lowered/04_reverse.wiz
-- (The enum is `LList`: lowered names are unchanged, L1, and `List` is the prelude's.)

feral
  enum LList where
    | nil
    | cons (head : U64) (tail : Box LList)

  fn reverse (l : LList) : LList := {
    let mut l := l;
    let mut acc := LList.nil;
    while let .cons x tail := l do {                 -- moves the cell out of l
      acc := .cons x acc;
      l := *tail                                     -- moves out of the box
    };
    acc
  }

  fn reverse_in_place (l : &mut LList) : Unit := {
    let old := mem.take l;                           -- leaves LList.nil (the default) behind
    *l := reverse old
  }
end

def LList.toNats : LList → List Nat
  | .nil => .nil
  | .cons x xs => .cons x.val (LList.toNats xs)
def l123 : LList := .cons (U64.lit 1) (.cons (U64.lit 2) (.cons (U64.lit 3) .nil))

#eval Result.map LList.toNats (reverse l123)
-- .ok [3, 2, 1]
#eval Result.map (fun (r : Unit × LList) => LList.toNats r.2)
  (Uniq1.borrow Region.static l123 (fun ρ h l r => reverse_in_place r))
