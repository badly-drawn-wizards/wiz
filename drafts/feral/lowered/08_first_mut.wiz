import FeralCore
-- Lowering of drafts/feral/surface/08_first_mut.wiz (rules: drafts/feral/LOWERING.md).
-- `Option (&'a mut A)` from a lender `S` is `MutOpt ρ A S` = `Affine A S` (L12): `none`
-- hands the lender straight back; `some` is a borrow with its backward function, which
-- can't be applied to the wrong variant.

-- fn first_mut {'a} (v : &'a mut Vec U64) : Option (&'a mut U64) := v.get_mut 0
-- (it cannot fail, but a function returning a borrow returns a `Borrowed`, D8)
def first_mut {ρ : Region} (1 v : Uniq ρ (Vec U64)) : Borrowed (MutOpt ρ U64 (Vec U64)) (Uniq ρ (Vec U64)) :=
  .ok (Vec.getMut (U64.lit 0) v)

-- fn zero_first (v : &mut Vec U64) : Bool :=
--   if let .some x := first_mut v then { *x := 0; true } else false
-- (`first_mut` returns a borrow of `*v`: a reborrow scope, L17)
def zero_first {ρ : Region} (1 v : Uniq ρ (Vec U64)) : Result1 Bool (Uniq ρ (Vec U64)) :=
  Uniq.reborrow v (fun ρ' h v r =>
    match first_mut r with
    | .ok o => (match o with
      | .some x =>
        let 1 x := Mut.set x (U64.lit 0);           -- *x := 0
        .ok Bool.true (Mut.release x)               -- the borrow ends
      | .none r => .ok Bool.false r)                -- no borrow: the lender straight back
    | .err e r => .err e r)

-- (the same, through the library: `MutOpt.over`)
def zero_first' {ρ : Region} (1 v : Uniq ρ (Vec U64)) : Result1 Unit (Uniq ρ (Vec U64)) :=
  Uniq.reborrow v (fun ρ' h v r =>
    match first_mut r with
    | .ok o => .ok () (MutOpt.over (fun (_ : U64) => U64.lit 0) o)
    | .err e r => .err e r)

def show (r : Result (Bool × Vec U64)) : Result (Bool × List Nat) :=
  Result.map (fun (r : Bool × Vec U64) => (r.1, List.map U64.toNat r.2.items)) r
def run (v : Vec U64) : Result (Bool × List Nat) :=
  show (Uniq.borrow Region.static v (fun ρ h v r => zero_first r))
#eval run (Vec.ofList (.cons (U64.lit 7) (.cons (U64.lit 8) .nil)))
-- .ok (.true, [0, 8])
#eval run Vec.new
-- .ok (.false, [])
#eval Result.map (fun (r : Unit × Vec U64) => List.map U64.toNat r.2.items)
  (Uniq.borrow Region.static (Vec.ofList (.cons (U64.lit 7) .nil)) (fun ρ h v r => zero_first' r))
-- .ok [0]
