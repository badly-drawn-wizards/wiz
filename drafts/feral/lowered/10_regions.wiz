import FeralCore
-- Lowering of drafts/feral/surface/10_regions.wiz (rules: drafts/feral/LOWERING.md, L20–L22).
-- An outlives bound `'a : 'b` is an erased proof argument `(0 h : Outlives ρa ρb)`; a
-- reference flows into a place of a shorter region only through `Shr.weaken h`. Each
-- borrow of a local is a scope with a fresh region nested in the enclosing one, which
-- hands out `Outlives σ ρ`. The negative versions are in drafts/feral/rejected/.

-- fn longest {'a 'b} {'a : 'b} (x : &'a U64) (y : &'b U64) : &'b U64
def longest {ρa ρb : Region} (0 h : Outlives ρa ρb) (x : Shr ρa U64) (y : Shr ρb U64) : Result (Shr ρb U64) :=
  match U64.lt x.val y.val with
  | .true => .ok y
  | .false => .ok (Shr.weaken h x)                -- 'a : 'b

-- fn remember {'a 'b 'm} {'a : 'b} (slot : &'m mut Option (&'b U64)) (x : &'a U64) : Unit
def remember {ρa ρb ρm : Region} (0 h : Outlives ρa ρb) (1 slot : Uniq ρm (Option (Shr ρb U64))) (x : Shr ρa U64) :
    Result1 Unit (Uniq ρm (Option (Shr ρb U64))) :=
  .ok () (Uniq.write slot (Option.some (Shr.weaken h x)))  -- *slot := .some x   ('a : 'b)

-- fn main () : U64
-- `ra := &a` is a scope at ρa (in main's body: Region.static); `rb := &b` is a scope at
-- ρb nested in it, which hands out `hb : Outlives ρa ρb`: the evidence `longest` and
-- `remember` need. `slot` holds `Shr ρb U64` references (Rust infers that lifetime);
-- `&mut slot` is a scope at ρm nested in ρb. Nothing of region ρb can leave b's scope:
-- the result is a `U64`.
def main : Result U64 :=
  let a := U64.lit 3;
  Shr.borrow Region.static a (fun ρa ha a =>               -- let ra := &a  (`a` is the borrow now)
    let ra := a;
    let b := U64.lit 5;
    Shr.borrow ρa b (fun ρb hb b =>                        -- let rb := &b
      let rb := b;
      match longest hb ra rb with                          -- longest {ρa ρb} hb ra rb
      | .ok m =>
        let slot := (Option.none : Option (Shr ρb U64));   -- let mut slot := .none
        (match Uniq.borrow ρb slot (fun ρm hm slot rs => remember hb rs ra) with   -- remember (&mut slot) ra
        | .ok q =>
          let (u, slot) := q;
          (match slot with
          | .some s => U64.add s.val m.val                 -- *s + *m
          | .none => .ok m.val)
        | .err e => .err e)
      | .err e => .err e))

#eval Result.map U64.toNat main
-- .ok 8
