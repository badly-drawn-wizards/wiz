import FeralCore
-- Lowering of drafts/feral/surface/05_bst.wiz (rules: drafts/feral/LOWERING.md).
-- Three lowerings of BST insertion: recursive (an `&mut` argument handed back), a cursor
-- loop as a chain of borrows (`Store.comp`: closures), and the same loop with the chain
-- defunctionalised into a zipper (frames as data, R6c), which reuses every node.

-- enum Tree where | leaf | node (key : U64) (left : Box Tree) (right : Box Tree)
inductive Tree where
  | leaf
  | node (key : U64) (left : Tree) (right : Tree)

-- fn insert {'a} (t : &'a mut Tree) (k : U64) : Unit := match t with ...
-- Matching on `&mut Tree` binds `left`, `right` as `&mut Tree` reborrows of the fields
-- (and `key` as `&U64`, L15): the node is unpacked inside a reborrow scope of `t` (so `t`
-- is a `Lent` token while its fields are out), each field reborrow is a borrow of the
-- unpacked local (a fresh region inside ρ'), and the node is rebuilt in the same block
-- (so Perceus reuses the cell).
-- `partial`: the recursive call is on the handle of a field, made inside a scope's
-- lambda, which structural recursion doesn't see through (wishful: reborrow-recursion).
partial def insert {ρ : Region} (t : Uniq ρ Tree) (k : U64) : Result (Unit × Uniq ρ Tree) :=
  Uniq.reborrow t (fun ρ' h t r =>
    match r.val with
    | .leaf => .ok ((), Uniq.set r (Tree.node k .leaf .leaf))   -- *t := .node k .leaf .leaf
    | .node key left right => match U64.lt k key with
      | .true => (match Uniq.borrow ρ' left (fun ρl hl left rl => insert rl k) with   -- insert left k
        | .ok q =>
          let (u, left) := q;
          .ok ((), Uniq.set r (Tree.node key left right))
        | .err e => .err e)
      | .false => match U64.lt key k with
        | .true => (match Uniq.borrow ρ' right (fun ρr hr right rr => insert rr k) with   -- insert right k
          | .ok q =>
            let (u, right) := q;
            .ok ((), Uniq.set r (Tree.node key left right))
          | .err e => .err e)
        | .false => .ok ((), Uniq.set r (Tree.node key left right)))

-- fn insert_loop {'a} (t : &'a mut Tree) (k : U64) : Unit := {
--   let mut cur := t;                                        -- cur : &'a mut Tree
--   while let .node key left right := cur do {
--     if k < *key then cur := left else if *key < k then cur := right else return () };
--   *cur := .node k .leaf .leaf }
-- `cur` is a borrow of the whole tree (`Mut ρ Tree Tree`, starting as `Mut.whole t`); each
-- step composes it with a borrow of a child, whose backward function rebuilds the node.
-- The region stays `ρ`: `t` is moved into the cursor, and the cursor's release gives it back.
partial def insert_loop.loop0 {ρ : Region} (k : U64) (cur : Mut ρ Tree Tree) :
    Result (Flow (Mut ρ Tree Tree) (Unit × Uniq ρ Tree)) :=
  match Mut.get cur with
  | .node key left right => (match U64.lt k key with
    | .true =>
      let cur := Mut.comp cur (fun (_ : Tree) => (left, fun (l : Tree) => Tree.node key l right));
      insert_loop.loop0 k cur
    | .false => match U64.lt key k with
      | .true =>
        let cur := Mut.comp cur (fun (_ : Tree) => (right, fun (r : Tree) => Tree.node key left r));
        insert_loop.loop0 k cur
      | .false =>
        let t := Mut.release cur;              -- return (): every borrow ends unchanged
        .ok (.ret ((), t)))
  | .leaf => .ok (.brk cur)

def insert_loop {ρ : Region} (t : Uniq ρ Tree) (k : U64) : Result (Unit × Uniq ρ Tree) :=
  let cur := Mut.whole t;
  match insert_loop.loop0 k cur with
  | .ok fl => (match fl with
    | .brk cur =>
      let cur := Mut.set cur (Tree.node k .leaf .leaf);    -- *cur := .node k .leaf .leaf
      let t := Mut.release cur;                            -- the borrow of t ends
      .ok ((), t)
    | .ret r => .ok r)
  | .err e => .err e

-- The same loop with the chain of backward closures defunctionalised: a frame per
-- step (the node with a hole), `plug` is the backward function. Every frame reuses
-- the node it came from, and `plug` reuses the frame.
inductive Path where
  | top
  | inLeft (key : U64) (right : Tree) (up : Path)
  | inRight (key : U64) (left : Tree) (up : Path)

def Path.plug : Path → Tree → Tree
  | .top, t => t
  | .inLeft key right up, t => Path.plug up (Tree.node key t right)
  | .inRight key left up, t => Path.plug up (Tree.node key left t)

partial def insert_zip.loop0 (k : U64) (cur : Tree) (path : Path) : Result (Flow (Tree × Path) (Unit × Tree)) :=
  match cur with
  | .node key left right => (match U64.lt k key with
    | .true => insert_zip.loop0 k left (Path.inLeft key right path)
    | .false => match U64.lt key k with
      | .true => insert_zip.loop0 k right (Path.inRight key left path)
      | .false => .ok (.ret ((), Path.plug path (Tree.node key left right))))
  | .leaf => .ok (.brk (cur, path))

def insert_zip {ρ : Region} (t : Uniq ρ Tree) (k : U64) : Result (Unit × Uniq ρ Tree) :=
  match insert_zip.loop0 k t.val Path.top with
  | .ok fl => (match fl with
    | .brk cp => let (cur, path) := cp; .ok ((), Uniq.set t (Path.plug path (Tree.node k .leaf .leaf)))
    | .ret r => let (u, t2) := r; .ok ((), Uniq.set t t2))
  | .err e => .err e

-- running them
def Tree.toNats : Tree → List Nat
  | .leaf => .nil
  | .node k l r => List.append (Tree.toNats l) (.cons k.val (Tree.toNats r))
def build (ins : (0 ρ : Region) → Uniq ρ Tree → U64 → Result (Unit × Uniq ρ Tree)) : List Nat → Tree → Result Tree
  | .nil, t => .ok t
  | .cons k ks, t => match Uniq.borrow Region.static t (fun ρ h t r => ins ρ r (U64.mk k)) with
    | .ok r => let (u, t) := r; build ins ks t
    | .err e => .err e
def keys : List Nat := .cons 5 (.cons 2 (.cons 8 (.cons 2 (.cons 7 (.cons 1 .nil)))))

#eval Result.map Tree.toNats (build (fun ρ => @insert ρ) keys .leaf)
#eval Result.map Tree.toNats (build (fun ρ => @insert_loop ρ) keys .leaf)
#eval Result.map Tree.toNats (build (fun ρ => @insert_zip ρ) keys .leaf)
-- all three: .ok [1, 2, 5, 7, 8]
