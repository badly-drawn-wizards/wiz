import FeralCore
-- WISHFUL (linear-case): borrow handles at quantity 1, so the kernel rejects E0499/E0502
-- by linearity instead of relying on the lowering's shape (Lent rebinding). Doesn't
-- check today: a linear variable can't be used inside a `match` alternative (methods of
-- `ind` are scaled by ω) and `Result`'s field is ω. See
-- /workspace/wiz-notes/wishful/linear-case.md.

-- a result whose payload is used once                                -- wishful: linear-case
inductive Result1 (A : Type) where
  | ok (1 a : A)
  | err (e : Error)

-- the scope's body gets the handle at 1 and must hand it back exactly once
def Uniq.borrow1 {S B : Type} (0 σ : Region) (1 s : S)
    (1 body : (0 ρ : Region) → (0 h : Outlives σ ρ) → (1 r : Uniq ρ S) → Result1 ((ω b : B) × Uniq ρ S)) :
    Result1 ((ω b : B) × S) :=
  match1 body σ (Outlives.refl σ) (Uniq.mk s) with                    -- wishful: linear-case
  | .ok p => let 1 (b, r) := p; .ok (b, r.val)
  | .err e => .err e

-- `*x` without consuming `x`: the value (copied, ω) and the handle back
def Uniq.read {ρ : Region} {A : Type} (1 r : Uniq ρ A) : (ω a : A) × Uniq ρ A := (r.val, r)

def swap {ρ₁ ρ₂ : Region} (1 x : Uniq ρ₁ U64) (1 y : Uniq ρ₂ U64) :
    Result1 ((ω u : Unit) × Uniq ρ₁ U64 × Uniq ρ₂ U64) :=
  let 1 (t, x) := Uniq.read x;
  let 1 (s, y) := Uniq.read y;
  .ok ((), Uniq.set x s, Uniq.set y t)

-- rejected once linear: `r` used twice (E0499)
def dup : Result1 ((ω u : Unit) × U64) := Uniq.borrow1 Region.static (U64.lit 1) (fun ρ h r =>
  match1 swap r r with                                               -- wishful: linear-case
  | .ok q => let 1 (u, r1r2) := q; let 1 (r1, r2) := r1r2; .ok ((), r1)
  | .err e => .err e)

-- rejected once linear: the lender `v` (bound at 1) is consumed by the borrow (E0502)
def lender (1 v : List Nat) : Result1 ((ω n : Nat) × List Nat) := Uniq.borrow1 Region.static v (fun ρ h r =>
  .ok (List.length v, Uniq.set r List.nil))
