import Rv.Proofs
import BitVecShift
-- SRLI probe: the barrel shifter's right stages as `BitVec.lshr`, for `SRLI x9, x2, 9`.
--
-- A right stage is `concat (fill) (slice j (32-j) x)`, i.e. `BitVec.shrStage (32-j) j f`
-- (lib/BitVecShift.wiz). For SRLI the fill is `Hw.and d.alt (bit 31 a)` with `d.alt = 0`,
-- so it is the zero word (`BitVec.and_zero_left`). `shamt = 9` turns on stages 1 and 8;
-- `BitVec.high_low`/`high_high`/`low_low_rev` put the composition in `BitVec.lshr`'s
-- normal form without a bound on the intermediate values.
--
-- Check: wiz check -I /workspace/wiz-rv/src drafts/rv-shift/SRLI.wiz
--
-- WIP: this does NOT check yet. `Rs.rStage1_toNat` (and the stage chain) go through
-- `BitVec.shrStage_toNat`, whose zero fill leaves `Nat.add (Nat.mul 0 (2^m)) L` in the
-- term; the kernel's `Nat` normalizer makes that identity definitionally true (so it is
-- `True`-typed and cannot be an `Eq.trans` step), while conversion between it and `L`
-- does not terminate when `L` is a stuck application (`Bits.low`/`Bits.high`/`Nat.div`).
-- Reproducer and the workaround (a fill-*value*-parameterised stage, so the `Nat` is
-- symbolic until a `transp` along the fill = 0 equation): wiz-notes/rv-shift-lemmas.md §7.

-- one right stage at width 32 (`m = 32 - j`)
def Rs.rStage1 (f : BitVec 1) (x : BitVec 32) : BitVec 32 := BitVec.shrStage 31 1 f x
def Rs.rStage2 (f : BitVec 2) (x : BitVec 32) : BitVec 32 := BitVec.shrStage 30 2 f x
def Rs.rStage4 (f : BitVec 4) (x : BitVec 32) : BitVec 32 := BitVec.shrStage 28 4 f x
def Rs.rStage8 (f : BitVec 8) (x : BitVec 32) : BitVec 32 := BitVec.shrStage 24 8 f x
def Rs.rStage16 (f : BitVec 16) (x : BitVec 32) : BitVec 32 := BitVec.shrStage 16 16 f x

-- the stage chain of `shamt = 9` (stages 1 and 8; 2, 4 and 16 are off)
def Rs.srli9Stages (x : BitVec 32) : BitVec 32 :=
  Rs.rStage8 (BitVec.ofNat 8 0) (Rs.rStage1 (BitVec.ofNat 1 0) x)

def Rs.rStage1_toNat (x : BitVec 32) :
    (Rs.rStage1 (BitVec.ofNat 1 0) x).toNat = Bits.low 31 (Bits.high 1 x.toNat) :=
  let L1 := Bits.low 31 (Bits.high 1 x.toNat);
  let s1 : (Rs.rStage1 (BitVec.ofNat 1 0) x).toNat
      = Bits.low 32 (Nat.add (Nat.mul (BitVec.ofNat 1 0).toNat (Nat.pow 2 31)) L1) :=
    BitVec.shrStage_toNat 31 1 (BitVec.ofNat 1 0) x;
  let s2 : (Rs.rStage1 (BitVec.ofNat 1 0) x).toNat
      = Bits.low 32 (Nat.add (Nat.mul 0 (Nat.pow 2 31)) L1) :=
    Bits.congr (fun t => Bits.low 32 (Nat.add (Nat.mul t (Nat.pow 2 31)) L1))
      (BitVec.toNat_zero 1);
  let s3 : (Rs.rStage1 (BitVec.ofNat 1 0) x).toNat = Bits.low 32 L1 :=
    Bits.congr (fun t => Bits.low 32 t) (Bits.zero_mul_add (Nat.pow 2 31) L1);
  Eq.trans s1 (Eq.trans s2 (Eq.trans s3 (Bits.low_low_rev 31 32 L1 rfl)))

def Rs.srli9Stages_toNat (x : BitVec 32) :
    (Rs.srli9Stages x).toNat = Bits.low 32 (Bits.high 9 x.toNat) :=
  let y1 : BitVec 32 := Rs.rStage1 (BitVec.ofNat 1 0) x;
  let L1 := Bits.low 31 (Bits.high 1 x.toNat);
  let H9 := Bits.high 9 x.toNat;
  let h23 : Nat.lt H9 (Nat.pow 2 23) = .true :=
    Bits.high_lt 9 23 x.toNat (UIntN.toNat_lt x);
  let h32 : Nat.lt H9 (Nat.pow 2 32) = .true :=
    Bits.high_lt_pow 9 32 x.toNat (UIntN.toNat_lt x);
  let s1 : (Rs.srli9Stages x).toNat
      = Bits.low 32 (Nat.add (Nat.mul (BitVec.ofNat 8 0).toNat (Nat.pow 2 24))
          (Bits.low 24 (Bits.high 8 y1.toNat))) :=
    BitVec.shrStage_toNat 24 8 (BitVec.ofNat 8 0) y1;
  let s2 : (Rs.srli9Stages x).toNat
      = Bits.low 32 (Nat.add (Nat.mul 0 (Nat.pow 2 24))
          (Bits.low 24 (Bits.high 8 y1.toNat))) :=
    Bits.congr (fun t => Bits.low 32 (Nat.add (Nat.mul t (Nat.pow 2 24))
        (Bits.low 24 (Bits.high 8 y1.toNat)))) (BitVec.toNat_zero 8);
  let s3 : (Rs.srli9Stages x).toNat
      = Bits.low 32 (Bits.low 24 (Bits.high 8 y1.toNat)) :=
    Bits.congr (fun t => Bits.low 32 t)
      (Bits.zero_mul_add (Nat.pow 2 24) (Bits.low 24 (Bits.high 8 y1.toNat)));
  let s4 : (Rs.srli9Stages x).toNat
      = Bits.low 32 (Bits.low 24 (Bits.high 8 (Bits.low 31 (Bits.high 1 x.toNat)))) :=
    Bits.congr (fun t => Bits.low 32 (Bits.low 24 (Bits.high 8 t))) (Rs.rStage1_toNat x);
  let s5 : (Rs.srli9Stages x).toNat
      = Bits.low 32 (Bits.low 24 (Bits.low 23 (Bits.high 8 (Bits.high 1 x.toNat)))) :=
    Bits.congr (fun t => Bits.low 32 (Bits.low 24 t)) (Bits.high_low 8 23 (Bits.high 1 x.toNat));
  let s6 : (Rs.srli9Stages x).toNat
      = Bits.low 32 (Bits.low 24 (Bits.low 23 H9)) :=
    Bits.congr (fun t => Bits.low 32 (Bits.low 24 (Bits.low 23 t))) (Bits.high_high 8 1 x.toNat);
  let s7 : (Rs.srli9Stages x).toNat = Bits.low 32 (Bits.low 23 H9) :=
    Bits.congr (fun t => Bits.low 32 t) (Bits.low_low_rev 23 24 H9 rfl);
  let s8 : (Rs.srli9Stages x).toNat = Bits.low 23 H9 := Bits.low_low_rev 23 32 H9 rfl;
  let s9 : (Rs.srli9Stages x).toNat = H9 := Bits.low_of_lt 23 H9 h23;
  Eq.trans s1 (Eq.trans s2 (Eq.trans s3 (Eq.trans s4 (Eq.trans s5 (Eq.trans s6
    (Eq.trans s7 (Eq.trans s8 (Eq.trans s9 (Eq.symm (Bits.low_of_lt 32 H9 h32))))))))))

-- the same, with the barrel's own expression: `shamt = 9` turns stages 1 and 8 on, the
-- others reduce to `x`, and the zero fill makes each stage's fill word `0…0`
def Rs.barrel9_toNat (x : BitVec 32) :
    (barrel (r := HwTy.El) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 5 9) x).toNat
      = Bits.low 32 (Bits.high 9 x.toNat) :=
  Rs.srli9Stages_toNat x

def Rs.barrel9 (x : BitVec 32) :
    barrel (r := HwTy.El) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 5 9) x
      = BitVec.lshr x 9 :=
  UIntN.ext (barrel (r := HwTy.El) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 5 9) x)
    (BitVec.lshr x 9)
    (Eq.trans (Rs.barrel9_toNat x) (Eq.symm (BitVec.lshr_low_toNat 32 9 x)))

-- The execute cycle, as `Pf.ok` needs it. The fill is `Hw.and d.alt (bit 31 a)`; for
-- SRLI `d.alt = 0`, and `Hw.and 0 b = 0` (`BitVec.and_zero_left`), so it is the zero word.
def Rs.srli_pc (a : Arch) : BitVec 32 := BitVec.add a.pc (BitVec.ofNat 32 4)

def Rs.srli9_G (a : Arch) (m0 m1 m2 m3 : BitVec 9 → BitVec 8) (x1 x2 acc dv rm : BitVec 32)
    (cnt srd : BitVec 5) (sf3 : BitVec 3) (slo : BitVec 2) (sio : BitVec 1) :
    Pf.G a (Pf.w (A.srli 9 2 9)) 9 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio
        (Pf.bytes (Pf.w (A.srli 9 2 9))) = Pf.spec a (Pf.w (A.srli 9 2 9)) 9 :=
  Eq.congrArg (fun v => (Rs.srli_pc a, v))
    (Eq.trans
      (Eq.congrArg (fun f =>
          barrel (r := HwTy.El) (BitVec.ofNat 1 0) f (BitVec.ofNat 5 9) (Pf.rf a (BitVec.ofNat 4 2)))
        (BitVec.and_zero_left (Hw.slice 31 1 (Pf.rf a (BitVec.ofNat 4 2)))))
      (Rs.barrel9 (Pf.rf a (BitVec.ofNat 4 2))))

def Rs.srli_ok : Pf.Claim (Pf.w (A.srli 9 2 9)) 9 :=
  fun a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio h =>
    Pf.ok a (Pf.w (A.srli 9 2 9)) 9 m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio
      (Rs.srli9_G a m0 m1 m2 m3 x1 x2 acc dv rm cnt srd sf3 slo sio) h
