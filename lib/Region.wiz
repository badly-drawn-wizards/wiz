import Optic
-- Regions (Rust lifetimes) and borrow handles for the Rust DSL's lowering (RD12).
-- Plan: /workspace/wiz-notes/rust-dsl-plan.md; rules: drafts/rust/LOWERING.md (L1, L3,
-- L4, L12, L17, L20–L22); hand-lowered programs: drafts/rust/lowered/.
--
-- A lifetime `'a` lowers to an erased variable `ρ : Region`. Every handle type below is a
-- `structure` (or `inductive`) with `ρ` as a parameter, so `ρ` is part of the type's
-- identity (phantom parameters, docs/stages/22-numbers.md, 22e): `Shr ρ A` and `Shr ρ' A` are different
-- types, and `ρ` is inferred from a handle's type. Nothing of it reaches run time.
--
-- Borrow checking is typing: a borrow scope (`Shr.borrow`, `Uniq.borrow`,
-- `Uniq.reborrow`, `Uniq.share`, `Region.scope`) takes a body that is polymorphic in a
-- fresh region `ρ`, and its result type `B` is chosen outside, so no handle at `ρ` can
-- leave the scope (as `runST`). Inside a mutable borrow the lender's name is rebound to
-- a `Lent ρ S` token that has no operations, so using the lender while it is borrowed
-- is a type mismatch. A reference flows to a longer-lived place only through
-- `Shr.weaken`, which needs `Outlives` evidence, and that evidence comes only from
-- scopes (or from a function's `'a : 'b` bounds, passed as erased proof arguments).

axiom Region : Type
-- `'static`
axiom Region.static : Region
-- `'a : 'b`, `'a` outlives `'b`. Opaque: its only proofs are the axioms below and the
-- ones scopes hand out, so `Shr.weaken` can't be used without a reason.
axiom Outlives : Region → Region → Prop
axiom Outlives.refl : (0 ρ : Region) → Outlives ρ ρ
axiom Outlives.trans : (0 ρ₁ : Region) → (0 ρ₂ : Region) → (0 ρ₃ : Region) →
  Outlives ρ₁ ρ₂ → Outlives ρ₂ ρ₃ → Outlives ρ₁ ρ₃
axiom Outlives.static : (0 ρ : Region) → Outlives Region.static ρ

-- `&'a A`: a shared borrow carries the value (shared, rc + 1; nothing mutates it while
-- the borrow lives). Read it with `.val`.
structure Shr (ρ : Region) (A : Type) where
  private mk ::
  val : A
-- `&'a mut A` as an argument (L3): the current value, handed back by the callee.
structure Uniq (ρ : Region) (A : Type) where
  private mk ::
  val : A
-- `&'a mut A` returned from a lender `S` (L4): the borrowed value and the backward
-- function that rebuilds the lender from the borrow's final value.
structure Mut (ρ : Region) (A S : Type) where
  private mk ::
  store : Store A S
-- `Option (&'a mut A)` returned from a lender `S` (L12): a borrow, or the lender back.
inductive MutOpt (ρ : Region) (A S : Type) where
  | some (m : Mut ρ A S)
  | none (r : Uniq ρ S)
-- the lender `S` while it is mutably borrowed at `ρ`: inside the borrow's scope the
-- lender's name is rebound to this, and nothing accepts it
structure Lent (ρ : Region) (S : Type) where
  private mk ::
  lent : Unit

-- The constructors `Shr.mk`, `Uniq.mk`, `Mut.mk` and `Lent.mk` are private to this
-- module (`private mk ::`, docs/stages/13-language.md, 13b): other modules get handles only from the scopes
-- and operations below, and see the handle types as opaque (no tuple or look-alike
-- structure converts to one), reading them through `.val`/`.store`/`.lent`. `MutOpt`'s
-- constructors stay public: their fields are handles already, so they forge nothing.

-- ## Scopes: fresh regions

-- a region nested in `σ` (a block)
def Region.scope {B : Type} (0 σ : Region)
    (body : (0 ρ : Region) → (0 h : Outlives σ ρ) → Result B) : Result B :=
  body σ (Outlives.refl σ)

-- `let r := &s` until the borrow's last use (NLL): inside, `s` is rebound to the
-- borrow too (reads go through `.val`, moves and mutations don't type-check)
def Shr.borrow {S B : Type} (0 σ : Region) (s : S)
    (body : (0 ρ : Region) → (0 h : Outlives σ ρ) → Shr ρ S → Result B) : Result B :=
  body σ (Outlives.refl σ) (Shr.mk s)

-- `let r := &mut s` until the borrow's last use: inside, `s` is rebound to a `Lent`
-- token; the body hands the borrow back with its result, and the lender comes back
def Uniq.borrow {S B : Type} (0 σ : Region) (s : S)
    (body : (0 ρ : Region) → (0 h : Outlives σ ρ) → Lent ρ S → Uniq ρ S → Result (B × Uniq ρ S)) :
    Result (B × S) :=
  match body σ (Outlives.refl σ) (Lent.mk ()) (Uniq.mk s) with
  | .ok r => .ok (r.1, r.2.val)
  | .err e => .err e

-- `&mut *r`, a reborrow at a shorter region (needed when a call returns a borrow of
-- `r`, L17): inside, `r` is rebound to a `Lent` token
def Uniq.reborrow {ρ : Region} {S B : Type} (r : Uniq ρ S)
    (body : (0 ρ' : Region) → (0 h : Outlives ρ ρ') → Lent ρ' S → Uniq ρ' S → Result (B × Uniq ρ' S)) :
    Result (B × Uniq ρ S) :=
  body ρ (Outlives.refl ρ) (Lent.mk ()) r

-- `&*r`, a shared reborrow of a mutable one: inside, `r` is rebound to the shared borrow
def Uniq.share {ρ : Region} {S B : Type} (r : Uniq ρ S)
    (body : (0 ρ' : Region) → (0 h : Outlives ρ ρ') → Shr ρ' S → Result B) : Result (B × Uniq ρ S) :=
  match body ρ (Outlives.refl ρ) (Shr.mk r.val) with
  | .ok b => .ok (b, r)
  | .err e => .err e

-- `&mut r.p` for a place `p` with a lens, passed to a body (a field reborrow; `zoom`
-- with regions): inside, `r` is rebound to a `Lent` token, so only disjoint places can
-- be borrowed at once through one lens (`Lens.pair`, then `Uniq.both`)
def Uniq.zoom {ρ : Region} {S X B : Type} (l : Lens S X) (r : Uniq ρ S)
    (body : (0 ρ' : Region) → (0 h : Outlives ρ ρ') → Lent ρ' S → Uniq ρ' X → Result (B × Uniq ρ' X)) :
    Result (B × Uniq ρ S) :=
  let st := l r.val;
  match body ρ (Outlives.refl ρ) (Lent.mk ()) (Uniq.mk st.1) with
  | .ok p => .ok (p.1, Uniq.mk (st.2 p.2.val))
  | .err e => .err e

-- a borrow of a pair is two borrows of its components, live at the same time
def Uniq.both {ρ : Region} {A B C : Type} (p : Uniq ρ (A × B))
    (body : (0 ρ' : Region) → (0 h : Outlives ρ ρ') → Uniq ρ' A → Uniq ρ' B → Result (C × Uniq ρ' A × Uniq ρ' B)) :
    Result (C × Uniq ρ (A × B)) :=
  match body ρ (Outlives.refl ρ) (Uniq.mk p.val.1) (Uniq.mk p.val.2) with
  | .ok r => .ok (r.1, Uniq.mk (r.2.1.val, r.2.2.val))
  | .err e => .err e

-- The scopes are inlined in compiled code (22i): with the handles unboxed, a scope is
-- its body run in place, with no closure and no handle allocated.
attribute [inline] Region.scope
attribute [inline] Shr.borrow
attribute [inline] Uniq.borrow
attribute [inline] Uniq.reborrow
attribute [inline] Uniq.share
attribute [inline] Uniq.zoom
attribute [inline] Uniq.both

-- `*r := a` through a mutable borrow argument
def Uniq.set {ρ : Region} {A : Type} (r : Uniq ρ A) (a : A) : Uniq ρ A := Uniq.mk a
attribute [inline] Uniq.set

-- ## Subtyping by evidence

-- `&'a A` is a `&'b A` when `'a : 'b` (shared borrows are covariant in the region).
-- Mutable borrows are not weakened: a shorter mutable borrow is a reborrow.
def Shr.weaken {ρ ρ' : Region} {A : Type} (0 h : Outlives ρ ρ') (x : Shr ρ A) : Shr ρ' A :=
  Shr.mk x.val
attribute [inline] Shr.weaken

-- ## Returned mutable borrows

-- `&mut r.p` for a place `p` with a (partial) lens: the borrow of the place, its
-- backward function rebuilding `r`'s value
def Mut.ofLens {ρ : Region} {S A : Type} (r : Uniq ρ S) (l : Lens S A) : Mut ρ A S :=
  Mut.mk (l r.val)
def Mut.ofR {ρ : Region} {S A : Type} : Result (Store A S) → Result (Mut ρ A S)
  | .ok st => .ok (Mut.mk st)
  | .err e => .err e
def Mut.ofPLens {ρ : Region} {S A : Type} (r : Uniq ρ S) (l : PLens S A) : Result (Mut ρ A S) :=
  Mut.ofR (l r.val)
-- the whole of `r` (a cursor's start, L16)
def Mut.whole {ρ : Region} {S : Type} (r : Uniq ρ S) : Mut ρ S S := Mut.mk (Lens.id r.val)
-- `*m`
def Mut.get {ρ : Region} {A S : Type} (m : Mut ρ A S) : A := m.store.1
-- `*m := a`
def Mut.set {ρ : Region} {A S : Type} (m : Mut ρ A S) (a : A) : Mut ρ A S := Mut.mk (a, m.store.2)
-- the borrow's last use: the lender comes back with the final value
def Mut.release {ρ : Region} {A S : Type} (m : Mut ρ A S) : Uniq ρ S := Uniq.mk (Store.extract m.store)
-- the lender, had the borrow's final value been `fin` (`final(v)` for `final(result)
-- = fin`, L18)
def Mut.close {ρ : Region} {A S : Type} (m : Mut ρ A S) (fin : A) : Uniq ρ S := Uniq.mk (m.store.2 fin)
-- `m := &mut (*m).p` (a cursor moves down, L16): compose the backward functions
def Mut.comp {ρ : Region} {A B S : Type} (m : Mut ρ A S) (k : A → Store B A) : Mut ρ B S :=
  Mut.mk (Store.comp m.store k)
-- `Option (&mut A)` from an affine optic on `r`
def MutOpt.ofAffine {ρ : Region} {A S : Type} : Affine A S → MutOpt ρ A S
  | .some a k => .some (Mut.mk (a, k))
  | .none s => .none (Uniq.mk s)
-- `if let .some x := o then *x := f *x`: the lender, updated or not
def MutOpt.over {ρ : Region} {A S : Type} (f : A → A) : MutOpt ρ A S → Uniq ρ S
  | .some m => Mut.release (Mut.set m (f (Mut.get m)))
  | .none r => r
