-- ## U64Array

sealed inductive U64Array where
  | private mk (toList : List U64)

def U64Array.toList : U64Array → List U64
  | .mk l => l
def U64Array.ofList (l : List U64) : U64Array := .mk l
def U64Array.empty : U64Array := .mk .nil
def U64Array.size (a : U64Array) : Nat := List.length a.toList
-- the element at `i`, or `d` (`get`: or 0)
def U64Array.getD (a : U64Array) (i : Nat) (d : U64) : U64 := List.getD a.toList i d
def U64Array.get (a : U64Array) (i : Nat) : U64 := U64Array.getD a i (U64.ofNat 0)
-- `x` at `i` (nothing changes when `i ≥ size a`)
def U64Array.set (a : U64Array) (i : Nat) (x : U64) : U64Array := .mk (List.setAt a.toList i x)
def U64Array.push (a : U64Array) (x : U64) : U64Array := .mk (List.append a.toList (.cons x .nil))
-- without the last element
def U64Array.pop (a : U64Array) : U64Array := .mk (List.dropLast a.toList)
-- the elements `[start, start + n)`, cut at the end
def U64Array.slice (a : U64Array) (start n : Nat) : U64Array := .mk (List.take n (List.drop start a.toList))
def U64Array.append (a b : U64Array) : U64Array := .mk (List.append a.toList b.toList)
-- (Wiz loops over the operations above, so natives too when compiled)
def U64Array.pushN (x : U64) : Nat → U64Array → U64Array
  | .zero, a => a
  | .succ n, a => U64Array.pushN x n (U64Array.push a x)
def U64Array.replicate (n : Nat) (x : U64) : U64Array := U64Array.pushN x n U64Array.empty
def U64Array.foldlFrom {B : Type} (a : U64Array) (f : B → U64 → B) : Nat → Nat → B → B
  | .zero, _, b => b
  | .succ k, i, b => U64Array.foldlFrom a f k (Nat.succ i) (f b (U64Array.get a i))
-- `f (… (f b a[0]) …) a[n-1]`, by index
def U64Array.foldl {B : Type} (f : B → U64 → B) (b : B) (a : U64Array) : B :=
  U64Array.foldlFrom a f (U64Array.size a) 0 b

