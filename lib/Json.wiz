import Prelude
import Text
-- JSON (RFC 8259) in Wiz: values, a parser and a printer. The infoview clients use it
-- to speak the language server's protocol. Strings are code points throughout:
-- `\uXXXX` escapes (with surrogate pairs) are decoded on input, and the printer
-- either keeps non-ASCII characters as they are (they become UTF-8 at the C boundary)
-- or escapes them (`Json.renderAscii`).

-- A value. Arrays and objects hold values, so the three types are mutual (Wiz has no
-- nested inductive types). Integers are kept exactly; other numbers keep their text.
mutual
inductive Json where
  | null
  | bool (b : Bool)
  | int (neg : Bool) (n : Nat)
  | dec (text : String)
  | str (s : String)
  | arr (xs : Jsons)
  | obj (fs : JFields)
inductive Jsons where
  | nil
  | cons (head : Json) (tail : Jsons)
inductive JFields where
  | fnil
  | fcons (key : String) (val : Json) (tail : JFields)
end

-- Arithmetic the prelude doesn't have (pure, so `#eval` runs it).
-- `(n / d, n % d)` for `d > 0`, by long division in binary.
partial def Json.divMod (n d : Nat) : Nat × Nat := match Nat.lt n d with
  | .true => (0, n)
  | .false =>
    let p := Json.divMod n (d + d);
    match Nat.lt p.2 d with
    | .true => (p.1 + p.1, p.2)
    | .false => (p.1 + p.1 + 1, p.2 - d)

def Json.between (c lo hi : Nat) : Bool := Bool.and (Nat.le lo c) (Nat.le c hi)
def Json.chr (n : Nat) : Char := Char.mk n
def Json.charsEq : List Char → List Char → Bool
  | .nil, .nil => .true
  | .cons a as, .cons b bs => Bool.and (Nat.beq (Char.code a) (Char.code b)) (Json.charsEq as bs)
  | _, _ => .false
-- (`String.eq`, `String.chars` and `Nat.repr` are lib/Text.wiz's)
def Json.revOnto : List Char → List Char → List Char
  | .nil, acc => acc
  | .cons c cs, acc => Json.revOnto cs (.cons c acc)

-- Decimal digits of `n`, in front of `tail`.
partial def Json.natChars (n : Nat) (tail : List Char) : List Char := match Nat.lt n 10 with
  | .true => .cons (Json.chr (48 + n)) tail
  | .false =>
    let p := Json.divMod n 10;
    Json.natChars p.1 (.cons (Json.chr (48 + p.2)) tail)

-- ## Printing

def Json.hexDigit (d : Nat) : Char := match Nat.lt d 10 with
  | .true => Json.chr (48 + d)
  | .false => Json.chr (87 + d)
-- `\uXXXX` for `n < 0x10000`, lower-case hex
def Json.u4 (n : Nat) (tail : List Char) : List Char :=
  let a := Json.divMod n 4096;
  let b := Json.divMod a.2 256;
  let c := Json.divMod b.2 16;
  .cons (Json.chr 92) (.cons (Json.chr 117) (.cons (Json.hexDigit a.1) (.cons (Json.hexDigit b.1)
    (.cons (Json.hexDigit c.1) (.cons (Json.hexDigit c.2) tail)))))
def Json.esc (c : Nat) (tail : List Char) : List Char := .cons (Json.chr 92) (.cons (Json.chr c) tail)

-- One character of a string literal. `ascii`: escape everything above 0x7E too (as a
-- surrogate pair above 0xFFFF).
def Json.escapeChar (ascii : Bool) (c : Nat) (tail : List Char) : List Char :=
  match Nat.beq c 34 with
  | .true => Json.esc 34 tail
  | .false => match Nat.beq c 92 with
    | .true => Json.esc 92 tail
    | .false => match Nat.lt c 32 with
      | .true => match Nat.beq c 10 with
        | .true => Json.esc 110 tail
        | .false => match Nat.beq c 13 with
          | .true => Json.esc 114 tail
          | .false => match Nat.beq c 9 with
            | .true => Json.esc 116 tail
            | .false => match Nat.beq c 8 with
              | .true => Json.esc 98 tail
              | .false => match Nat.beq c 12 with
                | .true => Json.esc 102 tail
                | .false => Json.u4 c tail
      | .false => match Bool.and ascii (Nat.lt 126 c) with
        | .false => .cons (Json.chr c) tail
        | .true => match Nat.lt c 65536 with
          | .true => Json.u4 c tail
          | .false =>
            let v := Json.divMod (c - 65536) 1024;
            Json.u4 (55296 + v.1) (Json.u4 (56320 + v.2) tail)
def Json.escapeChars (ascii : Bool) : List Char → List Char → List Char
  | .nil, tail => tail
  | .cons c cs, tail => Json.escapeChar ascii (Char.code c) (Json.escapeChars ascii cs tail)
def Json.quoteChars (ascii : Bool) (s : String) (tail : List Char) : List Char :=
  .cons (Json.chr 34) (Json.escapeChars ascii (String.chars s) (.cons (Json.chr 34) tail))
-- a JSON string literal, with its quotes
def Json.quote (s : String) : String := .mk (Json.quoteChars .false s .nil)

def Json.lit (s : String) (tail : List Char) : List Char := List.append (String.chars s) tail

-- The text of a value in front of `tail`, compact (no spaces).
mutual
def Json.emit (ascii : Bool) (j : Json) (tail : List Char) : List Char := match j with
  | .null => Json.lit "null" tail
  | .bool b => match b with
    | .true => Json.lit "true" tail
    | .false => Json.lit "false" tail
  | .int neg n => match Bool.and neg (Bool.not (Nat.beq n 0)) with
    | .true => .cons (Json.chr 45) (Json.natChars n tail)
    | .false => Json.natChars n tail
  | .dec t => Json.lit t tail
  | .str s => Json.quoteChars ascii s tail
  | .arr xs => match xs with
    | .nil => Json.lit "[]" tail
    | .cons x rest => .cons (Json.chr 91) (Json.emit ascii x (Json.emitRest ascii rest tail))
  | .obj fs => match fs with
    | .fnil => Json.lit "{}" tail
    | .fcons k v rest => .cons (Json.chr 123) (Json.emitField ascii k v (Json.emitFields ascii rest tail))
def Json.emitRest (ascii : Bool) (xs : Jsons) (tail : List Char) : List Char := match xs with
  | .nil => .cons (Json.chr 93) tail
  | .cons x rest => .cons (Json.chr 44) (Json.emit ascii x (Json.emitRest ascii rest tail))
def Json.emitField (ascii : Bool) (k : String) (v : Json) (tail : List Char) : List Char :=
  Json.quoteChars ascii k (.cons (Json.chr 58) (Json.emit ascii v tail))
def Json.emitFields (ascii : Bool) (fs : JFields) (tail : List Char) : List Char := match fs with
  | .fnil => .cons (Json.chr 125) tail
  | .fcons k v rest => .cons (Json.chr 44) (Json.emitField ascii k v (Json.emitFields ascii rest tail))
end

-- compact text, non-ASCII characters as they are
def Json.render (j : Json) : String := .mk (Json.emit .false j .nil)
-- compact text, pure ASCII
def Json.renderAscii (j : Json) : String := .mk (Json.emit .true j .nil)

-- ## Parsing

-- A parse: the value and the rest of the input, or a message and where it failed.
inductive JParse (A : Type) where
  | ok (a : A) (rest : List Char)
  | err (msg : String) (rest : List Char)

def Json.isWs (c : Nat) : Bool :=
  Bool.or (Bool.or (Nat.beq c 32) (Nat.beq c 10)) (Bool.or (Nat.beq c 13) (Nat.beq c 9))
def Json.skipWs : List Char → List Char
  | .nil => .nil
  | .cons c cs => match Json.isWs (Char.code c) with
    | .true => Json.skipWs cs
    | .false => .cons c cs
-- the input after the literal `lit`, if it starts with it
def Json.expect : List Char → List Char → Option (List Char)
  | .nil, s => .some s
  | .cons l ls, .cons c cs => match Nat.beq (Char.code l) (Char.code c) with
    | .true => Json.expect ls cs
    | .false => .none
  | _, _ => .none
def Json.keyword (lit : String) (v : Json) (s : List Char) : JParse Json :=
  match Json.expect (String.chars lit) s with
  | .some rest => .ok v rest
  | .none => .err "unexpected character" s
def Json.peek : List Char → Nat
  | .nil => 0
  | .cons c _ => Char.code c
def Json.drop1 : List Char → List Char
  | .nil => .nil
  | .cons _ cs => cs
def Json.isNil : Jsons → Bool
  | .nil => .true
  | _ => .false
def Json.isNilF : JFields → Bool
  | .fnil => .true
  | _ => .false
def Json.revJsons : Jsons → Jsons → Jsons
  | .nil, acc => acc
  | .cons x xs, acc => Json.revJsons xs (.cons x acc)
def Json.revFields : JFields → JFields → JFields
  | .fnil, acc => acc
  | .fcons k v xs, acc => Json.revFields xs (.fcons k v acc)

-- the value of a hex digit, or 16
def Json.hexVal (c : Nat) : Nat := match Json.between c 48 57 with
  | .true => c - 48
  | .false => match Json.between c 97 102 with
    | .true => c - 87
    | .false => match Json.between c 65 70 with
      | .true => c - 55
      | .false => 16
-- four hex digits
def Json.hex4 : List Char → Option (Nat × List Char)
  | .cons a (.cons b (.cons c (.cons d rest))) =>
    let va := Json.hexVal (Char.code a);
    let vb := Json.hexVal (Char.code b);
    let vc := Json.hexVal (Char.code c);
    let vd := Json.hexVal (Char.code d);
    match Nat.lt (Nat.max (Nat.max va vb) (Nat.max vc vd)) 16 with
    | .true => .some ((((va * 16 + vb) * 16 + vc) * 16 + vd), rest)
    | .false => .none
  | _ => .none

-- `a - b`, opaque to the elaborator: today `(hi - 55296) * 1024 + …` written out makes
-- elaboration unfold the subtraction 55296 times and run out of memory
partial def Json.sub (a b : Nat) : Nat := a - b
-- after `\u` and a high surrogate `hi`: a low one makes a pair; otherwise U+FFFD
def Json.surrogate (hi : Nat) (s : List Char) : Nat × List Char :=
  match Json.expect (.cons (Json.chr 92) (.cons (Json.chr 117) .nil)) s with
  | .none => (65533, s)
  | .some s2 => match Json.hex4 s2 with
    | .none => (65533, s)
    | .some p => match Json.between p.1 56320 57343 with
      | .true => (65536 + (Json.sub hi 55296 * 1024 + Json.sub p.1 56320), p.2)
      | .false => (65533, s)

-- The body of a string literal after the opening quote; `acc` holds the characters
-- read so far, reversed.
mutual
def Json.strBody (s : List Char) (acc : List Char) : JParse String := match s with
  | .nil => .err "unterminated string" s
  | .cons c rest => match Nat.beq (Char.code c) 34 with
    | .true => .ok (.mk (Json.revOnto acc .nil)) rest
    | .false => match Nat.beq (Char.code c) 92 with
      | .false => match Nat.lt (Char.code c) 32 with
        | .true => .err "control character in a string" s
        | .false => Json.strBody rest (.cons c acc)
      | .true => match rest with
        | .nil => .err "unterminated string" rest
        | .cons e rest2 => Json.strEscape (Char.code e) rest2 acc
def Json.strEscape (e : Nat) (s : List Char) (acc : List Char) : JParse String :=
  match Nat.beq e 117 with
  | .true => match Json.hex4 s with
    | .none => .err "bad \\u escape" s
    | .some p => match Json.between p.1 55296 56319 with
      | .true =>
        let q := Json.surrogate p.1 p.2;
        Json.strBody q.2 (.cons (Json.chr q.1) acc)
      | .false => match Json.between p.1 56320 57343 with
        | .true => Json.strBody p.2 (.cons (Json.chr 65533) acc)
        | .false => Json.strBody p.2 (.cons (Json.chr p.1) acc)
  | .false =>
    let simple := fun (c : Nat) => Json.strBody s (.cons (Json.chr c) acc);
    match Bool.or (Nat.beq e 34) (Bool.or (Nat.beq e 92) (Nat.beq e 47)) with
    | .true => simple e
    | .false => match Nat.beq e 110 with
      | .true => simple 10
      | .false => match Nat.beq e 116 with
        | .true => simple 9
        | .false => match Nat.beq e 114 with
          | .true => simple 13
          | .false => match Nat.beq e 98 with
            | .true => simple 8
            | .false => match Nat.beq e 102 with
              | .true => simple 12
              | .false => .err "bad escape" s
end

-- Digits: their value, and how many there were. `acc` is the reversed text so far.
partial def Json.digits (s : List Char) (n k : Nat) (acc : List Char) : Nat × Nat × List Char × List Char :=
  match s with
  | .cons c rest => match Json.between (Char.code c) 48 57 with
    | .true => Json.digits rest (n * 10 + (Char.code c - 48)) (k + 1) (.cons c acc)
    | .false => (n, k, acc, s)
  | .nil => (n, k, acc, s)

-- `.digits` (an optional fraction), then `e±digits` (an optional exponent): the
-- reversed text, whether there was any, and the rest
def Json.fracPart (s : List Char) (acc : List Char) : Option (Bool × List Char × List Char) :=
  match Nat.beq (Json.peek s) 46 with
  | .false => .some (Bool.false, acc, s)
  | .true =>
    let d := Json.digits (Json.drop1 s) 0 0 (.cons (Json.chr 46) acc);
    match Nat.beq d.2.1 0 with
    | .true => .none
    | .false => .some (Bool.true, d.2.2.1, d.2.2.2)
def Json.expPart (s : List Char) (acc : List Char) : Option (Bool × List Char × List Char) :=
  match s with
  | .cons e rest => match Bool.or (Nat.beq (Char.code e) 101) (Nat.beq (Char.code e) 69) with
    | .false => .some (Bool.false, acc, s)
    | .true =>
      let signed : List Char × List Char := match rest with
        | .cons c r => match Bool.or (Nat.beq (Char.code c) 43) (Nat.beq (Char.code c) 45) with
          | .true => (r, .cons c (.cons e acc))
          | .false => (rest, .cons e acc)
        | .nil => (rest, .cons e acc);
      let d := Json.digits signed.1 0 0 signed.2;
      match Nat.beq d.2.1 0 with
      | .true => .none
      | .false => .some (Bool.true, d.2.2.1, d.2.2.2)
  | .nil => .some (Bool.false, acc, s)

-- A number: `-`? (`0` | digits) fraction? exponent?
def Json.number (s : List Char) : JParse Json :=
  let neg := Nat.beq (Json.peek s) 45;
  let s1 : List Char := match neg with
    | .true => Json.drop1 s
    | .false => s;
  let start : List Char := match neg with
    | .true => .cons (Json.chr 45) .nil
    | .false => .nil;
  let d := Json.digits s1 0 0 start;
  let n := d.1;
  let k := d.2.1;
  let rest := d.2.2.2;
  match Bool.or (Nat.beq k 0) (Bool.and (Nat.beq (Json.peek s1) 48) (Nat.lt 1 k)) with
  | .true => .err "bad number" s
  | .false => match Json.fracPart rest d.2.2.1 with
    | .none => .err "bad number" rest
    | .some f => match Json.expPart f.2.2 f.2.1 with
      | .none => .err "bad number" f.2.2
      | .some e => match Bool.or f.1 e.1 with
        | .false => .ok (.int neg n) rest
        | .true => .ok (.dec (.mk (Json.revOnto e.2.1 .nil))) e.2.2

mutual
def Json.value (s0 : List Char) : JParse Json :=
  let s := Json.skipWs s0;
  let c := Json.peek s;
  match Nat.beq c 123 with
  | .true => Json.object (Json.skipWs (Json.drop1 s)) .fnil
  | .false => match Nat.beq c 91 with
    | .true => Json.array (Json.skipWs (Json.drop1 s)) .nil
    | .false => match Nat.beq c 34 with
      | .true => match Json.strBody (Json.drop1 s) .nil with
        | .ok str rest => .ok (.str str) rest
        | .err m r => .err m r
      | .false => match Nat.beq c 116 with
        | .true => Json.keyword "true" (.bool .true) s
        | .false => match Nat.beq c 102 with
          | .true => Json.keyword "false" (.bool .false) s
          | .false => match Nat.beq c 110 with
            | .true => Json.keyword "null" .null s
            | .false => match Bool.or (Nat.beq c 45) (Json.between c 48 57) with
              | .true => Json.number s
              | .false => match Nat.beq c 0 with
                | .true => .err "unexpected end of input" s
                | .false => .err "unexpected character" s
-- after `[` (and whitespace); `acc` is the elements so far, reversed
def Json.array (s : List Char) (acc : Jsons) : JParse Json :=
  match Bool.and (Nat.beq (Json.peek s) 93) (Json.isNil acc) with
  | .true => .ok (.arr .nil) (Json.drop1 s)
  | .false => match Json.value s with
    | .err m r => .err m r
    | .ok v rest => match Json.skipWs rest with
      | .cons c r => match Nat.beq (Char.code c) 44 with
        | .true => Json.array r (.cons v acc)
        | .false => match Nat.beq (Char.code c) 93 with
          | .true => .ok (.arr (Json.revJsons (.cons v acc) .nil)) r
          | .false => .err "expected , or ]" (.cons c r)
      | .nil => .err "unexpected end of input" .nil
-- after `{` (and whitespace)
def Json.object (s : List Char) (acc : JFields) : JParse Json :=
  match Bool.and (Nat.beq (Json.peek s) 125) (Json.isNilF acc) with
  | .true => .ok (.obj .fnil) (Json.drop1 s)
  | .false => match Nat.beq (Json.peek s) 34 with
    | .false => .err "expected a key" s
    | .true => match Json.strBody (Json.drop1 s) .nil with
      | .err m r => .err m r
      | .ok k rest => match Json.skipWs rest with
        | .cons colon r => match Nat.beq (Char.code colon) 58 with
          | .false => .err "expected :" (.cons colon r)
          | .true => match Json.value r with
            | .err m r2 => .err m r2
            | .ok v rest2 => match Json.skipWs rest2 with
              | .cons c r3 => match Nat.beq (Char.code c) 44 with
                | .true => Json.object (Json.skipWs r3) (.fcons k v acc)
                | .false => match Nat.beq (Char.code c) 125 with
                  | .true => .ok (.obj (Json.revFields (.fcons k v acc) .fnil)) r3
                  | .false => .err "expected , or }" (.cons c r3)
              | .nil => .err "unexpected end of input" .nil
        | .nil => .err "unexpected end of input" .nil
end

-- A whole document: one value, then only whitespace. An error says where (in code
-- points from the start).
def Json.parse (text : String) : Except String Json :=
  let s := String.chars text;
  let fail : String → List Char → Except String Json := fun m rest =>
    .error (String.append m (String.append " at offset "
      (Nat.repr (List.length s - List.length rest))));
  match Json.value s with
  | .err m rest => fail m rest
  | .ok v rest => match Json.skipWs rest with
    | .nil => .ok v
    | .cons c r => fail "trailing characters" (.cons c r)

-- ## Building and taking apart

def Json.ofNat (n : Nat) : Json := .int .false n
def Json.ofString (s : String) : Json := .str s
-- (constructors of a mutual type have no `Json.` names, so these stand in where no
-- expected type selects them, e.g. the second component of a pair)
def Json.mkStr (s : String) : Json := .str s
def Json.field (k : String) (v : Json) : String × Json := (k, v)
def Json.mkNull : Json := .null
def Json.mkBool (b : Bool) : Json := .bool b
def Jsons.ofList : List Json → Jsons
  | .nil => .nil
  | .cons x xs => .cons x (Jsons.ofList xs)
def Jsons.toList : Jsons → List Json
  | .nil => .nil
  | .cons x xs => .cons x (Jsons.toList xs)
def JFields.ofList : List (String × Json) → JFields
  | .nil => .fnil
  | .cons p ps => .fcons p.1 p.2 (JFields.ofList ps)
def Json.mkArr (xs : List Json) : Json := .arr (Jsons.ofList xs)
def Json.mkObj (fs : List (String × Json)) : Json := .obj (JFields.ofList fs)

def JFields.find : JFields → String → Option Json
  | .fnil, _ => .none
  | .fcons k v rest, key => match String.eq k key with
    | .true => .some v
    | .false => JFields.find rest key
-- the field `key` of an object
def Json.get (j : Json) (key : String) : Option Json := match j with
  | .obj fs => JFields.find fs key
  | _ => .none
def Json.getPath : Json → List String → Option Json
  | j, .nil => .some j
  | j, .cons k ks => match Json.get j k with
    | .some v => Json.getPath v ks
    | .none => .none
def Json.asString : Json → Option String
  | .str s => .some s
  | _ => .none
def Json.asNat : Json → Option Nat
  | .int .false n => .some n
  | _ => .none
def Json.asBool : Json → Option Bool
  | .bool b => .some b
  | _ => .none
def Json.asList : Json → List Json
  | .arr xs => Jsons.toList xs
  | _ => .nil
def Json.isNull : Json → Bool
  | .null => .true
  | _ => .false
-- with defaults, for fields that may be missing
def Json.getStr (j : Json) (key : String) : String := match Json.get j key with
  | .some (.str s) => s
  | _ => ""
def Json.getNat (j : Json) (key : String) : Nat := match Json.get j key with
  | .some (.int .false n) => n
  | _ => 0
def Json.getList (j : Json) (key : String) : List Json := match Json.get j key with
  | .some v => Json.asList v
  | .none => .nil
