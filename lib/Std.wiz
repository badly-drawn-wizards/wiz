import IO
/-!
# Std

The standard library for systems code (stage 12a): containers and text with native
representations, updated in place when they are unique.

* `Array A`: a growable array (`Array.push`, `Array.getD`, `Array.set`);
* `Str`: UTF-8 text in a native buffer (`Str.append`, `Str.slice`, `Str.byte`);
* `StrMap V`: a map from `Str` keys to values (`StrMap.insert`, `StrMap.findD`).

They are axioms with `extern` operations, implemented by the runtime (runtime/).
When a value is unique (its reference count is one), `push`, `set` and `insert`
update it in place instead of copying it.

```
def squares : Array Nat :=
  Array.push (Array.push (Array.push Array.empty 0) 1) 4
-- Array.getD squares 2 0 = 4, Array.size squares = 3
```
-/

/-- Arrays of any values: a native buffer, indexed from 0. -/
axiom Array : Type → Type
/-- The empty array. -/
extern "wiz_array_empty" Array.empty : {A : Type} → Array A
/-- Add an element at the end (in place when the array is unique). -/
extern "wiz_array_push" Array.push : {A : Type} → Array A → A → Array A
/-- The number of elements. -/
extern "wiz_array_size" Array.size : {A : Type} → Array A → Nat
/-- `Array.getD a i d`: the element at index `i`, or the default `d` if `i` is out of
range. -/
extern "wiz_array_get" Array.getD : {A : Type} → Array A → Nat → A → A
/-- `Array.set a i x`: `a` with the element at `i` replaced by `x` (unchanged if `i` is
out of range; in place when the array is unique). -/
extern "wiz_array_set" Array.set : {A : Type} → Array A → Nat → A → Array A

/-- UTF-8 text in a native buffer (unlike the Prelude's `String`, which is a value of
the compiler's own). Sizes and indices count bytes. -/
axiom Str : Type
/-- A `String` as a `Str`. -/
extern "wiz_str_of_cstr" Str.ofString : String → Str
/-- A `Str` as a `String`. -/
extern "wiz_str_to_cstr" Str.toString : Str → String
/-- The two texts one after the other. -/
extern "wiz_str_append" Str.append : Str → Str → Str
/-- The length in bytes. -/
extern "wiz_str_size" Str.size : Str → Nat
/-- `Str.byte s i`: the byte at offset `i`, a number below 256 (0 past the end). -/
extern "wiz_str_byte" Str.byte : Str → Nat → Nat
/-- `Str.slice s i j`: the bytes from offset `i` up to (not including) `j`, clamped to the
text. -/
extern "wiz_str_slice" Str.slice : Str → Nat → Nat → Str
/-- Whether the two texts are byte for byte equal. -/
extern "wiz_str_eq" Str.eq : Str → Str → Bool
/-- Whether the first text comes before the second (byte order). -/
extern "wiz_str_lt" Str.lt : Str → Str → Bool

/-- Maps from text (`Str`) to values of type `V`. -/
axiom StrMap : Type → Type
/-- The empty map. -/
extern "wiz_map_empty" StrMap.empty : {V : Type} → StrMap V
/-- `StrMap.insert m k v`: `m` with the key `k` mapped to `v` (replacing any old value;
in place when the map is unique). -/
extern "wiz_map_insert" StrMap.insert : {V : Type} → StrMap V → Str → V → StrMap V
/-- `StrMap.findD m k d`: the value of key `k`, or the default `d` if there is none. -/
extern "wiz_map_find" StrMap.findD : {V : Type} → StrMap V → Str → V → V
/-- The number of keys. -/
extern "wiz_map_size" StrMap.size : {V : Type} → StrMap V → Nat

/-- `IO.writeFile path text`: write `text` to the file at `path`, replacing it. -/
extern "wiz_io_write_file" IO.writeFile : String → String → IO Unit
