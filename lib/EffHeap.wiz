import Eff
import HoareTactics
-- Heap cells as an effect (lib/Eff.wiz) interpreted into the heap programs of separation
-- logic (lib/Hoare.wiz): the effect observation of plan S7 for state, and the reason
-- `Commute` is not needed for state on different cells. docs/resources.md tells how this
-- fits with Feral and the optics; /workspace/wiz-notes/cohesion-resources.md, M3.
--
-- * `Cell V l` is a state effect on the cell at location `l` (`State V` with the location
--   in its type, so a row can hold several cells and `Member` tells them apart).
-- * `Eff.toProg` is `interpret` (lib/Eff.wiz) with each cell handled by `get`/`set` on its
--   location: an `Eff` program over cells *is* a heap program, so its specification is a
--   `Triple` of `Eff.toProg c`, and the `x`-tactics prove it.
-- * Commutation. `Commute (Cell V p) (Cell V q) (Prog V)` does not hold: `Commute` asks
--   for an equation of computations, and `get p; get q` and `get q; get p` are different
--   trees. What does hold is that both orders meet the same specification from
--   `(p ↦ x) ⋆ (q ↦ y)` (`Cell.commute`): `⋆` says the cells are different, and that is
--   all the reordering needs. So for state, the commutation proofs of 10a become a
--   consequence of separation, proved once for every pair of operations.

-- ## A cell as an effect

-- the operations on the cell at `l` (`l` is a phantom parameter: it is part of the type)
inductive CellOp (V : Type) (l : Nat) where
  | get
  | put (v : V)
def CellOp.ret {ω V : Type} {l : Nat} : CellOp V l → Type
  | .get => V
  | .put _ => Unit
def Cell (V : Type) (l : Nat) : Effect := Effect.mk (CellOp V l) CellOp.ret

def Cell.get {V : Type} (l : Nat) {r : Row} [Member (Cell V l) r] : Eff r V :=
  send (Cell V l) (@CellOp.get V l)
def Cell.put {V : Type} (l : Nat) {r : Row} [Member (Cell V l) r] (v : V) : Eff r Unit :=
  send (Cell V l) (@CellOp.put V l v)

-- ## The effect observation: cells are heap cells

def Cell.handle {V : Type} (l : Nat) : (o : CellOp V l) → Prog V (CellOp.ret o)
  | .get => Prog.read l
  | .put v => Prog.write l v
instance {V : Type} {ω l : Nat} : Handler (Cell V l) (Prog V) where
  handle := fun o => Cell.handle l o

-- an `Eff` program over cells, as a heap program
def Eff.toProg {V : Type} {r : Row} [hs : Handlers r (Prog V)] {A : Type} (c : Eff r A) : Prog V A :=
  @interpret r (Prog V) _ hs A c

-- A triple for an `Eff` program is the triple of the heap program it is:
-- `Triple P (Eff.toProg c) Q`, proved with the `x`-tactics like any other (they see
-- through `interpret`).

-- ## Each operation's small-footprint specification

-- what the cell at `l`, holding `x`, satisfies after `o` answered `a`
def Cell.post {V : Type} (l : Nat) (x : V) : (o : CellOp V l) → CellOp.ret o → HProp V
  | .get, a => hpure (a = x) ⋆ (l ↦ x)
  | .put v, _ => l ↦ v

def Cell.spec {V : Type} (l : Nat) (x : V) : (o : CellOp V l) →
    Triple (l ↦ x) (Cell.handle l o) (Cell.post l x o)
  | .get => by xgo
  | .put v => by xgo

-- ## Commutation, from separation

-- two operations on two cells, in one order and in the other, with both answers
def Cell.both12 {V : Type} {ω p q : Nat} (o₁ : CellOp V p) (o₂ : CellOp V q) :
    Prog V (CellOp.ret o₁ × CellOp.ret o₂) :=
  Prog.bind (Cell.handle p o₁) (fun a => Prog.bind (Cell.handle q o₂) (fun b => Prog.ret (a, b)))
def Cell.both21 {V : Type} {ω p q : Nat} (o₁ : CellOp V p) (o₂ : CellOp V q) :
    Prog V (CellOp.ret o₁ × CellOp.ret o₂) :=
  Prog.bind (Cell.handle q o₂) (fun b => Prog.bind (Cell.handle p o₁) (fun a => Prog.ret (a, b)))

-- both orders meet the same specification: the cells are separate, so neither operation
-- sees the other
def Cell.both12_spec {V : Type} (p q : Nat) (x y : V) (o₁ : CellOp V p) (o₂ : CellOp V q) :
    Triple ((p ↦ x) ⋆ (q ↦ y)) (Cell.both12 o₁ o₂)
      (fun ab => Cell.post p x o₁ ab.1 ⋆ Cell.post q y o₂ ab.2) := by
  xapp (Cell.spec p x o₁)
  xapp (Cell.spec q y o₂)
  xval
def Cell.both21_spec {V : Type} (p q : Nat) (x y : V) (o₁ : CellOp V p) (o₂ : CellOp V q) :
    Triple ((p ↦ x) ⋆ (q ↦ y)) (Cell.both21 o₁ o₂)
      (fun ab => Cell.post p x o₁ ab.1 ⋆ Cell.post q y o₂ ab.2) := by
  xapp (Cell.spec q y o₂)
  xapp (Cell.spec p x o₁)
  xval

-- so whatever follows, the two orders are interchangeable: a proof of the rest for one
-- order is a proof for the other (`Commute`'s use in `reorder`, as a triple)
def Cell.commute {V B : Type} (p q : Nat) (x y : V) (o₁ : CellOp V p) (o₂ : CellOp V q)
    (H : HProp V) (f : CellOp.ret o₁ × CellOp.ret o₂ → Prog V B) (Q : B → HProp V)
    (k : (ab : CellOp.ret o₁ × CellOp.ret o₂) →
      Triple ((Cell.post p x o₁ ab.1 ⋆ Cell.post q y o₂ ab.2) ⋆ H) (f ab) Q) :
    Triple (((p ↦ x) ⋆ (q ↦ y)) ⋆ H) (Prog.bind (Cell.both12 o₁ o₂) f) Q ×
    Triple (((p ↦ x) ⋆ (q ↦ y)) ⋆ H) (Prog.bind (Cell.both21 o₁ o₂) f) Q :=
  (Triple.bind (Triple.frame H (Cell.both12_spec p q x y o₁ o₂)) k,
   Triple.bind (Triple.frame H (Cell.both21_spec p q x y o₁ o₂)) k)
