-- The Wiz prelude: `import Prelude`.

-- Propositional regularity: a cast along a proof of `A = A` is the identity, up to
-- equality. An axiom (it doesn't compute), consistent in the setoid model. Wiz has no
-- definitional regularity (D1: with an impredicative `Prop` it makes checking loop), so
-- a cast at a type variable stays stuck; this axiom is how proofs get rid of one
-- (`Vec.map_cons` in lib/Vec.wiz).
axiom castRefl.{u} {0 A : Type u} (0 e : A = A) (0 a : A) : (cast e a : A) = a

-- Transport along an equation, for linear values too (L4). The transported value is a
-- quantity-1 parameter: a linear value (a channel endpoint, a token) can be passed,
-- and so can an unrestricted one (an ω variable may be used once). `cast` itself passes
-- its argument's usage through; these just state it in their types.
def Eq.cast.{u} {A B : Type u} (0 e : A = B) (1 a : A) : B := cast e a
def Eq.subst.{u, v} {A : Type u} (0 P : A → Type v) {0 a b : A} (0 e : a = b) (1 pa : P a) : P b :=
  cast (transp (fun b _ => P a = P b) (refl (P a)) e) pa
-- ... and backwards, without `Eq.symm`
def Eq.substBack.{u, v} {A : Type u} (0 P : A → Type v) {0 a b : A} (0 e : a = b) (1 pb : P b) : P a :=
  cast (transp (fun b _ => P b = P a) (refl (P a)) e) pb

inductive Bool where
  | false
  | true

inductive Nat where
  | zero
  | succ (n : Nat)

def Nat.add : Nat → Nat → Nat
  | .zero, n => n
  | .succ m, n => .succ (Nat.add m n)

def Nat.mul : Nat → Nat → Nat
  | .zero, _ => .zero
  | .succ m, n => Nat.add n (Nat.mul m n)

def Nat.pred : Nat → Nat
  | .zero => .zero
  | .succ n => n

-- `n - m`, recursing on `m` (structural recursion is on the first argument)
def Nat.subFrom : Nat → Nat → Nat
  | .zero, n => n
  | .succ m, n => Nat.pred (Nat.subFrom m n)

def Nat.sub (n m : Nat) : Nat := Nat.subFrom m n

def Nat.beq : Nat → Nat → Bool
  | .zero, .zero => .true
  | .succ m, .succ n => Nat.beq m n
  | _, _ => .false

infixl:65 " + " => Nat.add
infixl:65 " - " => Nat.sub
infixl:70 " * " => Nat.mul

inductive List (A : Type) where
  | nil
  | cons (head : A) (tail : List A)

def List.append {A : Type} : List A → List A → List A
  | .nil, ys => ys
  | .cons x xs, ys => .cons x (List.append xs ys)

def List.length {A : Type} : List A → Nat
  | .nil => .zero
  | .cons _ xs => .succ (List.length xs)

inductive Option (A : Type) where
  | none
  | some (val : A)

-- Characters are code points; strings are lists of characters. Both are wrapped in
-- their own types so that `#eval` can print them as literals.
inductive Char where
  | mk (val : Nat)
inductive String where
  | mk (data : List Char)
def String.append : String → String → String
  | .mk xs, .mk ys => .mk (List.append xs ys)
infixr:67 " ++ " => List.append
-- `x |> f` is `f x` (stage 13)
def pipe {A B : Type} (a : A) (f : A → B) : B := f a
infixl:10 " |> " => pipe

-- Syntax trees, as one indexed family (descriptions have no nested inductives yet):
-- index `true` is a tree, `false` a list of trees.
inductive SyntaxF : Bool → Type where
  | missing : SyntaxF .true
  | atom (val : String) : SyntaxF .true
  | ident (val : String) : SyntaxF .true
  | node (kind : String) (args : SyntaxF .false) : SyntaxF .true
  | nil : SyntaxF .false
  | cons (head : SyntaxF .true) (tail : SyntaxF .false) : SyntaxF .false

def Syntax : Type := SyntaxF .true

-- Fast numbers at runtime (the kernel keeps the unary definitions above).
builtin nat := Nat
builtin nat.zero := Nat.zero
builtin nat.succ := Nat.succ
builtin nat.pred := Nat.pred
builtin nat.add := Nat.add
builtin nat.sub := Nat.sub
builtin nat.mul := Nat.mul
builtin nat.beq := Nat.beq
-- (stage 14) comparisons and Boolean connectives; `Nat.lt` runs natively
def Nat.lt : Nat → Nat → Bool
  | .zero, .zero => .false
  | .zero, .succ _ => .true
  | .succ _, .zero => .false
  | .succ m, .succ n => Nat.lt m n
builtin nat.blt := Nat.lt
-- (stage 15) a memoised suspension: to the kernel it is `f`; compiled code runs `f ()`
-- at most once and keeps the result
def memo {A : Type} (f : Unit → A) : Unit → A := f
builtin memo := memo
def Nat.le (m n : Nat) : Bool := Nat.lt m (Nat.succ n)
def Nat.max (m n : Nat) : Nat := match Nat.lt m n with
  | .true => n
  | .false => m
def Bool.and : Bool → Bool → Bool
  | .true, b => b
  | .false, _ => .false
def Bool.or : Bool → Bool → Bool
  | .true, _ => .true
  | .false, b => b
def Bool.not : Bool → Bool
  | .true => .false
  | .false => .true
def Char.code : Char → Nat
  | .mk n => n
builtin string := String

-- Division, powers and bits (for bit vectors and machine integers). The kernel sees
-- these definitions (structural recursion on a fuel argument that bounds the number
-- of steps); on numerals it computes natively, as compiled code does. As in Lean,
-- `n / 0 = 0`, `Nat.mod n 0 = n` and `Nat.log2 0 = 0`.
def Nat.divGo : Nat → Nat → Nat → Nat
  | .zero, _, _ => .zero
  | .succ fuel, n, m => match Nat.lt n m with
    | .true => .zero
    | .false => .succ (Nat.divGo fuel (Nat.sub n m) m)
def Nat.div (n m : Nat) : Nat := match m with
  | .zero => .zero
  | .succ _ => Nat.divGo n n m
def Nat.mod (n m : Nat) : Nat := Nat.sub n (Nat.mul m (Nat.div n m))
-- `b ^ e`, recursing on `e`
def Nat.powFrom : Nat → Nat → Nat
  | .zero, _ => .succ .zero
  | .succ e, b => Nat.mul b (Nat.powFrom e b)
def Nat.pow (b e : Nat) : Nat := Nat.powFrom e b
def Bool.xor : Bool → Bool → Bool
  | .true, b => Bool.not b
  | .false, b => b
-- a bitwise operation, bit by bit from the lowest (`fuel` bounds the number of bits)
def Nat.isOdd (n : Nat) : Bool := Nat.beq (Nat.mod n 2) 1
def Nat.bitwise (f : Bool → Bool → Bool) : Nat → Nat → Nat → Nat
  | .zero, _, _ => .zero
  | .succ fuel, a, b =>
    let rest := Nat.mul 2 (Nat.bitwise f fuel (Nat.div a 2) (Nat.div b 2));
    match f (Nat.isOdd a) (Nat.isOdd b) with
    | .true => .succ rest
    | .false => rest
def Nat.land (a b : Nat) : Nat := Nat.bitwise Bool.and (Nat.add a b) a b
def Nat.lor (a b : Nat) : Nat := Nat.bitwise Bool.or (Nat.add a b) a b
def Nat.xor (a b : Nat) : Nat := Nat.bitwise Bool.xor (Nat.add a b) a b
def Nat.shiftLeft (a n : Nat) : Nat := Nat.mul a (Nat.pow 2 n)
def Nat.shiftRight (a n : Nat) : Nat := Nat.div a (Nat.pow 2 n)
def Nat.log2Go : Nat → Nat → Nat
  | .zero, _ => .zero
  | .succ fuel, n => match Nat.lt n 2 with
    | .true => .zero
    | .false => .succ (Nat.log2Go fuel (Nat.div n 2))
def Nat.log2 (n : Nat) : Nat := Nat.log2Go n n
builtin nat.div := Nat.div
builtin nat.mod := Nat.mod
builtin nat.pow := Nat.pow
builtin nat.land := Nat.land
builtin nat.lor := Nat.lor
builtin nat.xor := Nat.xor
builtin nat.shiftLeft := Nat.shiftLeft
builtin nat.shiftRight := Nat.shiftRight
builtin nat.log2 := Nat.log2
-- bit `i` of `n`
def Nat.testBit (n i : Nat) : Bool := Nat.isOdd (Nat.shiftRight n i)
infixl:70 " / " => Nat.div

-- Errors.
inductive Except (E A : Type) where
  | error (e : E)
  | ok (a : A)

-- Reflected terms, for tactics. Variables are de Bruijn indices, relative to the goal's
-- context. Kernel forms with no constructor here (μ, descriptions, equality, sizes, …)
-- are `opaque` handles, held by the elaborator.
inductive Expr where
  | var (i : Nat)
  | const (n : String)
  | sort (u : Nat)
  | pi (x : String) (implicit : Bool) (q : Expr) (dom : Expr) (body : Expr)
  | lam (x : String) (body : Expr)
  | app (f : Expr) (a : Expr)
  | lit (n : Nat)
  | opaque (id : Nat)

-- Reflection (HD8): a declared inductive type or structure as command macros see it.
-- Types are syntax, written with the names of the binders in scope (the parameters,
-- then the earlier fields), not de Bruijn indices.
inductive BinderKind where
  | default
  | implicit
  | instImplicit
inductive ParamView where
  | mk (name : String) (kind : BinderKind) (type : Syntax)
-- a constructor field; `recursive` if its type is the inductive type itself, `proof` if
-- its type is a proposition
inductive FieldView where
  | mk (name : String) (kind : BinderKind) (type : Syntax) (recursive : Bool) (proof : Bool)
-- a constructor (short name, `cons`), its fields after the parameters, and the indices
-- of its result type
inductive CtorView where
  | mk (name : String) (fields : List FieldView) (indices : List Syntax)
inductive IndView where
  | mk (name : String) (levelParams : List String) (params : List ParamView)
       (indices : List ParamView) (ctors : List CtorView) (isStructure : Bool)

-- Requests to the elaborator, each with what to do with the answer: a free monad (its
-- continuations are infinitary fields). The elaborator interprets them; the order of
-- the constructors is fixed (`Elab/Tactic.lean`).
inductive Tac where
  | done
  | result (stx : Syntax)
  | fail (msg : String)
  | trace (msg : String) (next : Tac)
  | fresh (k : Nat → Tac)
  | getGoals (k : List Nat → Tac)
  | setGoals (gs : List Nat) (next : Tac)
  | goalType (g : Nat) (k : Expr → Tac)
  | goalExpr (g : Nat) (k : Expr → Tac)
  | goalHyps (g : Nat) (k : List (String × Expr) → Tac)
  | intro (g : Nat) (x : String) (k : Nat → Tac)
  | exact (g : Nat) (stx : Syntax) (next : Tac)
  | elabInfer (g : Nat) (stx : Syntax) (k : Expr × Expr → Tac)
  | assign (g : Nat) (e : Expr) (next : Tac)
  | newGoal (g : Nat) (ty : Expr) (k : Nat → Tac)
  | normalize (g : Nat) (e : Expr) (k : Expr → Tac)
  | instantiate (g : Nat) (body : Expr) (arg : Expr) (k : Expr → Tac)
  | isDefEq (g : Nat) (a : Expr) (b : Expr) (k : Bool → Tac)
  | inferType (g : Nat) (e : Expr) (k : Expr → Tac)
  | evalTactic (stx : Syntax) (next : Tac)
  | catch (body : Tac) (handler : String → Tac) (next : Tac)
  | getInductive (n : String) (k : Option IndView → Tac)
  | getType (n : String) (k : Option Syntax → Tac)
  -- tactic framework (tactic-fw): printing; new requests are appended, the numbers above
  -- don't change
  | ppGoal (g : Nat) (k : String → Tac)
  | ppExpr (g : Nat) (e : Expr) (k : String → Tac)
  -- names: introduce with a fresh name (the name and the new goal); rename hypothesis `i`
  | introFresh (g : Nat) (hint : String) (inaccessible : Bool) (k : String × Nat → Tac)
  | rename (g : Nat) (i : Nat) (x : String) (k : Nat → Tac)
  -- unfolding and rewriting: restate the goal (a new goal), compute, unfold `n` once,
  -- rewrite with an equation `h` (a new goal)
  | change (g : Nat) (ty : Expr) (k : Nat → Tac)
  | whnf (g : Nat) (e : Expr) (k : Expr → Tac)
  | unfold (g : Nat) (n : String) (e : Expr) (k : Expr → Tac)
  | rewrite (g : Nat) (h : Expr) (rtl : Bool) (k : Nat → Tac)

-- The metaprogramming monad: requests in continuation-passing style, so `bind` is just
-- composition. Macros and tactics both use it.
def TacticM (A : Type) : Type := (A → Tac) → Tac
def TacticM.pure {A : Type} (a : A) : TacticM A := fun k => k a
def TacticM.bind {A B : Type} (x : TacticM A) (f : A → TacticM B) : TacticM B := fun k => x (fun a => f a k)
def TacticM.run (t : TacticM Unit) : Tac := t (fun _ => Tac.done)
def TacticM.fail {A : Type} (msg : String) : TacticM A := fun _ => Tac.fail msg
def TacticM.trace (msg : String) : TacticM Unit := fun k => Tac.trace msg (k ())
def TacticM.fresh : TacticM Nat := fun k => Tac.fresh k
def TacticM.getGoals : TacticM (List Nat) := fun k => Tac.getGoals k
def TacticM.setGoals (gs : List Nat) : TacticM Unit := fun k => Tac.setGoals gs (k ())
def TacticM.goalType (g : Nat) : TacticM Expr := fun k => Tac.goalType g k
def TacticM.goalExpr (g : Nat) : TacticM Expr := fun k => Tac.goalExpr g k
def TacticM.goalHyps (g : Nat) : TacticM (List (String × Expr)) := fun k => Tac.goalHyps g k
def TacticM.intro (g : Nat) (x : String) : TacticM Nat := fun k => Tac.intro g x k
def TacticM.exact (g : Nat) (stx : Syntax) : TacticM Unit := fun k => Tac.exact g stx (k ())
def TacticM.elabInfer (g : Nat) (stx : Syntax) : TacticM (Expr × Expr) := fun k => Tac.elabInfer g stx k
def TacticM.assign (g : Nat) (e : Expr) : TacticM Unit := fun k => Tac.assign g e (k ())
def TacticM.newGoal (g : Nat) (ty : Expr) : TacticM Nat := fun k => Tac.newGoal g ty k
def TacticM.normalize (g : Nat) (e : Expr) : TacticM Expr := fun k => Tac.normalize g e k
-- `body` (under one more binder than goal `g`'s context) with `arg` for its variable 0
def TacticM.instantiate (g : Nat) (body arg : Expr) : TacticM Expr := fun k => Tac.instantiate g body arg k
def TacticM.isDefEq (g : Nat) (a b : Expr) : TacticM Bool := fun k => Tac.isDefEq g a b k
def TacticM.inferType (g : Nat) (e : Expr) : TacticM Expr := fun k => Tac.inferType g e k
def TacticM.evalTactic (stx : Syntax) : TacticM Unit := fun k => Tac.evalTactic stx (k ())
-- goal `g` as the elaborator shows it (hypotheses, then `⊢ type`), and a term in goal
-- `g`'s context: for `trace` and for error messages
def TacticM.ppGoal (g : Nat) : TacticM String := fun k => Tac.ppGoal g k
def TacticM.ppExpr (g : Nat) (e : Expr) : TacticM String := fun k => Tac.ppExpr g e k
-- Introduce a variable under a fresh name, and return the name with the new goal. The
-- name is `hint`, or (if `hint` is "") the binder's, or `h` (a proof) or `x`; if it is
-- taken it gets the first free numeric suffix (`n`, `n1`, `n2`, …).
def TacticM.introFresh (g : Nat) (hint : String) : TacticM (String × Nat) :=
  fun k => Tac.introFresh g hint .false k
-- … under an inaccessible name (`n✝`): the user cannot write it, so no proof depends on
-- it; `rename_i` (or `TacticM.rename`) names it.
def TacticM.introInaccessible (g : Nat) (hint : String) : TacticM (String × Nat) :=
  fun k => Tac.introFresh g hint .true k
-- goal `g` with its hypothesis `i` (the variable `Expr.var i`) renamed: a new goal
def TacticM.rename (g : Nat) (i : Nat) (x : String) : TacticM Nat := fun k => Tac.rename g i x k
-- Goal `g` restated as `ty`, which must be convertible with its type: the new goal.
def TacticM.change (g : Nat) (ty : Expr) : TacticM Nat := fun k => Tac.change g ty k
-- `e` with its head unfolded until it is not a definition (a constructor, a binder, a
-- variable): weak head normal form. Recursive calls are folded back where possible.
def TacticM.whnf (g : Nat) (e : Expr) : TacticM Expr := fun k => Tac.whnf g e k
-- `e` with every application of the definition `n` unfolded once (the `match` on its
-- arguments computed, the definitions in its body still folded, recursive calls folded
-- back): `MList (x :: L) p` becomes `∃ n, (p ↦ (x, n)) ⋆ MList L n`.
def TacticM.unfold (g : Nat) (n : String) (e : Expr) : TacticM Expr := fun k => Tac.unfold g n e k
-- Rewrite goal `g` with `h : a = b` (a complete term): every `a` in it becomes `b` (or
-- every `b` becomes `a`, if `rtl`). The new goal.
def TacticM.rewrite (g : Nat) (h : Expr) (rtl : Bool) : TacticM Nat := fun k => Tac.rewrite g h rtl k
def TacticM.tryCatch (t : TacticM Unit) (h : String → TacticM Unit) : TacticM Unit :=
  fun k => Tac.catch (TacticM.run t) (fun e => TacticM.run (h e)) (k ())

-- Type classes (stage 7). `outParam` marks a class parameter that instance resolution
-- determines (it is the identity).
def outParam.{u} (A : Sort u) : Sort u := A

class Monad (m : Type → Type) where
  pure : {A : Type} → A → m A
  bind : {A B : Type} → m A → (A → m B) → m B
-- A bind that takes the action and the continuation at quantity 1 (L6), so the
-- continuation may capture linear resources; `do1` is `do` notation over it.
class Monad1 (m : Type → Type) where
  bind1 : {A B : Type} → (1 x : m A) → (1 f : A → m B) → m B

instance : Monad TacticM where
  pure := TacticM.pure
  bind := TacticM.bind

-- Macros: `MacroM` is the same monad (it only uses `fresh` and `fail`).
def MacroM (A : Type) : Type := TacticM A
def MacroM.pure {A : Type} (a : A) : MacroM A := TacticM.pure a
def MacroM.throw {A : Type} (e : String) : MacroM A := TacticM.fail e
def MacroM.fresh : MacroM Nat := TacticM.fresh
-- A procedural macro, registered with `attribute [macro kind] f`.
def Macro : Type := Syntax → MacroM Syntax
def Macro.run (m : MacroM Syntax) : Tac := m (fun s => Tac.result s)
-- (HD8) Read the environment: a declared inductive type or structure, and the type of
-- any declaration, as syntax.
def MacroM.getInductive (n : String) : MacroM (Option IndView) := fun k => Tac.getInductive n k
def MacroM.getType (n : String) : MacroM (Option Syntax) := fun k => Tac.getType n k
def ParamView.name : ParamView → String
  | .mk n _ _ => n
def ParamView.kind : ParamView → BinderKind
  | .mk _ k _ => k
def ParamView.type : ParamView → Syntax
  | .mk _ _ t => t
def FieldView.name : FieldView → String
  | .mk n _ _ _ _ => n
def FieldView.kind : FieldView → BinderKind
  | .mk _ k _ _ _ => k
def FieldView.type : FieldView → Syntax
  | .mk _ _ t _ _ => t
def FieldView.recursive : FieldView → Bool
  | .mk _ _ _ r _ => r
def FieldView.proof : FieldView → Bool
  | .mk _ _ _ _ p => p
def CtorView.name : CtorView → String
  | .mk n _ _ => n
def CtorView.fields : CtorView → List FieldView
  | .mk _ fs _ => fs
def CtorView.indices : CtorView → List Syntax
  | .mk _ _ is => is
def IndView.name : IndView → String
  | .mk n _ _ _ _ _ => n
def IndView.levelParams : IndView → List String
  | .mk _ us _ _ _ _ => us
def IndView.params : IndView → List ParamView
  | .mk _ _ ps _ _ _ => ps
def IndView.indices : IndView → List ParamView
  | .mk _ _ _ is _ _ => is
def IndView.ctors : IndView → List CtorView
  | .mk _ _ _ _ cs _ => cs
def IndView.isStructure : IndView → Bool
  | .mk _ _ _ _ _ b => b
-- Building syntax: a node, an identifier (`x`, and the term `x`), literals, applications.
def SyntaxF.ofList : List Syntax → SyntaxF .false
  | .nil => .nil
  | .cons x xs => .cons x (SyntaxF.ofList xs)
def Syntax.mkNode (kind : String) (args : List Syntax) : Syntax := .node kind (SyntaxF.ofList args)
def Syntax.mkIdent (x : String) : Syntax := .ident x
def Syntax.mkVar (x : String) : Syntax := Syntax.mkNode "term.ident" (.cons (.ident x) .nil)
def Syntax.mkStr (s : String) : Syntax :=
  Syntax.mkNode "term.str" (.cons (Syntax.mkNode "str" (.cons (.atom s) .nil)) .nil)
def Syntax.mkApp (f : Syntax) : List Syntax → Syntax
  | .nil => f
  | .cons a rest => Syntax.mkNode "term.app" (.cons f (.cons (Syntax.mkNode "null" (.cons a rest)) .nil))
-- A command macro, registered with `attribute [macro command.k] f`: it expands one
-- command into any number of commands.
def CommandMacro : Type := Syntax → MacroM (List Syntax)
def CommandMacro.run (m : MacroM (List Syntax)) : Tac := m (fun cs => Tac.result (Syntax.mkNode "null" cs))
-- A deriver, registered with `attribute [deriver C] f`: given the name of an inductive
-- type, the commands that make it an instance of `C` (`deriving C`).
def Deriver : Type := String → MacroM (List Syntax)

-- `do` notation for any `Monad`, written as macros: `do x ← e; rest`, `do e; rest`, `do e`.
declare_syntax_cat doSeq
syntax (name := last) term : doSeq
syntax (name := bind) ident "←" term ";" doSeq : doSeq
syntax (name := seq) term ";" doSeq : doSeq
syntax (name := block) "do" doSeq : term
macro_rules
  | `(term| do $e:term) => `(term| $e)
macro_rules
  | `(term| do $e:term; $rest) => `(term| Monad.bind $e (fun _ => do $rest))
macro_rules
  | `(term| do $x ← $e; $rest) => `(term| Monad.bind $e (fun $x => do $rest))
-- `do let x := e; rest` (declared last: it wins over `let` as a term)
syntax (name := letBind) "let" ident ":=" term ";" doSeq : doSeq
macro_rules
  | `(term| do let $x := $e; $rest) => `(term| let $x := $e; do $rest)
-- `do1`: the same over `Monad1.bind1`, for linear sequencing (L6). The action of each
-- step and the rest of the block are used once, so the rest may use a linear variable
-- (and an action may consume one); the bound results are unrestricted.
syntax (name := block1) "do1" doSeq : term
macro_rules
  | `(term| do1 $e:term) => `(term| $e)
macro_rules
  | `(term| do1 $e:term; $rest) => `(term| Monad1.bind1 $e (fun _ => do1 $rest))
macro_rules
  | `(term| do1 $x ← $e; $rest) => `(term| Monad1.bind1 $e (fun $x => do1 $rest))
macro_rules
  | `(term| do1 let $x := $e; $rest) => `(term| let $x := $e; do1 $rest)

-- Taking syntax apart.
def SyntaxF.nth {b : Bool} : SyntaxF b → Nat → Syntax
  | .cons x t, n => match n with
    | .zero => x
    | .succ m => SyntaxF.nth t m
  | _, _ => .missing
def Syntax.getArg (stx : Syntax) (i : Nat) : Syntax := match stx with
  | .node _ args => SyntaxF.nth args i
  | _ => .missing

-- Tactics: a tactic is a Wiz function from its syntax to `TacticM Unit`, registered
-- with `attribute [tactic kind] f`. `by tac₁; tac₂ …` runs them on the goal.
def Tactic : Type := Syntax → TacticM Unit

def TacticM.mainGoal : TacticM Nat := do
  gs ← TacticM.getGoals;
  match gs with
  | .nil => TacticM.fail "no goals"
  | .cons g _ => TacticM.pure g

def TacticM.replaceMainGoal (new : List Nat) : TacticM Unit := do
  gs ← TacticM.getGoals;
  match gs with
  | .nil => TacticM.setGoals new
  | .cons _ rest => TacticM.setGoals (List.append new rest)

def Syntax.identName (stx : Syntax) : TacticM String := match stx with
  | .ident s => TacticM.pure s
  | _ => TacticM.fail "expected an identifier"

syntax (name := intro) "intro" ident : tactic
def Tactic.intro : Tactic := fun stx => do
  g ← TacticM.mainGoal;
  x ← Syntax.identName (Syntax.getArg stx 1);
  g' ← TacticM.intro g x;
  TacticM.replaceMainGoal (.cons g' .nil)
attribute [tactic tactic.intro] Tactic.intro

syntax (name := exact) "exact" term : tactic
def Tactic.exact : Tactic := fun stx => do
  g ← TacticM.mainGoal;
  TacticM.exact g (Syntax.getArg stx 1);
  TacticM.replaceMainGoal .nil
attribute [tactic tactic.exact] Tactic.exact

syntax (name := rflTac) "rfl" : tactic
macro_rules
  | `(tactic| rfl) => `(tactic| exact rfl)

-- `assumption`: close the goal with a hypothesis of a definitionally equal type.
def TacticM.findHyp : List (String × Expr) → Nat → Nat → Expr → TacticM Unit
  --<sol
  | .nil, _, _, _ => TacticM.fail "assumption: no hypothesis matches the goal"
  | .cons h hs, i, g, ty => do
    ok ← TacticM.isDefEq g h.2 ty;
    match ok with
    | .true => TacticM.assign g (.var i)
    | .false => TacticM.findHyp hs (Nat.succ i) g ty
  --|ex
  --| -- Exercise 6.6: try the hypotheses in order (the `i`th is `Expr.var i`), with
  --| -- `TacticM.isDefEq` against the goal `ty`, and `TacticM.assign` the first that fits.
  --| | _, _, _, _ => TacticM.fail "assumption: not implemented yet"
  --sol>
syntax (name := assumption) "assumption" : tactic
def Tactic.assumption : Tactic := fun _ => do
  g ← TacticM.mainGoal;
  ty ← TacticM.goalType g;
  hyps ← TacticM.goalHyps g;
  TacticM.findHyp hyps 0 g ty;
  TacticM.replaceMainGoal .nil
attribute [tactic tactic.assumption] Tactic.assumption

-- `apply f`: a new goal for each argument of `f`, then unify `f`'s result type with the
-- goal. Arguments that unification determines are dropped from the goals.
def TacticM.applyLoop : Nat → Nat → Expr → Expr → List Nat → TacticM (List Nat)
  | .zero, _, _, _, _ => TacticM.fail "apply: too many arguments"
  | .succ fuel, g, e, ty, acc => match ty with
    | .pi _ _ _ dom body => do
      ng ← TacticM.newGoal g dom;
      a ← TacticM.goalExpr ng;
      body' ← TacticM.instantiate g body a;
      TacticM.applyLoop fuel g (.app e a) body' (List.append acc (.cons ng .nil))
    | _ => do
      goalTy ← TacticM.goalType g;
      ok ← TacticM.isDefEq g ty goalTy;
      match ok with
      | .true => do TacticM.assign g e; TacticM.pure acc
      | .false => TacticM.fail "apply: the result type does not match the goal"
syntax (name := apply) "apply" term : tactic
def Tactic.apply : Tactic := fun stx => do
  g ← TacticM.mainGoal;
  p ← TacticM.elabInfer g (Syntax.getArg stx 1);
  new ← TacticM.applyLoop 64 g p.1 p.2 .nil;
  TacticM.replaceMainGoal new
attribute [tactic tactic.apply] Tactic.apply

syntax (name := try) "try" tactic : tactic
def Tactic.try : Tactic := fun stx =>
  TacticM.tryCatch (TacticM.evalTactic (Syntax.getArg stx 1)) (fun _ => TacticM.pure ())
attribute [tactic tactic.try] Tactic.try

syntax (name := first) "first" "|" tactic "|" tactic : tactic
def Tactic.first : Tactic := fun stx =>
  TacticM.tryCatch (TacticM.evalTactic (Syntax.getArg stx 2)) (fun _ => TacticM.evalTactic (Syntax.getArg stx 4))
attribute [tactic tactic.first] Tactic.first

-- `(tac₁; tac₂; …)` runs a sequence.
def TacticM.evalSeq {b : Bool} : SyntaxF b → TacticM Unit
  | .cons t ts => do TacticM.evalTactic t; TacticM.evalSeq ts
  | _ => TacticM.pure ()
syntax (name := paren) "(" sepBy(tactic, ";") ")" : tactic
def Tactic.paren : Tactic := fun stx => match Syntax.getArg stx 1 with
  | .node _ ts => TacticM.evalSeq ts
  | _ => TacticM.pure ()
attribute [tactic tactic.paren] Tactic.paren

-- `repeat tac`: run `tac` until it fails (at most 64 times).
def TacticM.repeatN : Nat → Syntax → TacticM Unit
  | .zero, _ => TacticM.pure ()
  | .succ n, t => TacticM.tryCatch (do TacticM.evalTactic t; TacticM.repeatN n t) (fun _ => TacticM.pure ())
syntax (name := repeat) "repeat" tactic : tactic
def Tactic.repeat : Tactic := fun stx => TacticM.repeatN 64 (Syntax.getArg stx 1)
attribute [tactic tactic.repeat] Tactic.repeat

syntax (name := trace) "trace" str : tactic
def Tactic.trace : Tactic := fun stx => match Syntax.getArg (Syntax.getArg stx 1) 0 with
  | .atom s => TacticM.trace s
  | _ => TacticM.pure ()
attribute [tactic tactic.trace] Tactic.trace

-- `trace_state`: the open goals, as an info message (as `trace`, at the tactic)
def TacticM.ppGoals : List Nat → TacticM String
  | .nil => TacticM.pure "no goals"
  | .cons g .nil => TacticM.ppGoal g
  | .cons g gs => do
    a ← TacticM.ppGoal g;
    rest ← TacticM.ppGoals gs;
    TacticM.pure (String.append a (String.append "\n\n" rest))
syntax (name := traceState) "trace_state" : tactic
def Tactic.traceState : Tactic := fun _ => do
  gs ← TacticM.getGoals;
  s ← TacticM.ppGoals gs;
  TacticM.trace s
attribute [tactic tactic.traceState] Tactic.traceState

-- ## Names (stage 6e)
--
-- `intros` takes the binders' names, as inaccessible names (`n✝`);
-- `rename_i a, b` names the last inaccessible hypotheses (`b` the most recent).
-- introduce while the goal is (syntactically) a function type; the names, in order
def TacticM.introsLoop : Nat → Nat → TacticM (List String × Nat)
  | .zero, g => TacticM.pure (.nil, g)
  | .succ fuel, g => do
    ty ← TacticM.goalType g;
    match ty with
    | .pi _ _ _ _ _ => do
      p ← TacticM.introInaccessible g "";
      r ← TacticM.introsLoop fuel p.2;
      TacticM.pure (.cons p.1 r.1, r.2)
    | _ => TacticM.pure (.nil, g)
def TacticM.intros (g : Nat) : TacticM (List String × Nat) := TacticM.introsLoop 4096 g
syntax (name := intros) "intros" : tactic
def Tactic.intros : Tactic := fun _ => do
  g ← TacticM.mainGoal;
  r ← TacticM.intros g;
  TacticM.replaceMainGoal (.cons r.2 .nil)
attribute [tactic tactic.intros] Tactic.intros

-- does a name carry the inaccessible mark `✝` (code point 10013)?
def List.hasDagger : List Char → Bool
  | .nil => .false
  | .cons c cs => match Nat.beq (Char.code c) 10013 with
    | .true => .true
    | .false => List.hasDagger cs
def String.isInaccessible : String → Bool
  | .mk cs => List.hasDagger cs

-- the indices of the inaccessible hypotheses, innermost first
def TacticM.inaccessibleFrom : Nat → List (String × Expr) → List Nat
  | _, .nil => .nil
  | i, .cons h hs => match String.isInaccessible h.1 with
    | .true => .cons i (TacticM.inaccessibleFrom (Nat.succ i) hs)
    | .false => TacticM.inaccessibleFrom (Nat.succ i) hs
def List.revOnto {A : Type} : List A → List A → List A
  | .nil, acc => acc
  | .cons x xs, acc => List.revOnto xs (.cons x acc)
-- `names` are given innermost first, like the indices
def TacticM.renameAll : Nat → List Nat → List String → TacticM Nat
  | g, _, .nil => TacticM.pure g
  | _, .nil, .cons _ _ => TacticM.fail "rename_i: more names than inaccessible hypotheses"
  | g, .cons i ixs, .cons x xs => do
    g' ← TacticM.rename g i x;
    TacticM.renameAll g' ixs xs
def Syntax.identNames {b : Bool} : SyntaxF b → List String
  | .cons (.ident x) rest => .cons x (Syntax.identNames rest)
  | .cons _ rest => Syntax.identNames rest
  | _ => .nil
def Syntax.sepIdents (stx : Syntax) : List String := match stx with
  | .node _ xs => Syntax.identNames xs
  | _ => .nil
syntax (name := renameI) "rename_i" sepBy1(ident, ",") : tactic
def Tactic.renameI : Tactic := fun stx => do
  g ← TacticM.mainGoal;
  hyps ← TacticM.goalHyps g;
  g' ← TacticM.renameAll g (TacticM.inaccessibleFrom 0 hyps) (List.revOnto (Syntax.sepIdents (Syntax.getArg stx 1)) .nil);
  TacticM.replaceMainGoal (.cons g' .nil)
attribute [tactic tactic.renameI] Tactic.renameI

-- ## Unfolding and rewriting (stage 6f)
--
-- `unfold f, g` unfolds the definitions `f` and `g` in the goal, once each;
-- `whnf` computes the goal's head; `change t` restates the goal as the convertible
-- `t`; `rw h` and `rw ← h` rewrite it with the equation `h`.
def TacticM.unfoldAll (g : Nat) : List String → Expr → TacticM Expr
  | .nil, e => TacticM.pure e
  | .cons n ns, e => do
    e' ← TacticM.unfold g n e;
    TacticM.unfoldAll g ns e'
syntax (name := unfold) "unfold" sepBy1(ident, ",") : tactic
def Tactic.unfold : Tactic := fun stx => do
  g ← TacticM.mainGoal;
  ty ← TacticM.goalType g;
  ty' ← TacticM.unfoldAll g (Syntax.sepIdents (Syntax.getArg stx 1)) ty;
  g' ← TacticM.change g ty';
  TacticM.replaceMainGoal (.cons g' .nil)
attribute [tactic tactic.unfold] Tactic.unfold

syntax (name := whnf) "whnf" : tactic
def Tactic.whnf : Tactic := fun _ => do
  g ← TacticM.mainGoal;
  ty ← TacticM.goalType g;
  ty' ← TacticM.whnf g ty;
  g' ← TacticM.change g ty';
  TacticM.replaceMainGoal (.cons g' .nil)
attribute [tactic tactic.whnf] Tactic.whnf

syntax (name := change) "change" term : tactic
def Tactic.change : Tactic := fun stx => do
  g ← TacticM.mainGoal;
  p ← TacticM.elabInfer g (Syntax.getArg stx 1);
  g' ← TacticM.change g p.1;
  TacticM.replaceMainGoal (.cons g' .nil)
attribute [tactic tactic.change] Tactic.change

syntax (name := rw) "rw" term : tactic
def Tactic.rw : Tactic := fun stx => do
  g ← TacticM.mainGoal;
  p ← TacticM.elabInfer g (Syntax.getArg stx 1);
  g' ← TacticM.rewrite g p.1 .false;
  TacticM.replaceMainGoal (.cons g' .nil)
attribute [tactic tactic.rw] Tactic.rw
syntax (name := rwBack) "rw" "←" term : tactic
def Tactic.rwBack : Tactic := fun stx => do
  g ← TacticM.mainGoal;
  p ← TacticM.elabInfer g (Syntax.getArg stx 2);
  g' ← TacticM.rewrite g p.1 .true;
  TacticM.replaceMainGoal (.cons g' .nil)
attribute [tactic tactic.rwBack] Tactic.rwBack
