import BitVec
import Logic
import Trace
import Deriving
/-!
# Hdl.Core: hardware description

The HDL library (`import Hdl.Core`): describe digital circuits in Wiz, simulate them,
prove things about them, and synthesise them to a netlist, Verilog, a test bench, a VCD
waveform and pin constraints. docs/libraries.md ("H14 S0", "H14 S1") describes it; design
notes are in drafts/hdl/Synth.wiz and /workspace/wiz-notes/hdl-usability.md.

Combinational logic is *tagless-final* code, polymorphic in its representation
`r : HwTy → Type` (the class `Hw`), with two instances: values (`HwTy.El`, for simulation
and proofs) and wires (`Wire`, for netlist construction). The same definition is both the
specification and the hardware. A sequential circuit is a `Circuit i o`, a Mealy machine
whose step is such code; its state is the registers.

* **Types are codes** (`HwTy`): bit vectors, products, and `named s t`, a type with a name
  (`HwTy.El`, `HwTy.width` and the bus encoding ignore the name; the netlist uses it for
  ports, registers and wires).
* **Wires are structured**: a value of a product type is a product of node ids, so pairs
  and projections cost nothing, and ports and registers are one per leaf, named by the
  path of `named` segments (`tx_cnt`).
* **Memories**: `HwTy.mem aw dw`, `2^aw` words of `dw` bits, a function at values; read
  with `Hw.memRead` (combinational), written with `Hw.memWrite` (at the clock edge, when
  it is the state's next value). In Verilog an array, which yosys maps to block RAM.
* **Bundles**: structures of signals (`structure Tx (r : HwTy → Type) where line : r Bit …`)
  are `Bundle`s: `deriving Bundle` gives their code and the conversions, and field access
  is the ordinary `s.line`.
* **Sharing.** `Wire t` is a netlist-building computation, so a wire used twice would be
  built twice. The builder hash-conses (identical nodes are one node), and a meta-level
  `let` of an object value whose body is an object value is elaborated as
  `ShareLet.share v (fun x => body)` (auto-share), which at `Wire` runs `v` once. Write
  `let ω x := …` to opt out, `Hw.share` for explicit sharing and `Hw.label "name" x` to
  name a wire.

The main definitions: `Hw` (the operations), `Circuit` and its combinators
(`Circuit.seq`, `Circuit.par`, `Circuit.loop`, `Circuit.delay`, `Circuit.withReset`,
`Circuit.withEnable`) with lemmas about `Circuit.run`; `Circuit.netlist`,
`Netlist.simulate`, `Verilog.emit`, `Testbench.verilog`, `Vcd.ofRun` and `Pcf.emit`.

```
import IO
import Hdl.Core

-- an 8-bit counter with a clock enable: the output is the count
def counter : Circuit (HwTy.bits 0) (HwTy.bits 8) :=
  Circuit.mk (HwTy.bits 8) (BitVec.ofNat 8 0) (fun s _ => Hw.pair (Hw.add s (Hw.lit 8 1)) s)

def main : IO Unit := IO.println (Verilog.emit (Circuit.netlist "counter" (Circuit.withEnable counter)))
```
-/

------------------------------------------------------------------------------------
-- Small helpers (prefixed `Hdl.`, so that importers keep the general names)

/-- `Hdl.rev xs acc`: `xs` reversed, in front of `acc`. -/
def Hdl.rev {A : Type} : List A → List A → List A
  | .nil, acc => acc
  | .cons x xs, acc => Hdl.rev xs (List.cons x acc)
/-- A list reversed (`Hdl.reverse [1, 2, 3] = [3, 2, 1]`). -/
def Hdl.reverse {A : Type} (xs : List A) : List A := Hdl.rev xs List.nil

/-- `f` applied to every element of a list. -/
def Hdl.map {A B : Type} (f : A → B) : List A → List B
  | .nil => .nil
  | .cons x xs => .cons (f x) (Hdl.map f xs)

/-- `Hdl.nthD d xs k`: the `k`-th element of `xs` (from 0), or `d` if the list is shorter. -/
def Hdl.nthD {A : Type} (d : A) : List A → Nat → A
  | .nil, _ => d
  | .cons x _, .zero => x
  | .cons _ xs, .succ k => Hdl.nthD d xs k

/-- Whether two lists of numbers are equal (the hash-consing table compares keys with it). -/
def Hdl.natsEq : List Nat → List Nat → Bool
  | .nil, .nil => .true
  | .cons a as, .cons b bs => Bool.and (Nat.beq a b) (Hdl.natsEq as bs)
  | _, _ => .false

/-- The sum of a list of numbers. -/
def Hdl.sum : List Nat → Nat
  | .nil => 0
  | .cons x xs => x + Hdl.sum xs

/-- The elements with their indices, counting from `k`:
`Hdl.indexed 0 [a, b] = [(0, a), (1, b)]`. -/
def Hdl.indexed {A : Type} : Nat → List A → List (Nat × A)
  | _, .nil => .nil
  | k, .cons x xs => .cons (k, x) (Hdl.indexed (Nat.succ k) xs)

infixr:67 " <+> " => String.append
/-- The decimal digits of `n` pushed onto `acc`; the first argument is fuel (a bound on the
number of digits). -/
def Hdl.digitsAux : Nat → Nat → List Char → List Char
  | .zero, _, acc => acc
  | .succ f, n, acc => match Nat.lt n 10 with
    | .true => List.cons (Char.mk (48 + n)) acc
    | .false => Hdl.digitsAux f (Nat.div n 10) (List.cons (Char.mk (48 + Nat.mod n 10)) acc)
/-- A number in decimal: `Hdl.show 42 = "42"`. -/
def Hdl.show (n : Nat) : String := String.mk (Hdl.digitsAux (Nat.succ n) n List.nil)
/-- The lower-case hexadecimal digit of a number below 16. -/
def Hdl.hexDigit (n : Nat) : Char := match Nat.lt n 10 with
  | .true => Char.mk (48 + n)
  | .false => Char.mk (87 + n)
/-- `Hdl.hexAux d v acc`: `d` hexadecimal digits of `v` (zero-padded, most significant
first), pushed onto `acc`. -/
def Hdl.hexAux : Nat → Nat → List Char → List Char
  | .zero, _, acc => acc
  | .succ d, v, acc => Hdl.hexAux d (Nat.div v 16) (List.cons (Hdl.hexDigit (Nat.mod v 16)) acc)
/-- `Hdl.binAux w v acc`: `w` binary digits of `v` (most significant first), pushed onto `acc`. -/
def Hdl.binAux : Nat → Nat → List Char → List Char
  | .zero, _, acc => acc
  | .succ d, v, acc => Hdl.binAux d (Nat.div v 2) (List.cons (Char.mk (48 + Nat.mod v 2)) acc)
/-- `v` as `w` binary digits: `Hdl.bin 4 5 = "0101"` (VCD values are written so). -/
def Hdl.bin (w v : Nat) : String := String.mk (Hdl.binAux w v List.nil)
/-- String equality. -/
def Hdl.strEq (a b : String) : Bool := String.beq a b
/-- The strings of a list, joined. -/
def Hdl.concat : List String → String
  | .nil => ""
  | .cons s ss => s <+> Hdl.concat ss

------------------------------------------------------------------------------------
-- Hardware types (codes) and their values

/-- Hardware types, as codes: what a signal carries.

* `bits n`: a bit vector of width `n`;
* `prod a b`: a pair (a bundle of two signals);
* `named s t`: `t` with a name. The name changes nothing about the values (`HwTy.El`,
  `HwTy.width` and the bus encoding ignore it); the netlist uses it for ports, registers
  and wires (`HwTy.leafNames`).

A code rather than a type, so that circuits can compute with it: `HwTy.El t` is the type
of its values, `HwTy.Ids t` that of its wires. -/
inductive HwTy where
  | bits (n : Nat)
  | prod (a b : HwTy)
  | named (s : String) (t : HwTy)
  | mem (aw dw : Nat)

/-- The values of a hardware type: `BitVec n` for `bits n`, pairs for `prod`. This is the
representation used for simulation and proofs (`instance : Hw HwTy.El`). -/
def HwTy.El : HwTy → Type
  | .bits n => BitVec n
  | .prod a b => HwTy.El a × HwTy.El b
  | .named _ t => HwTy.El t
  | .mem aw dw => BitVec aw → BitVec dw

/-- The total number of bits of a hardware type: `HwTy.width (.prod (.bits 3) (.bits 5)) = 8`. -/
def HwTy.width : HwTy → Nat
  | .bits n => n
  | .prod a b => HwTy.width a + HwTy.width b
  | .named _ t => HwTy.width t
  | .mem _ _ => 0

/-- The bus encoding of a value: all its bits as one number, the first component in the high
bits. `HwTy.unpack` is its inverse. -/
def HwTy.pack : (ω t : HwTy) → HwTy.El t → Nat
  | .bits n, v => v.toNat
  | .prod a b, v => Nat.shiftLeft (HwTy.pack a v.1) (HwTy.width b) + HwTy.pack b v.2
  | .named _ t, v => HwTy.pack t v
  | .mem _ _, v => 0

/-- A value from its bus encoding (`HwTy.pack`): the inverse direction, cutting the number
into the leaves' bit fields. -/
def HwTy.unpack : (ω t : HwTy) → Nat → HwTy.El t
  | .bits n, k => BitVec.ofNat n k
  | .prod a b, k => (HwTy.unpack a (Nat.shiftRight k (HwTy.width b)), HwTy.unpack b k)
  | .named _ t, k => HwTy.unpack t k
  | .mem aw dw, k => fun (a : BitVec aw) => BitVec.ofNat dw 0

-- (`HwTy.bit` rather than `HwTy.bits 1`: class field types are elaborated without
--  numerals or macros; wishful: numerals-in-class-decls)
/-- One bit, `HwTy.bits 1`: the type of conditions, resets and enables. -/
def HwTy.bit : HwTy := HwTy.bits 1

/-- The leaves of a code, in order (first component first): the widths of its bit vectors.
Memories are not leaves (no port or register carries one); `HwTy.memShapes` lists them.
`HwTy.leafWidths (.prod (.bits 1) (.bits 8)) = [1, 8]`. -/
def HwTy.leafWidths : HwTy → List Nat
  | .bits n => .cons n .nil
  | .prod a b => List.append (HwTy.leafWidths a) (HwTy.leafWidths b)
  | .named _ t => HwTy.leafWidths t
  | .mem _ _ => .nil

/-- A value's leaves as numbers, in the order of `HwTy.leafWidths` (one per port when the
value is a circuit's input or output). `HwTy.ofLeaves` goes back. -/
def HwTy.leaves : (ω t : HwTy) → HwTy.El t → List Nat
  | .bits n, v => .cons v.toNat .nil
  | .prod a b, v => List.append (HwTy.leaves a v.1) (HwTy.leaves b v.2)
  | .named _ t, v => HwTy.leaves t v
  | .mem _ _, v => .nil
/-- Read a value of type `t` from the front of a list of leaves; also returns the leaves
left over. A missing leaf reads as 0. -/
def HwTy.ofLeavesAux : (ω t : HwTy) → List Nat → HwTy.El t × List Nat
  | .bits n, .nil => (BitVec.ofNat n 0, .nil)
  | .bits n, .cons k ks => (BitVec.ofNat n k, ks)
  | .prod a b, ks =>
    let ω p := HwTy.ofLeavesAux a ks;
    let ω q := HwTy.ofLeavesAux b p.2;
    ((p.1, q.1), q.2)
  | .named _ t, ks => HwTy.ofLeavesAux t ks
  | .mem aw dw, ks => (fun (a : BitVec aw) => BitVec.ofNat dw 0, ks)
/-- A value from its leaves (`HwTy.leaves` in reverse). -/
def HwTy.ofLeaves (ω t : HwTy) (ks : List Nat) : HwTy.El t := (HwTy.ofLeavesAux t ks).1

/-- `pre_s`, or `s` alone when the prefix is empty: how `named` segments are joined into a
leaf's name. -/
def Hdl.joinName (pre s : String) : String := match pre with
  | .mk .nil => s
  | _ => pre <+> "_" <+> s
/-- The path name of every leaf, under the prefix: its `named` segments joined with `_`. -/
def HwTy.pathsAux : String → HwTy → List String
  | pre, .bits _ => .cons pre .nil
  | pre, .prod a b => List.append (HwTy.pathsAux pre a) (HwTy.pathsAux pre b)
  | pre, .named s t => HwTy.pathsAux (Hdl.joinName pre s) t
  | pre, .mem _ _ => .nil
/-- How often a string occurs in a list. -/
def Hdl.countName (s : String) : List String → Nat
  | .nil => 0
  | .cons x xs => match Hdl.strEq s x with
    | .true => Nat.succ (Hdl.countName s xs)
    | .false => Hdl.countName s xs
/-- Names made unique: a name that occurs more than once among `all` gets `_k` appended,
`k` its index. -/
def Hdl.dedup (all : List String) : List (Nat × String) → List String
  | .nil => .nil
  | .cons p ps => .cons (match Nat.lt 1 (Hdl.countName p.2 all) with
      | .true => p.2 <+> "_" <+> Hdl.show p.1
      | .false => p.2) (Hdl.dedup all ps)
/-- One name per leaf: its path under `base` (`base` alone for an unnamed leaf), with `_k`
(the leaf's index) where several leaves would get the same name. `Hw.label` names
wires with it.

```
HwTy.leafNames "tx" (.prod (.named "line" (.bits 1)) (.named "cnt" (.bits 4)))
  = ["tx_line", "tx_cnt"]
``` -/
def HwTy.leafNames (base : String) (t : HwTy) : List String :=
  let ω ps := HwTy.pathsAux base t;
  Hdl.dedup ps (Hdl.indexed 0 ps)
/-- `p`, or `base` when `p` is empty. -/
def Hdl.orBase (base p : String) : String := match p with
  | .mk .nil => base
  | _ => p
/-- The port (or register) names of a code's leaves: named leaves by their path alone,
unnamed ones `base`, made unique with `_k` like `HwTy.leafNames`. A circuit's input
ports are `HwTy.portNames "x" i`, its outputs `"y"`, its registers `"r"`. -/
def HwTy.portNames (base : String) (t : HwTy) : List String :=
  let ω ps := Hdl.map (Hdl.orBase base) (HwTy.pathsAux "" t);
  Hdl.dedup ps (Hdl.indexed 0 ps)

/-- The memories of a code, in order: their shapes (address and data widths), names
(as `portNames`) and contents (word `a` at index `a`). -/
def HwTy.memShapes : HwTy → List (Nat × Nat)
  | .bits _ => .nil
  | .prod a b => List.append (HwTy.memShapes a) (HwTy.memShapes b)
  | .named _ t => HwTy.memShapes t
  | .mem aw dw => .cons (aw, dw) .nil
/-- The path name of every memory of a code, under the prefix. -/
def HwTy.memPathsAux : String → HwTy → List String
  | pre, .bits _ => .nil
  | pre, .prod a b => List.append (HwTy.memPathsAux pre a) (HwTy.memPathsAux pre b)
  | pre, .named s t => HwTy.memPathsAux (Hdl.joinName pre s) t
  | pre, .mem _ _ => .cons pre .nil
/-- Memory names, made unique like `HwTy.portNames`. -/
def HwTy.memNames (base : String) (t : HwTy) : List String :=
  let ω ps := Hdl.map (Hdl.orBase base) (HwTy.memPathsAux "" t);
  Hdl.dedup ps (Hdl.indexed 0 ps)
/-- `Hdl.upto n k = [k, k + 1, …, k + n - 1]`. -/
def Hdl.upto : Nat → Nat → List Nat
  | .zero, k => .nil
  | .succ n, k => .cons k (Hdl.upto n (Nat.succ k))
/-- A memory's contents as a list: word `a` at index `a`. -/
def Hdl.memWords {ω aw dw : Nat} (m : BitVec aw → BitVec dw) : List Nat :=
  Hdl.map (fun (a : Nat) => (m (BitVec.ofNat aw a)).toNat) (Hdl.upto (Nat.pow 2 aw) 0)
/-- The memories of a value, in order: their contents (word `a` at index `a`). -/
def HwTy.memContents : (ω t : HwTy) → HwTy.El t → List (List Nat)
  | .bits _, v => .nil
  | .prod a b, v => List.append (HwTy.memContents a v.1) (HwTy.memContents b v.2)
  | .named _ t, v => HwTy.memContents t v
  | .mem aw dw, v => .cons (Hdl.memWords v) .nil

------------------------------------------------------------------------------------
-- The combinational operations, tagless final

/-- The combinational operations, tagless final: code written against `[Hw r]` for an
arbitrary representation `r : HwTy → Type` runs at every instance. `Hw HwTy.El` computes
values (simulation, proofs); `Hw Wire` builds a netlist (synthesis).

```
def incr {r : HwTy → Type} [Hw r] (x : r (HwTy.bits 8)) : r (HwTy.bits 8) :=
  Hw.add x (Hw.lit 8 1)
```

The arithmetic wraps around at the width; `eq` and `ult` give one bit; `mux c x y` is
`x` when `c` is 1. `share`, `tag`/`untag` and `label` cost no hardware. -/
class Hw (r : HwTy → Type) where
  /-- `lit n k`: the constant `k` (modulo 2ⁿ) as `n` bits. -/
  lit : (ω n : Nat) → Nat → r (HwTy.bits n)
  /-- Addition, wrapping around at the width. -/
  add : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  /-- Subtraction, wrapping around at the width. -/
  sub : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  /-- Multiplication, wrapping around at the width. -/
  mul : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  /-- Bitwise and. -/
  and : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  /-- Bitwise or. -/
  or : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  /-- Bitwise exclusive or. -/
  xor : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r (HwTy.bits n)
  /-- Bitwise complement. -/
  not : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n)
  /-- Equality, as one bit. -/
  eq : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r HwTy.bit
  /-- Unsigned less-than, as one bit. -/
  ult : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r HwTy.bit
  -- (H14 S4) shifts by an amount that is a signal (barrel shifters): `shlBy a s` is `a`
  -- moved up by `s` places (zeros in), `lshrBy` down (zeros in), `ashrBy` down (copies
  -- of the sign bit in); by `n` places or more, all zeros (or all sign). `slt`: signed
  -- (two's complement) less-than
  /-- `shlBy a s`: `a` shifted up by `s` places (zeros in); by `n` or more, all zeros. -/
  shlBy : {ω n m : Nat} → r (HwTy.bits n) → r (HwTy.bits m) → r (HwTy.bits n)
  /-- `lshrBy a s`: `a` shifted down by `s` places, zeros in at the top. -/
  lshrBy : {ω n m : Nat} → r (HwTy.bits n) → r (HwTy.bits m) → r (HwTy.bits n)
  /-- `ashrBy a s`: `a` shifted down by `s` places, copies of the sign bit in. -/
  ashrBy : {ω n m : Nat} → r (HwTy.bits n) → r (HwTy.bits m) → r (HwTy.bits n)
  /-- Signed (two's complement) less-than, as one bit. -/
  slt : {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits n) → r HwTy.bit
  /-- `mux c x y`: `x` when `c` is 1, else `y` (at any type, leaf by leaf). -/
  mux : {ω t : HwTy} → r HwTy.bit → r t → r t → r t
  /-- Concatenation: the first argument in the high bits. -/
  cat : {ω m n : Nat} → r (HwTy.bits m) → r (HwTy.bits n) → r (HwTy.bits (Nat.add m n))
  /-- `slice lo w x`: the `w` bits of `x` from bit `lo`. -/
  slice : (ω lo w : Nat) → {ω n : Nat} → r (HwTy.bits n) → r (HwTy.bits w)
  /-- A pair of signals (no hardware). -/
  pair : {ω a b : HwTy} → r a → r b → r (HwTy.prod a b)
  /-- The first of a pair (no hardware). -/
  fst : {ω a b : HwTy} → r (HwTy.prod a b) → r a
  /-- The second of a pair (no hardware). -/
  snd : {ω a b : HwTy} → r (HwTy.prod a b) → r b
  /-- `share x f`: `f x` with `x` built once (see `ShareLet`). -/
  share : {ω a b : HwTy} → r a → (r a → r b) → r b
  /-- A constant of any type. -/
  const : (ω t : HwTy) → HwTy.El t → r t
  /-- Into `named s t` (no hardware). -/
  tag : (ω s : String) → {ω t : HwTy} → r t → r (HwTy.named s t)
  /-- Out of `named s t` (no hardware). -/
  untag : {ω s : String} → {ω t : HwTy} → r (HwTy.named s t) → r t
  /-- A name for a wire (`label "sum" x`; it shows in the Verilog). -/
  label : (ω s : String) → {ω t : HwTy} → r t → r t
  /-- `resetTo rst v x` is `mux rst (const v) x`, by construction: when a register's next
  value is built with it (`Circuit.withReset`), the netlist records a synchronous reset
  on the register instead of a multiplexer. -/
  resetTo : {ω t : HwTy} → r HwTy.bit → HwTy.El t → r t → r t
  /-- `hold en x cur` is `mux en x cur`, by construction: when a register's next value is
  built with it (`Circuit.withEnable`), the netlist records a clock enable on the
  register instead of a multiplexer. -/
  hold : {ω t : HwTy} → r HwTy.bit → r t → r t → r t
  -- memories: the word at an address, and the memory with one word written when the
  -- enable is high (reads of the result see the write; a memory that is a circuit's state
  -- takes its writes at the clock edge). A reset leaves a memory's contents alone.
  memRead : {ω aw dw : Nat} → r (HwTy.mem aw dw) → r (HwTy.bits aw) → r (HwTy.bits dw)
  memWrite : {ω aw dw : Nat} → r (HwTy.mem aw dw) → r HwTy.bit → r (HwTy.bits aw) → r (HwTy.bits dw) → r (HwTy.mem aw dw)

/-- Auto-share: the elaborator turns `let x := v; body` into `ShareLet.share v (fun x =>
body)` when an instance `ShareLet A B` exists for the value's type `A` and the body's
type `B` (docs/libraries.md, H14 S0). For hardware this means a `let`-bound wire is
built once, not once per use; write `let ω x := …` to opt out. -/
class ShareLet (A B : Type) where
  share : A → (A → B) → B

/-- Auto-share for hardware code: a `let` of a signal is `Hw.share`. -/
instance {r : HwTy → Type} [Hw r] {ω a b : HwTy} : ShareLet (r a) (r b) where
  share := fun x f => Hw.share x f

/-- A boolean as one bit: `.true` is 1, `.false` is 0. -/
def Bool.toBits (b : Bool) : BitVec 1 := match b with
  | .true => BitVec.ofNat 1 1
  | .false => BitVec.ofNat 1 0
/-- Whether a bit vector is non-zero (how a condition bit is read). -/
def BitVec.isTrue {0 n : Nat} (v : BitVec n) : Bool := Bool.not (Nat.beq v.toNat 0)

-- (H14 S4) The shifts by a signal and the signed comparison on numbers below `2^w`: the
-- value simulation, the netlist simulation and `Hdl.Sim` all compute with these. An
-- amount of `w` or more gives 0 (or all sign bits) without computing `2^s`.
/-- `a` shifted up by `s` places below `2^w` (0 when `s ≥ w`). -/
def Hdl.shlN (w a s : Nat) : Nat := match Nat.lt s w with
  | .true => Nat.mod (Nat.shiftLeft a s) (Nat.pow 2 w)
  | .false => 0
/-- `a` shifted down by `s` places (0 when `s ≥ w`). -/
def Hdl.lshrN (w a s : Nat) : Nat := match Nat.lt s w with
  | .true => Nat.shiftRight a s
  | .false => 0
/-- The sign bit of a `w`-bit number (none at width 0). -/
def Hdl.negN (w a : Nat) : Bool := match w with
  | .zero => .false
  | .succ v => Bool.not (Nat.lt a (Nat.pow 2 v))
/-- Arithmetic shift right: copies of the sign bit come in. -/
def Hdl.ashrN (w a s : Nat) : Nat := match Hdl.negN w a with
  | .false => Hdl.lshrN w a s
  | .true => (match Nat.lt s w with
    | .true => Nat.shiftRight a s + (Nat.pow 2 w - Nat.pow 2 (w - s))
    | .false => Nat.pow 2 w - 1)
/-- Signed (two's complement) `a < b` on numbers below `2^w`. -/
def Hdl.sltN (w a b : Nat) : Bool := match Hdl.negN w a, Hdl.negN w b with
  | .true, .false => .true
  | .false, .true => .false
  | _, _ => Nat.lt a b

-- Simulation: the values themselves. (Named functions where an implicit width is
-- needed: a lambda can't bind one; wishful: implicit-lambda-binders.)
/-- The multiplexer on values: `x` when the condition bit is 1, else `y`. (Named functions
like this one stand in the value instance where an implicit width is needed: a lambda
can't bind one; wishful: implicit-lambda-binders.) -/
def HwTy.El.mux {ω t : HwTy} (c : HwTy.El HwTy.bit) (x y : HwTy.El t) : HwTy.El t :=
  match BitVec.isTrue (c : BitVec 1) with
  | .true => x
  | .false => y
/-- Concatenation on values: `a` in the high bits, `b` in the low ones. -/
def HwTy.El.cat {ω m n : Nat} (a : HwTy.El (HwTy.bits m)) (b : HwTy.El (HwTy.bits n)) :
    HwTy.El (HwTy.bits (Nat.add m n)) := BitVec.concat a b
/-- `HwTy.El.slice lo w a`: the `w` bits of `a` starting at bit `lo`. -/
def HwTy.El.slice (ω lo w : Nat) {ω n : Nat} (a : HwTy.El (HwTy.bits n)) : HwTy.El (HwTy.bits w) :=
  BitVec.ofNat w (Nat.shiftRight (a : BitVec n).toNat lo)
/-- `shlBy` on values: `a` shifted up by the amount `s`. -/
def HwTy.El.shlBy {ω n : Nat} {0 m : Nat} (a : HwTy.El (HwTy.bits n)) (s : HwTy.El (HwTy.bits m)) : HwTy.El (HwTy.bits n) :=
  BitVec.ofNat n (Hdl.shlN n (a : BitVec n).toNat (s : BitVec m).toNat)
/-- `lshrBy` on values: `a` shifted down by the amount `s`. -/
def HwTy.El.lshrBy {ω n : Nat} {0 m : Nat} (a : HwTy.El (HwTy.bits n)) (s : HwTy.El (HwTy.bits m)) : HwTy.El (HwTy.bits n) :=
  BitVec.ofNat n (Hdl.lshrN n (a : BitVec n).toNat (s : BitVec m).toNat)
/-- `ashrBy` on values: `a` shifted down by `s`, copies of the sign bit in. -/
def HwTy.El.ashrBy {ω n : Nat} {0 m : Nat} (a : HwTy.El (HwTy.bits n)) (s : HwTy.El (HwTy.bits m)) : HwTy.El (HwTy.bits n) :=
  BitVec.ofNat n (Hdl.ashrN n (a : BitVec n).toNat (s : BitVec m).toNat)
/-- `slt` on values: signed less-than, as one bit. -/
def HwTy.El.slt {ω n : Nat} (a b : HwTy.El (HwTy.bits n)) : HwTy.El HwTy.bit :=
  Bool.toBits (Hdl.sltN n (a : BitVec n).toNat (b : BitVec n).toNat)
/-- Into a named type, on values: the identity. -/
def HwTy.El.tag (ω s : String) {ω t : HwTy} (x : HwTy.El t) : HwTy.El (HwTy.named s t) := x
/-- Out of a named type, on values: the identity. -/
def HwTy.El.untag {ω s : String} {ω t : HwTy} (x : HwTy.El (HwTy.named s t)) : HwTy.El t := x
/-- A wire name, on values: the identity. -/
def HwTy.El.label (ω s : String) {ω t : HwTy} (x : HwTy.El t) : HwTy.El t := x
-- a reset: `v` where `c` is high, leaf by leaf; memories keep their contents (as block
-- RAM does: its contents are set only when the device is configured)
/-- A reset on values: `v` where `c` is 1, else `x` (leaf by leaf; a memory keeps its
contents). -/
def HwTy.El.resetToAt : (ω t : HwTy) → HwTy.El HwTy.bit → HwTy.El t → HwTy.El t → HwTy.El t
  | .bits n, c, v, x => @HwTy.El.mux (HwTy.bits n) c v x
  | .prod a b, c, v, x => (HwTy.El.resetToAt a c v.1 x.1, HwTy.El.resetToAt b c v.2 x.2)
  | .named _ t, c, v, x => HwTy.El.resetToAt t c v x
  | .mem _ _, c, v, x => x
/-- `resetTo c v x` on values: `v` when `c` is 1, else `x`. -/
def HwTy.El.resetTo {ω t : HwTy} (c : HwTy.El HwTy.bit) (v : HwTy.El t) (x : HwTy.El t) : HwTy.El t :=
  HwTy.El.resetToAt t c v x
/-- `d` at a hit, else `old` -/
def Hdl.memPick {A : Type} : Bool → A → A → A
  | .true, d, old => d
  | .false, d, old => old
/-- A write: a disabled one is the memory itself, so that a simulation does not wrap the
memory in one more function per cycle (a read would cost the number of cycles so far,
not the number of writes). -/
def Hdl.memWr {aw dw : Nat} : Bool → (BitVec aw → BitVec dw) → BitVec aw → BitVec dw → (BitVec aw → BitVec dw)
  | .false, m, a, d => m
  | .true, m, a, d => fun (b : BitVec aw) => Hdl.memPick (BitVec.beq a b) d (m b)
/-- Read a memory at an address (combinational). -/
def HwTy.El.memRead {0 aw : Nat} {ω dw : Nat} (m : HwTy.El (HwTy.mem aw dw)) (a : HwTy.El (HwTy.bits aw)) : HwTy.El (HwTy.bits dw) :=
  (m : BitVec aw → BitVec dw) a
/-- Write a memory (at the clock edge, when it is the state's next value); a disabled write
is the memory itself. -/
def HwTy.El.memWrite {0 aw : Nat} {ω dw : Nat} (m : HwTy.El (HwTy.mem aw dw)) (we : HwTy.El HwTy.bit) (a : HwTy.El (HwTy.bits aw))
    (d : HwTy.El (HwTy.bits dw)) : HwTy.El (HwTy.mem aw dw) :=
  Hdl.memWr (BitVec.isTrue (we : BitVec 1)) (m : BitVec aw → BitVec dw) (a : BitVec aw) (d : BitVec dw)

/-- Simulation: the value instance (`HwTy.El`), where hardware code computes bit vectors. -/
instance : Hw HwTy.El where
  lit := fun n k => BitVec.ofNat n k
  add := fun a b => BitVec.add a b
  sub := fun a b => BitVec.sub a b
  mul := fun a b => BitVec.mul a b
  and := fun a b => BitVec.and a b
  or := fun a b => BitVec.or a b
  xor := fun a b => BitVec.xor a b
  not := fun a => BitVec.not a
  eq := fun a b => Bool.toBits (BitVec.beq a b)
  ult := fun a b => Bool.toBits (BitVec.ult a b)
  shlBy := HwTy.El.shlBy
  lshrBy := HwTy.El.lshrBy
  ashrBy := HwTy.El.ashrBy
  slt := HwTy.El.slt
  mux := HwTy.El.mux
  cat := HwTy.El.cat
  slice := HwTy.El.slice
  pair := fun a b => (a, b)
  fst := fun p => p.1
  snd := fun p => p.2
  share := fun a f => f a
  const := fun t v => v
  tag := HwTy.El.tag
  untag := HwTy.El.untag
  label := HwTy.El.label
  resetTo := HwTy.El.resetTo
  hold := HwTy.El.mux
  memRead := HwTy.El.memRead
  memWrite := HwTy.El.memWrite

------------------------------------------------------------------------------------
-- The netlist IR: flat, widths concrete, one node per bit-vector operation

/-- The operation of a netlist node. `input p` is input port `p`, `reg r` the current value of
register `r`, `const v` a constant; the others are the bit-vector operations of `Hw`
(`slice lo` cuts from bit `lo`, `resetTo v` is `mux rst v x` and `hold` is `mux en x
cur`, which become a register's reset and enable). -/
inductive NetOp where
  | input (port : Nat)
  | const (v : Nat)
  | reg (r : Nat)
  | add
  | sub
  | mul
  | and
  | or
  | xor
  | not
  | eq
  | ult
  | mux
  | concat
  | slice (lo : Nat)
  | resetTo (v : Nat)
  | hold
  | memRead (m : Nat)
  | shl     -- (H14 S4) by a signal: `a << s`, `a >> s`, `$signed(a) >>> s`, `$signed(a) < $signed(b)`
  | lshr
  | ashr
  | slt

/-- A netlist node: its operation, its width and its arguments (ids of earlier nodes). -/
structure NetNode where
  op : NetOp
  width : Nat
  args : List Nat

/-- A register: its name, width and initial value; `next` is the node it loads; with `rst`,
a one-bit node that makes it load `init` instead (synchronous reset, before the
enable); with `en`, a one-bit node without which it keeps its value. -/
structure NetReg where
  name : String
  width : Nat
  init : Nat
  next : Nat
  rst : Option Nat
  en : Option Nat

/-- A memory: its name, address and data widths, initial contents (word `a` at index `a`)
and its writes, in order (a later one wins): (enable, address, data) nodes. -/
structure NetMem where
  name : String
  aw : Nat
  dw : Nat
  init : List Nat
  writes : List (Nat × (Nat × Nat))

/-- A port: its name, width and the node it is (an input) or shows (an output). -/
structure NetPort where
  name : String
  width : Nat
  node : Nat

/-- A netlist: flat, widths concrete, one node per bit-vector operation. Node `k` is the
`k`-th of `nodes` and its arguments refer to earlier nodes; `hints` are wire names
(from `Hw.label`). `Circuit.netlist` makes one, `Netlist.simulate` runs it and
`Verilog.emit` prints it. -/
structure Netlist where
  name : String
  nodes : List NetNode       -- node k is the k-th; arguments refer to earlier nodes
  regs : List NetReg
  inputs : List NetPort
  outputs : List NetPort
  hints : List (Nat × String) -- wire names (`Hw.label`)
  mems : List NetMem         -- memory k is the k-th; read by `memRead k` nodes
  errors : List String       -- what the netlist cannot express (a memory used wrongly)

/-- Hash-consing keys: an operation as a code and its payload. With the width and the
arguments (`NetNode.key`) it identifies a node. -/
def NetOp.code : NetOp → List Nat
  | .input p => List.cons 0 (List.cons p List.nil)
  | .const v => List.cons 1 (List.cons v List.nil)
  | .reg r => List.cons 2 (List.cons r List.nil)
  | .add => List.cons 3 List.nil
  | .sub => List.cons 4 List.nil
  | .mul => List.cons 5 List.nil
  | .and => List.cons 6 List.nil
  | .or => List.cons 7 List.nil
  | .xor => List.cons 8 List.nil
  | .not => List.cons 9 List.nil
  | .eq => List.cons 10 List.nil
  | .ult => List.cons 11 List.nil
  | .mux => List.cons 12 List.nil
  | .concat => List.cons 13 List.nil
  | .slice lo => List.cons 14 (List.cons lo List.nil)
  | .resetTo v => List.cons 15 (List.cons v List.nil)
  | .hold => List.cons 16 List.nil
  | .memRead m => List.cons 17 (List.cons m List.nil)
  | .shl => List.cons 20 List.nil
  | .lshr => List.cons 21 List.nil
  | .ashr => List.cons 22 List.nil
  | .slt => List.cons 23 List.nil

/-- Whether the operation is commutative (its two arguments are sorted for hash-consing,
so `a + b` and `b + a` are one node). -/
def NetOp.commutative : NetOp → Bool
  | .add => .true
  | .mul => .true
  | .and => .true
  | .or => .true
  | .xor => .true
  | .eq => .true
  | _ => .false

/-- The arguments in canonical order: a commutative operation's two arguments sorted. -/
def NetNode.canonArgs (op : NetOp) (args : List Nat) : List Nat := match NetOp.commutative op, args with
  | .true, .cons a (.cons b .nil) => match Nat.lt b a with
    | .true => List.cons b (List.cons a List.nil)
    | .false => args
  | _, _ => args

/-- The hash-consing key of a node: operation code, width, arguments. -/
def NetNode.key (op : NetOp) (w : Nat) (args : List Nat) : List Nat :=
  NetOp.code op ++ List.cons w args

/-- A hash of a list of numbers, from the seed `h` (polynomial, modulo a prime below 2³²). -/
def NatList.hash : List Nat → Nat → Nat
  | .nil, h => h
  | .cons k ks, h => NatList.hash ks (Nat.mod (h * 1000003 + k + 1) 4294967291)

/-- A hash trie: `depth` levels of binary branching on the hash's bits, exact buckets at the
leaves (a lookup compares whole keys, so a hash collision costs time, never
correctness). The netlist builder's hash-consing table, and the maps and sets of this
module. -/
inductive HTrie (V : Type) where
  | tip
  | bucket (kvs : List (List Nat × V))
  | node (l r : HTrie V)

/-- The depth of every `HTrie` (levels of branching). -/
def HTrie.depth : Nat := 20

/-- Look a key up in a bucket. -/
def HTrie.assoc {V : Type} (key : List Nat) : List (List Nat × V) → Option V
  | .nil => .none
  | .cons kv kvs => match Hdl.natsEq key kv.1 with
    | .true => .some kv.2
    | .false => HTrie.assoc key kvs

/-- `HTrie.find key h d t`: the value of `key` (hash `h`) in a trie of depth `d`. -/
def HTrie.find {V : Type} (key : List Nat) (h : Nat) : Nat → HTrie V → Option V
  | _, .tip => .none
  | _, .bucket kvs => HTrie.assoc key kvs
  | .zero, .node _ _ => .none
  | .succ d, .node l r => match Nat.testBit h d with
    | .true => HTrie.find key h d r
    | .false => HTrie.find key h d l

/-- `HTrie.insert key v h d t`: `t` with `key` (hash `h`) bound to `v` (in front of any
older binding). -/
def HTrie.insert {V : Type} (key : List Nat) (v : V) (h : Nat) : Nat → HTrie V → HTrie V
  | .zero, .tip => .bucket (List.cons (key, v) List.nil)
  | .zero, .bucket kvs => .bucket (List.cons (key, v) kvs)
  | .zero, .node _ _ => .bucket (List.cons (key, v) List.nil)
  | .succ d, .tip => match Nat.testBit h d with
    | .true => .node .tip (HTrie.insert key v h d .tip)
    | .false => .node (HTrie.insert key v h d .tip) .tip
  | .succ d, .bucket kvs => .bucket (List.cons (key, v) kvs)
  | .succ d, .node l r => match Nat.testBit h d with
    | .true => .node l (HTrie.insert key v h d r)
    | .false => .node (HTrie.insert key v h d l) r

/-- The value of a key, if any (hashing it). -/
def HTrie.get {V : Type} (key : List Nat) (t : HTrie V) : Option V :=
  HTrie.find key (NatList.hash key 7) HTrie.depth t
/-- Bind a key to a value (hashing it). -/
def HTrie.put {V : Type} (key : List Nat) (v : V) (t : HTrie V) : HTrie V :=
  HTrie.insert key v (NatList.hash key 7) HTrie.depth t
/-- `HTrie.get` for a key that is a single number. -/
def HTrie.getN {V : Type} (k : Nat) (t : HTrie V) : Option V := HTrie.get (List.cons k List.nil) t
/-- `HTrie.put` for a key that is a single number. -/
def HTrie.putN {V : Type} (k : Nat) (v : V) (t : HTrie V) : HTrie V := HTrie.put (List.cons k List.nil) v t

/-- The state of the netlist builder: the next node id, the nodes in reverse, the
hash-consing table, whether to hash-cons at all (off only to measure what it saves),
a work counter (every emit, hit or miss: generation time, measured deterministically),
and the wire names. -/
structure NetS where
  next : Nat
  nodes : List NetNode
  table : HTrie Nat
  cse : Bool
  work : Nat
  hints : List (Nat × String)
  mems : List NetMem         -- newest first
  errs : List String

/-- The empty builder state, hash-consing if `cse`. -/
def NetS.init (cse : Bool) : NetS := NetS.mk 0 List.nil HTrie.tip cse 0 List.nil List.nil List.nil

/-- Building netlists: a state monad over `NetS`. -/
def NetM (A : Type) : Type := NetS → A × NetS
/-- `pure` of `NetM`. -/
def NetM.pure {A : Type} (a : A) : NetM A := fun s => (a, s)
/-- `bind` of `NetM`. -/
def NetM.bind {A B : Type} (x : NetM A) (f : A → NetM B) : NetM B := fun s =>
  let r := x s
  f r.1 r.2
/-- `NetM` is a monad, so builders are written with `do`. -/
instance : Monad NetM where
  pure := NetM.pure
  bind := NetM.bind

/-- Append a new node (always a new id), with the table to keep. -/
def NetS.push (s : NetS) (op : NetOp) (w : Nat) (args : List Nat) (table : HTrie Nat) : Nat × NetS :=
  (s.next, NetS.mk (Nat.succ s.next) (List.cons (NetNode.mk op w args) s.nodes) table s.cse (Nat.succ s.work) s.hints s.mems s.errs)

/-- Emit a node through the hash-consing table: an identical node already built is reused. -/
def NetM.emitKeyed (op : NetOp) (w : Nat) (args : List Nat) (s : NetS) : Nat × NetS :=
  let key := NetNode.key op w args
  let h := NatList.hash key 7
  match HTrie.find key h HTrie.depth s.table with
  | .some k => (k, NetS.mk s.next s.nodes s.table s.cse (Nat.succ s.work) s.hints s.mems s.errs)
  | .none => NetS.push s op w args (HTrie.insert key s.next h HTrie.depth s.table)

/-- Emit a node `op` of width `w` with arguments `args` and return its id (hash-consed
unless the builder's `cse` is off). -/
def NetM.emit (op : NetOp) (w : Nat) (args : List Nat) : NetM Nat := fun s => match s.cse with
  | .true => NetM.emitKeyed op w (NetNode.canonArgs op args) s
  | .false => NetS.push s op w args s.table

/-- Record a wire name for node `k`. -/
def NetM.hint (k : Nat) (name : String) : NetM Unit := fun s =>
  ((), NetS.mk s.next s.nodes s.table s.cse s.work (List.cons (k, name) s.hints) s.mems s.errs)

/-- a new memory (its index), a problem, and a memory's writes -/
def NetM.newMem (m : NetMem) : NetM Nat := fun s =>
  (List.length s.mems, NetS.mk s.next s.nodes s.table s.cse s.work s.hints (List.cons m s.mems) s.errs)
/-- Record a problem the netlist cannot express. -/
def NetM.error (e : String) : NetM Unit := fun s =>
  ((), NetS.mk s.next s.nodes s.table s.cse s.work s.hints s.mems (List.cons e s.errs))
/-- (memories are kept newest first: memory k is at position `count - 1 - k`) -/
def Hdl.setWritesAux (ws : List (Nat × (Nat × Nat))) : Nat → List NetMem → List NetMem
  | _, .nil => .nil
  | .zero, .cons m ms => .cons (NetMem.mk m.name m.aw m.dw m.init ws) ms
  | .succ j, .cons m ms => .cons m (Hdl.setWritesAux ws j ms)
/-- Set the writes of memory `k`. -/
def NetM.setWrites (k : Nat) (ws : List (Nat × (Nat × Nat))) : NetM Unit := fun s =>
  ((), NetS.mk s.next s.nodes s.table s.cse s.work s.hints (Hdl.setWritesAux ws (List.length s.mems - 1 - k) s.mems) s.errs)

/-- Synthesis: the node ids of a signal of type `t`, one per leaf. A wire is a computation
that emits nodes and returns these (`Wire`). -/
def HwTy.Ids : HwTy → Type
  | .bits _ => Nat
  | .prod a b => HwTy.Ids a × HwTy.Ids b
  | .named _ t => HwTy.Ids t
  -- a memory, and the writes made to it so far (enable, address, data)
  | .mem _ _ => Nat × List (Nat × (Nat × Nat))

/-- The ids of a signal as a list, in leaf order. -/
def HwTy.idsLeaves : (ω t : HwTy) → HwTy.Ids t → List Nat
  | .bits _, k => .cons k .nil
  | .prod a b, p => List.append (HwTy.idsLeaves a p.1) (HwTy.idsLeaves b p.2)
  | .named _ t, p => HwTy.idsLeaves t p
  | .mem _ _, p => .nil
/-- Read the ids of a signal of type `t` from the front of a list; also returns the rest. -/
def HwTy.idsTake : (ω t : HwTy) → List Nat → HwTy.Ids t × List Nat
  | .bits _, .nil => (0, .nil)
  | .bits _, .cons k ks => (k, ks)
  | .prod a b, ks =>
    let ω p := HwTy.idsTake a ks;
    let ω q := HwTy.idsTake b p.2;
    ((p.1, q.1), q.2)
  | .named _ t, ks => HwTy.idsTake t ks
  | .mem _ _, ks => ((0, .nil), ks)
/-- the ids of a state: leaves from the list, memories numbered from `k` -/
def HwTy.idsState : (ω t : HwTy) → List Nat → Nat → HwTy.Ids t × (List Nat × Nat)
  | .bits _, .nil, k => (0, (.nil, k))
  | .bits _, .cons x xs, k => (x, (xs, k))
  | .prod a b, ks, k =>
    let ω p := HwTy.idsState a ks k;
    let ω q := HwTy.idsState b p.2.1 p.2.2;
    ((p.1, q.1), q.2)
  | .named _ t, ks, k => HwTy.idsState t ks k
  | .mem _ _, ks, k => ((k, .nil), (ks, Nat.succ k))
/-- the memories of a value's ids -/
def HwTy.idsMems : (ω t : HwTy) → HwTy.Ids t → List (Nat × List (Nat × (Nat × Nat)))
  | .bits _, p => .nil
  | .prod a b, p => List.append (HwTy.idsMems a p.1) (HwTy.idsMems b p.2)
  | .named _ t, p => HwTy.idsMems t p
  | .mem _ _, p => .cons p .nil

/-- The netlist representation: a wire of type `t` is a builder computation that emits the
nodes computing it and returns their ids. `instance : Hw Wire` makes hardware code build
a netlist. A wire used twice would be built twice; hash-consing and `Hw.share` (which a
`let` turns into, see `ShareLet`) keep that from costing hardware. -/
def Wire (t : HwTy) : Type := NetM (HwTy.Ids t)

/-- A node with two arguments, after building both. -/
def Wire.op2 (op : NetOp) (w : Nat) (a b : NetM Nat) : NetM Nat := do
  x ← a;
  y ← b;
  NetM.emit op w (List.cons x (List.cons y List.nil))
/-- A node with one argument, after building it. -/
def Wire.op1 (op : NetOp) (w : Nat) (a : NetM Nat) : NetM Nat := do
  x ← a;
  NetM.emit op w (List.cons x List.nil)

-- A choice between two memories: the writes both have made, then the other writes of
-- each, enabled only on its side (the sides exclude each other, so their order does not
-- matter). Two different memories cannot be chosen between. A memory can only be
-- written, not chosen, so choosing between two different ones is an error.
/-- Whether two writes are the same (enable, address and data nodes). -/
def Hdl.wEq (a b : Nat × (Nat × Nat)) : Bool := Bool.and (Nat.beq a.1 b.1) (Bool.and (Nat.beq a.2.1 b.2.1) (Nat.beq a.2.2 b.2.2))
/-- The writes both lists start with, then the rest of each. -/
def Hdl.commonW : List (Nat × (Nat × Nat)) → List (Nat × (Nat × Nat)) → List (Nat × (Nat × Nat)) × (List (Nat × (Nat × Nat)) × List (Nat × (Nat × Nat)))
  | .cons x xs, .cons y ys => (match Hdl.wEq x y with
    | .true => let ω r := Hdl.commonW xs ys; (.cons x r.1, r.2)
    | .false => (.nil, (.cons x xs, .cons y ys)))
  | xs, ys => (.nil, (xs, ys))
/-- Writes enabled only when `g` is high. -/
def Wire.guardW (g : Nat) : List (Nat × (Nat × Nat)) → NetM (List (Nat × (Nat × Nat)))
  | .nil => NetM.pure .nil
  | .cons w ws => do
    e ← NetM.emit NetOp.and 1 (.cons g (.cons w.1 .nil));
    rest ← Wire.guardW g ws;
    NetM.pure (.cons (e, w.2) rest)
/-- A choice between two memories: the writes both have made, then the other writes of
each, enabled on its side. -/
def Wire.memChoice (c : Nat) (a b : Nat × List (Nat × (Nat × Nat))) : NetM (Nat × List (Nat × (Nat × Nat))) :=
  match Nat.beq a.1 b.1 with
  | .false => do
    NetM.error "a choice between two different memories (a memory can only be written, not chosen)";
    NetM.pure a
  | .true => do
    let ω r := Hdl.commonW a.2 b.2;
    nc ← NetM.emit NetOp.not 1 (.cons c .nil);
    xs ← Wire.guardW c r.2.1;
    ys ← Wire.guardW nc r.2.2;
    NetM.pure (a.1, List.append r.1 (List.append xs ys))

-- per-leaf multiplexers, constants, resets, holds, names
/-- Per-leaf multiplexers: one `mux` node for each leaf of `t`. -/
def Wire.muxIds : (ω t : HwTy) → Nat → HwTy.Ids t → HwTy.Ids t → NetM (HwTy.Ids t)
  | .bits n, c, a, b => NetM.emit NetOp.mux n (List.cons c (List.cons a (List.cons b List.nil)))
  | .prod x y, c, a, b => do
    p ← Wire.muxIds x c a.1 b.1;
    q ← Wire.muxIds y c a.2 b.2;
    NetM.pure (p, q)
  | .named _ x, c, a, b => Wire.muxIds x c a b
  | .mem _ _, c, a, b => Wire.memChoice c a b
/-- Per-leaf `hold` nodes (clock-enable candidates). -/
def Wire.holdIds : (ω t : HwTy) → Nat → HwTy.Ids t → HwTy.Ids t → NetM (HwTy.Ids t)
  | .bits n, c, a, b => NetM.emit NetOp.hold n (List.cons c (List.cons a (List.cons b List.nil)))
  | .prod x y, c, a, b => do
    p ← Wire.holdIds x c a.1 b.1;
    q ← Wire.holdIds y c a.2 b.2;
    NetM.pure (p, q)
  | .named _ x, c, a, b => Wire.holdIds x c a b
  | .mem _ _, c, a, b => Wire.memChoice c a b
/-- A constant of any type: one `const` node per leaf. -/
def Wire.constIds : (ω t : HwTy) → HwTy.El t → NetM (HwTy.Ids t)
  | .bits n, v => NetM.emit (NetOp.const (v : BitVec n).toNat) n List.nil
  | .prod x y, v => do
    p ← Wire.constIds x v.1;
    q ← Wire.constIds y v.2;
    NetM.pure (p, q)
  | .named _ x, v => Wire.constIds x v
  -- a constant memory: a ROM
  | .mem aw dw, v => do
    k ← NetM.newMem (NetMem.mk "rom" aw dw (Hdl.memWords v) .nil);
    NetM.pure (k, .nil)
/-- Per-leaf `resetTo` nodes (synchronous-reset candidates). -/
def Wire.resetIds : (ω t : HwTy) → Nat → HwTy.El t → HwTy.Ids t → NetM (HwTy.Ids t)
  | .bits n, c, v, a => NetM.emit (NetOp.resetTo (v : BitVec n).toNat) n (List.cons c (List.cons a List.nil))
  | .prod x y, c, v, a => do
    p ← Wire.resetIds x c v.1 a.1;
    q ← Wire.resetIds y c v.2 a.2;
    NetM.pure (p, q)
  | .named _ x, c, v, a => Wire.resetIds x c v a
  | .mem _ _, c, v, a => NetM.pure a
/-- Record names for several nodes (pairwise). -/
def NetM.hints : List Nat → List String → NetM Unit
  | .cons k ks, .cons n ns => do
    NetM.hint k n;
    NetM.hints ks ns
  | _, _ => NetM.pure ()

/-- `Hw.lit` on wires: a constant node (the value taken modulo 2ⁿ). -/
def Wire.lit (ω n : Nat) (k : Nat) : Wire (HwTy.bits n) := NetM.emit (NetOp.const (Nat.mod k (Nat.pow 2 n))) n List.nil
/-- `Hw.add` on wires. -/
def Wire.add {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 NetOp.add n a b
/-- `Hw.sub` on wires. -/
def Wire.sub {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 NetOp.sub n a b
/-- `Hw.mul` on wires. -/
def Wire.mul {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 NetOp.mul n a b
/-- `Hw.and` on wires. -/
def Wire.and {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 NetOp.and n a b
/-- `Hw.or` on wires. -/
def Wire.or {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 NetOp.or n a b
/-- `Hw.xor` on wires. -/
def Wire.xor {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op2 NetOp.xor n a b
/-- `Hw.not` on wires. -/
def Wire.not {ω n : Nat} (a : Wire (HwTy.bits n)) : Wire (HwTy.bits n) := Wire.op1 NetOp.not n a
/-- `Hw.eq` on wires: a one-bit node. -/
def Wire.eq {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire HwTy.bit := Wire.op2 NetOp.eq 1 a b
/-- `Hw.ult` on wires: a one-bit node. -/
def Wire.ult {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire HwTy.bit := Wire.op2 NetOp.ult 1 a b
-- (an amount of width 0 is no shift; at width 0 there is nothing to shift or compare)
/-- A shift by a signal: one `op` node (the shifts' amount is an operand). -/
def Wire.shiftBy (op : NetOp) {ω n m : Nat} (a : Wire (HwTy.bits n)) (s : Wire (HwTy.bits m)) : Wire (HwTy.bits n) :=
  match Nat.beq n 0, Nat.beq m 0 with
  | .true, _ => a
  | _, .true => a
  | _, _ => Wire.op2 op n a s
/-- `shlBy` on wires. -/
def Wire.shlBy {ω n m : Nat} (a : Wire (HwTy.bits n)) (s : Wire (HwTy.bits m)) : Wire (HwTy.bits n) := Wire.shiftBy NetOp.shl a s
/-- `lshrBy` on wires. -/
def Wire.lshrBy {ω n m : Nat} (a : Wire (HwTy.bits n)) (s : Wire (HwTy.bits m)) : Wire (HwTy.bits n) := Wire.shiftBy NetOp.lshr a s
/-- `ashrBy` on wires. -/
def Wire.ashrBy {ω n m : Nat} (a : Wire (HwTy.bits n)) (s : Wire (HwTy.bits m)) : Wire (HwTy.bits n) := Wire.shiftBy NetOp.ashr a s
/-- Signed less-than on wires (0 at width 0). -/
def Wire.slt {ω n : Nat} (a b : Wire (HwTy.bits n)) : Wire HwTy.bit := match Nat.beq n 0 with
  | .true => Wire.lit 1 0
  | .false => Wire.op2 NetOp.slt 1 a b
/-- `Hw.mux` on wires: per-leaf multiplexers. -/
def Wire.mux {ω t : HwTy} (c : Wire HwTy.bit) (x y : Wire t) : NetM (HwTy.Ids t) := do
  k ← c;
  a ← x;
  b ← y;
  Wire.muxIds t k a b
/-- `Hw.cat` on wires: a `concat` node. -/
def Wire.cat {ω m n : Nat} (a : Wire (HwTy.bits m)) (b : Wire (HwTy.bits n)) : Wire (HwTy.bits (Nat.add m n)) :=
  Wire.op2 NetOp.concat (m + n) a b
/-- `Hw.slice` on wires: a `slice` node. -/
def Wire.slice (ω lo w : Nat) {ω n : Nat} (a : Wire (HwTy.bits n)) : Wire (HwTy.bits w) := Wire.op1 (NetOp.slice lo) w a
/-- `Hw.pair` on wires: the ids of both, no hardware. -/
def Wire.pair {ω a b : HwTy} (x : Wire a) (y : Wire b) : NetM (HwTy.Ids a × HwTy.Ids b) := do
  p ← x;
  q ← y;
  NetM.pure (p, q)
/-- `Hw.fst` on wires: the first component's ids, no hardware. -/
def Wire.fst {ω a b : HwTy} (p : Wire (HwTy.prod a b)) : NetM (HwTy.Ids a) := do
  q ← p;
  NetM.pure q.1
/-- `Hw.snd` on wires: the second component's ids, no hardware. -/
def Wire.snd {ω a b : HwTy} (p : Wire (HwTy.prod a b)) : NetM (HwTy.Ids b) := do
  q ← p;
  NetM.pure q.2
/-- `Hw.share` on wires: runs the wire's computation once and hands on its ids. -/
def Wire.share {ω a b : HwTy} (x : Wire a) (f : Wire a → Wire b) : NetM (HwTy.Ids b) := do
  ids ← x;
  f (NetM.pure ids)
/-- `Hw.const` on wires. -/
def Wire.const (ω t : HwTy) (v : HwTy.El t) : Wire t := Wire.constIds t v
/-- `Hw.tag` on wires: the identity. -/
def Wire.tag (ω s : String) {ω t : HwTy} (x : Wire t) : Wire (HwTy.named s t) := x
/-- `Hw.untag` on wires: the identity. -/
def Wire.untag {ω s : String} {ω t : HwTy} (x : Wire (HwTy.named s t)) : Wire t := x
/-- `Hw.label` on wires: records the name of every leaf (`HwTy.leafNames`) as a wire name. -/
def Wire.label (ω s : String) {ω t : HwTy} (x : Wire t) : NetM (HwTy.Ids t) := do
  ids ← x;
  NetM.hints (HwTy.idsLeaves t ids) (HwTy.leafNames s t);
  NetM.pure ids
/-- `Hw.resetTo` on wires: per-leaf `resetTo` nodes. -/
def Wire.resetTo {ω t : HwTy} (c : Wire HwTy.bit) (v : HwTy.El t) (x : Wire t) : NetM (HwTy.Ids t) := do
  k ← c;
  a ← x;
  Wire.resetIds t k v a
/-- `Hw.hold` on wires: per-leaf `hold` nodes. -/
def Wire.hold {ω t : HwTy} (c : Wire HwTy.bit) (x y : Wire t) : NetM (HwTy.Ids t) := do
  k ← c;
  a ← x;
  b ← y;
  Wire.holdIds t k a b

-- A read: the word in the memory, then each write made to it in this cycle, in order,
-- where it is enabled and hits the address.
/-- The read's value, with the writes made to the memory in this cycle applied in order
(so that a later write wins). -/
def Wire.bypass (dw x : Nat) : Nat → List (Nat × (Nat × Nat)) → NetM Nat
  | acc, .nil => NetM.pure acc
  | acc, .cons w ws => do
    hit ← NetM.emit NetOp.eq 1 (.cons w.2.1 (.cons x .nil));
    g ← NetM.emit NetOp.and 1 (.cons w.1 (.cons hit .nil));
    v ← NetM.emit NetOp.mux dw (.cons g (.cons w.2.2 (.cons acc .nil)));
    Wire.bypass dw x v ws
/-- A combinational read of a memory: the stored word, then this cycle's writes (bypass). -/
def Wire.memRead {ω aw dw : Nat} (m : Wire (HwTy.mem aw dw)) (a : Wire (HwTy.bits aw)) : NetM Nat := do
  mm ← m;
  x ← a;
  base ← NetM.emit (NetOp.memRead mm.1) dw (.cons x .nil);
  Wire.bypass dw x base mm.2
/-- A write at the clock edge: a disabled write is the memory unchanged. -/
def Wire.memWrite {ω aw dw : Nat} (m : Wire (HwTy.mem aw dw)) (we : Wire HwTy.bit) (a : Wire (HwTy.bits aw)) (d : Wire (HwTy.bits dw)) :
    NetM (Nat × List (Nat × (Nat × Nat))) := do
  mm ← m;
  e ← we;
  x ← a;
  y ← d;
  NetM.pure (mm.1, List.append mm.2 (.cons (e, (x, y)) .nil))

/-- Synthesis: the wire instance, where hardware code builds a netlist. -/
instance : Hw Wire where
  lit := Wire.lit
  add := Wire.add
  sub := Wire.sub
  mul := Wire.mul
  and := Wire.and
  or := Wire.or
  xor := Wire.xor
  not := Wire.not
  eq := Wire.eq
  ult := Wire.ult
  shlBy := Wire.shlBy
  lshrBy := Wire.lshrBy
  ashrBy := Wire.ashrBy
  slt := Wire.slt
  mux := Wire.mux
  cat := Wire.cat
  slice := Wire.slice
  pair := Wire.pair
  fst := Wire.fst
  snd := Wire.snd
  share := Wire.share
  const := Wire.const
  tag := Wire.tag
  untag := Wire.untag
  label := Wire.label
  resetTo := Wire.resetTo
  hold := Wire.hold
  memRead := Wire.memRead
  memWrite := Wire.memWrite

/-- Run a wire computation from scratch (for combinational tests): its ids and the
builder's state. -/
def Wire.build {ω t : HwTy} (cse : Bool) (x : Wire t) : HwTy.Ids t × NetS := (x : NetM (HwTy.Ids t)) (NetS.init cse)
/-- The number of nodes built so far. -/
def NetS.nodeCount (s : NetS) : Nat := s.next

------------------------------------------------------------------------------------
-- A random-access list (Okasaki's skew binary lists): `cons` in O(1), `get` in O(log n).
-- Index 0 is the most recent element. The netlist simulator keeps node values in one.

/-- A complete binary tree, an element at every node: the trees of `Hdl.RList`. -/
inductive Hdl.RTree (A : Type) where
  | leaf (x : A)
  | node (x : A) (l r : Hdl.RTree A)

/-- A random-access list (Okasaki's skew binary lists): `cons` in O(1), `get` in O(log n).
Index 0 is the most recent element. A list of complete trees with their sizes. -/
def Hdl.RList (A : Type) : Type := List (Nat × Hdl.RTree A)

/-- The empty random-access list. -/
def Hdl.RList.nil {A : Type} : Hdl.RList A := List.nil
/-- An element in front (index 0), in O(1): two trees of equal size merge under it. -/
def Hdl.RList.cons {A : Type} (x : A) (ts : Hdl.RList A) : Hdl.RList A := match (ts : List (Nat × Hdl.RTree A)) with
  | .cons p (.cons q rest) => (match Nat.beq p.1 q.1 with
    | .true => List.cons (Nat.succ (p.1 + q.1), Hdl.RTree.node x p.2 q.2) rest
    | .false => List.cons (1, Hdl.RTree.leaf x) (List.cons p (List.cons q rest)))
  | other => List.cons (1, Hdl.RTree.leaf x) other

/-- `Hdl.RTree.get d w i t`: element `i` of a tree of size `w` (pre-order), or `d`. -/
def Hdl.RTree.get {A : Type} (d : A) : Nat → Nat → Hdl.RTree A → A
  | _, _, .leaf x => x
  | w, i, .node x l r => match i with
    | .zero => x
    | .succ j => (match Nat.lt j (Nat.div w 2) with
      | .true => Hdl.RTree.get d (Nat.div w 2) j l
      | .false => Hdl.RTree.get d (Nat.div w 2) (j - Nat.div w 2) r)

/-- Element `i` of a list of trees, or `d`. -/
def Hdl.RList.getAux {A : Type} (d : A) : Nat → List (Nat × Hdl.RTree A) → A
  | _, .nil => d
  | i, .cons p ps => match Nat.lt i p.1 with
    | .true => Hdl.RTree.get d p.1 i p.2
    | .false => Hdl.RList.getAux d (i - p.1) ps
/-- `Hdl.RList.get d i ts`: element `i` (0 the most recent), or `d` if there is none. -/
def Hdl.RList.get {A : Type} (d : A) (i : Nat) (ts : Hdl.RList A) : A := Hdl.RList.getAux d i ts

/-- Push the elements of a list, in order (a list as a random-access list, reversed: see
`Hdl.RList.ofList`). -/
def Hdl.RList.ofListAux {A : Type} : List A → Hdl.RList A → Hdl.RList A
  | .nil, acc => acc
  | .cons x xs, acc => Hdl.RList.ofListAux xs (Hdl.RList.cons x acc)
/-- A list as a random-access list indexed like the list (element `k` at index `k`). -/
def Hdl.RList.ofList {A : Type} (xs : List A) : Hdl.RList A := Hdl.RList.ofListAux (Hdl.reverse xs) Hdl.RList.nil

/-- A growing vector: element `k` is the `k`-th pushed (`count` elements), on a random-access
list. The netlist simulator keeps node values in one. (Not the length-indexed `Vec`
of lib/Vec.wiz.) -/
structure Hdl.Vec (A : Type) where
  count : Nat
  items : Hdl.RList A
/-- The empty vector. -/
def Hdl.Vec.empty {A : Type} : Hdl.Vec A := Hdl.Vec.mk 0 Hdl.RList.nil
/-- Append an element (it gets index `count`). -/
def Hdl.Vec.push {A : Type} (v : Hdl.Vec A) (x : A) : Hdl.Vec A := Hdl.Vec.mk (Nat.succ v.count) (Hdl.RList.cons x v.items)
/-- `Hdl.Vec.get d v k`: the `k`-th element pushed, or `d`. -/
def Hdl.Vec.get {A : Type} (d : A) (v : Hdl.Vec A) (k : Nat) : A := Hdl.RList.get d (v.count - 1 - k) v.items
/-- Push the elements of a list, in order. -/
def Hdl.Vec.ofListAux {A : Type} : List A → Hdl.Vec A → Hdl.Vec A
  | .nil, v => v
  | .cons x xs, v => Hdl.Vec.ofListAux xs (Hdl.Vec.push v x)
/-- A list as a vector (element `k` at index `k`). -/
def Hdl.Vec.ofList {A : Type} (xs : List A) : Hdl.Vec A := Hdl.Vec.ofListAux xs Hdl.Vec.empty

------------------------------------------------------------------------------------
-- Netlist semantics: evaluate the nodes in order, once per clock cycle.

/-- `v` cut to `w` bits (modulo 2ʷ). -/
def Nat.wrap (w v : Nat) : Nat := Nat.mod v (Nat.pow 2 w)
/-- A boolean as 1 or 0. -/
def Nat.ofBool (b : Bool) : Nat := match b with
  | .true => 1
  | .false => 0
/-- Whether a number is 0. -/
def Hdl.isZero (v : Nat) : Bool := Nat.beq v 0

/-- A node prepared for simulation: `aux` is the width of the second argument (the shift
of a `concat`; the operands' width of an `slt`). -/
structure SimNode where
  op : NetOp
  width : Nat
  args : List Nat
  aux : Nat

/-- Prepare the nodes for simulation (compute each `concat`'s shift). -/
def SimNode.ofNodes : List NetNode → Hdl.Vec Nat → List SimNode
  | .nil, _ => .nil
  | .cons n ns, ws =>
    .cons (SimNode.mk n.op n.width n.args (Hdl.Vec.get 0 ws (Hdl.nthD 0 n.args 1)))
      (SimNode.ofNodes ns (Hdl.Vec.push ws n.width))

-- A memory's contents in simulation: address ↦ word (absent: 0).
/-- A memory's initial contents as a trie (word `k` at address `k`), from index `k` on. -/
def Hdl.memOfAux : Nat → List Nat → HTrie Nat → HTrie Nat
  | _, .nil, t => t
  | k, .cons w ws, t => Hdl.memOfAux (Nat.succ k) ws (HTrie.putN k w t)
/-- A memory's initial contents as a trie: word `k` at address `k`. -/
def Hdl.memOf (ws : List Nat) : HTrie Nat := Hdl.memOfAux 0 ws HTrie.tip
/-- The word at an address of a simulated memory (0 if unset). -/
def Hdl.memGet (t : HTrie Nat) (a : Nat) : Nat := match HTrie.getN a t with
  | .some v => v
  | .none => 0
/-- One node's value, given the values of the nodes before it, the input port values, the
register values and the memories. -/
def SimNode.eval (n : SimNode) (vals : Hdl.Vec Nat) (ins : List Nat) (regs : Hdl.Vec Nat) (mems : Hdl.Vec (HTrie Nat)) : Nat :=
  let ω arg := fun (i : Nat) => Hdl.Vec.get 0 vals (Hdl.nthD 0 n.args i);
  let ω w := n.width;
  match n.op with
  | .input p => Hdl.nthD 0 ins p
  | .const v => v
  | .reg r => Hdl.Vec.get 0 regs r
  | .add => Nat.wrap w (arg 0 + arg 1)
  | .sub => Nat.wrap w (arg 0 + Nat.pow 2 w - arg 1)
  | .mul => Nat.wrap w (arg 0 * arg 1)
  | .and => Nat.land (arg 0) (arg 1)
  | .or => Nat.lor (arg 0) (arg 1)
  | .xor => Nat.xor (arg 0) (arg 1)
  | .not => Nat.pow 2 w - 1 - arg 0
  | .eq => Nat.ofBool (Nat.beq (arg 0) (arg 1))
  | .ult => Nat.ofBool (Nat.lt (arg 0) (arg 1))
  | .shl => Hdl.shlN w (arg 0) (arg 1)
  | .lshr => Hdl.lshrN w (arg 0) (arg 1)
  | .ashr => Hdl.ashrN w (arg 0) (arg 1)
  | .slt => Nat.ofBool (Hdl.sltN n.aux (arg 0) (arg 1))
  | .mux => (match Hdl.isZero (arg 0) with
    | .true => arg 2
    | .false => arg 1)
  | .concat => Nat.shiftLeft (arg 0) n.aux + arg 1
  | .slice lo => Nat.wrap w (Nat.shiftRight (arg 0) lo)
  | .resetTo v => (match Hdl.isZero (arg 0) with
    | .true => arg 1
    | .false => v)
  | .hold => (match Hdl.isZero (arg 0) with
    | .true => arg 2
    | .false => arg 1)
  | .memRead m => Hdl.memGet (Hdl.Vec.get HTrie.tip mems m) (arg 0)

/-- The values of all nodes in one cycle, in order. -/
def SimNode.evalAll (ins : List Nat) (regs : Hdl.Vec Nat) (mems : Hdl.Vec (HTrie Nat)) : List SimNode → Hdl.Vec Nat → Hdl.Vec Nat
  | .nil, vals => vals
  | .cons n ns, vals => SimNode.evalAll ins regs mems ns (Hdl.Vec.push vals (SimNode.eval n vals ins regs mems))

/-- a memory at the clock edge: its enabled writes, in order -/
def NetMem.storeAux (vals : Hdl.Vec Nat) : List (Nat × (Nat × Nat)) → HTrie Nat → HTrie Nat
  | .nil, t => t
  | .cons w ws, t => NetMem.storeAux vals ws (match Hdl.isZero (Hdl.Vec.get 0 vals w.1) with
    | .true => t
    | .false => HTrie.putN (Hdl.Vec.get 0 vals w.2.1) (Hdl.Vec.get 0 vals w.2.2) t)
/-- The memories' contents after one cycle's writes, in order. -/
def NetMem.storeAll (vals : Hdl.Vec Nat) : List NetMem → List (HTrie Nat) → List (HTrie Nat)
  | .cons m ms, .cons t ts => .cons (NetMem.storeAux vals m.writes t) (NetMem.storeAll vals ms ts)
  | _, _ => .nil

/-- The value a register loads at the clock edge: `init` under reset, its own value `cur`
without enable, else its `next` node. -/
def NetReg.load (vals : Hdl.Vec Nat) (r : NetReg) (cur : Nat) : Nat :=
  let ω loaded := match r.en with
    | .none => Hdl.Vec.get 0 vals r.next
    | .some e => (match Hdl.isZero (Hdl.Vec.get 0 vals e) with
      | .true => cur
      | .false => Hdl.Vec.get 0 vals r.next);
  match r.rst with
  | .none => loaded
  | .some k => match Hdl.isZero (Hdl.Vec.get 0 vals k) with
    | .true => loaded
    | .false => r.init

/-- The next values of all registers. -/
def NetReg.loadAll (vals : Hdl.Vec Nat) : List NetReg → List Nat → List Nat
  | .cons r rs, .cons c cs => .cons (NetReg.load vals r c) (NetReg.loadAll vals rs cs)
  | _, _ => .nil

/-- An output port's value in a cycle. -/
def NetPort.read (vals : Hdl.Vec Nat) (p : NetPort) : Nat := Hdl.Vec.get 0 vals p.node

/-- The simulation loop: register values, memory contents, the inputs still to come, the
outputs so far. -/
def Netlist.simulateGo (n : Netlist) (prog : List SimNode) : List Nat → List (HTrie Nat) → List (List Nat) → List (List Nat) → List (List Nat)
  | _, _, .nil, acc => Hdl.reverse acc
  | regs, mems, .cons ins rest, acc =>
    let ω vals := SimNode.evalAll ins (Hdl.Vec.ofList regs) (Hdl.Vec.ofList mems) prog Hdl.Vec.empty;
    Netlist.simulateGo n prog (NetReg.loadAll vals n.regs regs) (NetMem.storeAll vals n.mems mems) rest
      (List.cons (Hdl.map (NetPort.read vals) n.outputs) acc)

/-- A clocked simulation of a netlist: one input vector per cycle (one value per input
port), the output vectors (one value per output port). O(nodes · log nodes) per cycle.
`Circuit.simLeaves` compares it with the value semantics. -/
def Netlist.simulate (n : Netlist) (inputs : List (List Nat)) : List (List Nat) :=
  Netlist.simulateGo n (SimNode.ofNodes n.nodes Hdl.Vec.empty) (Hdl.map (fun (r : NetReg) => r.init) n.regs)
    (Hdl.map (fun (m : NetMem) => Hdl.memOf m.init) n.mems) inputs List.nil

/-- The number of nodes whose operation satisfies `p`. -/
def Netlist.countAux (p : NetOp → Bool) : List NetNode → Nat
  | .nil => 0
  | .cons x xs => Nat.ofBool (p x.op) + Netlist.countAux p xs

/-- The number of nodes of a netlist. -/
def Netlist.size (n : Netlist) : Nat := List.length n.nodes

/-- Whether the operation is an adder (for `Netlist.count`). -/
def NetOp.isAdd : NetOp → Bool
  | .add => .true
  | _ => .false
/-- Whether the operation is a multiplexer (`mux`, and `resetTo`/`hold` that didn't become a
register's reset or enable). -/
def NetOp.isMux : NetOp → Bool
  | .mux => .true
  | .resetTo _ => .true
  | .hold => .true
  | _ => .false

/-- The number of nodes whose operation satisfies `p`:
`Netlist.count NetOp.isAdd (Circuit.netlist "c" c)`. -/
def Netlist.count (p : NetOp → Bool) (n : Netlist) : Nat :=
  Netlist.countAux p n.nodes

------------------------------------------------------------------------------------
-- From the builder's nodes to a netlist: registers take their reset and enable from
-- `resetTo`/`hold` nodes that feed them, and nodes nothing reads are dropped.

/-- A dummy node (a default for lookups). -/
def NetNode.none : NetNode := NetNode.mk (NetOp.const 0) 0 List.nil

/-- A `hold en x cur` in front of the register reading `cur`: an enable `en`, and `x` as the
next value; otherwise no enable. -/
def Net.peelEn (nodes : Hdl.Vec NetNode) (cur x : Nat) : Option Nat × Nat :=
  let ω n := Hdl.Vec.get NetNode.none nodes x;
  match n.op, n.args with
  | .hold, .cons e (.cons a (.cons b .nil)) => (match Nat.beq b cur with
    | .true => (Option.some e, a)
    | .false => (Option.none, x))
  | _, _ => (Option.none, x)
/-- A `resetTo rst init x` in front of a register, with the register's initial value: a
reset `rst`; then the enable (`Net.peelEn`) and the next value. -/
def Net.peel (nodes : Hdl.Vec NetNode) (cur init next : Nat) : Option Nat × (Option Nat × Nat) :=
  let ω n := Hdl.Vec.get NetNode.none nodes next;
  match n.op, n.args with
  | .resetTo v, .cons c (.cons x .nil) => (match Nat.beq v init with
    | .true => (Option.some c, Net.peelEn nodes cur x)
    | .false => (Option.none, Net.peelEn nodes cur next))
  | _, _ => (Option.none, Net.peelEn nodes cur next)

/-- The registers: names, widths, initial values, the nodes that read them, their next
values, with resets and enables peeled off. -/
def Net.regs (nodes : Hdl.Vec NetNode) : List String → List Nat → List Nat → List Nat → List Nat → List NetReg
  | .cons nm nms, .cons w ws, .cons v vs, .cons c cs, .cons x xs =>
    let ω p := Net.peel nodes c v x;
    .cons (NetReg.mk nm w v p.2.2 p.1 p.2.1) (Net.regs nodes nms ws vs cs xs)
  | _, _, _, _, _ => .nil

/-- Ports from their names, widths and nodes. -/
def Net.ports : List String → List Nat → List Nat → List NetPort
  | .cons nm nms, .cons w ws, .cons k ks => .cons (NetPort.mk nm w k) (Net.ports nms ws ks)
  | _, _, _ => .nil

/-- A set of numbers (an `HTrie` of keys). -/
def Hdl.Set : Type := HTrie Unit
/-- Add numbers to a set. -/
def Hdl.Set.addAll : List Nat → Hdl.Set → Hdl.Set
  | .nil, s => s
  | .cons k ks, s => Hdl.Set.addAll ks (HTrie.putN k () s)
/-- Whether a number is in a set. -/
def Hdl.Set.has (k : Nat) (s : Hdl.Set) : Bool := match HTrie.getN k s with
  | .some _ => .true
  | .none => .false
/-- An option as a list of zero or one elements. -/
def Hdl.optList : Option Nat → List Nat
  | .none => .nil
  | .some k => .cons k .nil
/-- The nodes a register reads: its next value, reset and enable. -/
def NetReg.reads (r : NetReg) : List Nat := .cons r.next (List.append (Hdl.optList r.rst) (Hdl.optList r.en))
/-- The nodes the registers read. -/
def NetReg.readsAll : List NetReg → List Nat
  | .nil => .nil
  | .cons r rs => List.append (NetReg.reads r) (NetReg.readsAll rs)

/-- Which nodes are live, in order, from the nodes newest first (`k` the newest's id) and
the set of nodes needed. -/
def Net.liveAux : List NetNode → Nat → Hdl.Set → List Bool → List Bool
  | .nil, _, _, acc => acc
  | .cons n ns, k, need, acc => match Hdl.Set.has k need with
    | .true => Net.liveAux ns (k - 1) (Hdl.Set.addAll n.args need) (List.cons .true acc)
    | .false => Net.liveAux ns (k - 1) need (List.cons .false acc)

/-- A node's new id (0 if it has none). -/
def Net.mapId (m : HTrie Nat) (k : Nat) : Nat := match HTrie.getN k m with
  | .some j => j
  | .none => 0

/-- Renumber the live nodes (in order), dropping the others; also returns the map from old
ids to new. -/
def Net.renumber : List NetNode → List Bool → Nat → Nat → HTrie Nat → List NetNode → List NetNode × HTrie Nat
  | .cons n ns, .cons l ls, k, j, m, acc => (match l with
    | .true => Net.renumber ns ls (Nat.succ k) (Nat.succ j) (HTrie.putN k j m)
        (List.cons (NetNode.mk n.op n.width (Hdl.map (Net.mapId m) n.args)) acc)
    | .false => Net.renumber ns ls (Nat.succ k) j m acc)
  | _, _, _, _, m, acc => (Hdl.reverse acc, m)

/-- `Net.mapId` under an option. -/
def Net.mapOpt (m : HTrie Nat) : Option Nat → Option Nat
  | .none => .none
  | .some k => .some (Net.mapId m k)
/-- A register with its nodes renumbered. -/
def NetReg.remap (m : HTrie Nat) (r : NetReg) : NetReg :=
  NetReg.mk r.name r.width r.init (Net.mapId m r.next) (Net.mapOpt m r.rst) (Net.mapOpt m r.en)
/-- A port with its node renumbered. -/
def NetPort.remap (m : HTrie Nat) (p : NetPort) : NetPort := NetPort.mk p.name p.width (Net.mapId m p.node)
/-- The wire names of live nodes, renumbered. -/
def Net.remapHints (live : Hdl.Set) (m : HTrie Nat) : List (Nat × String) → List (Nat × String)
  | .nil => .nil
  | .cons h hs => match Hdl.Set.has h.1 live with
    | .true => .cons (Net.mapId m h.1, h.2) (Net.remapHints live m hs)
    | .false => Net.remapHints live m hs
/-- The live nodes' ids as a set. -/
def Net.liveSet : List Bool → Nat → Hdl.Set → Hdl.Set
  | .nil, _, s => s
  | .cons b bs, k, s => match b with
    | .true => Net.liveSet bs (Nat.succ k) (HTrie.putN k () s)
    | .false => Net.liveSet bs (Nat.succ k) s

-- The netlist of a builder's state, with registers and ports. Roots: the ports, the
-- nodes that read the registers and what the registers load.
/-- The nodes a memory's writes read. -/
def NetMem.reads : List (Nat × (Nat × Nat)) → List Nat
  | .nil => .nil
  | .cons w ws => .cons w.1 (.cons w.2.1 (.cons w.2.2 (NetMem.reads ws)))
/-- The nodes the memories' writes read. -/
def NetMem.readsAll : List NetMem → List Nat
  | .nil => .nil
  | .cons m ms => List.append (NetMem.reads m.writes) (NetMem.readsAll ms)
/-- A memory's writes with their node ids renumbered. -/
def NetMem.remapW (m : HTrie Nat) : List (Nat × (Nat × Nat)) → List (Nat × (Nat × Nat))
  | .nil => .nil
  | .cons w ws => .cons (Net.mapId m w.1, (Net.mapId m w.2.1, Net.mapId m w.2.2)) (NetMem.remapW m ws)
/-- A memory with its writes renumbered. -/
def NetMem.remap (m : HTrie Nat) (x : NetMem) : NetMem := NetMem.mk x.name x.aw x.dw x.init (NetMem.remapW m x.writes)

/-- The netlist of a builder's state, with registers and ports; nodes nothing reads are
dropped. Roots: the ports, the nodes that read the registers and what the registers load. -/
def Net.finish (name : String) (s : NetS) (regs : List NetReg) (regReads : List Nat)
    (ins outs : List NetPort) : Netlist :=
  let ω mems := Hdl.reverse s.mems;
  let ω roots := List.append (Hdl.map (fun (p : NetPort) => p.node) ins)
    (List.append regReads (List.append (Hdl.map (fun (p : NetPort) => p.node) outs)
      (List.append (NetReg.readsAll regs) (NetMem.readsAll mems))));
  let ω live := Net.liveAux s.nodes (s.next - 1) (Hdl.Set.addAll roots HTrie.tip) List.nil;
  let ω r := Net.renumber (Hdl.reverse s.nodes) live 0 0 HTrie.tip List.nil;
  Netlist.mk name r.1 (Hdl.map (NetReg.remap r.2) regs) (Hdl.map (NetPort.remap r.2) ins)
    (Hdl.map (NetPort.remap r.2) outs) (Net.remapHints (Net.liveSet live 0 HTrie.tip) r.2 (Hdl.reverse s.hints))
    (Hdl.map (NetMem.remap r.2) mems) (Hdl.reverse s.errs)

------------------------------------------------------------------------------------
-- Circuits: Mealy machines whose step is tagless-final code. The only way to make
-- feedback: the state is a register.

/-- A sequential circuit: a Mealy machine with state type `st`, initial state `init` and a
step that is hardware code (at every representation): from the current state and the
input, the next state and the output. The state is the registers; this is the only way
to make feedback.

```
-- a counter: the output is the count, which goes up every cycle
def counter : Circuit (HwTy.bits 0) (HwTy.bits 8) :=
  Circuit.mk (HwTy.bits 8) (BitVec.ofNat 8 0) (fun s _ => Hw.pair (Hw.add s (Hw.lit 8 1)) s)
``` -/
structure Circuit (i o : HwTy) where
  st : HwTy
  init : HwTy.El st
  step : {r : HwTy → Type} → [Hw r] → r st → r i → r (HwTy.prod st o)

/-- The step on values (the representation is found from the result type). -/
def Circuit.stepEl {i o : HwTy} (c : Circuit i o) (s : HwTy.El c.st) (x : HwTy.El i) : HwTy.El (HwTy.prod c.st o) := c.step s x
/-- The step on wires. -/
def Circuit.stepWire {i o : HwTy} (c : Circuit i o) (s : Wire c.st) (x : Wire i) : Wire (HwTy.prod c.st o) := c.step s x

/-- The semantics: simulation by values over a finite input trace, from state `s`.
`runFrom` is the specification (structural, for proofs); `Circuit.run` is the same with
an accumulator (for long traces), and `Circuit.run_eq` says they agree. -/
def Circuit.runFrom {ω i o : HwTy} (c : Circuit i o) : HwTy.El c.st → List (HwTy.El i) → List (HwTy.El o)
  | _, .nil => .nil
  | s, .cons x xs => List.cons (Circuit.stepEl c s x).2 (Circuit.runFrom c (Circuit.stepEl c s x).1 xs)

/-- `Circuit.runFrom` with an accumulator (the outputs so far, reversed). -/
def Circuit.runAcc {ω i o : HwTy} (c : Circuit i o) : HwTy.El c.st → List (HwTy.El i) → List (HwTy.El o) → List (HwTy.El o)
  | _, .nil, acc => Hdl.rev acc List.nil
  | s, .cons x xs, acc =>
    let ω r : HwTy.El c.st × HwTy.El o := Circuit.stepEl c s x;
    Circuit.runAcc c r.1 xs (List.cons r.2 acc)

/-- Simulate a circuit from its initial state: one output per input.
`Circuit.run (Circuit.delay t v) [a, b] = [v, a]`. -/
def Circuit.run {ω i o : HwTy} (c : Circuit i o) (xs : List (HwTy.El i)) : List (HwTy.El o) :=
  Circuit.runAcc c c.init xs List.nil

/-- `Circuit.runAcc` is `Circuit.runFrom` behind the accumulator. -/
def Circuit.runAcc_eq {i o : HwTy} (c : Circuit i o) : (s : HwTy.El c.st) → (xs : List (HwTy.El i)) → (acc : List (HwTy.El o)) →
    Circuit.runAcc c s xs acc = Hdl.rev acc (Circuit.runFrom c s xs)
  | s, .nil, acc => refl (Hdl.rev acc (@List.nil (HwTy.El o)))
  | s, .cons x xs, acc => Circuit.runAcc_eq c (Circuit.stepEl c s x).1 xs (List.cons (Circuit.stepEl c s x).2 acc)

/-- `Circuit.run` agrees with the specification `Circuit.runFrom`. -/
def Circuit.run_eq {i o : HwTy} (c : Circuit i o) (xs : List (HwTy.El i)) : Circuit.run c xs = Circuit.runFrom c c.init xs :=
  Circuit.runAcc_eq c c.init xs List.nil

/-- The infinite semantics (lib/Trace.wiz): a circuit is a Mealy machine, and its run along
an input trace is a trace. `run` and `runFrom` are its finite prefixes
(`Mealy.runFrom_take`, `Circuit.run_take`); temporal properties are stated over `Circuit.trace` and
`Circuit.obs`. -/
def Circuit.mealy {i o : HwTy} (c : Circuit i o) : Mealy (HwTy.El c.st) (HwTy.El i) (HwTy.El o) := Circuit.stepEl c
/-- The state at each cycle, along an input trace. -/
def Circuit.stateAt {ω i o : HwTy} (c : Circuit i o) (xs : Trace (HwTy.El i)) : Trace (HwTy.El c.st) :=
  Mealy.stateAt (Circuit.mealy c) c.init xs
/-- The outputs at each cycle, along an input trace. -/
def Circuit.trace {ω i o : HwTy} (c : Circuit i o) (xs : Trace (HwTy.El i)) : Trace (HwTy.El o) :=
  Mealy.outAt (Circuit.mealy c) c.init xs
/-- the state and the input at each cycle -/
def Circuit.obs {ω i o : HwTy} (c : Circuit i o) (xs : Trace (HwTy.El i)) : Trace (HwTy.El c.st × HwTy.El i) :=
  Mealy.obs (Circuit.mealy c) c.init xs

/-- `runFrom` is `Mealy.runFrom` of the step, so simulating `n` cycles gives the first `n`
elements of the trace. -/
def Circuit.runFrom_mealy {i o : HwTy} (c : Circuit i o) : (s : HwTy.El c.st) → (xs : List (HwTy.El i)) →
    Circuit.runFrom c s xs = Mealy.run (Circuit.mealy c) s xs
  | s, .nil => rfl
  | s, .cons x xs => Eq.congrArg (List.cons (Circuit.stepEl c s x).2) (Circuit.runFrom_mealy c (Circuit.stepEl c s x).1 xs)
/-- (the statement lib/Hdl/Temporal.wiz uses) -/
def Mealy.runFrom_take {i o : HwTy} (c : Circuit i o) (n : Nat) (s : HwTy.El c.st) (xs : Trace (HwTy.El i)) :
    Circuit.runFrom c s (Trace.take n xs) = Trace.take n (Mealy.outAt (Circuit.stepEl c) s xs) :=
  Eq.trans (Circuit.runFrom_mealy c s (Trace.take n xs)) (Mealy.run_take (Circuit.mealy c) n s xs)
/-- `Circuit.run` of `n` cycles is the first `n` elements of `Circuit.trace`. -/
def Circuit.run_take {i o : HwTy} (c : Circuit i o) (n : Nat) (xs : Trace (HwTy.El i)) :
    Circuit.run c (Trace.take n xs) = Trace.take n (Circuit.trace c xs) :=
  Eq.trans (Circuit.run_eq c (Trace.take n xs)) (Mealy.runFrom_take c n c.init xs)

------------------------------------------------------------------------------------
-- Composition. Each combinator's state is made of its parts' states; the lemmas after
-- each say what it does to `runFrom` (and so, by `Circuit.run_eq`, to `run`).

/-- Combinational code: a function at every representation (`fun x => Hw.xor x k`, or a
definition `{r : HwTy → Type} → [Hw r] → r i → r o` by name). -/
def Comb (i o : HwTy) : Type 1 := {r : HwTy → Type} → [Hw r] → r i → r o

/-- A stateless circuit: combinational code (`Circuit.runFrom_comb`). -/
def Circuit.comb {ω i o : HwTy} (f : Comb i o) : Circuit i o :=
  Circuit.mk (HwTy.bits 0) (BitVec.ofNat 0 0) (fun s x => Hw.pair s (f x))

/-- One register: the output is the input of the cycle before (`init` first). -/
def Circuit.delay (ω t : HwTy) (init : HwTy.El t) : Circuit t t :=
  Circuit.mk t init (fun s x => Hw.pair x s)

/-- `a`, then `b` on its outputs (`Circuit.run_seq`). -/
def Circuit.seq {ω i m o : HwTy} (a : Circuit i m) (b : Circuit m o) : Circuit i o :=
  Circuit.mk (HwTy.prod a.st b.st) (a.init, b.init) (fun s x =>
    let ra := a.step (Hw.fst s) x;
    let rb := b.step (Hw.snd s) (Hw.snd ra);
    Hw.pair (Hw.pair (Hw.fst ra) (Hw.fst rb)) (Hw.snd rb))

/-- `a` and `b` side by side, on the two halves of the input and output (`Circuit.run_par`). -/
def Circuit.par {ω i1 o1 i2 o2 : HwTy} (a : Circuit i1 o1) (b : Circuit i2 o2) : Circuit (HwTy.prod i1 i2) (HwTy.prod o1 o2) :=
  Circuit.mk (HwTy.prod a.st b.st) (a.init, b.init) (fun s x =>
    let ra := a.step (Hw.fst s) (Hw.fst x);
    let rb := b.step (Hw.snd s) (Hw.snd x);
    Hw.pair (Hw.pair (Hw.fst ra) (Hw.fst rb)) (Hw.pair (Hw.snd ra) (Hw.snd rb)))

/-- Feedback through a register: `c`'s second output comes back as its second input in the
next cycle (`init` first). -/
def Circuit.loop {ω i o f : HwTy} (c : Circuit (HwTy.prod i f) (HwTy.prod o f)) (init : HwTy.El f) : Circuit i o :=
  Circuit.mk (HwTy.prod c.st f) (c.init, init) (fun s x =>
    let rc := c.step (Hw.fst s) (Hw.pair x (Hw.snd s));
    Hw.pair (Hw.pair (Hw.fst rc) (Hw.snd (Hw.snd rc))) (Hw.fst (Hw.snd rc)))

/-- A name for the state: its registers are `name_…`. It doesn't change the behaviour
(`Circuit.run_named`). -/
def Circuit.named {ω i o : HwTy} (name : String) (c : Circuit i o) : Circuit i o :=
  Circuit.mk (HwTy.named name c.st) c.init (fun s x =>
    let rc := c.step (Hw.untag s) x;
    Hw.pair (Hw.tag name (Hw.fst rc)) (Hw.snd rc))

/-- Combinational code before a circuit. -/
def Circuit.mapIn {ω i' i o : HwTy} (f : Comb i' i) (c : Circuit i o) : Circuit i' o :=
  Circuit.mk c.st c.init (fun s x => c.step s (f x))
/-- Combinational code after a circuit. -/
def Circuit.mapOut {ω i o o' : HwTy} (f : Comb o o') (c : Circuit i o) : Circuit i o' :=
  Circuit.mk c.st c.init (fun s x =>
    let rc := c.step s x;
    Hw.pair (Hw.fst rc) (f (Hw.snd rc)))

/-- A name for the input: the ports are `name`, or `name_…` for a product. -/
def Circuit.inputName {ω i o : HwTy} (name : String) (c : Circuit i o) : Circuit (HwTy.named name i) o :=
  Circuit.mk c.st c.init (fun s x => c.step s (Hw.untag x))
/-- A name for the output: the ports are `name`, or `name_…` for a product. -/
def Circuit.outputName {ω i o : HwTy} (name : String) (c : Circuit i o) : Circuit i (HwTy.named name o) :=
  Circuit.mk c.st c.init (fun s x =>
    let rc := c.step s x;
    Hw.pair (Hw.fst rc) (Hw.tag name (Hw.snd rc)))

/-- An instance of `c` inside another step: `s` is its state (a part of the caller's state,
starting at `c.init`), the result its next state and its output. -/
def Circuit.inst {r : HwTy → Type} [Hw r] {i o : HwTy} (c : Circuit i o) (s : r c.st) (x : r i) : r (HwTy.prod c.st o) :=
  c.step s x

/-- A synchronous reset: while `rst` (a new first input) is high the next state is `c.init`
(the outputs in that cycle are `c`'s, from the current state). In the netlist, every
register gets `rst` as its reset (`if (rst) r <= init;` in Verilog). -/
def Circuit.withReset {ω i o : HwTy} (c : Circuit i o) : Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) i) o :=
  Circuit.mk c.st c.init (fun s x =>
    let rc := c.step s (Hw.snd x);
    Hw.pair (Hw.resetTo (Hw.untag (Hw.fst x)) c.init (Hw.fst rc)) (Hw.snd rc))

/-- A clock enable: while `en` (a new first input) is low the state holds (the outputs are
still `c`'s, from the current state and input). In the netlist, every register gets
`en` as its enable. -/
def Circuit.withEnable {ω i o : HwTy} (c : Circuit i o) : Circuit (HwTy.prod (HwTy.named "en" HwTy.bit) i) o :=
  Circuit.mk c.st c.init (fun s x =>
    let rc := c.step s (Hw.snd x);
    Hw.pair (Hw.hold (Hw.untag (Hw.fst x)) (Hw.fst rc) s) (Hw.snd rc))

/-- (H14 S4) The reset and enable convention. A design that has a reset or a clock enable
takes them as its first inputs, named `rst` and `en`, reset first: `rst` wins over
`en` (a held register is still reset), and both are synchronous and active high (as
`if (rst) r <= init; else if (en) r <= next;`). For a whole circuit:
`Circuit.withResetEnable c`; for one register: `Circuit.registerR`/`registerE`/
`registerRE`; for one field of a state inside a step function: `Hw.regNext rst en init
cur next` (the next value of a register whose value is `cur`). Each of them becomes
the register's reset and enable in the netlist, not a multiplexer. Every register still
has its initial value (`initial` in Verilog: the iCE40 needs no reset). -/
def Circuit.withResetEnable {ω i o : HwTy} (c : Circuit i o) :
    Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) (HwTy.prod (HwTy.named "en" HwTy.bit) i)) o :=
  Circuit.withReset (Circuit.withEnable c)
/-- a register (`Circuit.delay`) with a reset to its initial value, with an enable, with both -/
def Circuit.registerR (ω t : HwTy) (init : HwTy.El t) : Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) t) t :=
  Circuit.withReset (Circuit.delay t init)
/-- A register with an enable (`Circuit.delay` with `Circuit.withEnable`). -/
def Circuit.registerE (ω t : HwTy) (init : HwTy.El t) : Circuit (HwTy.prod (HwTy.named "en" HwTy.bit) t) t :=
  Circuit.withEnable (Circuit.delay t init)
/-- A register with a reset and an enable. -/
def Circuit.registerRE (ω t : HwTy) (init : HwTy.El t) :
    Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) (HwTy.prod (HwTy.named "en" HwTy.bit) t)) t :=
  Circuit.withResetEnable (Circuit.delay t init)
/-- inside a step function: `init` under `rst`, else `next` under `en`, else `cur` (for the
netlist to see a reset, `init` must be the register's initial value; to see an enable,
`cur` must be the register itself) -/
def Hw.regNext {r : HwTy → Type} [Hw r] {ω t : HwTy} (rst en : r HwTy.bit) (init : HwTy.El t) (cur next : r t) : r t :=
  Hw.resetTo rst init (Hw.hold en next cur)

------------------------------------------------------------------------------------
-- What the combinators do to the semantics.

/-- Pairs of corresponding elements (as long as the shorter list). -/
def Hdl.zip {A B : Type} : List A → List B → List (A × B)
  | .cons a as, .cons b bs => .cons (a, b) (Hdl.zip as bs)
  | _, _ => .nil
/-- `v`, then the list without its last element: what a delay does to a trace. -/
def Hdl.shift {A : Type} : A → List A → List A
  | _, .nil => .nil
  | v, .cons x xs => .cons v (Hdl.shift x xs)
/-- The first components of a list of pairs. -/
def Hdl.fsts {A B : Type} : List (A × B) → List A
  | .nil => .nil
  | .cons p ps => .cons p.1 (Hdl.fsts ps)
/-- The second components of a list of pairs. -/
def Hdl.snds {A B : Type} : List (A × B) → List B
  | .nil => .nil
  | .cons p ps => .cons p.2 (Hdl.snds ps)

/-- Equal lists stay equal with the same head. -/
def Hdl.consEq {A : Type} (x : A) {xs ys : List A} (e : xs = ys) : List.cons x xs = List.cons x ys :=
  Eq.congrArg (List.cons x) e

/-- Combinational code at values. -/
def Comb.el {i o : HwTy} (f : Comb i o) (x : HwTy.El i) : HwTy.El o := f x
/-- A combinational circuit maps its code over the trace. -/
def Circuit.runFrom_comb {i o : HwTy} (f : Comb i o) :
    (s : HwTy.El (HwTy.bits 0)) → (xs : List (HwTy.El i)) →
    Circuit.runFrom (Circuit.comb f) s xs = Hdl.map (Comb.el f) xs
  | s, .nil => refl (@List.nil (HwTy.El o))
  | s, .cons x xs => Hdl.consEq (Comb.el f x) (Circuit.runFrom_comb f s xs)

/-- A delay shifts the trace by one, starting with its state. -/
def Circuit.runFrom_delay {t : HwTy} (v : HwTy.El t) : (s : HwTy.El t) → (xs : List (HwTy.El t)) →
    Circuit.runFrom (Circuit.delay t v) s xs = Hdl.shift s xs
  | s, .nil => refl (@List.nil (HwTy.El t))
  | s, .cons x xs => Hdl.consEq s (Circuit.runFrom_delay v x xs)

/-- A sequence runs the second circuit on the first one's outputs. -/
def Circuit.runFrom_seq {i m o : HwTy} (a : Circuit i m) (b : Circuit m o) :
    (sa : HwTy.El a.st) → (sb : HwTy.El b.st) → (xs : List (HwTy.El i)) →
    Circuit.runFrom (Circuit.seq a b) (sa, sb) xs = Circuit.runFrom b sb (Circuit.runFrom a sa xs)
  | sa, sb, .nil => refl (@List.nil (HwTy.El o))
  | sa, sb, .cons x xs =>
    Hdl.consEq (Circuit.stepEl b sb (Circuit.stepEl a sa x).2).2
      (Circuit.runFrom_seq a b (Circuit.stepEl a sa x).1 (Circuit.stepEl b sb (Circuit.stepEl a sa x).2).1 xs)

/-- Side by side: each circuit on its half of the inputs, the outputs zipped. -/
def Circuit.runFrom_par {i1 o1 i2 o2 : HwTy} (a : Circuit i1 o1) (b : Circuit i2 o2) :
    (sa : HwTy.El a.st) → (sb : HwTy.El b.st) → (xs : List (HwTy.El i1 × HwTy.El i2)) →
    Circuit.runFrom (Circuit.par a b) (sa, sb) xs =
      Hdl.zip (Circuit.runFrom a sa (Hdl.fsts xs)) (Circuit.runFrom b sb (Hdl.snds xs))
  | sa, sb, .nil => refl (@List.nil (HwTy.El o1 × HwTy.El o2))
  | sa, sb, .cons x xs =>
    Hdl.consEq ((Circuit.stepEl a sa x.1).2, (Circuit.stepEl b sb x.2).2)
      (Circuit.runFrom_par a b (Circuit.stepEl a sa x.1).1 (Circuit.stepEl b sb x.2).1 xs)

/-- Feedback, one cycle (the definition, as an equation to rewrite with). -/
def Circuit.runFrom_loop {i o f : HwTy} (v : HwTy.El f) (c : Circuit (HwTy.prod i f) (HwTy.prod o f))
    (s : HwTy.El c.st) (fb : HwTy.El f) (x : HwTy.El i) (xs : List (HwTy.El i)) :
    Circuit.runFrom (Circuit.loop c v) (s, fb) (List.cons x xs) =
      List.cons (Circuit.stepEl c s (x, fb)).2.1
        (Circuit.runFrom (Circuit.loop c v) ((Circuit.stepEl c s (x, fb)).1, (Circuit.stepEl c s (x, fb)).2.2) xs) :=
  refl (Circuit.runFrom (Circuit.loop c v) (s, fb) (List.cons x xs))

/-- Naming the state changes nothing. -/
def Circuit.runFrom_named {i o : HwTy} (name : String) (c : Circuit i o) : (s : HwTy.El c.st) → (xs : List (HwTy.El i)) →
    Circuit.runFrom (Circuit.named name c) s xs = Circuit.runFrom c s xs
  | s, .nil => refl (@List.nil (HwTy.El o))
  | s, .cons x xs => Hdl.consEq (Circuit.stepEl c s x).2 (Circuit.runFrom_named name c (Circuit.stepEl c s x).1 xs)

/-- An instance, at values, is the sub-circuit's step. -/
def Circuit.inst_el {i o : HwTy} (c : Circuit i o) (s : HwTy.El c.st) (x : HwTy.El i) :
    @Circuit.inst HwTy.El _ i o c s x = Circuit.stepEl c s x := refl (Circuit.stepEl c s x)

/-- Reset, one cycle: the next state is `c.init` when `rst` is 1. -/
def Circuit.stepEl_withReset {i o : HwTy} (c : Circuit i o) (s : HwTy.El c.st) (rst : HwTy.El HwTy.bit) (x : HwTy.El i) :
    Circuit.stepEl (Circuit.withReset c) s (rst, x) =
      (HwTy.El.resetToAt c.st rst c.init (Circuit.stepEl c s x).1, (Circuit.stepEl c s x).2) :=
  refl (Circuit.stepEl (Circuit.withReset c) s (rst, x))
/-- Enable, one cycle: the state holds when `en` is 0. -/
def Circuit.stepEl_withEnable {i o : HwTy} (c : Circuit i o) (s : HwTy.El c.st) (en : HwTy.El HwTy.bit) (x : HwTy.El i) :
    Circuit.stepEl (Circuit.withEnable c) s (en, x) =
      (@HwTy.El.mux c.st en (Circuit.stepEl c s x).1 s, (Circuit.stepEl c s x).2) :=
  refl (Circuit.stepEl (Circuit.withEnable c) s (en, x))
/-- the registers, cycle by cycle: the output is the current value; the next one is `init`
under reset (memories keep their contents, `resetToAt`), the input under enable, else
the current value -/
def Circuit.stepEl_registerRE {ω t : HwTy} (v : HwTy.El t) (s : HwTy.El t) (rst en : HwTy.El HwTy.bit) (x : HwTy.El t) :
    Circuit.stepEl (Circuit.registerRE t v) s (rst, (en, x)) = (HwTy.El.resetToAt t rst v (HwTy.El.mux en x s), s) :=
  rfl
/-- `Circuit.registerR`'s step: `init` under reset, else the input (the state holds). -/
def Circuit.stepEl_registerR {ω t : HwTy} (v : HwTy.El t) (s : HwTy.El t) (rst : HwTy.El HwTy.bit) (x : HwTy.El t) :
    Circuit.stepEl (Circuit.registerR t v) s (rst, x) = (HwTy.El.resetToAt t rst v x, s) :=
  rfl
/-- `Circuit.registerE`'s step: the input under enable, else the current state. -/
def Circuit.stepEl_registerE {ω t : HwTy} (v : HwTy.El t) (s : HwTy.El t) (en : HwTy.El HwTy.bit) (x : HwTy.El t) :
    Circuit.stepEl (Circuit.registerE t v) s (en, x) = (HwTy.El.mux en x s, s) :=
  rfl

/-- memories at values: a read sees an enabled write to its address, and nothing else -/
def Hdl.memWr_miss {aw dw : Nat} (m : BitVec aw → BitVec dw) (a : BitVec aw) (d : BitVec dw) (b : BitVec aw)
    (h : BitVec.beq a b = .false) : (we : Bool) → Hdl.memWr we m a d b = m b
  | .false => rfl
  | .true => Eq.substProp (fun (hit : Bool) => Hdl.memPick hit d (m b) = m b) (Eq.symm h) rfl
/-- A read after a write to another address is the read before it. -/
def HwTy.El.memRead_write_miss {aw dw : Nat} (m : HwTy.El (HwTy.mem aw dw)) (we : HwTy.El HwTy.bit) (a : HwTy.El (HwTy.bits aw))
    (d : HwTy.El (HwTy.bits dw)) (b : HwTy.El (HwTy.bits aw)) (h : BitVec.beq (a : BitVec aw) b = .false) :
    HwTy.El.memRead (HwTy.El.memWrite m we a d) b = HwTy.El.memRead m b :=
  Hdl.memWr_miss (m : BitVec aw → BitVec dw) (a : BitVec aw) (d : BitVec dw) b h (BitVec.isTrue (we : BitVec 1))
/-- A read after an enabled write to its address is the word written. -/
def HwTy.El.memRead_write_hit {aw dw : Nat} (m : HwTy.El (HwTy.mem aw dw)) (a : HwTy.El (HwTy.bits aw))
    (d : HwTy.El (HwTy.bits dw)) (b : HwTy.El (HwTy.bits aw)) (h : BitVec.beq (a : BitVec aw) b = .true) :
    HwTy.El.memRead (HwTy.El.memWrite m (BitVec.ofNat 1 1) a d) b = d :=
  Eq.substProp (fun (hit : Bool) => Hdl.memPick hit (d : BitVec dw) ((m : BitVec aw → BitVec dw) b) = d) (Eq.symm h) rfl
/-- A disabled write leaves every read unchanged. -/
def HwTy.El.memRead_write_off {aw dw : Nat} (m : HwTy.El (HwTy.mem aw dw)) (a : HwTy.El (HwTy.bits aw))
    (d : HwTy.El (HwTy.bits dw)) (b : HwTy.El (HwTy.bits aw)) :
    HwTy.El.memRead (HwTy.El.memWrite m (BitVec.ofNat 1 0) a d) b = HwTy.El.memRead m b := rfl

/-- `Circuit.runFrom_seq` for `Circuit.run`. -/
def Circuit.run_seq {ω i m o : HwTy} (a : Circuit i m) (b : Circuit m o) (xs : List (HwTy.El i)) :
    Circuit.run (Circuit.seq a b) xs = Circuit.run b (Circuit.run a xs) :=
  Eq.trans (Eq.trans (Circuit.run_eq (Circuit.seq a b) xs) (Circuit.runFrom_seq a b a.init b.init xs))
    (Eq.symm (Eq.trans (Circuit.run_eq b (Circuit.run a xs)) (Eq.congrArg (Circuit.runFrom b b.init) (Circuit.run_eq a xs))))
/-- `Circuit.runFrom_delay` for `Circuit.run`: the trace shifted, `v` first. -/
def Circuit.run_delay {ω t : HwTy} (v : HwTy.El t) (xs : List (HwTy.El t)) :
    Circuit.run (Circuit.delay t v) xs = Hdl.shift v xs :=
  Eq.trans (Circuit.run_eq (Circuit.delay t v) xs) (Circuit.runFrom_delay v v xs)
/-- `Circuit.runFrom_par` for `Circuit.run`. -/
def Circuit.run_par {ω i1 o1 i2 o2 : HwTy} (a : Circuit i1 o1) (b : Circuit i2 o2) (xs : List (HwTy.El i1 × HwTy.El i2)) :
    Circuit.run (Circuit.par a b) xs = Hdl.zip (Circuit.run a (Hdl.fsts xs)) (Circuit.run b (Hdl.snds xs)) :=
  Eq.trans (Eq.trans (Circuit.run_eq (Circuit.par a b) xs) (Circuit.runFrom_par a b a.init b.init xs))
    (Eq.symm (Eq.trans (Eq.congrArg (fun (l : List (HwTy.El o1)) => Hdl.zip l (Circuit.run b (Hdl.snds xs))) (Circuit.run_eq a (Hdl.fsts xs)))
      (Eq.congrArg (Hdl.zip (Circuit.runFrom a a.init (Hdl.fsts xs))) (Circuit.run_eq b (Hdl.snds xs)))))
/-- `Circuit.runFrom_named` for `Circuit.run`. -/
def Circuit.run_named {ω i o : HwTy} (name : String) (c : Circuit i o) (xs : List (HwTy.El i)) :
    Circuit.run (Circuit.named name c) xs = Circuit.run c xs :=
  Eq.trans (Eq.trans (Circuit.run_eq (Circuit.named name c) xs) (Circuit.runFrom_named name c c.init xs))
    (Eq.symm (Circuit.run_eq c xs))

------------------------------------------------------------------------------------
-- Synthesis: the step at the wire instance. Ports: one per leaf of the input and the
-- output (`HwTy.portNames "x"`, `"y"`); registers: one per leaf of the state
-- (`HwTy.portNames "r"`).

/-- One leaf node per width (`mk k` for the `k`-th: inputs or registers); their ids. -/
def NetM.emitLeaves (mk : Nat → NetOp) : Nat → List Nat → NetM (List Nat)
  | _, .nil => NetM.pure List.nil
  | k, .cons w ws => do
    x ← NetM.emit (mk k) w List.nil;
    rest ← NetM.emitLeaves mk (Nat.succ k) ws;
    NetM.pure (List.cons x rest)

/-- Make the state's memories, numbered from 0 (they are made first). -/
def NetM.stateMems : List String → List (Nat × Nat) → List (List Nat) → NetM Unit
  | .cons nm nms, .cons sh shs, .cons ws wss => do
    k ← NetM.newMem (NetMem.mk nm sh.1 sh.2 ws .nil);
    NetM.stateMems nms shs wss
  | _, _, _ => NetM.pure ()
/-- The next value of state memory `k` must be memory `k` with writes. -/
def NetM.memNexts : Nat → List (Nat × List (Nat × (Nat × Nat))) → NetM Unit
  | _, .nil => NetM.pure ()
  | k, .cons m ms => do
    (match Nat.beq m.1 k with
     | .true => NetM.setWrites k m.2
     | .false => NetM.error "a memory in the state must be written, not replaced by another memory");
    NetM.memNexts (Nat.succ k) ms
/-- Inputs and outputs carry no memories. -/
def NetM.noMems (what : String) (t : HwTy) : NetM Unit := match HwTy.memShapes t with
  | .nil => NetM.pure ()
  | .cons _ _ => NetM.error (String.append "a memory in the " what)

/-- Build a circuit's step at wires: input nodes, register nodes, then the step. The ids of
the inputs, the registers, the next state and the outputs. -/
def Circuit.build {ω i o : HwTy} (c : Circuit i o) : NetM (List Nat × (List Nat × (List Nat × List Nat))) := do
  NetM.noMems "input" i;
  NetM.noMems "output" o;
  NetM.stateMems (HwTy.memNames "m" c.st) (HwTy.memShapes c.st) (HwTy.memContents c.st c.init);
  ins ← NetM.emitLeaves NetOp.input 0 (HwTy.leafWidths i);
  cur ← NetM.emitLeaves NetOp.reg 0 (HwTy.leafWidths c.st);
  res ← (Circuit.stepWire c (NetM.pure (HwTy.idsState c.st cur 0).1) (NetM.pure (HwTy.idsTake i ins).1) :
    NetM (HwTy.Ids c.st × HwTy.Ids o));
  NetM.memNexts 0 (HwTy.idsMems c.st res.1);
  NetM.pure (ins, (cur, (HwTy.idsLeaves c.st res.1, HwTy.idsLeaves o res.2)))

/-- The netlist of a circuit (hash-consed if `cse`), and the builder's final state (for
counting nodes and work). -/
def Circuit.netlistS {ω i o : HwTy} (cse : Bool) (name : String) (c : Circuit i o) : Netlist × NetS :=
  let ω r := Circuit.build c (NetS.init cse);
  let ω ids := r.1;
  let ω s := r.2;
  let ω nodes := Hdl.Vec.ofList (Hdl.reverse s.nodes);
  let ω regs := Net.regs nodes (HwTy.portNames "r" c.st) (HwTy.leafWidths c.st) (HwTy.leaves c.st c.init) ids.2.1 ids.2.2.1;
  (Net.finish name s regs ids.2.1
    (Net.ports (HwTy.portNames "x" i) (HwTy.leafWidths i) ids.1)
    (Net.ports (HwTy.portNames "y" o) (HwTy.leafWidths o) ids.2.2.2), s)

/-- The netlist of a circuit, named `name`: one port per leaf of the input (`x…`) and output
(`y…`), one register per leaf of the state (`r…`), names from `named` types.

```
Verilog.emit (Circuit.netlist "blink" blink)
``` -/
def Circuit.netlist {ω i o : HwTy} (name : String) (c : Circuit i o) : Netlist := (Circuit.netlistS .true name c).1
/-- The netlist without hash-consing (to measure what it saves). -/
def Circuit.netlistNaive {ω i o : HwTy} (name : String) (c : Circuit i o) : Netlist := (Circuit.netlistS .false name c).1

/-- Simulation by values, on leaves (one number per port per cycle). Compare with
`Circuit.simLeaves`. -/
def Circuit.runLeaves {ω i o : HwTy} (c : Circuit i o) (xs : List (HwTy.El i)) : List (List Nat) :=
  Hdl.map (HwTy.leaves o) (Circuit.run c xs)
/-- Simulation of the netlist, on leaves (one number per port per cycle). -/
def Circuit.simLeaves {ω i o : HwTy} (cse : Bool) (c : Circuit i o) (xs : List (HwTy.El i)) : List (List Nat) :=
  Netlist.simulate (Circuit.netlistS cse "c" c).1 (Hdl.map (HwTy.leaves i) xs)
/-- Simulation by values on bus encodings (one number per cycle in and out). -/
def Circuit.runPacked {ω i o : HwTy} (c : Circuit i o) (xs : List Nat) : List Nat :=
  Hdl.map (HwTy.pack o) (Circuit.run c (Hdl.map (HwTy.unpack i) xs))
/-- Simulation of the netlist on bus encodings; equal to `Circuit.runPacked` for a correct
synthesis. -/
def Circuit.simNet {ω i o : HwTy} (cse : Bool) (c : Circuit i o) (xs : List Nat) : List Nat :=
  Hdl.map (fun (ls : List Nat) => HwTy.pack o (HwTy.ofLeaves o ls)) (Circuit.simLeaves cse c (Hdl.map (HwTy.unpack i) xs))

------------------------------------------------------------------------------------
-- Verilog-2005: one port per leaf, one `reg` per register (with its reset and enable),
-- one `wire` per node that is neither a port, a register nor a constant. Names come
-- from the netlist (ports, registers, `Hw.label`), made into unique identifiers.

/-- The Verilog-2005 keywords (and `clk`, the clock port), which no identifier may be. -/
def Verilog.keywords : List String :=
  .cons "module" (.cons "endmodule" (.cons "input" (.cons "output" (.cons "inout" (.cons "wire" (.cons "reg"
  (.cons "assign" (.cons "always" (.cons "initial" (.cons "begin" (.cons "end" (.cons "if" (.cons "else"
  (.cons "posedge" (.cons "negedge" (.cons "integer" (.cons "parameter" (.cons "localparam" (.cons "case"
  (.cons "endcase" (.cons "default" (.cons "for" (.cons "while" (.cons "function" (.cons "endfunction"
  (.cons "task" (.cons "endtask" (.cons "generate" (.cons "endgenerate" (.cons "genvar" (.cons "signed"
  (.cons "unsigned" (.cons "and" (.cons "or" (.cons "not" (.cons "xor" (.cons "nand" (.cons "nor" (.cons "buf"
  (.cons "supply0" (.cons "supply1" (.cons "tri" (.cons "time" (.cons "real" (.cons "event" (.cons "clk"
  .nil))))))))))))))))))))))))))))))))))))))))))))))

/-- A character as it may appear in an identifier: letters, digits and `_` stay, anything
else becomes `_`. -/
def Verilog.identChar (c : Char) : Char :=
  let ω k := Char.code c;
  match Bool.or (Bool.or (Bool.and (Nat.le 48 k) (Nat.le k 57)) (Bool.and (Nat.le 65 k) (Nat.le k 90)))
      (Bool.or (Bool.and (Nat.le 97 k) (Nat.le k 122)) (Nat.beq k 95)) with
  | .true => c
  | .false => Char.mk 95
/-- `Verilog.identChar` on every character. -/
def Verilog.identChars : List Char → List Char
  | .nil => .nil
  | .cons c cs => .cons (Verilog.identChar c) (Verilog.identChars cs)
/-- Whether a string is in a list. -/
def Hdl.member (s : String) : List String → Bool
  | .nil => .false
  | .cons x xs => Bool.or (Hdl.strEq s x) (Hdl.member s xs)
/-- The SystemVerilog keywords too (yosys, Verilator and simulators in SV mode read the
output), which no identifier may be either. -/
def Verilog.svKeywords : List String :=
  .cons "bit" (.cons "byte" (.cons "logic" (.cons "int" (.cons "shortint" (.cons "longint" (.cons "string"
  (.cons "struct" (.cons "union" (.cons "enum" (.cons "typedef" (.cons "packed" (.cons "interface" (.cons "class"
  (.cons "program" (.cons "package" (.cons "import" (.cons "export" (.cons "final" (.cons "assert" (.cons "property"
  (.cons "sequence" (.cons "cover" (.cons "void" (.cons "return" (.cons "break" (.cons "continue" (.cons "do"
  (.cons "foreach" (.cons "automatic" (.cons "static" (.cons "const" (.cons "ref" (.cons "new" (.cons "null"
  (.cons "this" (.cons "super" (.cons "local" (.cons "virtual" (.cons "type" (.cons "priority" (.cons "unique"
  (.cons "wait" (.cons "fork" (.cons "join" (.cons "forever" (.cons "repeat" (.cons "always_ff" (.cons "always_comb"
  (.cons "always_latch" (.cons "assign" .nil))))))))))))))))))))))))))))))))))))))))))))))))))

/-- A legal identifier: other characters become `_`, a leading digit or an empty name gets
a `_` in front, a keyword one behind. `Verilog.ident "2 wire" = "_2_wire"`,
`Verilog.ident "reg" = "reg_"`. -/
def Verilog.ident (s : String) : String :=
  let ω cs := Verilog.identChars (match s with
    | .mk l => l);
  let ω body := match cs with
    | .nil => String.mk (.cons (Char.mk 95) .nil)
    | .cons c _ => (match Bool.and (Nat.le 48 (Char.code c)) (Nat.le (Char.code c) 57) with
      | .true => String.mk (.cons (Char.mk 95) cs)
      | .false => String.mk cs);
  match Bool.or (Hdl.member body Verilog.keywords) (Hdl.member body Verilog.svKeywords) with
  | .true => body <+> "_"
  | .false => body

/-- A string as a key of an `HTrie` (its character codes). -/
def Hdl.strKey (s : String) : List Nat := match s with
  | .mk cs => Hdl.map Char.code cs
/-- `s_2`, `s_3` … whichever is free first; and the names taken after. -/
def Verilog.freshFrom (used : Hdl.Set) (s : String) : Nat → Nat → String × Hdl.Set
  | .zero, k => (s <+> "_" <+> Hdl.show k, used)
  | .succ f, k => match HTrie.get (Hdl.strKey (s <+> "_" <+> Hdl.show k)) used with
    | .some _ => Verilog.freshFrom used s f (Nat.succ k)
    | .none => (s <+> "_" <+> Hdl.show k, HTrie.put (Hdl.strKey (s <+> "_" <+> Hdl.show k)) () used)
/-- A unique identifier for `raw`: `Verilog.ident raw`, or with `_2`, `_3` … if that is
taken; and the names taken after. -/
def Verilog.fresh (used : Hdl.Set) (raw : String) : String × Hdl.Set :=
  let ω s := Verilog.ident raw;
  match HTrie.get (Hdl.strKey s) used with
  | .some _ => Verilog.freshFrom used s 100000 2
  | .none => (s, HTrie.put (Hdl.strKey s) () used)
/-- `Verilog.fresh` for a list of names, in order. -/
def Verilog.freshAll : Hdl.Set → List String → List String × Hdl.Set
  | used, .nil => (.nil, used)
  | used, .cons s ss =>
    let ω a := Verilog.fresh used s;
    let ω b := Verilog.freshAll a.2 ss;
    (.cons a.1 b.1, b.2)
/-- The names taken from the start: `clk`. -/
def Verilog.reserved : Hdl.Set := HTrie.put (Hdl.strKey "clk") () HTrie.tip

/-- The names of a list of things. -/
def Hdl.names {A : Type} (f : A → String) (xs : List A) : List String := Hdl.map f xs

/-- The Verilog identifiers of the inputs, outputs and registers, in that order, and all
the names taken. -/
structure VNames where
  ins : List String
  outs : List String
  regs : List String
  mems : List String
  used : Hdl.Set

/-- Unique identifiers for a netlist's ports and registers (shared by `Verilog.emit`,
`Testbench.verilog` and `Pcf.emit`, so they agree). -/
def Verilog.portIdents (n : Netlist) : VNames :=
  let ω a := Verilog.freshAll Verilog.reserved (Hdl.names (fun (p : NetPort) => p.name) n.inputs);
  let ω b := Verilog.freshAll a.2 (Hdl.names (fun (p : NetPort) => p.name) n.outputs);
  let ω c := Verilog.freshAll b.2 (Hdl.names (fun (r : NetReg) => r.name) n.regs);
  let ω d := Verilog.freshAll c.2 (Hdl.names (fun (m : NetMem) => m.name) n.mems);
  VNames.mk a.1 b.1 c.1 d.1 d.2

/-- A sized decimal literal: `Verilog.lit 8 5 = "8'd5"` (width 0 is written `1'd0`). -/
def Verilog.lit (w v : Nat) : String := match w with
  | .zero => "1'd0"
  | .succ _ => Hdl.show w <+> "'d" <+> Hdl.show v
/-- The range of a bus, `[w-1:0] `. A zero-width bus has no Verilog range; it is declared
one bit wide and never read. -/
def Verilog.range (w : Nat) : String := match w with
  | .zero => "[0:0] "
  | .succ v => "[" <+> Hdl.show v <+> ":0] "

/-- How a node is referred to: a port or register by its name, a constant by its value,
anything of width 0 as `1'd0`, a labelled node by its label, others `nK`; and the
names taken after. -/
def Verilog.refOf (vn : VNames) (hints : HTrie String) (used : Hdl.Set) (k : Nat) (n : NetNode) : String × Hdl.Set :=
  match n.width with
  | .zero => ("1'd0", used)
  | .succ _ => match n.op with
    | .input p => (Hdl.nthD "?" vn.ins p, used)
    | .reg r => (Hdl.nthD "?" vn.regs r, used)
    | .const v => (Verilog.lit n.width v, used)
    | _ => match HTrie.getN k hints with
      | .some h => Verilog.fresh used h
      | .none => Verilog.fresh used ("n" <+> Hdl.show k)
/-- The references of all nodes, in order. -/
def Verilog.refs (vn : VNames) (hints : HTrie String) : Nat → List NetNode → Hdl.Set → Hdl.Vec String → Hdl.Vec String
  | _, .nil, _, acc => acc
  | k, .cons n ns, used, acc =>
    let ω r := Verilog.refOf vn hints used k n;
    Verilog.refs vn hints (Nat.succ k) ns r.2 (Hdl.Vec.push acc r.1)
/-- The wire names by node: the first label of each node wins. -/
def Verilog.hintMap : List (Nat × String) → HTrie String → HTrie String
  | .nil, m => m
  | .cons h hs, m => match HTrie.getN h.1 m with
    | .some _ => Verilog.hintMap hs m
    | .none => Verilog.hintMap hs (HTrie.putN h.1 h.2 m)

/-- What printing an expression needs: every node's reference and the nodes themselves. -/
structure VCtx where
  mems : List String
  names : Hdl.Vec String
  nodes : Hdl.Vec NetNode

/-- How node `k` is referred to. -/
def VCtx.ref (cx : VCtx) (k : Nat) : String := Hdl.Vec.get "?" cx.names k
/-- Node `k`. -/
def VCtx.node (cx : VCtx) (k : Nat) : NetNode := Hdl.Vec.get NetNode.none cx.nodes k
/-- A binary operator applied to the first two arguments: `a + b`. -/
def Verilog.bin (cx : VCtx) (o : String) : List Nat → String
  | .cons a (.cons b _) => VCtx.ref cx a <+> " " <+> o <+> " " <+> VCtx.ref cx b
  | _ => "?"
/-- A conditional of the three arguments: `c ? a : b`. -/
def Verilog.mux3 (cx : VCtx) : List Nat → String
  | .cons c (.cons a (.cons b _)) => VCtx.ref cx c <+> " ? " <+> VCtx.ref cx a <+> " : " <+> VCtx.ref cx b
  | _ => "?"
/-- A part select `a[hi:lo]` (only of a name: a constant is cut at once). -/
def Verilog.slice (cx : VCtx) (lo w a : Nat) : String :=
  let ω an := VCtx.node cx a;
  match an.op with
  | .const v => Verilog.lit w (Nat.wrap w (Nat.shiftRight v lo))
  | _ => VCtx.ref cx a <+> "[" <+> Hdl.show (lo + w - 1) <+> ":" <+> Hdl.show lo <+> "]"
/-- A concatenation `{a, b}` (a zero-width side left out). -/
def Verilog.concat (cx : VCtx) (a b : Nat) : String :=
  match (VCtx.node cx a).width, (VCtx.node cx b).width with
  | .zero, _ => VCtx.ref cx b
  | _, .zero => VCtx.ref cx a
  | _, _ => "{" <+> VCtx.ref cx a <+> ", " <+> VCtx.ref cx b <+> "}"
/-- The Verilog expression that computes a node. -/
def Verilog.expr (cx : VCtx) (n : NetNode) : String := match n.op with
  | .input p => "?"
  | .const v => Verilog.lit n.width v
  | .reg r => "?"
  | .add => Verilog.bin cx "+" n.args
  | .sub => Verilog.bin cx "-" n.args
  | .mul => Verilog.bin cx "*" n.args
  | .and => Verilog.bin cx "&" n.args
  | .or => Verilog.bin cx "|" n.args
  | .xor => Verilog.bin cx "^" n.args
  | .not => (match n.args with
    | .cons a _ => "~" <+> VCtx.ref cx a
    | _ => "?")
  | .eq => Verilog.bin cx "==" n.args
  | .ult => Verilog.bin cx "<" n.args
  | .shl => Verilog.bin cx "<<" n.args
  | .lshr => Verilog.bin cx ">>" n.args
  | .ashr => (match n.args with
    | .cons a (.cons s _) => "$signed(" <+> VCtx.ref cx a <+> ") >>> " <+> VCtx.ref cx s
    | _ => "?")
  | .slt => (match n.args with
    | .cons a (.cons b _) => "$signed(" <+> VCtx.ref cx a <+> ") < $signed(" <+> VCtx.ref cx b <+> ")"
    | _ => "?")
  | .concat => (match n.args with
    | .cons a (.cons b _) => Verilog.concat cx a b
    | _ => "?")
  | .slice lo => (match n.args with
    | .cons a _ => Verilog.slice cx lo n.width a
    | _ => "?")
  | .mux => Verilog.mux3 cx n.args
  | .resetTo v => (match n.args with
    | .cons c (.cons a _) => VCtx.ref cx c <+> " ? " <+> Verilog.lit n.width v <+> " : " <+> VCtx.ref cx a
    | _ => "?")
  | .hold => Verilog.mux3 cx n.args
  | .memRead m => (match n.args with
    | .cons a _ => Hdl.nthD "?" cx.mems m <+> "[" <+> VCtx.ref cx a <+> "]"
    | _ => "?")

/-- Whether a node gets a `wire` of its own: not ports, registers, constants or zero-width
nodes. -/
def Verilog.declared (n : NetNode) : Bool := match n.width with
  | .zero => .false
  | .succ _ => match n.op with
    | .input _ => .false
    | .reg _ => .false
    | .const _ => .false
    | _ => .true
/-- The `wire` declarations with their expressions, from node `k` on. -/
def Verilog.wires (cx : VCtx) : Nat → List NetNode → String
  | _, .nil => ""
  | k, .cons n ns => (match Verilog.declared n with
    | .true => "  wire " <+> Verilog.range n.width <+> VCtx.ref cx k <+> " = " <+> Verilog.expr cx n <+> ";\n"
    | .false => "") <+> Verilog.wires cx (Nat.succ k) ns
/-- The registers' declarations with their initial values (sized). Their updates come after
the wires (Verilog wants a name declared before its use): `Verilog.updates`. -/
def Verilog.regDecls : List String → List NetReg → String
  | .cons nm nms, .cons r rs => (match r.width with
    | .zero => ""
    | .succ _ => "  reg " <+> Verilog.range r.width <+> nm <+> "; initial " <+> nm <+> " = " <+> Verilog.lit r.width r.init <+> ";\n")
    <+> Verilog.regDecls nms rs
  | _, _ => ""
/-- A register's update statement, with its reset and enable:
`if (rst) r <= 8'd0; else if (en) r <= n3;`. -/
def Verilog.load (cx : VCtx) (nm : String) (r : NetReg) : String :=
  let ω plain := nm <+> " <= " <+> VCtx.ref cx r.next <+> ";";
  let ω enabled := match r.en with
    | .none => plain
    | .some e => "if (" <+> VCtx.ref cx e <+> ") " <+> plain;
  match r.rst with
  | .none => enabled
  | .some k => "if (" <+> VCtx.ref cx k <+> ") " <+> nm <+> " <= " <+> Verilog.lit r.width r.init <+> "; else " <+> enabled
/-- An `always @(posedge clk)` per register. -/
def Verilog.updates (cx : VCtx) : List String → List NetReg → String
  | .cons nm nms, .cons r rs => (match r.width with
    | .zero => ""
    | .succ _ => "  always @(posedge clk) " <+> Verilog.load cx nm r <+> "\n") <+> Verilog.updates cx nms rs
  | _, _ => ""
-- A memory: an array with its contents, then (after the wires) its writes in one block,
-- in order, so that a later write wins. yosys infers block RAM (iCE40: SB_RAM40_4K) when a
-- read's address or data goes through a register.
/-- A memory's initial contents: `nm[k] = value;` for each word. -/
def Verilog.memInit (nm : String) (dw : Nat) : Nat → List Nat → String
  | _, .nil => ""
  | k, .cons w ws => "    " <+> nm <+> "[" <+> Hdl.show k <+> "] = " <+> Verilog.lit dw w <+> ";\n" <+> Verilog.memInit nm dw (Nat.succ k) ws
/-- A memory's declaration: an array with its initial contents. -/
def Verilog.memDecls : List String → List NetMem → String
  | .cons nm nms, .cons m ms => (match m.dw with
    | .zero => ""
    | .succ _ => "  reg " <+> Verilog.range m.dw <+> nm <+> " [0:" <+> Hdl.show (Nat.pow 2 m.aw - 1) <+> "];\n"
      <+> "  initial begin\n" <+> Verilog.memInit nm m.dw 0 m.init <+> "  end\n")
    <+> Verilog.memDecls nms ms
  | _, _ => ""
/-- The writes of a memory in one `always` block. -/
def Verilog.memWrites (cx : VCtx) (nm : String) : List (Nat × (Nat × Nat)) → String
  | .nil => ""
  | .cons w ws => "    if (" <+> VCtx.ref cx w.1 <+> ") " <+> nm <+> "[" <+> VCtx.ref cx w.2.1 <+> "] <= " <+> VCtx.ref cx w.2.2 <+> ";\n"
    <+> Verilog.memWrites cx nm ws
/-- The `always @(posedge clk)` block of each memory that is written. -/
def Verilog.memUpdates (cx : VCtx) : List String → List NetMem → String
  | .cons nm nms, .cons m ms => (match m.writes, m.dw with
    | .nil, _ => ""
    | _, .zero => ""
    | _, .succ _ => "  always @(posedge clk) begin\n" <+> Verilog.memWrites cx nm m.writes <+> "  end\n")
    <+> Verilog.memUpdates cx nms ms
  | _, _ => ""
/-- What the netlist could not express, as Verilog comments. -/
def Verilog.errors : List String → String
  | .nil => ""
  | .cons e es => "  // error: " <+> e <+> "\n" <+> Verilog.errors es

/-- The port declarations of one direction (`, input [7:0] x`). -/
def Verilog.portDecls (dir : String) : List String → List NetPort → String
  | .cons nm nms, .cons p ps => (match p.width with
    | .zero => ""
    | .succ _ => ", " <+> dir <+> " " <+> Verilog.range p.width <+> nm) <+> Verilog.portDecls dir nms ps
  | _, _ => ""
/-- The `assign` of every output port. -/
def Verilog.assigns (cx : VCtx) : List String → List NetPort → String
  | .cons nm nms, .cons p ps => (match p.width with
    | .zero => ""
    | .succ _ => "  assign " <+> nm <+> " = " <+> VCtx.ref cx p.node <+> ";\n") <+> Verilog.assigns cx nms ps
  | _, _ => ""

/-- The printing context of a netlist. -/
def Verilog.ctx (n : Netlist) (vn : VNames) : VCtx :=
  VCtx.mk vn.mems (Verilog.refs vn (Verilog.hintMap n.hints HTrie.tip) 0 n.nodes vn.used Hdl.Vec.empty) (Hdl.Vec.ofList n.nodes)

/-- A netlist as a Verilog-2005 module: one port per leaf (and `clk`), one `reg` per
register (with its reset and enable), one `wire` per node that is neither a port, a
register nor a constant. Names come from the netlist (ports, registers, `Hw.label`),
made into unique identifiers.

```
IO.writeFile "blink.v" (Verilog.emit (Circuit.netlist "blink" blink))
``` -/
def Verilog.emit (n : Netlist) : String :=
  let ω vn := Verilog.portIdents n;
  let ω cx := Verilog.ctx n vn;
  "module " <+> Verilog.ident n.name <+> "(input clk" <+> Verilog.portDecls "input" vn.ins n.inputs
  <+> Verilog.portDecls "output" vn.outs n.outputs <+> ");\n" <+> Verilog.errors n.errors <+> Verilog.regDecls vn.regs n.regs
  <+> Verilog.memDecls vn.mems n.mems
  <+> Verilog.wires cx 0 n.nodes <+> Verilog.updates cx vn.regs n.regs <+> Verilog.memUpdates cx vn.mems n.mems
  <+> Verilog.assigns cx vn.outs n.outputs <+> "endmodule\n"

------------------------------------------------------------------------------------
-- Bundles: structures of signals. A bundle is a structure parameterised by the
-- representation, `structure Tx (r : HwTy → Type) where line : r Bit; …`, so that
-- `s.line` is field access; `Bundle F` gives its code (a product of `named` fields) and
-- the conversions. `deriving Bundle` writes the instance. Values: `Tx HwTy.El`.

/-- A bundle: a structure of signals, parameterised by the representation
(`structure Tx (r : HwTy → Type) where line : r Bit; …`), so that `s.line` is field
access. `code` is its hardware type (a product of `named` fields), `pack` and `unpack`
convert. `deriving Bundle` writes it as `Tx.bundle`; values are `Tx HwTy.El`.

A bundle is a plain value, not an instance: structures are structural types, so two
structures with the same field types are one type and instance resolution could not
tell their bundles apart. -/
structure Bundle (F : (HwTy → Type) → Type) where
  code : HwTy
  pack : {r : HwTy → Type} → [Hw r] → F r → r code
  unpack : {r : HwTy → Type} → [Hw r] → r code → F r

-- (A bundle is a plain value, not an instance: structures are structural types, so two
-- structures with the same field types are one type, and instance resolution could not
-- tell their bundles apart. `deriving Bundle` names it `S.bundle`. It can become an
-- instance once declared types get kernel-level brands.)

/-- A bundle value as a value of its code. -/
def Bundle.toEl {F : (HwTy → Type) → Type} (b : Bundle F) (v : F HwTy.El) : HwTy.El b.code :=
  b.pack v
/-- A value of a bundle's code as the bundle's structure. -/
def Bundle.ofEl {F : (HwTy → Type) → Type} (b : Bundle F) (v : HwTy.El b.code) : F HwTy.El :=
  b.unpack v

/-- A circuit whose state, input and output are bundles: the step takes the state and the
input as structures and returns the packed next state and output
(`Hw.pair (S.pack s') (O.pack o)`). -/
def Circuit.bundled {S I O : (HwTy → Type) → Type} (bs : Bundle S) (bi : Bundle I) (bo : Bundle O)
    (init : S HwTy.El) (f : {r : HwTy → Type} → [Hw r] → S r → I r → r (HwTy.prod bs.code bo.code)) : Circuit bi.code bo.code :=
  Circuit.mk bs.code (bs.pack init) (fun s x => f (bs.unpack s) (bi.unpack x))

------------------------------------------------------------------------------------
-- `deriving Bundle` for a structure `S Δ (r : HwTy → Type)` (the representation is the
-- last parameter) whose fields are leaves `r T` or nested bundles `G … r` (which must
-- have been derived too: their code is `G.code …`). It defines
--   `S.code Δ : HwTy`                     the product of `named "field" T` (its tails
--                                         named `S.code.tail1 Δ`, …: see `HdlDerive.code`)
--   `S.pack Δ : S Δ r → r (S.code Δ)`     and `S.unpack Δ`
--   `S.bundle Δ : Bundle (S Δ)`
-- (the parameters Δ explicit).

/-- A syntax list as a `List`. -/
def HdlDerive.list : SyntaxF .false → List Syntax
  | .nil => .nil
  | .cons x xs => .cons x (HdlDerive.list xs)
/-- A list without its last element. -/
def HdlDerive.init {A : Type} : List A → List A
  | .nil => .nil
  | .cons _ .nil => .nil
  | .cons x xs => .cons x (HdlDerive.init xs)
/-- The last element of a list of syntax (`.missing` for none). -/
def HdlDerive.last : List Syntax → Syntax
  | .nil => .missing
  | .cons x .nil => x
  | .cons _ xs => HdlDerive.last xs
/-- The name of the last parameter (the representation `r`). -/
def HdlDerive.lastName : List ParamView → String
  | .nil => "r"
  | .cons p .nil => ParamView.name p
  | .cons _ ps => HdlDerive.lastName ps
/-- Syntax without one level of parentheses. -/
def HdlDerive.unparen (t : Syntax) : Syntax := match t with
  | .node k args => (match String.beq k "term.paren" with
    | .true => SyntaxF.nth args 1
    | .false => t)
  | _ => t
/-- A field type `h a₁ … aₖ` split into (`h a₁ … aₖ₋₁`, `aₖ`): the bundle or representation
and what it is applied to. -/
def HdlDerive.split (t : Syntax) : Syntax × Syntax := match HdlDerive.unparen t with
  | .node k args => (match String.beq k "term.app" with
    | .true =>
      let ω xs := HdlDerive.list (match Syntax.getArg (.node k args) 1 with
        | .node _ l => l
        | _ => SyntaxF.nil);
      (Syntax.mkApp (SyntaxF.nth args 0) (HdlDerive.init xs), HdlDerive.last xs)
    | .false => (.missing, .missing))
  | _ => (.missing, .missing)
/-- Whether syntax is the variable `r`. -/
def HdlDerive.isVar (r : String) (t : Syntax) : Bool := match HdlDerive.unparen t with
  | .node k args => Bool.and (String.beq k "term.ident") (match SyntaxF.nth args 0 with
    | .ident x => String.beq x r
    | _ => .false)
  | _ => .false

/-- `G` ↦ `G.suffix`, for an identifier. -/
def HdlDerive.identSuffixed (suffix : String) (t : Syntax) : Syntax := match HdlDerive.unparen t with
  | .node k args => (match String.beq k "term.ident" with
    | .true => (match SyntaxF.nth args 0 with
      | .ident x => Syntax.mkVar (String.append x suffix)
      | _ => t)
    | .false => t)
  | _ => t
/-- `G a₁ … aₖ` ↦ `G.suffix a₁ … aₖ` (a nested bundle's `code`, `pack`, `unpack`). -/
def HdlDerive.suffixed (suffix : String) (t : Syntax) : Syntax := match HdlDerive.unparen t with
  | .node k args => (match String.beq k "term.app" with
    | .true => Syntax.mkApp (HdlDerive.identSuffixed suffix (SyntaxF.nth args 0))
        (HdlDerive.list (match Syntax.getArg (.node k args) 1 with
          | .node _ l => l
          | _ => SyntaxF.nil))
    | .false => HdlDerive.identSuffixed suffix t)
  | _ => t

/-- One field's code: `HwTy.named "f" T` for a leaf `r T`, `HwTy.named "f" (G.code …)` for
a nested bundle. -/
def HdlDerive.fieldCode (r : String) (f : FieldView) : Syntax :=
  let ω sp := HdlDerive.split (FieldView.type f);
  let ω nm := Syntax.mkStr (FieldView.name f);
  match HdlDerive.isVar r sp.1 with
  | .true => let t := sp.2; `(term| HwTy.named $nm $t)
  | .false => let g := HdlDerive.suffixed ".code" sp.1; `(term| HwTy.named $nm $g)
/-- How one field is packed, from `s.f`. -/
def HdlDerive.fieldPack (r : String) (s : Syntax) (f : FieldView) : Syntax :=
  let ω sp := HdlDerive.split (FieldView.type f);
  let ω nm := Syntax.mkStr (FieldView.name f);
  let ω x := Derive.proj s (FieldView.name f);
  match HdlDerive.isVar r sp.1 with
  | .true => `(term| Hw.tag $nm $x)
  | .false => let g := HdlDerive.suffixed ".pack" sp.1; `(term| Hw.tag $nm ($g $x))
/-- How one field is unpacked, from `x`. -/
def HdlDerive.fieldUnpack (r : String) (x : Syntax) (f : FieldView) : Syntax :=
  let ω sp := HdlDerive.split (FieldView.type f);
  match HdlDerive.isVar r sp.1 with
  | .true => `(term| Hw.untag $x)
  | .false => let g := HdlDerive.suffixed ".unpack" sp.1; `(term| $g (Hw.untag $x))

-- Unpacking `x✝0 : r (S.code Δ)` walks down the product once: the tails are bound in a
-- chain `let ω x✝1 := Hw.snd x✝0; …; let ω x✝(n-1) := Hw.snd x✝(n-2)`, and field i is
-- `Hw.fst x✝i` (the last one `x✝(n-1)` itself). So `S.unpack` is linear in the number of
-- fields (`Hw.snd` applied i times for field i was quadratic, and slow to elaborate and
-- compile for wide bundles). `ω`: a plain let, not auto-shared (the body is a structure).
/-- The `i`-th tail of the product the fields are unpacked from (the variable `x✝i`). -/
def HdlDerive.tail (i : Nat) : Syntax := Derive.var "x✝" i
-- the fields, as arguments of the constructor
/-- The fields of `x`, unpacked, as arguments of the constructor. -/
def HdlDerive.unpackArgs (r : String) : Nat → List FieldView → List Syntax
  | i, .nil => .nil
  | i, .cons f .nil => .cons (HdlDerive.fieldUnpack r (HdlDerive.tail i) f) .nil
  | i, .cons f fs => .cons (HdlDerive.fieldUnpack r (Syntax.mkApp (Syntax.mkVar "Hw.fst") (.cons (HdlDerive.tail i) .nil)) f)
    (HdlDerive.unpackArgs r (Nat.succ i) fs)
-- the chain of tails around `b`
/-- The chain of `let ω x✝(i+1) := Hw.snd x✝i;` bindings around `b`. -/
def HdlDerive.unpackLets : Nat → List FieldView → Syntax → Syntax
  | i, .nil, b => b
  | i, .cons _ fs, b => match fs with
    | .nil => b
    | .cons _ _ =>
      let y := Syntax.mkIdent (Derive.name "x✝" (Nat.succ i));
      let x := HdlDerive.tail i;
      let rest := HdlDerive.unpackLets (Nat.succ i) fs b;
      `(term| let ω $y := Hw.snd $x; $rest)

/-- `(x : T) → …` for each parameter. -/
def HdlDerive.explicitPis : List ParamView → Syntax → Syntax
  | .nil, rest => rest
  | .cons p ps', rest =>
    let x := Syntax.mkIdent (ParamView.name p);
    let t := ParamView.type p;
    let b := HdlDerive.explicitPis ps' rest;
    `(term| ($x : $t) → $b)
/-- `fun x => …` for each parameter. -/
def HdlDerive.lams : List ParamView → Syntax → Syntax
  | .nil, rest => rest
  | .cons p ps', rest =>
    let x := Syntax.mkIdent (ParamView.name p);
    let b := HdlDerive.lams ps' rest;
    `(term| fun $x => $b)
/-- `{ω x : T} → …` for each parameter. -/
def HdlDerive.implicitPis : List ParamView → Syntax → Syntax
  | .nil, rest => rest
  | .cons p ps', rest =>
    let x := Syntax.mkIdent (ParamView.name p);
    let t := ParamView.type p;
    let b := HdlDerive.implicitPis ps' rest;
    `(term| {ω $x : $t} → $b)

-- The code is a chain of definitions, one for each tail of the fields:
--   `S.code Δ := HwTy.prod (named "f₀" T₀) (S.code.tail1 Δ)`, …, `S.code.tailₙ₋₁ Δ := named "fₙ₋₁" Tₙ₋₁`.
-- Unfolding `S.code.tailᵢ Δ` once gives the next name, so the `Hw.pair`s of `pack` and the
-- `Hw.snd`s of `unpack` get codes of constant size for their implicit arguments (a
-- literal product would put the whole rest of the code there, at each step: quadratic
-- code, and the codes are built at run time, `{ω a b : HwTy}`).
/-- The name of the `i`-th tail: `S.code` for 0, `S.code.tailᵢ` after. -/
def HdlDerive.tailName (n : String) (i : Nat) : String := match i with
  | .zero => String.append n ".code"
  | .succ _ => Derive.name (String.append n ".code.tail") i
-- the definitions of the tails from the `i`-th on, the last first
/-- The definitions of the code's tails from the `i`-th on, the last first. -/
def HdlDerive.codeDefs (n r : String) (ps : List ParamView) (delta : List Syntax) : Nat → List FieldView → List Syntax
  | i, .nil => .nil
  | i, .cons f fs =>
    let nm := Syntax.mkIdent (HdlDerive.tailName n i);
    let ty := HdlDerive.explicitPis ps `(term| HwTy);
    let a := HdlDerive.fieldCode r f;
    match fs with
    | .nil => let val := HdlDerive.lams ps a; .cons `(command| def $nm : $ty := $val) .nil
    | .cons _ _ =>
      let b := Syntax.mkApp (Syntax.mkVar (HdlDerive.tailName n (Nat.succ i))) delta;
      let val := HdlDerive.lams ps `(term| HwTy.prod $a $b);
      List.append (HdlDerive.codeDefs n r ps delta (Nat.succ i) fs) (.cons `(command| def $nm : $ty := $val) .nil)
-- (no fields: `S.code Δ := HwTy.bits 0`)
/-- The code of a structure: the product of its fields' codes (a chain of tail definitions;
no fields is `HwTy.bits 0`). -/
def HdlDerive.code (n r : String) (ps : List ParamView) (delta : List Syntax) (fs : List FieldView) : List Syntax :=
  match fs with
  | .nil =>
    let nm := Syntax.mkIdent (HdlDerive.tailName n 0);
    let ty := HdlDerive.explicitPis ps `(term| HwTy);
    let val := HdlDerive.lams ps `(term| HwTy.bits 0);
    .cons `(command| def $nm : $ty := $val) .nil
  | .cons _ _ => HdlDerive.codeDefs n r ps delta 0 fs

-- `pack`: `Hw.pair f₀ (Hw.pair f₁ … : r (S.code.tail1 Δ))`, each rest ascribed its tail's
-- name, so that the `Hw.pair`s' codes are names too (inferred from the parts, they would
-- be the literal products)
/-- Packing a structure: the pair of its fields, packed. -/
def HdlDerive.pack (n r : String) (delta : List Syntax) (s : Syntax) : Nat → List FieldView → Syntax
  | i, .nil => `(term| Hw.lit 0 0)
  | i, .cons f fs => match fs with
    | .nil => HdlDerive.fieldPack r s f
    | .cons _ _ =>
      let a := HdlDerive.fieldPack r s f;
      let b := HdlDerive.pack n r delta s (Nat.succ i) fs;
      let rv := Syntax.mkVar r;
      let t := Syntax.mkApp (Syntax.mkVar (HdlDerive.tailName n (Nat.succ i))) delta;
      `(term| Hw.pair $a ($b : $rv $t))

/-- `deriving Bundle` for a structure `S Δ (r : HwTy → Type)` (the representation is the
last parameter) whose fields are leaves `r T` or nested bundles `G … r` (which must
have been derived too). It defines, with the parameters Δ explicit,

* `S.code Δ : HwTy`, the product of `named "field" T`;
* `S.pack Δ : S Δ r → r (S.code Δ)` and `S.unpack Δ`;
* `S.bundle Δ : Bundle (S Δ)`.

```
structure Tx (r : HwTy → Type) where
  line : r HwTy.bit
  busy : r HwTy.bit
  deriving Bundle
``` -/
def deriveBundle : Deriver := fun n => do
  v ← Derive.lookup "Bundle" n;
  Derive.noIndices "Bundle" v;
  match IndView.ctors v with
  | .cons c .nil => do
    let ps := HdlDerive.init (IndView.params v);
    let delta := Derive.paramVars ps;
    let r := HdlDerive.lastName (IndView.params v);
    let rid := Syntax.mkIdent r;
    let rv := Syntax.mkVar r;
    let fs := CtorView.fields c;
    let tyF := Syntax.mkApp (Syntax.mkVar n) delta;
    let tyS := Syntax.mkApp tyF (.cons rv .nil);
    let packN := Syntax.mkIdent (String.append n ".pack");
    let unpackN := Syntax.mkIdent (String.append n ".unpack");
    let codeApp := Syntax.mkApp (Syntax.mkVar (String.append n ".code")) delta;
    let packApp := Syntax.mkApp (Syntax.mkVar (String.append n ".pack")) delta;
    let unpackApp := Syntax.mkApp (Syntax.mkVar (String.append n ".unpack")) delta;
    let s := Syntax.mkIdent "s✝";
    let sv := Syntax.mkVar "s✝";
    let x := Syntax.mkIdent "x✝";
    let xv := Syntax.mkVar "x✝";
    let packTy := HdlDerive.explicitPis ps `(term| {$rid : HwTy → Type} → [Hw $rv] → $tyS → $rv $codeApp);
    let packBody := HdlDerive.pack n r delta sv 0 fs;
    let packVal := HdlDerive.lams ps `(term| fun $s => $packBody);
    let unpackTy := HdlDerive.explicitPis ps `(term| {$rid : HwTy → Type} → [Hw $rv] → $rv $codeApp → $tyS);
    let mk := Syntax.mkApp (Syntax.mkVar (Derive.ctorName v c)) (HdlDerive.unpackArgs r 0 fs);
    let x0 := Syntax.mkIdent (Derive.name "x✝" 0);
    let unpackBody := HdlDerive.unpackLets 0 fs mk;
    let unpackVal := HdlDerive.lams ps `(term| fun $x0 => $unpackBody);
    let bundleN := Syntax.mkIdent (String.append n ".bundle");
    let bundleTy := HdlDerive.explicitPis ps `(term| Bundle $tyF);
    let bundleVal := HdlDerive.lams ps `(term| Bundle.mk $codeApp (fun $s => $packApp $sv) (fun $x => $unpackApp $xv));
    MacroM.pure (List.append (HdlDerive.code n r ps delta fs)
      (.cons `(command| def $packN : $packTy := $packVal)
      (.cons `(command| def $unpackN : $unpackTy := $unpackVal)
      (.cons `(command| def $bundleN : $bundleTy := $bundleVal) .nil))))
  | _ => MacroM.throw (String.append "Bundle: not a structure: " n)
attribute [deriver Bundle] deriveBundle

------------------------------------------------------------------------------------
-- (H14 S4) Bit packing: a value as one bit vector.
--
-- `Hw.packBits t x` is any code's signal as one bus (the first component in the high
-- bits, as `HwTy.pack`), `Hw.unpackBits t` takes it apart again: wiring only
-- (concatenations and slices), at any representation.

/-- A value as one bit vector (the first component in the high bits, as `HwTy.pack`). -/
def Hw.packBits {r : HwTy → Type} [Hw r] : (ω t : HwTy) → r t → r (HwTy.bits (HwTy.width t))
  | .bits n, x => x
  | .prod a b, x => Hw.share x (fun y => Hw.cat (Hw.packBits a (Hw.fst y)) (Hw.packBits b (Hw.snd y)))
  | .named _ t, x => Hw.packBits t (Hw.untag x)
  | .mem _ _, x => Hw.const (HwTy.bits 0) (BitVec.ofNat 0 0)
/-- Take a packed bit vector apart again (concatenations and slices only). -/
def Hw.unpackBits {r : HwTy → Type} [Hw r] : (ω t : HwTy) → r (HwTy.bits (HwTy.width t)) → r t
  | .bits n, x => x
  | .prod a b, x => Hw.share x (fun y =>
    Hw.pair (Hw.unpackBits a (Hw.slice (HwTy.width b) (HwTy.width a) y)) (Hw.unpackBits b (Hw.slice 0 (HwTy.width b) y)))
  | .named s t, x => Hw.tag s (Hw.unpackBits t x)
  | .mem aw dw, x => Hw.const (HwTy.mem aw dw) (fun (a : BitVec aw) => BitVec.ofNat dw 0)

/-- at values -/
def HwTy.El.packBits (ω t : HwTy) (x : HwTy.El t) : BitVec (HwTy.width t) := Hw.packBits (r := HwTy.El) t x
/-- At values: `Hw.unpackBits`. -/
def HwTy.El.unpackBits (ω t : HwTy) (x : BitVec (HwTy.width t)) : HwTy.El t := Hw.unpackBits (r := HwTy.El) t x

/-- A type's values as bit vectors of one width (Clash's `BitPack`). A plain value, not an
instance, for the reason `Bundle` is one. `deriving BitPack` makes `T.bitPack`. -/
structure BitPack (A : Type) where
  width : Nat
  pack : A → BitVec width
  unpack : BitVec width → A

/-- the number of bits for `k` values: the least `w` with `k ≤ 2^w` -/
def Hdl.clog2Go : Nat → Nat → Nat → Nat
  | .zero, w, _ => w
  | .succ f, w, k => match Nat.lt (Nat.pow 2 w) k with
    | .true => Hdl.clog2Go f (Nat.succ w) k
    | .false => w
/-- The number of bits needed for `k` values: the least `w` with `k ≤ 2^w`. -/
def Hdl.clog2 (k : Nat) : Nat := Hdl.clog2Go k 0 k

/-- `deriving BitPack`:
* for an enumeration `T` (no parameters, constructors without fields), constructor
`i` is the number `i`, in `w = ⌈log₂ #constructors⌉` bits:
`T.width : Nat`, `T.code : HwTy` (= `HwTy.bits T.width`),
`T.toNat`, `T.ofNat` (a number out of range is the first constructor),
`T.pack : T → HwTy.El T.code`, `T.unpack`, `T.unpack_pack : T.unpack (T.pack x) = x`,
`T.lit x : r T.code` (the constant, at any representation), `T.bitPack`;
* for a bundle `S Δ r` (a structure whose last parameter is the representation; its
`deriving Bundle` is made too if it is not there yet), the bundle as one bus:
`S.width Δ`, `S.toBits Δ : S Δ r → r (HwTy.bits (S.width Δ))`, `S.ofBits Δ`,
`S.unpack_pack Δ : S.unpack Δ (S.pack Δ s) = s` (at values), and
`S.bitPack Δ : BitPack (S Δ HwTy.El)`. -/
def HdlDerive.num (k : Nat) : Syntax := Syntax.mkNode "term.num" (.cons (Syntax.mkNode "num" (.cons (.atom (Syntax.decimal k)) .nil)) .nil)
/-- The constructor names of an inductive type, as variables. -/
def HdlDerive.ctorVars (v : IndView) : List CtorView → List Syntax
  | .nil => .nil
  | .cons c cs => .cons (Syntax.mkVar (Derive.ctorName v c)) (HdlDerive.ctorVars v cs)
/-- The syntax of a list literal of these terms. -/
def HdlDerive.listOf : List Syntax → Syntax
  | .nil => Syntax.mkVar "List.nil"
  | .cons x xs => Syntax.mkApp (Syntax.mkVar "List.cons") (.cons x (.cons (HdlDerive.listOf xs) .nil))
/-- `0, 1, …` up to the number of constructors. -/
def HdlDerive.nums : Nat → List CtorView → List Syntax
  | _, .nil => .nil
  | i, .cons _ cs => .cons (HdlDerive.num i) (HdlDerive.nums (Nat.succ i) cs)
/-- `refl c` for each term (the equations of an enumeration's laws). -/
def HdlDerive.refls : List Syntax → List Syntax
  | .nil => .nil
  | .cons c cs => .cons `(term| refl $c) (HdlDerive.refls cs)
/-- Whether every constructor has no fields (an enumeration). -/
def HdlDerive.allNullary : List CtorView → Bool
  | .nil => .true
  | .cons c cs => match CtorView.fields c with
    | .nil => HdlDerive.allNullary cs
    | _ => .false

/-- `deriving BitPack` for an enumeration: a number per constructor. -/
def HdlDerive.enumPack (v : IndView) (n : String) : MacroM (List Syntax) :=
  let cs := IndView.ctors v;
  let w := HdlDerive.num (Hdl.clog2 (List.length cs));
  let tyT := Syntax.mkVar n;
  let wN := Syntax.mkIdent (String.append n ".width");
  let wV := Syntax.mkVar (String.append n ".width");
  let codeN := Syntax.mkIdent (String.append n ".code");
  let codeV := Syntax.mkVar (String.append n ".code");
  let toNatN := Syntax.mkIdent (String.append n ".toNat");
  let toNatV := Syntax.mkVar (String.append n ".toNat");
  let ofNatN := Syntax.mkIdent (String.append n ".ofNat");
  let ofNatV := Syntax.mkVar (String.append n ".ofNat");
  let packN := Syntax.mkIdent (String.append n ".pack");
  let packV := Syntax.mkVar (String.append n ".pack");
  let unpackN := Syntax.mkIdent (String.append n ".unpack");
  let unpackV := Syntax.mkVar (String.append n ".unpack");
  let litN := Syntax.mkIdent (String.append n ".lit");
  let lawN := Syntax.mkIdent (String.append n ".unpack_pack");
  let lawV := Syntax.mkVar (String.append n ".unpack_pack");
  let bpN := Syntax.mkIdent (String.append n ".bitPack");
  let x := Syntax.mkIdent "x✝";
  let xv := Syntax.mkVar "x✝";
  let k := Syntax.mkIdent "k✝";
  let kv := Syntax.mkVar "k✝";
  let r := Syntax.mkIdent "r";
  let rv := Syntax.mkVar "r";
  let ctors := HdlDerive.ctorVars v cs;
  let first := (match ctors with
    | .cons c _ => c
    | .nil => Syntax.mkVar "x✝");
  let toNatBody := Syntax.mkApp (Syntax.mkVar (String.append n ".rec"))
    (.cons `(term| fun _ => Nat) (List.append (HdlDerive.nums 0 cs) (.cons xv .nil)));
  let ofNatBody := Syntax.mkApp (Syntax.mkVar "Hdl.nthD") (.cons first (.cons (HdlDerive.listOf ctors) (.cons kv .nil)));
  let motive := `(term| fun $x => $unpackV ($packV $xv) = $xv);
  let lawBody := Syntax.mkApp (Syntax.mkVar (String.append n ".rec"))
    (.cons motive (List.append (HdlDerive.refls ctors) (.cons xv .nil)));
  MacroM.pure (.cons `(command| def $wN : Nat := $w)
    (.cons `(command| def $codeN : HwTy := HwTy.bits $wV)
    (.cons `(command| def $toNatN ($x : $tyT) : Nat := $toNatBody)
    (.cons `(command| def $ofNatN ($k : Nat) : $tyT := $ofNatBody)
    (.cons `(command| def $packN ($x : $tyT) : HwTy.El $codeV := BitVec.ofNat $wV ($toNatV $xv))
    (.cons `(command| def $unpackN ($x : HwTy.El $codeV) : $tyT := $ofNatV (BitVec.toNat ($xv : BitVec $wV)))
    (.cons `(command| def $litN {$r : HwTy → Type} [Hw $rv] ($x : $tyT) : $rv $codeV := Hw.lit $wV ($toNatV $xv))
    (.cons `(command| def $lawN ($x : $tyT) : $unpackV ($packV $xv) = $xv := $lawBody)
    (.cons `(command| def $bpN : BitPack $tyT := BitPack.mk $wV $packV $unpackV) .nil)))))))))

/-- `deriving BitPack` for a structure: its bundle's packed code. -/
def HdlDerive.bundlePack (v : IndView) (n : String) (pre : List Syntax) : MacroM (List Syntax) :=
  let ps := HdlDerive.init (IndView.params v);
  let delta := Derive.paramVars ps;
  let tyF := Syntax.mkApp (Syntax.mkVar n) delta;
  let r := Syntax.mkIdent (HdlDerive.lastName (IndView.params v));
  let rv := Syntax.mkVar (HdlDerive.lastName (IndView.params v));
  let tyS := Syntax.mkApp tyF (.cons rv .nil);
  let tyEl := Syntax.mkApp tyF (.cons `(term| HwTy.El) .nil);
  let app := fun (suffix : String) => Syntax.mkApp (Syntax.mkVar (String.append n suffix)) delta;
  let idt := fun (suffix : String) => Syntax.mkIdent (String.append n suffix);
  let codeApp := app ".code";
  let widthApp := app ".width";
  let packApp := app ".pack";
  let unpackApp := app ".unpack";
  let s := Syntax.mkIdent "s✝";
  let sv := Syntax.mkVar "s✝";
  let x := Syntax.mkIdent "x✝";
  let xv := Syntax.mkVar "x✝";
  let wN := idt ".width";
  let wTy := HdlDerive.explicitPis ps `(term| Nat);
  let wVal := HdlDerive.lams ps `(term| HwTy.width $codeApp);
  let tN := idt ".toBits";
  let tTy := HdlDerive.explicitPis ps `(term| {$r : HwTy → Type} → [Hw $rv] → $tyS → $rv (HwTy.bits $widthApp));
  let tVal := HdlDerive.lams ps `(term| fun $s => Hw.packBits $codeApp ($packApp $sv));
  let oN := idt ".ofBits";
  let oTy := HdlDerive.explicitPis ps `(term| {$r : HwTy → Type} → [Hw $rv] → $rv (HwTy.bits $widthApp) → $tyS);
  let oVal := HdlDerive.lams ps `(term| fun $x => $unpackApp (Hw.unpackBits $codeApp $xv));
  let lN := idt ".unpack_pack";
  let lTy := HdlDerive.explicitPis ps `(term| ($s : $tyEl) → $unpackApp ($packApp $sv) = $sv);
  let lVal := HdlDerive.lams ps `(term| fun $s => refl $sv);
  let bN := idt ".bitPack";
  let bTy := HdlDerive.explicitPis ps `(term| BitPack $tyEl);
  let bVal := HdlDerive.lams ps `(term| BitPack.mk $widthApp (fun $s => HwTy.El.packBits $codeApp ($packApp $sv))
    (fun $x => $unpackApp (HwTy.El.unpackBits $codeApp $xv)));
  MacroM.pure (List.append pre
    (.cons `(command| def $wN : $wTy := $wVal)
    (.cons `(command| def $tN : $tTy := $tVal)
    (.cons `(command| def $oN : $oTy := $oVal)
    (.cons `(command| def $lN : $lTy := $lVal)
    (.cons `(command| def $bN : $bTy := $bVal) .nil))))))

/-- `deriving BitPack` for an enumeration (no parameters, constructors without fields) or
a structure. -/
def deriveBitPack : Deriver := fun n => do
  v ← Derive.lookup "BitPack" n;
  Derive.noIndices "BitPack" v;
  match IndView.params v, HdlDerive.allNullary (IndView.ctors v) with
  | .nil, .true => HdlDerive.enumPack v n
  | .cons _ _, _ => (match IndView.isStructure v with
    | .true => do
      code ← MacroM.getType (String.append n ".code");
      pre ← (match code with
        | .some _ => MacroM.pure List.nil
        | .none => deriveBundle n);
      HdlDerive.bundlePack v n pre
    | .false => MacroM.throw (String.append "BitPack: not an enumeration or a bundle: " n))
  | .nil, .false => MacroM.throw (String.append "BitPack: not an enumeration (constructors without fields) or a bundle: " n)
attribute [deriver BitPack] deriveBitPack

------------------------------------------------------------------------------------
-- Test benches. `Testbench.verilog n vec cycles` replays a vector file on the module
-- `Verilog.emit n` makes: each line of `vec` is one cycle, in hexadecimal, the input
-- ports then the expected output ports (in port order, the first in the high bits;
-- ports of width 0 left out). In each cycle the bench sets the inputs, waits for them to
-- settle, compares every output and clocks. It prints `PASS name: N cycles` or
-- `FAIL name: K mismatches` (and the first ten mismatches).

/-- Whether a port has any bits (ports of width 0 are left out of benches and pin files). -/
def Hdl.nonZero (p : NetPort) : Bool := Bool.not (Nat.beq p.width 0)
/-- The ports with their identifiers, without those of width 0. -/
def Hdl.filterPorts : List String → List NetPort → List (String × NetPort)
  | .cons nm nms, .cons p ps => (match Hdl.nonZero p with
    | .true => .cons (nm, p) (Hdl.filterPorts nms ps)
    | .false => Hdl.filterPorts nms ps)
  | _, _ => .nil
/-- The total width of some ports. -/
def Hdl.portWidths : List (String × NetPort) → Nat
  | .nil => 0
  | .cons p ps => p.2.width + Hdl.portWidths ps

/-- The bench's `reg` for every input. -/
def Testbench.regs : List (String × NetPort) → String
  | .nil => ""
  | .cons p ps => "  reg " <+> Verilog.range p.2.width <+> p.1 <+> " = 0;\n" <+> Testbench.regs ps
/-- The bench's `wire` for every output. -/
def Testbench.wires : List (String × NetPort) → String
  | .nil => ""
  | .cons p ps => "  wire " <+> Verilog.range p.2.width <+> p.1 <+> ";\n" <+> Testbench.wires ps
/-- The connections of the device under test (`, .x(x)`). -/
def Testbench.conns : List (String × NetPort) → String
  | .nil => ""
  | .cons p ps => ", ." <+> p.1 <+> "(" <+> p.1 <+> ")" <+> Testbench.conns ps
/-- The bits of a port in the vector, `tb_vec[tb_i][hi:lo]`; `top` is the bit above it. -/
def Testbench.field (top w : Nat) : String :=
  "tb_vec[tb_i][" <+> Hdl.show (top - 1) <+> ":" <+> Hdl.show (top - w) <+> "]"
/-- Set the inputs from the vector. -/
def Testbench.drive : Nat → List (String × NetPort) → String
  | _, .nil => ""
  | top, .cons p ps => "      " <+> p.1 <+> " = " <+> Testbench.field top p.2.width <+> ";\n"
      <+> Testbench.drive (top - p.2.width) ps
/-- Compare the outputs with the vector, counting (and showing the first ten) mismatches. -/
def Testbench.compare : Nat → List (String × NetPort) → String
  | _, .nil => ""
  | top, .cons p ps =>
    "      if (" <+> p.1 <+> " !== " <+> Testbench.field top p.2.width <+> ") begin\n"
    <+> "        tb_errors = tb_errors + 1;\n"
    <+> "        if (tb_errors < 10) $display(\"mismatch at cycle %0d: " <+> p.1 <+> " = %b, expected %b\", tb_i, "
    <+> p.1 <+> ", " <+> Testbench.field top p.2.width <+> ");\n      end\n"
    <+> Testbench.compare (top - p.2.width) ps

/-- A test bench for the module `Verilog.emit n` makes: it replays the vector file `vec`
(`cycles` lines, each one cycle in hexadecimal: the input ports then the expected
output ports, in port order, the first in the high bits; ports of width 0 left out). In
each cycle it sets the inputs, waits for them to settle, compares every output and
clocks. It prints `PASS name: N cycles` or `FAIL name: K mismatches` (and the first ten
mismatches). `Circuit.vectors` writes the vector file. -/
def Testbench.verilog (n : Netlist) (vec : String) (cycles : Nat) : String :=
  let ω vn := Verilog.portIdents n;
  let ω ins := Hdl.filterPorts vn.ins n.inputs;
  let ω outs := Hdl.filterPorts vn.outs n.outputs;
  let ω wi := Hdl.portWidths ins;
  let ω w := wi + Hdl.portWidths outs;
  let ω name := Verilog.ident n.name;
  "`timescale 1ns/1ps\n"
  <+> "module tb;\n"
  <+> "  reg clk = 0;\n"
  <+> Testbench.regs ins <+> Testbench.wires outs
  <+> "  " <+> name <+> " dut(.clk(clk)" <+> Testbench.conns ins <+> Testbench.conns outs <+> ");\n"
  <+> "  reg " <+> Verilog.range w <+> "tb_vec [0:" <+> Hdl.show (cycles - 1) <+> "];\n"
  <+> "  integer tb_i, tb_errors;\n"
  <+> "  initial begin\n"
  <+> "    $readmemh(\"" <+> vec <+> "\", tb_vec);\n"
  <+> "    tb_errors = 0;\n"
  <+> "    for (tb_i = 0; tb_i < " <+> Hdl.show cycles <+> "; tb_i = tb_i + 1) begin\n"
  <+> Testbench.drive w ins
  <+> "      #1;\n"
  <+> Testbench.compare (w - wi) outs
  <+> "      clk = 1; #1; clk = 0; #1;\n"
  <+> "    end\n"
  <+> "    if (tb_errors == 0) $display(\"PASS " <+> name <+> ": %0d cycles\", tb_i);\n"
  <+> "    else $display(\"FAIL " <+> name <+> ": %0d mismatches\", tb_errors);\n"
  <+> "    $finish;\n"
  <+> "  end\n"
  <+> "endmodule\n"

/-- Leaves packed into one number, the first port in the high bits. -/
def Testbench.packPorts : List NetPort → List Nat → Nat → Nat
  | .cons p ps, .cons v vs, acc => Testbench.packPorts ps vs (Nat.shiftLeft acc p.width + Nat.wrap p.width v)
  | _, _, acc => acc
/-- One vector line: the leaves of the inputs and the expected outputs (one number per
port, ports of width 0 included, as `Netlist.simulate` takes and gives them), in
hexadecimal. -/
def Testbench.line (n : Netlist) (ins outs : List Nat) : String :=
  let ω w := Hdl.sum (Hdl.map (fun (p : NetPort) => p.width) n.inputs) + Hdl.sum (Hdl.map (fun (p : NetPort) => p.width) n.outputs);
  let ω v := Testbench.packPorts n.outputs outs (Testbench.packPorts n.inputs ins 0);
  String.mk (Hdl.hexAux (Nat.max 1 (Nat.div (w + 3) 4)) v (List.cons (Char.mk 10) List.nil))
/-- The vector lines of a trace of inputs and outputs. -/
def Testbench.lines (n : Netlist) : List (List Nat) → List (List Nat) → List String
  | .cons i is, .cons o os => .cons (Testbench.line n i o) (Testbench.lines n is os)
  | _, _ => .nil
/-- The vector file (for `Testbench.verilog`) of a value simulation of `c` on `xs`; the
netlist `n` must be `c`'s. -/
def Circuit.vectors {ω i o : HwTy} (n : Netlist) (c : Circuit i o) (xs : List (HwTy.El i)) : List String :=
  Testbench.lines n (Hdl.map (HwTy.leaves i) xs) (Circuit.runLeaves c xs)

------------------------------------------------------------------------------------
-- A VCD waveform of a value simulation: the clock, every input and output leaf (by
-- port name) and every state leaf (by register name); a cycle is 2 time units.

/-- The digits of a VCD identifier (base 94, printable characters from `!`). -/
def Vcd.idAux : Nat → Nat → List Char → List Char
  | .zero, _, acc => acc
  | .succ f, k, acc => match Nat.lt k 94 with
    | .true => List.cons (Char.mk (33 + k)) acc
    | .false => Vcd.idAux f (Nat.div k 94 - 1) (List.cons (Char.mk (33 + Nat.mod k 94)) acc)
/-- The VCD identifier of signal `k`: `!`, `"`, … -/
def Vcd.id (k : Nat) : String := String.mk (Vcd.idAux 8 k List.nil)
/-- A value change line: `1!` for one bit, `b0101 "` for a vector. -/
def Vcd.value (w v : Nat) (id : String) : String := match w with
  | .succ .zero => Hdl.show v <+> id <+> "\n"
  | _ => "b" <+> Hdl.bin (Nat.max w 1) v <+> " " <+> id <+> "\n"
/-- The `$var` declarations of the signals. -/
def Vcd.vars : Nat → List String → List Nat → String
  | k, .cons nm nms, .cons w ws =>
    "$var wire " <+> Hdl.show (Nat.max w 1) <+> " " <+> Vcd.id k <+> " " <+> nm <+> " $end\n" <+> Vcd.vars (Nat.succ k) nms ws
  | _, _, _ => ""
/-- The value changes of a cycle: the values that differ from the previous cycle's (all of
them in the first cycle). -/
def Vcd.changes : Bool → Nat → List Nat → List Nat → List Nat → String
  | first, k, .cons w ws, .cons v vs, prev =>
    let ω rest := Vcd.changes first (Nat.succ k) ws vs (match prev with
      | .cons _ ps => ps
      | .nil => .nil);
    (match Bool.or first (Bool.not (Nat.beq v (Hdl.nthD 0 prev 0))) with
    | .true => Vcd.value w v (Vcd.id k)
    | .false => "") <+> rest
  | _, _, _, _, _ => ""
/-- The value changes cycle by cycle (the clock rises in the middle of each). -/
def Vcd.cycles {ω i o : HwTy} (c : Circuit i o) (ws : List Nat) :
    Nat → HwTy.El c.st → List (HwTy.El i) → List Nat → List String → List String
  | t, _, .nil, _, acc => Hdl.reverse (List.cons ("#" <+> Hdl.show (2 * t) <+> "\n") acc)
  | t, s, .cons x xs, prev, acc =>
    let ω r : HwTy.El c.st × HwTy.El o := Circuit.stepEl c s x;
    let ω vals := List.cons 0 (List.append (HwTy.leaves i x) (List.append (HwTy.leaves o r.2) (HwTy.leaves c.st s)));
    let ω now := "#" <+> Hdl.show (2 * t) <+> "\n" <+> Vcd.changes (Nat.beq t 0) 0 ws vals prev
      <+> "#" <+> Hdl.show (2 * t + 1) <+> "\n1!\n";
    Vcd.cycles c ws (Nat.succ t) r.1 xs (List.cons 1 (Hdl.map (fun (v : Nat) => v) (match vals with
      | .cons _ vs => vs
      | .nil => .nil))) (List.cons now acc)

/-- A VCD waveform of a value simulation of `c` on `xs`: the clock, every input and output
leaf (by port name) and every state leaf (by register name); a cycle is 2 time units.
Open it with GTKWave. -/
def Vcd.ofRun {ω i o : HwTy} (name : String) (c : Circuit i o) (xs : List (HwTy.El i)) : String :=
  let ω names := List.cons "clk" (List.append (HwTy.portNames "x" i) (List.append (HwTy.portNames "y" o) (HwTy.portNames "r" c.st)));
  let ω ws := List.cons 1 (List.append (HwTy.leafWidths i) (List.append (HwTy.leafWidths o) (HwTy.leafWidths c.st)));
  "$timescale 1ns $end\n$scope module " <+> Verilog.ident name <+> " $end\n" <+> Vcd.vars 0 names ws
  <+> "$upscope $end\n$enddefinitions $end\n" <+> Hdl.concat (Vcd.cycles c ws 0 c.init xs List.nil List.nil)

------------------------------------------------------------------------------------
-- Pin constraints (the PCF of nextpnr-ice40 and arachne): a pin for every port, by the
-- port's name in the netlist. `Pin.bus` lists the pins of a wider port, bit 0 first.

/-- Pin constraints for a port, by the port's name in the netlist: `one` for a one-bit
port, `bus` for a wider one (the pins of its bits, bit 0 first).

```
[Pin.one "x_rx" 9, Pin.bus "y_leds" [99, 98, 97, 96, 95]]
``` -/
inductive Pin where
  | one (port : String) (pin : Nat)
  | bus (port : String) (pins : List Nat)

/-- The port a pin constraint is for. -/
def Pin.port : Pin → String
  | .one p _ => p
  | .bus p _ => p
/-- The constraint for a port, if any. -/
def Pin.find (name : String) : List Pin → Option Pin
  | .nil => .none
  | .cons p ps => match Hdl.strEq (Pin.port p) name with
    | .true => .some p
    | .false => Pin.find name ps

/-- The `set_io` lines of a bus, bit `k` on. -/
def Pcf.busLines (id : String) : Nat → List Nat → String
  | _, .nil => ""
  | k, .cons pin pins => "set_io " <+> id <+> "[" <+> Hdl.show k <+> "] " <+> Hdl.show pin <+> "\n" <+> Pcf.busLines id (Nat.succ k) pins
/-- The `set_io` lines of one port (none if it has no pin). -/
def Pcf.port (pins : List Pin) (id : String) (p : NetPort) : String := match Pin.find p.name pins with
  | .none => ""
  | .some (.one _ pin) => "set_io " <+> id <+> " " <+> Hdl.show pin <+> "\n"
  | .some (.bus _ ps) => Pcf.busLines id 0 ps
/-- The `set_io` lines of some ports (zero-width ones left out). -/
def Pcf.ports (pins : List Pin) : List String → List NetPort → String
  | .cons id ids, .cons p ps => (match Hdl.nonZero p with
    | .true => Pcf.port pins id p
    | .false => "") <+> Pcf.ports pins ids ps
  | _, _ => ""

/-- A PCF file (nextpnr-ice40, arachne): `set_io` lines for the clock (pin `clk`) and the
ports, with the identifiers `Verilog.emit` uses. Check the pins first with `Pcf.check`. -/
def Pcf.emit (n : Netlist) (clk : Nat) (pins : List Pin) : String :=
  let ω vn := Verilog.portIdents n;
  "set_io clk " <+> Hdl.show clk <+> "\n" <+> Pcf.ports pins vn.ins n.inputs <+> Pcf.ports pins vn.outs n.outputs

/-- What is wrong with one port's pins: none, or the wrong number. -/
def Pcf.portProblem (pins : List Pin) (p : NetPort) : List String := match Hdl.nonZero p with
  | .false => .nil
  | .true => match Pin.find p.name pins with
    | .none => .cons ("no pin for port " <+> p.name) .nil
    | .some (.one _ _) => (match Nat.beq p.width 1 with
      | .true => .nil
      | .false => .cons ("port " <+> p.name <+> " has " <+> Hdl.show p.width <+> " bits, one pin given") .nil)
    | .some (.bus _ ps) => match Nat.beq p.width (List.length ps) with
      | .true => .nil
      | .false => .cons ("port " <+> p.name <+> " has " <+> Hdl.show p.width <+> " bits, "
          <+> Hdl.show (List.length ps) <+> " pins given") .nil
/-- The problems of all ports. -/
def Pcf.portProblems (pins : List Pin) : List NetPort → List String
  | .nil => .nil
  | .cons p ps => List.append (Pcf.portProblem pins p) (Pcf.portProblems pins ps)
/-- Whether a port of that name exists. -/
def Pcf.hasPort (name : String) : List NetPort → Bool
  | .nil => .false
  | .cons p ps => Bool.or (Hdl.strEq p.name name) (Pcf.hasPort name ps)
/-- Pins for no port. -/
def Pcf.strayPins (ports : List NetPort) : List Pin → List String
  | .nil => .nil
  | .cons p ps => match Pcf.hasPort (Pin.port p) ports with
    | .true => Pcf.strayPins ports ps
    | .false => .cons ("pin for no port: " <+> Pin.port p) (Pcf.strayPins ports ps)
/-- What is wrong with a pin list for a netlist: ports without a pin, pins for no port,
wrong widths. Empty when it is right. -/
def Pcf.check (n : Netlist) (pins : List Pin) : List String :=
  List.append (Pcf.portProblems pins (List.append n.inputs n.outputs)) (Pcf.strayPins (List.append n.inputs n.outputs) pins)

------------------------------------------------------------------------------------
-- A design: a top-level circuit with a name, packed at the first order, so that it is a
-- `Type` (a `Circuit` quantifies over representations and lives in `Type 1`) and
-- designs fit in a `List`. It keeps the step at values and the netlist.

/-- A design: a top-level circuit with a name, packed at the first order, so that it is a
`Type` (a `Circuit` quantifies over representations and lives in `Type 1`) and designs
fit in a `List`. It keeps the step at values and the netlist (computed on demand). -/
structure Design where
  name : String
  i : HwTy
  o : HwTy
  st : HwTy
  init : HwTy.El st
  step : HwTy.El st → HwTy.El i → HwTy.El (HwTy.prod st o)
  net : Unit → Netlist

/-- A circuit as a design named `name`. -/
def Circuit.design {ω i o : HwTy} (name : String) (c : Circuit i o) : Design :=
  Design.mk name i o c.st c.init (Circuit.stepEl c) (fun u => Circuit.netlist name c)

/-- The design's netlist. -/
def Design.netlist (d : Design) : Netlist := d.net ()
/-- The design as Verilog (`Verilog.emit`). -/
def Design.verilog (d : Design) : String := Verilog.emit (Design.netlist d)

/-- The simulation loop of `Design.run`. -/
def Design.runGo (d : Design) : HwTy.El d.st → List (HwTy.El d.i) → List (HwTy.El d.o) → List (HwTy.El d.o)
  | _, .nil, acc => Hdl.reverse acc
  | s, .cons x xs, acc =>
    let ω r : HwTy.El d.st × HwTy.El d.o := d.step s x;
    Design.runGo d r.1 xs (List.cons r.2 acc)
/-- Simulate a design by values from its initial state. -/
def Design.run (d : Design) (xs : List (HwTy.El d.i)) : List (HwTy.El d.o) := Design.runGo d d.init xs List.nil
/-- `Design.run` on bus encodings (one number per cycle). -/
def Design.runPacked (d : Design) (xs : List Nat) : List Nat :=
  Hdl.map (HwTy.pack d.o) (Design.run d (Hdl.map (HwTy.unpack d.i) xs))
/-- `Design.run` on leaves (one number per port per cycle). -/
def Design.runLeaves (d : Design) (xs : List (List Nat)) : List (List Nat) :=
  Hdl.map (HwTy.leaves d.o) (Design.run d (Hdl.map (HwTy.ofLeaves d.i) xs))

------------------------------------------------------------------------------------
-- Operators on signals (docs/libraries.md, H14 S2). At any representation `r` with
-- `[Hw r]`, on `r (HwTy.bits n)`:
--
--   numeral `k`                         `Hw.lit n k`, the width from the type
--   `a + b`  `a - b`  `a * b`  `-a`     `Hw.add`, `Hw.sub`, `Hw.mul`, `0 - a`   (65, 65, 70, 75)
--   `a &&& b`  `a ||| b`  `a ^^^ b`     `Hw.and`, `Hw.or`, `Hw.xor`             (60, 55, 58)
--   `~~~a`                              `Hw.not`                                (max)
--   `a <<< k`  `a >>> k`  (`k : Nat`)   logical shifts by `k` places: wiring    (75)
--   `a <ᵤ b`  `a ≤ᵤ b`  `a >ᵤ b`  `a ≥ᵤ b`   unsigned comparisons: 1 bit      (62)
--   `a === b`  `a =/= b`                equality, inequality: a 1-bit signal   (61)
--   `if c then a else b`, `c : r HwTy.bit`   `Hw.mux c a b`, at any type `r t`
--   (H14 S4) `a <<< s`  `a >>> s`  `a >>>ₛ s`  (`s` a signal)   barrel shifters   (75)
--   `a >>>ₛ k` (`k : Nat`)   arithmetic shift right by wiring                    (75)
--   `a <ₛ b`  `a ≤ₛ b`  `a >ₛ b`  `a ≥ₛ b`   signed comparisons: 1 bit           (62)
--   `a && b`  `a || b`  (`a b : r HwTy.bit`)   `a &&& b`, `a ||| b`             (35, 30)
--
-- They are the `Hw` operations, so circuits written with them have the same netlists and
-- the same Verilog as with `Hw.add` …, and print back as written. `Hw.ofNat k` is a
-- constant whose width comes from the expected type (`x === Hw.ofNat (n - 1)` for a
-- meta-level `n`). The comparisons are the HDL's own symbols (as in Chisel), not `==`/`<`:
-- they return a signal, not a `Bool`, and are unsigned (`ᵤ`). As in Verilog they bind
-- tighter than the bitwise operations, so `x === 0 &&& y <ᵤ k` needs no parentheses.

/-- A numeral at `r (HwTy.bits n)` is a constant of that width. -/
instance {r : HwTy → Type} [Hw r] {ω n k : Nat} : OfNat (r (HwTy.bits n)) k := OfNat.mk (Hw.lit n k)
/-- A numeral as a signal whose width comes from the expected type. -/
def Hw.ofNat {r : HwTy → Type} [Hw r] {ω n : Nat} (k : Nat) : r (HwTy.bits n) := Hw.lit n k

/-- `a + b` on hardware signals is `Hw.add`. -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : Add (r (HwTy.bits n)) := Add.mk (fun a b => Hw.add a b)
/-- `a - b` on hardware signals is `Hw.sub`. -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : Sub (r (HwTy.bits n)) := Sub.mk (fun a b => Hw.sub a b)
/-- `a * b` on hardware signals is `Hw.mul`. -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : Mul (r (HwTy.bits n)) := Mul.mk (fun a b => Hw.mul a b)
/-- `-a` on hardware signals is `Hw.sub (Hw.lit n 0) a`. -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : Neg (r (HwTy.bits n)) := Neg.mk (fun a => Hw.sub (Hw.lit n 0) a)
/-- `a &&& b` on hardware signals is `Hw.and`. -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : AndOp (r (HwTy.bits n)) := AndOp.mk (fun a b => Hw.and a b)
/-- `a ||| b` on hardware signals is `Hw.or`. -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : OrOp (r (HwTy.bits n)) := OrOp.mk (fun a b => Hw.or a b)
/-- `a ^^^ b` on hardware signals is `Hw.xor`. -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : XorOp (r (HwTy.bits n)) := XorOp.mk (fun a b => Hw.xor a b)
/-- `~~~a` on hardware signals is `Hw.not`. -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : Complement (r (HwTy.bits n)) := Complement.mk (fun a => Hw.not a)

/-- Shifts by a fixed number of places are wiring: `a <<< k` is the low `n` bits of `a`
with `k` zeros below it, `a >>> k` the high `n` bits of `k` zeros above `a` (a
concatenation and a slice: no shifter). By 0 places, `a`; by `n` or more, `0`. -/
def Hw.shl {r : HwTy → Type} [Hw r] {ω n : Nat} (a : r (HwTy.bits n)) (k : Nat) : r (HwTy.bits n) :=
  match Nat.beq k 0 with
  | .true => a
  | .false => (match Nat.lt k n with
    | .true => Hw.slice 0 n (Hw.cat a (Hw.lit k 0))
    | .false => Hw.lit n 0)
/-- A logical right shift by a fixed `k` places is wiring (zeros in at the top); by `n`
or more, `0`. -/
def Hw.lshr {r : HwTy → Type} [Hw r] {ω n : Nat} (a : r (HwTy.bits n)) (k : Nat) : r (HwTy.bits n) :=
  match Nat.beq k 0 with
  | .true => a
  | .false => (match Nat.lt k n with
    | .true => Hw.slice k n (Hw.cat (Hw.lit k 0) a)
    | .false => Hw.lit n 0)
/-- `a <<< k` on hardware signals is `Hw.shl` (wiring for a `Nat`). -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : ShiftLeft (r (HwTy.bits n)) := ShiftLeft.mk (fun a k => Hw.shl a k)
/-- `a >>> k` on hardware signals is `Hw.lshr` (wiring for a `Nat`). -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : ShiftRight (r (HwTy.bits n)) := ShiftRight.mk (fun a k => Hw.lshr a k)

-- (H14 S4) Shifts by a signal `s : r (HwTy.bits m)`: `a <<< s`, `a >>> s` are barrel
-- shifters (`Hw.shlBy`, `Hw.lshrBy`; Verilog `<<`, `>>`). A `Nat` amount stays wiring.
/-- `a <<< s` by a signal is a barrel shifter (`Hw.shlBy`). -/
instance {r : HwTy → Type} [Hw r] {ω n m : Nat} : HShiftLeft (r (HwTy.bits n)) (r (HwTy.bits m)) (r (HwTy.bits n)) :=
  HShiftLeft.mk (fun a s => Hw.shlBy a s)
/-- `a >>> s` by a signal is a barrel shifter (`Hw.lshrBy`). -/
instance {r : HwTy → Type} [Hw r] {ω n m : Nat} : HShiftRight (r (HwTy.bits n)) (r (HwTy.bits m)) (r (HwTy.bits n)) :=
  HShiftRight.mk (fun a s => Hw.lshrBy a s)

/-- Arithmetic shift right, `a >>>ₛ k` (copies of the sign bit come in): by a fixed `k :
Nat` it is wiring (the sign bit repeated `k` times on top, then a slice); by a signal,
`Hw.ashrBy` (Verilog `$signed(a) >>> s`). -/
def Hw.signs {r : HwTy → Type} [Hw r] {ω n : Nat} (a : r (HwTy.bits n)) (k : Nat) : r (HwTy.bits k) :=
  Hw.mux (Hw.slice (n - 1) 1 a) (Hw.lit k (Nat.pow 2 k - 1)) (Hw.lit k 0)
/-- An arithmetic right shift by a fixed `k` places (copies of the sign bit in); by a
signal, `Hw.ashrBy`. -/
def Hw.ashr {r : HwTy → Type} [Hw r] {ω n : Nat} (a : r (HwTy.bits n)) (k : Nat) : r (HwTy.bits n) :=
  match Nat.beq k 0, Nat.beq n 0 with
  | .true, _ => a
  | _, .true => a
  | _, _ => Hw.share a (fun a => match Nat.lt k n with
    | .true => Hw.slice k n (Hw.cat (Hw.signs a k) a)
    | .false => Hw.signs a n)
/-- Types with an arithmetic right shift, written `a >>>ₛ b`. -/
class AShiftRight (A B : Type) (C : outParam Type) where
  ashr : A → B → C
/-- `a >>>ₛ k` by a fixed amount is `Hw.ashr` (wiring). -/
instance {r : HwTy → Type} [Hw r] {ω n : Nat} : AShiftRight (r (HwTy.bits n)) Nat (r (HwTy.bits n)) :=
  AShiftRight.mk (fun a k => Hw.ashr a k)
/-- `a >>>ₛ s` by a signal is `Hw.ashrBy`. -/
instance {r : HwTy → Type} [Hw r] {ω n m : Nat} : AShiftRight (r (HwTy.bits n)) (r (HwTy.bits m)) (r (HwTy.bits n)) :=
  AShiftRight.mk (fun a s => Hw.ashrBy a s)
infixl:75 " >>>ₛ " => AShiftRight.ashr

/-- comparisons: one bit -/
def Hw.neq {r : HwTy → Type} [Hw r] {ω n : Nat} (a b : r (HwTy.bits n)) : r HwTy.bit := Hw.not (Hw.eq a b)
/-- Unsigned `a ≤ b`, as one bit. -/
def Hw.ule {r : HwTy → Type} [Hw r] {ω n : Nat} (a b : r (HwTy.bits n)) : r HwTy.bit := Hw.not (Hw.ult b a)
/-- Unsigned `a > b`, as one bit. -/
def Hw.ugt {r : HwTy → Type} [Hw r] {ω n : Nat} (a b : r (HwTy.bits n)) : r HwTy.bit := Hw.ult b a
/-- Unsigned `a ≥ b`, as one bit. -/
def Hw.uge {r : HwTy → Type} [Hw r] {ω n : Nat} (a b : r (HwTy.bits n)) : r HwTy.bit := Hw.not (Hw.ult a b)
infix:61 " === " => Hw.eq
infix:61 " =/= " => Hw.neq
infix:62 " <ᵤ " => Hw.ult
infix:62 " ≤ᵤ " => Hw.ule
infix:62 " >ᵤ " => Hw.ugt
infix:62 " ≥ᵤ " => Hw.uge

/-- (H14 S4) signed comparisons (two's complement), one bit: `<ₛ ≤ₛ >ₛ ≥ₛ` -/
def Hw.sle {r : HwTy → Type} [Hw r] {ω n : Nat} (a b : r (HwTy.bits n)) : r HwTy.bit := Hw.not (Hw.slt b a)
/-- Signed (two's complement) `a > b`, as one bit. -/
def Hw.sgt {r : HwTy → Type} [Hw r] {ω n : Nat} (a b : r (HwTy.bits n)) : r HwTy.bit := Hw.slt b a
/-- Signed (two's complement) `a ≥ b`, as one bit. -/
def Hw.sge {r : HwTy → Type} [Hw r] {ω n : Nat} (a b : r (HwTy.bits n)) : r HwTy.bit := Hw.not (Hw.slt a b)
infix:62 " <ₛ " => Hw.slt
infix:62 " ≤ₛ " => Hw.sle
infix:62 " >ₛ " => Hw.sgt
infix:62 " ≥ₛ " => Hw.sge

-- `if` on a one-bit signal (lib/Prelude.wiz, `Mux`): a multiplexer at any type
/-- `if c then x else y` on hardware signals is `Hw.mux`. -/
instance {r : HwTy → Type} [Hw r] {ω t : HwTy} : Mux (r HwTy.bit) (r t) := Mux.mk (fun c a b => Hw.mux c a b)
-- and `Hw.mux c a b` prints as that `if`
app_unexpander Hw.mux
  | `(term| $f $c $a $b) => `(term| if $c then $a else $b)
