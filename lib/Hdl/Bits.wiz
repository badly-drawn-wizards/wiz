import Hdl.Core
-- Bit-level reasoning for circuits (`import Hdl.Bits`): the laws of one-bit signals at
-- values, so that a proof does not dictate how control logic is written (finding C2 of
-- the iCEstick toy CPU: `rfl` reduces a multiplexer on a known select, but not
-- `Hw.and (Hw.lit 1 0) x` on a symbolic `x`). Design:
-- /workspace/wiz-notes/cohesion-hardware.md, 2.3.
--
-- * `Bit.ind`: a property of every bit is a property of 0 and of 1. With it, every
--   law of one-bit logic is two (or four, eight) closed evaluations: `Bit.ind` and `rfl`.
--   It rests on the words' range (stage 22l: a `UIntN 1` is 0 or 1, `UIntN.cases1`).
-- * The laws as named lemmas (`Bit.and_zero`, `Bit.or_one`, `Bit.not_not`, …), and the
--   multiplexer normal form: `Bit.and_mux` (`a & b = a ? b : 0`), `Bit.or_mux`,
--   `Bit.not_mux`, so a proof can turn gate-level control logic into the multiplexers
--   that `rfl` reduces, or the other way round; `HwTy.El.mux_same` at any type.
-- * The bridge to Booleans: `Bit.toBool` is a homomorphism (`Bit.toBool_and` …) and
--   `Bit.eq_of_toBool` turns an equation of bits into one of Booleans, the goals that
--   `sat_decide` (stage 28b) decides with a kernel-checked certificate.

def Bit.zero : BitVec 1 := BitVec.ofNat 1 0
def Bit.one : BitVec 1 := BitVec.ofNat 1 1

-- two bits are equal when their numbers are (a closed equation of bits: `Bit.eqv _ _ rfl`;
-- plain `rfl` can fail where two equal words were built with different range proofs)
def Bit.eqv (x y : BitVec 1) (h : BitVec.toNat x = BitVec.toNat y) : x = y := UIntN.ext x y h

-- the case split
def Bit.cases (x : BitVec 1) : x = Bit.zero ∨ x = Bit.one := UIntN.cases1 x
def Bit.ind (0 P : BitVec 1 → Prop) (h0 : P Bit.zero) (h1 : P Bit.one) (x : BitVec 1) : P x :=
  Or.elim (Bit.cases x)
    (fun (e : x = Bit.zero) => Eq.substProp P (Eq.symm e) h0)
    (fun (e : x = Bit.one) => Eq.substProp P (Eq.symm e) h1)
-- two and three bits at once
def Bit.ind2 (0 P : BitVec 1 → BitVec 1 → Prop) (h00 : P Bit.zero Bit.zero) (h01 : P Bit.zero Bit.one)
    (h10 : P Bit.one Bit.zero) (h11 : P Bit.one Bit.one) (x y : BitVec 1) : P x y :=
  Bit.ind (fun (a : BitVec 1) => P a y)
    (Bit.ind (fun (b : BitVec 1) => P Bit.zero b) h00 h01 y)
    (Bit.ind (fun (b : BitVec 1) => P Bit.one b) h10 h11 y) x
def Bit.ind3 (0 P : BitVec 1 → BitVec 1 → BitVec 1 → Prop)
    (h000 : P Bit.zero Bit.zero Bit.zero) (h001 : P Bit.zero Bit.zero Bit.one)
    (h010 : P Bit.zero Bit.one Bit.zero) (h011 : P Bit.zero Bit.one Bit.one)
    (h100 : P Bit.one Bit.zero Bit.zero) (h101 : P Bit.one Bit.zero Bit.one)
    (h110 : P Bit.one Bit.one Bit.zero) (h111 : P Bit.one Bit.one Bit.one) (x y z : BitVec 1) : P x y z :=
  Bit.ind (fun (a : BitVec 1) => P a y z)
    (Bit.ind2 (fun (b c : BitVec 1) => P Bit.zero b c) h000 h001 h010 h011 y z)
    (Bit.ind2 (fun (b c : BitVec 1) => P Bit.one b c) h100 h101 h110 h111 y z) x

------------------------------------------------------------------------------------
-- Gates with a constant

def Bit.and_zero (x : BitVec 1) : BitVec.and Bit.zero x = Bit.zero :=
  Bit.ind (fun (a : BitVec 1) => BitVec.and Bit.zero a = Bit.zero) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.and_zero_r (x : BitVec 1) : BitVec.and x Bit.zero = Bit.zero :=
  Bit.ind (fun (a : BitVec 1) => BitVec.and a Bit.zero = Bit.zero) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.and_one (x : BitVec 1) : BitVec.and Bit.one x = x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.and Bit.one a = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.and_one_r (x : BitVec 1) : BitVec.and x Bit.one = x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.and a Bit.one = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.or_one (x : BitVec 1) : BitVec.or Bit.one x = Bit.one :=
  Bit.ind (fun (a : BitVec 1) => BitVec.or Bit.one a = Bit.one) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.or_one_r (x : BitVec 1) : BitVec.or x Bit.one = Bit.one :=
  Bit.ind (fun (a : BitVec 1) => BitVec.or a Bit.one = Bit.one) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.or_zero (x : BitVec 1) : BitVec.or Bit.zero x = x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.or Bit.zero a = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.or_zero_r (x : BitVec 1) : BitVec.or x Bit.zero = x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.or a Bit.zero = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.xor_zero (x : BitVec 1) : BitVec.xor Bit.zero x = x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.xor Bit.zero a = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.xor_one (x : BitVec 1) : BitVec.xor Bit.one x = BitVec.not x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.xor Bit.one a = BitVec.not a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x

------------------------------------------------------------------------------------
-- Gates on variables

def Bit.not_not (x : BitVec 1) : BitVec.not (BitVec.not x) = x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.not (BitVec.not a) = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.and_self (x : BitVec 1) : BitVec.and x x = x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.and a a = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.or_self (x : BitVec 1) : BitVec.or x x = x :=
  Bit.ind (fun (a : BitVec 1) => BitVec.or a a = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.and_not_self (x : BitVec 1) : BitVec.and x (BitVec.not x) = Bit.zero :=
  Bit.ind (fun (a : BitVec 1) => BitVec.and a (BitVec.not a) = Bit.zero) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.or_not_self (x : BitVec 1) : BitVec.or x (BitVec.not x) = Bit.one :=
  Bit.ind (fun (a : BitVec 1) => BitVec.or a (BitVec.not a) = Bit.one) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.and_comm (x y : BitVec 1) : BitVec.and x y = BitVec.and y x :=
  Bit.ind2 (fun (a b : BitVec 1) => BitVec.and a b = BitVec.and b a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y
def Bit.or_comm (x y : BitVec 1) : BitVec.or x y = BitVec.or y x :=
  Bit.ind2 (fun (a b : BitVec 1) => BitVec.or a b = BitVec.or b a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y
def Bit.xor_comm (x y : BitVec 1) : BitVec.xor x y = BitVec.xor y x :=
  Bit.ind2 (fun (a b : BitVec 1) => BitVec.xor a b = BitVec.xor b a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y
def Bit.not_and (x y : BitVec 1) : BitVec.not (BitVec.and x y) = BitVec.or (BitVec.not x) (BitVec.not y) :=
  Bit.ind2 (fun (a b : BitVec 1) => BitVec.not (BitVec.and a b) = BitVec.or (BitVec.not a) (BitVec.not b)) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y
def Bit.not_or (x y : BitVec 1) : BitVec.not (BitVec.or x y) = BitVec.and (BitVec.not x) (BitVec.not y) :=
  Bit.ind2 (fun (a b : BitVec 1) => BitVec.not (BitVec.or a b) = BitVec.and (BitVec.not a) (BitVec.not b)) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y
def Bit.and_assoc (x y z : BitVec 1) : BitVec.and (BitVec.and x y) z = BitVec.and x (BitVec.and y z) :=
  Bit.ind3 (fun (a b c : BitVec 1) => BitVec.and (BitVec.and a b) c = BitVec.and a (BitVec.and b c)) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y z
def Bit.or_assoc (x y z : BitVec 1) : BitVec.or (BitVec.or x y) z = BitVec.or x (BitVec.or y z) :=
  Bit.ind3 (fun (a b c : BitVec 1) => BitVec.or (BitVec.or a b) c = BitVec.or a (BitVec.or b c)) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y z
def Bit.and_or (x y z : BitVec 1) : BitVec.and x (BitVec.or y z) = BitVec.or (BitVec.and x y) (BitVec.and x z) :=
  Bit.ind3 (fun (a b c : BitVec 1) => BitVec.and a (BitVec.or b c) = BitVec.or (BitVec.and a b) (BitVec.and a c)) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y z

------------------------------------------------------------------------------------
-- Multiplexers: the normal form `rfl` reduces

-- at any type, without the range: the select is a Boolean
def Hdl.boolSame {A : Type} : (c : Bool) → (x : A) → (match c with | .true => x | .false => x) = x
  | .true, x => rfl
  | .false, x => rfl
def HwTy.El.mux_same {t : HwTy} (c : BitVec 1) (x : HwTy.El t) : @HwTy.El.mux t c x x = x :=
  Hdl.boolSame (BitVec.isTrue c) x
def HwTy.El.mux_one {t : HwTy} (x y : HwTy.El t) : @HwTy.El.mux t Bit.one x y = x := rfl
def HwTy.El.mux_zero {t : HwTy} (x y : HwTy.El t) : @HwTy.El.mux t Bit.zero x y = y := rfl
def HwTy.El.mux_not {t : HwTy} (c : BitVec 1) (x y : HwTy.El t) : @HwTy.El.mux t (BitVec.not c) x y = @HwTy.El.mux t c y x :=
  Bit.ind (fun (a : BitVec 1) => @HwTy.El.mux t (BitVec.not a) x y = @HwTy.El.mux t a y x) rfl rfl c

-- gates as multiplexers
def Bit.and_mux (x y : BitVec 1) : BitVec.and x y = @HwTy.El.mux HwTy.bit x y Bit.zero :=
  Bit.ind2 (fun (a b : BitVec 1) => BitVec.and a b = @HwTy.El.mux HwTy.bit a b Bit.zero) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y
def Bit.or_mux (x y : BitVec 1) : BitVec.or x y = @HwTy.El.mux HwTy.bit x Bit.one y :=
  Bit.ind2 (fun (a b : BitVec 1) => BitVec.or a b = @HwTy.El.mux HwTy.bit a Bit.one b) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y
def Bit.not_mux (x : BitVec 1) : BitVec.not x = @HwTy.El.mux HwTy.bit x Bit.zero Bit.one :=
  Bit.ind (fun (a : BitVec 1) => BitVec.not a = @HwTy.El.mux HwTy.bit a Bit.zero Bit.one) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
def Bit.xor_mux (x y : BitVec 1) : BitVec.xor x y = @HwTy.El.mux HwTy.bit x (BitVec.not y) y :=
  Bit.ind2 (fun (a b : BitVec 1) => BitVec.xor a b = @HwTy.El.mux HwTy.bit a (BitVec.not b) b) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x y

------------------------------------------------------------------------------------
-- Booleans: the bridge to `sat_decide`

def Bit.toBool (x : BitVec 1) : Bool := BitVec.isTrue x
def Bit.ofBool (b : Bool) : BitVec 1 := Bool.toBits b

def Bit.toBool_ofBool : (b : Bool) → Bit.toBool (Bit.ofBool b) = b
  | .true => rfl
  | .false => rfl
def Bit.ofBool_toBool (x : BitVec 1) : Bit.ofBool (Bit.toBool x) = x :=
  Bit.ind (fun (a : BitVec 1) => Bit.ofBool (Bit.toBool a) = a) (Bit.eqv _ _ rfl) (Bit.eqv _ _ rfl) x
-- an equation of bits is an equation of their Booleans
def Bit.eq_of_toBool (x y : BitVec 1) (h : Bit.toBool x = Bit.toBool y) : x = y :=
  Eq.trans (Eq.symm (Bit.ofBool_toBool x)) (Eq.trans (Eq.congrArg Bit.ofBool h) (Bit.ofBool_toBool y))

def Bit.toBool_and (x y : BitVec 1) : Bit.toBool (BitVec.and x y) = Bool.and (Bit.toBool x) (Bit.toBool y) :=
  Bit.ind2 (fun (a b : BitVec 1) => Bit.toBool (BitVec.and a b) = Bool.and (Bit.toBool a) (Bit.toBool b)) rfl rfl rfl rfl x y
def Bit.toBool_or (x y : BitVec 1) : Bit.toBool (BitVec.or x y) = Bool.or (Bit.toBool x) (Bit.toBool y) :=
  Bit.ind2 (fun (a b : BitVec 1) => Bit.toBool (BitVec.or a b) = Bool.or (Bit.toBool a) (Bit.toBool b)) rfl rfl rfl rfl x y
def Bit.toBool_xor (x y : BitVec 1) : Bit.toBool (BitVec.xor x y) = Bool.xor (Bit.toBool x) (Bit.toBool y) :=
  Bit.ind2 (fun (a b : BitVec 1) => Bit.toBool (BitVec.xor a b) = Bool.xor (Bit.toBool a) (Bit.toBool b)) rfl rfl rfl rfl x y
def Bit.toBool_not (x : BitVec 1) : Bit.toBool (BitVec.not x) = Bool.not (Bit.toBool x) :=
  Bit.ind (fun (a : BitVec 1) => Bit.toBool (BitVec.not a) = Bool.not (Bit.toBool a)) rfl rfl x
def Bit.toBool_mux (c x y : BitVec 1) :
    Bit.toBool (@HwTy.El.mux HwTy.bit c x y) = Bool.or (Bool.and (Bit.toBool c) (Bit.toBool x)) (Bool.and (Bool.not (Bit.toBool c)) (Bit.toBool y)) :=
  Bit.ind3 (fun (a b d : BitVec 1) => Bit.toBool (@HwTy.El.mux HwTy.bit a b d) =
      Bool.or (Bool.and (Bit.toBool a) (Bit.toBool b)) (Bool.and (Bool.not (Bit.toBool a)) (Bit.toBool d)))
    rfl rfl rfl rfl rfl rfl rfl rfl c x y
