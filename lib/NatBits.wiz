import Prelude
-- Division, powers and bitwise operations on `Nat`, by structural recursion on a fuel
-- argument (`import NatBits`). They use only the native `+`, `-`, `*`, `Nat.lt`, so
-- each operation takes O(log x) native steps (bitwise ones O(log² x)), in the kernel
-- as well as at runtime.
--
-- Stopgap until H0b (agent/natives-ints) adds these names to the Prelude as natives;
-- then delete this file and the `import NatBits` lines (lib/BitVec.wiz).

-- `(x / m, x % m)` for `m > 0`, by long division on doublings of `m`: if
-- `x = q · 2m + r` with `r < 2m`, then `x = 2q · m + r`, and `r - m` if `r ≥ m`.
-- The fuel bounds the number of doublings (any `fuel ≥ log₂ x` will do).
def Nat.divModAux : Nat → Nat → Nat → Nat × Nat
  | .zero, x, _ => (0, x)
  | .succ fuel, x, m => match Nat.lt x m with
    | .true => (0, x)
    | .false =>
      let qr := Nat.divModAux fuel x (m + m);
      match Nat.lt qr.2 m with
      | .true => (qr.1 + qr.1, qr.2)
      | .false => (Nat.succ (qr.1 + qr.1), qr.2 - m)

-- `x / 0 = 0` and `x % 0 = x`, as in Lean.
def Nat.divMod (x m : Nat) : Nat × Nat := match m with
  | .zero => (0, x)
  | .succ _ => Nat.divModAux x x m

def Nat.div (x m : Nat) : Nat := (Nat.divMod x m).1
def Nat.mod (x m : Nat) : Nat := (Nat.divMod x m).2

def Nat.pow (b : Nat) : Nat → Nat
  | .zero => 1
  | .succ n => Nat.pow b n * b

def Nat.shiftLeft (x n : Nat) : Nat := x * Nat.pow 2 n
def Nat.shiftRight (x n : Nat) : Nat := Nat.div x (Nat.pow 2 n)
def Nat.isOdd (x : Nat) : Bool := Nat.beq (Nat.mod x 2) 1
def Nat.testBit (x i : Nat) : Bool := Nat.isOdd (Nat.shiftRight x i)
def Nat.ofBool : Bool → Nat
  | .false => 0
  | .true => 1

-- Combine `x` and `y` bit by bit with `f` (`f false false` must be `false`).
def Nat.bitwiseAux (f : Bool → Bool → Bool) : Nat → Nat → Nat → Nat
  | .zero, _, _ => 0
  | .succ fuel, x, y => match Bool.and (Nat.beq x 0) (Nat.beq y 0) with
    | .true => 0
    | .false =>
      let qx := Nat.divMod x 2;
      let qy := Nat.divMod y 2;
      let rest := Nat.bitwiseAux f fuel qx.1 qy.1;
      rest + rest + Nat.ofBool (f (Nat.beq qx.2 1) (Nat.beq qy.2 1))
def Nat.bitwise (f : Bool → Bool → Bool) (x y : Nat) : Nat := Nat.bitwiseAux f (Nat.succ (x + y)) x y

def Bool.xor : Bool → Bool → Bool
  | .true, b => Bool.not b
  | .false, b => b

def Nat.land (x y : Nat) : Nat := Nat.bitwise Bool.and x y
def Nat.lor (x y : Nat) : Nat := Nat.bitwise Bool.or x y
def Nat.xor (x y : Nat) : Nat := Nat.bitwise Bool.xor x y
