import IO
-- Algebraic effects as a library (stage 10).
--
-- An effect is a set of operations, each with the type of its answer. A computation
-- `Eff r A` is a tree of operations from the row `r`, with continuations (a free monad).
-- Handlers interpret the first effect of the row and leave the rest. Rows can be
-- reordered only where the effects provably commute (`Commute`).

structure Effect where
  op : Type
  ret : op → Type

inductive Row : Type 1 where
  | nil
  | cons (e : Effect) (r : Row)

inductive Sum (A B : Type) where
  | inl (a : A)
  | inr (b : B)

-- The operations of a row, and their answer types.
def Union : Row → Type
  | .nil => Empty
  | .cons e r => Sum e.op (Union r)
def RetU : (r : Row) → Union r → Type
  | .nil, o => absurd o
  | .cons e r, .inl o => e.ret o
  | .cons e r, .inr o => RetU r o

inductive Eff (r : Row) (A : Type) where
  | pure (a : A)
  | op (o : Union r) (k : RetU r o → Eff r A)

def Eff.bind {r : Row} {A B : Type} : Eff r A → (A → Eff r B) → Eff r B
  | .pure a, f => f a
  | .op o k, f => .op o (fun x => Eff.bind (k x) f)
instance {r : Row} : Monad (Eff r) where
  pure := fun a => Eff.pure a
  bind := Eff.bind

-- `e` is in the row `r`: how to inject its operations, and read their answers back.
class Member (e : Effect) (r : Row) where
  inj : e.op → Union r
  prj : (o : e.op) → RetU r (inj o) → e.ret o
instance {e : Effect} {r : Row} : Member e (Row.cons e r) where
  inj := fun o => Sum.inl o
  prj := fun o x => x
instance {e e' : Effect} {r : Row} [i : Member e r] : Member e (Row.cons e' r) :=
  Member.mk (fun o => @Sum.inr e'.op (Union r) (@Member.inj e r i o)) (fun o x => @Member.prj e r i o x)

-- Perform an operation of an effect in the row.
def send (0 e : Effect) {r : Row} [i : Member e r] (o : e.op) : Eff r (e.ret o) :=
  @Eff.op r (e.ret o) (@Member.inj e r i o) (fun x => Eff.pure (@Member.prj e r i o x))

-- A computation with no effects left.
def Eff.run {A : Type} : Eff Row.nil A → A
  | .pure a => a
  | .op o k => absurd o

-- State.
inductive StateOp (S : Type) where
  | get
  | put (s : S)
def State (S : Type) : Effect := Effect.mk (StateOp S) (fun o => match o with
  | .get => S
  | .put _ => Unit)
def get {S : Type} {r : Row} [Member (State S) r] : Eff r S := send (State S) StateOp.get
def put {S : Type} {r : Row} [Member (State S) r] (s : S) : Eff r Unit := send (State S) (StateOp.put s)
def runState {S : Type} {r : Row} {A : Type} : Eff (Row.cons (State S) r) A → S → Eff r (A × S)
  | .pure a, s => Eff.pure (a, s)
  | .op (.inl .get) k, s => runState (k s) s
  | .op (.inl (.put s')) k, s => runState (k ()) s'
  | .op (.inr o) k, s => Eff.op o (fun x => runState (k x) s)

-- Reading an environment.
inductive ReaderOp where
  | ask
def Reader (E : Type) : Effect := Effect.mk ReaderOp (fun _ => E)
def ask {E : Type} {r : Row} [Member (Reader E) r] : Eff r E := send (Reader E) ReaderOp.ask
def runReader {E : Type} {r : Row} {A : Type} : Eff (Row.cons (Reader E) r) A → E → Eff r A
  | .pure a, _ => Eff.pure a
  | .op (.inl .ask) k, env => runReader (k env) env
  | .op (.inr o) k, env => Eff.op o (fun x => runReader (k x) env)

-- Exceptions: the handler stops at the first one.
inductive ExnOp (X : Type) where
  | throw (x : X)
def Exn (X : Type) : Effect := Effect.mk (ExnOp X) (fun _ => Empty)
def throw {X A : Type} {r : Row} [Member (Exn X) r] (x : X) : Eff r A :=
  Eff.bind (send (Exn X) (ExnOp.throw x)) (fun e => absurd e)
def runExn {X : Type} {r : Row} {A : Type} : Eff (Row.cons (Exn X) r) A → Eff r (Except X A)
  | .pure a => Eff.pure (Except.ok a)
  | .op (.inl (.throw x)) _ => Eff.pure (Except.error x)
  | .op (.inr o) k => Eff.op o (fun x => runExn (k x))

-- Output, handled by `IO` at the bottom of the row.
inductive ConsoleOp where
  | println (s : String)
def Console : Effect := Effect.mk ConsoleOp (fun _ => Unit)
def println {r : Row} [Member Console r] (s : String) : Eff r Unit := send Console (ConsoleOp.println s)
def runConsole {A : Type} : Eff (Row.cons Console Row.nil) A → IO A
  | .pure a => IO.pure a
  | .op (.inl (.println s)) k => Monad.bind (IO.println s) (fun u => runConsole (k u))
  | .op (.inr o) _ => absurd o

-- Lowering to a monad: every effect of the row is handled in the same monad `m`.
class Handler (e : Effect) (m : Type → Type) where
  handle : (o : e.op) → m (e.ret o)
class Handlers (r : Row) (m : Type → Type) where
  handleU : (o : Union r) → m (RetU r o)
instance {m : Type → Type} : Handlers Row.nil m where
  handleU := fun o => absurd o
instance {e : Effect} {r : Row} {m : Type → Type} [h : Handler e m] [hs : Handlers r m] : Handlers (Row.cons e r) m :=
  Handlers.mk (fun o => match o with
    | .inl o' => @Handler.handle e m h o'
    | .inr o' => @Handlers.handleU r m hs o')
def interpret {r : Row} {m : Type → Type} [i : Monad m] [hs : Handlers r m] {A : Type} : Eff r A → m A
  | .pure a => @Monad.pure m i A a
  | .op o k => @Monad.bind m i (RetU r o) A (@Handlers.handleU r m hs o) (fun x => interpret (k x))

-- Two effects commute in `m` when their operations can be swapped: a proof obligation,
-- checked by the kernel. Only then may a row be reordered.
class Commute (e₁ e₂ : Effect) (m : Type → Type) [i : Monad m] [h₁ : Handler e₁ m] [h₂ : Handler e₂ m] where
  comm : (o₁ : e₁.op) → (o₂ : e₂.op) → (B : Type) → (f : e₁.ret o₁ → e₂.ret o₂ → m B) →
    @Monad.bind m i (e₁.ret o₁) B (@Handler.handle e₁ m h₁ o₁)
      (fun a => @Monad.bind m i (e₂.ret o₂) B (@Handler.handle e₂ m h₂ o₂) (fun b => f a b)) =
    @Monad.bind m i (e₂.ret o₂) B (@Handler.handle e₂ m h₂ o₂)
      (fun b => @Monad.bind m i (e₁.ret o₁) B (@Handler.handle e₁ m h₁ o₁) (fun a => f a b))

-- Swap the first two effects of a row (the meaning in `m` is unchanged, by `comm`).
def Eff.swapU {e₁ e₂ : Effect} {r : Row} : Union (Row.cons e₁ (Row.cons e₂ r)) → Union (Row.cons e₂ (Row.cons e₁ r))
  | .inl o => .inr (.inl o)
  | .inr (.inl o) => .inl o
  | .inr (.inr o) => .inr (.inr o)
def reorder {e₁ e₂ : Effect} {r : Row} {m : Type → Type} [i : Monad m] [h₁ : Handler e₁ m] [h₂ : Handler e₂ m]
    [c : @Commute e₁ e₂ m i h₁ h₂] {A : Type} : Eff (Row.cons e₁ (Row.cons e₂ r)) A → Eff (Row.cons e₂ (Row.cons e₁ r)) A
  | .pure a => Eff.pure a
  | .op (.inl o) k => Eff.op (.inr (.inl o)) (fun x => reorder (k x))
  | .op (.inr (.inl o)) k => Eff.op (.inl o) (fun x => reorder (k x))
  | .op (.inr (.inr o)) k => Eff.op (.inr (.inr o)) (fun x => reorder (k x))

-- Fusion (stage 10b). Programs written against these classes run either as trees of
-- operations (the `Eff r` instances, with handlers) or directly in a monad (the
-- `StateT`/`ReaderT`/`IO` instances), where each operation is a plain call and no tree
-- is built: the handlers are fused into the program.
class MonadState (S : Type) (m : Type → Type) where
  getS : m S
  putS : S → m Unit
class MonadReader (E : Type) (m : Type → Type) where
  askR : m E
class MonadConsole (m : Type → Type) where
  printLn : String → m Unit

-- trees of operations
instance {S : Type} {r : Row} [i : Member (State S) r] : MonadState S (Eff r) :=
  MonadState.mk (@get S r i) (@put S r i)
instance {E : Type} {r : Row} [i : Member (Reader E) r] : MonadReader E (Eff r) :=
  MonadReader.mk (@ask E r i)
instance {r : Row} [i : Member Console r] : MonadConsole (Eff r) :=
  MonadConsole.mk (@println r i)

-- direct: monad transformers over IO
def StateT (S : Type) (m : Type → Type) (A : Type) : Type := S → m (A × S)
instance {S : Type} {m : Type → Type} [i : Monad m] : Monad (StateT S m) :=
  Monad.mk (fun a => fun s => @Monad.pure m i _ (a, s))
    (fun x f => fun s => @Monad.bind m i _ _ (x s) (fun p => f p.1 p.2))
instance {S : Type} {m : Type → Type} [i : Monad m] : MonadState S (StateT S m) :=
  MonadState.mk (fun s => @Monad.pure m i _ (s, s)) (fun s' => fun _ => @Monad.pure m i _ ((), s'))
instance {S : Type} {m : Type → Type} [i : Monad m] [c : MonadConsole m] : MonadConsole (StateT S m) :=
  MonadConsole.mk (fun str => fun s => @Monad.bind m i _ _ (@MonadConsole.printLn m c str) (fun u => @Monad.pure m i _ (u, s)))

def ReaderT (E : Type) (m : Type → Type) (A : Type) : Type := E → m A
instance {E : Type} {m : Type → Type} [i : Monad m] : Monad (ReaderT E m) :=
  Monad.mk (fun a => fun _ => @Monad.pure m i _ a) (fun x f => fun env => @Monad.bind m i _ _ (x env) (fun a => f a env))
instance {E : Type} {m : Type → Type} [i : Monad m] : MonadReader E (ReaderT E m) :=
  MonadReader.mk (fun env => @Monad.pure m i _ env)
instance {E : Type} {m : Type → Type} [c : MonadConsole m] : MonadConsole (ReaderT E m) :=
  MonadConsole.mk (fun str => fun _ => @MonadConsole.printLn m c str)

instance : MonadConsole IO := MonadConsole.mk IO.println

-- One-shot effects (CS4–6). The continuations of `Eff` are ω fields, so a computation
-- can't keep a linear resource (a channel endpoint, a token) in one: the resource would
-- be used any number of times. `Eff1 q r R A` is the same computations, Church-encoded
-- over an answer type `R`, whose handler gets each continuation at quantity 1: it must
-- resume exactly once (one-shot, as in OCaml 5), and in exchange a continuation may
-- capture linear resources. The result is used `q` times: `ω` for ordinary results,
-- `1` for a computation that hands back a linear resource. Handlers that resume twice
-- (backtracking) or never (exceptions) need `Eff`. (Church-encoded rather than a tree:
-- a linear field can't be matched back out of data yet, plan L2.) The effects, rows and
-- `Member` are those of `Eff`.
def Eff1 (q : Qty) (r : Row) (R A : Type) : Type :=
  (1 ret : (%q a : A) → R) → (h : (o : Union r) → (1 k : RetU r o → R) → R) → R
def Eff1.pure {q : Qty} {r : Row} {R A : Type} (%q a : A) : Eff1 q r R A := fun ret h => ret a
-- the continuation is used once; its argument as often as the first result allows
def Eff1.bind {q p : Qty} {r : Row} {R A B : Type} (1 x : Eff1 q r R A) (1 f : (%q a : A) → Eff1 p r R B) : Eff1 p r R B :=
  fun ret h => x (fun a => f a ret h) h
-- perform an operation of the row, then continue (once) with `k`
def Eff1.op {q : Qty} {r : Row} {R A : Type} (o : Union r) (1 k : RetU r o → Eff1 q r R A) : Eff1 q r R A :=
  fun ret h => h o (fun x => k x ret h)
instance {r : Row} {R : Type} : Monad (Eff1 ω r R) where
  pure := fun a => Eff1.pure a
  bind := fun x f => Eff1.bind x f
instance {r : Row} {R : Type} : Monad1 (Eff1 ω r R) where
  bind1 := fun x f => Eff1.bind x f
def send1 (0 e : Effect) {r : Row} {R : Type} [i : Member e r] (o : e.op) : Eff1 ω r R (e.ret o) :=
  fun ret h => h (@Member.inj e r i o) (fun x => ret (@Member.prj e r i o x))
-- A computation with no effects left (the continuation of an impossible operation is
-- still used once: `k (absurd o)`), with an unrestricted or a linear result.
def Eff1.run {A : Type} (1 m : Eff1 ω Row.nil A A) : A := m (fun a => a) (fun o k => k (absurd o))
def Eff1.run1 {A : Type} (1 m : Eff1 1 Row.nil A A) : A := m (fun a => a) (fun o k => k (absurd o))
-- Every multi-shot computation is a one-shot one (it captures no linear resource).
def Eff.toEff1 {r : Row} {R A : Type} : Eff r A → Eff1 ω r R A
  | .pure a => Eff1.pure a
  | .op o k => Eff1.op o (fun x => Eff.toEff1 (k x))

-- A one-shot handler of the first effect of the row: `ret` for the result, `h` for each
-- operation, given the rest of the computation (`k`) to run exactly once.
def Eff1.handle {q p : Qty} {e : Effect} {r : Row} {R A B : Type} (1 ret : (%q a : A) → Eff1 p r R B)
    (h : (o : e.op) → (1 k : e.ret o → Eff1 p r R B) → Eff1 p r R B)
    (1 m : Eff1 q (Row.cons e r) (Eff1 p r R B) A) : Eff1 p r R B :=
  m ret (fun o => match o with
    | .inl o' => fun k => h o' k
    | .inr o' => fun k => @Eff1.op p r R B o' k)

-- State, one-shot: the handler threads the state through the continuation.
def get1 {S : Type} {r : Row} {R : Type} [Member (State S) r] : Eff1 ω r R S := send1 (State S) StateOp.get
def put1 {S : Type} {r : Row} {R : Type} [Member (State S) r] (s : S) : Eff1 ω r R Unit := send1 (State S) (StateOp.put s)
-- the result and the final state
def runState1 {S : Type} {r : Row} {R A : Type} (1 m : Eff1 ω (Row.cons (State S) r) (S → Eff1 ω r R (A × S)) A) : S → Eff1 ω r R (A × S) :=
  m (fun a s => Eff1.pure (a, s)) (fun o => match o with
    | .inl .get => fun k s => k s s
    | .inl (.put s') => fun k _ => k () s'
    | .inr o' => fun k s => @Eff1.op ω r R (A × S) o' (fun x => k x s))
-- the result only, which may be linear
def evalState1 {q : Qty} {S : Type} {r : Row} {R A : Type} (1 m : Eff1 q (Row.cons (State S) r) (S → Eff1 q r R A) A) : S → Eff1 q r R A :=
  m (fun a _ => Eff1.pure a) (fun o => match o with
    | .inl .get => fun k s => k s s
    | .inl (.put s') => fun k _ => k () s'
    | .inr o' => fun k s => @Eff1.op q r R A o' (fun x => k x s))

-- Output, handled by `IO` (whose bind takes its continuation at quantity 1).
def println1 {r : Row} {R : Type} [Member Console r] (s : String) : Eff1 ω r R Unit := send1 Console (ConsoleOp.println s)
def runConsole1 {A : Type} (1 m : Eff1 ω (Row.cons Console Row.nil) (IO A) A) : IO A :=
  m IO.pure (fun o => match o with
    | .inl (.println s) => fun k => IO.bind (IO.println s) k
    | .inr o' => fun k => k (absurd o'))
