import Nat
import Word
/-!
# PMap

Persistent (immutable, structurally shared) maps and sets (`import PMap`): `PMap K V`
and `PSet K`. Every update returns a new value and leaves the old one valid; the two
share all the nodes the update did not touch, so an update allocates only the O(log n)
nodes on the path from the root to the changed leaf (plus a constant number for
rebalancing rotations).

The representation is a size-balanced binary search tree (a weight-balanced tree, after
Adams; the same scheme as Haskell's `Data.Map`), with the subtree size stored in each
node. Keys are ordered by a `Compare` instance: `compare k k'` is `.lt`, `.eq` or `.gt`.
Instances are provided for `Nat` and `U64`; any other key type gets one by defining its
`Compare` instance. (`U64Map` in lib/WordMap.wiz is the specialised, in-place when unique
map with a native hash-table backend; `PMap` is the pure model a future `U64Map` can be
defined against, see `wiz-notes/persistent-data.md`.)

```
import PMap

def m : PMap Nat String := PMap.fromList [(2, "two"), (1, "one")]
def m' : PMap Nat String := PMap.insert m 3 "three"
-- PMap.toList m  = [(1, "one"), (2, "two")]
-- PMap.toList m' = [(1, "one"), (2, "two"), (3, "three")]
```

The balance condition is a weight balance: with `sl` and `sr` the sizes of the children,
a node is balanced when `sl + sr ≤ 1` or both `sl ≤ 3 sr` and `sr ≤ 3 sl`; otherwise a
single or double rotation restores it. This bounds the height by about `2 log₂ n` and
keeps every operation O(log n) in the worst case, unlike an unbalanced BST, which
degenerates to a list on sorted keys.

`toList` is in key order and `fromList` accepts entries in any order. `foldl` visits the
entries in key order. The map keeps its invariant (one entry per key, the tree in order
and weight-balanced) internally: the constructor of `PMap` is private, and the module's
operations preserve it.

Laws (`find_empty`, `size_empty`) are proved on the definitions. The other expected laws
(`find_insert`, `find_erase`, `size_insert`) depend on the tree invariant surviving
rotations; they are checked by the tests (group `persistent`) rather than proved here.
-/

/-- The result of comparing two keys: `lt`, `eq` or `gt`. (lib/Nat.wiz's `Ordering`.) -/
-- (`Ordering` and `Nat.cmp` come from lib/Nat.wiz.)

/-- Keys with a total order. `compare a b` must be `.lt` exactly when `a < b`, `.eq`
exactly when `a = b`, and `.gt` otherwise. -/
class Compare (K : Type) where
  compare : K → K → Ordering

/-- Natural numbers are compared by `Nat.cmp`. -/
instance : Compare Nat := Compare.mk Nat.cmp

/-- Three-way comparison of 64-bit words (unsigned). -/
def U64.cmp (a b : U64) : Ordering := match UIntN.lt a b with
  | .true => .lt
  | .false => match UIntN.beq a b with
    | .true => .eq
    | .false => .gt
/-- 64-bit words are compared unsigned, by `U64.cmp`. -/
instance : Compare U64 := Compare.mk U64.cmp

-- ## The tree

/-- The tree behind a `PMap`: a leaf, or a node with its two subtrees, the entry and the
size of the subtree (so that `size` and the balance checks are O(1)). -/
inductive Tree (K V : Type) where
  | leaf
  | node (left : Tree K V) (key : K) (val : V) (right : Tree K V) (sz : Nat)

/-- The number of entries in a tree (read from the root, O(1)). -/
def Tree.size {K V : Type} : Tree K V → Nat
  | .leaf => .zero
  | .node _ _ _ _ n => n

/-- A node with its size computed from its subtrees. -/
def Tree.mkNode {K V : Type} (l : Tree K V) (k : K) (v : V) (r : Tree K V) : Tree K V :=
  .node l k v r (Nat.succ (Nat.add (Tree.size l) (Tree.size r)))

/-- The height (for diagnostics and the balance tests; O(n)). -/
def Tree.height {K V : Type} : Tree K V → Nat
  | .leaf => .zero
  | .node l _ _ r _ => Nat.succ (Nat.max (Tree.height l) (Tree.height r))

/-- A left rotation about the root (the right subtree is heavier). The single rotation is
used when the right child's left subtree is lighter than its right subtree; otherwise a
double rotation (through the right child's left child). -/
def Tree.rotateL {K V : Type} (l : Tree K V) (k : K) (v : V) (r : Tree K V) : Tree K V :=
  match r with
  | .leaf => Tree.mkNode l k v r
  | .node rl rk rv rr _ =>
    if Nat.lt (Tree.size rl) (Nat.mul 2 (Tree.size rr)) then
      Tree.mkNode (Tree.mkNode l k v rl) rk rv rr
    else match rl with
      | .leaf => Tree.mkNode (Tree.mkNode l k v rl) rk rv rr
      | .node rll rlk rlv rlr _ =>
        Tree.mkNode (Tree.mkNode l k v rll) rlk rlv (Tree.mkNode rlr rk rv rr)

/-- A right rotation about the root, the mirror image of `Tree.rotateL`. -/
def Tree.rotateR {K V : Type} (l : Tree K V) (k : K) (v : V) (r : Tree K V) : Tree K V :=
  match l with
  | .leaf => Tree.mkNode l k v r
  | .node ll lk lv lr _ =>
    if Nat.lt (Tree.size lr) (Nat.mul 2 (Tree.size ll)) then
      Tree.mkNode ll lk lv (Tree.mkNode lr k v r)
    else match lr with
      | .leaf => Tree.mkNode ll lk lv (Tree.mkNode lr k v r)
      | .node lrl lrk lrv lrr _ =>
        Tree.mkNode (Tree.mkNode ll lk lv lrl) lrk lrv (Tree.mkNode lrr k v r)

/-- A node from a key, a value and two subtrees, rebalanced when one side is more than
three times the other. -/
def Tree.balance {K V : Type} (l : Tree K V) (k : K) (v : V) (r : Tree K V) : Tree K V :=
  let sl := Tree.size l;
  let sr := Tree.size r;
  if Nat.lt (Nat.add sl sr) 2 then Tree.mkNode l k v r
  else if Nat.lt (Nat.mul 3 sl) sr then Tree.rotateL l k v r
  else if Nat.lt (Nat.mul 3 sr) sl then Tree.rotateR l k v r
  else Tree.mkNode l k v r

/-- Insert `k ↦ v`: replace the value when the key is there, otherwise add an entry.
Only the nodes on the search path are copied. -/
def Tree.insert {K V : Type} (cmp : K → K → Ordering) (k : K) (v : V) :
    Tree K V → Tree K V
  | .leaf => .node .leaf k v .leaf (Nat.succ .zero)
  | .node l kk vv r n => match cmp k kk with
    | .lt => Tree.balance (Tree.insert cmp k v l) kk vv r
    | .eq => .node l k v r n
    | .gt => Tree.balance l kk vv (Tree.insert cmp k v r)

/-- The smallest entry of a non-empty tree, and the tree without it. -/
def Tree.deleteMin {K V : Type} : Tree K V → Option (K × V × Tree K V)
  | .leaf => .none
  | .node .leaf k v r _ => .some (k, v, r)
  | .node l k v r _ => match Tree.deleteMin l with
    | .none => .some (k, v, r)
    | .some p => .some (p.1, p.2.1, Tree.balance p.2.2 k v r)

/-- Remove `k` (the map is unchanged when it is not there). -/
def Tree.erase {K V : Type} (cmp : K → K → Ordering) (k : K) : Tree K V → Tree K V
  | .leaf => .leaf
  | .node l kk vv r _ => match cmp k kk with
    | .lt => Tree.balance (Tree.erase cmp k l) kk vv r
    | .gt => Tree.balance l kk vv (Tree.erase cmp k r)
    | .eq => match l with
      | .leaf => r
      | .node _ _ _ _ _ => match r with
        | .leaf => l
        | .node _ _ _ _ _ => match Tree.deleteMin r with
          | .none => l
          | .some p => Tree.balance l p.1 p.2.1 p.2.2

/-- `k`'s value, if it is there. -/
def Tree.find {K V : Type} (cmp : K → K → Ordering) (k : K) : Tree K V → Option V
  | .leaf => .none
  | .node l kk vv r _ => match cmp k kk with
    | .lt => Tree.find cmp k l
    | .eq => .some vv
    | .gt => Tree.find cmp k r

/-- The entries by increasing key, in front of `acc`. -/
def Tree.toListOnto {K V : Type} : Tree K V → List (K × V) → List (K × V)
  | .leaf, acc => acc
  | .node l k v r _, acc => Tree.toListOnto l (.cons (k, v) (Tree.toListOnto r acc))

/-- The keys by increasing key, in front of `acc`. -/
def Tree.keysOnto {K V : Type} : Tree K V → List K → List K
  | .leaf, acc => acc
  | .node l k _ r _, acc => Tree.keysOnto l (.cons k (Tree.keysOnto r acc))

/-- `f (… (f b k₀ v₀) …) kₙ vₙ`, by increasing key. -/
def Tree.foldl {K V B : Type} (f : B → K → V → B) : Tree K V → B → B
  | .leaf, b => b
  | .node l k v r _, b => Tree.foldl f r (f (Tree.foldl f l b) k v)

-- ## PMap

/-- A persistent map from keys `K` to values `V`. The constructor is private: a `PMap`
always holds a well-formed (ordered, weight-balanced) search tree. -/
sealed inductive PMap (K V : Type) where
  | private mk (tree : Tree K V)

/-- The tree of a map (for the module's definitions). -/
def PMap.tree {K V : Type} : PMap K V → Tree K V
  | .mk t => t

/-- The empty map. -/
def PMap.empty {K V : Type} : PMap K V := .mk .leaf

/-- `m` with `k ↦ v` (replacing `k`'s value if it has one). The old map is unchanged. -/
def PMap.insert {K V : Type} [c : Compare K] (m : PMap K V) (k : K) (v : V) : PMap K V :=
  .mk (Tree.insert Compare.compare k v m.tree)

/-- `m` without `k` (unchanged when `k` is not there). The old map is unchanged. -/
def PMap.erase {K V : Type} [c : Compare K] (m : PMap K V) (k : K) : PMap K V :=
  .mk (Tree.erase Compare.compare k m.tree)

/-- `k`'s value, if it has one. -/
def PMap.find {K V : Type} [c : Compare K] (m : PMap K V) (k : K) : Option V :=
  Tree.find Compare.compare k m.tree

/-- `k`'s value, or `d`. -/
def PMap.findD {K V : Type} [c : Compare K] (m : PMap K V) (k : K) (d : V) : V :=
  match PMap.find m k with
  | .none => d
  | .some v => v

/-- Whether `k` is in the map. -/
def PMap.contains {K V : Type} [c : Compare K] (m : PMap K V) (k : K) : Bool :=
  match PMap.find m k with
  | .none => .false
  | .some _ => .true

/-- The number of entries (O(1)). -/
def PMap.size {K V : Type} (m : PMap K V) : Nat := Tree.size m.tree

/-- The height of the tree (O(n); for tests and diagnostics). -/
def PMap.height {K V : Type} (m : PMap K V) : Nat := Tree.height m.tree

/-- The entries by increasing key. -/
def PMap.toList {K V : Type} (m : PMap K V) : List (K × V) := Tree.toListOnto m.tree .nil

/-- The keys by increasing key. -/
def PMap.keys {K V : Type} (m : PMap K V) : List K := Tree.keysOnto m.tree .nil

/-- `f (… (f b k₀ v₀) …) kₙ vₙ`, by increasing key. -/
def PMap.foldl {K V B : Type} (f : B → K → V → B) (b : B) (m : PMap K V) : B :=
  Tree.foldl f m.tree b

/-- A map from a list of entries; a later entry for the same key wins. -/
def PMap.fromListAux {K V : Type} [c : Compare K] :
    List (K × V) → PMap K V → PMap K V
  | .nil, m => m
  | .cons e rest, m => PMap.fromListAux rest (PMap.insert m e.1 e.2)
def PMap.fromList {K V : Type} [c : Compare K] (l : List (K × V)) : PMap K V :=
  PMap.fromListAux l PMap.empty
/-- The same as `PMap.fromList`. -/
def PMap.ofList {K V : Type} [c : Compare K] (l : List (K × V)) : PMap K V :=
  PMap.fromList l

-- Laws that hold on the definitions (the constructor is a `mk` around the tree).

/-- The empty map has no entries. -/
def PMap.size_empty {K V : Type} : PMap.size (PMap.empty : PMap K V) = .zero := rfl
/-- Nothing is in the empty map. -/
def PMap.find_empty {K V : Type} [c : Compare K] (k : K) :
    PMap.find (PMap.empty : PMap K V) k = .none := rfl

-- ## PSet

/-- A persistent set of keys: a `PMap K Unit`. -/
def PSet (K : Type) : Type := PMap K Unit

/-- The empty set. -/
def PSet.empty {K : Type} : PSet K := PMap.empty

/-- `s` with `k` added (unchanged when `k` is already there). -/
def PSet.insert {K : Type} [c : Compare K] (s : PSet K) (k : K) : PSet K :=
  PMap.insert s k ()

/-- `s` without `k` (unchanged when `k` is not there). -/
def PSet.erase {K : Type} [c : Compare K] (s : PSet K) (k : K) : PSet K :=
  PMap.erase s k

/-- Whether `k` is in the set. -/
def PSet.contains {K : Type} [c : Compare K] (s : PSet K) (k : K) : Bool :=
  PMap.contains s k

/-- The number of elements (O(1)). -/
def PSet.size {K : Type} (s : PSet K) : Nat := PMap.size s

/-- The elements in increasing order. -/
def PSet.toList {K : Type} (s : PSet K) : List K := PMap.keys s

/-- `f (… (f b k₀) …) kₙ`, by increasing key. -/
def PSet.foldl {K B : Type} (f : B → K → B) (b : B) (s : PSet K) : B :=
  PMap.foldl (fun acc k _ => f acc k) b s

/-- A set from a list; duplicates are ignored. -/
def PSet.fromListAux {K : Type} [c : Compare K] : List K → PSet K → PSet K
  | .nil, s => s
  | .cons k rest, s => PSet.fromListAux rest (PSet.insert s k)
def PSet.fromList {K : Type} [c : Compare K] (l : List K) : PSet K :=
  PSet.fromListAux l PSet.empty

/-- The empty set has no elements. -/
def PSet.size_empty {K : Type} : PSet.size (PSet.empty : PSet K) = .zero := rfl
/-- Nothing is in the empty set. -/
def PSet.contains_empty {K : Type} [c : Compare K] (k : K) :
    PSet.contains (PSet.empty : PSet K) k = .false := rfl
