import Optic
import Deriving
-- `deriving Lens` (`import OpticDerive`): a lens per field of a structure, its laws, and
-- the independence of every two distinct fields. For `structure S Δ where f₁ : T₁ … fₙ : Tₙ`
-- it defines, with the parameters Δ implicit,
--
--     S.fL         : Lens (S Δ) T                       get `s.f`, put by rebuilding `S.mk …`
--     S.fL_lawful  : Lens.Lawful S.fL                    by `rfl`
--     S.f_g_indep  : Lens.Indep S.fL S.gL                for f before g, by `rfl`
--
-- the same names and statements as Feral's lowering of `struct` (lib/Feral.wiz,
-- `Fe.lensDefs`), so lowered code can use the deriver. The lenses are ordinary values:
-- for an HDL bundle (`structure Tx (r : HwTy → Type)`) `Tx.lineL : Lens (Tx r) (r Bit)` is
-- one lens at every representation, on values (proofs) and on wires (synthesis); see
-- lib/Hdl/Optic.wiz. Fields whose types depend on earlier fields are not supported (a
-- put would have to change the type). Design: /workspace/wiz-notes/cohesion-hardware.md 2.2.

-- `{0 x : T} → rest` for the parameters (erased: a field's get and put never need them)
def OpticDerive.pis : List ParamView → Syntax → Syntax
  | .nil, rest => rest
  | .cons p ps, rest =>
    let x := Syntax.mkIdent (ParamView.name p);
    let t := ParamView.type p;
    let b := OpticDerive.pis ps rest;
    `(term| {0 $x : $t} → $b)

-- the constructor's arguments, with `x` for field `target` and `s.g` for the others
def OpticDerive.mkArgs (s x : Syntax) (target : String) : List FieldView → List Syntax
  | .nil => .nil
  | .cons f fs => .cons (match String.beq (FieldView.name f) target with
      | .true => x
      | .false => Derive.proj s (FieldView.name f)) (OpticDerive.mkArgs s x target fs)

-- `@S.fL Δ`
def OpticDerive.lensRef (n : String) (delta : List Syntax) (f : String) : Syntax :=
  Syntax.mkApp (Syntax.mkNode "term.explicit" (.cons (.atom "@")
    (.cons (Syntax.mkIdent (String.append n (String.append "." (String.append f "L")))) .nil))) delta

def OpticDerive.indeps (n : String) (delta : List Syntax) (ps : List ParamView) (tyS : Syntax) (f : FieldView) :
    List FieldView → List Syntax
  | .nil => .nil
  | .cons g gs =>
    let nm := Syntax.mkIdent (String.append n (String.append "." (String.append (FieldView.name f)
      (String.append "_" (String.append (FieldView.name g) "_indep")))));
    let tf := FieldView.type f;
    let tg := FieldView.type g;
    let lf := OpticDerive.lensRef n delta (FieldView.name f);
    let lg := OpticDerive.lensRef n delta (FieldView.name g);
    let ty := OpticDerive.pis ps `(term| @Lens.Indep $tyS $tf $tg $lf $lg);
    .cons `(command| def $nm : $ty := (fun s a => rfl, fun s b => rfl, fun s a b => rfl))
      (OpticDerive.indeps n delta ps tyS f gs)

def OpticDerive.allIndeps (n : String) (delta : List Syntax) (ps : List ParamView) (tyS : Syntax) : List FieldView → List Syntax
  | .nil => .nil
  | .cons f fs => List.append (OpticDerive.indeps n delta ps tyS f fs) (OpticDerive.allIndeps n delta ps tyS fs)

def OpticDerive.lenses (n ctor : String) (delta : List Syntax) (ps : List ParamView) (tyS : Syntax) (all : List FieldView) :
    List FieldView → List Syntax
  | .nil => .nil
  | .cons f fs =>
    let fname := FieldView.name f;
    let lname := String.append n (String.append "." (String.append fname "L"));
    let nm := Syntax.mkIdent lname;
    let lawN := Syntax.mkIdent (String.append lname "_lawful");
    let t := FieldView.type f;
    let s := Syntax.mkIdent "s✝";
    let sv := Syntax.mkVar "s✝";
    let x := Syntax.mkIdent "x✝";
    let xv := Syntax.mkVar "x✝";
    let get := Derive.proj sv fname;
    let mk := Syntax.mkApp (Syntax.mkVar ctor) (OpticDerive.mkArgs sv xv fname all);
    let ty := OpticDerive.pis ps `(term| Lens $tyS $t);
    let l := OpticDerive.lensRef n delta fname;
    let lawTy := OpticDerive.pis ps `(term| @Lens.Lawful $tyS $t $l);
    .cons `(command| def $nm : $ty := fun $s => ($get, fun $x => $mk))
      (.cons `(command| def $lawN : $lawTy := (fun s => rfl, fun s a => rfl, fun s a b => rfl))
        (OpticDerive.lenses n ctor delta ps tyS all fs))

def deriveLens : Deriver := fun n => do
  v ← Derive.lookup "Lens" n;
  Derive.noIndices "Lens" v;
  match IndView.ctors v with
  | .cons c .nil => do
    let ps := IndView.params v;
    let delta := Derive.paramVars ps;
    let tyS := Syntax.mkApp (Syntax.mkVar n) delta;
    let fs := CtorView.fields c;
    MacroM.pure (List.append (OpticDerive.lenses n (Derive.ctorName v c) delta ps tyS fs fs)
      (OpticDerive.allIndeps n delta ps tyS fs))
  | _ => MacroM.throw (String.append "Lens: not a structure: " n)
attribute [deriver Lens] deriveLens
