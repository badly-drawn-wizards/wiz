import Int
import Ring
/-!
# IntRing

Equations of commutative rings at `Int`, decided by reflection, and the ring laws of
the integers (`import IntRing`):

```
import IntRing

def ex (a b : Int) : (a - b) * (a + b) = a * a - b * b :=
  int_ring! (a - b) * (a + b) = a * a - b * b
def comm (a b : Int) : a * b = b * a := Int.mul_comm a b
```

`int_ring! lhs = rhs` reads both sides as `IntExpr`s (`+`, `*`, binary and unary `-`,
parentheses, ascriptions and numerals; every other subterm is an atom, compared by its
syntax) and normalises them to polynomials with integer coefficients (`IntPoly`).

Its soundness needs the ring laws of `Int`, which are proved through the pair
representation: `Int.ofPair a b` is `a - b` for natural numbers `a`, `b`; every integer
is one (`Int.pair`), the operations act on pairs as on formal differences
(`Int.ofPair_add`, `Int.ofPair_mul`, …), and equal differences are equal integers
(`Int.ofPair_eq`). So an identity of integers becomes one of naturals, which `nat_ring!`
proves. `int_pair_ring!` does this by reflection; it is the slower bootstrap that
proves the lemmas behind `int_ring!`.

Main definitions: `int_ring!`; the laws `Int.add_comm`, `Int.add_assoc`,
`Int.mul_comm`, `Int.mul_assoc`, `Int.mul_add`, `Int.add_mul`, `Int.add_neg`,
`Int.sub_self`, `Int.neg_mul`, …; `Int.beq_eq`; the pair representation `Int.ofPair`.
The order is in lib/IntOrder.wiz.
-/

-- ## The pair representation

/-- The difference `a - b` of two natural numbers, as an integer. Every integer is
one (`Int.pair`), and `+`, `*` and `-` act on pairs as on formal differences. -/
def Int.ofPair (a b : Nat) : Int := Int.subNatNat a b
/-- `Int.subNatNat m n` is this match on `n - m`. -/
def Int.pairSel (d a : Nat) : Int := match d with
  | .zero => .ofNat a
  | .succ k => .negSucc k
/-- `Int.ofPair a b` unfolded: the match on `b - a`. -/
def Int.ofPair_sel (a b : Nat) : Int.ofPair a b = Int.pairSel (b - a) (a - b) := rfl

/-- The positive part of an integer (`0` for a negative one). -/
def Int.posPart : Int → Nat
  | .ofNat n => n
  | .negSucc _ => 0
/-- The negative part of an integer, as a natural number (`0` for a non-negative one). -/
def Int.negPart : Int → Nat
  | .ofNat _ => 0
  | .negSucc n => Nat.succ n

-- ## The pair representation

/-- Adding the same number to both components keeps the difference. -/
def Int.ofPair_add_right (a b k : Nat) : Int.ofPair (a + k) (b + k) = Int.ofPair a b :=
  congrArg2 Int.pairSel (Nat.add_sub_add_right b a k) (Nat.add_sub_add_right a b k)
/-- `(b + x) - b = x`. -/
def Int.ofPair_nat (b x : Nat) : Int.ofPair (b + x) b = Int.ofNat x :=
  congrArg2 Int.pairSel (Nat.sub_self_add b x) (Nat.add_sub_cancel_left b x)
/-- `a - (a + x + 1) = -(x + 1)`. -/
def Int.ofPair_neg (a x : Nat) : Int.ofPair a (a + Nat.succ x) = Int.negSucc x :=
  @Eq.trans Int (Int.ofPair a (a + Nat.succ x)) (Int.pairSel (Nat.succ x) 0) (Int.negSucc x)
    (congrArg2 Int.pairSel (Nat.add_sub_cancel_left a (Nat.succ x)) (Nat.sub_self_add a (Nat.succ x))) rfl
/-- `x = x - 0`. -/
def Int.ofNat_pair (x : Nat) : Int.ofNat x = Int.ofPair x 0 :=
  Eq.symm (Int.ofPair_nat 0 x)
/-- `-(x + 1) = 0 - (x + 1)`. -/
def Int.negSucc_pair (x : Nat) : Int.negSucc x = Int.ofPair 0 (Nat.succ x) := rfl
/-- Every integer is the difference of its positive and negative parts. -/
def Int.pair (a : Int) : a = Int.ofPair (Int.posPart a) (Int.negPart a) := match a with
  | .ofNat x => Int.ofNat_pair x
  | .negSucc x => Int.negSucc_pair x

/-- A difference `a - b` is a natural number `x` with `a = b + x`, or the negative
of a successor `x + 1` with `b = a + x + 1`. -/
def Int.ofPair_cases (a b : Nat) (0 P : Int → Prop)
    (h1 : (x : Nat) → a = b + x → P (Int.ofNat x))
    (h2 : (x : Nat) → b = a + Nat.succ x → P (Int.negSucc x)) : P (Int.ofPair a b) :=
  Or.elim (Bool.cases (Nat.le b a))
    (fun (h : Nat.le b a = .true) =>
      let e : b + (a - b) = a := Nat.add_sub_of_le b a h;
      Eq.mpr' P (Eq.trans (congrArg (fun y => Int.ofPair y b) (Eq.symm e)) (Int.ofPair_nat b (a - b)))
        (h1 (a - b) (Eq.symm e)))
    (fun (h : Nat.le b a = .false) =>
      let e : Nat.succ a + (b - Nat.succ a) = b := Nat.add_sub_of_le (Nat.succ a) b (Nat.not_le b a h);
      let e' : b = a + Nat.succ (b - Nat.succ a) := Eq.trans (Eq.symm e) (Eq.symm (Nat.add_succ a (b - Nat.succ a)));
      Eq.mpr' P (Eq.trans (congrArg (fun y => Int.ofPair a y) e') (Int.ofPair_neg a (b - Nat.succ a)))
        (h2 (b - Nat.succ a) e'))

/-- Equal differences give equal integers: `a + d = c + b → a - b = c - d`. -/
def Int.ofPair_eq (a b c d : Nat) (h : a + d = c + b) : Int.ofPair a b = Int.ofPair c d :=
  Int.ofPair_cases a b (fun i => i = Int.ofPair c d)
    (fun x ea =>
      -- c + b = b + x + d, so c = d + x
      let ec : c = d + x := Nat.add_right_cancel (Eq.trans (Eq.symm h)
        (Eq.trans (congrArg (fun y => y + d) ea) (nat_ring! b + x + d = d + x + b)));
      Eq.symm (Eq.trans (congrArg (fun y => Int.ofPair y d) ec) (Int.ofPair_nat d x)))
    (fun x eb =>
      -- a + d = c + a + succ x, so d = c + succ x
      let ed : d = c + Nat.succ x := Nat.add_left_cancel a (Eq.trans h
        (Eq.trans (congrArg (fun y => c + y) eb) (nat_ring! c + (a + Nat.succ x) = a + (c + Nat.succ x))));
      Eq.symm (Eq.trans (congrArg (fun y => Int.ofPair c y) ed) (Int.ofPair_neg c x)))

-- ## Operations on pairs

/-- `-n = 0 - n`. -/
def Int.negOfNat_pair : (n : Nat) → Int.negOfNat n = Int.ofPair 0 n
  | .zero => rfl
  | .succ _ => rfl
/-- `-(a - b) = b - a`. -/
def Int.ofPair_negate (a b : Nat) : -(Int.ofPair a b) = Int.ofPair b a :=
  Int.ofPair_cases a b (fun i => -i = Int.ofPair b a)
    (fun (x : Nat) (ea : a = b + x) =>
      Eq.trans (Int.negOfNat_pair x)
        (Int.ofPair_eq 0 x b a ea))
    (fun (x : Nat) (eb : b = a + Nat.succ x) =>
      Eq.trans (Int.ofNat_pair (Nat.succ x))
        (Int.ofPair_eq (Nat.succ x) 0 b a
          (Eq.trans (nat_ring! Nat.succ x + a = a + Nat.succ x + 0) (congrArg (fun y => y + 0) (Eq.symm eb)))))

/-- `(a - b) + (c - d) = (a + c) - (b + d)`. -/
def Int.ofPair_add (a b c d : Nat) : Int.ofPair a b + Int.ofPair c d = Int.ofPair (a + c) (b + d) :=
  Int.ofPair_cases a b (fun i => i + Int.ofPair c d = Int.ofPair (a + c) (b + d))
    (fun (x : Nat) (ea : a = b + x) =>
      Int.ofPair_cases c d (fun j => Int.ofNat x + j = Int.ofPair (a + c) (b + d))
        (fun (y : Nat) (ec : c = d + y) =>
          Eq.trans (Int.ofNat_pair (x + y)) (Int.ofPair_eq (x + y) 0 (a + c) (b + d)
            (Eq.trans (nat_ring! x + y + (b + d) = b + x + (d + y) + 0)
              (congrArg2 (fun p q => p + q + 0) (Eq.symm ea) (Eq.symm ec)))))
        (fun (y : Nat) (ed : d = c + Nat.succ y) =>
          Int.ofPair_eq x (Nat.succ y) (a + c) (b + d)
            (Eq.trans (congrArg (fun q => x + (b + q)) ed)
              (Eq.trans (nat_ring! x + (b + (c + Nat.succ y)) = b + x + c + Nat.succ y)
                (congrArg (fun p => p + c + Nat.succ y) (Eq.symm ea))))))
    (fun (x : Nat) (eb : b = a + Nat.succ x) =>
      Int.ofPair_cases c d (fun j => Int.negSucc x + j = Int.ofPair (a + c) (b + d))
        (fun (y : Nat) (ec : c = d + y) =>
          Int.ofPair_eq y (Nat.succ x) (a + c) (b + d)
            (Eq.trans (congrArg (fun p => y + (p + d)) eb)
              (Eq.trans (nat_ring! y + (a + Nat.succ x + d) = a + (d + y) + Nat.succ x)
                (congrArg (fun q => a + q + Nat.succ x) (Eq.symm ec)))))
        (fun (y : Nat) (ed : d = c + Nat.succ y) =>
          Int.ofPair_eq 0 (Nat.succ (Nat.succ (x + y))) (a + c) (b + d)
            (Eq.trans (congrArg2 (fun p q => 0 + (p + q)) eb ed)
              (nat_ring! 0 + (a + Nat.succ x + (c + Nat.succ y)) = a + c + Nat.succ (Nat.succ (x + y))))))

/-- `(a - b) · (c - d) = (a·c + b·d) - (a·d + b·c)`. -/
def Int.ofPair_mul (a b c d : Nat) :
    Int.ofPair a b * Int.ofPair c d = Int.ofPair (a * c + b * d) (a * d + b * c) :=
  Int.ofPair_cases a b (fun i => i * Int.ofPair c d = Int.ofPair (a * c + b * d) (a * d + b * c))
    (fun (x : Nat) (ea : a = b + x) =>
      Int.ofPair_cases c d (fun j => Int.ofNat x * j = Int.ofPair (a * c + b * d) (a * d + b * c))
        (fun (y : Nat) (ec : c = d + y) =>
          Eq.trans (Int.ofNat_pair (x * y)) (Int.ofPair_eq (x * y) 0 (a * c + b * d) (a * d + b * c)
            (Eq.trans (congrArg2 (fun p q => x * y + (p * d + b * q)) ea ec)
              (Eq.trans (nat_ring! x * y + ((b + x) * d + b * (d + y)) = (b + x) * (d + y) + b * d + 0)
                (congrArg2 (fun p q => p * q + b * d + 0) (Eq.symm ea) (Eq.symm ec))))))
        (fun (y : Nat) (ed : d = c + Nat.succ y) =>
          Eq.trans (Int.negOfNat_pair (x * Nat.succ y)) (Int.ofPair_eq 0 (x * Nat.succ y) (a * c + b * d) (a * d + b * c)
            (Eq.trans (congrArg2 (fun p q => 0 + (p * q + b * c)) ea ed)
              (Eq.trans (nat_ring! 0 + ((b + x) * (c + Nat.succ y) + b * c) = (b + x) * c + b * (c + Nat.succ y) + x * Nat.succ y)
                (congrArg2 (fun p q => p * c + b * q + x * Nat.succ y) (Eq.symm ea) (Eq.symm ed)))))))
    (fun (x : Nat) (eb : b = a + Nat.succ x) =>
      Int.ofPair_cases c d (fun j => Int.negSucc x * j = Int.ofPair (a * c + b * d) (a * d + b * c))
        (fun (y : Nat) (ec : c = d + y) =>
          Eq.trans (Int.negOfNat_pair (Nat.succ x * y)) (Int.ofPair_eq 0 (Nat.succ x * y) (a * c + b * d) (a * d + b * c)
            (Eq.trans (congrArg2 (fun p q => 0 + (a * d + p * q)) eb ec)
              (Eq.trans (nat_ring! 0 + (a * d + (a + Nat.succ x) * (d + y)) = a * (d + y) + (a + Nat.succ x) * d + Nat.succ x * y)
                (congrArg2 (fun p q => a * q + p * d + Nat.succ x * y) (Eq.symm eb) (Eq.symm ec))))))
        (fun (y : Nat) (ed : d = c + Nat.succ y) =>
          Eq.trans (Int.ofNat_pair (Nat.succ x * Nat.succ y)) (Int.ofPair_eq (Nat.succ x * Nat.succ y) 0 (a * c + b * d) (a * d + b * c)
            (Eq.trans (congrArg2 (fun p q => Nat.succ x * Nat.succ y + (a * q + p * c)) eb ed)
              (Eq.trans (nat_ring! Nat.succ x * Nat.succ y + (a * (c + Nat.succ y) + (a + Nat.succ x) * c) = a * c + (a + Nat.succ x) * (c + Nat.succ y) + 0)
                (congrArg2 (fun p q => a * c + p * q + 0) (Eq.symm eb) (Eq.symm ed)))))))

/-- `(a - b) - (c - d) = (a + d) - (b + c)`. -/
def Int.ofPair_sub (a b c d : Nat) : Int.ofPair a b - Int.ofPair c d = Int.ofPair (a + d) (b + c) :=
  Eq.trans (congrArg (fun y => Int.ofPair a b + y) (Int.ofPair_negate c d)) (Int.ofPair_add a b d c)

-- ## The bootstrap normaliser, through pairs of naturals

/-- An expression of a commutative ring over atoms (`int_ring!`). -/
inductive IntExpr where
  | atom (i : Nat)
  | lit (n : Nat)
  | add (a b : IntExpr)
  | mul (a b : IntExpr)
  | neg (a : IntExpr)
  | sub (a b : IntExpr)

/-- The `i`-th atom of the environment (`0` past its end). -/
def IntExpr.get : List Int → Nat → Int
  | .nil, _ => 0
  | .cons x _, .zero => x
  | .cons _ xs, .succ i => IntExpr.get xs i

/-- The value of an expression at `Int`, given the atoms. -/
def IntExpr.eval (ρ : List Int) : IntExpr → Int
  | .atom i => IntExpr.get ρ i
  | .lit n => Int.ofNat n
  | .add a b => IntExpr.eval ρ a + IntExpr.eval ρ b
  | .mul a b => IntExpr.eval ρ a * IntExpr.eval ρ b
  | .neg a => -(IntExpr.eval ρ a)
  | .sub a b => IntExpr.eval ρ a - IntExpr.eval ρ b

/-- The environment of natural numbers for the pair translation: each atom gives
its positive and its negative part. -/
def IntExpr.env : List Int → List Nat
  | .nil => .nil
  | .cons a ρ => .cons (Int.posPart a) (.cons (Int.negPart a) (IntExpr.env ρ))

/-- An expression as a pair of `NatExpr`s whose difference it is (atom `i`
becomes the difference of the atoms `2i` and `2i+1`). -/
def IntExpr.toPair : IntExpr → NatExpr × NatExpr
  | .atom i => (.atom (i + i), .atom (Nat.succ (i + i)))
  | .lit n => (.lit n, .lit 0)
  | .add a b => (.add (IntExpr.toPair a).1 (IntExpr.toPair b).1, .add (IntExpr.toPair a).2 (IntExpr.toPair b).2)
  | .mul a b =>
    (.add (.mul (IntExpr.toPair a).1 (IntExpr.toPair b).1) (.mul (IntExpr.toPair a).2 (IntExpr.toPair b).2),
     .add (.mul (IntExpr.toPair a).1 (IntExpr.toPair b).2) (.mul (IntExpr.toPair a).2 (IntExpr.toPair b).1))
  | .neg a => ((IntExpr.toPair a).2, (IntExpr.toPair a).1)
  | .sub a b => (.add (IntExpr.toPair a).1 (IntExpr.toPair b).2, .add (IntExpr.toPair a).2 (IntExpr.toPair b).1)

/-- The atoms `2i` and `2i+1` of `IntExpr.env ρ` are the parts of atom `i`. -/
def IntExpr.env_get : (ρ : List Int) → (i : Nat) →
    (NatExpr.get (IntExpr.env ρ) (i + i) = Int.posPart (IntExpr.get ρ i)) ∧ (NatExpr.get (IntExpr.env ρ) (Nat.succ (i + i)) = Int.negPart (IntExpr.get ρ i))
  | .nil, _ => (rfl, rfl)
  | .cons _ _, .zero => (rfl, rfl)
  | .cons a ρ, .succ i =>
    -- succ i + succ i = succ (succ (i + i))
    let e : Nat.succ i + Nat.succ i = Nat.succ (Nat.succ (i + i)) := congrArg Nat.succ (Nat.add_succ i i);
    let ih := IntExpr.env_get ρ i;
    (Eq.trans (congrArg (NatExpr.get (IntExpr.env (.cons a ρ))) e) ih.1,
     Eq.trans (congrArg (fun j => NatExpr.get (IntExpr.env (.cons a ρ)) (Nat.succ j)) e) ih.2)

/-- An expression is the difference of the values of its pair. -/
def IntExpr.sound (ρ : List Int) : (e : IntExpr) →
    IntExpr.eval ρ e = Int.ofPair (NatExpr.eval (IntExpr.env ρ) (IntExpr.toPair e).1) (NatExpr.eval (IntExpr.env ρ) (IntExpr.toPair e).2)
  | .atom i =>
    let h := IntExpr.env_get ρ i;
    Eq.trans (Int.pair (IntExpr.get ρ i)) (congrArg2 Int.ofPair (Eq.symm h.1) (Eq.symm h.2))
  | .lit n => Int.ofNat_pair n
  | .add a b =>
    Eq.trans (congrArg2 (fun x y => x + y) (IntExpr.sound ρ a) (IntExpr.sound ρ b)) (Int.ofPair_add _ _ _ _)
  | .mul a b =>
    Eq.trans (congrArg2 (fun x y => x * y) (IntExpr.sound ρ a) (IntExpr.sound ρ b)) (Int.ofPair_mul _ _ _ _)
  | .neg a => Eq.trans (congrArg (fun x => -x) (IntExpr.sound ρ a)) (Int.ofPair_negate _ _)
  | .sub a b =>
    Eq.trans (congrArg2 (fun x y => x - y) (IntExpr.sound ρ a) (IntExpr.sound ρ b)) (Int.ofPair_sub _ _ _ _)

/-- The bootstrap decision procedure: two expressions are equal when `p₁ + q₂`
and `q₁ + p₂` have the same normal form as `NatExpr`s. -/
def IntExpr.provePairs (ρ : List Int) (a b : IntExpr)
    (h : NatPoly.beq (NatExpr.norm (.add (IntExpr.toPair a).1 (IntExpr.toPair b).2)) (NatExpr.norm (.add (IntExpr.toPair b).1 (IntExpr.toPair a).2)) = .true) :
    IntExpr.eval ρ a = IntExpr.eval ρ b :=
  Eq.trans (IntExpr.sound ρ a)
    (Eq.trans (Int.ofPair_eq _ _ _ _ (NatExpr.prove (IntExpr.env ρ) (.add (IntExpr.toPair a).1 (IntExpr.toPair b).2) (.add (IntExpr.toPair b).1 (IntExpr.toPair a).2) h))
      (Eq.symm (IntExpr.sound ρ b)))

/-- `x = y` by the bootstrap procedure, as `NatExpr.proveAt`. `int_pair_ring!`
expands to this. It is slower than `int_ring!`; it proves the lemmas `int_ring!`
needs. -/
def IntExpr.provePairsAt (x y : Int) (ρ : List Int) (a b : IntExpr) (hx : IntExpr.eval ρ a = x) (hy : IntExpr.eval ρ b = y)
    (h : NatPoly.beq (NatExpr.norm (.add (IntExpr.toPair a).1 (IntExpr.toPair b).2)) (NatExpr.norm (.add (IntExpr.toPair b).1 (IntExpr.toPair a).2)) = .true) :
    x = y :=
  Eq.trans (Eq.symm hx) (Eq.trans (IntExpr.provePairs ρ a b h) hy)
/-- The macro behind `int_pair_ring!`. -/
def IntPairRing.expand : Macro := fun stx => Ring.Reify.expandWith "IntExpr" "provePairsAt" stx
syntax:lead (name := intPairRing) "int_pair_ring!" term : term
attribute [macro term.intPairRing] IntPairRing.expand

-- ## The normaliser with integer coefficients

/-- `Int.beq` decides equality. -/
def Int.beq_eq : (a b : Int) → Int.beq a b = .true → a = b
  | .ofNat m, .ofNat n, h => congrArg Int.ofNat (Nat.beq_eq m n h)
  | .negSucc m, .negSucc n, h => congrArg Int.negSucc (Nat.beq_eq m n h)
  | .ofNat _, .negSucc _, h => absurd h.1
  | .negSucc _, .ofNat _, h => absurd h.1

/-- The product of the atoms of a key, at `Int`. -/
def IntPoly.keyProd (ρ : List Int) : List Nat → Int
  | .nil => 1
  | .cons i xs => IntExpr.get ρ i * IntPoly.keyProd ρ xs

/-- A normal form: monomials (integer coefficient, key), sorted by key, with
distinct keys and no zero coefficients. -/
def IntPoly : Type := List (Int × List Nat)

/-- The value of a polynomial, given the atoms. -/
def IntPoly.eval (ρ : List Int) : IntPoly → Int
  | .nil => 0
  | .cons m p => m.1 * IntPoly.keyProd ρ m.2 + IntPoly.eval ρ p

/-- Adding to a monomial with the same key: the coefficients add up, and the
monomial goes if they cancel (`b`). -/
def IntPoly.addEq : Bool → Int → List Nat → IntPoly → IntPoly
  | .true, _, _, p => p
  | .false, c, xs, p => .cons (c, xs) p
/-- One step of `IntPoly.addMono`, given how `xs` compares with the head's key `ys`;
`rec` is the result for the tail. -/
def IntPoly.addMonoO : Ordering → Int → List Nat → Int → List Nat → IntPoly → IntPoly → IntPoly
  | .lt, c, xs, d, ys, p, _ => .cons (c, xs) (.cons (d, ys) p)
  | .eq, c, xs, d, _, p, _ => IntPoly.addEq (Int.beq (c + d) 0) (c + d) xs p
  | .gt, _, _, d, ys, _, rec => .cons (d, ys) rec
/-- Add the monomial `c·xs` to a polynomial, keeping it sorted. -/
def IntPoly.addMono (c : Int) (xs : List Nat) : IntPoly → IntPoly
  | .nil => .cons (c, xs) .nil
  | .cons m p => IntPoly.addMonoO (Ring.Key.cmp xs m.2) c xs m.1 m.2 p (IntPoly.addMono c xs p)
/-- The sum of two polynomials. -/
def IntPoly.add : IntPoly → IntPoly → IntPoly
  | .nil, q => q
  | .cons m p, q => IntPoly.addMono m.1 m.2 (IntPoly.add p q)
/-- The product of the monomial `c·xs` and a polynomial. -/
def IntPoly.mulMono (c : Int) (xs : List Nat) : IntPoly → IntPoly
  | .nil => .nil
  | .cons m q => IntPoly.addMono (c * m.1) (Ring.Key.merge xs m.2) (IntPoly.mulMono c xs q)
/-- The product of two polynomials. -/
def IntPoly.mul : IntPoly → IntPoly → IntPoly
  | .nil, _ => .nil
  | .cons m p, q => IntPoly.add (IntPoly.mulMono m.1 m.2 q) (IntPoly.mul p q)
/-- A constant polynomial of a natural number. -/
def IntPoly.const : Nat → IntPoly
  | .zero => .nil
  | .succ n => .cons (Int.ofNat (.succ n), .nil) .nil

/-- The normal form of an expression. -/
def IntExpr.norm : IntExpr → IntPoly
  | .atom i => .cons (1, .cons i .nil) .nil
  | .lit n => IntPoly.const n
  | .add a b => IntPoly.add (IntExpr.norm a) (IntExpr.norm b)
  | .mul a b => IntPoly.mul (IntExpr.norm a) (IntExpr.norm b)
  | .neg a => IntPoly.mulMono (-1) .nil (IntExpr.norm a)
  | .sub a b => IntPoly.add (IntExpr.norm a) (IntPoly.mulMono (-1) .nil (IntExpr.norm b))

-- ## Soundness

/-- Soundness of `Ring.Key.insertB` at `Int`. -/
def IntPoly.keyProd_insertB (ρ : List Int) (x y : Nat) (ys rec : List Nat)
    (ih : IntPoly.keyProd ρ rec = IntExpr.get ρ x * IntPoly.keyProd ρ ys) :
    (b : Bool) → IntPoly.keyProd ρ (Ring.Key.insertB b x y ys rec) = IntExpr.get ρ x * (IntExpr.get ρ y * IntPoly.keyProd ρ ys)
  | .true => rfl
  | .false => Eq.trans (congrArg (fun z => IntExpr.get ρ y * z) ih)
                (int_pair_ring! IntExpr.get ρ y * (IntExpr.get ρ x * IntPoly.keyProd ρ ys) = IntExpr.get ρ x * (IntExpr.get ρ y * IntPoly.keyProd ρ ys))
/-- Inserting an atom multiplies the product by it. -/
def IntPoly.keyProd_insert (ρ : List Int) (x : Nat) : (ys : List Nat) →
    IntPoly.keyProd ρ (Ring.Key.insert x ys) = IntExpr.get ρ x * IntPoly.keyProd ρ ys
  | .nil => rfl
  | .cons y ys => IntPoly.keyProd_insertB ρ x y ys (Ring.Key.insert x ys) (IntPoly.keyProd_insert ρ x ys) (Nat.le x y)
/-- The product of merged keys is the product of the products. -/
def IntPoly.keyProd_merge (ρ : List Int) : (xs ys : List Nat) →
    IntPoly.keyProd ρ (Ring.Key.merge xs ys) = IntPoly.keyProd ρ xs * IntPoly.keyProd ρ ys
  | .nil, ys => int_pair_ring! IntPoly.keyProd ρ ys = 1 * IntPoly.keyProd ρ ys
  | .cons x xs, ys =>
    Eq.trans (IntPoly.keyProd_insert ρ x (Ring.Key.merge xs ys))
      (Eq.trans (congrArg (fun z => IntExpr.get ρ x * z) (IntPoly.keyProd_merge ρ xs ys))
        (int_pair_ring! IntExpr.get ρ x * (IntPoly.keyProd ρ xs * IntPoly.keyProd ρ ys) = IntExpr.get ρ x * IntPoly.keyProd ρ xs * IntPoly.keyProd ρ ys))

/-- Soundness of `IntPoly.addEq`. -/
def IntPoly.eval_addEq (ρ : List Int) (s : Int) (xs : List Nat) (p : IntPoly) :
    (b : Bool) → Int.beq s 0 = b → IntPoly.eval ρ (IntPoly.addEq b s xs p) = s * IntPoly.keyProd ρ xs + IntPoly.eval ρ p
  | .true, h =>
    Eq.trans (int_pair_ring! IntPoly.eval ρ p = 0 * IntPoly.keyProd ρ xs + IntPoly.eval ρ p)
      (congrArg (fun z => z * IntPoly.keyProd ρ xs + IntPoly.eval ρ p) (Eq.symm (Int.beq_eq s 0 h)))
  | .false, _ => rfl
/-- Soundness of `IntPoly.addMonoO`. -/
def IntPoly.eval_addMonoO (ρ : List Int) (c : Int) (xs : List Nat) (d : Int) (ys : List Nat) (p rec : IntPoly)
    (ih : IntPoly.eval ρ rec = c * IntPoly.keyProd ρ xs + IntPoly.eval ρ p) :
    (o : Ordering) → Ring.Key.cmp xs ys = o →
    IntPoly.eval ρ (IntPoly.addMonoO o c xs d ys p rec) = c * IntPoly.keyProd ρ xs + (d * IntPoly.keyProd ρ ys + IntPoly.eval ρ p)
  | .lt, _ => rfl
  | .eq, h =>
    let e := Ring.Key.cmp_eq xs ys h;
    Eq.trans (IntPoly.eval_addEq ρ (c + d) xs p (Int.beq (c + d) 0) rfl)
      (Eq.trans (int_pair_ring! (c + d) * IntPoly.keyProd ρ xs + IntPoly.eval ρ p = c * IntPoly.keyProd ρ xs + (d * IntPoly.keyProd ρ xs + IntPoly.eval ρ p))
        (congrArg (fun (zs : List Nat) => c * IntPoly.keyProd ρ xs + (d * IntPoly.keyProd ρ zs + IntPoly.eval ρ p)) e))
  | .gt, _ =>
    Eq.trans (congrArg (fun z => d * IntPoly.keyProd ρ ys + z) ih)
      (int_pair_ring! d * IntPoly.keyProd ρ ys + (c * IntPoly.keyProd ρ xs + IntPoly.eval ρ p) = c * IntPoly.keyProd ρ xs + (d * IntPoly.keyProd ρ ys + IntPoly.eval ρ p))
/-- Adding a monomial adds its value. -/
def IntPoly.eval_addMono (ρ : List Int) (c : Int) (xs : List Nat) : (p : IntPoly) →
    IntPoly.eval ρ (IntPoly.addMono c xs p) = c * IntPoly.keyProd ρ xs + IntPoly.eval ρ p
  | .nil => rfl
  | .cons m p =>
    IntPoly.eval_addMonoO ρ c xs m.1 m.2 p (IntPoly.addMono c xs p) (IntPoly.eval_addMono ρ c xs p) (Ring.Key.cmp xs m.2) rfl
/-- `IntPoly.add` is addition. -/
def IntPoly.eval_add (ρ : List Int) : (p q : IntPoly) → IntPoly.eval ρ (IntPoly.add p q) = IntPoly.eval ρ p + IntPoly.eval ρ q
  | .nil, q => int_pair_ring! IntPoly.eval ρ q = 0 + IntPoly.eval ρ q
  | .cons m p, q =>
    Eq.trans (IntPoly.eval_addMono ρ m.1 m.2 (IntPoly.add p q))
      (Eq.trans (congrArg (fun z => m.1 * IntPoly.keyProd ρ m.2 + z) (IntPoly.eval_add ρ p q))
        (int_pair_ring! m.1 * IntPoly.keyProd ρ m.2 + (IntPoly.eval ρ p + IntPoly.eval ρ q) = m.1 * IntPoly.keyProd ρ m.2 + IntPoly.eval ρ p + IntPoly.eval ρ q))
/-- Multiplying by a monomial multiplies by its value. -/
def IntPoly.eval_mulMono (ρ : List Int) (c : Int) (xs : List Nat) : (q : IntPoly) →
    IntPoly.eval ρ (IntPoly.mulMono c xs q) = c * IntPoly.keyProd ρ xs * IntPoly.eval ρ q
  | .nil => Eq.symm (int_pair_ring! c * IntPoly.keyProd ρ xs * 0 = 0)
  | .cons m q =>
    Eq.trans (IntPoly.eval_addMono ρ (c * m.1) (Ring.Key.merge xs m.2) (IntPoly.mulMono c xs q))
      (Eq.trans
        (congrArg2 (fun y z => c * m.1 * y + z) (IntPoly.keyProd_merge ρ xs m.2) (IntPoly.eval_mulMono ρ c xs q))
        (int_pair_ring! c * m.1 * (IntPoly.keyProd ρ xs * IntPoly.keyProd ρ m.2) + c * IntPoly.keyProd ρ xs * IntPoly.eval ρ q
           = c * IntPoly.keyProd ρ xs * (m.1 * IntPoly.keyProd ρ m.2 + IntPoly.eval ρ q)))
/-- `IntPoly.mul` is multiplication. -/
def IntPoly.eval_mul (ρ : List Int) : (p q : IntPoly) → IntPoly.eval ρ (IntPoly.mul p q) = IntPoly.eval ρ p * IntPoly.eval ρ q
  | .nil, q => Eq.symm (int_pair_ring! 0 * IntPoly.eval ρ q = 0)
  | .cons m p, q =>
    Eq.trans (IntPoly.eval_add ρ (IntPoly.mulMono m.1 m.2 q) (IntPoly.mul p q))
      (Eq.trans (congrArg2 (fun y z => y + z) (IntPoly.eval_mulMono ρ m.1 m.2 q) (IntPoly.eval_mul ρ p q))
        (int_pair_ring! m.1 * IntPoly.keyProd ρ m.2 * IntPoly.eval ρ q + IntPoly.eval ρ p * IntPoly.eval ρ q
           = (m.1 * IntPoly.keyProd ρ m.2 + IntPoly.eval ρ p) * IntPoly.eval ρ q))
/-- A constant polynomial evaluates to its constant. -/
def IntPoly.eval_const (ρ : List Int) : (n : Nat) → IntPoly.eval ρ (IntPoly.const n) = Int.ofNat n
  | .zero => rfl
  | .succ n => int_pair_ring! Int.ofNat (Nat.succ n) * 1 + 0 = Int.ofNat (Nat.succ n)
/-- Multiplying by `-1` negates. -/
def IntPoly.eval_neg (ρ : List Int) (p : IntPoly) : IntPoly.eval ρ (IntPoly.mulMono (-1) .nil p) = -(IntPoly.eval ρ p) :=
  Eq.trans (IntPoly.eval_mulMono ρ (-1) .nil p) (int_pair_ring! (-1 : Int) * 1 * IntPoly.eval ρ p = -(IntPoly.eval ρ p))

/-- Soundness of the normal form: it has the value of the expression. -/
def IntExpr.eval_norm (ρ : List Int) : (e : IntExpr) → IntPoly.eval ρ (IntExpr.norm e) = IntExpr.eval ρ e
  | .atom i => int_pair_ring! 1 * (IntExpr.get ρ i * 1) + 0 = IntExpr.get ρ i
  | .lit n => IntPoly.eval_const ρ n
  | .add a b => Eq.trans (IntPoly.eval_add ρ (IntExpr.norm a) (IntExpr.norm b)) (congrArg2 (fun y z => y + z) (IntExpr.eval_norm ρ a) (IntExpr.eval_norm ρ b))
  | .mul a b => Eq.trans (IntPoly.eval_mul ρ (IntExpr.norm a) (IntExpr.norm b)) (congrArg2 (fun y z => y * z) (IntExpr.eval_norm ρ a) (IntExpr.eval_norm ρ b))
  | .neg a => Eq.trans (IntPoly.eval_neg ρ (IntExpr.norm a)) (congrArg (fun y => -y) (IntExpr.eval_norm ρ a))
  | .sub a b =>
    Eq.trans (IntPoly.eval_add ρ (IntExpr.norm a) (IntPoly.mulMono (-1) .nil (IntExpr.norm b)))
      (Eq.trans (congrArg2 (fun y z => y + z) (IntExpr.eval_norm ρ a) (Eq.trans (IntPoly.eval_neg ρ (IntExpr.norm b)) (congrArg (fun y => -y) (IntExpr.eval_norm ρ b))))
        (int_pair_ring! IntExpr.eval ρ a + -(IntExpr.eval ρ b) = IntExpr.eval ρ a - IntExpr.eval ρ b))

/-- Boolean equality of polynomials (see `NatPoly.beq`). -/
def IntPoly.beq : IntPoly → IntPoly → Bool
  | .nil, .nil => .true
  | .cons m p, .cons n q => Bool.and (Bool.and (Int.beq m.1 n.1) (Ring.Key.beq m.2 n.2)) (IntPoly.beq p q)
  | _, _ => .false
/-- Polynomials that `IntPoly.beq` finds equal have the same value. -/
def IntPoly.beq_eval (ρ : List Int) : (p q : IntPoly) → IntPoly.beq p q = .true → IntPoly.eval ρ p = IntPoly.eval ρ q
  | .nil, .nil, _ => rfl
  | .nil, .cons _ _, h => absurd h.1
  | .cons _ _, .nil, h => absurd h.1
  | .cons m p, .cons n q, h =>
    let h1 := Bool.and_left _ _ h;
    congrArg2 (fun x y => x + y)
      (congrArg2 (fun c xs => c * IntPoly.keyProd ρ xs) (Int.beq_eq m.1 n.1 (Bool.and_left _ _ h1)) (Ring.Key.beq_eq m.2 n.2 (Bool.and_right _ _ h1)))
      (IntPoly.beq_eval ρ p q (Bool.and_right _ _ h))

/-- Expressions with the same normal form have the same value. -/
def IntExpr.prove (ρ : List Int) (a b : IntExpr) (h : IntPoly.beq (IntExpr.norm a) (IntExpr.norm b) = .true) : IntExpr.eval ρ a = IntExpr.eval ρ b :=
  Eq.trans (Eq.symm (IntExpr.eval_norm ρ a)) (Eq.trans (IntPoly.beq_eval ρ (IntExpr.norm a) (IntExpr.norm b) h) (IntExpr.eval_norm ρ b))

/-- `x = y`, from expressions that evaluate to `x` and `y` and have the same
normal form. `int_ring!` expands to this. -/
def IntExpr.proveAt (x y : Int) (ρ : List Int) (a b : IntExpr) (hx : IntExpr.eval ρ a = x) (hy : IntExpr.eval ρ b = y)
    (h : IntPoly.beq (IntExpr.norm a) (IntExpr.norm b) = .true) : x = y :=
  Eq.trans (Eq.symm hx) (Eq.trans (IntExpr.prove ρ a b h) hy)

/-- The macro behind `int_ring!`. -/
def IntRing.expand : Macro := fun stx => Ring.Reify.expand "IntExpr" stx
syntax:lead (name := intRing) "int_ring!" term : term
attribute [macro term.intRing] IntRing.expand

-- ## The ring laws

/-- Addition is commutative. -/
def Int.add_comm (a b : Int) : a + b = b + a := int_ring! a + b = b + a
/-- Addition is associative. -/
def Int.add_assoc (a b c : Int) : a + b + c = a + (b + c) := int_ring! a + b + c = a + (b + c)
/-- `a + (b + c) = b + (a + c)`. -/
def Int.add_left_comm (a b c : Int) : a + (b + c) = b + (a + c) := int_ring! a + (b + c) = b + (a + c)
/-- `a + -a = 0`. -/
def Int.add_neg (a : Int) : a + -a = 0 := int_ring! a + -a = 0
/-- `-a + a = 0`. -/
def Int.neg_add (a : Int) : -a + a = 0 := int_ring! -a + a = 0
/-- `a - a = 0`. -/
def Int.sub_self (a : Int) : a - a = 0 := int_ring! a - a = 0
/-- `a - 0 = a`. -/
def Int.sub_zero (a : Int) : a - 0 = a := int_ring! a - 0 = a
/-- `0 - a = -a`. -/
def Int.zero_sub (a : Int) : 0 - a = -a := int_ring! 0 - a = -a
/-- Subtraction is adding the negation. -/
def Int.sub_eq_add_neg (a b : Int) : a - b = a + -b := int_ring! a - b = a + -b
/-- `-(a + b) = -a + -b`. -/
def Int.neg_add_distrib (a b : Int) : -(a + b) = -a + -b := int_ring! -(a + b) = -a + -b
/-- `-(a - b) = b - a`. -/
def Int.neg_sub (a b : Int) : -(a - b) = b - a := int_ring! -(a - b) = b - a
/-- `a + b - b = a`. -/
def Int.add_sub_cancel (a b : Int) : a + b - b = a := int_ring! a + b - b = a
/-- `a - b + b = a`. -/
def Int.sub_add_cancel (a b : Int) : a - b + b = a := int_ring! a - b + b = a
/-- Multiplication is commutative. -/
def Int.mul_comm (a b : Int) : a * b = b * a := int_ring! a * b = b * a
/-- Multiplication is associative. -/
def Int.mul_assoc (a b c : Int) : a * b * c = a * (b * c) := int_ring! a * b * c = a * (b * c)
/-- `a * (b * c) = b * (a * c)`. -/
def Int.mul_left_comm (a b c : Int) : a * (b * c) = b * (a * c) := int_ring! a * (b * c) = b * (a * c)
/-- `a * 1 = a`. -/
def Int.mul_one (a : Int) : a * 1 = a := int_ring! a * 1 = a
/-- `1 * a = a`. -/
def Int.one_mul (a : Int) : 1 * a = a := int_ring! 1 * a = a
/-- `a * 0 = 0`. -/
def Int.mul_zero (a : Int) : a * 0 = 0 := int_ring! a * 0 = 0
/-- `0 * a = 0`. -/
def Int.zero_mul (a : Int) : 0 * a = 0 := int_ring! 0 * a = 0
/-- Multiplication distributes over addition on the left. -/
def Int.mul_add (a b c : Int) : a * (b + c) = a * b + a * c := int_ring! a * (b + c) = a * b + a * c
/-- Multiplication distributes over addition on the right. -/
def Int.add_mul (a b c : Int) : (a + b) * c = a * c + b * c := int_ring! (a + b) * c = a * c + b * c
/-- Multiplication distributes over subtraction on the left. -/
def Int.mul_sub (a b c : Int) : a * (b - c) = a * b - a * c := int_ring! a * (b - c) = a * b - a * c
/-- Multiplication distributes over subtraction on the right. -/
def Int.sub_mul (a b c : Int) : (a - b) * c = a * c - b * c := int_ring! (a - b) * c = a * c - b * c
/-- `-a * b = -(a * b)`. -/
def Int.neg_mul (a b : Int) : -a * b = -(a * b) := int_ring! -a * b = -(a * b)
/-- `a * -b = -(a * b)`. -/
def Int.mul_neg (a b : Int) : a * -b = -(a * b) := int_ring! a * -b = -(a * b)
/-- `-a * -b = a * b`. -/
def Int.neg_mul_neg (a b : Int) : -a * -b = a * b := int_ring! -a * -b = a * b
/-- `-1 * a = -a`. -/
def Int.neg_one_mul (a : Int) : -1 * a = -a := int_ring! -1 * a = -a
/-- `Int.ofNat` preserves addition (by computation). -/
def Int.ofNat_add (m n : Nat) : Int.ofNat (m + n) = Int.ofNat m + Int.ofNat n := rfl
/-- `Int.ofNat` preserves multiplication (by computation). -/
def Int.ofNat_mul (m n : Nat) : Int.ofNat (m * n) = Int.ofNat m * Int.ofNat n := rfl
/-- `Int.ofNat (n + 1) = Int.ofNat n + 1`. -/
def Int.ofNat_succ (n : Nat) : Int.ofNat (Nat.succ n) = Int.ofNat n + 1 :=
  congrArg Int.ofNat (Eq.symm (Nat.add_one n))
