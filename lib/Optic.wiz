import Prelude
-- Optics for borrows (RD11): the target library of Feral's lowering of
-- mutable borrows. See /workspace/wiz-notes/borrows-as-optics.md.
--
-- A Feral function that returns `&mut A` borrowed from a lender `S` lowers (Aeneas
-- style) to a forward value and a backward closure: `S → Result (A × (A → S))`. That
-- is a (partial) costate coalgebra `S → Result (Store A S)`, and when its body is a
-- place expression (fields, indices, variant payloads) it is a lawful partial lens.
-- This file names the pieces and states the laws. The representation stays the
-- closure form, which is what reference counting with reuse wants.

-- The result monad of lowered code (RD7): every panic (`panic!`, `unwrap` on `none`,
-- overflow, an index out of bounds, division by zero) is an `err`.
inductive Error where
  | panic (msg : String)
  | overflow
  | outOfBounds
  | unwrapNone
  | divZero

inductive Result (A : Type) where
  | ok (a : A)
  | err (e : Error)

-- Lowered code matches on results directly (no closures around owners); `bind` and the
-- monad instance are for hand-written specs and Wiz code calling lowered code (RD16).
def Result.bind {A B : Type} (x : Result A) (f : A → Result B) : Result B := match x with
  | .ok a => f a
  | .err e => .err e
def Result.map {A B : Type} (f : A → B) (x : Result A) : Result B := match x with
  | .ok a => .ok (f a)
  | .err e => .err e
instance : Monad Result where
  pure := fun a => Result.ok a
  bind := Result.bind

-- `P` holds of the value, if there is one (a failure satisfies everything).
def Result.All {A : Type} (P : A → Prop) : Result A → Prop
  | .ok a => P a
  | .err _ => True
-- there is a value, and `P` holds of it (an `∃` without `∃`)
def Result.Holds {A : Type} (P : A → Prop) : Result A → Prop
  | .ok a => P a
  | .err _ => False

-- ## Store: a value and a way to put it back
--
-- `Store A S` is "an `A` borrowed out of an `S`": the borrow's current value, and the
-- backward function that rebuilds the lender from the borrow's final value.

def Store (A S : Type) : Type := A × (A → S)
def Store.mk {A S : Type} (a : A) (k : A → S) : Store A S := (a, k)
-- the borrowed value
def Store.pos {A S : Type} (st : Store A S) : A := st.1
-- end the borrow with a final value
def Store.put {A S : Type} (st : Store A S) (a : A) : S := st.2 a
-- end the borrow without writing to it
def Store.extract {A S : Type} (st : Store A S) : S := st.2 st.1
-- a borrow of a borrow (a reborrow `&mut (*r).f`): its put goes through both
def Store.comp {A B S : Type} (st : Store A S) (m : A → Store B A) : Store B S :=
  let inner := m st.1;
  (inner.1, fun b => st.2 (inner.2 b))
-- a borrow out of `A` (which may fail), seen as a borrow out of `S`, given how to put
-- `A` back into `S`
def Store.underR {A B S : Type} (k : A → S) : Result (Store B A) → Result (Store B S)
  | .ok inner => .ok (inner.1, fun b => k (inner.2 b))
  | .err e => .err e
-- the same as `comp`, when the inner borrow may fail (`&mut (*r)[i]`)
def Store.compP {A B S : Type} (st : Store A S) (m : A → Result (Store B A)) : Result (Store B S) :=
  Store.underR st.2 (m st.1)

-- ## Lenses
--
-- `Lens S A`: a total place (`&mut s.f`). `PLens S A`: a place whose get may panic
-- (`&mut v[i]`); whether it fails depends only on the lender, never on the value put.

def Lens (S A : Type) : Type := S → Store A S
def PLens (S A : Type) : Type := S → Result (Store A S)

def Lens.id {S : Type} : Lens S S := fun s => (s, fun s' => s')
def Lens.get {S A : Type} (l : Lens S A) (s : S) : A := (l s).1
def Lens.set {S A : Type} (l : Lens S A) (s : S) (a : A) : S := (l s).2 a
def Lens.over {S A : Type} (l : Lens S A) (f : A → A) (s : S) : S :=
  let st := l s;
  st.2 (f st.1)
def Lens.comp {S A B : Type} (l : Lens S A) (m : Lens A B) : Lens S B :=
  fun s => Store.comp (l s) m
def Lens.toP {S A : Type} (l : Lens S A) : PLens S A := fun s => .ok (l s)

def PLens.comp {S A B : Type} (l : PLens S A) (m : PLens A B) : PLens S B := fun s =>
  match l s with
  | .ok st => Store.compP st m
  | .err e => .err e

-- ## zoom: run a state transformer through a place
--
-- A function taking `&mut X` lowers to `X → Result (B × X)` (the value is handed back).
-- Calling it on a sub-place of `s` is `zoom`: borrow, run, put back. This is also the
-- lowering of a `FnMut` closure that captures `&mut x` (state passing, RD5).

def zoom {S X B : Type} (l : Lens S X) (m : X → Result (B × X)) (s : S) : Result (B × S) :=
  let st := l s;
  match m st.1 with
  | .ok r => .ok (r.1, st.2 r.2)
  | .err e => .err e

def zoomP {S X B : Type} (l : PLens S X) (m : X → Result (B × X)) (s : S) : Result (B × S) :=
  match l s with
  | .ok st => (match m st.1 with
    | .ok r => .ok (r.1, st.2 r.2)
    | .err e => .err e)
  | .err e => .err e

-- ## Affine: `Option<&mut A>`
--
-- A place that may not exist (`v.get_mut(i)`, `if let Some(x) = &mut o`). `none`
-- carries the lender back unchanged; `some` is a borrow. Unlike `Option A × (Option A
-- → S)`, the backward function can't be given the wrong variant.

inductive Affine (A S : Type) where
  | none (s : S)
  | some (a : A) (k : A → S)

def ALens (S A : Type) : Type := S → Result (Affine A S)

-- the lender, after ending the borrow (if any) with its current value
def Affine.extract {A S : Type} : Affine A S → S
  | .none s => s
  | .some a k => k a
-- end the borrow (if any) with `f` of its current value
def Affine.over {A S : Type} (f : A → A) : Affine A S → S
  | .none s => s
  | .some a k => k (f a)
-- a borrow into a borrow that may not exist
def Affine.comp {A B S : Type} (x : Affine A S) (m : A → Affine B A) : Affine B S := match x with
  | .none s => .none s
  | .some a k => (match m a with
    | .none a' => .none (k a')
    | .some b j => .some b (fun b' => k (j b')))

-- ## Traversals: `iter_mut`
--
-- `for x in s.iter_mut() { body }` with loop state `σ`. Instances should run in place
-- (take each element, run the body, put it back).
class TraverseMut (S : Type) (A : outParam Type) where
  traverseM : {σ : Type} → (A → σ → Result (A × σ)) → S → σ → Result (S × σ)

def List.traverseM {A σ : Type} (f : A → σ → Result (A × σ)) : List A → σ → Result (List A × σ)
  | .nil, st => .ok ((List.nil : List A), st)
  | .cons x xs, st => match f x st with
    | .ok r => (match List.traverseM f xs r.2 with
      | .ok r' => .ok (List.cons r.1 r'.1, r'.2)
      | .err e => .err e)
    | .err e => .err e

instance {A : Type} : TraverseMut (List A) A where
  traverseM := fun f xs st => List.traverseM f xs st

-- ## Laws (quantity 0: propositions, erased)
--
-- Stated on successful calls. For a total lens they are equations; for a partial lens
-- `Result.All` says "if it succeeds", and `Result.Holds` says "it succeeds, and".

-- GetPut: a borrow that is never written leaves the lender unchanged.
def Lens.GetPut {S A : Type} (l : Lens S A) : Prop := (s : S) → (l s).2 (l s).1 = s
-- PutGet: borrowing again after a write sees the write.
def Lens.PutGet {S A : Type} (l : Lens S A) : Prop := (s : S) → (a : A) → (l ((l s).2 a)).1 = a
-- PutPut: a second borrow of the same place rebuilds the lender the same way.
def Lens.PutPut {S A : Type} (l : Lens S A) : Prop :=
  (s : S) → (a b : A) → (l ((l s).2 a)).2 b = (l s).2 b
def Lens.Lawful {S A : Type} (l : Lens S A) : Prop := Lens.GetPut l × Lens.PutGet l × Lens.PutPut l

def PLens.GetPut {S A : Type} (l : PLens S A) : Prop :=
  (s : S) → Result.All (fun (st : Store A S) => st.2 st.1 = s) (l s)
def PLens.PutGet {S A : Type} (l : PLens S A) : Prop :=
  (s : S) → Result.All (fun (st : Store A S) => (a : A) → Result.Holds (fun (st' : Store A S) => st'.1 = a) (l (st.2 a))) (l s)
def PLens.PutPut {S A : Type} (l : PLens S A) : Prop :=
  (s : S) → Result.All (fun (st : Store A S) => (a b : A) →
    Result.Holds (fun (st' : Store A S) => st'.2 b = st.2 b) (l (st.2 a))) (l s)
def PLens.Lawful {S A : Type} (l : PLens S A) : Prop := PLens.GetPut l × PLens.PutGet l × PLens.PutPut l

-- Two places are independent (disjoint borrows, `split_at_mut`): a put to one neither
-- changes the other's value nor depends on the order of the puts.
def Lens.Indep {S A B : Type} (l : Lens S A) (m : Lens S B) : Prop :=
  ((s : S) → (a : A) → (m ((l s).2 a)).1 = (m s).1) ×
  ((s : S) → (b : B) → (l ((m s).2 b)).1 = (l s).1) ×
  ((s : S) → (a : A) → (b : B) → (m ((l s).2 a)).2 b = (l ((m s).2 b)).2 a)

-- Two independent places borrowed at once (`let (a, b) = (&mut s.x, &mut s.y)`).
def Lens.pair {S A B : Type} (l : Lens S A) (m : Lens S B) : Lens S (A × B) := fun s =>
  (((l s).1, (m s).1), fun ab => (m ((l s).2 ab.1)).2 ab.2)

-- The resolution equation, which `final(r)` specs desugar to: whatever the borrow's
-- final value `fin`, the lender's final value is `put fin`. It holds by definition;
-- stated so that specs can cite it.
def Store.final {A S : Type} (st : Store A S) (fin : A) : Store.put st fin = st.2 fin := rfl

-- ## Examples: lawful lenses
--
-- A structure field, and the head of a non-empty list. The front end would generate
-- these laws (by `rfl` or by cases) for every place function it emits.

structure Pair2 (A B : Type) where
  fst : A
  snd : B

def Pair2.fstL {A B : Type} : Lens (Pair2 A B) A := fun s =>
  (s.fst, fun a => Pair2.mk a s.snd)
def Pair2.sndL {A B : Type} : Lens (Pair2 A B) B := fun s =>
  (s.snd, fun b => Pair2.mk s.fst b)

def Pair2.fstL_lawful {A B : Type} : Lens.Lawful (@Pair2.fstL A B) :=
  (fun s => rfl, fun s a => rfl, fun s a b => rfl)
def Pair2.sndL_lawful {A B : Type} : Lens.Lawful (@Pair2.sndL A B) :=
  (fun s => rfl, fun s a => rfl, fun s a b => rfl)
def Pair2.indep {A B : Type} : Lens.Indep (@Pair2.fstL A B) (@Pair2.sndL A B) :=
  (fun s a => rfl, fun s b => rfl, fun s a b => rfl)

-- `&mut v[0]` on a list: panics on the empty list.
def List.headL {A : Type} : PLens (List A) A
  | .nil => .err .outOfBounds
  | .cons x xs => .ok (x, fun x' => List.cons x' xs)

def List.headL_lawful {A : Type} : PLens.Lawful (@List.headL A) :=
  (fun s => match s with
    | .nil => ()
    | .cons x xs => refl (List.cons x xs),
   fun s => match s with
    | .nil => ()
    | .cons x xs => fun a => refl a,
   fun s => match s with
    | .nil => ()
    | .cons x xs => fun a b => refl (List.cons b xs))

-- ## Composition preserves lawfulness
--
-- A reborrow chain `&mut (*r).f.g` is a composite of field lenses, so its laws follow
-- from theirs. (Equational reasoning by transport; `congrArg` and `Eq.trans` are J.)

def Optic.congrArg {A B : Type} (f : A → B) {a b : A} (e : a = b) : f a = f b :=
  transp (fun b _ => f a = f b) (refl (f a)) e
def Optic.sym {A : Type} {a b : A} (e : a = b) : b = a :=
  transp (fun b _ => b = a) (refl a) e
-- transport into a proposition: an equation of propositions computes to `(0 _ : P → Q)
-- × (Q → P)`, so the usable direction is the second field of `P b = P a`
def Optic.subst {A : Type} (P : A → Prop) {a b : A} (e : a = b) (pa : P a) : P b :=
  (@Optic.congrArg A Prop P b a (Optic.sym e)).2 pa
def Optic.trans {A : Type} {a b c : A} (e₁ : a = b) (e₂ : b = c) : a = c :=
  transp (fun c _ => a = c) e₁ e₂

def Lens.comp_lawful {S A B : Type} (l : Lens S A) (m : Lens A B)
    (hl : Lens.Lawful l) (hm : Lens.Lawful m) : Lens.Lawful (Lens.comp l m) :=
  (fun s => Optic.trans (Optic.congrArg (l s).2 (hm.1 (l s).1)) (hl.1 s),
   fun s b => Optic.trans
     (Optic.congrArg (fun x => (m x).1) (hl.2.1 s ((m (l s).1).2 b)))
     (hm.2.1 (l s).1 b),
   fun s b c => Optic.trans
     (Optic.congrArg (fun x => (l ((l s).2 ((m (l s).1).2 b))).2 ((m x).2 c)) (hl.2.1 s ((m (l s).1).2 b)))
     (Optic.trans
       (Optic.congrArg (l ((l s).2 ((m (l s).1).2 b))).2 (hm.2.2 (l s).1 b c))
       (hl.2.2 s ((m (l s).1).2 b) ((m (l s).1).2 c))))

-- GetPut for two independent places borrowed at once. (PutGet and PutPut hold too, by
-- `Indep`; their proofs are in drafts/feral/Optic.wiz until the elaborator compares an
-- equation of pairs with its computed form.)
def Lens.pair_getPut {S A B : Type} (l : Lens S A) (m : Lens S B) (hl : Lens.Lawful l) (hm : Lens.Lawful m) :
    Lens.GetPut (Lens.pair l m) := fun s =>
  @Optic.subst S (fun (y : S) => (m y).2 (m s).1 = s) s ((l s).2 (l s).1) (Optic.sym (hl.1 s)) (hm.1 s)

-- Equality of a pair with a pair-valued variable, componentwise. The equation computes to
-- `(e : a = p.1) × (cast B B _ b = p.2)` (the second component's type is cast along the
-- first's equation, and `B` is a variable, so the cast is stuck): `castRefl` removes it.
def Optic.pairEq {A B : Type} (a : A) (b : B) (p : A × B) (e₁ : a = p.1) (e₂ : b = p.2) : (a, b) = p :=
  (e₁, Optic.trans (@castRefl B rfl b) e₂)
def Lens.pair_putGet {S A B : Type} (l : Lens S A) (m : Lens S B) (hl : Lens.Lawful l) (hm : Lens.Lawful m)
    (hi : Lens.Indep l m) : Lens.PutGet (Lens.pair l m) := fun s ab =>
  Optic.pairEq ((l ((m ((l s).2 ab.1)).2 ab.2)).1) ((m ((m ((l s).2 ab.1)).2 ab.2)).1) ab
    (Optic.trans (hi.2.1 ((l s).2 ab.1) ab.2) (hl.2.1 s ab.1))
    (hm.2.1 ((l s).2 ab.1) ab.2)

-- `underR` preserves the laws, case by case on the inner result. These are the lemmas
-- for a partial lens behind a lens whose put-then-get is definitional (a field, a
-- constructor's argument): the composite's laws are the inner lens's.
def Store.underR_gp {A B S : Type} (k : A → S) (a : A) (s : S) (hk : k a = s) : (r : Result (Store B A)) →
    Result.All (fun (st : Store B A) => st.2 st.1 = a) r →
    Result.All (fun (st : Store B S) => st.2 st.1 = s) (Store.underR k r)
  | .ok st, h => Optic.trans (Optic.congrArg k h) hk
  | .err e, h => ()
def Store.underR_get {A B S : Type} (k : A → S) (b : B) : (r : Result (Store B A)) →
    Result.Holds (fun (st : Store B A) => st.1 = b) r →
    Result.Holds (fun (st : Store B S) => st.1 = b) (Store.underR k r)
  | .ok st, h => h
  | .err e, h => h
def Store.underR_pg1 {A B S : Type} (k : A → S) (m : PLens A B) (C : PLens S B)
    (hC : (x : A) → @Store.underR A B S k (m x) = C (k x)) (st : Store B A) (b : B)
    (h : Result.Holds (fun (st' : Store B A) => st'.1 = b) (m (st.2 b))) :
    Result.Holds (fun (st' : Store B S) => st'.1 = b) (C (k (st.2 b))) :=
  @Optic.subst (Result (Store B S)) (Result.Holds (fun (st' : Store B S) => st'.1 = b))
    (Store.underR k (m (st.2 b))) (C (k (st.2 b))) (hC (st.2 b))
    (Store.underR_get k b (m (st.2 b)) h)
def Store.underR_pg {A B S : Type} (k : A → S) (m : PLens A B) (C : PLens S B)
    (hC : (x : A) → @Store.underR A B S k (m x) = C (k x)) : (r : Result (Store B A)) →
    Result.All (fun (st : Store B A) => (b : B) →
      Result.Holds (fun (st' : Store B A) => st'.1 = b) (m (st.2 b))) r →
    Result.All (fun (st : Store B S) => (b : B) →
      Result.Holds (fun (st' : Store B S) => st'.1 = b) (C (st.2 b))) (Store.underR k r)
  | .ok st, h => fun b => Store.underR_pg1 k m C hC st b (h b)
  | .err e, h => ()
def Store.underR_put {A B S : Type} (k : A → S) (b : B) (t : A) : (r : Result (Store B A)) →
    Result.Holds (fun (st : Store B A) => st.2 b = t) r →
    Result.Holds (fun (st : Store B S) => st.2 b = k t) (Store.underR k r)
  | .ok st, h => Optic.congrArg k h
  | .err e, h => h
def Store.underR_pp1 {A B S : Type} (k : A → S) (m : PLens A B) (C : PLens S B)
    (hC : (x : A) → @Store.underR A B S k (m x) = C (k x)) (st : Store B A) (a b : B)
    (h : Result.Holds (fun (st' : Store B A) => st'.2 b = st.2 b) (m (st.2 a))) :
    Result.Holds (fun (st' : Store B S) => st'.2 b = k (st.2 b)) (C (k (st.2 a))) :=
  @Optic.subst (Result (Store B S)) (Result.Holds (fun (st' : Store B S) => st'.2 b = k (st.2 b)))
    (Store.underR k (m (st.2 a))) (C (k (st.2 a))) (hC (st.2 a))
    (Store.underR_put k b (st.2 b) (m (st.2 a)) h)
def Store.underR_pp {A B S : Type} (k : A → S) (m : PLens A B) (C : PLens S B)
    (hC : (x : A) → @Store.underR A B S k (m x) = C (k x)) : (r : Result (Store B A)) →
    Result.All (fun (st : Store B A) => (a b : B) →
      Result.Holds (fun (st' : Store B A) => st'.2 b = st.2 b) (m (st.2 a))) r →
    Result.All (fun (st : Store B S) => (a b : B) →
      Result.Holds (fun (st' : Store B S) => st'.2 b = st.2 b) (C (st.2 a))) (Store.underR k r)
  | .ok st, h => fun a b => Store.underR_pp1 k m C hC st a b (h a b)
  | .err e, h => ()

-- `&mut v[i]` on a list (the kernel model of a vector): a lawful partial lens, by
-- induction on the index.
def List.atL {A : Type} : Nat → PLens (List A) A
  | _, .nil => .err .outOfBounds
  | .zero, .cons x xs => .ok (x, fun x' => List.cons x' xs)
  | .succ i, .cons x xs => Store.underR (List.cons x) (List.atL i xs)

def List.atL_gp {A : Type} : (i : Nat) → (s : List A) →
    Result.All (fun (st : Store A (List A)) => st.2 st.1 = s) (List.atL i s)
  | _, .nil => ()
  | .zero, .cons x xs => refl (List.cons x xs)
  | .succ i, .cons x xs => Store.underR_gp (List.cons x) xs (List.cons x xs) rfl (List.atL i xs) (List.atL_gp i xs)
def List.atL_pg {A : Type} : (i : Nat) → (s : List A) →
    Result.All (fun (st : Store A (List A)) => (a : A) →
      Result.Holds (fun (st' : Store A (List A)) => st'.1 = a) (List.atL i (st.2 a))) (List.atL i s)
  | _, .nil => ()
  | .zero, .cons x xs => fun a => refl a
  | .succ i, .cons x xs => Store.underR_pg (List.cons x) (List.atL i) (List.atL (Nat.succ i)) (fun y => rfl) (List.atL i xs) (List.atL_pg i xs)
def List.atL_pp {A : Type} : (i : Nat) → (s : List A) →
    Result.All (fun (st : Store A (List A)) => (a b : A) →
      Result.Holds (fun (st' : Store A (List A)) => st'.2 b = st.2 b) (List.atL i (st.2 a))) (List.atL i s)
  | _, .nil => ()
  | .zero, .cons x xs => fun a b => refl (List.cons b xs)
  | .succ i, .cons x xs => Store.underR_pp (List.cons x) (List.atL i) (List.atL (Nat.succ i)) (fun y => rfl) (List.atL i xs) (List.atL_pp i xs)
def List.atL_lawful {A : Type} (i : Nat) : PLens.Lawful (@List.atL A i) :=
  (fun s => List.atL_gp i s, fun s => List.atL_pg i s, fun s => List.atL_pp i s)
