import Lake

open System Lake DSL

package wiz where
  testDriver := "tests"
  version := v!"0.1.0"
  -- compiled modules go to the shared Lake cache (keyed by their inputs), so worktrees
  -- reuse each other's builds
  enableArtifactCache? := true

lean_lib Wiz

/-- `Tests/Groups.lean`: an import of each module under `Tests/Groups/` (one test group
each, `Tests/Harness.lean`, `registerGroup`), generated from the directory's files and
rewritten only when that list changes. The file is not committed: a new group is a new
file and touches no shared one. -/
target testGroups pkg : FilePath := do
  let dir := pkg.dir / "Tests" / "Groups"
  let files ← if ← dir.isDir then dir.readDir else pure #[]
  let mods := files.filterMap fun e =>
    if e.fileName.endsWith ".lean" then some (e.fileName.dropEnd 5).toString else none
  let mods := mods.qsort (fun a b => decide (a < b))
  let text := "-- generated by lakefile.lean (target `testGroups`) from Tests/Groups/; not committed\n" ++
    String.join (mods.toList.map (s!"import Tests.Groups.{·}\n"))
  let out := pkg.dir / "Tests" / "Groups.lean"
  let old ← if ← out.pathExists then IO.FS.readFile out else pure ""
  if old != text then IO.FS.writeFile out text
  return .pure out

lean_lib Tests where
  needs := #[`@/testGroups]

-- The spec of the core theory and its reference checker (see WizMeta.lean). Not a
-- default target: only the test driver imports it, so `lake build` and `wiz` don't build
-- it. A misspelt name in a rule must be an error, not a fresh variable.
lean_lib WizMeta where
  leanOptions := #[⟨`autoImplicit, false⟩, ⟨`relaxedAutoImplicit, false⟩]

lean_lib Grail

-- The C runtime as text (`include_str`, runtime/WizRuntime.lean), a library of its own so
-- that only it depends on the runtime's files: `needs` mixes their hashes into its
-- modules' traces, so editing one rebuilds it and its importers (Lake doesn't track
-- include_str). The runtime is the header's inline part plus six area files.
lean_lib WizRuntime where
  srcDir := "runtime"
  needs := #[`@/wizRuntimeHeader, `@/wizRuntimeCore, `@/wizRuntimeNum,
    `@/wizRuntimeWords, `@/wizRuntimeData, `@/wizRuntimeSys, `@/wizRuntimeCon]

@[default_target] lean_exe wiz where
  root := `Main
  moreLinkObjs := #[`@/sockets]

lean_exe tests where
  root := `Tests.Main
  moreLinkObjs := #[`@/sockets, `@/proc]

@[default_target] lean_exe grail where
  root := `Grail.Main
  moreLinkObjs := #[`@/sockets, `@/proc]

-- Unix-domain sockets for `wiz lsp --infoview` (Lean's library has none): a C file that
-- the linker compiles into each executable
input_file sockets where
  path := "c/sockets.c"

-- `_exit` for grail's job supervisor (Grail/Exec.lean), linked into grail and the tests
input_file proc where
  path := "c/proc.c"

-- The runtime's files: `runtime/WizRuntime.lean` embeds them with `include_str`. Each is
-- an `input_file` so that its content hash is part of WizRuntime's trace.
input_file wizRuntimeHeader where
  path := "runtime/wiz_rt.h"
  text := true

input_file wizRuntimeCore where
  path := "runtime/rt_core.inc"
  text := true

input_file wizRuntimeNum where
  path := "runtime/rt_num.inc"
  text := true

input_file wizRuntimeWords where
  path := "runtime/rt_words.inc"
  text := true

input_file wizRuntimeData where
  path := "runtime/rt_data.inc"
  text := true

input_file wizRuntimeSys where
  path := "runtime/rt_sys.inc"
  text := true

input_file wizRuntimeCon where
  path := "runtime/rt_con.inc"
  text := true
