import Grail
-- The Wiz repository's build file (stage 23d): `grail build`, or `grail build std`.
-- Machine settings (where GMP lives) go in grail.local.wiz, which isn't committed.
-- examples/procmacro.wiz and examples/syntax.wiz show errors on purpose: the test
-- runner (23f) will check them against their expected output.
def package : Package := Package.new "wiz"
  |> Package.set "libs" "-lm"
  |> Package.lib "std" "lib"
  |> Package.check "examples/church" "examples/church.wiz"
  |> Package.check "examples/classes" "examples/classes.wiz"
  |> Package.check "examples/data" "examples/data.wiz"
  |> Package.check "examples/deriving" "examples/deriving.wiz"
  |> Package.check "examples/effects" "examples/effects.wiz"
  |> Package.check "examples/equality" "examples/equality.wiz"
  |> Package.check "examples/foreign" "examples/foreign.wiz"
  |> Package.check "examples/fusion" "examples/fusion.wiz"
  |> Package.check "examples/glue" "examples/glue.wiz"
  |> Package.check "examples/import_c" "examples/import_c.wiz"
  |> Package.check "examples/inductive" "examples/inductive.wiz"
  |> Package.check "examples/io" "examples/io.wiz"
  |> Package.check "examples/macros" "examples/macros.wiz"
  |> Package.check "examples/match" "examples/match.wiz"
  |> Package.check "examples/pairs" "examples/pairs.wiz"
  |> Package.check "examples/run" "examples/run.wiz"
  |> Package.check "examples/sized" "examples/sized.wiz"
  |> Package.check "examples/std" "examples/std.wiz"
  |> Package.check "examples/streams" "examples/streams.wiz"
  |> Package.check "examples/tactics" "examples/tactics.wiz"
  |> Package.exe "io" "examples/io.wiz"
  |> Package.exe "std-demo" "examples/std.wiz"
  |> Package.exe "effects" "examples/effects.wiz"
  |> Package.exe "foreign" "examples/foreign.wiz"
  |> Package.exe "glue" "examples/glue.wiz"
  |> Package.exe "import-c" "examples/import_c.wiz"
