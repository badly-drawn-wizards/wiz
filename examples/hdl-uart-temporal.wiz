def Rx.WellFormed (rs : Trace Bool) (v : Nat) (e : Bits8) : Prop :=
  (k : Nat) → Nat.lt k 38 = .true → rs (Nat.add k v) = Uart.frameBit e (Nat.div k 4)

def Rx.frameRun (rs : Trace Bool) (v c0 : Nat) (cs e : Bits8) (hidle : Rx.run rs v = RxS.mk 0 c0 cs) (hf : Rx.WellFormed rs v e)
    (k : Nat) (hk : Nat.lt k 40 = .true) : Rx.run rs (Nat.add k v) = Rx.path c0 cs e k :=
  Mealy.follows Rx.spec Rx.s0 rs (Rx.path c0 cs e) v 39 hidle
    (fun (j : Nat) (hj : Nat.lt j 39 = .true) =>
      Nat.all_spec (Rx.PStep c0 cs e) 39 (Rx.psteps c0 cs e) j hj (rs (Nat.add j v)) (hf j))
    k hk

-- (R1) Fed a well-formed frame with a high stop bit, the receiver reports the byte at
-- the stop bit's sample (cycle 38 + v), reports nothing before, and is idle after.
def Rx.quiet (rs : Trace Bool) (v c0 : Nat) (cs e : Bits8) (hidle : Rx.run rs v = RxS.mk 0 c0 cs) (hf : Rx.WellFormed rs v e)
    (k : Nat) (hk : Nat.lt k 38 = .true) : (Rx.outs rs (Nat.add k v)).1 = .false :=
  Eq.trans (Eq.congrArg (fun (s : RxS) => (Rx.out s (rs (Nat.add k v))).1) (Rx.frameRun rs v c0 cs e hidle hf k (Nat.lt_to_succ k 39 (Nat.lt_to_succ k 38 hk))))
    (Nat.all_spec (Rx.PQuiet c0 cs e) 38 (Rx.pquiet c0 cs e) k hk (rs (Nat.add k v)))
def Rx.receives (rs : Trace Bool) (v c0 : Nat) (cs e : Bits8) (hidle : Rx.run rs v = RxS.mk 0 c0 cs) (hf : Rx.WellFormed rs v e)
    (hstop : rs (Nat.add 38 v) = .true) : Rx.outs rs (Nat.add 38 v) = (.true, e) :=
  @Eq.trans (Bool × Bits8) (Rx.out (Rx.run rs (Nat.add 38 v)) (rs (Nat.add 38 v))) (Rx.out (Rx.path c0 cs e 38) (rs (Nat.add 38 v))) (.true, e)
    (Eq.congrArg (fun (s : RxS) => Rx.out s (rs (Nat.add 38 v))) (Rx.frameRun rs v c0 cs e hidle hf 38 rfl))
    (Eq.congrArg (fun (r : Bool) => Rx.out (Rx.path c0 cs e 38) r) hstop)
def Rx.idleAfter (rs : Trace Bool) (v c0 : Nat) (cs e : Bits8) (hidle : Rx.run rs v = RxS.mk 0 c0 cs) (hf : Rx.WellFormed rs v e) :
    Rx.run rs (Nat.add 39 v) = RxS.mk 0 0 e :=
  Rx.frameRun rs v c0 cs e hidle hf 39 rfl

-- (R2) With a low stop bit: nothing is reported, and the receiver is idle again just
-- the same (it then sees the low line as the next start bit).
def Rx.badStop (rs : Trace Bool) (v c0 : Nat) (cs e : Bits8) (hidle : Rx.run rs v = RxS.mk 0 c0 cs) (hf : Rx.WellFormed rs v e)
    (hstop : rs (Nat.add 38 v) = .false) : (Rx.outs rs (Nat.add 38 v)).1 = .false ∧ Rx.run rs (Nat.add 39 v) = RxS.mk 0 0 e :=
  And.intro
    (Eq.trans (Eq.congrArg (fun (s : RxS) => (Rx.out s (rs (Nat.add 38 v))).1) (Rx.frameRun rs v c0 cs e hidle hf 38 rfl))
      (Eq.congrArg (fun (r : Bool) => (Rx.out (Rx.path c0 cs e 38) r).1) hstop))
    (Rx.idleAfter rs v c0 cs e hidle hf)

-- (R3) A low pulse that is gone at the start bit's sample (cycle 2 + v) is a glitch:
-- the receiver is idle again at 3 + v, its register unchanged.
def Rx.glitchSt (c0 : Nat) (cs : Bits8) (k : Nat) : RxS := match Nat.lt k 3 with
  | .true => Rx.path c0 cs cs k
  | .false => RxS.mk 0 0 cs
def Rx.glitch (rs : Trace Bool) (v c0 : Nat) (cs : Bits8) (hidle : Rx.run rs v = RxS.mk 0 c0 cs)
    (hfall : rs (Nat.add 0 v) = .false) (hback : rs (Nat.add 2 v) = .true) : Rx.run rs (Nat.add 3 v) = RxS.mk 0 0 cs :=
  Mealy.follows Rx.spec Rx.s0 rs (Rx.glitchSt c0 cs) v 3 hidle
    (fun (j : Nat) (hj : Nat.lt j 3 = .true) => Nat.all_spec (fun (k : Nat) => (r : Bool) → (Nat.beq k 0 = .true → r = .false) → (Nat.beq k 2 = .true → r = .true) →
        Rx.next (Rx.glitchSt c0 cs k) r = Rx.glitchSt c0 cs (Nat.succ k)) 3
      (And.intro (And.intro (And.intro True.intro
        (fun (r : Bool) (h0 : Nat.beq 0 0 = .true → r = .false) (h2 : Nat.beq 0 2 = .true → r = .true) =>
          Eq.substProp (fun (z : Bool) => Rx.next (Rx.glitchSt c0 cs 0) z = Rx.glitchSt c0 cs 1) (Eq.symm (h0 rfl)) rfl))
        (fun (r : Bool) (h0 : Nat.beq 1 0 = .true → r = .false) (h2 : Nat.beq 1 2 = .true → r = .true) => rfl))
        (fun (r : Bool) (h0 : Nat.beq 2 0 = .true → r = .false) (h2 : Nat.beq 2 2 = .true → r = .true) =>
          Eq.substProp (fun (z : Bool) => Rx.next (Rx.glitchSt c0 cs 2) z = Rx.glitchSt c0 cs 3) (Eq.symm (h2 rfl)) rfl))
      j hj (rs (Nat.add j v))
      (fun (e0 : Nat.beq j 0 = .true) => Eq.substProp (fun (k : Nat) => rs (Nat.add k v) = .false) (Eq.symm (Nat.eq_of_beq j 0 e0)) hfall)
      (fun (e2 : Nat.beq j 2 = .true) => Eq.substProp (fun (k : Nat) => rs (Nat.add k v) = .true) (Eq.symm (Nat.eq_of_beq j 2 e2)) hback))
    3 rfl

-- The circuit reports what the specification does (`Rx.refinesOut`): with (R1), its
-- output at cycle 38 + v is `Rx.embOut (.true, e)`, i.e. valid high and `byte e`.
-- (Composing the two equations in one statement is left out: checking an equation
-- between two circuit outputs, a pair of words, unfolds the circuit per field and went
-- over 2 GB; see the findings.)
def Rx.outImpl (rs : Trace Bool) (u : Nat) : HwTy.El Byte.code := Mealy.outAt rxM (rxC 4).init (Trace.map Rx.embIn rs) u

------------------------------------------------------------------------------------
-- 7. The loopback: transmitter → synchroniser → receiver

-- the synchroniser's specification: two flip-flops, the line delayed by two cycles
inductive SyS where
  | mk (f1 : Bool) (f2 : Bool)
def SyS.f1 : SyS → Bool
  | .mk f1 f2 => f1
def SyS.f2 : SyS → Bool
  | .mk f1 f2 => f2
def Sy.spec (s : SyS) (p : Bool) : SyS × Bool := (SyS.mk p s.f1, s.f2)
def Sy.s0 : SyS := SyS.mk .true .true
def Sy.emb (s : SyS) : HwTy.El syncC.st := Bundle.toEl Sync.bundle (Sync.mk (Bool.toBits s.f1) (Bool.toBits s.f2))
def Sy.OK (s : SyS) (p : Bool) : Prop :=
  syncM (Sy.emb s) (Rx.embIn p) = (Sy.emb (Sy.spec s p).1, Rx.embIn (Sy.spec s p).2)
def Sy.ok3 : (f1 f2 p : Bool) → Sy.OK (SyS.mk f1 f2) p
  | .true, .true, .true => rfl
  | .true, .true, .false => rfl
  | .true, .false, .true => rfl
  | .true, .false, .false => rfl
  | .false, .true, .true => rfl
  | .false, .true, .false => rfl
  | .false, .false, .true => rfl
  | .false, .false, .false => rfl
def Sy.ok : (s : SyS) → (p : Bool) → Sy.OK s p
  | .mk f1 f2, p => Sy.ok3 f1 f2 p
def Sy.init_emb : syncC.init = Sy.emb Sy.s0 := refl syncC.init
def Sy.refinesOut (ys : Trace Bool) (u : Nat) :
    Mealy.outAt syncM syncC.init (Trace.map Rx.embIn ys) u = Rx.embIn (Mealy.outAt Sy.spec Sy.s0 ys u) :=
  Mealy.simulatesOut syncM Sy.spec Sy.emb Rx.embIn Rx.embIn Sy.ok Sy.s0 ys u
-- the line two cycles later
def Sy.delay (ys : Trace Bool) (u : Nat) : Mealy.outAt Sy.spec Sy.s0 ys (Nat.succ (Nat.succ u)) = ys u := rfl

-- The three specifications on each other's outputs
def Loop.line (xs : Trace (Bool × Bits8)) : Trace Bool := Mealy.outAt Tx.spec Tx.s0 xs
def Loop.rs (xs : Trace (Bool × Bits8)) : Trace Bool := Mealy.outAt Sy.spec Sy.s0 (Loop.line xs)

-- The circuit `loopC` (Circuit.seq of the three) is that composition, for every input
-- trace: its output is the receiver's specification on the synchroniser's on the
-- transmitter's.
def loopM : Mealy (HwTy.El loopC.st) (HwTy.El Send.code) (HwTy.El Byte.code) := Circuit.stepEl loopC
def Loop.stepEq : loopM = Mealy.seq (Mealy.seq txM syncM) rxM := rfl
def Loop.outImpl (xs : Trace (Bool × Bits8)) (u : Nat) : HwTy.El Byte.code := Mealy.outAt loopM loopC.init (Trace.map Tx.embIn xs) u
def Loop.refinesOut (xs : Trace (Bool × Bits8)) (u : Nat) : Loop.outImpl xs u = Rx.embOut (Rx.outs (Loop.rs xs) u) :=
  Eq.trans (Eq.congrArg (fun (m : Mealy (HwTy.El loopC.st) (HwTy.El Send.code) (HwTy.El Byte.code)) => Mealy.outAt m loopC.init (Trace.map Tx.embIn xs) u) Loop.stepEq)
   (Eq.trans (Mealy.seq_outAt (Mealy.seq txM syncM) rxM ((txC 4).init, syncC.init) (rxC 4).init (Trace.map Tx.embIn xs) u)
    (Eq.trans (Eq.congrArg (fun (ys : Trace (HwTy.El Line.code)) => Mealy.outAt rxM (rxC 4).init ys u)
       (funext (fun (w : Nat) => Eq.trans (Mealy.seq_outAt txM syncM (txC 4).init syncC.init (Trace.map Tx.embIn xs) w)
         (Eq.trans (Eq.congrArg (fun (zs : Trace (HwTy.El Line.code)) => Mealy.outAt syncM syncC.init zs w)
            (funext (fun (j : Nat) => Tx.refinesOut xs j)))
           (Sy.refinesOut (Loop.line xs) w)))))
      (Rx.refinesOut (Loop.rs xs) u)))

-- Facts about the parts the proof needs
def Rx.ph_next_true : (s : RxS) → s.ph = 0 ∨ (s.ph = 1 ∧ s.c = 3) → (Rx.next s .true).ph = 0
  | .mk ph c cs, h => Or.elim h
      (fun (e : ph = 0) => Eq.substProp (fun (p : Nat) => (Rx.next (RxS.mk p c cs) .true).ph = 0) (Eq.symm e) rfl)
      (fun (e : ph = 1 ∧ c = 3) => Eq.substProp (fun (p : Nat) => (Rx.next (RxS.mk p c cs) .true).ph = 0) (Eq.symm e.1)
        (Eq.substProp (fun (k : Nat) => (Rx.next (RxS.mk 1 k cs) .true).ph = 0) (Eq.symm e.2) rfl))
def Rx.eta0 : (s : RxS) → s.ph = 0 → s = RxS.mk 0 s.c s.cs
  | .mk ph c cs, h => Eq.substProp (fun (p : Nat) => RxS.mk p c cs = RxS.mk 0 c cs) (Eq.symm h) rfl
def Rx.out_idle : (s : RxS) → (r : Bool) → s.ph = 0 → (Rx.out s r).1 = .false
  | .mk ph c cs, r, h => Eq.substProp (fun (p : Nat) => (Rx.out (RxS.mk p c cs) r).1 = .false) (Eq.symm h) rfl
def Tx.line_idle (xs : Trace (Bool × Bits8)) (u : Nat) (h : (Tx.run xs u).l = 0) : Loop.line xs u = .true :=
  Eq.congrArg (fun (l : Nat) => Tx.lineOf (Tx.run xs u).d l) h
def Tx.frameSpec (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hidle : (Tx.run xs t).l = 0) (hgo : (xs t) = (.true, e))
    (m : Nat) (hm : Nat.lt m 40 = .true) : Loop.line xs (Nat.add m (Nat.succ t)) = Uart.frameBit e (Nat.div m 4) :=
  Eq.trans (Eq.congrArg (fun (s : TxS) => Tx.lineOf s.d s.l) (Tx.frameRun xs t e hidle hgo m (Nat.lt_to_succ m 40 hm)))
    (Nat.all_spec (Tx.lineBit e) 40 (Tx.lineBits e) m hm)

-- (L1) A byte taken by the transmitter at cycle t, while the synchroniser holds the high
-- line and the receiver is idle or at the stop bit of the frame before, is reported by
-- the receiver at cycle t + 41, and nothing is reported from t + 1 to t + 40.
def Loop.Quiet (xs : Trace (Bool × Bits8)) (t : Nat) : Prop :=
  (Tx.run xs t).l = 0 ∧ Mealy.stateAt Sy.spec Sy.s0 (Loop.line xs) t = SyS.mk .true .true ∧
    ((Rx.run (Loop.rs xs) t).ph = 0 ∨ ((Rx.run (Loop.rs xs) t).ph = 1 ∧ (Rx.run (Loop.rs xs) t).c = 3))

def Loop.rxLine (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hq : Loop.Quiet xs t) (hgo : xs t = (.true, e))
    (k : Nat) (hk : Nat.lt k 40 = .true) :
    Loop.rs xs (Nat.add k (Nat.succ (Nat.succ (Nat.succ t)))) = Uart.frameBit e (Nat.div k 4) :=
  Eq.trans (Eq.congrArg (Loop.rs xs) (Eq.trans (Nat.add_succ k (Nat.succ (Nat.succ t)))
      (Eq.congrArg Nat.succ (Nat.add_succ k (Nat.succ t)))))
    (Tx.frameSpec xs t e hq.1 hgo k hk)

def Loop.rxIdle (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hq : Loop.Quiet xs t) :
    (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t)))).ph = 0 :=
  Eq.substProp (fun (r : Bool) => (Rx.next (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ t))) r).ph = 0)
    (Eq.symm (Tx.line_idle xs t hq.1))
    (Rx.ph_next_true (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ t))) (Or.inl
      (Eq.substProp (fun (r : Bool) => (Rx.next (Rx.run (Loop.rs xs) (Nat.succ t)) r).ph = 0)
        (Eq.symm (Eq.congrArg SyS.f1 hq.2.1))
        (Rx.ph_next_true (Rx.run (Loop.rs xs) (Nat.succ t)) (Or.inl
          (Eq.substProp (fun (r : Bool) => (Rx.next (Rx.run (Loop.rs xs) t) r).ph = 0)
            (Eq.symm (Eq.congrArg SyS.f2 hq.2.1))
            (Rx.ph_next_true (Rx.run (Loop.rs xs) t) hq.2.2)))))))

def Loop.delivers (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hq : Loop.Quiet xs t) (hgo : xs t = (.true, e)) :
    Rx.outs (Loop.rs xs) (Nat.add 38 (Nat.succ (Nat.succ (Nat.succ t)))) = (.true, e) :=
  Rx.receives (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t))) (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t)))).c
    (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t)))).cs e
    (Rx.eta0 (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t)))) (Loop.rxIdle xs t e hq))
    (fun (k : Nat) (hk : Nat.lt k 38 = .true) => Loop.rxLine xs t e hq hgo k (Nat.lt_to_succ k 39 (Nat.lt_to_succ k 38 hk)))
    (Loop.rxLine xs t e hq hgo 38 rfl)
def Loop.silent (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hq : Loop.Quiet xs t) (hgo : xs t = (.true, e))
    (k : Nat) (hk : Nat.lt k 38 = .true) : (Rx.outs (Loop.rs xs) (Nat.add k (Nat.succ (Nat.succ (Nat.succ t))))).1 = .false :=
  Rx.quiet (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t))) (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t)))).c
    (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t)))).cs e
    (Rx.eta0 (Rx.run (Loop.rs xs) (Nat.succ (Nat.succ (Nat.succ t)))) (Loop.rxIdle xs t e hq))
    (fun (j : Nat) (hj : Nat.lt j 38 = .true) => Loop.rxLine xs t e hq hgo j (Nat.lt_to_succ j 39 (Nat.lt_to_succ j 38 hj)))
    k hk

-- The circuit's output at cycle t + 41 is `Rx.embOut` of that (`Loop.refinesOut`).

-- (L2) After reset the loopback is quiet until the first byte is sent, so the first
-- byte is delivered: for every input trace whose first start is at cycle t.
def Tx.stay_idle : (s : TxS) → (x : Bool × Bits8) → s.l = 0 → x.1 = .false → (Tx.spec s x).1.l = 0
  | .mk l c d, x, hl, hx => Eq.substProp (fun (k : Nat) => (Tx.spec (TxS.mk k c d) x).1.l = 0) (Eq.symm hl)
      (Eq.substProp (fun (b : Bool) => (Tx.spec (TxS.mk 0 c d) (b, x.2)).1.l = 0) (Eq.symm hx) rfl)
def Loop.quietStep (xs : Trace (Bool × Bits8)) (u : Nat) (hs : (xs u).1 = .false) (hq : Loop.Quiet xs u) : Loop.Quiet xs (Nat.succ u) :=
  And.intro (Tx.stay_idle (Tx.run xs u) (xs u) hq.1 hs)
    (And.intro
      (@Eq.trans SyS (SyS.mk (Loop.line xs u) (Mealy.stateAt Sy.spec Sy.s0 (Loop.line xs) u).f1) (SyS.mk .true (Mealy.stateAt Sy.spec Sy.s0 (Loop.line xs) u).f1) (SyS.mk .true .true)
        (Eq.congrArg (fun (p : Bool) => SyS.mk p (Mealy.stateAt Sy.spec Sy.s0 (Loop.line xs) u).f1) (Tx.line_idle xs u hq.1))
        (Eq.congrArg (fun (q : Bool) => SyS.mk .true q) (Eq.congrArg SyS.f1 hq.2.1)))
      (Or.inl (Eq.substProp (fun (r : Bool) => (Rx.next (Rx.run (Loop.rs xs) u) r).ph = 0)
        (Eq.symm (Eq.congrArg SyS.f2 hq.2.1))
        (Rx.ph_next_true (Rx.run (Loop.rs xs) u) hq.2.2))))
def Loop.quietUntil (xs : Trace (Bool × Bits8)) (t : Nat) (hnone : (u : Nat) → Nat.lt u t = .true → (xs u).1 = .false) :
    (u : Nat) → Nat.lt u (Nat.succ t) = .true → Loop.Quiet xs u
  | .zero, h => And.intro rfl (And.intro rfl (Or.inl rfl))
  | .succ u, h => Loop.quietStep xs u (hnone u h) (Loop.quietUntil xs t hnone u (Nat.lt_to_succ u t h))
def Loop.firstByte (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hnone : (u : Nat) → Nat.lt u t = .true → (xs u).1 = .false)
    (hgo : xs t = (.true, e)) : Rx.outs (Loop.rs xs) (Nat.add 38 (Nat.succ (Nat.succ (Nat.succ t)))) = (.true, e) :=
  Loop.delivers xs t e (Loop.quietUntil xs t hnone t (Nat.lt_self_succ t)) hgo
