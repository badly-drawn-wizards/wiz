def Rx.case : (s : RxS) → (r : Bool) → Rx.inv s → Rx.Case s r
  | .mk ph c cs, r, h => Bool.indP (fun (b : Bool) => Rx.Case (RxS.mk ph c cs) b)
      (Nat.all_spec Rx.CaseL 11 Rx.cases ph h.1 c h.2 cs).1 (Nat.all_spec Rx.CaseL 11 Rx.cases ph h.1 c h.2 cs).2 r
def Rx.ok (s : RxS) (r : Bool) (h : Rx.inv s) : rxM (Rx.emb s) (Rx.embIn r) = (Rx.emb (Rx.spec s r).1, Rx.embOut (Rx.spec s r).2) :=
  @Eq.trans RxP (rxM (Rx.emb s) (Rx.embIn r))
    (Rx.pk (Rx.Gd (Rx.embT s) (Bool.toBits r)).1, Rx.pkO (Rx.Gd (Rx.embT s) (Bool.toBits r)).2)
    (Rx.emb (Rx.spec s r).1, Rx.embOut (Rx.spec s r).2)
    (Rx.stepG (Rx.embT s) (Bool.toBits r))
    (Eq.congrArg (fun (p : RxTO) => (Rx.pk p.1, Rx.pkO p.2)) (Rx.case s r h).1)
def Rx.pres (s : RxS) (r : Bool) (h : Rx.inv s) : Rx.inv (Rx.spec s r).1 := (Rx.case s r h).2
def Rx.inv0 : Rx.inv Rx.s0 := And.intro rfl rfl

-- For every input trace (the line, as Booleans): the circuit's state and output are the
-- specification's.
def Rx.run (rs : Trace Bool) : Trace RxS := Mealy.stateAt Rx.spec Rx.s0 rs
def Rx.outs (rs : Trace Bool) : Trace (Bool × Bits8) := Mealy.outAt Rx.spec Rx.s0 rs
def Rx.refines (rs : Trace Bool) (t : Nat) :
    Mealy.stateAt rxM (rxC 4).init (Trace.map Rx.embIn rs) t = Rx.emb (Rx.run rs t) :=
  Mealy.simulatesInv rxM Rx.spec Rx.emb Rx.embIn Rx.embOut Rx.inv Rx.pres Rx.ok Rx.s0 Rx.inv0 rs t
def Rx.refinesOut (rs : Trace Bool) (t : Nat) :
    Mealy.outAt rxM (rxC 4).init (Trace.map Rx.embIn rs) t = Rx.embOut (Rx.outs rs t) :=
  Mealy.simulatesInvOut rxM Rx.spec Rx.emb Rx.embIn Rx.embOut Rx.inv Rx.pres Rx.ok Rx.s0 Rx.inv0 rs t

