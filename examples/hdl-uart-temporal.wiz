-- Temporal properties of a real design: the iCEstick UART (transmitter, synchroniser,
-- receiver) of wiz-icestick-uart (src/Icestick/Uart.wiz, copied below unchanged), with
-- 4 clock cycles per bit. Checked by the `hdl` test group. Doc:
-- docs/libraries.md, "H14 T2: the iCEstick UART, temporal properties".
--
-- What is proved (kernel-checked, for every input trace and every byte):
--   Tx.idleHigh       the transmitter's line is high whenever it is idle
--   Tx.frame          a byte accepted at cycle t is on the line from t+1: a start bit, the
--                     8 data bits least significant first and a stop bit, 4 cycles each
--   Tx.returns        40 cycles later the transmitter is idle again, and takes the next byte
--   Rx.receives       the receiver, idle and fed a well-formed frame, reports that byte
--   Rx.badStop        … and with a low stop bit reports nothing and is idle again
--   Rx.glitch         a low pulse shorter than half a bit does not start a frame
--   Loop.delivers     transmitter → synchroniser → receiver: a byte accepted at cycle t
--                     comes out at cycle t+41, and nothing comes out in between
--
-- The method (docs/libraries.md, H14 T2):
-- 1. Specifications on friendly types: control as `Nat`s, data as Booleans (`Bits8`, a
--    9-bit register `Reg9`). The circuit's states are images of the specification's
--    (`Tx.emb`, `Rx.emb`).
-- 2. Refinement, one step: for every reachable control state (11·4 for the transmitter,
--    166 for the receiver) and every input, the circuit's step on the image is the image
--    of the specification's step. The data are variables throughout; each case is a
--    kernel evaluation, generated by scripts/gen-uart-temporal.py. Where the data path
--    computes (a shift), one lemma about words closes the gap (`Uart.shift_reg9`, …),
--    proved by evaluating it on all 2^9 Boolean inputs.
-- 3. `Mealy.simulatesInv`: so the circuit's run on any input trace is the image of the
--    specification's run, for ever. Every temporal property is proved on the
--    specification, where a step is a small computation on Nats and Booleans.
import Hdl.Temporal

------------------------------------------------------------------------------------
-- 0. The design (wiz-icestick-uart, src/Icestick/Gates.wiz and Uart.wiz, unchanged)

def Bit : HwTy := HwTy.bits 1
def B4 : HwTy := HwTy.bits 4
def B7 : HwTy := HwTy.bits 7
def B8 : HwTy := HwTy.bits 8
def B9 : HwTy := HwTy.bits 9

def hi {r : HwTy → Type} [Hw r] : r Bit := Hw.lit 1 1
def lo {r : HwTy → Type} [Hw r] : r Bit := Hw.lit 1 0

def band {r : HwTy → Type} [Hw r] (a b : r Bit) : r Bit := Hw.and a b
def bor {r : HwTy → Type} [Hw r] (a b : r Bit) : r Bit := Hw.or a b
def bnot {r : HwTy → Type} [Hw r] (a : r Bit) : r Bit := Hw.not a

def eqLit {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) (k : Nat) : r Bit :=
  Hw.eq x (Hw.lit n k)
def inc {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) : r (HwTy.bits n) :=
  Hw.add x (Hw.lit n 1)
def dec {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) : r (HwTy.bits n) :=
  Hw.sub x (Hw.lit n 1)

def frame9 {r : HwTy → Type} [Hw r] (d : r B8) : r B9 := Hw.cat (Hw.lit 1 1) d
def shiftIn9 {r : HwTy → Type} [Hw r] (x : r B9) (b : r Bit) : r B9 := Hw.cat b (Hw.slice 1 8 x)
def shiftIn8 {r : HwTy → Type} [Hw r] (x : r B8) (b : r Bit) : r B8 := Hw.cat b (Hw.slice 1 7 x)

def baudStep {r : HwTy → Type} [Hw r] (n : Nat) (c : r B7) : r (HwTy.prod B7 Bit) :=
  let t := Hw.label "tick" (eqLit c (n - 1));
  Hw.pair (Hw.mux t (Hw.lit 7 0) (inc c)) t

structure Tx (r : HwTy → Type) where
  line : r Bit
  left : r B4
  cnt : r B7
  sh : r B9
  deriving Bundle

def Tx.init : Tx HwTy.El := Tx.mk (BitVec.ofNat 1 1) (BitVec.ofNat 4 0) (BitVec.ofNat 7 0) (BitVec.ofNat 9 511)

def txIdle {r : HwTy → Type} [Hw r] (s : Tx r) : r Bit := eqLit s.left 0

def txStep {r : HwTy → Type} [Hw r] (n : Nat) (s : Tx r) (start : r Bit) (d : r B8) : r Tx.code :=
  let idle := txIdle s;
  let go := band idle start;
  let b := baudStep n s.cnt;
  let tick := band (bnot idle) (Hw.snd b);
  Tx.pack (Tx.mk
    (Hw.mux go lo (Hw.mux tick (Hw.slice 0 1 s.sh) s.line))
    (Hw.mux go (Hw.lit 4 10) (Hw.mux tick (dec s.left) s.left))
    (Hw.mux go (Hw.lit 7 0) (Hw.fst b))
    (Hw.mux go (frame9 d) (Hw.mux tick (shiftIn9 s.sh hi) s.sh)))

structure Rx (r : HwTy → Type) where
  ph : r B4
  cnt : r B7
  sh : r B8
  deriving Bundle

structure Byte (r : HwTy → Type) where
  valid : r Bit
  data : r B8
  deriving Bundle

def Rx.init : Rx HwTy.El := Rx.mk (BitVec.ofNat 4 0) (BitVec.ofNat 7 0) (BitVec.ofNat 8 0)

def rxStep {r : HwTy → Type} [Hw r] (n : Nat) (s : Rx r) (rx : r Bit) : r (HwTy.prod Rx.code Byte.code) :=
  let idle := eqLit s.ph 0;
  let inStart := eqLit s.ph 10;
  let inStop := eqLit s.ph 1;
  let fall := band idle (bnot rx);
  let startTick := band inStart (eqLit s.cnt (Nat.div n 2 - 1));
  let tick := band (bnot idle) (band (bnot inStart) (eqLit s.cnt (n - 1)));
  let ph := Hw.mux fall (Hw.lit 4 10)
    (Hw.mux startTick (Hw.mux rx (Hw.lit 4 0) (Hw.lit 4 9)) (Hw.mux tick (dec s.ph) s.ph));
  let cnt := Hw.mux (bor fall (bor startTick tick)) (Hw.lit 7 0) (inc s.cnt);
  let sh := Hw.mux (band tick (bnot inStop)) (shiftIn8 s.sh rx) s.sh;
  Hw.pair (Rx.pack (Rx.mk ph cnt sh)) (Byte.pack (Byte.mk (band tick (band inStop rx)) s.sh))

structure Sync (r : HwTy → Type) where
  ff1 : r Bit
  ff2 : r Bit
  deriving Bundle

def Sync.init : Sync HwTy.El := Sync.mk (BitVec.ofNat 1 1) (BitVec.ofNat 1 1)
def syncStep {r : HwTy → Type} [Hw r] (s : Sync r) (pin : r Bit) : r Sync.code := Sync.pack (Sync.mk pin s.ff1)

structure Send (r : HwTy → Type) where
  start : r Bit
  data : r B8
  deriving Bundle
structure Line (r : HwTy → Type) where
  line : r Bit
  deriving Bundle

def txC (n : Nat) : Circuit Send.code Line.code :=
  Circuit.bundled Tx.bundle Send.bundle Line.bundle Tx.init
    (fun s x => Hw.pair (txStep n s x.start x.data) (Line.pack (Line.mk s.line)))
def syncC : Circuit Line.code Line.code :=
  Circuit.bundled Sync.bundle Line.bundle Line.bundle Sync.init
    (fun s x => Hw.pair (syncStep s x.line) (Line.pack (Line.mk s.ff2)))
def rxC (n : Nat) : Circuit Line.code Byte.code :=
  Circuit.bundled Rx.bundle Line.bundle Byte.bundle Rx.init (fun s x => rxStep n s x.line)

-- The loopback of wiz-icestick-uart's Icestick.Proofs: the line through the
-- synchroniser into the receiver. Here with 4 cycles per bit (the board: 104).
def loopC : Circuit Send.code Byte.code := Circuit.seq (Circuit.seq (txC 4) syncC) (rxC 4)

-- The machines, with their types spelled out once
def txM : Mealy (HwTy.El (txC 4).st) (HwTy.El Send.code) (HwTy.El Line.code) := Circuit.stepEl (txC 4)
def syncM : Mealy (HwTy.El syncC.st) (HwTy.El Line.code) (HwTy.El Line.code) := Circuit.stepEl syncC
def rxM : Mealy (HwTy.El (rxC 4).st) (HwTy.El Line.code) (HwTy.El Byte.code) := Circuit.stepEl (rxC 4)

------------------------------------------------------------------------------------
-- 1. Generic tools: from lib/Trace.wiz (Mealy.simulatesInv, Mealy.follows, Mealy.seq,
-- Nat.All, Bool.forall9, Bool.indP) and UIntN.ext (lib/Word.wiz) for word equality.

------------------------------------------------------------------------------------
-- 2. Data as Booleans

structure Bits8 where
  b0 : Bool
  b1 : Bool
  b2 : Bool
  b3 : Bool
  b4 : Bool
  b5 : Bool
  b6 : Bool
  b7 : Bool
structure Reg9 where
  r0 : Bool
  r1 : Bool
  r2 : Bool
  r3 : Bool
  r4 : Bool
  r5 : Bool
  r6 : Bool
  r7 : Bool
  r8 : Bool

def Bool.toN (b : Bool) : Nat := match b with
  | .true => 1
  | .false => 0
def Bits8.val (d : Bits8) : Nat :=
  Bool.toN d.b0 + 2 * (Bool.toN d.b1 + 2 * (Bool.toN d.b2 + 2 * (Bool.toN d.b3 + 2 * (Bool.toN d.b4 +
    2 * (Bool.toN d.b5 + 2 * (Bool.toN d.b6 + 2 * Bool.toN d.b7))))))
def Reg9.val (r : Reg9) : Nat :=
  Bool.toN r.r0 + 2 * (Bool.toN r.r1 + 2 * (Bool.toN r.r2 + 2 * (Bool.toN r.r3 + 2 * (Bool.toN r.r4 +
    2 * (Bool.toN r.r5 + 2 * (Bool.toN r.r6 + 2 * (Bool.toN r.r7 + 2 * Bool.toN r.r8)))))))
-- the byte with these bits (bit i = `bi`); every byte is one (2^8 of them)
def byte (d : Bits8) : BitVec 8 := BitVec.ofNat 8 (Bits8.val d)
def reg9 (r : Reg9) : BitVec 9 := BitVec.ofNat 9 (Reg9.val r)
def Bits8.zero : Bits8 := Bits8.mk .false .false .false .false .false .false .false .false

-- the frame in the transmitter's shift register: the data, the stop bit on top
def Reg9.frame (d : Bits8) : Reg9 := Reg9.mk d.b0 d.b1 d.b2 d.b3 d.b4 d.b5 d.b6 d.b7 .true
-- one shift right, a one coming in at the top (`shiftIn9 x hi`)
def Reg9.shift (r : Reg9) : Reg9 := Reg9.mk r.r1 r.r2 r.r3 r.r4 r.r5 r.r6 r.r7 r.r8 .true
def Reg9.shifts : Nat → Reg9 → Reg9
  | .zero, r => r
  | .succ k, r => Reg9.shift (Reg9.shifts k r)
-- one shift right of the receiver's register, `b` coming in at the top (`shiftIn8 x b`)
def Bits8.shiftIn (d : Bits8) (b : Bool) : Bits8 := Bits8.mk d.b1 d.b2 d.b3 d.b4 d.b5 d.b6 d.b7 b

-- The words the data path computes, as functions of the bits (2^9 evaluations each).
def shift9 (x : BitVec 9) : BitVec 9 := @shiftIn9 HwTy.El _ x hi
def bit0 (x : BitVec 9) : BitVec 1 := @HwTy.El.slice 0 1 9 x
def shift8 (x : BitVec 8) (b : BitVec 1) : BitVec 8 := @shiftIn8 HwTy.El _ x b

def Uart.shiftQ (a b c d e f g i j : Bool) : Bool :=
  Nat.beq (BitVec.toNat (shift9 (reg9 (Reg9.mk a b c d e f g i j)))) (BitVec.toNat (reg9 (Reg9.shift (Reg9.mk a b c d e f g i j))))
def Uart.bit0Q (a b c d e f g i j : Bool) : Bool :=
  Nat.beq (BitVec.toNat (bit0 (reg9 (Reg9.mk a b c d e f g i j)))) (BitVec.toNat (Bool.toBits a))
def Uart.frameQ (a b c d e f g i j : Bool) : Bool :=
  Nat.beq (BitVec.toNat (@frame9 HwTy.El _ (byte (Bits8.mk a b c d e f g i)))) (BitVec.toNat (reg9 (Reg9.frame (Bits8.mk a b c d e f g i))))
def Uart.shift8Q (a b c d e f g i j : Bool) : Bool :=
  Nat.beq (BitVec.toNat (shift8 (byte (Bits8.mk a b c d e f g i)) (Bool.toBits j))) (BitVec.toNat (byte (Bits8.shiftIn (Bits8.mk a b c d e f g i) j)))
def Uart.shiftQ_all : Bool.all9 Uart.shiftQ = .true := refl Bool.true
def Uart.bit0Q_all : Bool.all9 Uart.bit0Q = .true := refl Bool.true
def Uart.frameQ_all : Bool.all9 Uart.frameQ = .true := refl Bool.true
def Uart.shift8Q_all : Bool.all9 Uart.shift8Q = .true := refl Bool.true

def Uart.shift_reg9 (r : Reg9) : shift9 (reg9 r) = reg9 (Reg9.shift r) :=
  UIntN.ext (shift9 (reg9 r)) (reg9 (Reg9.shift r))
    (Nat.eq_of_beq _ _ (Bool.forall9 Uart.shiftQ Uart.shiftQ_all r.r0 r.r1 r.r2 r.r3 r.r4 r.r5 r.r6 r.r7 r.r8))
def Uart.bit0_reg9 (r : Reg9) : bit0 (reg9 r) = Bool.toBits r.r0 :=
  UIntN.ext (bit0 (reg9 r)) (Bool.toBits r.r0)
    (Nat.eq_of_beq _ _ (Bool.forall9 Uart.bit0Q Uart.bit0Q_all r.r0 r.r1 r.r2 r.r3 r.r4 r.r5 r.r6 r.r7 r.r8))
def Uart.frame_byte (d : Bits8) : @frame9 HwTy.El _ (byte d) = reg9 (Reg9.frame d) :=
  UIntN.ext (@frame9 HwTy.El _ (byte d)) (reg9 (Reg9.frame d))
    (Nat.eq_of_beq _ _ (Bool.forall9 Uart.frameQ Uart.frameQ_all d.b0 d.b1 d.b2 d.b3 d.b4 d.b5 d.b6 d.b7 .false))
def Uart.shift8_byte (d : Bits8) (b : Bool) : shift8 (byte d) (Bool.toBits b) = byte (Bits8.shiftIn d b) :=
  UIntN.ext (shift8 (byte d) (Bool.toBits b)) (byte (Bits8.shiftIn d b))
    (Nat.eq_of_beq _ _ (Bool.forall9 Uart.shift8Q Uart.shift8Q_all d.b0 d.b1 d.b2 d.b3 d.b4 d.b5 d.b6 d.b7 b))

------------------------------------------------------------------------------------
-- 3. The transmitter's specification
--
-- State `TxS.mk l c d`: `l` bit periods left (0: idle; 10: start bit, 9 … 2: data bits
-- 0 … 7, 1: stop bit), `c` the cycle within the bit (0 … 3; it runs while idle too)
-- and `d` the byte of the frame (the last one, while idle). Input: (start, byte);
-- output: the line. The line and the shift register are functions of `(l, d)`.

inductive TxS where
  | mk (l : Nat) (c : Nat) (d : Bits8)
def TxS.l : TxS → Nat
  | .mk l c d => l
def TxS.c : TxS → Nat
  | .mk l c d => c
def TxS.d : TxS → Bits8
  | .mk l c d => d

-- the register after `10 - l` ticks, and the line (low in the start bit, else the
-- bit shifted out last)
def Tx.reg (d : Bits8) (l : Nat) : Reg9 := Reg9.shifts (Nat.sub 10 l) (Reg9.frame d)
def Tx.lineOf (d : Bits8) (l : Nat) : Bool := match Nat.beq l 10 with
  | .true => .false
  | .false => (Reg9.shifts (Nat.sub 9 l) (Reg9.frame d)).r0

def Tx.cntNext (c : Nat) : Nat := match Nat.beq c 3 with
  | .true => 0
  | .false => Nat.succ c
def Tx.spec (s : TxS) (x : Bool × Bits8) : TxS × Bool :=
  (match Nat.beq s.l 0 with
    | .true => (match x.1 with
      | .true => TxS.mk 10 0 x.2
      | .false => TxS.mk 0 (Tx.cntNext s.c) s.d)
    | .false => (match Nat.beq s.c 3 with
      | .true => TxS.mk (Nat.sub s.l 1) 0 s.d
      | .false => TxS.mk s.l (Nat.succ s.c) s.d),
   Tx.lineOf s.d s.l)

def Tx.s0 : TxS := TxS.mk 0 0 Bits8.zero
def Tx.inv (s : TxS) : Prop := Nat.lt s.l 11 = .true ∧ Nat.lt s.c 4 = .true

-- The circuit's state as a plain tuple (line, left, cnt, sh), and its step as a function
-- of the two comparisons it makes (`left == 0`, `cnt == 3`): `Tx.G`, the same gates as
-- `txStep`. `Tx.stepG` (one evaluation, everything a variable) says that it is the step.
def TxT : Type := BitVec 1 × (BitVec 4 × (BitVec 7 × BitVec 9))
def Tx.pk (q : TxT) : HwTy.El (txC 4).st := Bundle.toEl Tx.bundle (Tx.mk q.1 q.2.1 q.2.2.1 q.2.2.2)
def Tx.in (st : Bool) (d : BitVec 8) : HwTy.El Send.code := Bundle.toEl Send.bundle (Send.mk (Bool.toBits st) d)
def Tx.wire (ln : BitVec 1) : HwTy.El Line.code := Bundle.toEl Line.bundle (Line.mk ln)
def Tx.G (bi bt : Bool) (q : TxT) (start : BitVec 1) (d : BitVec 8) : TxT :=
  let idle := Bool.toBits bi;
  let go := BitVec.and idle start;
  let t := Bool.toBits bt;
  let tick := BitVec.and (BitVec.not idle) t;
  (@HwTy.El.mux Bit go (BitVec.ofNat 1 0) (@HwTy.El.mux Bit tick (bit0 q.2.2.2) q.1),
   (@HwTy.El.mux B4 go (BitVec.ofNat 4 10) (@HwTy.El.mux B4 tick (@dec HwTy.El _ 4 q.2.1) q.2.1),
    (@HwTy.El.mux B7 go (BitVec.ofNat 7 0) (@HwTy.El.mux B7 t (BitVec.ofNat 7 0) (@inc HwTy.El _ 7 q.2.2.1)),
     @HwTy.El.mux B9 go (@frame9 HwTy.El _ d) (@HwTy.El.mux B9 tick (shift9 q.2.2.2) q.2.2.2))))
def TxP : Type := HwTy.El (txC 4).st × HwTy.El Line.code
def Tx.stepG (q : TxT) (st : Bool) (d : BitVec 8) :
    txM (Tx.pk q) (Tx.in st d) = (Tx.pk (Tx.G (BitVec.beq q.2.1 (BitVec.ofNat 4 0)) (BitVec.beq q.2.2.1 (BitVec.ofNat 7 3)) q (Bool.toBits st) d), Tx.wire q.1) :=
  refl (Tx.pk (Tx.G (BitVec.beq q.2.1 (BitVec.ofNat 4 0)) (BitVec.beq q.2.2.1 (BitVec.ofNat 7 3)) q (Bool.toBits st) d), Tx.wire q.1)

-- the representation
def Tx.embT (s : TxS) : TxT := (Bool.toBits (Tx.lineOf s.d s.l), (BitVec.ofNat 4 s.l, (BitVec.ofNat 7 s.c, reg9 (Tx.reg s.d s.l))))
def Tx.emb (s : TxS) : HwTy.El (txC 4).st := Tx.pk (Tx.embT s)
def Tx.embIn (x : Bool × Bits8) : HwTy.El Send.code := Tx.in x.1 (byte x.2)
def Tx.embOut (b : Bool) : HwTy.El Line.code := Tx.wire (Bool.toBits b)

def Tx.init_emb : (txC 4).init = Tx.emb Tx.s0 := refl (txC 4).init

-- the refinement premise at the tuple level, one case per control state and start bit
def Tx.GOK (s : TxS) (x : Bool × Bits8) : Prop :=
  Tx.G (BitVec.beq (Tx.embT s).2.1 (BitVec.ofNat 4 0)) (BitVec.beq (Tx.embT s).2.2.1 (BitVec.ofNat 7 3)) (Tx.embT s) (Bool.toBits x.1) (byte x.2)
    = Tx.embT (Tx.spec s x).1
def Tx.Case (s : TxS) (x : Bool × Bits8) : Prop := Tx.GOK s x ∧ Tx.inv (Tx.spec s x).1
-- (the start bit is split outside: a table entry with a variable start bit would hold the
-- whole step unevaluated, and comparing it costs about a second per entry)
def Tx.CaseLC (l c : Nat) : Prop := (d e : Bits8) → Tx.Case (TxS.mk l c d) (.true, e) ∧ Tx.Case (TxS.mk l c d) (.false, e)
def Tx.CaseL (l : Nat) : Prop := (c : Nat) → Nat.lt c 4 = .true → Tx.CaseLC l c

-- BEGIN GENERATED tx (scripts/gen-uart-temporal.py)
def Tx.o_0_0_t (d e : Bits8) : Tx.GOK (TxS.mk 0 0 d) (.true, e) :=
  @Eq.trans TxT (Tx.G (BitVec.beq (BitVec.ofNat 4 0) (BitVec.ofNat 4 0)) (BitVec.beq (BitVec.ofNat 7 0) (BitVec.ofNat 7 3)) (Tx.embT (TxS.mk 0 0 d)) (Bool.toBits .true) (byte e)) (BitVec.ofNat 1 0, (BitVec.ofNat 4 10, (BitVec.ofNat 7 0, @frame9 HwTy.El _ (byte e)))) (BitVec.ofNat 1 0, (BitVec.ofNat 4 10, (BitVec.ofNat 7 0, reg9 (Reg9.frame e)))) (refl (BitVec.ofNat 1 0, (BitVec.ofNat 4 10, (BitVec.ofNat 7 0, @frame9 HwTy.El _ (byte e))))) (Eq.congrArg (fun (z : BitVec 9) => (BitVec.ofNat 1 0, (BitVec.ofNat 4 10, (BitVec.ofNat 7 0, z)))) (Uart.frame_byte e))
def Tx.v_0_0_t (d e : Bits8) : Tx.inv (Tx.spec (TxS.mk 0 0 d) (.true, e)).1 := And.intro rfl rfl
def Tx.c_0_0_t (d e : Bits8) : Tx.Case (TxS.mk 0 0 d) (.true, e) := And.intro (Tx.o_0_0_t d e) (Tx.v_0_0_t d e)
def Tx.o_0_0_f (d e : Bits8) : Tx.GOK (TxS.mk 0 0 d) (.false, e) :=
  refl (Tx.embT (TxS.mk 0 1 d))
def Tx.v_0_0_f (d e : Bits8) : Tx.inv (Tx.spec (TxS.mk 0 0 d) (.false, e)).1 := And.intro rfl rfl
def Tx.c_0_0_f (d e : Bits8) : Tx.Case (TxS.mk 0 0 d) (.false, e) := And.intro (Tx.o_0_0_f d e) (Tx.v_0_0_f d e)
def Tx.o_0_1_t (d e : Bits8) : Tx.GOK (TxS.mk 0 1 d) (.true, e) :=
  @Eq.trans TxT (Tx.G (BitVec.beq (BitVec.ofNat 4 0) (BitVec.ofNat 4 0)) (BitVec.beq (BitVec.ofNat 7 1) (BitVec.ofNat 7 3)) (Tx.embT (TxS.mk 0 1 d)) (Bool.toBits .true) (byte e)) (BitVec.ofNat 1 0, (BitVec.ofNat 4 10, (BitVec.ofNat 7 0, @frame9 HwTy.El _ (byte e)))) (BitVec.ofNat 1 0, (BitVec.ofNat 4 10, (BitVec.ofNat 7 0, reg9 (Reg9.frame e)))) (refl (BitVec.ofNat 1 0, (BitVec.ofNat 4 10, (BitVec.ofNat 7 0, @frame9 HwTy.El _ (byte e))))) (Eq.congrArg (fun (z : BitVec 9) => (BitVec.ofNat 1 0, (BitVec.ofNat 4 10, (BitVec.ofNat 7 0, z)))) (Uart.frame_byte e))
def Tx.v_0_1_t (d e : Bits8) : Tx.inv (Tx.spec (TxS.mk 0 1 d) (.true, e)).1 := And.intro rfl rfl
def Tx.c_0_1_t (d e : Bits8) : Tx.Case (TxS.mk 0 1 d) (.true, e) := And.intro (Tx.o_0_1_t d e) (Tx.v_0_1_t d e)
def Tx.o_0_1_f (d e : Bits8) : Tx.GOK (TxS.mk 0 1 d) (.false, e) :=
  refl (Tx.embT (TxS.mk 0 2 d))
def Tx.v_0_1_f (d e : Bits8) : Tx.inv (Tx.spec (TxS.mk 0 1 d) (.false, e)).1 := And.intro rfl rfl
