def Tx.frameStart (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hidle : (Tx.run xs t).l = 0) (hgo : (xs t) = (.true, e)) :
    Mealy.stateAt Tx.spec Tx.s0 xs (Nat.succ t) = Tx.frameSt e 0 :=
  @Eq.trans TxS (Tx.spec (Tx.run xs t) (xs t)).1 (Tx.spec (Tx.run xs t) (.true, e)).1 (TxS.mk 10 0 e)
    (Eq.congrArg (fun (x : Bool × Bits8) => (Tx.spec (Tx.run xs t) x).1) hgo) (Tx.go_step (Tx.run xs t) e hidle)
def Tx.frameSteps (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (k : Nat) (hk : Nat.lt k 40 = .true) :
    (Tx.spec (Tx.frameSt e k) (xs (Nat.add k (Nat.succ t)))).1 = Tx.frameSt e (Nat.succ k) :=
  Nat.all_spec (Tx.FStep e) 40 (Tx.fsteps e) k hk (xs (Nat.add k (Nat.succ t)))
def Tx.frameRun (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hidle : (Tx.run xs t).l = 0) (hgo : (xs t) = (.true, e))
    (m : Nat) (hm : Nat.lt m 41 = .true) : Tx.run xs (Nat.add m (Nat.succ t)) = Tx.frameSt e m :=
  Mealy.follows Tx.spec Tx.s0 xs (Tx.frameSt e) (Nat.succ t) 40 (Tx.frameStart xs t e hidle hgo) (Tx.frameSteps xs t e) m hm

-- (T2) Every byte accepted is framed on the line: in cycle `m` after the cycle that
-- took it (m < 40), the line carries bit `m / 4` of the frame — start bit, data bits
-- least significant first, stop bit — each for 4 cycles (the baud period).
def Tx.lineBit (e : Bits8) (m : Nat) : Prop := Tx.lineOf (Tx.frameSt e m).d (Tx.frameSt e m).l = Uart.frameBit e (Nat.div m 4)
-- BEGIN GENERATED txbits (scripts/gen-uart-temporal.py)
def Tx.lineBits (e : Bits8) : Nat.All (Tx.lineBit e) 40 :=
  And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (And.intro (True.intro) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)) (rfl)
-- END GENERATED txbits
def Tx.frame (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hidle : (Tx.run xs t).l = 0) (hgo : (xs t) = (.true, e))
    (m : Nat) (hm : Nat.lt m 40 = .true) :
    Tx.lineAt xs (Nat.add m (Nat.succ t)) = Tx.embOut (Uart.frameBit e (Nat.div m 4)) :=
  Eq.trans (Tx.lineAt_spec xs (Nat.add m (Nat.succ t)))
    (Eq.trans (Eq.congrArg (fun (s : TxS) => Tx.embOut (Tx.lineOf s.d s.l)) (Tx.frameRun xs t e hidle hgo m (Nat.lt_to_succ m 40 hm)))
      (Eq.congrArg Tx.embOut (Nat.all_spec (Tx.lineBit e) 40 (Tx.lineBits e) m hm)))

-- the same as a temporal formula: for a rigid byte `e`, goA e |=> the 40 cycles of the
-- frame (`TL.during` reads the offset from the start of the frame)
def Tx.frameTL (xs : Trace (Bool × Bits8)) (e : Bits8) :
    TL.always (TL.imp (Tx.goA e) (fun (σ : Trace (TxS × (Bool × Bits8))) (t : Nat) =>
      (m : Nat) → Nat.lt m 40 = .true → Tx.lineAt xs (Nat.add m (Nat.succ t)) = Tx.embOut (Uart.frameBit e (Nat.div m 4)))) (Tx.obs xs) 0 :=
  fun (k : Nat) (h : (Tx.run xs (Nat.add k 0)).l = 0 ∧ xs (Nat.add k 0) = (.true, e)) => Tx.frame xs (Nat.add k 0) e h.1 h.2

-- (T3) 41 cycles after it took a byte the transmitter is idle again (and its line
-- high: T1); the next byte is taken then.
def Tx.returns (xs : Trace (Bool × Bits8)) (t : Nat) (e : Bits8) (hidle : (Tx.run xs t).l = 0) (hgo : (xs t) = (.true, e)) :
    Tx.run xs (Nat.add 40 (Nat.succ t)) = TxS.mk 0 0 e :=
  Tx.frameRun xs t e hidle hgo 40 rfl
def Tx.accepts (xs : Trace (Bool × Bits8)) (t : Nat) (e e' : Bits8) (hidle : (Tx.run xs t).l = 0) (hgo : (xs t) = (.true, e))
    (hnext : xs (Nat.add 40 (Nat.succ t)) = (.true, e')) :
    Tx.run xs (Nat.succ (Nat.add 40 (Nat.succ t))) = TxS.mk 10 0 e' :=
  Eq.trans (Eq.congrArg (fun (x : Bool × Bits8) => (Tx.spec (Tx.run xs (Nat.add 40 (Nat.succ t))) x).1) hnext)
    (Tx.go_step (Tx.run xs (Nat.add 40 (Nat.succ t))) e' (Eq.congrArg (fun (s : TxS) => s.l) (Tx.returns xs t e hidle hgo)))
-- and while a frame is on the line, start is ignored: `Tx.frameRun` holds for every
-- input from cycle t+1 on.

------------------------------------------------------------------------------------
-- 5. The receiver's specification
--
-- State `RxS.mk ph c cs`: the phase (0 idle, 10 start bit, 9 … 2 data bits 0 … 7,
-- 1 stop bit), the cycle counter, and the shift register (bits as Booleans). Input:
-- the line; output: (valid, byte). While idle the counter runs (mod 128).

inductive RxS where
  | mk (ph : Nat) (c : Nat) (cs : Bits8)
def RxS.ph : RxS → Nat
  | .mk ph c cs => ph
def RxS.c : RxS → Nat
  | .mk ph c cs => c
def RxS.cs : RxS → Bits8
  | .mk ph c cs => cs

def Rx.cnt128 (c : Nat) : Nat := match Nat.beq c 127 with
  | .true => 0
  | .false => Nat.succ c
def Rx.next (s : RxS) (r : Bool) : RxS :=
  match Nat.beq s.ph 0 with
  | .true => (match r with
    | .true => RxS.mk 0 (Rx.cnt128 s.c) s.cs
    | .false => RxS.mk 10 0 s.cs)
  | .false => (match Nat.beq s.ph 10 with
    | .true => (match Nat.beq s.c 1 with
      | .true => (match r with
        | .true => RxS.mk 0 0 s.cs
        | .false => RxS.mk 9 0 s.cs)
      | .false => RxS.mk 10 (Nat.succ s.c) s.cs)
    | .false => (match Nat.beq s.c 3 with
      | .true => (match Nat.beq s.ph 1 with
        | .true => RxS.mk 0 0 s.cs
        | .false => RxS.mk (Nat.sub s.ph 1) 0 (Bits8.shiftIn s.cs r))
      | .false => RxS.mk s.ph (Nat.succ s.c) s.cs))
-- valid: at the sample of a stop bit that is high; the byte: the register
def Rx.out (s : RxS) (r : Bool) : Bool × Bits8 :=
  (match Nat.beq s.ph 1 with
    | .true => Bool.and (Nat.beq s.c 3) r
    | .false => .false,
   s.cs)
def Rx.spec (s : RxS) (r : Bool) : RxS × (Bool × Bits8) := (Rx.next s r, Rx.out s r)

def Rx.s0 : RxS := RxS.mk 0 0 Bits8.zero
def Rx.bound (ph : Nat) : Nat := match Nat.beq ph 0 with
  | .true => 128
  | .false => (match Nat.beq ph 10 with
    | .true => 2
    | .false => 4)
def Rx.inv (s : RxS) : Prop := Nat.lt s.ph 11 = .true ∧ Nat.lt s.c (Rx.bound s.ph) = .true

-- the circuit's state as a tuple (ph, cnt, sh), and its step as a function of its five
-- comparisons (ph == 0, 10, 1; cnt == 1, 3)
def RxT : Type := BitVec 4 × (BitVec 7 × BitVec 8)
def RxO : Type := BitVec 1 × BitVec 8
def Rx.pk (q : RxT) : HwTy.El (rxC 4).st := Bundle.toEl Rx.bundle (Rx.mk q.1 q.2.1 q.2.2)
def Rx.pkO (o : RxO) : HwTy.El Byte.code := Bundle.toEl Byte.bundle (Byte.mk o.1 o.2)
def Rx.G (bi bs bp bh bt : Bool) (q : RxT) (rx : BitVec 1) : RxT × RxO :=
  let idle := Bool.toBits bi;
  let inStart := Bool.toBits bs;
  let inStop := Bool.toBits bp;
  let fall := BitVec.and idle (BitVec.not rx);
  let startTick := BitVec.and inStart (Bool.toBits bh);
  let tick := BitVec.and (BitVec.not idle) (BitVec.and (BitVec.not inStart) (Bool.toBits bt));
  ((@HwTy.El.mux B4 fall (BitVec.ofNat 4 10) (@HwTy.El.mux B4 startTick (@HwTy.El.mux B4 rx (BitVec.ofNat 4 0) (BitVec.ofNat 4 9))
      (@HwTy.El.mux B4 tick (@dec HwTy.El _ 4 q.1) q.1)),
    (@HwTy.El.mux B7 (BitVec.or fall (BitVec.or startTick tick)) (BitVec.ofNat 7 0) (@inc HwTy.El _ 7 q.2.1),
     @HwTy.El.mux B8 (BitVec.and tick (BitVec.not inStop)) (shift8 q.2.2 rx) q.2.2)),
   (BitVec.and tick (BitVec.and inStop rx), q.2.2))
def RxP : Type := HwTy.El (rxC 4).st × HwTy.El Byte.code
def Rx.dec (q : RxT) : Bool × (Bool × (Bool × (Bool × Bool))) :=
  (BitVec.beq q.1 (BitVec.ofNat 4 0), (BitVec.beq q.1 (BitVec.ofNat 4 10), (BitVec.beq q.1 (BitVec.ofNat 4 1),
    (BitVec.beq q.2.1 (BitVec.ofNat 7 1), BitVec.beq q.2.1 (BitVec.ofNat 7 3)))))
def Rx.Gd (q : RxT) (rx : BitVec 1) : RxT × RxO :=
  Rx.G (Rx.dec q).1 (Rx.dec q).2.1 (Rx.dec q).2.2.1 (Rx.dec q).2.2.2.1 (Rx.dec q).2.2.2.2 q rx
def Rx.stepG (q : RxT) (r : BitVec 1) : rxM (Rx.pk q) (Tx.wire r) = (Rx.pk (Rx.Gd q r).1, Rx.pkO (Rx.Gd q r).2) :=
  refl (Rx.pk (Rx.Gd q r).1, Rx.pkO (Rx.Gd q r).2)

-- The same step with the comparisons combined as Booleans (`startTick`, `tick`): equal
-- to `Rx.G` for all 32 values of the comparisons (`Rx.GG2`). With it the idle step is
-- one lemma for every counter value: `Bool.and false _` computes, `BitVec.and 0 _` on a
-- symbolic bit does not.
def Rx.G2 (bi bs bp bh bt : Bool) (q : RxT) (rx : BitVec 1) : RxT × RxO :=
  let idle := Bool.toBits bi;
  let inStop := Bool.toBits bp;
  let fall := BitVec.and idle (BitVec.not rx);
  let startTick := Bool.toBits (Bool.and bs bh);
  let tick := Bool.toBits (Bool.and (Bool.not bi) (Bool.and (Bool.not bs) bt));
  ((@HwTy.El.mux B4 fall (BitVec.ofNat 4 10) (@HwTy.El.mux B4 startTick (@HwTy.El.mux B4 rx (BitVec.ofNat 4 0) (BitVec.ofNat 4 9))
      (@HwTy.El.mux B4 tick (@dec HwTy.El _ 4 q.1) q.1)),
    (@HwTy.El.mux B7 (BitVec.or fall (BitVec.or startTick tick)) (BitVec.ofNat 7 0) (@inc HwTy.El _ 7 q.2.1),
     @HwTy.El.mux B8 (BitVec.and tick (BitVec.not inStop)) (shift8 q.2.2 rx) q.2.2)),
   (BitVec.and tick (BitVec.and inStop rx), q.2.2))
def Rx.GEq (q : RxT) (rx : BitVec 1) (bi bs bp bh bt : Bool) : Prop := Rx.G bi bs bp bh bt q rx = Rx.G2 bi bs bp bh bt q rx
-- BEGIN GENERATED rxgg2 (scripts/gen-uart-temporal.py)
