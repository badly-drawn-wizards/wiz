-- 6. The receiver's properties
--
-- A well-formed frame of byte `e` from cycle `v`: the line carries bit `k / 4` of the
-- frame (`Uart.frameBit`, as the transmitter sends it) at cycle `k + v`, for k < 38
-- (start bit, data bits, the first half of the stop bit). The receiver, idle at `v`,
-- follows `Rx.path`, whatever its counter and register were.

-- the register after `n` data bits of `e` came in on top of `cs`
def Rx.csAt (cs e : Bits8) : Nat → Bits8
  | .zero => cs
  | .succ n => Bits8.shiftIn (Rx.csAt cs e n) (Bits8.bit e n)
def Rx.capped (n : Nat) : Nat := match Nat.lt n 8 with
  | .true => n
  | .false => 8
-- the state `k` cycles after the falling edge (k ≥ 1)
def Rx.frameSt (cs e : Bits8) (k : Nat) : RxS := match Nat.lt k 3 with
  | .true => (match Nat.beq k 1 with
    | .true => RxS.mk 10 0 cs
    | .false => RxS.mk 10 1 cs)
  | .false => RxS.mk (Nat.sub 9 (Nat.div (Nat.sub k 3) 4)) (Nat.mod (Nat.sub k 3) 4) (Rx.csAt cs e (Rx.capped (Nat.div (Nat.sub k 3) 4)))
def Rx.path (c0 : Nat) (cs e : Bits8) : Nat → RxS
  | .zero => RxS.mk 0 c0 cs
  | .succ j => Rx.frameSt cs e (Nat.succ j)

def Rx.PStep (c0 : Nat) (cs e : Bits8) (k : Nat) : Prop :=
  (r : Bool) → (Nat.lt k 38 = .true → r = Uart.frameBit e (Nat.div k 4)) → Rx.next (Rx.path c0 cs e k) r = Rx.path c0 cs e (Nat.succ k)
def Rx.PQuiet (c0 : Nat) (cs e : Bits8) (k : Nat) : Prop := (r : Bool) → (Rx.out (Rx.path c0 cs e k) r).1 = .false
