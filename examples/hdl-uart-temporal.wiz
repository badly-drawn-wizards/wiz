def Tx.case : (s : TxS) → (x : Bool × Bits8) → Tx.inv s → Tx.Case s x
  | .mk l c d, x, h => Bool.indP (fun (st : Bool) => Tx.Case (TxS.mk l c d) (st, x.2))
      (Nat.all_spec Tx.CaseL 11 Tx.cases l h.1 c h.2 d x.2).1 (Nat.all_spec Tx.CaseL 11 Tx.cases l h.1 c h.2 d x.2).2 x.1
def Tx.ok (s : TxS) (x : Bool × Bits8) (h : Tx.inv s) : txM (Tx.emb s) (Tx.embIn x) = (Tx.emb (Tx.spec s x).1, Tx.embOut (Tx.spec s x).2) :=
  @Eq.trans TxP (txM (Tx.emb s) (Tx.embIn x))
    (Tx.pk (Tx.G (BitVec.beq (Tx.embT s).2.1 (BitVec.ofNat 4 0)) (BitVec.beq (Tx.embT s).2.2.1 (BitVec.ofNat 7 3)) (Tx.embT s) (Bool.toBits x.1) (byte x.2)), Tx.wire (Tx.embT s).1)
    (Tx.emb (Tx.spec s x).1, Tx.embOut (Tx.spec s x).2)
    (Tx.stepG (Tx.embT s) x.1 (byte x.2))
    (Eq.congrArg (fun (q : TxT) => (Tx.pk q, Tx.wire (Tx.embT s).1)) (Tx.case s x h).1)
def Tx.pres (s : TxS) (x : Bool × Bits8) (h : Tx.inv s) : Tx.inv (Tx.spec s x).1 := (Tx.case s x h).2
def Tx.inv0 : Tx.inv Tx.s0 := And.intro rfl rfl

-- So, for every input trace: the circuit's state and line are the specification's.
def Tx.run (xs : Trace (Bool × Bits8)) : Trace TxS := Mealy.stateAt Tx.spec Tx.s0 xs
def Tx.refines (xs : Trace (Bool × Bits8)) (t : Nat) :
    Mealy.stateAt txM (txC 4).init (Trace.map Tx.embIn xs) t = Tx.emb (Tx.run xs t) :=
  Mealy.simulatesInv txM Tx.spec Tx.emb Tx.embIn Tx.embOut Tx.inv Tx.pres Tx.ok Tx.s0 Tx.inv0 xs t
def Tx.refinesOut (xs : Trace (Bool × Bits8)) (t : Nat) :
    Mealy.outAt txM (txC 4).init (Trace.map Tx.embIn xs) t = Tx.embOut (Mealy.outAt Tx.spec Tx.s0 xs t) :=
  Mealy.simulatesInvOut txM Tx.spec Tx.emb Tx.embIn Tx.embOut Tx.inv Tx.pres Tx.ok Tx.s0 Tx.inv0 xs t

------------------------------------------------------------------------------------
-- 4. The transmitter's properties
--
-- Over the observations `(state, input)` of the specification's run (`Mealy.obs`); the
-- circuit's line at cycle `u` is `Tx.embOut` of the specification's (`Tx.refinesOut`).

-- bit `i` of a byte, least significant first; the bit the line carries in bit period
-- `k` of a frame (0: start, 1 … 8: data, 9: stop)
def Bits8.bit : Bits8 → Nat → Bool
  | d, .zero => d.b0
  | d, .succ i => Bits8.bit (Bits8.shiftIn d .false) i
def Uart.frameBit (d : Bits8) (k : Nat) : Bool := match k with
  | .zero => .false
  | .succ i => (match Nat.lt i 8 with
    | .true => Bits8.bit d i
    | .false => .true)

def Tx.obs (xs : Trace (Bool × Bits8)) : Trace (TxS × (Bool × Bits8)) := Mealy.obs Tx.spec Tx.s0 xs
-- the circuit's line, as a Boolean
def Tx.lineAt (xs : Trace (Bool × Bits8)) (u : Nat) : HwTy.El Line.code :=
  Mealy.outAt txM (txC 4).init (Trace.map Tx.embIn xs) u

-- atoms
def Tx.idleA : TL (TxS × (Bool × Bits8)) := TL.now (fun (o : TxS × (Bool × Bits8)) => o.1.l = 0)
def Tx.goA (e : Bits8) : TL (TxS × (Bool × Bits8)) := TL.now (fun (o : TxS × (Bool × Bits8)) => o.1.l = 0 ∧ o.2 = (.true, e))

-- The line is whatever the specification's state says: high when idle (`lineOf d 0`
-- is the bit shifted out last, a one shifted in).
def Tx.lineAt_spec (xs : Trace (Bool × Bits8)) (u : Nat) :
    Tx.lineAt xs u = Tx.embOut (Tx.lineOf (Tx.run xs u).d (Tx.run xs u).l) :=
  Tx.refinesOut xs u
def Tx.lineOf_idle (d : Bits8) : Tx.lineOf d 0 = .true := rfl

-- (T1) □ (idle → line high), for every input trace.
def Tx.idleHigh (xs : Trace (Bool × Bits8)) :
    TL.always (TL.imp Tx.idleA (fun (σ : Trace (TxS × (Bool × Bits8))) (u : Nat) => Tx.lineAt xs u = Tx.embOut .true)) (Tx.obs xs) 0 :=
  fun (k : Nat) (h : (Tx.run xs (Nat.add k 0)).l = 0) =>
    Eq.trans (Tx.lineAt_spec xs (Nat.add k 0))
      (Eq.congrArg (fun (l : Nat) => Tx.embOut (Tx.lineOf (Tx.run xs (Nat.add k 0)).d l)) h)

-- The step that takes a byte: from an idle state with start, the frame begins.
def Tx.go_step : (s : TxS) → (e : Bits8) → s.l = 0 → (Tx.spec s (.true, e)).1 = TxS.mk 10 0 e
  | .mk l c d, e, h => Eq.substProp (fun (k : Nat) => (Tx.spec (TxS.mk k c d) (.true, e)).1 = TxS.mk 10 0 e) (Eq.symm h) (refl (TxS.mk 10 0 e))

-- The frame, cycle by cycle: `m` cycles after the first cycle of the frame, the state is
-- `Tx.frameSt d m` whatever the inputs (40 steps, one evaluation each).
def Tx.frameSt (d : Bits8) (m : Nat) : TxS := TxS.mk (Nat.sub 10 (Nat.div m 4)) (Nat.mod m 4) d
def Tx.FStep (d : Bits8) (k : Nat) : Prop := (x : Bool × Bits8) → (Tx.spec (Tx.frameSt d k) x).1 = Tx.frameSt d (Nat.succ k)
-- BEGIN GENERATED txframe (scripts/gen-uart-temporal.py)
def Tx.fsteps (d : Bits8) : Nat.All (Tx.FStep d) 40 :=
