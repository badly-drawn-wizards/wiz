def Rx.embT (s : RxS) : RxT := (BitVec.ofNat 4 s.ph, (BitVec.ofNat 7 s.c, byte s.cs))
def Rx.emb (s : RxS) : HwTy.El (rxC 4).st := Rx.pk (Rx.embT s)
def Rx.embIn (r : Bool) : HwTy.El Line.code := Tx.wire (Bool.toBits r)
def Rx.embOT (o : Bool × Bits8) : RxO := (Bool.toBits o.1, byte o.2)
def Rx.embOut (o : Bool × Bits8) : HwTy.El Byte.code := Rx.pkO (Rx.embOT o)
def Rx.init_emb : (rxC 4).init = Rx.emb Rx.s0 := refl (rxC 4).init

def Rx.GOK (s : RxS) (r : Bool) : Prop := Rx.Gd (Rx.embT s) (Bool.toBits r) = (Rx.embT (Rx.next s r), Rx.embOT (Rx.out s r))
def Rx.Case (s : RxS) (r : Bool) : Prop := Rx.GOK s r ∧ Rx.inv (Rx.next s r)
def Rx.CaseLC (ph c : Nat) : Prop := (cs : Bits8) → Rx.Case (RxS.mk ph c cs) .true ∧ Rx.Case (RxS.mk ph c cs) .false
def Rx.CaseL (ph : Nat) : Prop := (c : Nat) → Nat.lt c (Rx.bound ph) = .true → Rx.CaseLC ph c
def RxTO : Type := RxT × RxO

