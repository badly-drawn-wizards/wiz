import Hdl.Core
-- Operator notation on HDL signals (docs/libraries.md, H14 S2): each design twice, with
-- the operators and with the `Hw` operations, and the two give the same Verilog; the
-- operators print back as written; `if` stays a `match` on a `Bool`.

def Bit : HwTy := HwTy.bits 1
def B4 : HwTy := HwTy.bits 4
def B8 : HwTy := HwTy.bits 8

-- arithmetic, bitwise operations, shifts and a multiplexer
def ops {r : HwTy → Type} [Hw r] (c : r Bit) (x y : r B8) : r B8 :=
  if c then (x + 1) &&& ~~~y else (x <<< 2 ||| y >>> 3) ^^^ (-x * 2)
def ops0 {r : HwTy → Type} [Hw r] (c : r Bit) (x y : r B8) : r B8 :=
  Hw.mux c (Hw.and (Hw.add x (Hw.lit 8 1)) (Hw.not y))
    (Hw.xor (Hw.or (Hw.shl x 2) (Hw.lshr y 3)) (Hw.mul (Hw.sub (Hw.lit 8 0) x) (Hw.lit 8 2)))

-- comparisons are one bit
def cmp {r : HwTy → Type} [Hw r] (x y : r B8) : r Bit :=
  (x === y ||| x =/= 7) &&& (x <ᵤ y ||| x ≤ᵤ 3) ^^^ (x >ᵤ y &&& y ≥ᵤ 200)
def cmp0 {r : HwTy → Type} [Hw r] (x y : r B8) : r Bit :=
  Hw.xor (Hw.and (Hw.or (Hw.eq x y) (Hw.neq x (Hw.lit 8 7))) (Hw.or (Hw.ult x y) (Hw.ule x (Hw.lit 8 3))))
    (Hw.and (Hw.ugt x y) (Hw.uge y (Hw.lit 8 200)))

-- a counter that wraps at a meta-level `n`, with a numeral as the branch (its width is
-- the other branch's) and a constant of the expected width (`Hw.ofNat`)
def count {r : HwTy → Type} [Hw r] (n : Nat) (c : r B4) : r B4 :=
  let t := c === Hw.ofNat (n - 1);
  if t then 0 else c + 1
def count0 {r : HwTy → Type} [Hw r] (n : Nat) (c : r B4) : r B4 :=
  let t := Hw.eq c (Hw.lit 4 (n - 1));
  Hw.mux t (Hw.lit 4 0) (Hw.add c (Hw.lit 4 1))

def opsC (f : {r : HwTy → Type} → [Hw r] → r Bit → r B8 → r B8 → r B8) : Circuit B8 B8 :=
  Circuit.mk B8 (BitVec.ofNat 8 5) (fun s x => Hw.pair (f (Hw.slice 0 1 x) s x) s)
def cmpC (f : {r : HwTy → Type} → [Hw r] → r B8 → r B8 → r Bit) : Circuit B8 Bit :=
  Circuit.mk B8 (BitVec.ofNat 8 0) (fun s x => Hw.pair x (f s x))
def countC (f : {r : HwTy → Type} → [Hw r] → Nat → r B4 → r B4) : Circuit Bit B4 :=
  Circuit.mk B4 (BitVec.ofNat 4 0) (fun s x => Hw.pair (f 10 s) s)

def v (name : String) {ω i o : HwTy} (c : Circuit i o) : String := Verilog.emit (Circuit.netlist name c)
def same {ω i o : HwTy} (a b : Circuit i o) : Bool := Hdl.strEq (v "m" a) (v "m" b)
def agree : Bool × Bool × Bool := (same (opsC ops) (opsC ops0), same (cmpC cmp) (cmpC cmp0), same (countC count) (countC count0))
#eval agree

-- simulation: the counter wraps at 10; the shifts
def ins : List (HwTy.El Bit) := Hdl.map (BitVec.ofNat 1) (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 (List.cons 0 List.nil))))))))))))
#eval Hdl.map (HwTy.pack B4) (Circuit.run (countC count) ins)
def shifts (a : Nat) (k : Nat) : Nat × Nat :=
  (HwTy.pack B8 (Hw.shl (r := HwTy.El) (HwTy.unpack B8 a) k), HwTy.pack B8 (Hw.lshr (r := HwTy.El) (HwTy.unpack B8 a) k))
def shifted : (Nat × Nat) × (Nat × Nat) × (Nat × Nat) := (shifts 201 3, shifts 201 0, shifts 201 8)
#eval shifted
#eval v "count" (countC count)

-- printed as written; `Hw.mux` prints as `if`
#check fun (c : Wire Bit) (x y : Wire B8) => if c then (x + 1) &&& ~~~y else x <<< 2 ||| y >>> 3
#check fun (x y : Wire B8) => x === y ||| x <ᵤ 3
#check fun (c : Wire Bit) (x : Wire B8) => Hw.mux c x 0

-- on `Bool` and `Nat`, `if` is the `match` it always was (a dependent one too) and the
-- bitwise classes have `Nat` instances
def pick (b : Bool) : Nat := if b then 1 else 2
def both (b : Bool) : (if b then 1 else 1) = 1 := if b then rfl else rfl
def nats : Nat × Nat × Nat := (pick .true, (12 &&& 10) ||| (1 <<< 4), 255 >>> 4 ^^^ 1)
#eval nats
