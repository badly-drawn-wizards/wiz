-- A benchmark for the HDL simulations (`wiz build examples/hdl-sim-bench.wiz -o b`,
-- then `b MODE CYCLES`): a design in the style of the iCEstick OLED demo (a sequencer
-- whose program is a table, a serialiser, a pixel generator reading a sine and a font
-- table, frame counters; bundles throughout, tables as multiplexer trees on the
-- address bits), simulated for CYCLES cycles by
--   value   the value simulation, `Design.runLeaves` (the step at `HwTy.El` every cycle)
--   net     the netlist semantics, `Netlist.simulate`
--   fast    the fast netlist simulation, `Design.simFast` (lib/Hdl/Sim.wiz)
--   check   all three on CYCLES cycles, which must agree
-- It prints the number of netlist nodes and a checksum of the outputs (the same for
-- every mode). Timed by /workspace/wiz-tools/bench/hdl-sim.
import Hdl.Core
import Hdl.Sim
import Text
import IO

def Bit : HwTy := HwTy.bits 1
def D3 : HwTy := HwTy.bits 3
def D4 : HwTy := HwTy.bits 4
def D6 : HwTy := HwTy.bits 6
def D7 : HwTy := HwTy.bits 7
def D8 : HwTy := HwTy.bits 8
def D9 : HwTy := HwTy.bits 9
def D10 : HwTy := HwTy.bits 10
def D16 : HwTy := HwTy.bits 16

def lo {r : HwTy → Type} [Hw r] : r Bit := Hw.lit 1 0
def hi {r : HwTy → Type} [Hw r] : r Bit := Hw.lit 1 1
def eqLit {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) (k : Nat) : r Bit := Hw.eq x (Hw.lit n k)
def inc {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) : r (HwTy.bits n) := Hw.add x (Hw.lit n 1)
def dec {r : HwTy → Type} [Hw r] {ω n : Nat} (x : r (HwTy.bits n)) : r (HwTy.bits n) := Hw.sub x (Hw.lit n 1)

-- tables: `2^k` entries (zeros past the list), a tree on the address bits
def Tbl.pseudo (m : Nat) : Nat → Nat → List Nat
  | _, .zero => .nil
  | seed, .succ k => .cons (Nat.mod (Nat.div (seed * 2654435761 + k * 40503) 64) m) (Tbl.pseudo m (seed + 7 * k + 1) k)
def romAt {r : HwTy → Type} [Hw r] (w : Nat) {ω n : Nat} (a : r (HwTy.bits n)) (es : List Nat) : Nat → Nat → r (HwTy.bits w)
  | .zero, base => Hw.lit w (Hdl.nthD 0 es base)
  | .succ k, base => Hw.mux (Hw.slice k 1 a) (romAt w a es k (base + Nat.pow 2 k)) (romAt w a es k base)

-- the program (64 entries of 9 bits: an opcode flag and a byte), the sine (32 × 8), the
-- font (128 × 8)
def progT : List Nat := Tbl.pseudo 512 1 64
def sineT : List Nat := Tbl.pseudo 256 2 32
def fontT : List Nat := Tbl.pseudo 256 3 128

structure Ser (r : HwTy → Type) where
  sclk : r Bit
  mosi : r Bit
  sh : r D7
  cnt : r D4
  deriving Bundle

def serStep {r : HwTy → Type} [Hw r] (s : Ser r) (load : r Bit) (d : r D8) : r Ser.code :=
  let ready := eqLit s.cnt 0;
  let busy := Hw.not ready;
  let go := Hw.and ready load;
  let fall := Hw.and busy s.sclk;
  Ser.pack (Ser.mk
    (Hw.mux go lo (Hw.mux busy (Hw.not s.sclk) s.sclk))
    (Hw.mux go (Hw.slice 7 1 d) (Hw.mux fall (Hw.slice 6 1 s.sh) s.mosi))
    (Hw.mux go (Hw.slice 0 7 d) (Hw.mux fall (Hw.cat (Hw.slice 0 6 s.sh) lo) s.sh))
    (Hw.mux go (Hw.lit 4 15) (Hw.mux busy (dec s.cnt) s.cnt)))

structure Pix (r : HwTy → Type) where
  idx : r D10
  k : r D3
  nb : r D8
  full : r Bit
  deriving Bundle

structure Top (r : HwTy → Type) where
  pc : r D6
  wait : r D16
  dc : r Bit
  ser : Ser r
  pix : Pix r
  timer : r D9
  t : r D10
  deriving Bundle

structure TopIn (r : HwTy → Type) where
  key : r Bit
  deriving Bundle

structure TopOut (r : HwTy → Type) where
  sclk : r Bit
  mosi : r Bit
  dc : r Bit
  leds : r (HwTy.bits 5)
  deriving Bundle

-- the pixel at (x, y) of frame t: a sine plasma XOR a character of the font
def pixel {r : HwTy → Type} [Hw r] (x : r D7) (y : r (HwTy.bits 5)) (t : r D10) : r Bit :=
  let s1 := romAt 8 (Hw.add (Hw.slice 2 5 x) (Hw.slice 3 5 t)) sineT 5 0;
  let s2 := romAt 8 (Hw.add y (Hw.slice 1 5 t)) sineT 5 0;
  let col := romAt 8 (Hw.cat (Hw.slice 3 4 x) (Hw.slice 2 3 y)) fontT 7 0;
  let ch := Hw.slice 0 1 (Hw.slice 7 1 (Hw.add s1 s2));
  Hw.xor ch (Hw.slice 0 1 col)

def topStep {r : HwTy → Type} [Hw r] (s : Top r) (x : TopIn r) : r (HwTy.prod Top.code TopOut.code) :=
  let e := romAt 9 s.pc progT 6 0;
  let isCmd := Hw.not (Hw.slice 8 1 e);
  let code := Hw.slice 0 4 e;
  let ready := eqLit s.ser.cnt 0;
  let isOp := fun (k : Nat) => Hw.and (Hw.slice 8 1 e) (eqLit code k);
  let opWait := isOp 4;
  let opPix := Hw.or (isOp 8) (isOp 6);
  let opAgain := isOp 9;
  let g := s.pix;
  let lastByte := eqLit g.idx 511;
  let loadData := Hw.and opPix (Hw.and g.full ready);
  let loadCmd := Hw.and isCmd ready;
  let waitDone := eqLit s.wait 0;
  let adv := Hw.and ready (Hw.or isCmd (Hw.or (Hw.and opWait waitDone) (Hw.and loadData lastByte)));
  let genOn := Hw.and opPix (Hw.not g.full);
  let bit := pixel (Hw.slice 0 7 g.idx) (Hw.cat (Hw.slice 7 2 g.idx) g.k) s.t;
  let tick := eqLit s.timer 511;
  Hw.pair
    (Top.pack (Top.mk
      (Hw.mux (Hw.and ready opAgain) (Hw.lit 6 20) (Hw.mux adv (inc s.pc) s.pc))
      (Hw.mux (Hw.and opWait waitDone) (Hw.cat (Hw.lit 8 0) (Hw.slice 0 8 e)) (Hw.mux waitDone s.wait (dec s.wait)))
      (Hw.mux loadCmd lo (Hw.mux loadData hi s.dc))
      (Ser.unpack (serStep s.ser (Hw.or loadCmd loadData) (Hw.mux isCmd (Hw.slice 0 8 e) g.nb)))
      (Pix.mk
        (Hw.mux loadData (Hw.mux lastByte (Hw.lit 10 0) (inc g.idx)) g.idx)
        (Hw.mux genOn (dec g.k) g.k)
        (Hw.mux genOn (Hw.cat (Hw.slice 0 7 g.nb) bit) g.nb)
        (Hw.mux (Hw.and genOn (eqLit g.k 0)) hi (Hw.mux loadData lo g.full)))
      (Hw.mux x.key (Hw.lit 9 0) (inc s.timer))
      (Hw.mux tick (Hw.add s.t (Hw.lit 10 3)) s.t)))
    (TopOut.pack (TopOut.mk s.ser.sclk s.ser.mosi s.dc (Hw.slice 5 5 s.t)))

def top : Circuit TopIn.code TopOut.code :=
  Circuit.bundled Top.bundle TopIn.bundle TopOut.bundle
    (Top.mk (BitVec.ofNat 6 0) (BitVec.ofNat 16 0) (BitVec.ofNat 1 0)
      (Ser.mk (BitVec.ofNat 1 1) (BitVec.ofNat 1 0) (BitVec.ofNat 7 0) (BitVec.ofNat 4 0))
      (Pix.mk (BitVec.ofNat 10 0) (BitVec.ofNat 3 7) (BitVec.ofNat 8 0) (BitVec.ofNat 1 0))
      (BitVec.ofNat 9 0) (BitVec.ofNat 10 0))
    topStep

def Rng.next (s : Nat) : Nat := Nat.mod (s * 1103515245 + 12345) 2147483648
-- the key: pressed in about one cycle of 4096
def keys : Nat → Nat → List (List Nat) → List (List Nat)
  | .zero, _, acc => acc
  | .succ k, s, acc => keys k (Rng.next s) (.cons (.cons (match Nat.beq (Nat.mod (Nat.div s 256) 4096) 0 with
    | .true => 1
    | .false => 0) .nil) acc)

def leavesEq : List (List Nat) → List (List Nat) → Bool
  | .nil, .nil => .true
  | .cons a as, .cons b bs => Bool.and (Hdl.natsEq a b) (leavesEq as bs)
  | _, _ => .false

def sumAll : List (List Nat) → Nat → Nat
  | .nil, acc => acc
  | .cons l ls, acc => sumAll ls (Nat.mod (Hdl.sum l + acc * 3) 1000000007)

def say (net : Netlist) (ys : List (List Nat)) : IO Unit :=
  IO.println (Hdl.show (Netlist.size net) <+> " nodes, " <+> Hdl.show (List.length ys) <+> " cycles, checksum " <+> Hdl.show (sumAll ys 0))

def main : IO Unit := do
  args ← IO.args;
  let mode := Hdl.nthD "check" args 0;
  let n := (match String.parseNat (Hdl.nthD "" args 1) with
    | .some k => k
    | .none => 20000);
  let d := Circuit.design "top" top;
  let net := Design.netlist d;
  let ins := keys n 1 .nil;
  match Hdl.strEq mode "value" with
  | .true => say net (Design.runLeaves d ins)
  | .false => match Hdl.strEq mode "net" with
    | .true => say net (Netlist.simulate net ins)
    | .false => match Hdl.strEq mode "fast" with
      | .true => say net (Design.simFast d ins)
      | .false => do
        let f := Design.simFast d ins;
        IO.println ("fast = value: " <+> (match leavesEq f (Design.runLeaves d ins) with
          | .true => "yes"
          | .false => "NO") <+> ", fast = net: " <+> (match leavesEq f (Netlist.simulate net ins) with
          | .true => "yes"
          | .false => "NO"));
        say net f
