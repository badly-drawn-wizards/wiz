-- Stage 5: erasure and the interpreter. `lake exe wiz check examples/run.wiz`

inductive Nat where
  | zero
  | succ (n : Nat)
def add : Nat → Nat → Nat
  | .zero, n => n
  | .succ m, n => .succ (add m n)
#eval add (.succ .zero) (.succ (.succ .zero))
def fib {i : Size} : Nat^i → Nat
  | .zero => .succ .zero
  | .succ .zero => .succ .zero
  | .succ (.succ n) => add (fib n) (fib (.succ n))
#eval fib (.succ (.succ (.succ (.succ (.succ .zero)))))
coinductive Stream (A : Type) where
  head : A
  tail : Stream A
def nats (n : Nat) : Stream Nat
  | .head => n
  | .tail => nats (.succ n)
#eval (nats .zero).tail.tail.head
def swap {A B : Type} (p : A × B) : B × A := (p.2, p.1)
#eval swap (Nat.zero, Nat.succ Nat.zero)

inductive Vec (A : Type) : Nat → Type where
  | nil : Vec A .zero
  | cons {0 n : Nat} (x : A) (xs : Vec A n) : Vec A (.succ n)
-- the length is erased: `cons` stores only x and xs
#erase Vec.cons
