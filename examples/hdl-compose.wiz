-- HDL stage S1 (`import Hdl.Core`): bundles, composition, reset and enable, names in the
-- netlist, emitters. Each circuit is simulated by values (`Circuit.run`) and by its
-- netlist (`Netlist.simulate`), which must agree. Checked by the `hdl` test group.
import Hdl.Core

def Bit : HwTy := HwTy.bits 1
def B4 : HwTy := HwTy.bits 4
def B8 : HwTy := HwTy.bits 8

------------------------------------------------------------------------------------
-- A bundle: an up/down counter's state, its input and its output, by name.

structure Cnt (r : HwTy → Type) where
  count : r B4
  up : r Bit
  deriving Bundle
structure CntIn (r : HwTy → Type) where
  go : r Bit
  deriving Bundle
structure CntOut (r : HwTy → Type) where
  leds : r B4
  top : r Bit
  deriving Bundle

-- counts 0 … 9 … 0 while `go` is high
def cntStep {r : HwTy → Type} [Hw r] (s : Cnt r) (x : CntIn r) : r (HwTy.prod Cnt.code CntOut.code) :=
  let inc := Hw.add s.count (Hw.lit 4 1);
  let dec := Hw.sub s.count (Hw.lit 4 1);
  let next := Hw.label "next" (Hw.mux x.go (Hw.mux s.up inc dec) s.count);
  let atTop := Hw.eq next (Hw.lit 4 9);
  let atBottom := Hw.eq next (Hw.lit 4 0);
  let up := Hw.mux atTop (Hw.lit 1 0) (Hw.mux atBottom (Hw.lit 1 1) s.up);
  Hw.pair (Cnt.pack (Cnt.mk next up)) (CntOut.pack (CntOut.mk s.count (Hw.eq s.count (Hw.lit 4 9))))

def counter : Circuit CntIn.code CntOut.code :=
  Circuit.bundled Cnt.bundle CntIn.bundle CntOut.bundle (Cnt.mk (BitVec.ofNat 4 0) (BitVec.ofNat 1 1)) cntStep

------------------------------------------------------------------------------------
-- Composition: a delay line and an accumulator, in sequence and side by side, a
-- feedback loop, names for the parts.

def delay2 : Circuit B8 B8 := Circuit.seq (Circuit.named "d1" (Circuit.delay B8 (BitVec.ofNat 8 7))) (Circuit.named "d2" (Circuit.delay B8 (BitVec.ofNat 8 9)))
def acc : Circuit B8 B8 := Circuit.mk B8 (BitVec.ofNat 8 0) (fun s x => Hw.pair (Hw.add s x) s)
def chain : Circuit B8 B8 := Circuit.seq (Circuit.named "acc" acc) delay2
def sideBy : Circuit (HwTy.prod B8 B8) (HwTy.prod B8 B8) := Circuit.par chain (Circuit.comb (fun x => Hw.xor x (Hw.lit 8 85)))
-- feedback: the output plus the input, fed back (a running sum through the loop register)
def fbBody : Circuit (HwTy.prod B8 B8) (HwTy.prod B8 B8) :=
  Circuit.mk (HwTy.bits 0) (BitVec.ofNat 0 0) (fun s p => Hw.pair s (Hw.pair (Hw.snd p) (Hw.add (Hw.fst p) (Hw.snd p))))
def fb : Circuit B8 B8 := Circuit.loop fbBody (BitVec.ofNat 8 1)

-- an instance with its own state inside a hand-written step: two counters, the second
-- counting only when the first is at its top
structure Two (r : HwTy → Type) where
  lo : Cnt r
  hi : Cnt r
  deriving Bundle
def twoStep {r : HwTy → Type} [Hw r] (s : Two r) (x : CntIn r) : r (HwTy.prod Two.code CntOut.code) :=
  let a := Circuit.inst counter (Cnt.pack s.lo) (CntIn.pack x);
  let ao := CntOut.unpack (Hw.snd a);
  let b := Circuit.inst counter (Cnt.pack s.hi) (CntIn.pack (CntIn.mk (Hw.and x.go ao.top)));
  Hw.pair (Two.pack (Two.mk (Cnt.unpack (Hw.fst a)) (Cnt.unpack (Hw.fst b)))) (Hw.snd b)
def cnt0 : Cnt HwTy.El := Cnt.mk (BitVec.ofNat 4 0) (BitVec.ofNat 1 1)
def two : Circuit CntIn.code CntOut.code :=
  Circuit.bundled Two.bundle CntIn.bundle CntOut.bundle (Two.mk cnt0 cnt0) twoStep

-- reset and enable around the counter
def counterRE : Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) (HwTy.prod (HwTy.named "en" HwTy.bit) CntIn.code)) CntOut.code :=
  Circuit.withReset (Circuit.withEnable counter)

------------------------------------------------------------------------------------
-- Traces: a linear congruential generator, so resets and enables come at arbitrary cycles.

def Rng.next (s : Nat) : Nat := Nat.mod (s * 1103515245 + 12345) 2147483648
def Rng.trace (m : Nat) : Nat → Nat → List Nat
  | .zero, _ => .nil
  | .succ k, s => .cons (Nat.mod (Nat.div s 65536) m) (Rng.trace m k (Rng.next s))

def agree {ω i o : HwTy} (c : Circuit i o) (xs : List Nat) : Bool × List Nat :=
  let ω ys := Circuit.runPacked c xs;
  (Bool.and (Hdl.natsEq ys (Circuit.simNet .true c xs)) (Hdl.natsEq ys (Circuit.simNet .false c xs)), List.cons (Netlist.size (Circuit.netlist "c" c)) ys)

def t1 : Bool × List Nat := agree counter (Rng.trace 2 30 1)
#eval t1
def t2 : Bool × List Nat := agree chain (Rng.trace 256 12 2)
#eval t2
def t3 : Bool × List Nat := agree sideBy (Rng.trace 65536 8 3)
#eval t3
def t4 : Bool × List Nat := agree fb (Rng.trace 256 8 4)
#eval t4
def t5 : Bool × List Nat := agree two (Rng.trace 2 40 5)
#eval t5
-- rst and en at random: (rst, en, go) packed in three bits, rst one cycle in four
def reTrace : List Nat := Hdl.map (fun (k : Nat) => match Nat.lt k 6 with
  | .true => Nat.mod k 4
  | .false => 4 + Nat.mod k 4) (Rng.trace 8 60 6)
def t6 : Bool × List Nat := agree counterRE reTrace
#eval t6

------------------------------------------------------------------------------------
-- The semantics of the combinators, as equations (the library's lemmas, instantiated).

def chain_run (xs : List (HwTy.El B8)) : Circuit.run chain xs = Circuit.run delay2 (Circuit.run (Circuit.named "acc" acc) xs) :=
  Circuit.run_seq (Circuit.named "acc" acc) delay2 xs
def delay_run (xs : List (HwTy.El B8)) : Circuit.run (Circuit.delay B8 (BitVec.ofNat 8 7)) xs = Hdl.shift (BitVec.ofNat 8 7 : HwTy.El B8) xs :=
  Circuit.run_delay (BitVec.ofNat 8 7) xs

------------------------------------------------------------------------------------
-- Names in the Verilog, a test bench, pin constraints, a waveform; designs in a list.

def vCounter : String := Verilog.emit (Circuit.netlist "counter" counterRE)
#eval vCounter
def vTwo : String := Verilog.emit (Circuit.netlist "two" two)
def vPipe : String := Verilog.emit (Circuit.netlist "pipe" sideBy)

def reInputs : List (HwTy.El (HwTy.prod (HwTy.named "rst" HwTy.bit) (HwTy.prod (HwTy.named "en" HwTy.bit) CntIn.code))) :=
  Hdl.map (HwTy.unpack (HwTy.prod (HwTy.named "rst" HwTy.bit) (HwTy.prod (HwTy.named "en" HwTy.bit) CntIn.code))) reTrace
def tbCounter : String := Testbench.verilog (Circuit.netlist "counter" counterRE) "counter.vec" (List.length reTrace)
def vecCounter : String := Hdl.concat (Circuit.vectors (Circuit.netlist "counter" counterRE) counterRE reInputs)

def pins : List Pin := .cons (Pin.one "rst" 1) (.cons (Pin.one "en" 2) (.cons (Pin.one "go" 3)
  (.cons (Pin.bus "leds" (.cons 99 (.cons 98 (.cons 97 (.cons 96 .nil))))) (.cons (Pin.one "top" 95) .nil))))
#eval Pcf.emit (Circuit.netlist "counter" counterRE) 21 pins
#eval Pcf.check (Circuit.netlist "counter" counterRE) (.cons (Pin.one "go" 3) (.cons (Pin.one "led" 4) (.cons (Pin.one "leds" 5) .nil)))

def vcdCounter : String := Vcd.ofRun "counter" counter (Hdl.map (HwTy.unpack CntIn.code) (Rng.trace 2 4 1))
#eval vcdCounter

def designs : List Design := .cons (Circuit.design "counter" counter) (.cons (Circuit.design "chain" chain) (.cons (Circuit.design "fb" fb) .nil))
def Design.sizes : List Design → List Nat
  | .nil => .nil
  | .cons d ds => .cons (Netlist.size (Design.netlist d)) (Design.sizes ds)
#eval Design.sizes designs
