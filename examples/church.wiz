-- Stage 3: `lake exe wiz check examples/church.wiz`

def id {A : Type} (x : A) : A := x
def comp {A B C : Type} (g : B → C) (f : A → B) (x : A) : C := g (f x)

-- Church numerals
def Nat : Type 1 := (A : Type) → (A → A) → A → A
def zero : Nat := fun A s z => z
def succ (n : Nat) : Nat := fun A s z => s (n A s z)
def add (m n : Nat) : Nat := fun A s z => m A s (n A s z)
def two : Nat := succ (succ zero)

#reduce add two two

-- Leibniz equality: `2 + 2 = 4` holds by computation. (The built-in observational
-- equality `a = b` arrives in stage 4c.)
def Leibniz {A : Type 1} (x y : A) : Type 2 := (P : A → Type 1) → P x → P y
def lrefl {A : Type 1} (x : A) : Leibniz x x := fun P px => px
def twoPlusTwo : Leibniz (add two two) (succ (succ two)) := lrefl _

-- Quantities: erased type, linear argument.
def lid {0 A : Type} (1 x : A) : A := x
#check lid

