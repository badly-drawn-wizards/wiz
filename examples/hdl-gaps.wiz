import Hdl.Core
-- HDL gaps found by the iCEstick projects (docs/libraries.md, H14 S4): shifts by a signal,
-- signed comparisons and arithmetic shift right, `&&`/`||` on one-bit signals,
-- `deriving BitPack` for enumerations and bundles, and registers with a reset and an
-- enable. Each new operation: the value simulation against `BitVec`'s own definitions,
-- the netlist simulations (hash-consed and naive) against the value simulation, and the
-- Verilog (the `hdl` group also runs it through Icarus Verilog when it is installed).

def Bit : HwTy := HwTy.bits 1
def B3 : HwTy := HwTy.bits 3
def B4 : HwTy := HwTy.bits 4
def B8 : HwTy := HwTy.bits 8

def Rng.next (s : Nat) : Nat := Nat.mod (s * 1103515245 + 12345) 2147483648
def Rng.trace (m : Nat) : Nat → Nat → List Nat
  | .zero, _ => .nil
  | .succ k, s => .cons (Nat.mod (Nat.div s 65536) m) (Rng.trace m k (Rng.next s))

def agree {ω i o : HwTy} (c : Circuit i o) (xs : List Nat) : Bool × List Nat :=
  let ω ys := Circuit.runPacked c xs;
  (Bool.and (Hdl.natsEq ys (Circuit.simNet .true c xs)) (Hdl.natsEq ys (Circuit.simNet .false c xs)), List.cons (Netlist.size (Circuit.netlist "c" c)) ys)
def v (name : String) {ω i o : HwTy} (c : Circuit i o) : String := Verilog.emit (Circuit.netlist name c)
def same {ω i o : HwTy} (a b : Circuit i o) : Bool := Hdl.strEq (v "m" a) (v "m" b)

------------------------------------------------------------------------------------
-- 1. Shifts by a signal, 2. signed comparisons and arithmetic shift right

-- an amount of 4 bits shifts an 8-bit value by 0 … 15 places (8 and more: all out)
def shifts {r : HwTy → Type} [Hw r] (x : r B8) (s : r B4) : r (HwTy.prod B8 (HwTy.prod B8 (HwTy.prod B8 B8))) :=
  Hw.pair (x <<< s) (Hw.pair (x >>> s) (Hw.pair (x >>>ₛ s) (x >>>ₛ 3)))
def cmps {r : HwTy → Type} [Hw r] (x y : r B8) : r B4 :=
  Hw.cat (Hw.cat (x <ₛ y) (x ≤ₛ y)) (Hw.cat (x >ₛ y) (x ≥ₛ y))
def cmps0 {r : HwTy → Type} [Hw r] (x y : r B8) : r B4 :=
  Hw.cat (Hw.cat (Hw.slt x y) (Hw.sle x y)) (Hw.cat (Hw.sgt x y) (Hw.sge x y))

def shiftC : Circuit (HwTy.prod B8 B4) (HwTy.prod B8 (HwTy.prod B8 (HwTy.prod B8 B8))) :=
  Circuit.comb (fun p => shifts (Hw.fst p) (Hw.snd p))
def cmpC (f : {r : HwTy → Type} → [Hw r] → r B8 → r B8 → r B4) : Circuit (HwTy.prod B8 B8) B4 :=
  Circuit.comb (fun p => f (Hw.fst p) (Hw.snd p))

-- the value simulation against lib/BitVec.wiz (`BitVec.shl`, `lshr`, `ashr`, `slt`,
-- `sle`), on every 8-bit value and every amount
def bv (k : Nat) : BitVec 8 := BitVec.ofNat 8 k
def bitOf (b : Bool) : Nat := match b with
  | .true => 1
  | .false => 0
def shiftSpec (x s : Nat) : Bool :=
  let ω y := HwTy.pack (HwTy.prod B8 (HwTy.prod B8 (HwTy.prod B8 B8))) (Comb.el (fun p => shifts (Hw.fst p) (Hw.snd p)) (bv x, BitVec.ofNat 4 s));
  Nat.beq y (HwTy.pack (HwTy.prod B8 (HwTy.prod B8 (HwTy.prod B8 B8)))
    (BitVec.shl (bv x) s, (BitVec.lshr (bv x) s, (BitVec.ashr (bv x) s, BitVec.ashr (bv x) 3))))
def cmpSpec (x y : Nat) : Bool :=
  let ω got := HwTy.pack B4 (Comb.el (fun p => cmps (Hw.fst p) (Hw.snd p)) (bv x, bv y));
  let ω lt := BitVec.slt (bv x) (bv y);
  let ω le := BitVec.sle (bv x) (bv y);
  Nat.beq got (8 * bitOf lt + 4 * bitOf le + 2 * bitOf (Bool.not le) + bitOf (Bool.not lt))
def allBelow : Nat → (Nat → Bool) → Bool
  | .zero, p => .true
  | .succ k, p => Bool.and (p k) (allBelow k p)
def specs : Bool × Bool :=
  (allBelow 256 (fun (x : Nat) => allBelow 16 (fun (s : Nat) => shiftSpec x s)),
   allBelow 256 (fun (x : Nat) => allBelow 256 (fun (y : Nat) => Bool.or (Nat.lt 0 (Nat.mod (x + y) 7)) (cmpSpec x y))))
#eval specs

-- the netlist simulations agree with the values (random inputs); the operators are the
-- `Hw` operations
def t1 : Bool × Nat := ((agree shiftC (Rng.trace 4096 200 1)).1, Netlist.size (Circuit.netlist "c" shiftC))
#eval t1
def t2 : Bool × Bool := ((agree (cmpC cmps) (Rng.trace 65536 200 2)).1, same (cmpC cmps) (cmpC cmps0))
#eval t2
#eval v "shifts" shiftC
#check fun (x : Wire B8) (s : Wire B3) => x <<< s ||| x >>> s ^^^ x >>>ₛ s ^^^ x >>>ₛ 2
#check fun (x y : Wire B8) => x <ₛ y ||| x ≥ₛ 2

------------------------------------------------------------------------------------
-- 3. `&&` and `||` on one-bit signals: the gates `&&&` and `|||`

def logic {r : HwTy → Type} [Hw r] (a b c : r Bit) (x : r B8) : r Bit :=
  a && b || c && x === 0 || x <ᵤ 4
def logic0 {r : HwTy → Type} [Hw r] (a b c : r Bit) (x : r B8) : r Bit :=
  Hw.or (Hw.and a b) (Hw.or (Hw.and c (Hw.eq x (Hw.lit 8 0))) (Hw.ult x (Hw.lit 8 4)))
def logicC (f : {r : HwTy → Type} → [Hw r] → r Bit → r Bit → r Bit → r B8 → r Bit) : Circuit (HwTy.prod B3 B8) Bit :=
  Circuit.comb (fun p => f (Hw.slice 2 1 (Hw.fst p)) (Hw.slice 1 1 (Hw.fst p)) (Hw.slice 0 1 (Hw.fst p)) (Hw.snd p))
def t3 : Bool × Bool := ((agree (logicC logic) (Rng.trace 2048 40 3)).1, same (logicC logic) (logicC logic0))
#eval t3
#check fun (a b : Wire Bit) => a && b || b
-- on `Bool`, `&&` and `||` are what they were
def bools (a b : Bool) : Bool := a && b || !a
def boolsAt : Bool × Bool := (bools .true .false, bools .false .false)
#eval boolsAt

------------------------------------------------------------------------------------
-- 4. `deriving BitPack`: an enumeration, and a bundle with an enumeration in it

inductive Phase where
  | idle
  | start
  | data
  | stop
  deriving BitPack

structure Tx (r : HwTy → Type) where
  ph : r Phase.code
  left : r B4
  line : r Bit
  deriving Bundle, BitPack

-- a bundle without `deriving Bundle`: `deriving BitPack` makes its bundle too
structure Pair (r : HwTy → Type) where
  hi : r B3
  lo : r Phase.code
  deriving BitPack

-- the encoding: two bits, constructor `i` is `i`; out of range would be `idle`
def phases : List Nat := Hdl.map (fun (p : Phase) => BitVec.toNat (Phase.pack p)) (.cons Phase.idle (.cons Phase.start (.cons Phase.data (.cons Phase.stop .nil))))
def widths : Nat × List Nat × Nat × Nat := (Phase.width, phases, Tx.width, Pair.width)
#eval widths
-- the round trips: for every phase (a lemma, by cases), and a bundle at values
def phase_law (p : Phase) : Phase.unpack (Phase.pack p) = p := Phase.unpack_pack p
def tx0 : Tx HwTy.El := Tx.mk (Phase.pack Phase.data) (BitVec.ofNat 4 9) (BitVec.ofNat 1 1)
def tx_law : Tx.unpack (Tx.pack tx0) = tx0 := Tx.unpack_pack tx0
-- `ph` in the high bits, then `left`, then `line`: 10 1001 1
#eval BitVec.toNat (BitPack.pack Tx.bitPack tx0)
def tx_bits : BitPack.unpack Tx.bitPack (BitPack.pack Tx.bitPack tx0) = tx0 := refl tx0
def pairRound (k : Nat) : Bool :=
  Nat.beq (BitVec.toNat (BitPack.pack Pair.bitPack (BitPack.unpack Pair.bitPack (BitVec.ofNat 5 k)))) k
#eval allBelow 32 pairRound

-- in a circuit: a phase register stepping idle → start → data → stop → idle, and a
-- bundle kept in one 7-bit register (packed on the way in, unpacked on the way out)
def nextPhase {r : HwTy → Type} [Hw r] (p : r Phase.code) : r Phase.code :=
  if p === Phase.lit Phase.stop then Phase.lit Phase.idle else p + 1
def phaseC : Circuit Bit Phase.code :=
  Circuit.mk Phase.code (Phase.pack Phase.idle) (fun s x => Hw.pair (if x then nextPhase s else s) s)
def txReg : Circuit Tx.code Tx.code :=
  Circuit.mk (HwTy.bits Tx.width) (Tx.toBits tx0) (fun s x => Hw.pair (Tx.toBits (Tx.unpack x)) (Tx.pack (Tx.ofBits s)))
def t4 : Bool × List Nat := agree phaseC (Rng.trace 2 20 4)
#eval t4
def t5 : Bool × List Nat := agree txReg (Rng.trace 128 12 5)
#eval t5
#eval v "phase" phaseC

------------------------------------------------------------------------------------
-- 5. Registers with a reset and an enable

def regRE : Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) (HwTy.prod (HwTy.named "en" HwTy.bit) B8)) B8 :=
  Circuit.registerRE B8 (BitVec.ofNat 8 42)
def regR : Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) B8) B8 := Circuit.registerR B8 (BitVec.ofNat 8 42)
def regE : Circuit (HwTy.prod (HwTy.named "en" HwTy.bit) B8) B8 := Circuit.registerE B8 (BitVec.ofNat 8 42)
-- a counter with its own reset and enable, inside the step (`Hw.regNext`), and the same
-- counter through `Circuit.withResetEnable`: one Verilog
def cnt : Circuit B8 B8 := Circuit.mk B8 (BitVec.ofNat 8 0) (fun s x => Hw.pair (s + x) s)
def cntRE : Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) (HwTy.prod (HwTy.named "en" HwTy.bit) B8)) B8 :=
  Circuit.withResetEnable cnt
def cntRE' : Circuit (HwTy.prod (HwTy.named "rst" HwTy.bit) (HwTy.prod (HwTy.named "en" HwTy.bit) B8)) B8 :=
  Circuit.mk B8 (BitVec.ofNat 8 0) (fun s x =>
    Hw.pair (Hw.regNext (Hw.untag (Hw.fst x)) (Hw.untag (Hw.fst (Hw.snd x))) (BitVec.ofNat 8 0) s (s + Hw.snd (Hw.snd x))) s)
-- reset in about one cycle in eight, enable in three of four
def reTrace : List Nat := Hdl.map (fun (k : Nat) => match Nat.lt k 2 with
  | .true => k * 512 + Nat.mod (k * 37) 256
  | .false => (match Nat.lt k 8 with
    | .true => 256 + k * 29
    | .false => Nat.mod k 256)) (Rng.trace 32 40 6)
def t6 : (Bool × List Nat) × (Bool × List Nat) × Bool × Bool :=
  (agree regRE reTrace, agree cntRE reTrace, same cntRE cntRE', (agree regR (Rng.trace 512 30 7)).1)
#eval t6
#eval (agree regE (Rng.trace 512 30 8)).1
#eval v "reg" regRE
def reg_step (s x : HwTy.El B8) : Circuit.stepEl regRE s (BitVec.ofNat 1 0, (BitVec.ofNat 1 1, x)) = (x, s) := refl (x, s)

-- test benches for Icarus Verilog (the `hdl` group): the shifter and the comparisons
-- against their value simulations
def shiftIns : List (HwTy.El (HwTy.prod B8 B4)) := Hdl.map (HwTy.unpack (HwTy.prod B8 B4)) (Rng.trace 4096 200 11)
def cmpIns : List (HwTy.El (HwTy.prod B8 B8)) := Hdl.map (HwTy.unpack (HwTy.prod B8 B8)) (Rng.trace 65536 200 12)
def tbShift : String := Testbench.verilog (Circuit.netlist "shifts" shiftC) "shifts.vec" 200
def vecShift : String := Hdl.concat (Circuit.vectors (Circuit.netlist "shifts" shiftC) shiftC shiftIns)
def vCmp : String := v "cmps" (cmpC cmps)
def tbCmp : String := Testbench.verilog (Circuit.netlist "cmps" (cmpC cmps)) "cmps.vec" 200
def vecCmp : String := Hdl.concat (Circuit.vectors (Circuit.netlist "cmps" (cmpC cmps)) (cmpC cmps) cmpIns)
def vShift : String := v "shifts" shiftC
