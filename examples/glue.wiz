import IO
import_c "string.h"
glue sumTo (n : Nat) : Nat := "uint64_t s = 0; for (uint64_t i = 0; i < n; i++) s += i; return s;"
glue shout (s : String) : Nat := "return strlen(s) * 2;"
glue avg (a : Float64) (b : Float64) : Float64 := "double m = (a + b) / 2; return m;"
def main : IO Unit := do
  IO.println (Nat.toString (sumTo 100));
  IO.println (Nat.toString (shout "hello"));
  IO.println (Float64.toString (avg (Float64.ofNat 1) (Float64.ofNat 2)))
