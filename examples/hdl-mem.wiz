-- Memories (lib/Hdl/Core.wiz, `HwTy.mem`), checked by the `hdl` test group: a RAM with a
-- registered read (what an iCE40 block RAM is) and a ROM. The value simulation, the
-- netlist simulation and (in the test) Icarus Verilog agree; yosys maps both to
-- SB_RAM40_4K.
import Hdl.Core

def Bit : HwTy := HwTy.bits 1
def B4 : HwTy := HwTy.bits 4
def B8 : HwTy := HwTy.bits 8
def Ram : HwTy := HwTy.mem 4 8

structure Port (r : HwTy → Type) where
  we : r Bit
  waddr : r B4
  wdata : r B8
  raddr : r B4
  deriving Bundle

structure RamS (r : HwTy → Type) where
  cells : r Ram
  q : r B8
  deriving Bundle

-- one write port, one read port whose data is registered (a read sees the memory before
-- this cycle's write: block RAM's read-before-write)
def ramStep {r : HwTy → Type} [Hw r] (s : RamS r) (p : Port r) : r (HwTy.prod RamS.code B8) :=
  Hw.pair (RamS.pack (RamS.mk (Hw.memWrite s.cells p.we p.waddr p.wdata) (Hw.memRead s.cells p.raddr))) s.q
def zeros : HwTy.El Ram := fun (a : BitVec 4) => BitVec.ofNat 8 0
def ramC : Circuit Port.code B8 :=
  Circuit.mk RamS.code (Bundle.toEl RamS.bundle (RamS.mk zeros (BitVec.ofNat 8 0)))
    (fun s x => ramStep (RamS.unpack s) (Port.unpack x))

-- A ROM: a constant memory, read through a register (squares mod 256).
def squares : HwTy.El (HwTy.mem 4 8) := fun (a : BitVec 4) => BitVec.ofNat 8 (Nat.mul a.toNat a.toNat)
def romC : Circuit B4 B8 := Circuit.mk B8 (BitVec.ofNat 8 0)
  (fun s a => Hw.pair (Hw.memRead (Hw.const (HwTy.mem 4 8) squares) a) s)

-- What the RAM does, as lemmas at values: a read after a write to another address sees
-- the old word, to the same address the new one.
def ram_other (m : HwTy.El Ram) (we : BitVec 1) (d : BitVec 8) :
    HwTy.El.memRead (HwTy.El.memWrite m we (BitVec.ofNat 4 3) d) (BitVec.ofNat 4 5) = HwTy.El.memRead m (BitVec.ofNat 4 5) :=
  HwTy.El.memRead_write_miss m we (BitVec.ofNat 4 3) d (BitVec.ofNat 4 5) rfl
def ram_same (m : HwTy.El Ram) (a : BitVec 4) (d : BitVec 8) (h : BitVec.beq a a = .true) :
    HwTy.El.memRead (HwTy.El.memWrite m (BitVec.ofNat 1 1) a d) a = d :=
  HwTy.El.memRead_write_hit m a d a h

-- a write to 7, 9, 7 again, then reads of 7, 9, 3
def port (we wa wd ra : Nat) : HwTy.El Port.code :=
  Bundle.toEl Port.bundle (Port.mk (BitVec.ofNat 1 we) (BitVec.ofNat 4 wa) (BitVec.ofNat 8 wd) (BitVec.ofNat 4 ra))
def ins : List (HwTy.El Port.code) :=
  .cons (port 1 7 42 7) (.cons (port 1 9 99 7) (.cons (port 1 7 13 9) (.cons (port 0 7 0 7) (.cons (port 0 0 0 9) (.cons (port 0 0 0 3) (.cons (port 0 0 0 0) .nil))))))
def ramOut : List Nat := Hdl.map (HwTy.pack B8) (Circuit.run ramC ins)
def ramAgree : Bool := Hdl.natsEq (Hdl.map (HwTy.pack B8) (Circuit.run ramC ins)) (Circuit.simNet .true ramC (Hdl.map (HwTy.pack Port.code) ins))
def romIns : List Nat := .cons 3 (.cons 15 (.cons 0 (.cons 7 (.cons 7 .nil))))
def romOut : List Nat := Circuit.runPacked romC romIns
def romAgree : Bool := Hdl.natsEq (Circuit.runPacked romC romIns) (Circuit.simNet .true romC romIns)
def vRam : String := Verilog.emit (Circuit.netlist "ram" ramC)
def vRom : String := Verilog.emit (Circuit.netlist "rom" romC)
def tbRam : String := Testbench.verilog (Circuit.netlist "ram" ramC) "ram.vec" 7
def vecRam : String := Hdl.concat (Circuit.vectors (Circuit.netlist "ram" ramC) ramC ins)
def ramR : List Nat × Bool := (ramOut, ramAgree)
def romR : List Nat × Bool := (romOut, romAgree)
-- under a clock enable a write happens only when enabled; a reset leaves the contents
-- (the read register is reset): value and netlist simulations agree
def ramE : Circuit (HwTy.prod (HwTy.named "rst" Bit) (HwTy.prod (HwTy.named "en" Bit) Port.code)) B8 :=
  Circuit.withReset (Circuit.withEnable ramC)
def ctl (rst en : Nat) (p : HwTy.El Port.code) : HwTy.El (HwTy.prod (HwTy.named "rst" Bit) (HwTy.prod (HwTy.named "en" Bit) Port.code)) :=
  (BitVec.ofNat 1 rst, (BitVec.ofNat 1 en, p))
def insE : List (HwTy.El (HwTy.prod (HwTy.named "rst" Bit) (HwTy.prod (HwTy.named "en" Bit) Port.code))) :=
  .cons (ctl 0 1 (port 1 7 42 7)) (.cons (ctl 0 0 (port 1 7 55 7)) (.cons (ctl 1 1 (port 0 0 0 7)) (.cons (ctl 0 1 (port 0 0 0 7)) (.cons (ctl 0 1 (port 0 0 0 0)) .nil))))
def ramEOut : List Nat := Hdl.map (HwTy.pack B8) (Circuit.run ramE insE)
def ramEAgree : Bool := Hdl.natsEq ramEOut (Circuit.simNet .true ramE (Hdl.map (HwTy.pack (HwTy.prod (HwTy.named "rst" Bit) (HwTy.prod (HwTy.named "en" Bit) Port.code))) insE))
def ramER : List Nat × Bool := (ramEOut, ramEAgree)

-- what a netlist cannot express is reported (and printed as `// error:` in the Verilog)
def badC : Circuit Bit B8 := Circuit.mk Bit (BitVec.ofNat 1 0) (fun s c =>
  Hw.pair c (Hw.memRead (Hw.mux c (Hw.const (HwTy.mem 4 8) squares) (Hw.const (HwTy.mem 4 8) zeros)) (Hw.lit 4 2)))
def badErrors : List String := (Circuit.netlist "bad" badC).errors
#eval ramR
#eval romR
#eval ramER
#eval badErrors
#eval vRam
