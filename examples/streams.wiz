-- Stage 4e: coinductive types and copatterns. `lake exe wiz check examples/streams.wiz`

inductive Nat where
  | zero
  | succ (n : Nat)

coinductive Stream (A : Type) where
  head : A
  tail : Stream A

def nats (n : Nat) : Stream Nat
  | .head => n
  | .tail => nats (.succ n)

#reduce (nats .zero).tail.tail.head
#reduce Stream.head (Stream.tail (nats .zero))

def repeat {A : Type} (a : A) : Stream A
  | .head => a
  | .tail => repeat a
#reduce (repeat Nat.zero).tail.head

-- No corecursive observation: not recursive at all. `register a s` is one `cocon` cell
-- in front of `s` (a delay by one step, as in hardware).
def register {A : Type} (init : A) (s : Stream A) : Stream A
  | .head => init
  | .tail => s
#reduce (register Nat.zero (nats (.succ .zero))).tail.head

-- The coconstructor: `Stream.mk h t` (or `.mk h t`) is the same cell.
def zeroThenNats : Stream Nat := .mk .zero (nats .zero)

-- A Mealy machine: the state is the explicit arguments (`coit`).
def mealy {S I O : Type} (f : S → I → S × O) (st : S) (i : Stream I) : Stream O
  | .head => (f st i.head).2
  | .tail => mealy f (f st i.head).1 i.tail
#reduce (mealy (fun (n : Nat) (x : Nat) => (.succ n, n)) .zero (repeat Nat.zero)).tail.tail.head
