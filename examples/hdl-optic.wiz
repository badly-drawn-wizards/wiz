-- Lenses for HDL bundles (lib/Hdl/Optic.wiz, lib/OpticDerive.wiz), checked by the `hdl`
-- test group. A transmitter's state is a bundle; its countdown is a sub-step zoomed into
-- one field, and the frame rule says the other field is unchanged, for every state.
import Hdl.Optic

def Bit : HwTy := HwTy.bits 1
def B4 : HwTy := HwTy.bits 4

structure Tx (r : HwTy → Type) where
  line : r Bit
  left : r B4
  deriving Bundle, Lens

-- the derived pieces: one lens per field at every representation, laws, independence
def Tx.law : Bundle.Lawful Tx.bundle := (fun v => rfl, fun s => rfl)
def Tx.leftL_ok {r : HwTy → Type} : Lens.Lawful (@Tx.leftL r) := Tx.leftL_lawful

-- the countdown, as a step on the field alone; the transmitter's step zooms into it
def countdown {r : HwTy → Type} [Hw r] (x : r B4) (go : r Bit) : r B4 × r Bit :=
  (Hw.mux go (Hw.lit 4 9) (Hw.sub x (Hw.lit 4 1)), Hw.eq x (Hw.lit 4 0))
def txStep {r : HwTy → Type} [Hw r] (s : Tx r) (go : r Bit) : r (HwTy.prod Tx.code Bit) :=
  let n := Hdl.zoom Tx.leftL countdown s go;
  Hw.pair (Tx.pack n.1) n.2
def txC : Circuit Bit Bit := Circuit.mk Tx.code (Bundle.toEl Tx.bundle (Tx.mk (BitVec.ofNat 1 1) (BitVec.ofNat 4 0)))
  (fun s go => txStep (Tx.unpack s) go)

-- the frame rule: the step leaves the line alone, whatever the state and the input
def line_kept (s : Tx HwTy.El) (go : BitVec 1) : (Hdl.zoom Tx.leftL countdown s go).1.line = s.line :=
  Hdl.zoom_frame Tx.leftL Tx.lineL (Hdl.indep_symm Tx.lineL Tx.leftL Tx.line_left_indep) countdown s go

-- the same lens drives synthesis: the netlist and the value simulation agree
def go : Trace (BitVec 1) := Trace.once (BitVec.ofNat 1 1) (BitVec.ofNat 1 0)
def out : List Nat × Bool := (Hdl.map BitVec.toNat (Trace.take 12 (Circuit.trace txC go)),
  Hdl.natsEq (Circuit.runPacked txC (Hdl.map BitVec.toNat (Trace.take 12 go))) (Circuit.simNet .true txC (Hdl.map BitVec.toNat (Trace.take 12 go))))
#eval out
