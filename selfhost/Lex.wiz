import IO
import Std
-- The lexer, in Wiz: the first piece of the self-hosted frontend (stage 12b).
-- It follows `Wiz/Parser/Token.lean`: tokens are read on demand at an offset of the
-- input (an array of code points), so the parser can look ahead from anywhere.
-- Whitespace and nested comments, identifiers (with dotted components), numbers,
-- string literals with escapes, and the longest symbol from a token table (a symbol at
-- least as long as an identifier wins). The scanning loops are partial definitions:
-- they terminate because the offset grows, which Wiz can't see.

def between (c lo hi : Nat) : Bool := Bool.and (Nat.le lo c) (Nat.le c hi)

-- character classes, on code points
def isAlpha (c : Nat) : Bool := Bool.or (between c 65 90) (between c 97 122)
def isDigit (c : Nat) : Bool := between c 48 57
-- ASCII letters, `_`, and Greek letters except λ (955), Π (928) and Σ (931)
def isIdStart (c : Nat) : Bool :=
  Bool.or (Bool.or (isAlpha c) (Nat.beq c 95))
    (Bool.or (Bool.and (between c 945 969) (Bool.not (Nat.beq c 955)))
             (Bool.and (between c 913 937) (Bool.and (Bool.not (Nat.beq c 928)) (Bool.not (Nat.beq c 931)))))
def isIdRest (c : Nat) : Bool :=
  Bool.or (Bool.or (isIdStart c) (isDigit c))
    (Bool.or (Bool.or (Nat.beq c 39) (Nat.beq c 33)) (between c 8320 8329))
def isSpace (c : Nat) : Bool := Bool.or (Bool.or (Nat.beq c 32) (Nat.beq c 9)) (Bool.or (Nat.beq c 13) (Nat.beq c 10))

-- the input: code points; `0` past the end
def at (input : Array Nat) (i : Nat) : Nat := Array.getD input i 0
def codesOf : List Char → Array Nat → Array Nat
  | .nil, a => a
  | .cons c cs, a => codesOf cs (Array.push a (Char.code c))
def String.codes (s : String) : Array Nat := match s with
  | .mk cs => codesOf cs Array.empty
-- the characters of `n` code points from `i`
def slice : Nat → Array Nat → Nat → List Char
  | .zero, _, _ => .nil
  | .succ n, input, i => .cons (Char.mk (at input i)) (slice n input (i + 1))

-- after the end of the line
partial def lineEnd (input : Array Nat) (j : Nat) : Nat :=
  match Nat.beq (at input j) 0 with
  | .true => j
  | .false => match Nat.beq (at input j) 10 with
    | .true => j + 1
    | .false => lineEnd input (j + 1)
-- after the end of a block comment, `d` levels deep (comments nest)
partial def blockEnd (input : Array Nat) (j d : Nat) : Nat :=
    let c := at input j;
    let c2 := at input (j + 1);
    match Nat.beq c 0 with
    | .true => j
    | .false => match Bool.and (Nat.beq c 45) (Nat.beq c2 47) with
      | .true => match Nat.beq d 1 with
        | .true => j + 2
        | .false => blockEnd input (j + 2) (d - 1)
      | .false => match Bool.and (Nat.beq c 47) (Nat.beq c2 45) with
        | .true => blockEnd input (j + 2) (d + 1)
        | .false => blockEnd input (j + 1) d
-- the offset of the next significant character
partial def skipWs (input : Array Nat) (i : Nat) : Nat :=
    let c := at input i;
    let c2 := at input (i + 1);
    match isSpace c with
    | .true => skipWs input (i + 1)
    | .false => match Bool.and (Nat.beq c 45) (Nat.beq c2 45) with
      | .true => skipWs input (lineEnd input (i + 2))
      | .false => match Bool.and (Nat.beq c 47) (Nat.beq c2 45) with
        | .true => skipWs input (blockEnd input (i + 2) 1)
        | .false => i

-- the end of an identifier (a `.` continues it if an identifier can start after it)
partial def identEnd (input : Array Nat) (j : Nat) : Nat :=
  let c := at input j;
  match isIdRest c with
  | .true => identEnd input (j + 1)
  | .false => match Bool.and (Nat.beq c 46) (isIdStart (at input (j + 1))) with
    | .true => identEnd input (j + 1)
    | .false => j
partial def digitsEnd (input : Array Nat) (j : Nat) : Nat :=
  match isDigit (at input j) with
  | .true => digitsEnd input (j + 1)
  | .false => j

def reverse : List Char → List Char → List Char
  | .nil, acc => acc
  | .cons c cs, acc => reverse cs (.cons c acc)

-- a string literal's contents after the opening quote: decoded, and the offset after it;
-- or what is wrong, and where (a bad escape's backslash; an unterminated literal: `0`, the
-- caller reports the literal's start). The escapes and messages are `readEscape`'s in
-- `Wiz/Parser/Token.lean`.
inductive StrLit where
  | ok (s : List Char) (stop : Nat)
  | err (msg : String) (pos : Nat)
def hexVal (c : Nat) : Option Nat := match between c 48 57 with
  | .true => .some (Nat.sub c 48)
  | .false => match between c 97 102 with
    | .true => .some (Nat.sub c 87)
    | .false => match between c 65 70 with
      | .true => .some (Nat.sub c 55)
      | .false => .none
def uBad : String := "the escape \\u is written \\u{H}, with one to six hexadecimal digits (as in \\u{3bb})"
-- the digits of `\u{H}` from offset `k`: `count` read so far, worth `n`; the code point and
-- the offset after `}`, or a message at `j`, the backslash
partial def readU (input : Array Nat) (j k n count : Nat) : StrLit :=
  let c := at input k;
  match Nat.beq c 125 with
  | .true => match Nat.beq count 0 with
    | .true => .err uBad j
    | .false => match Bool.or (Nat.lt 1114111 n) (between n 55296 57343) with
      | .true => .err "the escape \\u{H} is not a Unicode scalar value (at most 10FFFF, and not D800 to DFFF)" j
      | .false => .ok (.cons (Char.mk n) .nil) (k + 1)
  | .false => match hexVal c, Nat.lt count 6 with
    | .some d, .true => readU input j (k + 1) (Nat.add (Nat.mul n 16) d) (Nat.succ count)
    | _, _ => .err uBad j
-- the escape whose backslash is at `j`: its character (as a one-element list) and the
-- offset after it, or a message at `j` (`0`: the literal is unterminated)
def readEscape (input : Array Nat) (j : Nat) : StrLit :=
  let e := at input (j + 1);
  let one := fun (c : Nat) => StrLit.ok (.cons (Char.mk c) .nil) (j + 2);
  match Nat.beq e 110 with
  | .true => one 10
  | .false => match Nat.beq e 116 with
    | .true => one 9
    | .false => match Nat.beq e 114 with
      | .true => one 13
      | .false => match Nat.beq e 48 with
        | .true => one 0
        | .false => match Bool.or (Bool.or (Nat.beq e 92) (Nat.beq e 34)) (Nat.beq e 39) with
          | .true => one e
          | .false => match Nat.beq e 120 with
            | .true => match hexVal (at input (j + 2)), hexVal (at input (j + 3)) with
              | .some a, .some b => .ok (.cons (Char.mk (Nat.add (Nat.mul a 16) b)) .nil) (j + 4)
              | _, _ => .err "the escape \\x needs two hexadecimal digits (as in \\x41)" j
            | .false => match Nat.beq e 117 with
              | .true => match Nat.beq (at input (j + 2)) 123 with
                | .true => readU input j (j + 3) 0 0
                | .false => .err uBad j
              | .false => match Nat.beq e 0 with
                | .true => .err "unterminated string literal" 0
                | .false => .err (String.append "unknown escape sequence \\" (String.mk (.cons (Char.mk e) .nil))) j
partial def readStr (input : Array Nat) (j : Nat) (acc : List Char) : StrLit :=
    let c := at input j;
    match Nat.beq c 0 with
    | .true => .err "unterminated string literal" 0
    | .false => match Nat.beq c 34 with
      | .true => .ok (reverse acc .nil) (j + 1)
      | .false => match Nat.beq c 92 with
        | .false => readStr input (j + 1) (.cons (Char.mk c) acc)
        | .true => match readEscape input j with
          | .ok cs k => match cs with
            | .cons ch _ => readStr input k (.cons ch acc)
            | .nil => readStr input k acc
          | .err m p => .err m p

def len : List Char → Nat
  | .nil => 0
  | .cons _ cs => .succ (len cs)
def isNil : List Char → Bool
  | .nil => .true
  | .cons _ _ => .false
-- does `tok` occur at offset `i`?
def matchesAt : List Char → Array Nat → Nat → Bool
  | .nil, _, _ => .true
  | .cons c cs, input, i => Bool.and (Nat.beq (Char.code c) (at input i)) (matchesAt cs input (i + 1))

-- the longest token of the table at offset `i` (or the empty list)
def longest : List String → Array Nat → Nat → List Char → List Char
  --<sol
  | .nil, _, _, best => best
  | .cons (.mk t) ts, input, i, best => match Bool.and (matchesAt t input i) (Nat.lt (len best) (len t)) with
    | .true => longest ts input i t
    | .false => longest ts input i best
  --|ex
  --| -- Exercise 12.1: walk the table, keeping in `best` the longest token that occurs at
  --| -- offset `i` (`matchesAt`, `len`, `Nat.lt`); a `String` is `.mk` of its characters.
  --| | _, _, _, best => best
  --sol>

inductive Tok where
  | atom (val : String)
  | ident (val : String)
  | num (digits : String)
  | str (val : String)
  | error (msg : String)
-- a token and where it is: [start, stop)
inductive TokInfo where
  | mk (tok : Tok) (start stop : Nat)

-- the token at offset `i`, which must not be whitespace
def readToken (tokens : List String) (input : Array Nat) (i : Nat) : TokInfo :=
  let c := at input i;
  let sym := longest tokens input i .nil;
  match isIdStart c with
  | .true =>
    let j := identEnd input i;
    -- a symbol token at least as long as the identifier wins (e.g. a keyword)
    match Bool.and (Bool.not (isNil sym)) (Nat.le (j - i) (len sym)) with
    | .true => TokInfo.mk (Tok.atom (String.mk sym)) i (i + len sym)
    | .false => TokInfo.mk (Tok.ident (String.mk (slice (j - i) input i))) i j
  | .false => match isDigit c with
    | .true =>
      let j := digitsEnd input i;
      TokInfo.mk (Tok.num (String.mk (slice (j - i) input i))) i j
    | .false => match Nat.beq c 34 with
      | .true => match readStr input (i + 1) .nil with
        | .ok s j => TokInfo.mk (Tok.str (String.mk s)) i j
        -- (a bad escape is reported at its backslash, an unterminated literal at its start)
        | .err m p => match Nat.beq p 0 with
          | .true => TokInfo.mk (Tok.error m) i i
          | .false => TokInfo.mk (Tok.error m) p p
      | .false => match sym with
        | .nil => TokInfo.mk (Tok.error (String.append "unexpected character '"
            (String.append (String.mk (.cons (Char.mk c) .nil)) "'"))) i i
        | .cons _ _ => TokInfo.mk (Tok.atom (String.mk sym)) i (i + len sym)

-- all the tokens, as `kind:text` lines (reversed)
partial def lex (tokens : List String) (input : Array Nat) (i : Nat) (acc : List String) : List String :=
    let j := skipWs input i;
    match Nat.lt j (Array.size input) with
    | .false => acc
    | .true => match readToken tokens input j with
      | .mk t _ stop => match t with
        | .atom s => lex tokens input stop (.cons (String.append "atom:" s) acc)
        | .ident s => lex tokens input stop (.cons (String.append "ident:" s) acc)
        | .num s => lex tokens input stop (.cons (String.append "num:" s) acc)
        | .str s => lex tokens input stop (.cons (String.append "str:" s) acc)
        | .error m => .cons (String.append "error:" m) acc

def printAll : List String → IO Unit
  | .nil => IO.pure ()
  | .cons s ss => do
    IO.println s;
    printAll ss

def tokenize (tokens : List String) (input : String) : List String :=
  lex tokens (String.codes input) 0 .nil
