import IO
-- A type checker in Wiz (stage 14a): the core of `Wiz/Core`, for a small calculus:
-- variables (de Bruijn indices), universes `U n`, Π types, λ, application, Σ types,
-- pairs and projections (stage 14e), `Unit`, `Empty`, finite enumerations with case
-- analysis (stage 14f), `let`, and type ascriptions. Normalisation by evaluation, as in `Eval.lean`: terms evaluate to
-- values with closures (an environment and a body), values quote back to normal forms,
-- and conversion compares values (with η for functions and pairs).
--
-- Values, environments and spines are mutually inductive (a closure holds an
-- environment of values), and evaluation, application and quotation are mutually
-- recursive.

mutual
inductive Tm where
  | var (i : Nat)
  | univ (n : Nat)
  | pi (dom cod : Tm)
  | lam (body : Tm)
  | app (f a : Tm)
  | letE (ty val body : Tm)
  | ann (t ty : Tm)
  | sigma (fst snd : Tm)
  | pair (a b : Tm)
  | fst (p : Tm)
  | snd (p : Tm)
  -- `Unit n`, `Empty n : U n`; `exfalso motive t` for `t : Empty n`
  | unit (n : Nat)
  | star
  | empty (n : Nat)
  | exfalso (motive t : Tm)
  -- an enumeration of `k` tags, its `i`-th tag, and case analysis (the motive is
  -- under one binder, the scrutinee)
  | enum (k : Nat)
  | tag (k i : Nat)
  | ecase (motive scrut : Tm) (branches : Tms)
inductive Tms where
  | tnil
  | tcons (t : Tm) (rest : Tms)
end

mutual
inductive Val where
  | vuniv (n : Nat)
  -- `(x : dom) → cod`, `cod` under one binder, closed over `env`
  | vpi (dom : Val) (env : Env) (cod : Tm)
  | vlam (env : Env) (body : Tm)
  -- `(x : fst) × snd`, `snd` under one binder, closed over `env`
  | vsigma (fst : Val) (env : Env) (snd : Tm)
  | vpair (a b : Val)
  | vunit (n : Nat)
  | vtt
  | vempty (n : Nat)
  | venum (k : Nat)
  | vtag (k i : Nat)
  -- a variable (by level) and the eliminations applied to it
  | vne (lvl : Nat) (spine : Spine)
inductive Env where
  | nil
  | cons (v : Val) (rest : Env)
-- eliminations, the last one outermost
inductive Spine where
  | snil
  | sapp (sp : Spine) (a : Val)
  | sfst (sp : Spine)
  | ssnd (sp : Spine)
  -- a stuck case: its motive and branches, closed over `env`
  | secase (sp : Spine) (env : Env) (motive : Tm) (branches : Tms)
  | sabsurd (sp : Spine) (motive : Val)
end

def tmsNth : Tms → Nat → Tm
  | .tnil, _ => .star
  | .tcons t rest, i => match i with
    | .zero => t
    | .succ j => tmsNth rest j
def tmsLen : Tms → Nat
  | .tnil => 0
  | .tcons _ rest => Nat.succ (tmsLen rest)

def lookup : Env → Nat → Val
  | .nil, _ => .vuniv 0
  | .cons v rest, i => match i with
    | .zero => v
    | .succ j => lookup rest j

-- **Exercise 14.1.** Evaluation, application and projections (`eval`, `vApp`, `vFst`,
-- `vSnd` in `Eval.lean`).
mutual
def eval : Env → Tm → Val
  | _, _ => .vuniv 0
def vapp : Val → Val → Val
  | v, _ => v
def vfst : Val → Val
  | v => v
def vsnd : Val → Val
  | v => v
end

-- a fresh variable at level `l`
def fresh (l : Nat) : Val := .vne l .snil

-- **Exercise 14.2.** Quotation (`quote` in `Eval.lean`): back to a term at depth `l`.
mutual
def quote : Nat → Val → Tm
  | _, _ => .univ 0
def quoteSpine : Nat → Tm → Spine → Tm
  | _, h, .snil => h
  | l, h, .sapp sp a => .app (quoteSpine l h sp) (quote l a)
  | l, h, .sfst sp => .fst (quoteSpine l h sp)
  | l, h, .ssnd sp => .snd (quoteSpine l h sp)
  | l, h, .secase sp env m bs =>
    .ecase (quote (l + 1) (eval (.cons (fresh l) env) m)) (quoteSpine l h sp) (quoteBranches l env bs)
  | l, h, .sabsurd sp m => .exfalso (quote l m) (quoteSpine l h sp)
def quoteBranches : Nat → Env → Tms → Tms
  | _, _, .tnil => .tnil
  | l, env, .tcons b rest => .tcons (quote l (eval env b)) (quoteBranches l env rest)
end

-- **Exercise 14.6.** Conversion (`conv` in `Conv.lean`), on values at depth `l`: equal
-- universes, Π and Σ types with convertible components, the same variable with
-- convertible eliminations, functions compared by applying both to a fresh variable,
-- and pairs by their projections (that is η: `f` and `λx. f x` are convertible, and so
-- are `p` and `(p.1, p.2)`).
mutual
def conv : Nat → Val → Val → Bool
  | _, _, _ => .false
def convSpine : Nat → Spine → Spine → Bool
  | _, .snil, .snil => .true
  | l, .sapp r a, .sapp r' b => Bool.and (convSpine l r r') (conv l a b)
  | l, .sfst r, .sfst r' => convSpine l r r'
  | l, .ssnd r, .ssnd r' => convSpine l r r'
  | l, .secase r e m bs, .secase r' e' m' bs' => Bool.and (convSpine l r r')
      (Bool.and (conv (l + 1) (eval (.cons (fresh l) e) m) (eval (.cons (fresh l) e') m'))
        (convBranches l e e' bs bs'))
  | l, .sabsurd r m, .sabsurd r' m' => Bool.and (convSpine l r r') (conv l m m')
  | _, _, _ => .false
def convBranches : Nat → Env → Env → Tms → Tms → Bool
  | _, _, _, .tnil, .tnil => .true
  | l, e, e', .tcons b r, .tcons b' r' => Bool.and (conv l (eval e b) (eval e' b')) (convBranches l e e' r r')
  | _, _, _, _, _ => .false
end

-- the name of the variable at level `l`: from `names` (the outermost first), or `x<l>`
def nameFrom : List String → Nat → Nat → String
  | .nil, _, l => String.append "x" (Nat.toString l)
  | .cons n ns, k, l => match k with
    | .zero => n
    | .succ k' => nameFrom ns k' l
def nameAt (names : List String) (l : Nat) : String := nameFrom names l l

mutual
-- terms, printed with the variables named by level (`x0` is the outermost, unless
-- `names` names it)
def show (names : List String) : Nat → Tm → String
  | l, .var i => nameAt names (l - i - 1)
  | _, .univ n => String.append "U" (Nat.toString n)
  | l, .pi a b => String.append (String.append (String.append "(" (nameAt names l))
      (String.append " : " (show names l a))) (String.append ") → " (show names (l + 1) b))
  | l, .lam b => String.append (String.append "λ" (nameAt names l)) (String.append ". " (show names (l + 1) b))
  | l, .app f a => String.append (String.append "(" (show names l f)) (String.append " " (String.append (show names l a) ")"))
  | l, .letE t v b => String.append (String.append "let " (nameAt names l))
      (String.append (String.append " := " (show names l v)) (String.append "; " (show names (l + 1) b)))
  | l, .ann t ty => String.append (String.append "(" (show names l t)) (String.append " : " (String.append (show names l ty) ")"))
  | l, .sigma a b => String.append (String.append (String.append "(" (nameAt names l))
      (String.append " : " (show names l a))) (String.append ") × " (show names (l + 1) b))
  | l, .pair a b => String.append (String.append "(" (show names l a)) (String.append ", " (String.append (show names l b) ")"))
  | l, .fst p => String.append (show names l p) ".1"
  | l, .snd p => String.append (show names l p) ".2"
  | _, .unit n => String.append "Unit" (Nat.toString n)
  | _, .star => "tt"
  | _, .empty n => String.append "Empty" (Nat.toString n)
  | l, .exfalso m t => String.append (String.append "absurd(" (show names l m)) (String.append ", " (String.append (show names l t) ")"))
  | _, .enum k => String.append "Enum" (Nat.toString k)
  | _, .tag _ i => String.append "#" (Nat.toString i)
  | l, .ecase m s bs => String.append (String.append (String.append "case(" (show names (l + 1) m))
      (String.append ", " (show names l s))) (String.append (showBranches names l bs) ")")

-- the branches, each after `, `
def showBranches (names : List String) : Nat → Tms → String
  | _, .tnil => ""
  | l, .tcons b rest => String.append (String.append ", " (show names l b)) (showBranches names l rest)
end

-- the typing context: values of the variables, their types, the depth
inductive TCtx where
  | mk (env : Env) (types : Env) (lvl : Nat)
def TCtx.lvl : TCtx → Nat
  | .mk _ _ l => l
def TCtx.env : TCtx → Env
  | .mk e _ _ => e
def TCtx.types : TCtx → Env
  | .mk _ t _ => t
-- a new variable of type `ty`
def TCtx.bind (c : TCtx) (ty : Val) : TCtx := match c with
  | .mk e t l => .mk (.cons (fresh l) e) (.cons ty t) (l + 1)
-- a new variable defined as `v`
def TCtx.define (c : TCtx) (v ty : Val) : TCtx := match c with
  | .mk e t l => .mk (.cons v e) (.cons ty t) (l + 1)

inductive TyRes where
  | ok (ty : Val)
  | err (msg : String)

def showVal (c : TCtx) (v : Val) : String := show .nil (TCtx.lvl c) (quote (TCtx.lvl c) v)

-- **Exercise 14.3.** Bidirectional type checking (`infer` and `check` in `Check.lean`).
-- `check` returns the type it checked against.
mutual
def infer : TCtx → Tm → TyRes
  | _, _ => .err "not implemented"
def check : TCtx → Tm → Val → TyRes
  | _, _, _ => .err "not implemented"
-- branch `i` and on, against the motive at tag `i`
def checkBranches : TCtx → Nat → Tm → Tms → Nat → TyRes
  | _, k, _, .tnil, _ => .ok (.venum k)
  | c, k, m, .tcons b rest, i => match check c b (eval (.cons (.vtag k i) (TCtx.env c)) m) with
    | .ok _ => checkBranches c k m rest (i + 1)
    | r => r
-- a type: its universe
def inferUniv : TCtx → Tm → TyRes
  | c, t => match infer c t with
    | .ok ty => match ty with
      | .vuniv n => .ok (.vuniv n)
      | ty => .err (String.append "not a type: its type is " (showVal c ty))
    | r => r
end

def empty : TCtx := .mk .nil .nil 0

-- type check a closed term: its type, or the error
def typeOf (t : Tm) : String := match infer empty t with
  | .ok ty => show .nil 0 (quote 0 ty)
  | .err m => String.append "error: " m

-- the normal form of a closed term
def normalize (t : Tm) : String := show .nil 0 (quote 0 (eval .nil t))
