import IO
-- A type checker in Wiz (stage 14a): the core of `Wiz/Core`, for a small calculus:
-- variables (de Bruijn indices), universes `U n`, Π types, λ, application, Σ types,
-- pairs and projections (stage 14e), `Unit`, `Empty`, finite enumerations with case
-- analysis (stage 14f), `Prop` with proof irrelevance (stage 14g), observational
-- equality (stage 14h), descriptions and data (stage 14i), induction (stage 14j),
-- global constants (stage 14k) and universe-polymorphic ones (stage 14l), quantities
-- (stage 14m), sizes and subtyping (stage 14n), sized recursion (stage 14o), `let`, and
-- type ascriptions. Normalisation by evaluation, as in `Eval.lean`: terms evaluate to values
-- with closures (an environment and a body), values quote back to normal forms, and
-- conversion compares values at their types (with η, and all proofs of a proposition
-- equal). Values carry `Sort` levels: `Prop` is `Sort 0`, and `U n` is `Sort (n + 1)`.
--
-- Values, environments and spines are mutually inductive (a closure holds an
-- environment of values), and evaluation, application and quotation are mutually
-- recursive.

-- quantities (stage 14m): how many times a binder's variable may be used at runtime
inductive Q where
  | qz
  | qo
  | qw
def qEq : Q → Q → Bool
  | .qz, .qz => .true
  | .qo, .qo => .true
  | .qw, .qw => .true
  | _, _ => .false

-- universe levels in terms: numerals, parameters (of a universe-polymorphic constant),
-- and their successors and maxima. Values only ever see closed levels (a constant is
-- instantiated before it is evaluated), so their levels are numbers.
inductive Lvl where
  | lnum (n : Nat)
  | lparam (name : String)
  | lsucc (l : Lvl)
  | lmax (a b : Lvl)
  | limax (a b : Lvl)

mutual
inductive Tm where
  | var (i : Nat)
  -- `U n` (= `Type n`, `Sort (n + 1)`), and `Prop` (`Sort 0`)
  | univ (n : Nat)
  | prop
  -- `Sort l` for any level (`univ n` and `prop` are the closed ones)
  | sortL (l : Lvl)
  | pi (dom cod : Tm)
  | lam (body : Tm)
  | app (f a : Tm)
  | letE (ty val body : Tm)
  | ann (t ty : Tm)
  -- binders with a quantity (`pi`, `sigma`, `letE` are at ω)
  | piq (q : Q) (dom cod : Tm)
  -- a `Π` or `Σ` with its sort: type equality compares propositions by equivalence and
  -- other types by their parts, so it needs to know which is which (`infer` checks it)
  | sorted (s : Lvl) (t : Tm)
  | sigmaq (q : Q) (fst snd : Tm)
  | letq (q : Q) (ty val body : Tm)
  | sigma (fst snd : Tm)
  | pair (a b : Tm)
  | fst (p : Tm)
  | snd (p : Tm)
  -- `Unit n`, `Empty n : U n`, `True`, `False : Prop`; `exfalso motive t` for an empty `t`
  | unit (n : Nat)
  | star
  | empty (n : Nat)
  | ptrue
  | pfalse
  | exfalso (motive t : Tm)
  -- an enumeration of `k` tags, its `i`-th tag, and case analysis (the motive is
  -- under one binder, the scrutinee)
  | enum (k : Nat)
  | tag (k i : Nat)
  | ecase (motive scrut : Tm) (branches : Tms)
  -- observational equality (`Eval.lean`, stage 4c): `a = b` at `A`, `A = B` between
  -- types, their proofs `eqRefl`, `tyRefl`, `subst` (`refl`, `reflTy` and `transp`:
  -- transport in a family of propositions), and `coe A B e t : B` (`cast`) for `t : A`
  -- and `e : A = B` (the Wiz keywords can't be constructor names)
  | eq (A a b : Tm)
  | eqTy (A B : Tm)
  | eqRefl (A a : Tm)
  | tyRefl (X : Tm)
  | coe (A B e t : Tm)
  | subst (A a P p b e : Tm)
  -- descriptions of indexed data (`descr l I` is `Desc.{l} I`, stage 4d; `desc` would
  -- clash with the family's own description), their eliminator (with the
  -- motive's universe `v`), the data type `μ D i`, and its constructor. Quantities are
  -- not part of this kernel: where the Lean kernel passes one, this one passes `tt`.
  | descr (l : Nat) (I : Tm)
  | dret (i : Tm)
  | darg (S D : Tm)
  | drec (j D : Tm)
  | dhrec (H j D : Tm)
  | delim (v : Nat) (P mret marg mrec mhrec D : Tm)
  | mu (l : Nat) (I D i : Tm)
  | con (x : Tm)
  -- sizes (stage 4f): the type `Size`, `∞`, `↑s`, the sizes below `s`, and `μ` at a size
  -- (`mu` is at `∞`)
  | size
  | szInf
  | szSuc (s : Tm)
  | sizeLt (s : Tm)
  | mus (l : Nat) (I D i s : Tm)
  -- sized recursion and case analysis on `x : μ^s D i` (stage 4f)
  | sfix (l : Nat) (I D : Tm) (v : Nat) (P f s i x : Tm)
  | scase (l : Nat) (I D : Tm) (v : Nat) (P m s i x : Tm)
  -- coinduction (stages 4d, 4f): `ν^s D i`, observation `out x : ⟦D⟧ (ν D) i`, a ν
  -- constructor, sized corecursion and coiteration (unfolding a state `s : S i` by `step`)
  | nu (l : Nat) (I D i s : Tm)
  | out (x : Tm)
  | cocon (x : Tm)
  | scofix (l : Nat) (I D A f s i a : Tm)
  | coit (l : Nat) (I D S step i s : Tm)
  -- induction on `x : μ D i`, into the motive `P : (i : I) → μ D i → Sort v`
  | ind (l : Nat) (I D : Tm) (v : Nat) (P m i x : Tm)
  -- a global definition, carrying its (closed) value and type, and a global axiom: the
  -- terms are shared, so there is no table of globals to pass around
  | const (name : String) (params : List String) (levels : List Lvl) (value ty : Tm)
  | axiomC (name : String) (ty : Tm)
  -- (Q4) `ULift A : Sort l` for `A : Sort k`, `k ≤ l`: a description field must be in
  -- exactly `Sort (l+1)`, so smaller ones are lifted; `up a : ULift A`, `down t : A`
  | ulift (l : Nat) (A : Tm)
  | up (a : Tm)
  | down (t : Tm)
inductive Tms where
  | tnil
  | tcons (t : Tm) (rest : Tms)
end

mutual
inductive Val where
  -- `Sort l`
  | vsort (l : Lvl)
  -- `(x : dom) → cod`, `cod` under one binder, closed over `env`; `s` its sort, when
  -- known (`sorted`)
  | vpi (q : Q) (dom : Val) (env : Env) (cod : Tm) (s : Option Lvl)
  | vlam (env : Env) (body : Tm)
  -- `(x : fst) × snd`, `snd` under one binder, closed over `env`
  | vsigma (q : Q) (fst : Val) (env : Env) (snd : Tm) (s : Option Lvl)
  | vpair (a b : Val)
  -- the unit and empty types in `Sort l`
  | vunit (l : Nat)
  | vtt
  | vempty (l : Nat)
  | venum (k : Nat)
  | vtag (k i : Nat)
  | vdesc (l : Nat) (I : Val)
  | vdret (i : Val)
  | vdarg (S E : Val)
  | vdrec (j E : Val)
  | vdhrec (H j E : Val)
  | vmu (l : Nat) (I D i sz : Val)
  | vsize
  | vszInf
  | vszSuc (s : Val)
  | vsizeLt (s : Val)
  | vcon (x : Val)
  | vnu (l : Nat) (I D i sz : Val)
  | vcocon (x : Val)
  -- unfoldings: they compute only when observed
  | vscofix (l : Nat) (I D A f sz i a : Val)
  | vcoit (l : Nat) (I D S step i s : Val)
  -- **glued**: a global definition applied to `sp`, and its unfolding (`Val.unfold` in
  -- the Lean kernel), computed when `whnf` first looks through it (`memo`)
  | vglued (h : Head) (sp : Spine) (v : Unit → Val)
  -- `ULift A` in `Sort l`, and its constructor (Q4)
  | vulift (l : Nat) (A : Val)
  | vup (a : Val)
  -- a stuck head and the eliminations applied to it
  | vne (head : Head) (spine : Spine)
inductive Env where
  | nil
  | cons (v : Val) (rest : Env)
-- eliminations, the last one outermost
inductive Spine where
  | snil
  | sapp (sp : Spine) (a : Val)
  | sfst (sp : Spine)
  | ssnd (sp : Spine)
  -- a stuck case: its motive and branches, closed over `env`
  | secase (sp : Spine) (env : Env) (motive : Tm) (branches : Tms)
  | sabsurd (sp : Spine) (motive : Val)
  | sdelim (sp : Spine) (v : Nat) (P mret marg mrec mhrec : Val)
  | sind (sp : Spine) (l : Nat) (I D : Val) (v : Nat) (P m i : Val)
  | ssfix (sp : Spine) (l : Nat) (I D : Val) (v : Nat) (P f s i : Val)
  | sscase (sp : Spine) (l : Nat) (I D : Val) (v : Nat) (P m s i : Val)
  | sout (sp : Spine)
  | sdown (sp : Spine)
-- what a neutral is stuck on: a variable (by level), or an equality, cast or proof
-- that doesn't compute
inductive Head where
  | hvar (lvl : Nat)
  | heq (A a b : Val)
  | heqTy (A B : Val)
  | hcast (A B e t : Val)
  | hrefl (A a : Val)
  | hreflTy (X : Val)
  | htransp (A a P p b e : Val)
  -- (P2) a suspended proof: the term `t` in `env`, never evaluated by the kernel; `ty`
  -- is its type
  | hprf (ty : Unit → Val) (env : Env) (t : Tm)
  | hconst (name : String) (params : List String) (levels : List Lvl) (value ty : Tm)
  | haxiom (name : String) (ty : Tm)
end
-- the payload types of a cast between two data types and their equation (4g)
inductive PayEq where
  | mk (Xi Xi' e : Val)

def kCharsEq : List Char → List Char → Bool
  | .nil, .nil => .true
  -- (the heads first: `Bool.and` would evaluate the rest anyway, call by value)
  | .cons a as, .cons b bs => match Nat.beq (Char.code a) (Char.code b) with
    | .true => kCharsEq as bs
    | .false => .false
  | _, _ => .false
def kStrEq (a b : String) : Bool := match a with
  | .mk x => match b with
    | .mk y => kCharsEq x y
def kCharsLt : List Char → List Char → Bool
  | .nil, .cons _ _ => .true
  | .cons a as, .cons b bs => match Nat.lt (Char.code a) (Char.code b) with
    | .true => .true
    | .false => Bool.and (Nat.beq (Char.code a) (Char.code b)) (kCharsLt as bs)
  | _, _ => .false
def kStrLt (a b : String) : Bool := match a with
  | .mk x => match b with
    | .mk y => kCharsLt x y

-- Normal forms of levels (`Level.normalize` in `Level.lean`): the `max` of entries
-- `atom + k`, sorted, at most one per atom, where an atom is the constant `0`, a
-- parameter, or an `imax` that doesn't simplify
mutual
inductive LAtom where
  | aconst
  | aparam (n : String)
  | aimax (a b : LNF)
inductive LNF where
  | nnil
  | ncons (a : LAtom) (k : Nat) (rest : LNF)
end

mutual
def atomEq : LAtom → LAtom → Bool
  | .aconst, .aconst => .true
  | .aparam a, .aparam b => kStrEq a b
  | .aimax a b, .aimax c d => Bool.and (nfEq a c) (nfEq b d)
  | _, _ => .false
def nfEq : LNF → LNF → Bool
  | .nnil, .nnil => .true
  | .ncons a k r, .ncons b m r' => Bool.and (Bool.and (atomEq a b) (Nat.beq k m)) (nfEq r r')
  | _, _ => .false
end
mutual
def atomShow : LAtom → String
  | .aconst => "0"
  | .aparam n => n
  | .aimax a b => String.append (String.append (String.append "imax(" (nfShow a)) ", ") (String.append (nfShow b) ")")
def nfShow : LNF → String
  | .nnil => ""
  | .ncons a k r => String.append (String.append (String.append (atomShow a) "+") (Nat.toString k))
      (String.append " " (nfShow r))
end
def atomRank : LAtom → Nat
  | .aconst => 0
  | .aparam _ => 1
  | .aimax _ _ => 2
-- a total order on atoms, to keep normal forms sorted
def atomLt (a b : LAtom) : Bool := match a with
  | .aparam x => match b with
    | .aparam y => kStrLt x y
    | _ => Nat.lt (atomRank a) (atomRank b)
  | .aimax _ _ => match b with
    | .aimax _ _ => kStrLt (atomShow a) (atomShow b)
    | _ => Nat.lt (atomRank a) (atomRank b)
  | _ => Nat.lt (atomRank a) (atomRank b)
def nfInsert (x : LAtom) (k : Nat) : LNF → LNF
  | .nnil => .ncons x k .nnil
  | .ncons y m ys => match atomEq x y with
    | .true => .ncons y (Nat.max k m) ys
    | .false => match atomLt x y with
      | .true => .ncons x k (.ncons y m ys)
      | .false => .ncons y m (nfInsert x k ys)
def nfMerge : LNF → LNF → LNF
  | .nnil, b => b
  | .ncons x k r, b => nfMerge r (nfInsert x k b)
def nfShift : LNF → LNF
  | .nnil => .nnil
  | .ncons a k r => .ncons a (k + 1) (nfShift r)
def nfOthers : LNF → LNF
  | .nnil => .nnil
  | .ncons a k r => match a with
    | .aconst => nfOthers r
    | _ => .ncons a k (nfOthers r)
def nfMaxK : LNF → Nat
  | .nnil => 0
  | .ncons _ k r => Nat.max k (nfMaxK r)
def nfConst : LNF → Option Nat
  | .nnil => .none
  | .ncons a k r => match a with
    | .aconst => .some k
    | _ => nfConst r
-- drop the constant entry when another entry already guarantees it
def nfCleanup (n : LNF) : LNF := match nfConst n with
  | .none => n
  | .some c => match nfOthers n with
    | .nnil => n
    | .ncons a k r => match Nat.le c (nfMaxK (.ncons a k r)) with
      | .true => .ncons a k r
      | .false => n
-- certainly nonzero
def nfNonZero : LNF → Bool
  | .nnil => .false
  | .ncons _ k r => Bool.or (Nat.lt 0 k) (nfNonZero r)
def nfZero : LNF := .ncons .aconst 0 .nnil

-- **Exercise 14.8.** Normalise a level (`Level.normalize`): `imax a b` is `max a b` when
-- `b` is certainly nonzero, `0` when `b` is `0`, and an atom otherwise.
def lvlNorm : Lvl → LNF
  --<sol
  | .lnum n => .ncons .aconst n .nnil
  | .lparam n => .ncons (.aparam n) 0 .nnil
  | .lsucc l => nfCleanup (nfShift (lvlNorm l))
  | .lmax a b => nfCleanup (nfMerge (lvlNorm a) (lvlNorm b))
  -- (`b`'s normal form once: a chain of `imax`es, along a telescope, would be normalised
  -- exponentially often)
  | .limax a b =>
    let na := lvlNorm a;
    let nb := lvlNorm b;
    match nfNonZero nb with
    | .true => nfCleanup (nfMerge na nb)
    | .false => match nfEq nb nfZero with
      | .true => nfZero
      | .false => .ncons (.aimax na nb) 0 .nnil
  --|ex
  --| | _ => nfZero
  --sol>

def lvlParams : Lvl → List String
  | .lparam n => .cons n .nil
  | .lsucc l => lvlParams l
  | .lmax a b => List.append (lvlParams a) (lvlParams b)
  | .limax a b => List.append (lvlParams a) (lvlParams b)
  | _ => .nil
def lvlNeverZero (l : Lvl) : Bool := nfNonZero (lvlNorm l)
def orElseStr : Option String → Option String → Option String
  | .some a, _ => .some a
  | .none, b => b
def headStr : List String → Option String
  | .nil => .none
  | .cons a _ => .some a
-- a parameter that decides whether some `imax` is zero
def imaxParam : Lvl → Option String
  | .lsucc l => imaxParam l
  | .lmax a b => orElseStr (imaxParam a) (imaxParam b)
  | .limax a b => orElseStr (orElseStr (imaxParam a) (imaxParam b)) (match lvlNeverZero b with
    | .true => .none
    | .false => headStr (lvlParams b))
  | _ => .none
-- a closed level as a number (a parameter that is left counts as `0`)
def lookupLvl : List String → List Lvl → String → Lvl
  | .cons p ps, .cons l ls, n => match kStrEq p n with
    | .true => l
    | .false => lookupLvl ps ls n
  | _, _, n => .lparam n
-- substitute levels for parameters
def substLvl (ps : List String) (ls : List Lvl) : Lvl → Lvl
  | .lparam n => lookupLvl ps ls n
  | .lsucc l => .lsucc (substLvl ps ls l)
  | .lmax a b => .lmax (substLvl ps ls a) (substLvl ps ls b)
  | .limax a b => .limax (substLvl ps ls a) (substLvl ps ls b)
  | l => l
-- (`Level.equiv`) normal forms decide equality except for `imax`: then split on a
-- parameter `p` an `imax` depends on, `p = 0` or `p = p + 1`
def lvlEquivF : Nat → Lvl → Lvl → Bool
  | .zero, a, b => nfEq (lvlNorm a) (lvlNorm b)
  | .succ f, a, b => match nfEq (lvlNorm a) (lvlNorm b) with
    | .true => .true
    | .false => match orElseStr (imaxParam a) (imaxParam b) with
      | .none => .false
      | .some p =>
        let ps := List.cons p .nil;
        let z := List.cons (Lvl.lnum 0) .nil;
        let sp := List.cons (Lvl.lsucc (.lparam p)) .nil;
        Bool.and (lvlEquivF f (substLvl ps z a) (substLvl ps z b)) (lvlEquivF f (substLvl ps sp a) (substLvl ps sp b))
def lvlEquiv (a b : Lvl) : Bool := lvlEquivF 8 a b
def lvlLe (a b : Lvl) : Bool := lvlEquiv (.lmax a b) b
-- a level without parameters, as a number
def lvlClosed : Lvl → Option Nat
  | .lnum n => .some n
  | .lsucc l => match lvlClosed l with
    | .some n => .some (n + 1)
    | .none => .none
  | .lmax a b => match lvlClosed a with
    | .some m => match lvlClosed b with
      | .some n => .some (Nat.max m n)
      | .none => .none
    | .none => .none
  | .limax a b => match lvlClosed a with
    | .some m => match lvlClosed b with
      | .some n => match n with
        | .zero => .some 0
        | .succ _ => .some (Nat.max m n)
      | .none => .none
    | .none => .none
  | .lparam _ => .none
def lvlShow : Lvl → String
  | .lnum n => Nat.toString n
  | .lparam n => n
  | .lsucc l => String.append (String.append "(" (lvlShow l)) ")+1"
  | .lmax a b => String.append (String.append (String.append "max(" (lvlShow a)) ", ") (String.append (lvlShow b) ")")
  | .limax a b => String.append (String.append (String.append "imax(" (lvlShow a)) ", ") (String.append (lvlShow b) ")")
-- levels, compared and shown as `.{1, u}`
def lvlsEq : List Lvl → List Lvl → Bool
  | .nil, .nil => .true
  | .cons a r, .cons b r' => Bool.and (lvlEquiv a b) (lvlsEq r r')
  | _, _ => .false
def showLvlsFrom : List Lvl → String
  | .nil => ""
  | .cons l rest => match rest with
    | .nil => lvlShow l
    | .cons _ _ => String.append (String.append (lvlShow l) ", ") (showLvlsFrom rest)
def showLvls : List Lvl → String
  | .nil => ""
  | ls => String.append (String.append ".{" (showLvlsFrom ls)) "}"
def substLvls (ps : List String) (ls : List Lvl) : List Lvl → List Lvl
  | .nil => .nil
  | .cons l rest => .cons (substLvl ps ls l) (substLvls ps ls rest)
-- instantiate a universe-polymorphic definition's levels (the definitions of the
-- constants it mentions are closed, so they are left alone)
mutual
def tmSubst (ps : List String) (ls : List Lvl) : Tm → Tm
  | .sortL l => .sortL (substLvl ps ls l)
  | .const n ps' ls' v ty => .const n ps' (substLvls ps ls ls') v ty
  | .pi a b => .pi (tmSubst ps ls a) (tmSubst ps ls b)
  | .lam b => .lam (tmSubst ps ls b)
  | .app f a => .app (tmSubst ps ls f) (tmSubst ps ls a)
  | .letE t v b => .letE (tmSubst ps ls t) (tmSubst ps ls v) (tmSubst ps ls b)
  | .ann t ty => .ann (tmSubst ps ls t) (tmSubst ps ls ty)
  | .sigma a b => .sigma (tmSubst ps ls a) (tmSubst ps ls b)
  | .piq q a b => .piq q (tmSubst ps ls a) (tmSubst ps ls b)
  | .sigmaq q a b => .sigmaq q (tmSubst ps ls a) (tmSubst ps ls b)
  | .sorted l t => .sorted (substLvl ps ls l) (tmSubst ps ls t)
  | .letq q t v b => .letq q (tmSubst ps ls t) (tmSubst ps ls v) (tmSubst ps ls b)
  | .pair a b => .pair (tmSubst ps ls a) (tmSubst ps ls b)
  | .fst p => .fst (tmSubst ps ls p)
  | .snd p => .snd (tmSubst ps ls p)
  | .exfalso m t => .exfalso (tmSubst ps ls m) (tmSubst ps ls t)
  | .ecase m sc bs => .ecase (tmSubst ps ls m) (tmSubst ps ls sc) (tmsSubst ps ls bs)
  | .eq A a b => .eq (tmSubst ps ls A) (tmSubst ps ls a) (tmSubst ps ls b)
  | .eqTy A B => .eqTy (tmSubst ps ls A) (tmSubst ps ls B)
  | .eqRefl A a => .eqRefl (tmSubst ps ls A) (tmSubst ps ls a)
  | .tyRefl X => .tyRefl (tmSubst ps ls X)
  | .coe A B e t => .coe (tmSubst ps ls A) (tmSubst ps ls B) (tmSubst ps ls e) (tmSubst ps ls t)
  | .subst A a P p b e => .subst (tmSubst ps ls A) (tmSubst ps ls a) (tmSubst ps ls P) (tmSubst ps ls p)
      (tmSubst ps ls b) (tmSubst ps ls e)
  | .descr l I => .descr l (tmSubst ps ls I)
  | .dret i => .dret (tmSubst ps ls i)
  | .darg S D => .darg (tmSubst ps ls S) (tmSubst ps ls D)
  | .drec j D => .drec (tmSubst ps ls j) (tmSubst ps ls D)
  | .dhrec H j D => .dhrec (tmSubst ps ls H) (tmSubst ps ls j) (tmSubst ps ls D)
  | .delim v P a b c h D => .delim v (tmSubst ps ls P) (tmSubst ps ls a) (tmSubst ps ls b) (tmSubst ps ls c)
      (tmSubst ps ls h) (tmSubst ps ls D)
  | .mu l I D i => .mu l (tmSubst ps ls I) (tmSubst ps ls D) (tmSubst ps ls i)
  | .con x => .con (tmSubst ps ls x)
  | .szSuc sz => .szSuc (tmSubst ps ls sz)
  | .sfix l I D v P f sz i x => .sfix l (tmSubst ps ls I) (tmSubst ps ls D) v (tmSubst ps ls P) (tmSubst ps ls f)
      (tmSubst ps ls sz) (tmSubst ps ls i) (tmSubst ps ls x)
  | .scase l I D v P m sz i x => .scase l (tmSubst ps ls I) (tmSubst ps ls D) v (tmSubst ps ls P) (tmSubst ps ls m)
      (tmSubst ps ls sz) (tmSubst ps ls i) (tmSubst ps ls x)
  | .sizeLt sz => .sizeLt (tmSubst ps ls sz)
  | .mus l I D i sz => .mus l (tmSubst ps ls I) (tmSubst ps ls D) (tmSubst ps ls i) (tmSubst ps ls sz)
  | .nu l I D i sz => .nu l (tmSubst ps ls I) (tmSubst ps ls D) (tmSubst ps ls i) (tmSubst ps ls sz)
  | .out x => .out (tmSubst ps ls x)
  | .cocon x => .cocon (tmSubst ps ls x)
  | .scofix l I D A f sz i a => .scofix l (tmSubst ps ls I) (tmSubst ps ls D) (tmSubst ps ls A) (tmSubst ps ls f)
      (tmSubst ps ls sz) (tmSubst ps ls i) (tmSubst ps ls a)
  | .coit l I D S st i x => .coit l (tmSubst ps ls I) (tmSubst ps ls D) (tmSubst ps ls S) (tmSubst ps ls st)
      (tmSubst ps ls i) (tmSubst ps ls x)
  | .ind l I D v P m i x => .ind l (tmSubst ps ls I) (tmSubst ps ls D) v (tmSubst ps ls P) (tmSubst ps ls m)
      (tmSubst ps ls i) (tmSubst ps ls x)
  | .ulift l A => .ulift l (tmSubst ps ls A)
  | .up a => .up (tmSubst ps ls a)
  | .down t => .down (tmSubst ps ls t)
  | t => t
def tmsSubst (ps : List String) (ls : List Lvl) : Tms → Tms
  | .tnil => .tnil
  | .tcons t rest => .tcons (tmSubst ps ls t) (tmsSubst ps ls rest)
end
-- (a constant without level parameters is used as it is)
def substIfAny (ps : List String) (ls : List Lvl) (t : Tm) : Tm := match ps with
  | .nil => t
  | .cons _ _ => tmSubst ps ls t

-- a Π or Σ with a quantity, as a term (the default ω without one)
def sortedTm : Option Lvl → Tm → Tm
  | .none, t => t
  | .some l, t => .sorted l t
def piTm (q : Q) (a b : Tm) : Tm := match q with
  | .qw => .pi a b
  | q => .piq q a b
def sigmaTm (q : Q) (a b : Tm) : Tm := match q with
  | .qw => .sigma a b
  | q => .sigmaq q a b

-- unfold glued definitions at the head: do this before matching on a value's shape
-- (partial, so that the last case returns the value itself: by structural recursion it
-- would be rebuilt from its fields, an allocation for every call)
partial def whnf (v : Val) : Val := match v with
  | .vglued _ _ g => whnf (g ())
  | _ => v



def tmsNth : Tms → Nat → Tm
  | .tnil, _ => .star
  | .tcons t rest, i => match i with
    | .zero => t
    | .succ j => tmsNth rest j
def tmsLen : Tms → Nat
  | .tnil => 0
  | .tcons _ rest => Nat.succ (tmsLen rest)

-- (past the end: a stuck unknown. The checker rejects a variable out of scope, so
-- nothing well typed gets here; `Sort 0` here made such a variable a term `Prop : Prop`)
def lookup : Env → Nat → Val
  | .nil, _ => .vne (.haxiom " out of scope" .star) .snil
  | .cons v rest, i => match i with
    | .zero => v
    | .succ j => lookup rest j

-- a fresh variable at level `l`
def fresh (l : Nat) : Val := .vne (.hvar l) .snil

-- a `Π`/`Σ` with its sort (`sorted`); and a sort's verdict: a proposition, not one, or
-- not known (a level with parameters, or no sort given)
def withSort (l : Lvl) : Val → Val
  | .vpi q a env b _ => .vpi q a env b (.some l)
  | .vsigma q a env b _ => .vsigma q a env b (.some l)
  | v => v
def sortProp : Option Lvl → Option Bool
  | .none => .none
  | .some l => match lvlEquiv l (.lnum 0) with
    | .true => .some .true
    | .false => match lvlNeverZero l with
      | .true => .some .false
      | .false => .none
-- is this type (in weak head normal form) a proposition? (`propSort?` in `Eval.lean`)
def propSort : Val → Option Bool
  | .vpi _ _ _ _ s => sortProp s
  | .vsigma _ _ _ _ s => sortProp s
  | .vunit l => .some (Nat.beq l 0)
  | .vempty l => .some (Nat.beq l 0)
  | .vsort _ => .some .false
  | .venum _ => .some .false
  | .vdesc _ _ => .some .false
  | .vmu _ _ _ _ _ => .some .false
  | .vnu _ _ _ _ _ => .some .false
  | .vsize => .some .false
  | .vsizeLt _ => .some .false
  | .vulift l _ => .some (Nat.beq l 0)
  | .vne h sp => match sp with
    | .snil => match h with
      | .heq _ _ _ => .some .true
      | .heqTy _ _ => .some .true
      | _ => .none
    | _ => .none
  | _ => .none
-- `(a → b) × (b → a)`: equality of propositions
def vIff (a b : Val) : Val :=
  .vsigma .qz (.vpi .qz a (.cons b .nil) (.var 1) (.some (.lnum 0))) (.cons a (.cons b .nil))
    (.sorted (.lnum 0) (.piq .qz (.var 2) (.var 2))) (.some (.lnum 0))

-- `True` if the levels are equal, else `False`
def levels (l l' : Nat) : Val := match Nat.beq l l' with
  | .true => .vunit 0
  | .false => .vempty 0
def same (l l' : Nat) (yes no : Val) : Val := match Nat.beq l l' with
  | .true => yes
  | .false => no
-- a type former (so different ones are never equal); `Size` and `Size< s` are not
-- (as in `Eval.lean`): an equation between them stays stuck
def canonical : Val → Bool
  | .vpi _ _ _ _ _ => .true
  | .vsigma _ _ _ _ _ => .true
  | .vsort _ => .true
  | .vunit _ => .true
  | .vempty _ => .true
  | .venum _ => .true
  | .vdesc _ _ => .true
  | .vmu _ _ _ _ _ => .true
  | .vnu _ _ _ _ _ => .true
  | .vulift _ _ => .true
  | _ => .false

-- syntactic equality of terms
mutual
def tmEq : Tm → Tm → Bool
  | .var i, .var j => Nat.beq i j
  | .univ m, .univ n => Nat.beq m n
  | .prop, .prop => .true
  | .pi a b, .pi c d => Bool.and (tmEq a c) (tmEq b d)
  | .sorted l a, .sorted l' b => Bool.and (lvlEquiv l l') (tmEq a b)
  | .lam a, .lam b => tmEq a b
  | .app f a, .app g b => Bool.and (tmEq f g) (tmEq a b)
  | .sigma a b, .sigma c d => Bool.and (tmEq a c) (tmEq b d)
  | .piq q a b, .piq q' c d => Bool.and (qEq q q') (Bool.and (tmEq a c) (tmEq b d))
  | .sigmaq q a b, .sigmaq q' c d => Bool.and (qEq q q') (Bool.and (tmEq a c) (tmEq b d))
  | .pair a b, .pair c d => Bool.and (tmEq a c) (tmEq b d)
  | .fst a, .fst b => tmEq a b
  | .snd a, .snd b => tmEq a b
  | .unit m, .unit n => Nat.beq m n
  | .star, .star => .true
  | .empty m, .empty n => Nat.beq m n
  | .ptrue, .ptrue => .true
  | .pfalse, .pfalse => .true
  | .exfalso a b, .exfalso c d => Bool.and (tmEq a c) (tmEq b d)
  | .enum k, .enum k' => Nat.beq k k'
  | .tag _ i, .tag _ j => Nat.beq i j
  | .ecase a b bs, .ecase c d bs' => Bool.and (tmEq a c) (Bool.and (tmEq b d) (tmsEq bs bs'))
  | .eq a b c, .eq d e f => Bool.and (tmEq a d) (Bool.and (tmEq b e) (tmEq c f))
  | .eqTy a b, .eqTy c d => Bool.and (tmEq a c) (tmEq b d)
  | .coe a b _ t, .coe c d _ u => Bool.and (tmEq a c) (Bool.and (tmEq b d) (tmEq t u))
  | .eqRefl _ _, .eqRefl _ _ => .true
  | .tyRefl _, .tyRefl _ => .true
  | .subst _ _ _ _ _ _, .subst _ _ _ _ _ _ => .true
  | .descr l a, .descr l' b => Bool.and (Nat.beq l l') (tmEq a b)
  | .dret a, .dret b => tmEq a b
  | .darg a b, .darg c d => Bool.and (tmEq a c) (tmEq b d)
  | .drec a b, .drec c d => Bool.and (tmEq a c) (tmEq b d)
  | .dhrec a b c, .dhrec d e f => Bool.and (tmEq a d) (Bool.and (tmEq b e) (tmEq c f))
  | .delim v a b c d e f, .delim v' a' b' c' d' e' f' => Bool.and (Nat.beq v v') (Bool.and (tmEq a a')
      (Bool.and (tmEq b b') (Bool.and (tmEq c c') (Bool.and (tmEq d d') (Bool.and (tmEq e e') (tmEq f f'))))))
  | .mu l a b c, .mu l' d e f => Bool.and (Nat.beq l l') (Bool.and (tmEq a d) (Bool.and (tmEq b e) (tmEq c f)))
  | .con a, .con b => tmEq a b
  | .sfix l a b v c d e f g, .sfix l' a' b' v' c' d' e' f' g' => Bool.and (Bool.and (Nat.beq l l') (Nat.beq v v'))
      (Bool.and (tmEq a a') (Bool.and (tmEq b b') (Bool.and (tmEq c c') (Bool.and (tmEq d d') (Bool.and (tmEq e e') (Bool.and (tmEq f f') (tmEq g g')))))))
  | .scase l a b v c d e f g, .scase l' a' b' v' c' d' e' f' g' => Bool.and (Bool.and (Nat.beq l l') (Nat.beq v v'))
      (Bool.and (tmEq a a') (Bool.and (tmEq b b') (Bool.and (tmEq c c') (Bool.and (tmEq d d') (Bool.and (tmEq e e') (Bool.and (tmEq f f') (tmEq g g')))))))
  | .size, .size => .true
  | .szInf, .szInf => .true
  | .szSuc a, .szSuc b => tmEq a b
  | .sizeLt a, .sizeLt b => tmEq a b
  | .mus l a b c d, .mus l' a' b' c' d' => Bool.and (Nat.beq l l') (Bool.and (tmEq a a') (Bool.and (tmEq b b') (Bool.and (tmEq c c') (tmEq d d'))))
  | .nu l a b c d, .nu l' a' b' c' d' => Bool.and (Nat.beq l l') (Bool.and (tmEq a a') (Bool.and (tmEq b b') (Bool.and (tmEq c c') (tmEq d d'))))
  | .out a, .out b => tmEq a b
  | .cocon a, .cocon b => tmEq a b
  | .scofix l a b c d e f g, .scofix l' a' b' c' d' e' f' g' => Bool.and (Nat.beq l l')
      (Bool.and (tmEq a a') (Bool.and (tmEq b b') (Bool.and (tmEq c c') (Bool.and (tmEq d d') (Bool.and (tmEq e e') (Bool.and (tmEq f f') (tmEq g g')))))))
  | .coit l a b c d e f, .coit l' a' b' c' d' e' f' => Bool.and (Nat.beq l l')
      (Bool.and (tmEq a a') (Bool.and (tmEq b b') (Bool.and (tmEq c c') (Bool.and (tmEq d d') (Bool.and (tmEq e e') (tmEq f f'))))))
  | .const n _ ls _ _, .const n' _ ls' _ _ => Bool.and (kStrEq n n') (lvlsEq ls ls')
  | .sortL l, .sortL l' => lvlEquiv l l'
  | .axiomC n _, .axiomC n' _ => kStrEq n n'
  | .ulift l a, .ulift l' b => Bool.and (Nat.beq l l') (tmEq a b)
  | .up a, .up b => tmEq a b
  | .down a, .down b => tmEq a b
  | .ind l a b v c d e f, .ind l' a' b' v' c' d' e' f' => Bool.and (Nat.beq l l') (Bool.and (Nat.beq v v')
      (Bool.and (tmEq a a') (Bool.and (tmEq b b') (Bool.and (tmEq c c') (Bool.and (tmEq d d') (Bool.and (tmEq e e') (tmEq f f')))))))
  | _, _ => .false
def tmsEq : Tms → Tms → Bool
  | .tnil, .tnil => .true
  | .tcons a r, .tcons b r' => Bool.and (tmEq a b) (tmsEq r r')
  | _, _ => .false
end

-- The templates of `Templates.lean`, as terms (the same de Bruijn layout; quantity
-- binders stay, quantity arguments go).
def tLams : Nat → Tm → Tm
  | .zero, b => b
  | .succ n, b => .lam (tLams n b)
def tApps : Tm → Tms → Tm
  | f, .tnil => f
  | f, .tcons a rest => tApps (.app f a) rest
def args2 (a b : Tm) : Tms := .tcons a (.tcons b .tnil)
def args3 (a b c : Tm) : Tms := .tcons a (args2 b c)
def args4 (a b c d : Tm) : Tms := .tcons a (args3 b c d)

-- `fun I D X i => ⟦D⟧ X i` for `D : Desc.{l} I`
def interpTm (l : Nat) : Tm :=
  let tyL : Tm := .univ l;
  -- D'0 D1 I2
  let P : Tm := .lam (.pi (.pi (.var 2) tyL) (.pi (.var 3) tyL));
  -- i0 X1 j2 D3 I4
  let mret := tLams 3 (.sigmaq .qz (.eq (.var 4) (.var 2) (.var 0)) (.unit l));
  -- i0 X1 ih2 E3 S4 q5
  let marg := tLams 6 (.sigma (.var 4) (tApps (.var 3) (args3 (.var 0) (.var 2) (.var 1))));
  -- i0 X1 ih2 E3 j4 q5
  let mrec := tLams 6 (.sigma (.app (.var 1) (.var 4)) (tApps (.var 3) (args2 (.var 2) (.var 1))));
  -- i0 X1 ih2 E3 j4 H5 q6
  let mhrec := tLams 7 (.sigma (.pi (.var 5) (.app (.var 2) (.app (.var 5) (.var 0)))) (tApps (.var 3) (args2 (.var 2) (.var 1))));
  tLams 2 (.delim (l + 2) P mret marg mrec mhrec (.var 0))

-- `Sort v` and the unit type in it, as terms
def sortTm (v : Nat) : Tm := match v with
  | .zero => .prop
  | .succ n => .univ n
def unitTm (v : Nat) : Tm := match v with
  | .zero => .ptrue
  | .succ n => .unit n
def args5 (a b c d e : Tm) : Tms := .tcons a (args4 b c d e)
def args6 (a b c d e f : Tm) : Tms := .tcons a (args5 b c d e f)
def interpApp (l : Nat) (I E X i : Tm) : Tm := tApps (interpTm l) (args4 I E X i)

-- `fun I D X P i xs => All D X P i xs`: one proof of `P` per recursive field
def allTm (l v : Nat) : Tm :=
  let tyL : Tm := .univ l;
  -- E0 D1 I2, then X, P, i, xs
  let P : Tm := .lam (.pi (.pi (.var 2) tyL) (.pi (.pi (.var 3) (.pi (.app (.var 1) (.var 0)) (sortTm v)))
    (.pi (.var 4) (.pi (interpApp l (.var 5) (.var 3) (.var 2) (.var 0)) (sortTm (Nat.max (l + 1) v))))));
  let mret := tLams 5 (unitTm (Nat.max (l + 1) v));
  -- xs0 i1 P2 X3 ih4 E5 S6 q7
  let marg := tLams 8 (tApps (.var 4) (args5 (.fst (.var 0)) (.var 3) (.var 2) (.var 1) (.snd (.var 0))));
  -- xs0 i1 P2 X3 ih4 E5 j6 q7
  let mrec := tLams 8 (.sigma (tApps (.var 2) (args2 (.var 6) (.fst (.var 0))))
    (tApps (.var 5) (args4 (.var 4) (.var 3) (.var 2) (.snd (.var 1)))));
  -- xs0 i1 P2 X3 ih4 E5 j6 H7 q8
  let mhrec := tLams 9 (.sigma (.pi (.var 7) (tApps (.var 3) (args2 (.app (.var 7) (.var 0)) (.app (.fst (.var 1)) (.var 0)))))
    (tApps (.var 5) (args4 (.var 4) (.var 3) (.var 2) (.snd (.var 1)))));
  tLams 2 (.delim (Nat.max (l + 2) (v + 1)) P mret marg mrec mhrec (.var 0))

-- `fun I D X P f i xs => hyps …`: apply `f` to every recursive field
def hypsTm (l v : Nat) : Tm :=
  let tyL : Tm := .univ l;
  -- E0 D1 I2, then X, P, f, i, xs
  let P : Tm := .lam (.pi (.pi (.var 2) tyL) (.pi (.pi (.var 3) (.pi (.app (.var 1) (.var 0)) (sortTm v)))
    (.pi (.pi (.var 4) (.pi (.app (.var 2) (.var 0)) (tApps (.var 2) (args2 (.var 1) (.var 0)))))
      (.pi (.var 5) (.pi (interpApp l (.var 6) (.var 4) (.var 3) (.var 0))
        (tApps (allTm l v) (args6 (.var 7) (.var 5) (.var 4) (.var 3) (.var 1) (.var 0))))))));
  let mret := tLams 6 .star;
  -- xs0 i1 f2 P3 X4 ih5 E6 S7 q8
  let marg := tLams 9 (tApps (.var 5) (args6 (.fst (.var 0)) (.var 4) (.var 3) (.var 2) (.var 1) (.snd (.var 0))));
  -- xs0 i1 f2 P3 X4 ih5 E6 j7 q8
  let mrec := tLams 9 (.pair (tApps (.var 2) (args2 (.var 7) (.fst (.var 0))))
    (tApps (.var 5) (args5 (.var 4) (.var 3) (.var 2) (.var 1) (.snd (.var 0)))));
  -- xs0 i1 f2 P3 X4 ih5 E6 j7 H8 q9
  let mhrec := tLams 10 (.pair (.lam (tApps (.var 3) (args2 (.app (.var 8) (.var 0)) (.app (.fst (.var 1)) (.var 0)))))
    (tApps (.var 5) (args5 (.var 4) (.var 3) (.var 2) (.var 1) (.snd (.var 0)))));
  tLams 2 (.delim (Nat.max (l + 2) (v + 1)) P mret marg mrec mhrec (.var 0))

-- `fun I D X Y f i xs => map …`: apply `f` to every recursive field
def mapTm (l : Nat) : Tm :=
  let tyL : Tm := .univ l;
  -- E0 D1 I2, then X, Y, f, i, xs
  let P : Tm := .lam (.pi (.pi (.var 2) tyL) (.pi (.pi (.var 3) tyL)
    (.pi (.pi (.var 4) (.pi (.app (.var 2) (.var 0)) (.app (.var 2) (.var 1))))
      (.pi (.var 5) (.pi (interpApp l (.var 6) (.var 4) (.var 3) (.var 0)) (interpApp l (.var 7) (.var 5) (.var 3) (.var 1)))))));
  let mret := tLams 6 (.var 0);
  -- xs0 i1 f2 Y3 X4 ih5 E6 S7 q8
  let marg := tLams 9 (.pair (.fst (.var 0))
    (tApps (.var 5) (args6 (.fst (.var 0)) (.var 4) (.var 3) (.var 2) (.var 1) (.snd (.var 0)))));
  -- xs0 i1 f2 Y3 X4 ih5 E6 j7 q8
  let mrec := tLams 9 (.pair (tApps (.var 2) (args2 (.var 7) (.fst (.var 0))))
    (tApps (.var 5) (args5 (.var 4) (.var 3) (.var 2) (.var 1) (.snd (.var 0)))));
  -- xs0 i1 f2 Y3 X4 ih5 E6 j7 H8 q9
  let mhrec := tLams 10 (.pair (.lam (tApps (.var 3) (args2 (.app (.var 8) (.var 0)) (.app (.fst (.var 1)) (.var 0)))))
    (tApps (.var 5) (args5 (.var 4) (.var 3) (.var 2) (.var 1) (.snd (.var 0)))));
  tLams 2 (.delim (l + 2) P mret marg mrec mhrec (.var 0))

-- the size of a constructor's fields: `↑s ↦ s`, `∞ ↦ ∞`
def sizePred (sz : Val) : Option Val := match whnf sz with
  | .vszInf => .some .vszInf
  | .vszSuc s => .some s
  | _ => .none
-- Regularity (`cast A A e t ↦ t` for any proof `e`) is off: with an impredicative `Prop`
-- and proof irrelevance it makes checking loop (D1, Abel–Coquand). `.true` restores
-- it, as `--regularity full` does in the Lean kernel.
def kernelRegularity : Bool := .false
-- (P2) proofs are never evaluated (`Globals.lazyProofs` in the Lean kernel): a proof
-- position (`coe`'s equation, `subst`'s two proofs) is suspended (`Head.hprf`), and a cast
-- between propositions is stuck. `.false` is the old behaviour (the evaluator runs
-- proofs), kept for the transition.
def kernelLazyProofs : Bool := .true

-- **Exercise 14.1.** Evaluation, application and projections (`eval`, `vApp`, `vFst`,
-- `vSnd` in `Eval.lean`).
-- might `t` mention the variable `i` (at the top: index `i`)? conservative: the forms
-- not listed might
def usesVar : Nat → Tm → Bool
  | i, .var j => Nat.beq i j
  | i, .pi a b => Bool.or (usesVar i a) (usesVar (i + 1) b)
  | i, .piq _ a b => Bool.or (usesVar i a) (usesVar (i + 1) b)
  | i, .sigma a b => Bool.or (usesVar i a) (usesVar (i + 1) b)
  | i, .sigmaq _ a b => Bool.or (usesVar i a) (usesVar (i + 1) b)
  | i, .lam b => usesVar (i + 1) b
  | i, .app f a => Bool.or (usesVar i f) (usesVar i a)
  | i, .fst p => usesVar i p
  | i, .snd p => usesVar i p
  | i, .pair a b => Bool.or (usesVar i a) (usesVar i b)
  | i, .con x => usesVar i x
  | i, .ulift _ A => usesVar i A
  | i, .up a => usesVar i a
  | i, .down t => usesVar i t
  | i, .mu _ I D x => Bool.or (usesVar i I) (Bool.or (usesVar i D) (usesVar i x))
  | i, .eq A a b => Bool.or (usesVar i A) (Bool.or (usesVar i a) (usesVar i b))
  | i, .const _ _ _ _ _ => .false
  | i, .axiomC _ _ => .false
  | i, .univ _ => .false
  | i, .prop => .false
  | i, .sortL _ => .false
  | i, .unit _ => .false
  | i, .empty _ => .false
  | i, .ptrue => .false
  | i, .pfalse => .false
  | i, .star => .false
  | i, .enum _ => .false
  | i, .tag _ _ => .false
  | i, .size => .false
  | i, .szInf => .false
  | _, _ => .true

-- `1 +` the largest level of a variable in a value (`0` if none). `sameVal` (regularity,
-- `vCastW`) quotes at this level, so that every variable gets its own index. A closure counts only
-- the entries of its environment that its body might mention (`usesVar`).
mutual
def lvlBound : Val → Nat
  | .vsort _ => 0
  | .vpi _ a env b _ => Nat.max (lvlBound a) (envBound 1 env b)
  | .vlam env b => envBound 1 env b
  | .vsigma _ a env b _ => Nat.max (lvlBound a) (envBound 1 env b)
  | .vpair a b => Nat.max (lvlBound a) (lvlBound b)
  | .vunit _ => 0
  | .vtt => 0
  | .vempty _ => 0
  | .venum _ => 0
  | .vtag _ _ => 0
  | .vdesc _ I => lvlBound I
  | .vdret i => lvlBound i
  | .vdarg S E => Nat.max (lvlBound S) (lvlBound E)
  | .vdrec j E => Nat.max (lvlBound j) (lvlBound E)
  | .vdhrec H j E => Nat.max (lvlBound H) (Nat.max (lvlBound j) (lvlBound E))
  | .vmu _ I D i sz => Nat.max (Nat.max (lvlBound I) (lvlBound D)) (Nat.max (lvlBound i) (lvlBound sz))
  | .vsize => 0
  | .vszInf => 0
  | .vszSuc sz => lvlBound sz
  | .vsizeLt sz => lvlBound sz
  | .vcon x => lvlBound x
  | .vnu _ I D i sz => Nat.max (Nat.max (lvlBound I) (lvlBound D)) (Nat.max (lvlBound i) (lvlBound sz))
  | .vcocon x => lvlBound x
  | .vscofix _ I D A f sz i a => Nat.max (Nat.max (Nat.max (lvlBound I) (lvlBound D)) (Nat.max (lvlBound A) (lvlBound f)))
      (Nat.max (Nat.max (lvlBound sz) (lvlBound i)) (lvlBound a))
  | .vcoit _ I D S st i s => Nat.max (Nat.max (Nat.max (lvlBound I) (lvlBound D)) (Nat.max (lvlBound S) (lvlBound st)))
      (Nat.max (lvlBound i) (lvlBound s))
  | .vglued h sp _ => Nat.max (headBound h) (spineBound sp)
  | .vne h sp => Nat.max (headBound h) (spineBound sp)
  | .vulift _ A => lvlBound A
  | .vup a => lvlBound a
-- the entries of `env` (the first at index `i` of `b`) that `b` might mention
def envBound : Nat → Env → Tm → Nat
  | _, .nil, _ => 0
  | i, .cons v rest, b => Nat.max (match usesVar i b with
    | .true => lvlBound v
    | .false => 0) (envBound (i + 1) rest b)
def branchesBound : Env → Tms → Nat
  | _, .tnil => 0
  | env, .tcons b rest => Nat.max (envBound 0 env b) (branchesBound env rest)
def headBound : Head → Nat
  | .hvar x => x + 1
  | .heq A a b => Nat.max (lvlBound A) (Nat.max (lvlBound a) (lvlBound b))
  | .heqTy A B => Nat.max (lvlBound A) (lvlBound B)
  | .hcast A B e t => Nat.max (Nat.max (lvlBound A) (lvlBound B)) (Nat.max (lvlBound e) (lvlBound t))
  | .hrefl A a => Nat.max (lvlBound A) (lvlBound a)
  | .hreflTy X => lvlBound X
  | .htransp A a P p b e => Nat.max (Nat.max (lvlBound A) (lvlBound a))
      (Nat.max (Nat.max (lvlBound P) (lvlBound p)) (Nat.max (lvlBound b) (lvlBound e)))
  | .hconst _ _ _ _ _ => 0
  | .haxiom _ _ => 0
  | .hprf _ env t => envBound 0 env t
def spineBound : Spine → Nat
  | .snil => 0
  | .sapp sp a => Nat.max (spineBound sp) (lvlBound a)
  | .sfst sp => spineBound sp
  | .ssnd sp => spineBound sp
  | .secase sp env m bs => Nat.max (spineBound sp) (Nat.max (envBound 1 env m) (branchesBound env bs))
  | .sabsurd sp m => Nat.max (spineBound sp) (lvlBound m)
  | .sdelim sp _ P a b c d => Nat.max (spineBound sp)
      (Nat.max (Nat.max (lvlBound P) (lvlBound a)) (Nat.max (Nat.max (lvlBound b) (lvlBound c)) (lvlBound d)))
  | .sind sp _ I D _ P m i => Nat.max (spineBound sp)
      (Nat.max (Nat.max (lvlBound I) (lvlBound D)) (Nat.max (lvlBound P) (Nat.max (lvlBound m) (lvlBound i))))
  | .ssfix sp _ I D _ P f sz i => Nat.max (spineBound sp)
      (Nat.max (Nat.max (lvlBound I) (lvlBound D)) (Nat.max (Nat.max (lvlBound P) (lvlBound f)) (Nat.max (lvlBound sz) (lvlBound i))))
  | .sscase sp _ I D _ P m sz i => Nat.max (spineBound sp)
      (Nat.max (Nat.max (lvlBound I) (lvlBound D)) (Nat.max (Nat.max (lvlBound P) (lvlBound m)) (Nat.max (lvlBound sz) (lvlBound i))))
  | .sout sp => spineBound sp
  | .sdown sp => spineBound sp
end

mutual
def eval : Env → Tm → Val
  --<sol
  | env, .var i => lookup env i
  | _, .univ n => .vsort (.lnum (n + 1))
  | _, .prop => .vsort (.lnum 0)
  | env, .pi a b => .vpi .qw (eval env a) env b .none
  | env, .piq q a b => .vpi q (eval env a) env b .none
  | env, .sigmaq q a b => .vsigma q (eval env a) env b .none
  | env, .letq _ _ v b => eval (.cons (eval env v) env) b
  | env, .lam b => .vlam env b
  | env, .app f a => vapp (eval env f) (eval env a)
  | env, .letE _ v b => eval (.cons (eval env v) env) b
  | env, .ann t _ => eval env t
  | env, .sorted l t => withSort l (eval env t)
  | env, .sigma a b => .vsigma .qw (eval env a) env b .none
  | env, .pair a b => .vpair (eval env a) (eval env b)
  | env, .fst p => vfst (eval env p)
  | env, .snd p => vsnd (eval env p)
  | _, .unit n => .vunit (n + 1)
  | _, .star => .vtt
  | _, .empty n => .vempty (n + 1)
  | _, .ptrue => .vunit 0
  | _, .pfalse => .vempty 0
  | env, .exfalso m t => match whnf (eval env t) with
    | .vne h sp => .vne h (.sabsurd sp (eval env m))
    | v => v
  | _, .enum k => .venum k
  | _, .tag k i => .vtag k i
  | env, .ecase m s bs => match whnf (eval env s) with
    | .vtag _ i => eval env (tmsNth bs i)
    | .vne h sp => .vne h (.secase sp env m bs)
    | v => v
  | env, .eq A a b => vEq (eval env A) (eval env a) (eval env b)
  | env, .eqTy A B => vEqType (eval env A) (eval env B)
  | env, .coe A B e t =>
    let vA := eval env A;
    let vB := eval env B;
    vCast vA vB (suspend env e (memo (fun _ => vEqType vA vB))) (eval env t)
  | env, .eqRefl A a => .vne (.hrefl (eval env A) (eval env a)) .snil
  | env, .tyRefl X => .vne (.hreflTy (eval env X)) .snil
  | env, .subst A a P p b e =>
    let vA := eval env A;
    let va := eval env a;
    let vP := eval env P;
    let vb := eval env b;
    .vne (.htransp vA va vP (suspend env p (memo (fun _ => vapp (vapp vP va) (.vne (.hrefl vA va) .snil)))) vb
      (suspend env e (memo (fun _ => vEq vA va vb)))) .snil
  | env, .descr l I => .vdesc l (eval env I)
  | env, .dret i => .vdret (eval env i)
  | env, .darg S D => .vdarg (eval env S) (eval env D)
  | env, .drec j D => .vdrec (eval env j) (eval env D)
  | env, .dhrec H j D => .vdhrec (eval env H) (eval env j) (eval env D)
  | env, .delim v P a b c h D =>
    vDelim v (eval env P) (eval env a) (eval env b) (eval env c) (eval env h) (eval env D)
  | env, .mu l I D i => .vmu l (eval env I) (eval env D) (eval env i) .vszInf
  | env, .mus l I D i sz => .vmu l (eval env I) (eval env D) (eval env i) (eval env sz)
  | _, .size => .vsize
  | _, .szInf => .vszInf
  | env, .szSuc sz => .vszSuc (eval env sz)
  | env, .sizeLt sz => .vsizeLt (eval env sz)
  | env, .sfix l I D v P f sz i x =>
    vSfix l (eval env I) (eval env D) v (eval env P) (eval env f) (eval env sz) (eval env i) (eval env x)
  | env, .scase l I D v P m sz i x =>
    vScase l (eval env I) (eval env D) v (eval env P) (eval env m) (eval env sz) (eval env i) (eval env x)
  | env, .con x => .vcon (eval env x)
  | env, .nu l I D i sz => .vnu l (eval env I) (eval env D) (eval env i) (eval env sz)
  | env, .out x => vOut (eval env x)
  | env, .cocon x => .vcocon (eval env x)
  | env, .scofix l I D A f sz i a =>
    .vscofix l (eval env I) (eval env D) (eval env A) (eval env f) (eval env sz) (eval env i) (eval env a)
  | env, .coit l I D S st i x =>
    .vcoit l (eval env I) (eval env D) (eval env S) (eval env st) (eval env i) (eval env x)
  | env, .ind l I D v P m i x =>
    vInd l (eval env I) (eval env D) v (eval env P) (eval env m) (eval env i) (eval env x)
  | _, .sortL l => .vsort l
  | _, .const n ps ls v ty => .vglued (.hconst n ps ls v ty) .snil (memo (fun _ => eval .nil (substIfAny ps ls v)))
  | _, .axiomC n ty => .vne (.haxiom n ty) .snil
  | env, .ulift l A => .vulift l (eval env A)
  | env, .up a => .vup (eval env a)
  | env, .down t => vdown (eval env t)
  --|ex
  --| | _, _ => .vsort (.lnum 0)
  --sol>
-- (P2) a proof position: suspended, never evaluated (`suspend` in `Eval.lean`)
def suspend (env : Env) (t : Tm) (ty : Unit → Val) : Val := match kernelLazyProofs with
  | .true => .vne (.hprf ty env t) .snil
  | .false => eval env t
-- (P2) the eliminations of a proof, applied to its value (for reading it back)
def forceSp : Val → Spine → Val
  | v, .snil => v
  | v, .sapp sp a => vapp (forceSp v sp) a
  | v, .sfst sp => vfst (forceSp v sp)
  | v, .ssnd sp => vsnd (forceSp v sp)
  | v, .sdown sp => vdown (forceSp v sp)
  | v, .sabsurd sp m => match whnf (forceSp v sp) with
    | .vne h sp' => .vne h (.sabsurd sp' m)
    | w => w
  | v, _ => v
-- (P2) the eliminations of a proof from its last `absurd` on (`.none`: there is none).
-- Past an `absurd` the value need not be a proof (`exfalso M p : M`, for any `M`).
def fromAbsurd : Spine → Option Spine
  | .snil => .none
  | .sabsurd _ m => .some (.sabsurd .snil m)
  | .sapp sp a => match fromAbsurd sp with
    | .some r => .some (.sapp r a)
    | .none => .none
  | .sfst sp => match fromAbsurd sp with
    | .some r => .some (.sfst r)
    | .none => .none
  | .ssnd sp => match fromAbsurd sp with
    | .some r => .some (.ssnd r)
    | .none => .none
  | .secase sp env m bs => match fromAbsurd sp with
    | .some r => .some (.secase r env m bs)
    | .none => .none
  | .sdelim sp v P a b c d => match fromAbsurd sp with
    | .some r => .some (.sdelim r v P a b c d)
    | .none => .none
  | .sind sp l I D v P m i => match fromAbsurd sp with
    | .some r => .some (.sind r l I D v P m i)
    | .none => .none
  | .ssfix sp l I D v P f s i => match fromAbsurd sp with
    | .some r => .some (.ssfix r l I D v P f s i)
    | .none => .none
  | .sscase sp l I D v P m s i => match fromAbsurd sp with
    | .some r => .some (.sscase r l I D v P m s i)
    | .none => .none
  | .sout sp => match fromAbsurd sp with
    | .some r => .some (.sout r)
    | .none => .none
  | .sdown sp => match fromAbsurd sp with
    | .some r => .some (.sdown r)
    | .none => .none
def vapp : Val → Val → Val
  | .vglued h sp v, a => .vglued h (.sapp sp a) (memo (fun _ => vapp (v ()) a))  -- (given) glued stays glued
  --<sol
  | .vlam env b, a => eval (.cons a env) b
  | .vne h sp, a => .vne h (.sapp sp a)
  | v, _ => v
  --|ex
  --| | v, _ => v
  --sol>
def vfst : Val → Val
  | .vglued h sp v => .vglued h (.sfst sp) (memo (fun _ => vfst (v ())))  -- (given)
  --<sol
  | .vpair a _ => a
  | .vne h sp => .vne h (.sfst sp)
  | v => v
  --|ex
  --| | v => v
  --sol>
def vsnd : Val → Val
  | .vglued h sp v => .vglued h (.ssnd sp) (memo (fun _ => vsnd (v ())))  -- (given)
  --<sol
  | .vpair _ b => b
  | .vne h sp => .vne h (.ssnd sp)
  | v => v
  --|ex
  --| | v => v
  --sol>
-- (Q4) `down (up a) ↦ a`
def vdown : Val → Val
  | .vglued h sp v => .vglued h (.sdown sp) (memo (fun _ => vdown (v ())))
  | .vup a => a
  | .vne h sp => .vne h (.sdown sp)
  | v => v
-- `up` when `lifted` (a lifted tag, Q4)
def upIf (lifted : Bool) (v : Val) : Val := match lifted with
  | .true => .vup v
  | .false => v
-- `Desc.elim` (`vDelim` in `Eval.lean`): the methods get `tt` for the quantity
def vDelim (v : Nat) (P mret marg mrec mhrec D : Val) : Val := vDelimW v P mret marg mrec mhrec (whnf D)
def vDelimW : Nat → Val → Val → Val → Val → Val → Val → Val
  | _, _, mret, _, _, _, .vdret i => vapp mret i
  | v, P, mret, marg, mrec, mhrec, .vdarg S E =>
    -- fun s => Desc.elim … (E s);  inside: s0 E1 mhrec2 mrec3 marg4 mret5 P6
    let ih : Val := .vlam (.cons E (.cons mhrec (.cons mrec (.cons marg (.cons mret (.cons P .nil))))))
      (.delim v (.var 6) (.var 5) (.var 4) (.var 3) (.var 2) (.app (.var 1) (.var 0)));
    vapp (vapp (vapp (vapp marg .vtt) S) E) ih
  | v, P, mret, marg, mrec, mhrec, .vdrec j E =>
    vapp (vapp (vapp (vapp mrec .vtt) j) E) (vDelim v P mret marg mrec mhrec E)
  | v, P, mret, marg, mrec, mhrec, .vdhrec H j E =>
    vapp (vapp (vapp (vapp (vapp mhrec .vtt) H) j) E) (vDelim v P mret marg mrec mhrec E)
  | v, P, mret, marg, mrec, mhrec, .vne h sp => .vne h (.sdelim sp v P mret marg mrec mhrec)
  | _, _, _, _, _, _, d => d
-- induction (`vInd` in `Eval.lean`): on a constructor, the method applied to the payload
-- and its hypotheses (`ind` at each recursive field)
def vInd (l : Nat) (I D : Val) (v : Nat) (P m i x : Val) : Val := vIndW l I D v P m i (whnf x)
def vIndW : Nat → Val → Val → Nat → Val → Val → Val → Val → Val
  | l, I, D, v, P, m, i, .vcon xs =>
    -- fun j y => ind … j y;  inside: y0 j1 m2 P3 D4 I5
    let f : Val := .vlam (.cons m (.cons P (.cons D (.cons I .nil))))
      (.lam (.ind l (.var 5) (.var 4) v (.var 3) (.var 2) (.var 1) (.var 0)));
    let hyps := vapp (vapp (vapp (vapp (vapp (vapp (vapp (eval .nil (hypsTm l v)) I) D) (muFamily l I D)) P) f) i) xs;
    vapp (vapp (vapp m i) xs) hyps
  | l, I, D, v, P, m, i, .vne h sp => .vne h (.sind sp l I D v P m i)
  | _, _, _, _, _, _, _, x => x
-- sized recursion (`vSfix`): on a constructor, `f ∞ rec i x`, where `rec j i y` recurses
def vSfix (l : Nat) (I D : Val) (v : Nat) (P f sz i x : Val) : Val := match whnf x with
  | .vcon xs =>
    -- inside: y0 i1 j2 f3 P4 D5 I6
    let rec_ : Val := .vlam (.cons f (.cons P (.cons D (.cons I .nil))))
      (.lam (.lam (.sfix l (.var 6) (.var 5) v (.var 4) (.var 3) (.var 2) (.var 1) (.var 0))));
    vapp (vapp (vapp (vapp f .vszInf) rec_) i) (.vcon xs)
  | .vne h sp => .vne h (.ssfix sp l I D v P f sz i)
  | x' => x'
-- sized case analysis (`vScase`): `m ∞ i xs`
def vScase (l : Nat) (I D : Val) (v : Nat) (P m sz i x : Val) : Val := match whnf x with
  | .vcon xs => vapp (vapp (vapp m .vszInf) i) xs
  | .vne h sp => .vne h (.sscase sp l I D v P m sz i)
  | x' => x'
-- observation (`vOut`): run one step of an unfolding, re-wrapping the recursive fields
def vOut (x : Val) : Val := match whnf x with
  | .vcocon xs => xs
  | .vcoit l I D S st i s =>
    -- fun j s => coit … j s;  inside: s0 j1 step2 S3 D4 I5
    let f : Val := .vlam (.cons st (.cons S (.cons D (.cons I .nil))))
      (.lam (.coit l (.var 5) (.var 4) (.var 3) (.var 2) (.var 1) (.var 0)));
    vapp (vapp (vapp (vapp (vapp (vapp (vapp (eval .nil (mapTm l)) I) D) S) (nuFamily l I D)) f) i) (vapp (vapp st i) s)
  | .vscofix l I D A f _ i a =>
    -- fun i a => scofix … ∞ i a;  inside: a0 i1 f2 A3 D4 I5
    let rec_ : Val := .vlam (.cons f (.cons A (.cons D (.cons I .nil))))
      (.lam (.scofix l (.var 5) (.var 4) (.var 3) (.var 2) .szInf (.var 1) (.var 0)));
    vOut (vapp (vapp (vapp (vapp f .vszInf) rec_) i) a)
  | .vne h sp => outNe h sp
  | x' => x'
-- `⟦D⟧ X i`
def vInterp (l : Nat) (I D X i : Val) : Val :=
  vapp (vapp (vapp (vapp (eval .nil (interpTm l)) I) D) X) i
-- `fun j => μ D j`
def muFamily (l : Nat) (I D : Val) : Val :=
  .vlam (.cons D (.cons I .nil)) (.mu l (.var 2) (.var 1) (.var 0))
-- `fun j => μ D j` at size `s`
def muFamilyAt (l : Nat) (I D sz : Val) : Val :=
  .vlam (.cons sz (.cons D (.cons I .nil))) (.mus l (.var 3) (.var 2) (.var 0) (.var 1))
-- `fun j => ν D j`, and at size `s`
def nuFamily (l : Nat) (I D : Val) : Val :=
  .vlam (.cons D (.cons I .nil)) (.nu l (.var 2) (.var 1) (.var 0) .szInf)
def nuFamilyAt (l : Nat) (I D sz : Val) : Val :=
  .vlam (.cons sz (.cons D (.cons I .nil))) (.nu l (.var 3) (.var 2) (.var 0) (.var 1))
-- `a = b` at `A`, by `A` (`vEq` in `Eval.lean`; the closures are the same templates)
def vEq (A a b : Val) : Val := vEqW (whnf A) (whnf a) (whnf b)
def vEqW : Val → Val → Val → Val
  | .vpi _ a1 env b1 _, a, b => .vpi .qz a1 (.cons b (.cons a (.cons (.vlam env b1) .nil)))
      (.eq (.app (.var 3) (.var 0)) (.app (.var 2) (.var 0)) (.app (.var 1) (.var 0))) (.some (.lnum 0))
  | .vsigma _ a1 env b1 _, a, b =>
    let P : Tm := .lam (.lam (.eqTy (.app (.var 5) (.fst (.var 4))) (.app (.var 5) (.var 1))));
    let apB : Tm := .subst (.var 4) (.fst (.var 2)) P (.tyRefl (.app (.var 3) (.fst (.var 2)))) (.fst (.var 1)) (.var 0);
    .vsigma .qz (vEq a1 (vfst a) (vfst b)) (.cons b (.cons a (.cons (.vlam env b1) (.cons a1 .nil))))
      (.eq (.app (.var 3) (.fst (.var 1)))
        (.coe (.app (.var 3) (.fst (.var 2))) (.app (.var 3) (.fst (.var 1))) apB (.snd (.var 2))) (.snd (.var 1))) (.some (.lnum 0))
  | .vunit _, _, _ => .vunit 0
  | .vempty _, _, _ => .vunit 0
  -- (Q4) by the lifted type; a lifted proposition has one inhabitant
  | .vulift l A, a, b => match propSort (whnf A) with
    | .some p => match p with
      | .true => .vunit 0
      | .false => vEq A (vdown a) (vdown b)
    | .none => .vne (.heq (.vulift l A) a b) .snil
  | .venum k, .vtag _ i, .vtag _ j => match Nat.beq i j with
    | .true => .vunit 0
    | .false => .vempty 0
  | .vmu l I D i s, .vcon x, .vcon y => match eqPayload l I (muFamily l I D) i (whnf D) x y with
    | .some r => r
    | .none => .vne (.heq (.vmu l I D i s) (.vcon x) (.vcon y)) .snil
  | .vsort l, a, b => match lvlEquiv l (.lnum 0) with
    -- propositions: equal when equivalent
    | .true => vIff a b
    | .false => match lvlNeverZero l with
      | .true => vEqType a b
      | .false => .vne (.heq (.vsort l) a b) .snil
  -- (4g) equality of description codes, structurally
  | .vdesc l I, a, b => vEqDesc l I a b
  | A, a, b => .vne (.heq A a b) .snil
-- equality of two payloads, constructor by constructor (`vEqPayload` in `Eval.lean`):
-- `.none` when a tag is not known (the equation is stuck)
def eqPayload (l : Nat) (I X i : Val) : Val → Val → Val → Option Val
  | .vdret _, _, _ => .some (.vunit 0)
  | .vdarg S E, x, y => match whnf S with
    | .venum k => eqTags l I X i (.venum k) E .false (whnf (vfst x)) (whnf (vfst y)) x y
    -- (a lifted tag, Q4)
    | .vulift n A => match whnf A with
      | .venum k => eqTags l I X i (.vulift n (.venum k)) E .true (whnf (vdown (vfst x))) (whnf (vdown (vfst y))) x y
      | A' => .some (vEq (vInterp l I (.vdarg (.vulift n A') E) X i) x y)
    | S' => .some (vEq (vInterp l I (.vdarg S' E) X i) x y)
  | .vdrec j E, x, y => match eqPayload l I X i (whnf E) (vsnd x) (vsnd y) with
    | .some r => .some (withRest (vEq (vapp X j) (vfst x) (vfst y)) (whnf E) r)
    | .none => .none
  | .vdhrec H j E, x, y => match eqPayload l I X i (whnf E) (vsnd x) (vsnd y) with
    -- h0 j1 X2
    | .some r => .some (withRest (vEq (.vpi .qw H (.cons j (.cons X .nil)) (.app (.var 2) (.app (.var 1) (.var 0))) .none)
        (vfst x) (vfst y)) (whnf E) r)
    | .none => .none
  | _, _, _ => .none
-- (equal tags: the rest; different tags: the Σ rule, whose first component is `False`;
-- a lifted tag (Q4) is read through `down`, and `E` gets `up tag`)
def eqTags (l : Nat) (I X i S E : Val) (lifted : Bool) : Val → Val → Val → Val → Option Val
  | .vtag k a, .vtag _ b, x, y => match Nat.beq a b with
    | .true => eqPayload l I X i (whnf (vapp E (upIf lifted (.vtag k a)))) (vsnd x) (vsnd y)
    | .false => .some (vEq (vInterp l I (.vdarg S E) X i) x y)
  | _, _, _, _ => .none
-- `A × B` in `Prop`
def pairTy (A B : Val) : Val := .vsigma .qz A (.cons B .nil) (.var 1) (.some (.lnum 0))
-- a field's equation, and the rest's unless the rest is `ret` (`withRest` in `Eval.lean`)
def withRest (A E r : Val) : Val := match E with
  | .vdret _ => A
  | _ => pairTy A r
-- `A = B` between types (`vEqType`)
def vEqType (X Y : Val) : Val := vEqTypeP (whnf X) (whnf Y)
-- propositions are equal when equivalent; a proposition is never a type of another sort
def vEqTypeP (X Y : Val) : Val := match propSort X with
  | .some px => match propSort Y with
    | .some py => match px with
      | .true => match py with
        | .true => vIff X Y
        | .false => .vempty 0
      | .false => match py with
        | .true => .vempty 0
        | .false => vEqTypeW X Y
    | .none => .vne (.heqTy X Y) .snil
  | .none => .vne (.heqTy X Y) .snil
def vEqTypeW : Val → Val → Val
  | .vpi q a env b _, .vpi q' a' env' b' _ => match qEq q q' with
    | .false => .vempty 0
    | .true => .vsigma .qz (vEqType a' a)
      (.cons (.vlam env' b') (.cons (.vlam env b) (.cons a' (.cons a .nil))))
      (.sorted (.lnum 0) (.piq .qz (.var 3) (.eqTy (.app (.var 3) (.coe (.var 4) (.var 5) (.var 1) (.var 0))) (.app (.var 2) (.var 0))))) (.some (.lnum 0))
  | .vsigma q a env b _, .vsigma q' a' env' b' _ => match qEq q q' with
    | .false => .vempty 0
    | .true => .vsigma .qz (vEqType a a')
      (.cons (.vlam env' b') (.cons (.vlam env b) (.cons a' (.cons a .nil))))
      (.sorted (.lnum 0) (.piq .qz (.var 4) (.eqTy (.app (.var 3) (.var 0)) (.app (.var 2) (.coe (.var 5) (.var 4) (.var 1) (.var 0)))))) (.some (.lnum 0))
  | .vsort l, .vsort l' => match lvlEquiv l l' with
    | .true => .vunit 0
    | .false => match lvlClosed l with
      | .some _ => match lvlClosed l' with
        | .some _ => .vempty 0
        | .none => .vne (.heqTy (.vsort l) (.vsort l')) .snil
      | .none => .vne (.heqTy (.vsort l) (.vsort l')) .snil
  | .vunit l, .vunit l' => levels l l'
  | .vempty l, .vempty l' => levels l l'
  | .venum k, .venum k' => levels k k'
  | .vdesc l I, .vdesc l' I' => match Nat.beq l l' with
    | .true => vEqType I I'
    | .false => .vne (.heqTy (.vdesc l I) (.vdesc l' I')) .snil
  | .vmu l I D i s, .vmu l' I' D' i' s' => famEqTy (.vmu l I D i s) (.vmu l' I' D' i' s')
  -- (Q4) `ULift A = ULift B ↦ A = B`
  | .vulift l A, .vulift l' B => same l l' (vEqType A B) (.vempty 0)
  | .vnu l I D i s, .vnu l' I' D' i' s' => famEqTy (.vnu l I D i s) (.vnu l' I' D' i' s')
  | X, Y => match Bool.and (canonical X) (canonical Y) with
    | .true => .vempty 0
    | .false => .vne (.heqTy X Y) .snil
-- `cast A B e t` (`vCast`)
def vCast (A B e t : Val) : Val := vCastP (whnf A) (whnf B) e t
-- between propositions, `e` is an equivalence
def vCastP (A B e t : Val) : Val := match propSort A with
  | .some pa => match pa with
    | .true => match propSort B with
      | .some pb => match pb with
        -- (P2) the cast is a proof itself: nothing needs its value, so it is stuck
        | .true => match kernelLazyProofs with
          | .true => .vne (.hcast A B e t) .snil
          | .false => vapp (vfst e) t
        | .false => vCastW A B e t
      | .none => vCastW A B e t
    | .false => vCastW A B e t
  | .none => vCastW A B e t
def vCastW : Val → Val → Val → Val → Val
  | .vpi q1 a1 env1 b1 s1, .vpi q2 a2 env2 b2 s2, e, t => match qEq q1 q2 with
    | .false => .vne (.hcast (.vpi q1 a1 env1 b1 s1) (.vpi q2 a2 env2 b2 s2) e t) .snil
    | .true =>
      let c : Tm := .coe (.var 5) (.var 6) (.fst (.var 2)) (.var 0);
      .vlam (.cons t (.cons e (.cons (.vlam env2 b2) (.cons (.vlam env1 b1) (.cons a2 (.cons a1 .nil))))))
        (.coe (.app (.var 4) c) (.app (.var 3) (.var 0)) (.app (.snd (.var 2)) (.var 0)) (.app (.var 1) c))
  | .vsigma q1 a1 env1 b1 s1, .vsigma q2 a2 env2 b2 s2, e, t => match qEq q1 q2 with
    | .false => .vne (.hcast (.vsigma q1 a1 env1 b1 s1) (.vsigma q2 a2 env2 b2 s2) e t) .snil
    | .true =>
      let t1 := vfst t;
      let c1 := vCast a1 a2 (vfst e) t1;
      .vpair c1 (vCast (eval (.cons t1 env1) b1) (eval (.cons c1 env2) b2) (vapp (vsnd e) t1) (vsnd t))
  | .vsort l, .vsort l', e, t => match lvlEquiv l l' with
    | .true => t
    | .false => .vne (.hcast (.vsort l) (.vsort l') e t) .snil
  | .vempty l, .vempty l', e, t => same l l' t (.vne (.hcast (.vempty l) (.vempty l') e t) .snil)
  | .vunit l, .vunit l', e, t => same l l' .vtt (.vne (.hcast (.vunit l) (.vunit l') e t) .snil)
  | .venum k, .venum k', e, t => same k k' t (.vne (.hcast (.venum k) (.venum k') e t) .snil)
  -- (Q4) through `down` (a lifted proposition is cast by the equivalence, in `vCastP`)
  | .vulift l A, .vulift l' B, e, t => same l l' (.vup (vCast A B e (vdown t))) (.vne (.hcast (.vulift l A) (.vulift l' B) e t) .snil)
  -- regularity at inert types (InReg, P1): equal ground inert types (`groundEqTy`, stable
  -- under substitution); full regularity (off, `kernelRegularity`) by `sameVal`
  | A, B, e, t => castReg A B e t
def castReg (A B e t : Val) : Val := match Bool.and kernelRegularity (sameVal A B) with
  | .true => t
  | .false => match groundEqTy 0 A B with
    | .true => t
    | .false => vCastData A B e t
-- an inert type (`inertTy` in `Eval.lean`): first-order data, where a cast between equal
-- types is the identity: `Enum`, `Unit`, `Σ`s of inert types, and `μ` types whose index
-- type and fields are inert (no `Prop` fields, functions or neutral types)
def inertTy (depth : Nat) (A : Val) : Bool := match Nat.lt depth 8 with
  | .false => .false
  | .true => inertW depth (whnf A)
def inertW (depth : Nat) : Val → Bool
  | .venum _ => .true
  | .vulift l A => match Nat.beq l 0 with
    | .true => .false
    | .false => inertTy (Nat.succ depth) A
  | .vunit l => match Nat.beq l 0 with
    | .true => .false
    | .false => .true
  | .vsigma _ a env b s => match s with
    | .some l => match lvlNeverZero l with
      | .true => match inertTy (Nat.succ depth) a with
        | .true => inertTy (Nat.succ depth) (eval (.cons (fresh (Nat.add 100000 depth)) env) b)
        | .false => .false
      | .false => .false
    | .none => .false
  | .vmu _ I D _ _ => match inertTy (Nat.succ depth) I with
    | .true => inertDesc (Nat.succ depth) D
    | .false => .false
  | _ => .false
def inertDesc (depth : Nat) (D : Val) : Bool := match Nat.lt depth 8 with
  | .false => .false
  | .true => inertDescW depth (whnf D)
def inertDescW (depth : Nat) : Val → Bool
  | .vdret _ => .true
  | .vdrec _ E => inertDesc depth E
  | .vdarg S E => match whnf S with
    | .venum k => inertTags depth E .false k 0
    | .vulift n A => match whnf A with
      | .venum k => inertTags depth E .true k 0
      | _ => match inertTy (Nat.succ depth) (.vulift n A) with
        | .true => inertDesc depth (vapp E (fresh (Nat.add 100050 depth)))
        | .false => .false
    | S' => match inertTy (Nat.succ depth) S' with
      | .true => inertDesc depth (vapp E (fresh (Nat.add 100050 depth)))
      | .false => .false
  | _ => .false
def inertTags (depth : Nat) (E : Val) (lifted : Bool) (k i : Nat) : Bool := match Nat.lt i k with
  | .false => .true
  | .true => match inertDesc depth (vapp E (upIf lifted (.vtag k i))) with
    | .true => inertTags depth E lifted k (Nat.succ i)
    | .false => .false
-- syntactic equality of values, quoted at a level above every variable in them
-- (`lvlBound`), so that different variables never quote alike
def sameVal (a b : Val) : Bool :=
  let l := Nat.max (lvlBound a) (lvlBound b);
  tmEq (quoteM .false l a) (quoteM .false l b)
-- Ground equality at inert types (`groundEqTy` in `Eval.lean`, P1): two inert types that
-- are equal and have no free variable in a relevant position. Values are compared by
-- their type (tags, constructors; `Unit` and propositions skipped; `Σ` by projections);
-- a neutral equals only itself, and only if it is an atom (a fresh constant for a variable
-- bound inside the comparison, with projections). So the answer is the same for
-- convertible inputs and doesn't flip from `true` under a substitution.
def groundAtomSp : Spine → Spine → Bool
  | .snil, .snil => .true
  | .sfst a, .sfst b => groundAtomSp a b
  | .ssnd a, .ssnd b => groundAtomSp a b
  | .sdown a, .sdown b => groundAtomSp a b
  | _, _ => .false
-- the `d`-th atom: a neutral with a reserved head (an axiom whose name starts with a
-- space, so it is no declaration), which can't collide with a variable of the context
def groundAtom (d : Nat) : Val := .vne (.haxiom (String.append " atom" (Nat.toString d)) .star) .snil
def isAtomName (n : String) : Bool := match n with
  | .mk cs => match cs with
    | .cons c _ => Nat.beq (Char.code c) 32
    | .nil => .false
def groundAtomEq : Val → Val → Bool
  | .vne (.haxiom x _) sp, .vne (.haxiom y _) sp' => match isAtomName x with
    | .true => Bool.and (kStrEq x y) (groundAtomSp sp sp')
    | .false => .false
  | _, _ => .false
def groundSizeEq (s s' : Val) : Bool := groundSizeW (whnf s) (whnf s')
def groundSizeW : Val → Val → Bool
  | .vszInf, .vszInf => .true
  | .vszSuc a, .vszSuc b => groundSizeEq a b
  | a, b => groundAtomEq a b
def groundEqTy (d : Nat) (A B : Val) : Bool := match Nat.lt d 64 with
  | .false => .false
  | .true => groundTyW d (whnf A) (whnf B)
def groundTyW (d : Nat) : Val → Val → Bool
  | .venum k, .venum k' => Nat.beq k k'
  | .vunit l, .vunit l' => Bool.and (Nat.lt 0 l) (Nat.beq l l')
  | .vulift l A, .vulift l' B => Bool.and (Bool.and (Nat.lt 0 l) (Nat.beq l l')) (groundEqTy (Nat.succ d) A B)
  | .vsigma q a env b _, .vsigma q' a' env' b' _ => match Bool.and (qEq q q') (groundEqTy (Nat.succ d) a a') with
    | .true => groundEqTy (Nat.succ d) (eval (.cons (groundAtom d) env) b) (eval (.cons (groundAtom d) env') b')
    | .false => .false
  | .vmu l I D i sz, .vmu l' I' D' i' sz' => match Bool.and (Nat.beq l l') (groundSizeEq sz sz') with
    | .true => match groundEqTy (Nat.succ d) I I' with
      | .true => match groundEqDesc (Nat.succ d) I D D' with
        | .true => groundEqVal I i i'
        | .false => .false
      | .false => .false
    | .false => .false
  | _, _ => .false
def groundEqDesc (d : Nat) (I D D' : Val) : Bool := match Nat.lt d 64 with
  | .false => .false
  | .true => groundDescW d I (whnf D) (whnf D')
def groundDescW (d : Nat) (I : Val) : Val → Val → Bool
  | .vdret j, .vdret j' => groundEqVal I j j'
  | .vdrec j E, .vdrec j' E' => Bool.and (groundEqVal I j j') (groundEqDesc d I E E')
  | .vdarg S E, .vdarg S' E' => match groundEqTy (Nat.succ d) S S' with
    | .true => groundArg d I (whnf S) E E'
    | .false => .false
  | _, _ => .false
-- the rest of an `arg`: branch by branch at a tag field, else under an atom
def groundArg (d : Nat) (I S E E' : Val) : Bool := match S with
  | .venum k => groundTags d I E E' .false k 0
  | .vulift n A => match whnf A with
    | .venum k => groundTags d I E E' .true k 0
    | _ => groundEqDesc (Nat.succ d) I (vapp E (groundAtom d)) (vapp E' (groundAtom d))
  | _ => groundEqDesc (Nat.succ d) I (vapp E (groundAtom d)) (vapp E' (groundAtom d))
def groundTags (d : Nat) (I E E' : Val) (lifted : Bool) (k i : Nat) : Bool := match Nat.lt i k with
  | .false => .true
  | .true => match groundEqDesc (Nat.succ d) I (vapp E (upIf lifted (.vtag k i))) (vapp E' (upIf lifted (.vtag k i))) with
    | .true => groundTags d I E E' lifted k (Nat.succ i)
    | .false => .false
def groundEqVal (T a b : Val) : Bool := groundValP (whnf T) (whnf a) (whnf b)
def groundValP (T a b : Val) : Bool := match propSort T with
  | .some p => match p with
    | .true => .true
    | .false => groundValW T a b
  | .none => groundValW T a b
def groundValW : Val → Val → Val → Bool
  | .vunit _, _, _ => .true
  | .venum _, .vtag _ i, .vtag _ j => Nat.beq i j
  | .venum _, a, b => groundAtomEq a b
  | .vsigma _ A env B _, a, b => match groundEqVal A (vfst a) (vfst b) with
    | .true => groundEqVal (eval (.cons (vfst a) env) B) (vsnd a) (vsnd b)
    | .false => .false
  | .vulift _ A, a, b => groundEqVal A (vdown a) (vdown b)
  | .vmu l I D i _, .vcon x, .vcon y => groundEqVal (vInterp l I D (muFamily l I D) i) x y
  | .vmu _ _ _ _ _, a, b => groundAtomEq a b
  | _, _, _ => .false
-- (4g) sizes equal as conversion decides it (`sizeEqTrue` in `Eval.lean`, `sizeEq`
-- below): any `↑ᵏ ∞` is `∞`, and `↑ᵏ x = ↑ᵐ y` when `k = m` and `x`, `y` are one variable
def szIsInf (s : Val) : Bool := match whnf s with
  | .vszInf => .true
  | .vszSuc t => szIsInf t
  | _ => .false
def szVar (s : Val) : Option Nat := match whnf s with
  | .vszSuc t => szVar t
  | .vne h sp => match h with
    | .hvar x => match sp with
      | .snil => .some x
      | _ => .none
    | _ => .none
  | _ => .none
def szSucs (s : Val) : Nat := match whnf s with
  | .vszSuc t => Nat.succ (szSucs t)
  | _ => 0
def sizeEqTrue (s s' : Val) : Bool := match Bool.and (szIsInf s) (szIsInf s') with
  | .true => .true
  | .false => match szVar s with
    | .some x => match szVar s' with
      | .some y => Bool.and (Nat.beq x y) (Nat.beq (szSucs s) (szSucs s'))
      | .none => .false
    | .none => .false
-- (4g) equality of description codes, by the constructors (`vEqDesc` in `Eval.lean`):
-- `ret j = ret j'` is `j = j'`; `arg S E = arg S' E'` is
-- `(e : S = S') × ((s : S) → E s = E' (cast e s))`; `rec`, `hrec` likewise with the rests
-- `E = E'`; different constructors `False`; a neutral stuck
def vEqDesc (l : Nat) (I D D' : Val) : Val := vEqDescW l I (whnf D) (whnf D')
def isDescCon : Val → Bool
  | .vdret _ => .true
  | .vdarg _ _ => .true
  | .vdrec _ _ => .true
  | .vdhrec _ _ _ => .true
  | _ => .false
-- `(e :0 S = S') × ((x :0 S) → F x = F' (cast S S' e x))` at type `T`
-- (inside `e`: e0 S1 S'2 F3 F'4 T5; inside `x`: one more)
def eqAlong (S S' F F' T : Val) : Val :=
  .vsigma .qz (vEqType S S') (.cons S (.cons S' (.cons F (.cons F' (.cons T .nil)))))
    (.sorted (.lnum 0) (.piq .qz (.var 1) (.eq (.var 6) (.app (.var 4) (.var 0)) (.app (.var 5) (.coe (.var 2) (.var 3) (.var 1) (.var 0)))))) (.some (.lnum 0))
-- `A × (E = E')` (inside `_`: _0 E1 E'2 I3)
def andRest (l : Nat) (I A E E' : Val) : Val :=
  .vsigma .qz A (.cons E (.cons E' (.cons I .nil))) (.eq (.descr l (.var 3)) (.var 1) (.var 2)) (.some (.lnum 0))
def vEqDescW (l : Nat) (I : Val) : Val → Val → Val
  | .vdret j, .vdret j' => vEq I j j'
  | .vdarg S E, .vdarg S' E' => eqAlong S S' E E' (.vdesc l I)
  | .vdrec j E, .vdrec j' E' => andRest l I (vEq I j j') E E'
  | .vdhrec H j E, .vdhrec H' j' E' => andRest l I (eqAlong H H' j j' I) E E'
  | D, D' => match Bool.and (isDescCon D) (isDescCon D') with
    | .true => .vempty 0
    | .false => .vne (.heq (.vdesc l I) D D') .snil
-- `(J : Sort (l+1)) × (D : Desc_l J) × J`, the type of a family's code (`famCodeTy`)
def famCodeTy (l : Nat) : Val :=
  .vsigma .qw (.vsort (.lnum (Nat.succ l))) .nil
    (.sorted (.lnum (Nat.succ (Nat.succ l))) (.sigmaq .qw (.descr l (.var 0)) (.var 1))) (.some (.lnum (Nat.succ (Nat.succ l))))
-- `μ I D i = μ I' D' i'` is `(I, D, i) = (I', D', i')` at `famCodeTy l` when the levels
-- agree and the sizes are equal by their heads; else stuck (`vEqType` in `Eval.lean`)
def famEqTy (X Y : Val) : Val := match X with
  | .vmu l I D i s => match Y with
    | .vmu l' I' D' i' s' => famEqW X Y l I D i s l' I' D' i' s'
    | _ => .vne (.heqTy X Y) .snil
  | .vnu l I D i s => match Y with
    | .vnu l' I' D' i' s' => famEqW X Y l I D i s l' I' D' i' s'
    | _ => .vne (.heqTy X Y) .snil
  | _ => .vne (.heqTy X Y) .snil
def famEqW (X Y : Val) (l : Nat) (I D i s : Val) (l' : Nat) (I' D' i' s' : Val) : Val :=
  match Bool.and (Nat.beq l l') (sizeEqTrue s s') with
  | .false => .vne (.heqTy X Y) .snil
  | .true => vEq (famCodeTy l) (.vpair I (.vpair D i)) (.vpair I' (.vpair D' i'))
-- `cast` at the data types, by the value (`vCastData` in `Eval.lean`)
def vCastData : Val → Val → Val → Val → Val
  | .vdesc l I, .vdesc l' I', e, t => match Nat.beq l l' with
    | .true => castDesc l I I' e (whnf t)
    | .false => .vne (.hcast (.vdesc l I) (.vdesc l' I') e t) .snil
  | .vmu l I D i sz, .vmu l' I' D' i' sz', e, t => castMu (.vmu l I D i sz) (.vmu l' I' D' i' sz') e t
  | .vnu l I D i sz, .vnu l' I' D' i' sz', e, t => castNu (.vnu l I D i sz) (.vnu l' I' D' i' sz') e t
  | A, B, e, t => .vne (.hcast A B e t) .snil
def castDesc (l : Nat) (I I' e : Val) : Val → Val
  | .vdret i => .vdret (vCast I I' e i)
  -- s0 E1 e2 I'3 I4
  | .vdarg S E => .vdarg S (.vlam (.cons E (.cons e (.cons I' (.cons I .nil))))
      (.coe (.descr l (.var 4)) (.descr l (.var 3)) (.var 2) (.app (.var 1) (.var 0))))
  | .vdrec j E => .vdrec (vCast I I' e j) (castDesc l I I' e (whnf E))
  -- h0 j1 e2 I'3 I4
  | .vdhrec H j E => .vdhrec H (.vlam (.cons j (.cons e (.cons I' (.cons I .nil))))
      (.coe (.var 4) (.var 3) (.var 2) (.app (.var 1) (.var 0)))) (castDesc l I I' e (whnf E))
  | d => .vne (.hcast (.vdesc l I) (.vdesc l I') e d) .snil
-- the payload types of a cast between two `μ` (or `ν`) types and their equation
-- (`famPayloadEq?` in `Eval.lean`)
def famAt (nu : Bool) (l : Nat) (I D sz : Val) : Val := match nu with
  | .true => nuFamilyAt l I D sz
  | .false => muFamilyAt l I D sz
def famTm (nu : Bool) (l : Nat) (I D i sz : Tm) : Tm := match nu with
  | .true => .nu l I D i sz
  | .false => .mus l I D i sz
def famPayload (A B e : Val) : Option PayEq := match A with
  | .vmu l I D i s => match B with
    | .vmu l' I' D' i' s' => famPayloadW .false l I D i s l' I' D' i' s' e
    | _ => .none
  | .vnu l I D i s => match B with
    | .vnu l' I' D' i' s' => famPayloadW .true l I D i s l' I' D' i' s' e
    | _ => .none
  | _ => .none
def famPayloadW (nu : Bool) (l : Nat) (I D i s : Val) (l' : Nat) (I' D' i' s' e : Val) : Option PayEq :=
  match Bool.and (Nat.beq l l') (sizeEqTrue s s') with
  | .false => .none
  | .true => match sizePred s with
    | .none => .none
    | .some sp =>
      let Xi := vInterp l I D (famAt nu l I D sp) i;
      let Xi' := vInterp l I' D' (famAt nu l I' D' sp) i';
      -- under `t _`: _0 t1 Xi2 sp3; under `k`: k0 _1 t2 Xi3 sp4
      let P : Val := .vlam (.cons Xi (.cons sp .nil))
        (.lam (.eqTy (.var 2) (interpApp l (.fst (.var 1)) (.fst (.snd (.var 1)))
          (.lam (famTm nu l (.fst (.var 2)) (.fst (.snd (.var 2))) (.var 0) (.var 4))) (.snd (.snd (.var 1))))));
      .some (.mk Xi Xi' (.vne (.htransp (famCodeTy l) (.vpair I (.vpair D i)) P (.vne (.hreflTy Xi) .snil) (.vpair I' (.vpair D' i')) e) .snil))
def castMu (A B e t : Val) : Val := match whnf t with
  | .vcon x => match famPayload A B e with
    | .some p => match p with
      | .mk Xi Xi' e' => .vcon (vCast Xi Xi' e' x)
    | .none => .vne (.hcast A B e t) .snil
  | _ => .vne (.hcast A B e t) .snil
def castNu (A B e t : Val) : Val := match whnf t with
  | .vcocon x => match famPayload A B e with
    | .some p => match p with
      | .mk Xi Xi' e' => .vcocon (vCast Xi Xi' e' x)
    | .none => .vne (.hcast A B e t) .snil
  | _ => .vne (.hcast A B e t) .snil
-- observing a cast between two `ν` types observes its argument
def outNe (h : Head) (sp : Spine) : Val := match sp with
  | .snil => match h with
    | .hcast A B e t => outCast A B e t
    | _ => .vne h (.sout sp)
  | _ => .vne h (.sout sp)
def outCast (A B e t : Val) : Val := match A with
  | .vnu _ _ _ _ _ => match famPayload A B e with
    | .some p => match p with
      | .mk Xi Xi' e' => vCast Xi Xi' e' (vOut t)
    | .none => .vne (.hcast A B e t) (.sout .snil)
  | _ => .vne (.hcast A B e t) (.sout .snil)

-- **Exercise 14.2.** Quotation (`quote` in `Eval.lean`): back to a term at depth `l`.
def quoteM (qm : Bool) : Nat → Val → Tm
  --<sol
  | _, .vsort l => match lvlClosed l with
    | .some n => match n with
      | .zero => .prop
      | .succ m => .univ m
    | .none => .sortL l
  | l, .vpi q a env b s => sortedTm s (piTm q (quoteM qm l a) (quoteM qm (l + 1) (eval (.cons (fresh l) env) b)))
  | l, .vlam env b => .lam (quoteM qm (l + 1) (eval (.cons (fresh l) env) b))
  | l, .vsigma q a env b s => sortedTm s (sigmaTm q (quoteM qm l a) (quoteM qm (l + 1) (eval (.cons (fresh l) env) b)))
  | l, .vpair a b => .pair (quoteM qm l a) (quoteM qm l b)
  | _, .vunit l => match l with
    | .zero => .ptrue
    | .succ n => .unit n
  | _, .vtt => .star
  | _, .vempty l => match l with
    | .zero => .pfalse
    | .succ n => .empty n
  | _, .venum k => .enum k
  | _, .vtag k i => .tag k i
  | l, .vdesc k I => .descr k (quoteM qm l I)
  | l, .vdret i => .dret (quoteM qm l i)
  | l, .vdarg S E => .darg (quoteM qm l S) (quoteM qm l E)
  | l, .vdrec j E => .drec (quoteM qm l j) (quoteM qm l E)
  | l, .vdhrec H j E => .dhrec (quoteM qm l H) (quoteM qm l j) (quoteM qm l E)
  | l, .vmu k I D i sz => match sz with
    | .vszInf => .mu k (quoteM qm l I) (quoteM qm l D) (quoteM qm l i)
    | _ => .mus k (quoteM qm l I) (quoteM qm l D) (quoteM qm l i) (quoteM qm l sz)
  | _, .vsize => .size
  | _, .vszInf => .szInf
  | l, .vszSuc sz => .szSuc (quoteM qm l sz)
  | l, .vsizeLt sz => .sizeLt (quoteM qm l sz)
  | l, .vcon x => .con (quoteM qm l x)
  | l, .vnu k I D i sz => .nu k (quoteM qm l I) (quoteM qm l D) (quoteM qm l i) (quoteM qm l sz)
  | l, .vcocon x => .cocon (quoteM qm l x)
  | l, .vscofix k I D A f sz i a =>
    .scofix k (quoteM qm l I) (quoteM qm l D) (quoteM qm l A) (quoteM qm l f) (quoteM qm l sz) (quoteM qm l i) (quoteM qm l a)
  | l, .vcoit k I D S st i s => .coit k (quoteM qm l I) (quoteM qm l D) (quoteM qm l S) (quoteM qm l st) (quoteM qm l i) (quoteM qm l s)
  -- (P2) a suspended proof, with its eliminations: evaluated (`.true`), or `()`. Erased,
  -- the eliminations from the last `absurd` on are kept, on `()`: past an `absurd` the
  -- value need not be a proof, and two different values must not read back alike
  | l, .vne (.hprf _ env t) sp => match qm with
    | .true => quoteM qm l (forceSp (eval env t) sp)
    | .false => match fromAbsurd sp with
      | .none => .star
      | .some r => quoteSpine qm l .star r
  | l, .vne h sp => quoteSpine qm l (quoteHead qm l h) sp
  | l, .vglued h sp _ => quoteSpine qm l (quoteHead qm l h) sp
  | l, .vulift k A => .ulift k (quoteM qm l A)
  | l, .vup a => .up (quoteM qm l a)
  --|ex
  --| | _, _ => .univ 0
  --sol>
def quoteSpine (qm : Bool) : Nat → Tm → Spine → Tm
  | _, h, .snil => h
  | l, h, .sapp sp a => .app (quoteSpine qm l h sp) (quoteM qm l a)
  | l, h, .sfst sp => .fst (quoteSpine qm l h sp)
  | l, h, .ssnd sp => .snd (quoteSpine qm l h sp)
  | l, h, .secase sp env m bs =>
    .ecase (quoteM qm (l + 1) (eval (.cons (fresh l) env) m)) (quoteSpine qm l h sp) (quoteBranches qm l env bs)
  | l, h, .sabsurd sp m => .exfalso (quoteM qm l m) (quoteSpine qm l h sp)
  | l, h, .sdelim sp v P a b c d =>
    .delim v (quoteM qm l P) (quoteM qm l a) (quoteM qm l b) (quoteM qm l c) (quoteM qm l d) (quoteSpine qm l h sp)
  | l, h, .sind sp k I D v P m i =>
    .ind k (quoteM qm l I) (quoteM qm l D) v (quoteM qm l P) (quoteM qm l m) (quoteM qm l i) (quoteSpine qm l h sp)
  | l, h, .ssfix sp k I D v P f sz i =>
    .sfix k (quoteM qm l I) (quoteM qm l D) v (quoteM qm l P) (quoteM qm l f) (quoteM qm l sz) (quoteM qm l i) (quoteSpine qm l h sp)
  | l, h, .sscase sp k I D v P m sz i =>
    .scase k (quoteM qm l I) (quoteM qm l D) v (quoteM qm l P) (quoteM qm l m) (quoteM qm l sz) (quoteM qm l i) (quoteSpine qm l h sp)
  | l, h, .sout sp => .out (quoteSpine qm l h sp)
  | l, h, .sdown sp => .down (quoteSpine qm l h sp)
def quoteHead (qm : Bool) : Nat → Head → Tm
  | l, .hvar x => .var (l - x - 1)
  | l, .heq A a b => .eq (quoteM qm l A) (quoteM qm l a) (quoteM qm l b)
  | l, .heqTy A B => .eqTy (quoteM qm l A) (quoteM qm l B)
  | l, .hcast A B e t => .coe (quoteM qm l A) (quoteM qm l B) (quoteM qm l e) (quoteM qm l t)
  | l, .hrefl A a => .eqRefl (quoteM qm l A) (quoteM qm l a)
  | l, .hreflTy X => .tyRefl (quoteM qm l X)
  | l, .htransp A a P p b e => .subst (quoteM qm l A) (quoteM qm l a) (quoteM qm l P) (quoteM qm l p) (quoteM qm l b) (quoteM qm l e)
  | _, .hconst n ps ls v ty => .const n ps ls v ty
  | _, .haxiom n ty => .axiomC n ty
  | l, .hprf _ env t => quoteM qm l (eval env t)  -- (not reached: `quoteM`'s case)
def quoteBranches (qm : Bool) : Nat → Env → Tms → Tms
  | _, _, .tnil => .tnil
  | l, env, .tcons b rest => .tcons (quoteM qm l (eval env b)) (quoteBranches qm l env rest)
end
-- **Reading back** a value: suspended proofs are evaluated, so that the term is a normal
-- form (which `infer` can check again). The kernel's own comparison of types (`sameVal`)
-- uses `quoteM .false`, which never evaluates a proof.
def quote (l : Nat) (v : Val) : Tm := quoteM .true l v

-- a binder's quantity, as ` :0 ` (ω is the default, ` : `)
def showQ : Q → String
  | .qz => " :0 "
  | .qo => " :1 "
  | .qw => " : "

-- the name of the variable at level `l`: from `names` (the outermost first), or `x<l>`
def nameFrom : List String → Nat → Nat → String
  | .nil, _, l => String.append "x" (Nat.toString l)
  | .cons n ns, k, l => match k with
    | .zero => n
    | .succ k' => nameFrom ns k' l
def nameAt (names : List String) (l : Nat) : String := nameFrom names l l

mutual
-- terms, printed with the variables named by level (`x0` is the outermost, unless
-- `names` names it)
def show (names : List String) : Nat → Tm → String
  | l, .var i => nameAt names (l - i - 1)
  | _, .univ n => String.append "U" (Nat.toString n)
  | _, .prop => "Prop"
  | l, .pi a b => String.append (String.append (String.append "(" (nameAt names l))
      (String.append " : " (show names l a))) (String.append ") → " (show names (l + 1) b))
  | l, .lam b => String.append (String.append "λ" (nameAt names l)) (String.append ". " (show names (l + 1) b))
  | l, .app f a => String.append (String.append "(" (show names l f)) (String.append " " (String.append (show names l a) ")"))
  | l, .letE t v b => String.append (String.append "let " (nameAt names l))
      (String.append (String.append " := " (show names l v)) (String.append "; " (show names (l + 1) b)))
  | l, .sorted _ t => show names l t
  | l, .ann t ty => String.append (String.append "(" (show names l t)) (String.append " : " (String.append (show names l ty) ")"))
  | l, .piq q a b => String.append (String.append (String.append "(" (nameAt names l))
      (String.append (showQ q) (show names l a))) (String.append ") → " (show names (l + 1) b))
  | l, .sigmaq q a b => String.append (String.append (String.append "(" (nameAt names l))
      (String.append (showQ q) (show names l a))) (String.append ") × " (show names (l + 1) b))
  | l, .letq _ t v b => show names l (.letE t v b)
  | l, .sigma a b => String.append (String.append (String.append "(" (nameAt names l))
      (String.append " : " (show names l a))) (String.append ") × " (show names (l + 1) b))
  | l, .pair a b => String.append (String.append "(" (show names l a)) (String.append ", " (String.append (show names l b) ")"))
  | l, .fst p => String.append (show names l p) ".1"
  | l, .snd p => String.append (show names l p) ".2"
  | _, .unit n => String.append "Unit" (Nat.toString n)
  | _, .star => "tt"
  | _, .empty n => String.append "Empty" (Nat.toString n)
  | _, .ptrue => "True"
  | _, .pfalse => "False"
  | l, .eq A a b => String.append (String.append (String.append "Eq(" (show names l A)) (String.append ", " (show names l a)))
      (String.append ", " (String.append (show names l b) ")"))
  | l, .eqTy A B => String.append (String.append "EqTy(" (show names l A)) (String.append ", " (String.append (show names l B) ")"))
  | l, .eqRefl A a => String.append (String.append "refl(" (show names l A)) (String.append ", " (String.append (show names l a) ")"))
  | l, .descr k I => String.append (String.append "Desc" (Nat.toString k)) (String.append "(" (String.append (show names l I) ")"))
  | l, .dret i => String.append (String.append "ret(" (show names l i)) ")"
  | l, .darg S E => String.append (String.append "arg(" (show names l S)) (String.append ", " (String.append (show names l E) ")"))
  | l, .drec j E => String.append (String.append "rec(" (show names l j)) (String.append ", " (String.append (show names l E) ")"))
  | l, .dhrec H j E => String.append (String.append (String.append "hrec(" (show names l H)) (String.append ", " (show names l j)))
      (String.append ", " (String.append (show names l E) ")"))
  | l, .delim v P a b c d D => String.append (String.append (String.append "elim(" (show names l P))
      (String.append ", " (show names l a))) (String.append (String.append (String.append ", " (show names l b))
        (String.append ", " (show names l c))) (String.append (String.append ", " (show names l d))
          (String.append ", " (String.append (show names l D) ")"))))
  | l, .mu k I D i => String.append (String.append (String.append "μ" (Nat.toString k)) (String.append "(" (show names l I)))
      (String.append (String.append ", " (show names l D)) (String.append ", " (String.append (show names l i) ")")))
  | l, .con x => String.append (String.append "con(" (show names l x)) ")"
  | l, .sfix _ _ _ _ P f sz i x => String.append (String.append (String.append "sfix(" (show names l P)) (String.append ", " (show names l f)))
      (String.append (String.append ", " (show names l sz)) (String.append (String.append ", " (show names l i)) (String.append ", " (String.append (show names l x) ")"))))
  | l, .scase _ _ _ _ P m sz i x => String.append (String.append (String.append "scase(" (show names l P)) (String.append ", " (show names l m)))
      (String.append (String.append ", " (show names l sz)) (String.append (String.append ", " (show names l i)) (String.append ", " (String.append (show names l x) ")"))))
  | _, .size => "Size"
  | _, .szInf => "∞"
  | l, .szSuc sz => String.append (String.append "↑(" (show names l sz)) ")"
  | l, .sizeLt sz => String.append (String.append "Size<(" (show names l sz)) ")"
  | l, .mus k I D i sz => String.append (String.append (String.append "μ" (Nat.toString k)) (String.append "(" (show names l I)))
      (String.append (String.append ", " (show names l D)) (String.append (String.append ", " (show names l i))
        (String.append ", " (String.append (show names l sz) ")"))))
  | l, .nu k I D i sz => String.append (String.append (String.append "ν" (Nat.toString k)) (String.append "(" (show names l I)))
      (String.append (String.append ", " (show names l D)) (String.append (String.append ", " (show names l i))
        (String.append ", " (String.append (show names l sz) ")"))))
  | l, .out x => String.append (String.append "out(" (show names l x)) ")"
  | l, .cocon x => String.append (String.append "cocon(" (show names l x)) ")"
  | l, .scofix _ _ _ A f sz i a => String.append (String.append (String.append "scofix(" (show names l A)) (String.append ", " (show names l f)))
      (String.append (String.append ", " (show names l sz)) (String.append (String.append ", " (show names l i)) (String.append ", " (String.append (show names l a) ")"))))
  | l, .coit _ _ _ S st i x => String.append (String.append (String.append "coit(" (show names l S)) (String.append ", " (show names l st)))
      (String.append (String.append ", " (show names l i)) (String.append ", " (String.append (show names l x) ")")))
  | _, .const n _ ls _ _ => String.append n (showLvls ls)
  | _, .sortL l => match lvlClosed l with
    | .some n => match n with
      | .zero => "Prop"
      | .succ m => String.append "U" (Nat.toString m)
    | .none => String.append (String.append "Sort(" (lvlShow l)) ")"
  | _, .axiomC n _ => n
  | l, .ind _ _ _ _ P m i x => String.append (String.append (String.append "ind(" (show names l P)) (String.append ", " (show names l m)))
      (String.append (String.append ", " (show names l i)) (String.append ", " (String.append (show names l x) ")")))
  | l, .tyRefl X => String.append (String.append "reflTy(" (show names l X)) ")"
  | l, .coe A B e t => String.append (String.append (String.append "cast(" (show names l A)) (String.append ", " (show names l B)))
      (String.append (String.append ", " (show names l e)) (String.append ", " (String.append (show names l t) ")")))
  | l, .subst A a P p b e => String.append (String.append (String.append "transp(" (show names l A)) (String.append ", " (show names l a)))
      (String.append (String.append (String.append ", " (show names l P)) (String.append ", " (show names l p)))
        (String.append (String.append ", " (show names l b)) (String.append ", " (String.append (show names l e) ")"))))
  | l, .exfalso m t => String.append (String.append "absurd(" (show names l m)) (String.append ", " (String.append (show names l t) ")"))
  | _, .enum k => String.append "Enum" (Nat.toString k)
  | l, .ulift k A => String.append (String.append (String.append "ULift" (Nat.toString k)) "(") (String.append (show names l A) ")")
  | l, .up a => show names l a
  | l, .down t => show names l t
  | _, .tag _ i => String.append "#" (Nat.toString i)
  | l, .ecase m s bs => String.append (String.append (String.append "case(" (show names (l + 1) m))
      (String.append ", " (show names l s))) (String.append (showBranches names l bs) ")")

-- the branches, each after `, `
def showBranches (names : List String) : Nat → Tms → String
  | _, .tnil => ""
  | l, .tcons b rest => String.append (String.append ", " (show names l b)) (showBranches names l rest)
end

-- the typing context: values of the variables, their types, the depth
-- (and whether we are in an erased position: a type, a proof, an argument to a `0`
-- binder, where erased fields may be projected)
inductive TCtx where
  | mk (env : Env) (types : Env) (lvl : Nat) (erased : Bool)
def TCtx.lvl : TCtx → Nat
  | .mk _ _ l _ => l
def TCtx.env : TCtx → Env
  | .mk e _ _ _ => e
def TCtx.types : TCtx → Env
  | .mk _ t _ _ => t
def TCtx.erased : TCtx → Bool
  | .mk _ _ _ x => x
def TCtx.erase (c : TCtx) : TCtx := match c with
  | .mk e t l _ => .mk e t l .true
def erasedIf (q : Q) (c : TCtx) : TCtx := match q with
  | .qz => TCtx.erase c
  | _ => c
-- a new variable of type `ty`
def TCtx.bind (c : TCtx) (ty : Val) : TCtx := match c with
  | .mk e t l x => .mk (.cons (fresh l) e) (.cons ty t) (l + 1) x
-- a new variable defined as `v`
def TCtx.define (c : TCtx) (v ty : Val) : TCtx := match c with
  | .mk e t l x => .mk (.cons v e) (.cons ty t) (l + 1) x

-- Usage (`Usage` in `Check.lean`): one quantity per variable, the innermost first.
def qadd : Q → Q → Q
  | .qz, b => b
  | a, .qz => a
  | _, _ => .qw
def qmul : Q → Q → Q
  | .qz, _ => .qz
  | _, .qz => .qz
  | .qo, b => b
  | a, .qo => a
  | .qw, .qw => .qw
-- may a variable declared `d` be used `u` times?
def qle (u d : Q) : Bool := Bool.or (qEq u d) (qEq d .qw)
-- the least quantity allowing both (two branches of a case)
def qjoin (a b : Q) : Q := match qEq a b with
  | .true => a
  | .false => .qw
-- (a usage list may stop early: the variables after its end are unused, so no usage at
-- all is the empty list, and building one as long as the context for every term was a
-- third of the kernel's allocations)
def uZeros (_ : Nat) : List Q := .nil
-- `n` variables, the one at index `i` used once
def uOne : Nat → List Q
  | .zero => .cons .qo .nil
  | .succ j => .cons .qz (uOne j)
def uSingle (_ i : Nat) : List Q := uOne i
def uAdd : List Q → List Q → List Q
  | .cons a r, .cons b r' => .cons (qadd a b) (uAdd r r')
  | u, .nil => u
  | .nil, u => u
def uScale (q : Q) : List Q → List Q
  | .nil => .nil
  | .cons a r => .cons (qmul q a) (uScale q r)
def uJoin : List Q → List Q → List Q
  | .cons a r, .cons b r' => .cons (qjoin a b) (uJoin r r')
  | u, .nil => u
  | .nil, u => u
-- leave a binder of quantity `q`: its own usage must fit
def popUsage (q : Q) : List Q → Option (List Q)
  | .nil => .some .nil
  | .cons used rest => match qle used q with
    | .true => .some rest
    | .false => .none

inductive TyRes where
  | ok (ty : Val) (u : List Q)
  | err (msg : String)

-- the size of an observation's fields: `↑s ↦ s`, anything else ↦ `∞`
def sizePredOrInf (sz : Val) : Val := match whnf sz with
  | .vszSuc s => s
  | _ => .vszInf

-- The type of a neutral, and the universe of a type (`typeSort?` in `Conv.lean`).
mutual
-- the type of the variable at level `x` after the eliminations `sp`
def typeOfNe : TCtx → Head → Spine → Val
  | c, h, .snil => headType c h
  | c, x, .sapp sp a => match whnf (typeOfNe c x sp) with
    | .vpi _ _ env cod _ => eval (.cons a env) cod
    | ty => ty
  | c, x, .sfst sp => match whnf (typeOfNe c x sp) with
    | .vsigma _ a _ _ _ => a
    | ty => ty
  | c, x, .ssnd sp => match whnf (typeOfNe c x sp) with
    | .vsigma _ _ env b _ => eval (.cons (vfst (.vne x sp)) env) b
    | ty => ty
  | _, x, .secase sp env m _ => eval (.cons (.vne x sp) env) m
  | _, _, .sabsurd _ m => m
  | _, h, .sdelim sp _ P _ _ _ _ => vapp P (.vne h sp)
  | _, h, .sind sp _ _ _ _ P _ i => vapp (vapp P i) (.vne h sp)
  | _, h, .ssfix sp _ _ _ _ P _ _ i => vapp (vapp P i) (.vne h sp)
  | _, h, .sscase sp _ _ _ _ P _ _ i => vapp (vapp P i) (.vne h sp)
  | c, x, .sout sp => match whnf (typeOfNe c x sp) with
    | .vnu l I D i sz => vInterp l I D (nuFamilyAt l I D (sizePredOrInf sz)) i
    | ty => ty
  | c, x, .sdown sp => match whnf (typeOfNe c x sp) with
    | .vulift _ A => A
    | ty => ty
-- the level of the universe a type lives in
def sortOf (c : TCtx) (ty : Val) : Option Lvl := sortOfW c (whnf ty)
def sortOfW : TCtx → Val → Option Lvl
  | c, .vpi _ a env b _ => match sortOf c a with
    | .some i => match sortOf (TCtx.bind c a) (eval (.cons (fresh (TCtx.lvl c)) env) b) with
      | .some j => .some (.limax i j)
      | .none => .none
    | .none => .none
  | c, .vsigma _ a env b _ => match sortOf c a with
    | .some i => match sortOf (TCtx.bind c a) (eval (.cons (fresh (TCtx.lvl c)) env) b) with
      | .some j => .some (.lmax i j)
      | .none => .none
    | .none => .none
  | _, .vsort l => .some (.lsucc l)
  | _, .vunit l => .some (.lnum l)
  | _, .vempty l => .some (.lnum l)
  | _, .venum _ => .some (.lnum 1)
  | _, .vdesc l _ => .some (.lnum (l + 2))
  | _, .vmu l _ _ _ _ => .some (.lnum (l + 1))
  | _, .vnu l _ _ _ _ => .some (.lnum (l + 1))
  | _, .vsize => .some (.lnum 1)
  | _, .vsizeLt _ => .some (.lnum 1)
  | _, .vulift l _ => .some (.lnum l)
  | c, .vne x sp => match whnf (typeOfNe c x sp) with
    | .vsort l => .some l
    | _ => .none
  | _, _ => .none
-- the type of a head
def headType : TCtx → Head → Val
  | c, .hvar x => lookup (TCtx.types c) (TCtx.lvl c - x - 1)
  | _, .heq _ _ _ => .vsort (.lnum 0)
  | _, .heqTy _ _ => .vsort (.lnum 0)
  | _, .hcast _ B _ _ => B
  | _, .hrefl A a => vEq A a a
  | _, .hreflTy X => vEqType X X
  | _, .htransp _ _ P _ b e => vapp (vapp P b) e
  | _, .hconst _ ps ls _ ty => eval .nil (substIfAny ps ls ty)
  | _, .haxiom _ ty => eval .nil ty
  | _, .hprf ty _ _ => ty ()
end

-- (without computing the whole sort: a Π type is a proposition when its codomain is,
-- as `imax i j` is `0` exactly when `j` is; `conv` asks this at every step)
mutual
def isProp (c : TCtx) (ty : Val) : Bool := isPropW c (whnf ty)
def isPropW : TCtx → Val → Bool
  | c, .vpi _ a env b _ => isProp (TCtx.bind c a) (eval (.cons (fresh (TCtx.lvl c)) env) b)
  | c, .vsigma _ a env b _ => Bool.and (isProp c a) (isProp (TCtx.bind c a) (eval (.cons (fresh (TCtx.lvl c)) env) b))
  | _, .vunit l => Nat.beq l 0
  | _, .vempty l => Nat.beq l 0
  | _, .vsort _ => .false
  | _, .vmu _ _ _ _ _ => .false
  | _, .vnu _ _ _ _ _ => .false
  | _, .venum _ => .false
  | _, .vdesc _ _ => .false
  | _, .vulift l _ => Nat.beq l 0
  | c, ty => match sortOfW c ty with
    | .some l => lvlEquiv l (.lnum 0)
    | .none => .false
end

-- the quantity binders of the method types: this kernel has no quantities, so `Unit`
def qTy : Tm := .unit 0
-- `P : Desc I → Sort v`
def delimMotiveTy (l v : Nat) (I : Val) : Val := .vpi .qw (.vdesc l I) .nil (sortTm v) .none
-- the types of `mret`, `marg`, `mrec`, `mhrec` (`delimMethodTys` in `Conv.lean`)
def delimMret (l : Nat) (I P : Val) : Val :=
  -- i0 P1 I2
  eval (.cons P (.cons I .nil)) (.pi (.var 1) (.app (.var 1) (.dret (.var 0))))
def delimMarg (l : Nat) (I P : Val) : Val :=
  eval (.cons P (.cons I .nil)) (.pi qTy (.pi (.univ l) (.pi (.pi (.var 0) (.descr l (.var 4)))
    (.pi (.pi (.var 1) (.app (.var 4) (.app (.var 1) (.var 0)))) (.app (.var 4) (.darg (.var 2) (.var 1)))))))
def delimMrec (l : Nat) (I P : Val) : Val :=
  eval (.cons P (.cons I .nil)) (.pi qTy (.pi (.var 2) (.pi (.descr l (.var 3))
    (.pi (.app (.var 3) (.var 0)) (.app (.var 4) (.drec (.var 2) (.var 1)))))))
def delimMhrec (l : Nat) (I P : Val) : Val :=
  eval (.cons P (.cons I .nil)) (.pi qTy (.pi (.univ l) (.pi (.pi (.var 0) (.var 4)) (.pi (.descr l (.var 4))
    (.pi (.app (.var 4) (.var 0)) (.app (.var 5) (.dhrec (.var 3) (.var 2) (.var 1))))))))

-- `P : (i : I) → μ D i → Sort v`
def indMotiveTy (l v : Nat) (I D : Val) : Val :=
  eval (.cons D (.cons I .nil)) (.pi (.var 1) (.pi (.mu l (.var 2) (.var 1) (.var 0)) (sortTm v)))
-- `m : (i : I) → (xs : ⟦D⟧ (μ D) i) → All D (μ D) P i xs → P i (con xs)`
def indMethodTy (l v : Nat) (I D P : Val) : Val :=
  -- i0 P1 D2 I3 ; xs0 i1 P2 D3 I4 ; ih0 xs1 i2 P3 D4 I5
  let X1 : Tm := .lam (.mu l (.var 4) (.var 3) (.var 0));
  let X2 : Tm := .lam (.mu l (.var 5) (.var 4) (.var 0));
  eval (.cons P (.cons D (.cons I .nil))) (.piq .qz (.var 2)
    (.pi (tApps (interpTm l) (args4 (.var 3) (.var 2) X1 (.var 0)))
      (.pi (tApps (allTm l v) (args6 (.var 4) (.var 3) X2 (.var 2) (.var 1) (.var 0)))
        (tApps (.var 3) (args2 (.var 2) (.con (.var 1)))))))

-- Sizes (`Conv.lean`): `∞`, or a size variable with a number of `↑`s
inductive SizeView where
  | inf (k : Nat)
  | var (x : Nat) (k : Nat)
  | other
def sizeView : Val → SizeView
  | .vszInf => .inf 0
  | .vszSuc sz => match sizeView sz with
    | .inf k => .inf (k + 1)
    | .var x k => .var x (k + 1)
    | .other => .other
  | .vne (.hvar x) .snil => .var x 0
  | .vglued _ _ v => sizeView (v ())
  | _ => .other
def sizeEq (a b : Val) : Bool := match sizeView a with
  | .inf _ => match sizeView b with
    | .inf _ => .true
    | _ => .false
  | .var x k => match sizeView b with
    | .var y m => Bool.and (Nat.beq k m) (Nat.beq x y)
    | _ => .false
  | .other => .false
def addSucs : Nat → Val → Val
  | .zero, sz => sz
  | .succ k, sz => .vszSuc (addSucs k sz)
-- `a ≤ b`: anything is below `∞`; `↑ᵏ x ≤ ↑ᵐ x` when `k ≤ m`; and `x : Size< u` gives
-- `↑ᵏ x ≤ b` when `↑ᵏ⁻¹ u ≤ b`
partial def sizeLe (c : TCtx) (a b : Val) : Bool := match sizeView b with
  | .inf _ => .true
  | vb => match sizeView a with
    | .var x k => Bool.or (match vb with
        | .var y m => Bool.and (Nat.le k m) (Nat.beq x y)
        | _ => .false)
      (match whnf (lookup (TCtx.types c) (TCtx.lvl c - x - 1)) with
       | .vsizeLt u => sizeLe c (addSucs (k - 1) u) b
       | _ => .false)
    | _ => .false
-- `a < b`: `↑a ≤ b`, except at `∞` (decision D2): `↑∞ = ∞`, so `↑a ≤ ∞` holds for every
-- `a`, `∞` included. Below `∞` are only `↑ᵏ x` for a variable `x : Size< u`.
def sizeBelow (c : TCtx) (a b : Val) : Bool := match sizeView b with
  | .inf _ => match sizeView a with
    | .var x _ => match whnf (lookup (TCtx.types c) (TCtx.lvl c - x - 1)) with
      | .vsizeLt _ => .true
      | _ => .false
    | _ => .false
  | _ => sizeLe c (.vszSuc a) b

-- `f : (s :0 Size) → ((j :0 Size< s) → (i : I) → (y : μ^j D i) → P i y) → (i : I) → (x : μ^s D i) → P i x`
def sfixFunTy (l : Nat) (I D P : Val) : Val :=
  eval (.cons P (.cons D (.cons I .nil))) (.piq .qz .size
    (.pi (.piq .qz (.sizeLt (.var 0))
        (.pi (.var 4) (.pi (.mus l (.var 5) (.var 4) (.var 0) (.var 1)) (tApps (.var 4) (args2 (.var 1) (.var 0))))))
      (.pi (.var 4) (.pi (.mus l (.var 5) (.var 4) (.var 0) (.var 2)) (tApps (.var 4) (args2 (.var 1) (.var 0)))))))
-- `m : (j :0 Size< s) → (i :0 I) → (xs : ⟦D⟧ (μ^j D) i) → P i (con xs)`
def scaseMethodTy (l : Nat) (I D P sz : Val) : Val :=
  eval (.cons sz (.cons P (.cons D (.cons I .nil)))) (.piq .qz (.sizeLt (.var 0)) (.piq .qz (.var 4)
    (.pi (tApps (interpTm l) (args4 (.var 5) (.var 4) (.lam (.mus l (.var 6) (.var 5) (.var 0) (.var 2))) (.var 0)))
      (tApps (.var 4) (args2 (.var 1) (.con (.var 0)))))))

-- `S : I → Type l`, the states of a coiteration (and `A`, the seeds of a corecursion)
def coitStateTy (l : Nat) (I : Val) : Val := .vpi .qw I .nil (.univ l) .none
-- `step : (i : I) → S i → ⟦D⟧ S i`
def coitStepTy (l : Nat) (I D S : Val) : Val :=
  -- i0 S1 D2 I3 ; s0 i1 S2 D3 I4
  eval (.cons S (.cons D (.cons I .nil)))
    (.pi (.var 2) (.pi (.app (.var 1) (.var 0)) (interpApp l (.var 4) (.var 3) (.var 2) (.var 1))))
-- `f : (s :0 Size) → ((i : I) → A i → ν^s D i) → (i : I) → A i → ν^{↑s} D i`
def scofixFunTy (l : Nat) (I D A : Val) : Val :=
  eval (.cons A (.cons D (.cons I .nil))) (.piq .qz .size
    (.pi (.pi (.var 3) (.pi (.app (.var 2) (.var 0)) (.nu l (.var 5) (.var 4) (.var 1) (.var 2))))
      (.pi (.var 4) (.pi (.app (.var 3) (.var 0)) (.nu l (.var 6) (.var 5) (.var 1) (.szSuc (.var 3)))))))

def andSame (a : Option Nat) (k : Nat → Option Nat) : Option Nat := match a with
  | .some n => k n
  | .none => .none
def fuelOk : Option Nat → Bool
  | .some _ => .true
  | .none => .false
-- Are two values the same, structurally, within a budget of nodes (`none` when it runs
-- out or they differ)? Cheap and allocation-free, unlike `conv`; a closure is the same
-- when its term and environment are.
mutual
def valSame : Nat → Val → Val → Option Nat
  | .zero, _, _ => .none
  | .succ n, a, b => match a with
    | .vne h sp => match b with
      | .vne h' sp' => andSame (headSame n h h') (fun k => spineSame k sp sp')
      | _ => .none
    | .vglued h sp _ => match b with
      | .vglued h' sp' _ => andSame (headSame n h h') (fun k => spineSame k sp sp')
      | _ => .none
    | .vlam e t => match b with
      | .vlam e' t' => match tmEq t t' with
        | .true => envSame n e e'
        | .false => .none
      | _ => .none
    | .vpi q x e t _ => match b with
      | .vpi q' x' e' t' _ => match Bool.and (qEq q q') (tmEq t t') with
        | .true => andSame (valSame n x x') (fun k => envSame k e e')
        | .false => .none
      | _ => .none
    | .vpair x y => match b with
      | .vpair x' y' => andSame (valSame n x x') (fun k => valSame k y y')
      | _ => .none
    | .vcon x => match b with
      | .vcon x' => valSame n x x'
      | _ => .none
    | .vtag k i => match b with
      | .vtag k' i' => match Bool.and (Nat.beq k k') (Nat.beq i i') with
        | .true => .some n
        | .false => .none
      | _ => .none
    | .venum k => match b with
      | .venum k' => match Nat.beq k k' with
        | .true => .some n
        | .false => .none
      | _ => .none
    | .vtt => match b with
      | .vtt => .some n
      | _ => .none
    | .vszInf => match b with
      | .vszInf => .some n
      | _ => .none
    | _ => .none
def envSame : Nat → Env → Env → Option Nat
  | .zero, _, _ => .none
  | .succ n, .nil, .nil => .some n
  | .succ n, .cons v r, .cons v' r' => andSame (valSame n v v') (fun k => envSame k r r')
  | _, _, _ => .none
def spineSame : Nat → Spine → Spine → Option Nat
  | .zero, _, _ => .none
  | .succ n, .snil, .snil => .some n
  | .succ n, .sapp sp a, .sapp sp' a' => andSame (spineSame n sp sp') (fun k => valSame k a a')
  | .succ n, .sfst sp, .sfst sp' => spineSame n sp sp'
  | .succ n, .ssnd sp, .ssnd sp' => spineSame n sp sp'
  | _, _, _ => .none
def headSame : Nat → Head → Head → Option Nat
  | n, .hvar x, .hvar y => match Nat.beq x y with
    | .true => .some n
    | .false => .none
  -- (the same constant at the same levels: by name alone, `d.{0}` and `d.{1}` were "the
  -- same", `convSpine`'s shortcut for a stuck `ecase` then identified two cases whose
  -- environments differed in a level instance, and that proved `False`:
  -- `wiz-notes/kernel-lint.md`, W1)
  | n, .hconst a _ ls _ _, .hconst b _ ls' _ _ => match Bool.and (kStrEq a b) (lvlsEq ls ls') with
    | .true => .some n
    | .false => .none
  | n, .haxiom a _, .haxiom b _ => match kStrEq a b with
    | .true => .some n
    | .false => .none
  | _, _, _ => .none
end

-- **Exercise 14.6.** Conversion (`conv` and `convTy` in `Conv.lean`): `conv c ty a b`
-- compares `a` and `b` at type `ty`. All proofs of a proposition are equal; functions
-- are compared by applying both to a fresh variable and pairs by their projections
-- (that is η); types structurally (`convTy`); anything else must be the same variable
-- with convertible eliminations (`convNe`).
mutual
def conv : TCtx → Val → Val → Val → Bool
  --<sol
  -- (proof irrelevance is checked at the other types only: at a Π type the comparison
  -- of the bodies, at a Σ type of the components, checks it again, and asking at every
  -- level made long Π types quadratic)
  | c, ty, a, b => match (match whnf ty with
      | .vpi _ _ _ _ _ => Bool.false
      | .vsigma _ _ _ _ _ => Bool.false
      | w => isPropW c w) with
    | .true => .true
    | .false => match whnf ty with
      | .vpi _ dom env cod _ =>
        let x := fresh (TCtx.lvl c);
        conv (TCtx.bind c dom) (eval (.cons x env) cod) (vapp a x) (vapp b x)
      | .vsigma _ ta env tb _ =>
        Bool.and (conv c ta (vfst a) (vfst b)) (conv c (eval (.cons (vfst a) env) tb) (vsnd a) (vsnd b))
      | .vunit _ => .true
      -- (Q4) η: compare the contents
      | .vulift _ A => conv c A (vdown a) (vdown b)
      | .vsort _ => convTy c a b
      | .vdesc l I => match whnf a with
        | .vdret i => match whnf b with
          | .vdret j => conv c I i j
          | _ => .false
        | .vdarg S E => match whnf b with
          | .vdarg S' E' => Bool.and (convTy c S S') (conv c (.vpi .qw S (.cons I .nil) (.descr l (.var 1)) .none) E E')
          | _ => .false
        | .vdrec j E => match whnf b with
          | .vdrec j' E' => Bool.and (conv c I j j') (conv c (.vdesc l I) E E')
          | _ => .false
        | .vdhrec H j E => match whnf b with
          | .vdhrec H' j' E' => Bool.and (convTy c H H')
              (Bool.and (conv c (.vpi .qw H (.cons I .nil) (.var 1) .none) j j') (conv c (.vdesc l I) E E'))
          | _ => .false
        | _ => convNe c a b
      | .vmu l I D i _ => match whnf a with
        | .vcon x => match whnf b with
          | .vcon y => conv c (vInterp l I D (muFamily l I D) i) x y
          | _ => .false
        | _ => convNe c a b
      | .vnu l I D i _ => match whnf a with
        | .vcocon x => match whnf b with
          | .vcocon y => conv c (vInterp l I D (nuFamily l I D) i) x y
          | _ => .false
        | .vscofix _ _ _ A f _ j x => match whnf b with
          | .vscofix _ _ _ A' f' _ j' x' => Bool.and (conv c (coitStateTy l I) A A')
              (Bool.and (conv c (scofixFunTy l I D A) f f') (Bool.and (conv c I j j') (conv c (vapp A j) x x')))
          | _ => .false
        | .vcoit _ _ _ S st j x => match whnf b with
          | .vcoit _ _ _ S' st' j' x' => Bool.and (conv c (coitStateTy l I) S S')
              (Bool.and (conv c (coitStepTy l I D S) st st') (Bool.and (conv c I j j') (conv c (vapp S j) x x')))
          | _ => .false
        | _ => convNe c a b
      | _ => convNe c a b
  --|ex
  --| | _, _, _, _ => .false
  --sol>
def convTy (c : TCtx) (a b : Val) : Bool := match lazyDelta c a b with
  | .true => .true
  | .false => convTyW c (whnf a) (whnf b)
-- two glued values with the same head: compare the spines (else they get unfolded)
def lazyDelta : TCtx → Val → Val → Bool
  | c, .vglued h sp _, .vglued h' sp' _ => Bool.and (convHead c h h') (convSpine c h sp sp')
  | _, _, _ => .false
def convTyW : TCtx → Val → Val → Bool
  --<sol
  | c, .vpi q a e b _, .vpi q' a' e' b' _ => Bool.and (qEq q q') (Bool.and (convTy c a a')
      (convTy (TCtx.bind c a) (eval (.cons (fresh (TCtx.lvl c)) e) b) (eval (.cons (fresh (TCtx.lvl c)) e') b')))
  | c, .vsigma q a e b _, .vsigma q' a' e' b' _ => Bool.and (qEq q q') (Bool.and (convTy c a a')
      (convTy (TCtx.bind c a) (eval (.cons (fresh (TCtx.lvl c)) e) b) (eval (.cons (fresh (TCtx.lvl c)) e') b')))
  | _, .vsort l, .vsort l' => lvlEquiv l l'
  | _, .vunit l, .vunit l' => Nat.beq l l'
  | _, .vempty l, .vempty l' => Nat.beq l l'
  | _, .venum k, .venum k' => Nat.beq k k'
  | c, .vdesc l I, .vdesc l' I' => Bool.and (Nat.beq l l') (convTy c I I')
  | c, .vulift l A, .vulift l' A' => Bool.and (Nat.beq l l') (convTy c A A')
  | _, .vsize, .vsize => .true
  | c, .vsizeLt s, .vsizeLt s' => sizeEq s s'
  | c, .vmu l I D i s, .vmu l' I' D' i' s' => Bool.and (Bool.and (Nat.beq l l') (sizeEq s s')) (Bool.and (convTy c I I')
      (Bool.and (conv c (.vdesc l I) D D') (conv c I i i')))
  | c, .vnu l I D i s, .vnu l' I' D' i' s' => Bool.and (Bool.and (Nat.beq l l') (sizeEq s s')) (Bool.and (convTy c I I')
      (Bool.and (conv c (.vdesc l I) D D') (conv c I i i')))
  | c, a, b => convNe c a b
  --|ex
  --| | _, _, _ => .false
  --sol>
def convNe (c : TCtx) (a b : Val) : Bool := match lazyDelta c a b with
  | .true => .true
  | .false => convNeW c (whnf a) (whnf b)
def convNeW : TCtx → Val → Val → Bool
  | _, .vtag _ i, .vtag _ j => Nat.beq i j
  | _, .vtt, .vtt => .true
  | c, .vne x sp, .vne y sp' => Bool.and (convHead c x y) (convSpine c x sp sp')
  | _, _, _ => .false
-- the same head: the same variable, or equal components (proofs are all equal)
def convHead : TCtx → Head → Head → Bool
  | _, .hvar x, .hvar y => Nat.beq x y
  | _, .hconst n _ ls _ _, .hconst n' _ ls' _ _ => Bool.and (kStrEq n n') (lvlsEq ls ls')
  | _, .haxiom n _, .haxiom n' _ => kStrEq n n'
  | c, .heq A a b, .heq A' a' b' => Bool.and (convTy c A A') (Bool.and (conv c A a a') (conv c A b b'))
  | c, .heqTy A B, .heqTy A' B' => Bool.and (convTy c A A') (convTy c B B')
  | c, .hcast A B _ t, .hcast A' B' _ t' => Bool.and (convTy c A A') (Bool.and (convTy c B B') (conv c A t t'))
  | _, .hrefl _ _, .hrefl _ _ => .true
  | _, .hreflTy _, .hreflTy _ => .true
  | _, .htransp _ _ _ _ _ _, .htransp _ _ _ _ _ _ => .true
  | _, .hprf _ _ _, .hprf _ _ _ => .true
  | _, _, _ => .false
-- the same head `x`: compare the eliminations, at their types
def convSpine : TCtx → Head → Spine → Spine → Bool
  | _, _, .snil, .snil => .true
  | c, x, .sapp r a, .sapp r' b => Bool.and (convSpine c x r r') (match whnf (typeOfNe c x r) with
    | .vpi _ dom _ _ _ => conv c dom a b
    | _ => .false)
  | c, x, .sfst r, .sfst r' => convSpine c x r r'
  | c, x, .ssnd r, .ssnd r' => convSpine c x r r'
  | c, x, .sout r, .sout r' => convSpine c x r r'
  | c, x, .sdown r, .sdown r' => convSpine c x r r'
  | c, x, .secase r e m bs, .secase r' e' m' bs' => Bool.and (convSpine c x r r')
      -- (the same branches over the same environment: nothing more to compare)
      (match Bool.and (Bool.and (tmEq m m') (tmsEq bs bs')) (fuelOk (envSame 2000 e e')) with
      | .true => .true
      | .false => match whnf (typeOfNe c x r) with
       | .venum k => Bool.and
           (convTy (TCtx.bind c (.venum k)) (eval (.cons (fresh (TCtx.lvl c)) e) m) (eval (.cons (fresh (TCtx.lvl c)) e') m'))
           (convBranches c k e m e' bs bs' 0)
       | _ => .false)
  | c, x, .sabsurd r m, .sabsurd r' m' => Bool.and (convSpine c x r r') (convTy c m m')
  | c, x, .sdelim r v P a b d e, .sdelim r' v' P' a' b' d' e' => Bool.and (convSpine c x r r')
      (match whnf (typeOfNe c x r) with
       | .vdesc l I => Bool.and (Nat.beq v v') (Bool.and (conv c (delimMotiveTy l v I) P P')
           (Bool.and (conv c (delimMret l I P) a a') (Bool.and (conv c (delimMarg l I P) b b')
             (Bool.and (conv c (delimMrec l I P) d d') (conv c (delimMhrec l I P) e e')))))
       | _ => .false)
  | c, x, .ssfix r l I D v P f sz i, .ssfix r' l' I' D' v' P' f' sz' i' => Bool.and (convSpine c x r r')
      (Bool.and (Bool.and (Nat.beq l l') (Nat.beq v v')) (Bool.and (convTy c I I') (Bool.and (conv c (.vdesc l I) D D')
        (Bool.and (conv c (indMotiveTy l v I D) P P') (Bool.and (conv c (sfixFunTy l I D P) f f')
          (Bool.and (sizeEq sz sz') (conv c I i i')))))))
  | c, x, .sscase r l I D v P m sz i, .sscase r' l' I' D' v' P' m' sz' i' => Bool.and (convSpine c x r r')
      (Bool.and (Bool.and (Nat.beq l l') (Nat.beq v v')) (Bool.and (convTy c I I') (Bool.and (conv c (.vdesc l I) D D')
        (Bool.and (conv c (indMotiveTy l v I D) P P') (Bool.and (conv c (scaseMethodTy l I D P sz) m m')
          (Bool.and (sizeEq sz sz') (conv c I i i')))))))
  | c, x, .sind r l I D v P m i, .sind r' l' I' D' v' P' m' i' => Bool.and (convSpine c x r r')
      (Bool.and (Bool.and (Nat.beq l l') (Nat.beq v v')) (Bool.and (convTy c I I') (Bool.and (conv c (.vdesc l I) D D')
        (Bool.and (conv c (indMotiveTy l v I D) P P') (Bool.and (conv c (indMethodTy l v I D P) m m') (conv c I i i'))))))
  | _, _, _, _ => .false
def convBranches : TCtx → Nat → Env → Tm → Env → Tms → Tms → Nat → Bool
  | _, _, _, _, _, .tnil, .tnil, _ => .true
  | c, k, e, m, e', .tcons b r, .tcons b' r', i =>
    Bool.and (conv c (eval (.cons (.vtag k i) e) m) (eval e b) (eval e' b')) (convBranches c k e m e' r r' (i + 1))
  | _, _, _, _, _, _, _, _ => .false

-- **Exercise 14.7.** Subtyping (`subTy` in `Conv.lean`): sizes grow covariantly in `μ`,
-- functions are contravariant in their domain (and may differ in quantity when they are
-- propositions), pairs covariant; otherwise convertible.
def subTy (c : TCtx) (A B : Val) : Bool := match whnf A with
  --<sol
  | .vmu l I D i s => match whnf B with
    | .vmu l' I' D' i' s' => Bool.and (Bool.and (Nat.beq l l') (sizeLe c s s'))
        (Bool.and (convTy c I I') (Bool.and (conv c (.vdesc l I) D D') (conv c I i i')))
    | B' => convTy c (.vmu l I D i s) B'
  | .vnu l I D i s => match whnf B with
    | .vnu l' I' D' i' s' => Bool.and (Bool.and (Nat.beq l l') (sizeLe c s' s))
        (Bool.and (convTy c I I') (Bool.and (conv c (.vdesc l I) D D') (conv c I i i')))
    | B' => convTy c (.vnu l I D i s) B'
  | .vpi q a1 e1 b1 _ => match whnf B with
    | .vpi q' a2 e2 b2 _ =>
      let x := fresh (TCtx.lvl c);
      Bool.and (Bool.or (qEq q q') (isProp c (.vpi q a1 e1 b1 .none))) (Bool.and (subTy c a2 a1)
        (subTy (TCtx.bind c a2) (eval (.cons x e1) b1) (eval (.cons x e2) b2)))
    | B' => convTy c (.vpi q a1 e1 b1 .none) B'
  | .vsigma q a1 e1 b1 _ => match whnf B with
    | .vsigma q' a2 e2 b2 _ =>
      let x := fresh (TCtx.lvl c);
      Bool.and (qEq q q') (Bool.and (subTy c a1 a2)
        (subTy (TCtx.bind c a1) (eval (.cons x e1) b1) (eval (.cons x e2) b2)))
    | B' => convTy c (.vsigma q a1 e1 b1 .none) B'
  | .vsizeLt sz => match whnf B with
    | .vsize => .true
    | .vsizeLt t => sizeLe c sz t
    | B' => convTy c (.vsizeLt sz) B'
  | A' => convTy c A' B
  --|ex
  --| | A' => convTy c A' B
  --sol>
end

def showVal (c : TCtx) (v : Val) : String := show .nil (TCtx.lvl c) (quote (TCtx.lvl c) v)

-- (Q1) must a value `v` of type `a` be used: is `a` a Σ with a field whose quantity
-- doesn't allow zero uses, here or in its second part? (`p.1` drops `p.2`)
partial def mustUse (a v : Val) : Bool := match whnf a with
  | .vsigma q _ env b _ => match qle .qz q with
    | .true => mustUse (eval (.cons (vfst v) env) b) (vsnd v)
    | .false => .true
  | _ => .false

-- **Exercise 14.3.** Bidirectional type checking with usage (`infer` and `check` in
-- `Check.lean`): each answer comes with the usage of the variables (types and proofs
-- count nothing); leaving a binder checks its variable's usage against its quantity.
-- `check` returns the type it checked against.
mutual
def infer : TCtx → Tm → TyRes
  --<sol
  | c, .var i => match Nat.lt i (TCtx.lvl c) with
    | .true => .ok (lookup (TCtx.types c) i) (uSingle (TCtx.lvl c) i)
    | .false => .err "internal error: a variable out of scope"
  | c, .univ n => .ok (.vsort (.lnum (n + 2))) (uZeros (TCtx.lvl c))
  | c, .prop => .ok (.vsort (.lnum 1)) (uZeros (TCtx.lvl c))
  | c, .sortL l => .ok (.vsort (.lsucc l)) (uZeros (TCtx.lvl c))
  | c, .pi a b => former c a b .true
  | c, .piq _ a b => former c a b .true
  | c, .sigma a b => former c a b .false
  | c, .sigmaq _ a b => former c a b .false
  | c, .sorted l t => match infer c t with
    | .ok ty u => match ty with
      | .vsort l' => match lvlEquiv l l' with
        | .true => .ok ty u
        | .false => .err "internal error: a type marked with the wrong sort"
      | _ => .err "internal error: a sort given to a term that is not a type"
    | r => r
  | _, .lam _ => .err "cannot infer the type of a λ; add a type ascription"
  | c, .app f a => match infer c f with
    | .ok fty uf => match whnf fty with
      | .vpi q dom env cod _ => match check (erasedIf q c) a dom with
        -- (the argument is evaluated only if the codomain mentions it: `List.cons x rest`
        -- nested n deep would evaluate the rest at every level)
        | .ok _ ua => .ok (eval (.cons (match usesVar 0 cod with
            | .true => eval (TCtx.env c) a
            | .false => .vtt) env) cod) (uAdd uf (uScale q ua))
        | r => r
      | ty => .err (String.append "not a function: its type is " (showVal c ty))
    | r => r
  | c, .letE ty v b => letIn c .qw ty v b
  | c, .letq q ty v b => letIn c q ty v b
  | c, .ann t ty => match inferUniv c ty with
    | .ok _ _ => match check c t (eval (TCtx.env c) ty) with
      | .ok _ u => .ok (eval (TCtx.env c) ty) u
      | r => r
    | r => r
  | _, .pair _ _ => .err "cannot infer the type of a pair; add a type ascription"
  | c, .fst p => match infer c p with
    | .ok ty u => match whnf ty with
      | .vsigma q a env b _ => match Bool.or (TCtx.erased c) (qle .qo q) with
        -- `p.1` drops `p.2` (Q1): if that holds a field that must be used, only an
        -- unrestricted pair may drop it, so `p` counts as used ω times
        | .true => match TCtx.erased c with
          | .true => .ok a u
          | .false =>
            let pv := eval (TCtx.env c) p;
            match mustUse (eval (.cons (vfst pv) env) b) (vsnd pv) with
            | .true => .ok a (uScale .qw u)
            | .false => .ok a u
        | .false => .err "cannot project an erased field"
      | ty => .err (String.append "not a pair: its type is " (showVal c ty))
    | r => r
  | c, .snd p => match infer c p with
    | .ok ty u => match whnf ty with
      -- `p.2` discards the first field: if it must be used, only an unrestricted pair
      -- (whose field is ω·q) may drop it, so `p` counts as used ω times
      | .vsigma q _ env b _ => match Bool.or (TCtx.erased c) (qle .qz q) with
        | .true => .ok (eval (.cons (vfst (eval (TCtx.env c) p)) env) b) u
        | .false => .ok (eval (.cons (vfst (eval (TCtx.env c) p)) env) b) (uScale .qw u)
      | ty => .err (String.append "not a pair: its type is " (showVal c ty))
    | r => r
  | c, .unit n => .ok (.vsort (.lnum (n + 1))) (uZeros (TCtx.lvl c))
  | c, .empty n => .ok (.vsort (.lnum (n + 1))) (uZeros (TCtx.lvl c))
  | c, .ptrue => .ok (.vsort (.lnum 0)) (uZeros (TCtx.lvl c))
  | c, .pfalse => .ok (.vsort (.lnum 0)) (uZeros (TCtx.lvl c))
  | _, .star => .err "cannot infer the type of tt; add a type ascription"
  | c, .exfalso m t => match inferUniv c m with
    | .ok _ _ => match infer (TCtx.erase c) t with
      | .ok ty _ => match whnf ty with
        | .vempty _ => .ok (eval (TCtx.env c) m) (uZeros (TCtx.lvl c))
        | ty => .err (String.append "not empty: " (showVal c ty))
      | r => r
    | r => r
  | c, .enum _ => .ok (.vsort (.lnum 1)) (uZeros (TCtx.lvl c))
  | c, .tag k i => match Nat.lt i k with
    | .true => .ok (.venum k) (uZeros (TCtx.lvl c))
    | .false => .err "tag out of range"
  | c, .ecase m sc bs => match infer c sc with
    | .ok sty us => match whnf sty with
      | .venum k => match Nat.beq k (tmsLen bs) with
        | .false => .err "wrong number of branches"
        | .true => match inferUniv (TCtx.bind c (.venum k)) m with
          | .ok _ _ => match checkBranches c k m bs 0 .none with
            | .ok _ ub => .ok (eval (.cons (eval (TCtx.env c) sc) (TCtx.env c)) m) (uAdd us ub)
            | r => r
          | r => r
      | ty => .err (String.append "not an enumeration: " (showVal c ty))
    | r => r
  | c, .eq A a b => match inferUniv c A with
    | .ok (.vsort l) _ => match lvlNeverZero l with
      | .false => .err "equality is for types in Type u, not propositions"
      | .true =>
        let vA := eval (TCtx.env c) A;
        match check c a vA with
        | .ok _ _ => match check c b vA with
          | .ok _ _ => .ok (.vsort (.lnum 0)) (uZeros (TCtx.lvl c))
          | r => r
        | r => r
    | r => r
  | c, .eqTy A B => match inferUniv c A with
    | .ok (.vsort l) _ => match inferUniv c B with
      | .ok (.vsort l') _ => match lvlEquiv l l' with
        | .true => .ok (.vsort (.lnum 0)) (uZeros (TCtx.lvl c))
        | .false => .err "type equality between different universes"
      | r => r
    | r => r
  | c, .eqRefl A a => match inferUniv c A with
    | .ok (.vsort l) _ => match lvlNeverZero l with
      | .false => .err "refl is for terms of types in Type u"
      | .true =>
        let vA := eval (TCtx.env c) A;
        match check c a vA with
        | .ok _ _ => .ok (vEq vA (eval (TCtx.env c) a) (eval (TCtx.env c) a)) (uZeros (TCtx.lvl c))
        | r => r
    | r => r
  | c, .tyRefl X => match inferUniv c X with
    | .ok _ _ => .ok (vEqType (eval (TCtx.env c) X) (eval (TCtx.env c) X)) (uZeros (TCtx.lvl c))
    | r => r
  | c, .coe A B e t => match inferUniv c A with
    | .ok (.vsort l) _ => match inferUniv c B with
      | .ok (.vsort l') _ => match lvlEquiv l l' with
        | .false => .err "cast between different universes"
        | .true =>
          let vA := eval (TCtx.env c) A;
          let vB := eval (TCtx.env c) B;
          match check (TCtx.erase c) e (vEqType vA vB) with
          | .ok _ _ => match check c t vA with
            | .ok _ u => .ok vB u
            | r => r
          | r => r
      | r => r
    | r => r
  | c0, .subst A a P p b e =>
    -- a proof: everything in it is erased
    let c := TCtx.erase c0;
    match inferUniv c A with
    | .ok _ _ =>
      let vA := eval (TCtx.env c) A;
      match check c a vA with
      | .ok _ _ =>
        let va := eval (TCtx.env c) a;
        -- (b :0 A) → (_ :0 a = b) → Prop
        let motiveTy : Val := .vpi .qz vA (.cons va (.cons vA .nil)) (.piq .qz (.eq (.var 2) (.var 1) (.var 0)) .prop) .none;
        match check c P motiveTy with
        | .ok _ _ =>
          let vP := eval (TCtx.env c) P;
          match check c p (vapp (vapp vP va) (.vne (.hrefl vA va) .snil)) with
          | .ok _ _ => match check c b vA with
            | .ok _ _ =>
              let vb := eval (TCtx.env c) b;
              match check c e (vEq vA va vb) with
              | .ok _ _ => .ok (vapp (vapp vP vb) (eval (TCtx.env c) e)) (uZeros (TCtx.lvl c))
              | r => r
            | r => r
          | r => r
        | r => r
      | r => r
    | r => r
  | c, .descr l I => match inferUniv c I with
    | .ok (.vsort lI) _ => match lvlEquiv lI (.lnum (l + 1)) with
      | .true => .ok (.vsort (.lnum (l + 2))) (uZeros (TCtx.lvl c))
      | .false => .err "a description's index type must be in its universe"
    | r => r
  | _, .dret _ => .err "cannot infer the type of a description; add a type ascription"
  | _, .darg _ _ => .err "cannot infer the type of a description; add a type ascription"
  | _, .drec _ _ => .err "cannot infer the type of a description; add a type ascription"
  | _, .dhrec _ _ _ => .err "cannot infer the type of a description; add a type ascription"
  | _, .con _ => .err "cannot infer the type of a constructor; add a type ascription"
  | c, .size => .ok (.vsort (.lnum 1)) (uZeros (TCtx.lvl c))
  | c, .szInf => .ok .vsize (uZeros (TCtx.lvl c))
  | c, .szSuc sz => match check (TCtx.erase c) sz .vsize with
    | .ok _ _ => .ok .vsize (uZeros (TCtx.lvl c))
    | r => r
  | c, .sizeLt sz => match check (TCtx.erase c) sz .vsize with
    | .ok _ _ => .ok (.vsort (.lnum 1)) (uZeros (TCtx.lvl c))
    | r => r
  | c, .mus l I D i sz => match check (TCtx.erase c) sz .vsize with
    | .ok _ _ => infer c (.mu l I D i)
    | r => r
  | c, .sfix l I D v P f sz i x => match inferUniv c I with
    | .ok _ _ =>
      let vI := eval (TCtx.env c) I;
      match check c D (.vdesc l vI) with
      | .ok _ _ =>
        let vD := eval (TCtx.env c) D;
        match check c P (indMotiveTy l v vI vD) with
        | .ok _ _ =>
          let vP := eval (TCtx.env c) P;
          match check c f (sfixFunTy l vI vD vP) with
          | .ok _ uf => match check (TCtx.erase c) sz .vsize with
            | .ok _ _ => match check c i vI with
              | .ok _ _ =>
                let vi := eval (TCtx.env c) i;
                match check c x (.vmu l vI vD vi (eval (TCtx.env c) sz)) with
                | .ok _ ux => .ok (vapp (vapp vP vi) (eval (TCtx.env c) x)) (uAdd (uScale .qw uf) ux)
                | r => r
              | r => r
            | r => r
          | r => r
        | r => r
      | r => r
    | r => r
  | c, .scase l I D v P m sz i x => match inferUniv c I with
    | .ok _ _ =>
      let vI := eval (TCtx.env c) I;
      match check c D (.vdesc l vI) with
      | .ok _ _ =>
        let vD := eval (TCtx.env c) D;
        match check c P (indMotiveTy l v vI vD) with
        | .ok _ _ =>
          let vP := eval (TCtx.env c) P;
          match check (TCtx.erase c) sz .vsize with
          | .ok _ _ =>
            let vs := eval (TCtx.env c) sz;
            match check c m (scaseMethodTy l vI vD vP vs) with
            | .ok _ um => match check c i vI with
              | .ok _ _ =>
                let vi := eval (TCtx.env c) i;
                match check c x (.vmu l vI vD vi vs) with
                | .ok _ ux => .ok (vapp (vapp vP vi) (eval (TCtx.env c) x)) (uAdd um ux)
                | r => r
              | r => r
            | r => r
          | r => r
        | r => r
      | r => r
    | r => r
  | c, .nu l I D i sz => match check (TCtx.erase c) sz .vsize with
    | .ok _ _ => infer c (.mu l I D i)
    | r => r
  | c, .out x => match infer c x with
    | .ok ty u => match whnf ty with
      | .vnu l I D i sz => match sizePred sz with
        | .some sz' => .ok (vInterp l I D (nuFamilyAt l I D sz') i) u
        | .none => .err "only a value of size ↑s or ∞ can be observed"
      | ty' => .err (String.append "not a coinductive type: " (showVal c ty'))
    | r => r
  | _, .cocon _ => .err "cannot infer the type of a constructor; add a type ascription"
  | c, .scofix l I D A f sz i a => match inferUniv c I with
    | .ok _ _ =>
      let vI := eval (TCtx.env c) I;
      match check c D (.vdesc l vI) with
      | .ok _ _ =>
        let vD := eval (TCtx.env c) D;
        match check c A (coitStateTy l vI) with
        | .ok _ _ =>
          let vA := eval (TCtx.env c) A;
          match check c f (scofixFunTy l vI vD vA) with
          | .ok _ uf => match check (TCtx.erase c) sz .vsize with
            | .ok _ _ => match check c i vI with
              | .ok _ _ =>
                let vi := eval (TCtx.env c) i;
                match check c a (vapp vA vi) with
                | .ok _ ua => .ok (.vnu l vI vD vi (eval (TCtx.env c) sz)) (uAdd (uScale .qw uf) ua)
                | r => r
              | r => r
            | r => r
          | r => r
        | r => r
      | r => r
    | r => r
  | c, .coit l I D S st i x => match inferUniv c I with
    | .ok _ _ =>
      let vI := eval (TCtx.env c) I;
      match check c D (.vdesc l vI) with
      | .ok _ _ =>
        let vD := eval (TCtx.env c) D;
        match check c S (coitStateTy l vI) with
        | .ok _ _ =>
          let vS := eval (TCtx.env c) S;
          match check c st (coitStepTy l vI vD vS) with
          | .ok _ ust => match check c i vI with
            | .ok _ _ =>
              let vi := eval (TCtx.env c) i;
              match check c x (vapp vS vi) with
              | .ok _ ux => .ok (.vnu l vI vD vi .vszInf) (uAdd (uScale .qw ust) ux)
              | r => r
            | r => r
          | r => r
        | r => r
      | r => r
    | r => r
  | c, .mu l I D i => match inferUniv c I with
    | .ok (.vsort lI) _ => match lvlEquiv lI (.lnum (l + 1)) with
      | .false => .err "an index type must be in the data type's universe"
      | .true =>
        let vI := eval (TCtx.env c) I;
        match check c D (.vdesc l vI) with
        | .ok _ _ => match check c i vI with
          | .ok _ _ => .ok (.vsort (.lnum (l + 1))) (uZeros (TCtx.lvl c))
          | r => r
        | r => r
    | r => r
  | c, .delim v P a b d e D => match infer c D with
    | .ok dty uD => match whnf dty with
      | .vdesc l I => match check c P (delimMotiveTy l v I) with
        | .ok _ _ =>
          let vP := eval (TCtx.env c) P;
          match check c a (delimMret l I vP) with
          | .ok _ ua => match check c b (delimMarg l I vP) with
            | .ok _ ub => match check c d (delimMrec l I vP) with
              | .ok _ ud => match check c e (delimMhrec l I vP) with
                | .ok _ ue => .ok (vapp vP (eval (TCtx.env c) D))
                    (uAdd (uScale .qw (uAdd ua (uAdd ub (uAdd ud ue)))) uD)
                | r => r
              | r => r
            | r => r
          | r => r
        | r => r
      | ty => .err (String.append "not a description: " (showVal c ty))
    | r => r
  | c, .ind l I D v P m i x => match inferUniv c I with
    | .ok _ _ =>
      let vI := eval (TCtx.env c) I;
      match check c D (.vdesc l vI) with
      | .ok _ _ =>
        let vD := eval (TCtx.env c) D;
        match check c P (indMotiveTy l v vI vD) with
        | .ok _ _ =>
          let vP := eval (TCtx.env c) P;
          match check c m (indMethodTy l v vI vD vP) with
          | .ok _ um => match check c i vI with
            | .ok _ _ =>
              let vi := eval (TCtx.env c) i;
              match check c x (.vmu l vI vD vi .vszInf) with
              | .ok _ ux => .ok (vapp (vapp vP vi) (eval (TCtx.env c) x)) (uAdd (uScale .qw um) ux)
              | r => r
            | r => r
          | r => r
        | r => r
      | r => r
    | r => r
  | c, .const _ ps ls _ ty => .ok (eval .nil (substIfAny ps ls ty)) (uZeros (TCtx.lvl c))
  | c, .axiomC _ ty => .ok (eval .nil ty) (uZeros (TCtx.lvl c))
  | c, .ulift l A => match inferUniv c A with
    | .ok (.vsort k) _ => match lvlLe k (.lnum l) with
      | .true => .ok (.vsort (.lnum l)) (uZeros (TCtx.lvl c))
      | .false => .err "ULift can only lift a type to a universe at least as big"
    | r => r
  | _, .up _ => .err "cannot infer the type of up; add a type ascription"
  | c, .down t => match infer c t with
    | .ok ty u => match whnf ty with
      | .vulift _ A => .ok A u
      | ty' => .err (String.append "not a lifted type: " (showVal c ty'))
    | r => r
  --|ex
  --| | _, _ => .err "not implemented"
  --sol>
-- a Π (`isPi`) or Σ type: its universe
def former : TCtx → Tm → Tm → Bool → TyRes
  | c, a, b, isPi => match inferUniv c a with
    | .ok (.vsort i) _ => match inferUniv (TCtx.bind c (eval (TCtx.env c) a)) b with
      | .ok (.vsort j) _ => match isPi with
        | .true => .ok (.vsort (.limax i j)) (uZeros (TCtx.lvl c))
        | .false => .ok (.vsort (.lmax i j)) (uZeros (TCtx.lvl c))
      | r => r
    | r => r
-- `let x :q ty := v; b`
def letIn : TCtx → Q → Tm → Tm → Tm → TyRes
  | c, q, ty, v, b => match inferUniv c ty with
    | .ok _ _ =>
      let tyv := eval (TCtx.env c) ty;
      match check c v tyv with
      | .ok _ uv => match infer (TCtx.define c (eval (TCtx.env c) v) tyv) b with
        | .ok bty ub => match popUsage q ub with
          | .some ub' => .ok bty (uAdd (uScale q uv) ub')
          | .none => .err "the let-bound variable is used more than its quantity allows"
        | r => r
      | r => r
    | r => r
-- `let x :q ty := v; b` against a type: the body is checked against it too
def checkLet : TCtx → Q → Tm → Tm → Tm → Val → TyRes
  | c, q, ty, v, b, T => match inferUniv c ty with
    | .ok _ _ =>
      let tyv := eval (TCtx.env c) ty;
      match check c v tyv with
      | .ok _ uv => match check (TCtx.define c (eval (TCtx.env c) v) tyv) b T with
        | .ok _ ub => match popUsage q ub with
          | .some ub' => .ok T (uAdd (uScale q uv) ub')
          | .none => .err "the let-bound variable is used more than its quantity allows"
        | r => r
      | r => r
    | r => r
-- (given) `check` matches on the type's shape (`whnf`), and answers with the type it got
def check (c : TCtx) (t : Tm) (ty : Val) : TyRes := match checkW c t (whnf ty) with
  | .ok _ u => .ok ty u
  | r => r
def checkW : TCtx → Tm → Val → TyRes
  --<sol
  | c, .lam b, .vpi q dom env cod _ =>
    match check (TCtx.bind c dom) b (eval (.cons (fresh (TCtx.lvl c)) env) cod) with
    | .ok _ u => match popUsage q u with
      | .some u' => .ok (.vpi q dom env cod .none) u'
      | .none => .err "the bound variable is used more than its quantity allows"
    | r => r
  | c, .letE ty v b, T => checkLet c .qw ty v b T
  | c, .letq q ty v b, T => checkLet c q ty v b T
  | c, .star, .vunit n => .ok (.vunit n) (uZeros (TCtx.lvl c))
  | c, .up a, .vulift n A => match check c a A with
    | .ok _ u => .ok (.vulift n A) u
    | r => r
  | c, .pair a b, .vsigma q ta env tb _ => match check c a ta with
    | .ok _ ua => match check c b (eval (.cons (eval (TCtx.env c) a) env) tb) with
      | .ok _ ub => .ok (.vsigma q ta env tb .none) (uAdd (uScale q ua) ub)
      | r => r
    | r => r
  | c, .dret i, .vdesc l I => match check c i I with
    | .ok _ u => .ok (.vdesc l I) u
    | r => r
  | c, .darg S E, .vdesc l I => match inferUniv c S with
    -- (Q4) exactly the universe `Desc.elim`'s `marg` takes fields from (smaller ones are lifted)
    | .ok (.vsort lS) _ => match lvlEquiv lS (.lnum (l + 1)) with
      | .false => .err "a description's field type must be in its universe (lift it with ULift)"
      | .true => match check c E (.vpi .qw (eval (TCtx.env c) S) (.cons I .nil) (.descr l (.var 1)) .none) with
        | .ok _ u => .ok (.vdesc l I) u
        | r => r
    | r => r
  | c, .drec j E, .vdesc l I => match check c j I with
    | .ok _ uj => match check c E (.vdesc l I) with
      | .ok _ uE => .ok (.vdesc l I) (uAdd uj uE)
      | r => r
    | r => r
  | c, .dhrec H j E, .vdesc l I => match inferUniv c H with
    | .ok (.vsort lH) _ => match lvlEquiv lH (.lnum (l + 1)) with
      | .false => .err "a description's branching type must be in its universe (lift it with ULift)"
      | .true => match check c j (.vpi .qw (eval (TCtx.env c) H) (.cons I .nil) (.var 1) .none) with
        | .ok _ uj => match check c E (.vdesc l I) with
          | .ok _ uE => .ok (.vdesc l I) (uAdd uj uE)
          | r => r
        | r => r
    | r => r
  | c, .con x, .vmu l I D i sz => match sizePred sz with
    | .some sz' => match check c x (vInterp l I D (muFamilyAt l I D sz') i) with
      | .ok _ u => .ok (.vmu l I D i sz) u
      | r => r
    | .none => .err "a constructor builds a value of size ↑s"
  | c, .cocon x, .vnu l I D i sz => match sizePred sz with
    | .some sz' => match check c x (vInterp l I D (nuFamilyAt l I D sz') i) with
      | .ok _ u => .ok (.vnu l I D i sz) u
      | r => r
    | .none => .err "cocon builds a value of size ↑s"
  | c, t, .vsizeLt sz => checkBelow c t sz
  | c, t, ty => checkByInfer c t ty
  --|ex
  --| | c, t, ty => checkByInfer c t ty
  --sol>
-- (given) Otherwise: infer, and the type must be a subtype of the expected one. (A
-- catch-all row is copied into every case the rows above it split off, so a long
-- right-hand side here would be compiled hundreds of times: keep it a call.)
def checkByInfer (c : TCtx) (t : Tm) (ty : Val) : TyRes := match infer c t with
  | .ok ty' u => match subTy c ty' ty with
    | .true => .ok ty u
    | .false => .err (String.append (String.append "type mismatch: expected " (showVal c ty))
        (String.append ", got " (showVal c ty')))
  | r => r
--<sol
-- a size below `sz`
def checkBelow (c : TCtx) (t : Tm) (sz : Val) : TyRes := match check c t .vsize with
  | .ok _ _ => match sizeBelow c (eval (TCtx.env c) t) sz with
    | .true => .ok (.vsizeLt sz) (uZeros (TCtx.lvl c))
    | .false => .err "the size is not below its bound"
  | r => r
--|ex
--sol>
-- branch `i` and on, against the motive at tag `i`; the usages are joined
def checkBranches : TCtx → Nat → Tm → Tms → Nat → Option (List Q) → TyRes
  | c, k, _, .tnil, _, acc => match acc with
    | .some u => .ok (.venum k) u
    | .none => .ok (.venum k) (uZeros (TCtx.lvl c))
  | c, k, m, .tcons b rest, i, acc => match check c b (eval (.cons (.vtag k i) (TCtx.env c)) m) with
    | .ok _ u => checkBranches c k m rest (i + 1) (match acc with
      | .some u0 => .some (uJoin u0 u)
      | .none => .some u)
    | r => r
-- a type: its universe (types are erased: their usage counts for nothing)
def inferUniv : TCtx → Tm → TyRes
  | c, t => match infer (TCtx.erase c) t with
    | .ok ty _ => match whnf ty with
      | .vsort l => .ok (.vsort l) (uZeros (TCtx.lvl c))
      | ty => .err (String.append "not a type: its type is " (showVal c ty))
    | r => r
end

def empty : TCtx := .mk .nil .nil 0 .false

-- check a declaration (`addDecl` in `Check.lean`): its type is a type and its value, if
-- it has one, has that type. Its level parameters stay symbolic, so this checks it at
-- every level at once.
def checkDecl (ty : Tm) (value : Option Tm) : TyRes := match inferUniv empty ty with
  | .ok _ _ => match value with
    | .none => .ok (eval .nil ty) .nil
    | .some v => check empty v (eval .nil ty)
  | r => r

-- a partial definition's signature (`addPartialDecl`): its type is a type and the
-- witness, a term of that type, checks (erased: it is evidence, never run). The
-- definition stays opaque, an axiom whose type is inhabited.
def checkPartial (ty w : Tm) : TyRes := match inferUniv empty ty with
  | .ok _ _ => check (TCtx.erase empty) w (eval .nil ty)
  | r => r

-- type check a closed term: its type, or the error
def typeOf (t : Tm) : String := match infer empty t with
  | .ok ty _ => show .nil 0 (quote 0 ty)
  | .err m => String.append "error: " m

-- the normal form of a closed term
def normalize (t : Tm) : String := show .nil 0 (quote 0 (eval .nil t))
