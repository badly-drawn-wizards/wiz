-- From text to a checked term, all in Wiz (stage 14b): the lexer and parser read the
-- full Wiz grammar, and this scope checker turns the syntax of a few term forms into
-- the kernel's `Tm` (names become de Bruijn indices), which `Kernel.wiz` type checks.
-- Load it after `Lex.wiz`, `Parse.wiz` and `Kernel.wiz`.
--
-- Supported: identifiers, `Type n`, `(x : A) → B`, `A → B`, `fun x (y : A) => b` (the
-- binder types are not kept: a λ is checked against a type), application,
-- `let x : A := v; b`, `(t : T)` and parentheses; and (stage 16) inductive types.

-- the arguments of a node, as a list
def argsOf : SyntaxF .false → List Syntax
  | .nil => .nil
  | .cons s rest => .cons s (argsOf rest)
def kids : Syntax → List Syntax
  | .node _ args => argsOf args
  | _ => .nil
def kid (s : Syntax) (i : Nat) : Syntax := Syntax.getArg s i
def kindOf : Syntax → String
  | .node k _ => k
  | _ => ""
def is (s : Syntax) (k : String) : Bool := strEq (kindOf s) k

def digits : List Char → Nat → Nat
  | .nil, acc => acc
  | .cons c cs, acc => digits cs (Nat.add (Nat.mul acc 10) (Char.code c - 48))

def indexOf : List String → String → Nat → Option Nat
  | .nil, _, _ => .none
  | .cons n ns, x, i => match strEq n x with
    | .true => .some i
    | .false => indexOf ns x (i + 1)

-- the names in scope: the local binders (innermost first, with their number) and the
-- globals, by name (each with its position plus one; there are `count`)
inductive Scope where
  | mk (locals : List String) (depth : Nat) (globals : StrMap Nat) (count : Nat)
def Scope.empty : Scope := .mk .nil 0 StrMap.empty 0
def Scope.bind (sc : Scope) (x : String) : Scope := match sc with
  | .mk ls d gs n => .mk (.cons x ls) (d + 1) gs n
def Scope.addGlobal (sc : Scope) (x : String) : Scope := match sc with
  | .mk ls d gs n => .mk ls d (StrMap.insert gs (Str.ofString x) (n + 1)) (n + 1)
-- a name's index: a local binder's, or past them a global's (the latest is the nearest)
def Scope.lookup (sc : Scope) (x : String) : Option Nat := match sc with
  | .mk ls d gs n => match indexOf ls x 0 with
    | .some i => .some i
    | .none => match StrMap.findD gs (Str.ofString x) 0 with
      | .zero => .none
      | .succ p => .some (d + (n - 1 - p))

inductive Elab where
  | ok (t : Tm)
  | err (msg : String)

-- the names a binder introduces, and its type (if any)
def identNames : List Syntax → List String
  | .nil => .nil
  | .cons s rest => .cons (match s with
      | .ident n => n
      | _ => "_") (identNames rest)
def binderNames (b : Syntax) : List String := match b with
  | .ident n => .cons n .nil
  | _ => match strEq (kindOf b) "term.hole" with
    | .true => .cons "_" .nil
    | .false => identNames (kids (kid b 2))
def binderType (b : Syntax) : Option Syntax := match kids (kid b 3) with
  | .cons _ (.cons t _) => .some t
  | _ => .none

-- all the names of a `fun`'s binders
def binders : List Syntax → List String
  | .nil => .nil
  | .cons b bs => List.append (binderNames b) (binders bs)

def univLevel (s : Syntax) : Nat := match kids (kid s 1) with
  | .cons l _ => match kid l 0 with
    | .node _ args => match argsOf args with
      | .cons (.atom d) _ => match d with
        | .mk cs => digits cs 0
      | _ => 0
    | _ => 0
  | .nil => 0

-- **Exercise 14.4.** Scope checking: names to indices (`Scope.lookup`, `Scope.bind`).
mutual
def elab : Scope → Syntax → Elab
  --<sol
  | names, .ident n => match Scope.lookup names n with
    | .some i => .ok (.var i)
    | .none => match strEq n "Unit" with
      | .true => .ok (.unit 0)
      | .false => .err ("unknown identifier " +++ n)
  | names, s => match strEq (kindOf s) "term.ident" with
    | .true => elab names (kid s 0)
    | .false => match strEq (kindOf s) "term.paren" with
      | .true => elab names (kid s 1)
      | .false => match strEq (kindOf s) "term.ascription" with
        | .true => both names (kid s 1) (kid s 3) (fun t ty => .ann t ty)
        | .false => match strEq (kindOf s) "term.type" with
          | .true => .ok (.univ (univLevel s))
          | .false => match strEq (kindOf s) "term.arrow" with
            | .true => match elab names (kid s 0) with
              | .ok a => match elab (Scope.bind names "_") (kid s 2) with
                | .ok b => .ok (.pi a b)
                | e => e
              | e => e
            | .false => match strEq (kindOf s) "term.depArrow" with
              | .true => pis names (binderNames (kid s 0)) (binderType (kid s 0)) (kid s 2)
              | .false => match strEq (kindOf s) "term.fun" with
                | .true => lams names (binders (kids (kid s 1))) (kid s 3)
                | .false => match strEq (kindOf s) "term.app" with
                  | .true => match elab names (kid s 0) with
                    | .ok f => apps names f (kids (kid s 1))
                    | e => e
                  | .false => match strEq (kindOf s) "term.let" with
                    | .true => match binderType s with
                      | .none => .err "let needs a type"
                      | .some ty => match elab names ty with
                        | .ok tyT => match elab names (kid s 5) with
                          | .ok v => match kid s 2 with
                            | .ident x => match elab (Scope.bind names x) (kid s 7) with
                              | .ok b => .ok (.letE tyT v b)
                              | e => e
                            | _ => .err "let needs a name"
                          | e => e
                        | e => e
                    | .false => .err ("unsupported syntax " +++ kindOf s)
  --|ex
  --| | _, _ => .err "not implemented"
  --sol>
def both : Scope → Syntax → Syntax → (Tm → Tm → Tm) → Elab
  | names, a, b, k => match elab names a with
    | .ok x => match elab names b with
      | .ok y => .ok (k x y)
      | e => e
    | e => e
-- `(x y : A) → B`: one Π per name, `A` read in each one's context
def pis : Scope → List String → Option Syntax → Syntax → Elab
  | names, .nil, _, body => elab names body
  | names, .cons x xs, ty, body => match ty with
    | .none => .err "a Π needs a binder type"
    | .some a => match elab names a with
      | .ok aT => match pis (Scope.bind names x) xs ty body with
        | .ok b => .ok (.pi aT b)
        | e => e
      | e => e
def lams : Scope → List String → Syntax → Elab
  | names, .nil, body => elab names body
  | names, .cons x xs, body => match lams (Scope.bind names x) xs body with
    | .ok b => .ok (.lam b)
    | e => e
def apps : Scope → Tm → List Syntax → Elab
  | _, f, .nil => .ok f
  | names, f, .cons a rest => match elab names a with
    | .ok aT => apps names (.app f aT) rest
    | e => e
end

-- parse, scope check and type check a closed term
def checkText (cats : List Cat) (tokens : List String) (text : String) : String :=
  match parseSyntax cats tokens "term" text with
  | .err m => String.append "parse " m
  | .ok stx => match elab Scope.empty stx with
    | .err m => String.append "scope error: " m
    | .ok t => typeOf t

-- A file of commands (stage 14c): `def x (binders) : T := v`, `#check t` and
-- `#reduce t`. The global definitions are the kernel's constants.

-- binder groups `(x y : A) …` around a result: Π types, each `A` read in its context
mutual
def groupPis : Scope → List Syntax → Syntax → Elab
  | names, .nil, body => elab names body
  | names, .cons b bs, body => match binderType b with
    | .none => .err "the binders of a definition need types"
    | .some a => piGroup names (binderNames b) a bs body
def piGroup : Scope → List String → Syntax → List Syntax → Syntax → Elab
  | names, .nil, _, bs, body => groupPis names bs body
  | names, .cons x xs, a, bs, body => match elab names a with
    | .ok aT => match piGroup (Scope.bind names x) xs a bs body with
      | .ok b => .ok (.pi aT b)
      | e => e
    | e => e
end

def List.reverseOf {A : Type} : List A → List A → List A
  | .nil, acc => acc
  | .cons x xs, acc => List.reverseOf xs (.cons x acc)

-- a global: its name, type, and value as closed terms (other globals are constants
-- in them), and its value with every global inlined (for `#reduce`, since `quote`
-- doesn't unfold constants)
inductive Global where
  | mk (name : String) (ty val inlined : Tm) (implicits : List Bool)
-- an inductive type (stage 16): its description (with constants, and inlined), and
-- each constructor's fields: name, whether recursive, and type (over the fields before)
inductive CField where
  | mk (name : String) (isRec : Bool) (ty tyI : Tm)
inductive Ctor where
  | mk (name : String) (fields : List CField) (res : Tm)
inductive IndInfo where
  | mk (np : Nat) (I D DI : Tm) (ctors : List Ctor) (fixed : Option Tm) (fam : Tm)
-- the globals so far: by position (the first is `0`), their names in scope, and the
-- inductive types by name
inductive Globals where
  | mk (all : Array Global) (scope : Scope) (inds : StrMap (Option IndInfo))
def Globals.empty : Globals := .mk Array.empty Scope.empty StrMap.empty
def Globals.scope : Globals → Scope
  | .mk _ sc _ => sc
def Globals.add (gs : Globals) (g : Global) : Globals := match gs with
  | .mk all sc inds => match g with
    | .mk x _ _ _ _ => .mk (Array.push all g) (Scope.addGlobal sc x) inds
def Globals.addInd (gs : Globals) (T : String) (info : IndInfo) : Globals := match gs with
  | .mk all sc inds => .mk all sc (StrMap.insert inds (Str.ofString T) (.some info))
def Globals.ind (gs : Globals) (T : String) : Option IndInfo := match gs with
  | .mk _ _ inds => StrMap.findD inds (Str.ofString T) .none
-- the global at index `i` (the latest is `0`): a constant, or its value inlined
def globalTm (inline : Bool) (gs : Globals) (i : Nat) : Tm := match gs with
  | .mk all _ _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .star .star .star .nil) with
    | .mk n ty v iv _ => match inline with
      | .true => iv
      | .false => .const n .nil .nil v ty
-- close a scope-checked term: the variables beyond the `d` binders it is under are
-- globals (each command is checked in the empty context, so usage vectors and lookups
-- don't grow with the number of globals)
def closeG (inline : Bool) (gs : Globals) : Nat → Tm → Tm
  | d, .var i => match Nat.lt i d with
    | .true => .var i
    | .false => globalTm inline gs (i - d)
  | d, .pi a b => .pi (closeG inline gs d a) (closeG inline gs (d + 1) b)
  | d, .lam b => .lam (closeG inline gs (d + 1) b)
  | d, .app f a => .app (closeG inline gs d f) (closeG inline gs d a)
  | d, .letE ty v b => .letE (closeG inline gs d ty) (closeG inline gs d v) (closeG inline gs (d + 1) b)
  | d, .ann t ty => .ann (closeG inline gs d t) (closeG inline gs d ty)
  | d, .sorted l t => .sorted l (closeG inline gs d t)
  | _, t => t

-- the output of a command, and the globals after it
inductive Step where
  | mk (out : String) (gs : Globals)

def errStep (gs : Globals) (m : String) : Step := .mk (String.append "error: " m) gs


-- Inductive types (stage 16a): `inductive T where | c (x : A) (y : T) …`, without
-- parameters or indices, in `Type`. `T` is the constant `μ D tt` for the description
--   D := darg (Enum k) (fun t => ecase t [D₁, …, Dₖ])
-- and each constructor `T.c` the constant `fun fields => con (tag, fields…, tt, tt)`.

-- a constructor's field, and whether its type is `T` itself (a recursive field)
inductive Field where
  | mk (name : String) (ty : Syntax)
def trues : Nat → List Bool
  | .zero => .nil
  | .succ k => .cons .true (trues k)
def falses : Nat → List Bool
  | .zero => .nil
  | .succ k => .cons .false (falses k)
-- which parameters are implicit (`{x : A}`), one per name
def paramMask : List Syntax → List Bool
  | .nil => .nil
  | .cons b bs =>
    let n := List.length (binderNames b);
    List.append (match strEq (kindOf b) "binder.implicit" with
      | .true => trues n
      | .false => falses n) (paramMask bs)

def fieldsNamed (ty : Syntax) : List String → List Field
  | .nil => .nil
  | .cons x xs => .cons (.mk x ty) (fieldsNamed ty xs)
def fieldsOf : List Syntax → List Field
  | .nil => .nil
  | .cons b bs => match binderType b with
    | .none => fieldsOf bs
    | .some ty => List.append (fieldsNamed ty (binderNames b)) (fieldsOf bs)
-- shift the variables from `c` on of a scope-checked term by `k`
def shiftTm (k : Nat) : Nat → Tm → Tm
  | c, .var i => match Nat.lt i c with
    | .true => .var i
    | .false => .var (i + k)
  | c, .pi a b => .pi (shiftTm k c a) (shiftTm k (c + 1) b)
  | c, .lam b => .lam (shiftTm k (c + 1) b)
  | c, .app f a => .app (shiftTm k c f) (shiftTm k c a)
  | c, .letE ty v b => .letE (shiftTm k c ty) (shiftTm k c v) (shiftTm k (c + 1) b)
  | c, .ann t ty => .ann (shiftTm k c t) (shiftTm k c ty)
  | c, .sorted l t => .sorted l (shiftTm k c t)
  | c, .piq q a b => .piq q (shiftTm k c a) (shiftTm k (c + 1) b)
  | c, .sigmaq q a b => .sigmaq q (shiftTm k c a) (shiftTm k (c + 1) b)
  | c, .sigma a b => .sigma (shiftTm k c a) (shiftTm k (c + 1) b)
  | c, .eq A a b => .eq (shiftTm k c A) (shiftTm k c a) (shiftTm k c b)
  | c, .eqRefl A a => .eqRefl (shiftTm k c A) (shiftTm k c a)
  | c, .pair a b => .pair (shiftTm k c a) (shiftTm k c b)
  | c, .fst t => .fst (shiftTm k c t)
  | c, .snd t => .snd (shiftTm k c t)
  | c, .con t => .con (shiftTm k c t)
  | c, .exfalso m t => .exfalso (shiftTm k c m) (shiftTm k c t)
  | _, t => t
inductive TmsR where
  | ok (ts : Tms)
  | err (msg : String)
-- the normal form of a term under `d` binders (to reduce applied templates: the kernel
-- can't infer the type of a λ applied to arguments)
def freshEnv : Nat → Env
  | .zero => .nil
  | .succ k => .cons (fresh k) (freshEnv k)
def nfAt (d : Nat) (t : Tm) : Tm := quote d (eval (freshEnv d) t)
def identOf (s : Syntax) : String := match strEq (kindOf s) "term.ident" with
  | .true => match kid s 0 with
    | .ident n => n
    | _ => "_"
  | .false => "_"
def bindAll : Scope → List String → Scope
  | sc, .nil => sc
  | sc, .cons x xs => bindAll (Scope.bind sc x) xs
def argsAre : List Syntax → List String → Bool
  | .nil, .nil => .true
  | .cons a as, .cons p ps => Bool.and (strEq (identOf a) p) (argsAre as ps)
  | _, _ => .false
-- a recursive field's type is `T` applied to the parameters `ps` (and, for an indexed
-- type, an index: `isRecField` gives it)
inductive RecF where
  | no
  | yes (idx : Option Syntax)
def lastS : List Syntax → Syntax
  | .nil => .missing
  | .cons s rest => match rest with
    | .nil => s
    | .cons _ _ => lastS rest
def argsPrefix : List Syntax → List String → Bool
  | _, .nil => .true
  | .cons a as, .cons p ps => Bool.and (strEq (identOf a) p) (argsPrefix as ps)
  | .nil, .cons _ _ => .false
def recField (T : String) (ps : List String) (nidx : Nat) (ty : Syntax) : RecF := match strEq (kindOf ty) "term.ident" with
  | .true => match Bool.and (strEq (identOf ty) T) (Bool.and (argsAre .nil ps) (Nat.beq nidx 0)) with
    | .true => .yes .none
    | .false => .no
  | .false => match strEq (kindOf ty) "term.app" with
    | .true =>
      let as := kids (kid ty 1);
      match Bool.and (strEq (identOf (kid ty 0)) T) (Bool.and (argsPrefix as ps) (Nat.beq (List.length as) (List.length ps + nidx))) with
      | .true => .yes (match nidx with
        | .zero => .none
        | .succ _ => .some (lastS as))
      | .false => .no
    | .false => .no
def isRecField (T : String) (ps : List String) (ty : Syntax) : Bool := match recField T ps 0 ty with
  | .yes _ => .true
  | .no => .false
-- the parameters as variables at depth `d`: `var (d - 1), …, var (d - np)`
def pvars : Nat → Nat → Tms
  | .zero, _ => .tnil
  | .succ k, d => .tcons (.var (d - 1)) (pvars k (d - 1))
def tmsDrop : Nat → Tms → Tms
  | .zero, ts => ts
  | .succ k, ts => match ts with
    | .tnil => .tnil
    | .tcons _ rest => tmsDrop k rest
def tmsTake : Nat → Tms → Tms
  | .zero, _ => .tnil
  | .succ k, ts => match ts with
    | .tnil => .tnil
    | .tcons t rest => .tcons t (tmsTake k rest)
def tmsLenF : Tms → Nat
  | .tnil => 0
  | .tcons _ rest => tmsLenF rest + 1
def tmsAppend : Tms → Tms → Tms
  | .tnil, b => b
  | .tcons t rest, b => .tcons t (tmsAppend rest b)
def shiftTms (k : Nat) : Tms → Tms
  | .tnil => .tnil
  | .tcons t rest => .tcons (shiftTm k 0 t) (shiftTms k rest)
-- `Π (x₁ : A₁) … B` for a telescope of types
def piTele : Tms → Tm → Tm
  | .tnil, b => b
  | .tcons a rest, b => .pi a (piTele rest b)
def fieldNames : List Field → List String
  | .nil => .nil
  | .cons (.mk x _) rest => .cons x (fieldNames rest)
def ctorName (c : Syntax) : String := match kid c 1 with
  | .ident n => n
  | _ => "_"
def ctorFields (c : Syntax) : List Field := fieldsOf (kids (kid c 2))

-- an index (`tt` without one), scope-checked in `sc` and closed at depth `d`
def idxTm (inline : Bool) (gs : Globals) (sc : Scope) (d : Nat) : Option Syntax → Elab
  | .none => .ok .star
  | .some s => match elab sc s with
    | .ok t => .ok (closeG inline gs d t)
    | e => e
-- **Exercise 16.1.** The description of a constructor's fields (`ctorDesc` in
-- `Inductive.lean`): a field `(x : A)` is `darg A (fun x => …)`, a recursive one (of
-- type `T ps j`, `recField`) is `drec j …`, and the end is `dret i`, `i` the
-- constructor's index `res` (`idxTm`: `tt` for a type without indices). A recursive
-- field binds no variable. `sc` is the scope (the globals, then the parameters, `t✝`
-- and the fields so far that are bound) and `d` the number of those binders, for
-- closing a field's type over the globals (`closeG inline gs d`).
def ctorDesc (inline : Bool) (gs : Globals) (T : String) (ps : List String) (nidx : Nat) (res : Option Syntax) : Scope → Nat → List Field → Elab
  --<sol
  | sc, d, .nil => match idxTm inline gs sc d res with
    | .ok i => .ok (.dret i)
    | e => e
  | sc, d, .cons (.mk x ty) rest => match recField T ps nidx ty with
    | .yes j => match idxTm inline gs sc d j with
      | .err m => .err m
      | .ok jt => match ctorDesc inline gs T ps nidx res sc d rest with
        | .ok D => .ok (.drec jt D)
        | e => e
    | .no => match elab sc ty with
      | .err m => .err m
      | .ok A => match ctorDesc inline gs T ps nidx res (Scope.bind sc x) (d + 1) rest with
        | .ok D => .ok (.darg (closeG inline gs d A) (.lam D))
        | e => e
  --|ex
  --| | _, _, _ => .err "not implemented"
  --sol>
-- a constructor's index: the last argument of its result type `T ps i`
def ctorRes (nidx : Nat) (c : Syntax) : Option Syntax := match nidx with
  | .zero => .none
  | .succ _ => match kids (kid c 3) with
    | .cons _ (.cons ty _) => .some (lastS (kids (kid ty 1)))
    | _ => .none

-- the constructors' descriptions, under the binder `t✝` of the tag
inductive Descs where
  | ok (ds : Tms)
  | err (msg : String)
def ctorDescs (inline : Bool) (gs : Globals) (T : String) (ps : List String) (nidx : Nat) : List Syntax → Descs
  | .nil => .ok .tnil
  | .cons c cs => match ctorDesc inline gs T ps nidx (ctorRes nidx c) (Scope.bind (bindAll (Globals.scope gs) ps) "t✝") (List.length ps + 1) (ctorFields c) with
    | .err m => .err m
    | .ok D => match ctorDescs inline gs T ps nidx cs with
      | .ok ds => .ok (.tcons D ds)
      | e => e
-- a constructor's fields with their types, every field bound in the later ones
inductive CFields where
  | ok (fs : List CField)
  | err (msg : String)
def idxArgs (gs : Globals) (sc : Scope) (d : Nat) : Option Syntax → TmsR
  | .none => .ok .tnil
  | .some s => match elab sc s with
    | .ok t => .ok (.tcons (closeG .false gs d t) .tnil)
    | .err m => .err m
def ctorFieldTys (gs : Globals) (T : String) (ps : List String) (nidx : Nat) (Tc TcI : Tm) : Scope → Nat → List Field → CFields
  | _, _, .nil => .ok .nil
  | sc, d, .cons (.mk x ty) rest =>
    let np := List.length ps;
    let A : CFields := match recField T ps nidx ty with
      | .yes j => match idxArgs gs sc d j with
        | .ok js => .ok (.cons (.mk x .true (tApps Tc (tmsAppend (pvars np d) js)) (tApps TcI (tmsAppend (pvars np d) js))) .nil)
        | .err m => .err m
      | .no => match elab sc ty with
        | .ok A => .ok (.cons (.mk x .false (closeG .false gs d A) (closeG .true gs d A)) .nil)
        | .err m => .err m;
    match A with
    | .err m => .err m
    | .ok f => match ctorFieldTys gs T ps nidx Tc TcI (Scope.bind sc x) (d + 1) rest with
      | .ok fs => .ok (List.append f fs)
      | e => e
-- a constructor's type: `(fields) → T`
def ctorType (Tc : Tm) : List CField → Tm
  | .nil => Tc
  | .cons (.mk _ _ A _) rest => .pi A (ctorType Tc rest)
-- the payload `(field₁, …, (tt, tt))`, the first field being `var (n - 1)`
def payloadTm : Nat → Nat → Tm
  | .zero, _ => .pair .star .star
  | .succ r, i => .pair (.var i) (payloadTm r (i - 1))
-- add the constructors from the `i`th on, collecting their fields
inductive Added where
  | ok (gs : Globals) (ctors : List Ctor)
  | err
-- the payload `(field₁, …, (p, tt))`, the first field being `var (n - 1)`, `p` the
-- proof that the index is the constructor's
def payloadP (p : Tm) : Nat → Nat → Tm
  | .zero, _ => .pair p .star
  | .succ r, i => .pair (.var i) (payloadP p r (i - 1))
-- A type with the sorts of the `Π`/`Σ` in its spine filled in where they are known
-- (`Sorts.type` in the Lean elaborator), and its sort: the types of declarations are
-- built without them (telescopes, constructor types), and type equality waits on a
-- `Π`/`Σ` without its sort. A sort is only written when the kernel's `sortOf` knows it.
inductive STm where
  | mk (t : Tm) (s : Option Lvl)
def STm.tm : STm → Tm
  | .mk t _ => t
-- (a defined type's sort comes from its declared type: unfolding it, as `sortOf` does,
-- would evaluate its whole description)
def leafSort (c : TCtx) (v : Val) : Option Lvl := match v with
  | .vglued h sp _ => match whnf (typeOfNe c h sp) with
    | .vsort l => .some l
    | _ => sortOf c v
  | v => sortOf c v
def sortLeaf (c : TCtx) (t : Tm) : STm := .mk t (leafSort c (eval (TCtx.env c) t))
def binTm (isPi : Bool) (q : Q) (a b : Tm) : Tm := match isPi with
  | .true => piTm q a b
  | .false => sigmaTm q a b
-- (a closed level is kept a number: a chain of `imax`es along a telescope would cost
-- the kernel's level normalization dearly)
def closedLvl (l : Lvl) : Lvl := match lvlClosed l with
  | .some n => .lnum n
  | .none => l
def binLvl (isPi : Bool) (i j : Lvl) : Lvl := match isPi with
  | .true => closedLvl (.limax i j)
  | .false => closedLvl (.lmax i j)
def sortJoin (isPi : Bool) (q : Q) (a b : STm) : STm := match a, b with
  | .mk a' (.some i), .mk b' (.some j) => .mk (.sorted (binLvl isPi i j) (binTm isPi q a' b')) (.some (binLvl isPi i j))
  | .mk a' _, .mk b' _ => .mk (binTm isPi q a' b') .none
def sortUnder (c : TCtx) (a : STm) : TCtx := TCtx.bind c (eval (TCtx.env c) (STm.tm a))
def sortSpine : TCtx → Tm → STm
  | c, .pi a b => let sa := sortSpine c a; sortJoin .true .qw sa (sortSpine (sortUnder c sa) b)
  | c, .piq q a b => let sa := sortSpine c a; sortJoin .true q sa (sortSpine (sortUnder c sa) b)
  | c, .sigma a b => let sa := sortSpine c a; sortJoin .false .qw sa (sortSpine (sortUnder c sa) b)
  | c, .sigmaq q a b => let sa := sortSpine c a; sortJoin .false q sa (sortSpine (sortUnder c sa) b)
  | _, .sorted l t => .mk (.sorted l t) (.some l)
  | c, t => sortLeaf c t
-- a closed type with its sorts (`sortSpine`)
def sortTy (t : Tm) : Tm := STm.tm (sortSpine empty t)
def addCtors (T : String) (ps : List String) (pts : Tms) (nidx : Nat) (I : Tm) (Tc TcI : Tm) (k : Nat) : Globals → Nat → List Syntax → Added
  | gs, _, .nil => .ok gs .nil
  | gs, i, .cons c cs =>
    let n := List.length (ctorFields c);
    let np := List.length ps;
    let scF := bindAll (bindAll (Globals.scope gs) ps) (fieldNames (ctorFields c));
    match ctorFieldTys gs T ps nidx Tc TcI (bindAll (Globals.scope gs) ps) np (ctorFields c) with
    | .err _ => .err
    | .ok fs => match idxArgs gs scF (np + n) (ctorRes nidx c) with
      | .err _ => .err
      | .ok ics =>
        let ty := sortTy (piTele pts (ctorType (tApps Tc (tmsAppend (pvars np (np + n)) ics)) fs));
        let proof : Tm := match ics with
          | .tcons ic _ => .eqRefl (shiftTm n 0 I) ic
          | .tnil => .star;
        let v := tLams (np + n) (.con (.pair (.tag k i) (payloadP proof n (n - 1))));
        match check empty v (eval .nil ty) with
        | .err _ => .err
        | .ok _ _ => match addCtors T ps pts nidx I Tc TcI k (Globals.add gs (.mk (String.append (String.append T ".") (ctorName c)) ty v v
          (List.append (trues np) (falses n)))) (i + 1) cs with
        | .ok gs' rest => .ok gs' (.cons (.mk (ctorName c) fs (match ics with
          | .tcons ic _ => ic
          | .tnil => .star)) rest)
        | .err => .err
-- the types of a telescope, each over the ones before
def elabTele (gs : Globals) : Scope → Nat → List Field → TmsR
  | _, _, .nil => .ok .tnil
  | sc, d, .cons (.mk x ty) rest => match elab sc ty with
    | .err m => .err m
    | .ok A => match elabTele gs (Scope.bind sc x) (d + 1) rest with
      | .ok ts => .ok (.tcons (closeG .false gs d A) ts)
      | e => e
-- the index type of a signature `I → Type` (or `(i : I) → Type`); `none` for `Type`
inductive Sig where
  | plain
  | indexed (I : Syntax)
  | bad
def sigOf (stx : Syntax) : Sig := match kids (kid stx 4) with
  | .cons _ (.cons ty _) => match strEq (kindOf ty) "term.type" with
    | .true => .plain
    | .false => match strEq (kindOf ty) "term.arrow" with
      | .true => match strEq (kindOf (kid ty 2)) "term.type" with
        | .true => .indexed (kid ty 0)
        | .false => .bad
      | .false => match strEq (kindOf ty) "term.depArrow" with
        | .true => match binderType (kid ty 0) with
          | .some I => match strEq (kindOf (kid ty 2)) "term.type" with
            | .true => .indexed I
            | .false => .bad
          | .none => .bad
        | .false => .bad
  | _ => .plain
-- in an indexed family `T : I → Type`, an index `.c` (the last argument of `T …` in the
-- constructors) is `I.c`: the constructors are scope-checked, not typed (stage 19d)
def takeS : Nat → List Syntax → List Syntax
  | .zero, _ => .nil
  | .succ n, xs => match xs with
    | .nil => .nil
    | .cons x rest => .cons x (takeS n rest)
def lastS' : List Syntax → Syntax
  | .nil => .missing
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => lastS' rest
def lastIdx : List Syntax → Nat → Nat
  | .nil, _ => 0
  | .cons _ rest, i => match rest with
    | .nil => i
    | .cons _ _ => lastIdx rest (i + 1)
mutual
def fixDots (T I : String) (s : Syntax) : Syntax := match s with
  | .node k args =>
    let s' : Syntax := .node k (fixDotsArgs T I args);
    match Bool.and (strEq k "term.app") (strEq (identOf (kid s' 0)) T) with
    | .true =>
      let as := kids (kid s' 1);
      let n := lastIdx as 0;
      let a := lastS' as;
      match strEq (kindOf a) "term.dotIdent" with
      | .true => match kid a 1 with
        | .ident c => mkNode "term.app" (.cons (kid s' 0) (one (mkNull (List.append (takeS n as)
            (one (mkNode "term.ident" (one (.ident (String.append (String.append I ".") c)))))))))
        | _ => s'
      | .false => s'
    | .false => s'
  | s => s
def fixDotsArgs (T I : String) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (fixDots T I s) (fixDotsArgs T I rest)
end
def inductiveCmd (gs : Globals) (stx0 : Syntax) : Step := match kid stx0 1 with
  | .ident T =>
    let stx := match sigOf stx0 with
      | .indexed I => match strEq (kindOf I) "term.ident" with
        | .true => fixDots T (identOf I) stx0
        | .false => stx0
      | _ => stx0;
    let params := fieldsOf (kids (kid stx 3));
    let ps := fieldNames params;
    let np := List.length ps;
    let ctors := kids (kid stx 6);
    let k := List.length ctors;
    let sig := sigOf stx;
    let nidx := match sig with
      | .indexed _ => 1
      | _ => 0;
    match elabTele gs (Globals.scope gs) 0 params with
    | .err m => errStep gs m
    | .ok pts =>
      -- the index type, over the parameters
      let Ir : Elab := match sig with
        | .indexed I => match elab (bindAll (Globals.scope gs) ps) I with
          | .ok t => .ok (closeG .false gs np t)
          | e => e
        | .plain => .ok (.unit 0)
        | .bad => .err "an inductive type's signature must be Type or I → Type";
      match Ir with
      | .err m => errStep gs m
      | .ok I =>
        let mkD := fun (ds : Tms) => (.darg (.enum k) (.lam (.ecase (.descr 0 (shiftTm 1 0 I)) (.var 0) ds)) : Tm);
        match ctorDescs .false gs T ps nidx ctors with
        | .err m => errStep gs m
        | .ok ds => match ctorDescs .true gs T ps nidx ctors with
          | .err m => errStep gs m
          | .ok dsI =>
            -- `fun ps => μ D tt`, or `fun ps i => μ D i`
            let body := fun (D : Tm) => (match sig with
              | .indexed _ => .lam (.mu 0 (shiftTm 1 0 I) (nfAt (np + 1) (tApps (tLams np D) (pvars np (np + 1)))) (.var 0))
              | _ => .mu 0 (.unit 0) D .star : Tm);
            let ty := sortTy (piTele pts (match sig with
              | .indexed _ => .pi I (.univ 0)
              | _ => .univ 0));
            let val := tLams np (body (mkD ds));
            match check empty val (eval .nil ty) with
            | .err m => errStep gs m
            | .ok _ _ =>
              let valI := tLams np (body (mkD dsI));
              let gs1 := Globals.add gs (.mk T ty val valI .nil);
              match addCtors T ps pts nidx I (.const T .nil .nil val ty) valI k gs1 0 ctors with
              | .err => errStep gs "ill-typed constructor"
              | .ok gs2 cs => .mk (String.append T (String.append " : " (show .nil 0 ty)))
                  (Globals.addInd gs2 T (.mk np I (mkD ds) (mkD dsI) cs .none (.const T .nil .nil val ty)))
  | _ => errStep gs "an inductive type needs a name"

def sndN : Nat → Tm → Tm
  | .zero, t => t
  | .succ n, t => sndN n (.snd t)

def takeL {A : Type} : Nat → List A → List A
  | .zero, _ => .nil
  | .succ k, xs => match xs with
    | .nil => .nil
    | .cons x rest => .cons x (takeL k rest)
def dropL {A : Type} : Nat → List A → List A
  | .zero, xs => xs
  | .succ k, xs => match xs with
    | .nil => .nil
    | .cons _ rest => dropL k rest

-- Typed elaboration (stage 17): implicit arguments. A metavariable `?mN` is an opaque
-- constant (the kernel's `axiomC`) of type `Π Γ. A`, applied to the variables of the
-- context `Γ` where it was made, so a solution is a term over `Γ`. Unification solves
-- `?mN Γ =?= t` when `t` lives in `Γ`; elaborated terms are zonked (the solutions put
-- in) before the kernel checks them.

-- an elaboration context: the kernel's (values, types) and the names
-- (and the binders' types quoted, latest first, each when first needed: a new
-- metavariable's type is a Π over the whole context, and quoting every type again for
-- each one made big definitions run out of memory: stage 20b)
inductive Cx where
  | mk (c : TCtx) (sc : Scope) (tele : List (Unit → Tm))
def Cx.c : Cx → TCtx
  | .mk c _ _ => c
def Cx.sc : Cx → Scope
  | .mk _ sc _ => sc
def Cx.tele : Cx → List (Unit → Tm)
  | .mk _ _ t => t
def Cx.lvl (cx : Cx) : Nat := TCtx.lvl (Cx.c cx)
def Cx.bind (cx : Cx) (x : String) (ty : Val) : Cx := match cx with
  | .mk c sc t =>
    let d := TCtx.lvl c;
    .mk (TCtx.bind c ty) (Scope.bind sc x) (.cons (memo (fun _ => quote d ty)) t)
-- (a `let`'s variable is glued to its value: it quotes back as the variable, so the
-- metavariables applied to the context don't carry every `let`'s value along)
def Cx.define (cx : Cx) (x : String) (v ty : Val) : Cx := match cx with
  | .mk c sc t =>
    let d := TCtx.lvl c;
    .mk (TCtx.define c (.vglued (.hvar d) .snil (memo (fun _ => v))) ty) (Scope.bind sc x) (.cons (memo (fun _ => quote d ty)) t)
-- the metavariables: the depth each was made at, and its solution (a term at that depth)
inductive MetaInfo where
  | mk (depth : Nat) (sol : Option Tm)
-- a postponed argument: its syntax, type and context, and the metavariable standing for it
inductive Pend where
  | mk (s : Syntax) (dom : Val) (m : Tm) (cx : Cx)
inductive ES where
  | mk (metas : Array MetaInfo) (pending : List Pend)
def ES.empty : ES := .mk Array.empty .nil
def ES.get (es : ES) (i : Nat) : MetaInfo := match es with
  | .mk ms _ => Array.getD ms i (.mk 0 .none)
def ES.pend (es : ES) (p : Pend) : ES := match es with
  | .mk ms ps => .mk ms (.cons p ps)
def metaName (i : Nat) : String := String.append "?m" (Nat.toString i)
-- the number of a metavariable's name
def metaId (n : String) : Option Nat := match n with
  | .mk cs => match cs with
    | .cons a (.cons b rest) => match Bool.and (Nat.beq (Char.code a) 63) (Nat.beq (Char.code b) 109) with
      | .true => .some (digits rest 0)
      | .false => .none
    | _ => .none
-- the types of the context's variables as a telescope, from level `l` on
def teleOf : List (Unit → Tm) → Tms → Tms
  | .nil, acc => acc
  | .cons t rest, acc => teleOf rest (.tcons (t ()) acc)
-- a new metavariable of type `A`, as a term: `?mN x₀ … xₙ₋₁`
inductive MetaR where
  | mk (t : Tm) (es : ES)
def newMeta (es : ES) (cx : Cx) (A : Val) : MetaR := match es with
  | .mk ms ps =>
    let d := Cx.lvl cx;
    let id := Array.size ms;
    let ty := piTele (teleOf (Cx.tele cx) .tnil) (quote d A);
    .mk (tApps (.axiomC (metaName id) ty) (pvars d d)) (.mk (Array.push ms (.mk d .none)) ps)

-- a spine's arguments, first first (`none` if it isn't only applications)
def spineArgs : Spine → Option (List Val)
  | .snil => .some .nil
  | .sapp sp a => match spineArgs sp with
    | .some as => .some (List.append as (.cons a .nil))
    | .none => .none
  | _ => .none
def envOf : List Val → Env → Env
  | .nil, acc => acc
  | .cons a rest, acc => envOf rest (.cons a acc)
def applyAll : Val → List Val → Val
  | f, .nil => f
  | f, .cons a rest => applyAll (vapp f a) rest
-- a solved metavariable's application, replaced by its solution
partial def force (es : ES) (v : Val) : Val := match whnf v with
  | .vne (.haxiom n _) sp => match metaId n with
    | .some i => match ES.get es i with
      | .mk k (.some sol) => match spineArgs sp with
        | .some as => force es (applyAll (eval (envOf (takeL k as) .nil) sol) (dropL k as))
        | .none => v
      | _ => v
    | .none => v
  | _ => v
-- an unsolved metavariable applied to its context: its number and depth
inductive MetaApp where
  | mk (i k : Nat)
  | none
def metaApp (es : ES) (v : Val) : MetaApp := match v with
  | .vne (.haxiom n _) sp => match metaId n with
    | .some i => match ES.get es i with
      | .mk k .none => match spineArgs sp with
        | .some as => match Nat.beq (List.length as) k with
          | .true => .mk i k
          | .false => .none
        | .none => .none
      | _ => .none
    | .none => .none
  | _ => .none
-- a term at depth `d` moved to depth `d - k`, if it doesn't use the `k` variables in
-- between (only for the forms solutions take)
def lowerTm (k : Nat) : Nat → Tm → Option Tm
  | c, .var i => match Nat.lt i c with
    | .true => .some (.var i)
    | .false => match Nat.lt (i - c) k with
      | .true => .none
      | .false => .some (.var (i - k))
  | c, .pi a b => match lowerTm k c a with
    | .some a' => match lowerTm k (c + 1) b with
      | .some b' => .some (.pi a' b')
      | .none => .none
    | .none => .none
  | c, .lam b => match lowerTm k (c + 1) b with
    | .some b' => .some (.lam b')
    | .none => .none
  | c, .sorted l t => match lowerTm k c t with
    | .some t' => .some (.sorted l t')
    | .none => .none
  | c, .app f a => match lowerTm k c f with
    | .some f' => match lowerTm k c a with
      | .some a' => .some (.app f' a')
      | .none => .none
    | .none => .none
  -- (projections and pairs: the fields of a pattern are projections of its payload)
  | c, .fst t => match lowerTm k c t with
    | .some t' => .some (.fst t')
    | .none => .none
  | c, .snd t => match lowerTm k c t with
    | .some t' => .some (.snd t')
    | .none => .none
  | c, .con t => match lowerTm k c t with
    | .some t' => .some (.con t')
    | .none => .none
  | c, .pair a b => match lowerTm k c a with
    | .some a' => match lowerTm k c b with
      | .some b' => .some (.pair a' b')
      | .none => .none
    | .none => .none
  | _, .const n ps ls v ty => .some (.const n ps ls v ty)
  | _, .axiomC n ty => .some (.axiomC n ty)
  | _, .univ n => .some (.univ n)
  | _, .prop => .some .prop
  | _, .sortL l => .some (.sortL l)
  | _, .unit n => .some (.unit n)
  | _, .star => .some .star
  | _, .enum k => .some (.enum k)
  | _, .tag k i => .some (.tag k i)
  | _, _ => .none
-- does the term mention metavariable `i`?
def mentions (i : Nat) : Tm → Bool
  | .axiomC n _ => match metaId n with
    | .some j => Nat.beq i j
    | .none => .false
  | .pi a b => Bool.or (mentions i a) (mentions i b)
  | .lam b => mentions i b
  | .sorted _ t => mentions i t
  | .app f a => Bool.or (mentions i f) (mentions i a)
  | .fst t => mentions i t
  | .snd t => mentions i t
  | .con t => mentions i t
  | .pair a b => Bool.or (mentions i a) (mentions i b)
  | _ => .false
-- Pruning (stage 20a): a solution at depth `k` that mentions a metavariable of a deeper
-- context (`?m := List ?n` with `?n` made under more `let`s) can't be lowered; when that
-- metavariable's type doesn't depend on the deeper variables, it is solved by a new one
-- at depth `k`, applied to the first `k` variables, and the solution is lowered again
def piCod : Nat → Tm → Option Tm
  | .zero, t => .some t
  | .succ n, t => match t with
    | .pi _ b => piCod n b
    | _ => .none
def piPrefix : Nat → Tm → Tm → Option Tm
  | .zero, _, B => .some B
  | .succ n, t, B => match t with
    | .pi a b => match piPrefix n b B with
      | .some r => .some (.pi a r)
      | .none => .none
    | _ => .none
def spineHead : Tm → Tm
  | .app f _ => spineHead f
  | t => t
def spineArgsTm : Tm → List Tm → List Tm
  | .app f a, acc => spineArgsTm f (.cons a acc)
  | _, acc => acc
def appsL : Tm → List Tm → Tm
  | f, .nil => f
  | f, .cons a rest => appsL (.app f a) rest
inductive Pruned where
  | mk (es : ES) (t : Tm)
-- prune the deeper metavariables in `t` (applications, Π types and the like)
partial def pruneTm (k d : Nat) (es : ES) (t : Tm) : Pruned := match spineHead t with
  | .axiomC n ty => match metaId n with
    | .some j => match ES.get es j with
      -- (a solved one is replaced by its solution first)
      | .mk _ (.some _) => pruneTm k d es (quote d (force es (eval (freshEnv d) t)))
      | .mk kj .none => match Nat.lt k kj with
        | .true => match piCod kj ty with
          | .some A => match lowerTm (kj - k) 0 A with
            | .some Ak => match piPrefix k ty Ak with
              | .some nty => match es with
                | .mk ms ps =>
                  let id := Array.size ms;
                  let fresh : Tm := .axiomC (metaName id) nty;
                  let ms1 := Array.push ms (.mk k .none);
                  .mk (.mk (Array.set ms1 j (.mk kj (.some (tApps fresh (pvars k kj))))) ps)
                    (appsL fresh (takeL k (spineArgsTm t .nil)))
              | .none => .mk es t
            | .none => .mk es t
          | .none => .mk es t
        | .false => .mk es t
      | _ => .mk es t
    | .none => .mk es t
  | _ => match t with
    | .app f a => match pruneTm k d es f with
      | .mk es1 f' => match pruneTm k d es1 a with
        | .mk es2 a' => .mk es2 (.app f' a')
    | .pi a b => match pruneTm k d es a with
      | .mk es1 a' => match pruneTm k (d + 1) es1 b with
        | .mk es2 b' => .mk es2 (.pi a' b')
    | .lam b => match pruneTm k (d + 1) es b with
      | .mk es1 b' => .mk es1 (.lam b')
    | t' => .mk es t'
def solve (es0 : ES) (cx : Cx) (i k : Nat) (t : Val) : Option ES :=
  let d := Cx.lvl cx;
  let tm0 := quote d t;
  let pr := match lowerTm (d - k) 0 tm0 with
    | .some _ => Pruned.mk es0 tm0
    | .none => pruneTm k d es0 tm0;
  match pr with
  | .mk es tm =>
  match mentions i tm with
  | .true => .none
  -- (at the metavariable's own depth nothing is lowered: any term will do, like a
  -- postponed `match` argument's: stage 20a)
  | .false => match (match Nat.beq d k with
      | .true => Option.some tm
      | .false => lowerTm (d - k) 0 tm) with
    | .some sol => match es with
      | .mk ms ps => .some (.mk (Array.set ms i (.mk k (.some sol))) ps)
    | .none => .none
mutual
-- unify two values (types, mostly) at depth `cx`, solving metavariables
def unify (es : ES) (cx : Cx) (a b : Val) : Option ES :=
  let a' := force es a;
  let b' := force es b;
  match metaApp es a' with
  | .mk i k => match metaApp es b' with
    | .mk j _ => match Nat.beq i j with
      | .true => .some es
      | .false => solve es cx i k b'
    | .none => solve es cx i k b'
  | .none => match metaApp es b' with
    | .mk j k => solve es cx j k a'
    | .none => unifyW es cx a' b'
def unifyW (es : ES) (cx : Cx) (a b : Val) : Option ES := match a with
  | .vglued h sp va => match b with
    | .vglued h' sp' vb => match convHead (Cx.c cx) h h' with
      | .true => match unifySpine es cx sp sp' with
        | .some es' => .some es'
        | .none => unifyS es cx (whnf a) (whnf b)
      -- different definitions: unfold one step while one side unfolds to another
      -- definition (`Syntax` is `SyntaxF .true`: stage 19d)
      | .false => match va () with
        | .vglued _ _ _ => unifyW es cx (va ()) b
        | _ => match vb () with
          | .vglued _ _ _ => unifyW es cx a (vb ())
          | _ => unifyS es cx (whnf a) (whnf b)
    | _ => unifyS es cx (whnf a) (whnf b)
  | _ => unifyS es cx (whnf a) (whnf b)
def unifyS (es : ES) (cx : Cx) (a b : Val) : Option ES := match a with
  | .vpi q A e B _ => match b with
    | .vpi q' A' e' B' _ => match qEq q q' with
      | .true => match unify es cx A A' with
        | .some es1 =>
          let x := fresh (Cx.lvl cx);
          unify es1 (Cx.bind cx "_" A) (eval (.cons x e) B) (eval (.cons x e') B')
        | .none => .none
      | .false => .none
    | _ => unifyConv es cx a b
  | .vne h sp => match b with
    | .vne h' sp' => match convHead (Cx.c cx) h h' with
      | .true => unifySpine es cx sp sp'
      | .false => .none
    | _ => unifyConv es cx a b
  | _ => unifyConv es cx a b
-- (no metavariables left to solve: the kernel's conversion)
def unifyConv (es : ES) (cx : Cx) (a b : Val) : Option ES := match convTy (Cx.c cx) a b with
  | .true => .some es
  | .false => .none
def unifySpine (es : ES) (cx : Cx) (sp sp' : Spine) : Option ES := match sp with
  | .snil => match sp' with
    | .snil => .some es
    | _ => .none
  | .sapp r a => match sp' with
    | .sapp r' a' => match unifySpine es cx r r' with
      | .some es1 => unify es1 cx a a'
      | .none => .none
    | _ => .none
  | _ => .none
end

-- put the solutions into a term (at depth `d`): `none` if a metavariable is unsolved
inductive MH where
  | mk (i n : Nat)
  | none
def metaHead : Tm → Nat → MH
  | .axiomC n _, k => match metaId n with
    | .some i => .mk i k
    | .none => .none
  | .app f _, k => metaHead f (k + 1)
  | _, _ => .none
def appArgs : Tm → List Tm → List Tm
  | .app f a, acc => appArgs f (.cons a acc)
  | _, acc => acc
def tAppsL : Tm → List Tm → Tm
  | f, .nil => f
  | f, .cons a rest => tAppsL (.app f a) rest
def tms6 (a b c e f g : Tm) : Tms := .tcons a (.tcons b (.tcons c (.tcons e (.tcons f (.tcons g .tnil)))))
mutual
def zonk (es : ES) (d : Nat) (t : Tm) : Option Tm := match metaHead t 0 with
  | .mk i _ => match ES.get es i with
    | .mk k (.some sol) => match zonk es k sol with
      | .some sol' =>
        let extra := dropL k (appArgs t .nil);
        match extra with
        | .nil => .some (shiftTm (d - k) 0 sol')
        | _ => match zonkAll es d extra with
          | .some extra' => .some (nfAt d (tAppsL (shiftTm (d - k) 0 sol') extra'))
          | .none => .none
      | .none => .none
    | _ => .none
  | .none => match t with
    | .pi a b => match zonk es d a with
      | .some a' => match zonk es (d + 1) b with
        | .some b' => .some (.pi a' b')
        | .none => .none
      | .none => .none
    | .lam b => match zonk es (d + 1) b with
      | .some b' => .some (.lam b')
      | .none => .none
    | .app f a => match zonk es d f with
      | .some f' => match zonk es d a with
        | .some a' => .some (.app f' a')
        | .none => .none
      | .none => .none
    | .letE ty v b => match zonk es d ty with
      | .some ty' => match zonk es d v with
        | .some v' => match zonk es (d + 1) b with
          | .some b' => .some (.letE ty' v' b')
          | .none => .none
        | .none => .none
      | .none => .none
    | .ann x ty => match zonk es d x with
      | .some x' => match zonk es d ty with
        | .some ty' => .some (.ann x' ty')
        | .none => .none
      | .none => .none
    | .sorted l x => match zonk es d x with
      | .some x' => .some (.sorted l x')
      | .none => .none
    -- (the other forms a match or a postponed argument leaves: stage 20a)
    | .sigma a b => match zonk es d a with
      | .some a' => match zonk es (d + 1) b with
        | .some b' => .some (.sigma a' b')
        | .none => .none
      | .none => .none
    | .letq q ty v b => match zonk es d ty with
      | .some ty' => match zonk es d v with
        | .some v' => match zonk es (d + 1) b with
          | .some b' => .some (.letq q ty' v' b')
          | .none => .none
        | .none => .none
      | .none => .none
    | .piq q a b => match zonk es d a with
      | .some a' => match zonk es (d + 1) b with
        | .some b' => .some (.piq q a' b')
        | .none => .none
      | .none => .none
    | .sigmaq q a b => match zonk es d a with
      | .some a' => match zonk es (d + 1) b with
        | .some b' => .some (.sigmaq q a' b')
        | .none => .none
      | .none => .none
    | .ecase m sc bs => match zonk es (d + 1) m with
      | .some m' => match zonk es d sc with
        | .some sc' => match zonkTms es d bs with
          | .some bs' => .some (.ecase m' sc' bs')
          | .none => .none
        | .none => .none
      | .none => .none
    | .ind l I D v P m i x => match zonkTms es d (tms6 I D P m i x) with
      | .some ts => match ts with
        | .tcons I' (.tcons D' (.tcons P' (.tcons m' (.tcons i' (.tcons x' _))))) => .some (.ind l I' D' v P' m' i' x')
        | _ => .none
      | .none => .none
    | .scase l I D v P m sz i x => match zonkTms es d (.tcons sz (tms6 I D P m i x)) with
      | .some ts => match ts with
        | .tcons sz' (.tcons I' (.tcons D' (.tcons P' (.tcons m' (.tcons i' (.tcons x' _)))))) => .some (.scase l I' D' v P' m' sz' i' x')
        | _ => .none
      | .none => .none
    | t' => match zonkSub es d t' with
      | .some t'' => .some t''
      | .none => .none
-- the forms whose parts are all at the same depth
def zonkSub (es : ES) (d : Nat) (t : Tm) : Option Tm := match t with
  | .fst x => zonk1 es d x (fun x' => .fst x')
  | .snd x => zonk1 es d x (fun x' => .snd x')
  | .con x => zonk1 es d x (fun x' => .con x')
  | .dret i => zonk1 es d i (fun i' => .dret i')
  | .tyRefl X => zonk1 es d X (fun X' => .tyRefl X')
  | .pair a b => zonk2 es d a b (fun a' b' => .pair a' b')
  | .darg S D => zonk2 es d S D (fun S' D' => .darg S' D')
  | .drec j D => zonk2 es d j D (fun j' D' => .drec j' D')
  | .eqTy A B => zonk2 es d A B (fun A' B' => .eqTy A' B')
  | .eqRefl A a => zonk2 es d A a (fun A' a' => .eqRefl A' a')
  | .exfalso m x => zonk2 es d m x (fun m' x' => .exfalso m' x')
  | .eq A a b => match zonkTms es d (.tcons A (.tcons a (.tcons b .tnil))) with
    | .some (.tcons A' (.tcons a' (.tcons b' _))) => .some (.eq A' a' b')
    | _ => .none
  | .mu l I D i => match zonkTms es d (.tcons I (.tcons D (.tcons i .tnil))) with
    | .some (.tcons I' (.tcons D' (.tcons i' _))) => .some (.mu l I' D' i')
    | _ => .none
  | .coe A B e x => match zonkTms es d (.tcons A (.tcons B (.tcons e (.tcons x .tnil)))) with
    | .some (.tcons A' (.tcons B' (.tcons e' (.tcons x' _)))) => .some (.coe A' B' e' x')
    | _ => .none
  | .out x => zonk1 es d x (fun x' => .out x')
  | .cocon x => zonk1 es d x (fun x' => .cocon x')
  | .delim v P mr ma mc mh D => match zonkTms es d (tms6 P mr ma mc mh D) with
    | .some (.tcons P' (.tcons mr' (.tcons ma' (.tcons mc' (.tcons mh' (.tcons D' _)))))) => .some (.delim v P' mr' ma' mc' mh' D')
    | _ => .none
  | .nu l I D i sz => match zonkTms es d (.tcons I (.tcons D (.tcons i (.tcons sz .tnil)))) with
    | .some (.tcons I' (.tcons D' (.tcons i' (.tcons sz' _)))) => .some (.nu l I' D' i' sz')
    | _ => .none
  | .szSuc x => zonk1 es d x (fun x' => .szSuc x')
  | .sizeLt x => zonk1 es d x (fun x' => .sizeLt x')
  | .descr l I => zonk1 es d I (fun I' => .descr l I')
  | .dhrec H j D => match zonkTms es d (.tcons H (.tcons j (.tcons D .tnil))) with
    | .some (.tcons H' (.tcons j' (.tcons D' _))) => .some (.dhrec H' j' D')
    | _ => .none
  | .mus l I D i sz => match zonkTms es d (.tcons I (.tcons D (.tcons i (.tcons sz .tnil)))) with
    | .some (.tcons I' (.tcons D' (.tcons i' (.tcons sz' _)))) => .some (.mus l I' D' i' sz')
    | _ => .none
  | .subst A a P p b e => match zonkTms es d (tms6 A a P p b e) with
    | .some (.tcons A' (.tcons a' (.tcons P' (.tcons p' (.tcons b' (.tcons e' _)))))) => .some (.subst A' a' P' p' b' e')
    | _ => .none
  | t' => .some t'
def zonk1 (es : ES) (d : Nat) (x : Tm) (k : Tm → Tm) : Option Tm := match zonk es d x with
  | .some x' => .some (k x')
  | .none => .none
def zonk2 (es : ES) (d : Nat) (x y : Tm) (k : Tm → Tm → Tm) : Option Tm := match zonk es d x with
  | .some x' => match zonk es d y with
    | .some y' => .some (k x' y')
    | .none => .none
  | .none => .none
def zonkTms (es : ES) (d : Nat) : Tms → Option Tms
  | .tnil => .some .tnil
  | .tcons t rest => match zonk es d t with
    | .some t' => match zonkTms es d rest with
      | .some r => .some (.tcons t' r)
      | .none => .none
    | .none => .none
def zonkAll (es : ES) (d : Nat) : List Tm → Option (List Tm)
  | .nil => .some .nil
  | .cons t rest => match zonk es d t with
    | .some t' => match zonkAll es d rest with
      | .some r => .some (.cons t' r)
      | .none => .none
    | .none => .none
end

inductive HE where
  | ok (t : Tm) (ty : Val) (es : ES) (mask : List Bool)
  | err (msg : String)
-- the arguments of `if`: before `then`, between `then` and `else`, after `else`
inductive IfParts where
  | mk (c a b : List Syntax)
def isNilS : List Syntax → Bool
  | .nil => .true
  | .cons _ _ => .false
inductive Two where
  | mk (a b : List Syntax)
def splitElse : List Syntax → List Syntax → Option Two
  | .nil, _ => .none
  | .cons x rest, acc => match strEq (identOf x) "else" with
    | .true => .some (.mk (List.reverseOf acc .nil) rest)
    | .false => splitElse rest (.cons x acc)
def splitIf : List Syntax → List Syntax → Option IfParts
  | .nil, _ => .none
  | .cons x rest, acc => match strEq (identOf x) "then" with
    | .true => match splitElse rest .nil with
      | .some (.mk a b) => .some (.mk (List.reverseOf acc .nil) a b)
      | .none => .none
    | .false => splitIf rest (.cons x acc)
-- one term, or the application of the first to the rest
def appOf : List Syntax → Syntax
  | .nil => .missing
  | .cons f rest => match rest with
    | .nil => f
    | .cons _ _ => mkNode "term.app" (.cons f (one (mkNull rest)))
-- `if c then a else b` (an application of `if`: the grammar has no `if`) is
-- `match c with | .true => a | .false => b` (stage 19a)
def ifMatch (s : Syntax) : Option Syntax := match Bool.and (strEq (kindOf s) "term.app") (strEq (identOf (kid s 0)) "if") with
  | .false => .none
  | .true => match splitIf (kids (kid s 1)) .nil with
    | .some (.mk cs as bs) => match Bool.and (Bool.not (isNilS cs)) (Bool.and (Bool.not (isNilS as)) (Bool.not (isNilS bs))) with
      | .true =>
        let c := appOf cs;
        let a := appOf as;
        let b := appOf bs;
        let alt := fun (ctor : String) (rhs : Syntax) => mkNode "match.alt" (.cons (.atom "|")
          (.cons (mkNull (one (mkNode "term.dotIdent" (.cons (.atom ".") (one (.ident ctor)))))) (.cons (.atom "=>") (one rhs))));
        .some (mkNode "term.match" (.cons (.atom "match") (.cons (mkNull (one c)) (.cons (.atom "with")
          (one (mkNull (.cons (alt "true" a) (one (alt "false" b)))))))))
      | .false => .none
    | _ => .none
-- a string literal's text (the first atom inside)
partial def strValue (s : Syntax) : String := match s with
  | .atom v => v
  | .node _ _ => strValue (kid s 0)
  | _ => ""
-- a numeral's value (its digits are the first atom inside)
partial def numValue (s : Syntax) : Nat := match s with
  | .atom d => match d with
    | .mk cs => digits cs 0
  | .node _ _ => numValue (kid s 0)
  | _ => 0
def iterApp (f : Tm) : Nat → Tm → Tm
  | .zero, t => t
  | .succ k, t => iterApp f k (.app f t)
-- (a big numeral is built in binary when `Nat.mul` is there: `2 * (n / 2)`, plus one if
-- `n` is odd; `succ` applied 100000 times would be a term of that depth: stage 19f)
partial def halfNat : Nat → Nat
  | .zero => 0
  | .succ .zero => 0
  | .succ (.succ j) => halfNat j + 1
partial def binNat (sc z mul : Tm) (n : Nat) : Tm := match Nat.lt n 16 with
  | .true => iterApp sc n z
  | .false =>
    let h := halfNat n;
    let t : Tm := .app (.app mul (iterApp sc 2 z)) (binNat sc z mul h);
    match Nat.beq (h + h) n with
    | .true => t
    | .false => .app sc t
-- `a.b.c` as `a.b` and `c`
inductive Split where
  | mk (base field : String)
def lastDot : List Char → Nat → Option Nat → Option Nat
  | .nil, _, best => best
  | .cons c rest, i, best => lastDot rest (i + 1) (match Nat.beq (Char.code c) 46 with
    | .true => .some i
    | .false => best)
def splitLast (n : String) : Option Split := match n with
  | .mk cs => match lastDot cs 0 .none with
    | .some i => match Nat.lt 0 i with
      | .true => .some (.mk (.mk (takeL i cs)) (.mk (dropL (i + 1) cs)))
      | .false => .none
    | .none => .none
-- the arguments still waiting, while some can be done
inductive DR where
  | ok (es : ES) (progress : Bool)
  | err
-- a postponed argument: its syntax, type, and the metavariable standing for it
inductive Post where
  | mk (s : Syntax) (dom : Val) (m : Tm)
partial def unparen (s : Syntax) : Syntax := match strEq (kindOf s) "term.paren" with
  | .true => unparen (kid s 1)
  | .false => s
partial def isDotStx (s : Syntax) : Bool := match strEq (kindOf s) "term.paren" with
  | .true => isDotStx (kid s 1)
  | .false => match strEq (kindOf s) "term.dotIdent" with
    | .true => .true
    | .false => Bool.and (strEq (kindOf s) "term.app") (strEq (kindOf (kid s 0)) "term.dotIdent")
-- an argument that needs its expected type: `.c …`, and (stage 20a) a `match` or a `fun`
def postponable (a : Syntax) : Bool := Bool.or (isDotStx a) (Bool.or (strEq (kindOf (unparen a)) "term.match")
  (strEq (kindOf (unparen a)) "term.fun"))
def isMetaApp (es : ES) (ty : Val) : Bool := match metaApp es (force es ty) with
  | .mk _ _ => .true
  | .none => .false
-- `.c` (or `.c a …`) against a type `T …`: `T.c`
-- (a type that is a definition, like `Syntax := SyntaxF .true`, is unfolded: stage 19d)
partial def dotName (gs : Globals) (es : ES) (ty : Val) (c : String) : Option String := match force es ty with
  | .vglued (.hconst T _ _ _ _) _ v => match Globals.ind gs T with
    | .some _ => .some (String.append (String.append T ".") c)
    | .none => match v () with
      | .vglued _ _ _ => dotName gs es (v ()) c
      | _ => .some (String.append (String.append T ".") c)
  | _ => .none
def dotCtor (gs : Globals) (es : ES) (ty : Val) (s : Syntax) : Option Syntax :=
  let ident := fun (n : String) => mkNode "term.ident" (one (.ident n));
  match strEq (kindOf s) "term.dotIdent" with
  | .true => match kid s 1 with
    | .ident c => match dotName gs es ty c with
      | .some n => .some (ident n)
      | .none => .none
    | _ => .none
  | .false => match Bool.and (strEq (kindOf s) "term.app") (strEq (kindOf (kid s 0)) "term.dotIdent") with
    | .true => match kid (kid s 0) 1 with
      | .ident c => match dotName gs es ty c with
        | .some n => .some (mkNode "term.app" (.cons (ident n) (one (kid s 1))))
        | .none => .none
      | _ => .none
    | .false => .none
-- the level of a sort
def sortLvl (es : ES) (ty : Val) : Lvl := match whnf (force es ty) with
  | .vsort l => l
  | _ => .lnum 0
-- `(x : a) → b` with its sort, when both parts' sorts are known (`sorted`)
def piSorted (es : ES) (a b : Tm) (la lb : Val) : Tm := match whnf (force es la) with
  | .vsort l1 => match whnf (force es lb) with
    | .vsort l2 => .sorted (.limax l1 l2) (.pi a b)
    | _ => .pi a b
  | _ => .pi a b
def tailBools : List Bool → List Bool
  | .nil => .nil
  | .cons _ rest => rest
def scopeNames : Scope → List String
  | .mk ls _ _ _ => List.reverseOf ls .nil

-- the result of elaborating a term: the term, its type, the metavariables
inductive TE where
  | ok (t : Tm) (ty : Val) (es : ES)
  | err (msg : String)
-- a global's implicit parameters (by its index from the latest)
def globalMask (gs : Globals) (i : Nat) : List Bool := match gs with
  | .mk all _ _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .star .star .star .nil) with
    | .mk _ _ _ _ m => m
-- Pattern matching in definitions (stages 16b, 16e): `def f (ps) : R := match x, y with
-- | p₁, q₁ => rhs₁ …`, the scrutinees parameters and `R` not mentioning them, is
-- compiled column by column: split on the first column where the first clause has a
-- constructor pattern (an `ind` with the constant motive `fun i y => R`), so that in
-- the branch for constructor `c` that column is replaced by `c`'s fields; a clause with
-- a variable there names the column (a `let` at the leaf). The method of a split is
--   fun i xs ih => (ecase (fst xs) [b₁, …, bₖ] : convoy) (snd xs) ih
-- with each branch `bᵢ := fun rest ih => let fields := …; …`. The first split is the
-- structural one: its recursive fields' induction hypotheses are `let`s too, and a
-- recursive call `f … y …` on such a field (the other arguments being the parameters)
-- becomes `y`'s hypothesis.

def nthSyntax : List Syntax → Nat → Syntax
  | .nil, _ => .missing
  | .cons s rest, i => match i with
    | .zero => s
    | .succ j => nthSyntax rest j
def nthName : List String → Nat → String
  | .nil, _ => "_"
  | .cons s rest, i => match i with
    | .zero => s
    | .succ j => nthName rest j
-- the field variables before field `j`, as arguments: `var (j - 1), …, var 0`
def fvars : Nat → Tms
  | .zero => .tnil
  | .succ k => tmsAppend (.tcons (.var k) .tnil) (fvars k)
def elemNat : Nat → List Nat → Bool
  | _, .nil => .false
  | x, .cons y ys => Bool.or (Nat.beq x y) (elemNat x ys)

-- a pattern: a constructor and its sub-patterns, or a variable (or `_`)
inductive Pat where
  | ctor (c : String) (subs : List Syntax)
  | any (x : String)
-- `T.c` without the `T.`
def dropPrefix : List Char → List Char → Option (List Char)
  | .nil, rest => .some rest
  | .cons a as, .cons b bs => match Nat.beq (Char.code a) (Char.code b) with
    | .true => dropPrefix as bs
    | .false => .none
  | _, .nil => .none
def ctorOfName (T n : String) : Option String := match String.append T "." with
  | .mk ts => match n with
    | .mk ns => match dropPrefix ts ns with
      | .some c => .some (.mk c)
      | .none => .none
def headCtor (T : String) (h : Syntax) : Option String := match strEq (kindOf h) "term.dotIdent" with
  | .true => match kid h 1 with
    | .ident c => .some c
    | _ => .none
  | .false => ctorOfName T (identOf h)
partial def patOf (T : String) (p : Syntax) : Pat := match strEq (kindOf p) "term.paren" with
  | .true => patOf T (kid p 1)
  | .false => match strEq (kindOf p) "term.num" with
  -- a numeral: `0` is `.zero`, `n + 1` is `.succ n`
  | .true => match numValue p with
    | .zero => .ctor "zero" .nil
    | .succ k => .ctor "succ" (one (mkNode "term.num" (one (.atom (Nat.toString k)))))
  | .false => match strEq (kindOf p) "term.app" with
    | .true => match strEq (identOf (kid p 0)) "Nat.add" with
      -- `a + (k + 1)` (from `infixl " + " => Nat.add`) is `.succ (a + k)`
      | .true => match kids (kid p 1) with
        | .cons a (.cons b .nil) => match strEq (kindOf b) "term.num" with
          | .true => match numValue b with
            | .zero => patOf T a
            | .succ k => .ctor "succ" (one (match k with
              | .zero => a
              | _ => mkNode "term.app" (.cons (kid p 0) (one (mkNull (.cons a (one (mkNode "term.num" (one (.atom (Nat.toString k)))))))))))
          | .false => .any "_"
        | _ => .any "_"
      | .false => match headCtor T (kid p 0) with
        | .some c => .ctor c (kids (kid p 1))
        | .none => .any "_"
    | .false => match headCtor T p with
      | .some c => .ctor c .nil
      | .none => .any (identOf p)
def isVarPat (p : Syntax) : Bool := match strEq (kindOf p) "term.ident" with
  | .true => .true
  | .false => strEq (kindOf p) "term.hole"

-- a column: a variable (by level) and its type, with constants and inlined, over the
-- binders before it
inductive Col where
  | mk (lvl : Nat) (ty tyI : Tm)
-- a name a clause gives a column
inductive Bind where
  | mk (name : String) (col : Col)
inductive Clause where
  | mk (pats : List Syntax) (binds : List Bind) (rhs : Syntax)
def holeStx : Syntax := mkNode "term.hole" (one (.atom "_"))
def holes : Nat → List Syntax
  | .zero => .nil
  | .succ k => .cons holeStx (holes k)
def nthCol : List Col → Nat → Col
  | .nil, _ => .mk 0 .star .star
  | .cons c rest, i => match i with
    | .zero => c
    | .succ j => nthCol rest j
-- `n` sub-patterns: as given, or holes if there are fewer
def padPats : Nat → List Syntax → List Syntax
  | .zero, _ => .nil
  | .succ k, ps => match ps with
    | .nil => .cons holeStx (padPats k .nil)
    | .cons p rest => .cons p (padPats k rest)

-- **Exercise 16.2.** The clauses for constructor `c` (of type `T`) after splitting
-- column `k` (`col`): a clause with `c` there gets its sub-patterns in place of that
-- column (`padPats F`), one with a variable gets `F` holes and binds the variable to
-- `col` (unless it is `_`), and one with another constructor is dropped.
def specialize (T c : String) (k F : Nat) (col : Col) : List Clause → List Clause
  --<sol
  | .nil => .nil
  | .cons (.mk pats binds rhs) rest =>
    let before := takeL k pats;
    let after := dropL (k + 1) pats;
    match patOf T (nthSyntax pats k) with
    | .ctor c' subs => match strEq c c' with
      | .true => .cons (.mk (List.append before (List.append (padPats F subs) after)) binds rhs) (specialize T c k F col rest)
      | .false => specialize T c k F col rest
    | .any x =>
      let binds' := match strEq x "_" with
        | .true => binds
        | .false => List.append binds (.cons (Bind.mk x col) .nil);
      .cons (.mk (List.append before (List.append (holes F) after)) binds' rhs) (specialize T c k F col rest)
  --|ex
  --| | _ => .nil
  --sol>

-- the names of the recursive fields' hypotheses: field name ↦ hypothesis name
inductive IHName where
  | mk (field ih : String)
def ihFor (x : String) : List IHName → Option String
  | .nil => .none
  | .cons (.mk y h) rest => match strEq x y with
    | .true => .some h
    | .false => ihFor x rest
-- the levels a name stands for (in a clause's binds)
def bindLvl (x : String) : List Bind → Option Nat
  | .nil => .none
  | .cons (.mk y (.mk l _ _)) rest => match strEq x y with
    | .true => .some l
    | .false => bindLvl x rest
-- is the argument the `i`th parameter (by its name, or a name for its column)?
def isParamArg (params : List String) (binds : List Bind) (i : Nat) (a : Syntax) : Bool :=
  match strEq (identOf a) (nthName params i) with
  | .true => .true
  | .false => match bindLvl (identOf a) binds with
    | .some l => Nat.beq l i
    | .none => .false
-- the arguments (the explicit parameters': implicit ones are left out, being the same)
-- before the structural one are the parameters, the structural one a field with a
-- hypothesis: that hypothesis (the later arguments are its arguments)
def nthBool : List Bool → Nat → Bool
  | .nil, _ => .false
  | .cons b rest, i => match i with
    | .zero => b
    | .succ j => nthBool rest j
partial def recCallIH (params : List String) (mask : List Bool) (binds : List Bind) (p : Nat) (ihs : List IHName) : List Syntax → Nat → Option String
  | args, i => match Nat.lt i (List.length params) with
    | .false => match args with
      | .nil => .some ""
      | .cons _ _ => .none
    | .true => match nthBool mask i with
      | .true => recCallIH params mask binds p ihs args (i + 1)
      | .false => match args with
        | .nil => .none
        | .cons a rest => match recCallIH params mask binds p ihs rest (i + 1) with
          | .none => .none
          | .some h => match Nat.beq i p with
            | .true => ihFor (match strEq (kindOf (unparen a)) "term.app" with
                | .true => identOf (kid (unparen a) 0)
                | .false => identOf a) ihs
            | .false => match Nat.lt p i with
              | .true => .some h
              | .false => match isParamArg params binds i a with
                | .true => .some h
                | .false => .none
def nthS' : List Syntax → Nat → Syntax
  | .nil, _ => .missing
  | .cons s rest, i => match i with
    | .zero => s
    | .succ j => nthS' rest j
-- how many explicit parameters there are up to the `p`th
def explicitUpTo : List Bool → Nat → Nat
  | .nil, _ => 0
  | .cons b rest, p => (match b with
      | .true => 0
      | .false => 1) + (match p with
      | .zero => 0
      | .succ q => explicitUpTo rest q)
-- what a match needs: the function's name, parameters and structural position, the
-- result type `R` (over the `n` parameters), the motive's universe `v`
inductive MatchCtx where
  | mk (f : String) (params : List String) (p n v : Nat) (R RI : Tm) (pts ptsI : Tms) (mask : List Bool)
mutual
-- replace the recursive calls `f …` by hypotheses
def rewriteRec (mc : MatchCtx) (binds : List Bind) (ihs : List IHName) (stx : Syntax) : Syntax :=
  match mc with
  | .mk f params p _ _ _ _ _ _ mask => match stx with
    | .node k args => match Bool.and (strEq k "term.app") (strEq (identOf (kid stx 0)) f) with
      | .true => match recCallIH params mask binds p ihs (kids (kid stx 1)) 0 with
        | .some h => match strEq h "" with
          | .true => .node k (rewriteArgs mc binds ihs args)
          | .false =>
            -- (through a function field `y`, the structural argument `y a…` gives `ih a…`)
            let sa := unparen (nthS' (kids (kid stx 1)) (explicitUpTo mask p - 1));
            let ih := match strEq (kindOf sa) "term.app" with
              | .true => mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident h))) (one (kid sa 1)))
              | .false => mkNode "term.ident" (one (.ident h));
            match dropL (explicitUpTo mask p) (kids (kid stx 1)) with
            | .nil => ih
            | later => mkNode "term.app" (.cons ih (one (.node "null" (rewriteArgs mc binds ihs (toArgs later)))))
        | .none => .node k (rewriteArgs mc binds ihs args)
      | .false => .node k (rewriteArgs mc binds ihs args)
    | s => s
def rewriteArgs (mc : MatchCtx) (binds : List Bind) (ihs : List IHName) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (rewriteRec mc binds ihs s) (rewriteArgs mc binds ihs rest)
end

-- a type's head constant and arguments
inductive TyHead where
  | mk (name : String) (args : Tms)
  | none
def headOf : Tm → Tms → TyHead
  | .const n _ _ _ _, acc => .mk n acc
  | .app f a, acc => headOf f (.tcons a acc)
  | _, _ => .none
def headTm : Tm → Tm
  | .app f _ => headTm f
  | t => t
-- the hypotheses' names, for the binds standing for recursive fields that have one
def ihNamesOf (ihLvls : List Nat) : List Bind → List IHName
  | .nil => .nil
  | .cons (.mk x (.mk l _ _)) rest => match elemNat l ihLvls with
    | .true => .cons (.mk x (String.append "ih✝" (Nat.toString l))) (ihNamesOf ihLvls rest)
    | .false => ihNamesOf ihLvls rest
def ihLvlNames : List Nat → List String
  | .nil => .nil
  | .cons l rest => .cons (String.append "ih✝" (Nat.toString l)) (ihLvlNames rest)
-- `let x : A := var` for each bind, from depth `d`
def bindLets (inline : Bool) (body : Tm) : Nat → List Bind → Tm
  | _, .nil => body
  | d, .cons (.mk _ (.mk l ty tyI)) rest =>
    let A := match inline with
      | .true => tyI
      | .false => ty;
    .letE (shiftTm (d - l) 0 A) (.var (d - 1 - l)) (bindLets inline body (d + 1) rest)
def bindNames : List Bind → List String
  | .nil => .nil
  | .cons (.mk x _) rest => .cons x (bindNames rest)
-- the parameters after the structural one (`p`): their types as a telescope over the
-- binders at depth `base` (the parameters up to `p` stay where they are)
def genTys (p base : Nat) : Nat → Tms → Tms
  | _, .tnil => .tnil
  | m, .tcons t rest => .tcons (shiftTm (base - p - 1) m t) (genTys p base (m + 1) rest)
def nthTm : Tms → Nat → Tm
  | .tnil, _ => .star
  | .tcons t rest, i => match i with
    | .zero => t
    | .succ j => nthTm rest j
-- move the columns of the parameters after `p` to their new binders from depth `base`
def regen (p n base : Nat) (pts ptsI : Tms) : List Col → List Col
  | .nil => .nil
  | .cons (.mk l ty tyI) rest => match Bool.and (Nat.lt p l) (Nat.lt l n) with
    | .true => .cons (.mk (base + (l - p - 1)) (shiftTm (base - p - 1) (l - p - 1) (nthTm pts l))
        (shiftTm (base - p - 1) (l - p - 1) (nthTm ptsI l))) (regen p n base pts ptsI rest)
    | .false => .cons (.mk l ty tyI) (regen p n base pts ptsI rest)
def genVars (d : Nat) : Nat → Nat → Tms
  | .zero, _ => .tnil
  | .succ k, l => .tcons (.var (d - 1 - l)) (genVars d k (l + 1))
-- the fields as `let`s from depth `d0` (`rest` just before the first), as columns, and
-- in the context; each field type (over the type's parameters and the fields before)
-- gets the arguments `args` (at depth `L`)
inductive Lets where
  | mk (wrap : Tm → Tm) (cols : List Col) (recs : List Nat) (cx : Cx)
def fieldCols (np L d0 : Nat) (args : Tms) : Cx → Nat → List CField → Lets
  | cx, _, .nil => .mk (fun b => b) .nil .nil cx
  | cx, j, .cons (.mk _ isRec A _) rest =>
    let d := d0 + j;
    let ty := nfAt d (tApps (tLams np (tLams j A)) (tmsAppend (shiftTms (d - L) args) (fvars j)));
    let val : Tm := .fst (sndN j (.var (1 + j)));
    let env := TCtx.env (Cx.c cx);
    match fieldCols np L d0 args (Cx.define cx "_" (eval env val) (eval env ty)) (j + 1) rest with
    | .mk wrap cols recs cx' => .mk (fun b => .letE ty val (wrap b)) (.cons (.mk d ty ty) cols) (match isRec with
        | .true => .cons d recs
        | .false => recs) cx'
-- the hypotheses `let ih✝l : M := fst (snd^r ih)` (one per recursive field `l`), after
-- `F` fields, from depth `d0 + F`; `M` is the motive's body, at depth `md`
inductive IHL where
  | mk (wrap : Tm → Tm) (cx : Cx)
def ihLetsT (M : Tm) (md d0 F : Nat) : Cx → Nat → List Nat → IHL
  | cx, _, .nil => .mk (fun b => b) cx
  | cx, r, .cons l rest =>
    let ty := shiftTm (d0 + F + r - md) 0 M;
    let val : Tm := .fst (sndN r (.var (F + r)));
    let env := TCtx.env (Cx.c cx);
    match ihLetsT M md d0 F (Cx.define cx (String.append "ih✝" (Nat.toString l)) (eval env val) (eval env ty)) (r + 1) rest with
    | .mk w cx' => .mk (fun b => .letE ty val (w b)) cx'
-- `let x : A := var` for each bind
def bindLetsT (body : Tm) : Cx → List Bind → Tm
  | _, .nil => body
  | cx, .cons (.mk x (.mk l ty _)) rest =>
    let d := Cx.lvl cx;
    let A := shiftTm (d - l) 0 ty;
    let v : Tm := .var (d - 1 - l);
    let env := TCtx.env (Cx.c cx);
    .letE A v (bindLetsT body (Cx.define cx x (eval env v) (eval env A)) rest)
def bindCx : Cx → List Bind → Cx
  | cx, .nil => cx
  | cx, .cons (.mk x (.mk l ty _)) rest =>
    let d := Cx.lvl cx;
    let A := shiftTm (d - l) 0 ty;
    let env := TCtx.env (Cx.c cx);
    bindCx (Cx.define cx x (eval env (.var (d - 1 - l))) (eval env A)) rest
-- bind the parameters after the structural one again: names from `ps`, types from the
-- Π type `ty`; the rest of `ty` is the expected type inside
inductive Gen where
  | mk (cx : Cx) (expected : Val)
def genBind (es : ES) : Cx → Val → List String → Gen
  | cx, ty, .nil => .mk cx ty
  | cx, ty, .cons x rest => match whnf ty with
    | .vpi _ dom env cod _ => genBind es (Cx.bind cx x dom) (eval (.cons (fresh (Cx.lvl cx)) env) cod) rest
    | t => .mk cx t
def dropEnv : Nat → Env → Env
  | .zero, e => e
  | .succ k, e => match e with
    | .nil => .nil
    | .cons _ rest => dropEnv k rest
def lenL {A : Type} (xs : List A) : Nat := List.length xs

def colTyAt : List Col → Nat → Option Tm
  | .nil, _ => .none
  | .cons (.mk l' ty _) rest, l => match Nat.beq l l' with
    | .true => .some ty
    | .false => colTyAt rest l
def lastTm : Tms → Tm
  | .tnil => .star
  | .tcons t rest => match rest with
    | .tnil => t
    | .tcons _ _ => lastTm rest
def isNilCl : List Clause → Bool
  | .nil => .true
  | .cons _ _ => .false
-- `False` from a proof of an equation that computes to it (or to `False × …`)
partial def toFalse (ty : Val) (t : Tm) : Option Tm := match whnf ty with
  | .vempty _ => .some t
  | .vsigma _ A _ _ _ => toFalse A (.fst t)
  | _ => .none
-- the field variables (from level `d0`, `F` of them) as arguments at depth `D`
def fieldVarsAt (D d0 : Nat) : Nat → Nat → Tms
  | .zero, _ => .tnil
  | .succ k, j => .tcons (.var (D - 1 - (d0 + j))) (fieldVarsAt D d0 k (j + 1))
-- a constructor ruled out by a closed index: `fun e => exfalso M (…)`, where the
-- payload's proof `p : res = i` is carried along `e : i = idx` to `res = idx`, which
-- computes to `False`; `none` if it doesn't
def absurdBranch (cx6 : Cx) (np L d d0 F : Nat) (args : Tms) (I idx res : Tm) (MBv : Val) : Option Tm :=
  let D1 := Cx.lvl cx6;
  match whnf MBv with
  | .vpi _ eTy envE codE _ =>
    let cxE := Cx.bind cx6 "e✝" eTy;
    let D := D1 + 1;
    let expected' := eval (.cons (fresh D1) envE) codE;
    let ID := nfAt D (tApps (tLams np I) (shiftTms (D - L) args));
    let icD := nfAt D (tApps (tLams np (tLams F res)) (tmsAppend (shiftTms (D - L) args) (fieldVarsAt D d0 F 0)));
    let idxD := shiftTm (D - L) 0 idx;
    let pTm : Tm := .fst (sndN F (.var (D - 1 - (d + 3))));
    let mot : Tm := .lam (.lam (.eq (shiftTm 2 0 ID) (shiftTm 2 0 icD) (.var 1)));
    let prf : Tm := .subst ID (.var (D - 1 - d)) mot pTm idxD (.var 0);
    match toFalse (eval (TCtx.env (Cx.c cxE)) (.eq ID icD idxD)) prf with
    | .some f => .some (.lam (.exfalso (quote D expected') f))
    | .none => .none
  | _ => .none
-- the hypotheses `let ih✝l := fst (snd^r ih)`, one per recursive field `l`; with a closed
-- index, one whose field has that index is applied to `refl` already
def ihLetsB (gs : Globals) (MB0 MB : Tm) (md d0 F np L : Nat) (args : Tms) (I idx : Tm) (modeB : Bool) (fcols : List Col) : Cx → Nat → List Nat → IHL
  | cx, _, .nil => .mk (fun b => b) cx
  | cx, r, .cons l rest =>
    let D := d0 + F + r;
    let env := TCtx.env (Cx.c cx);
    let raw : Tm := .fst (sndN r (.var (F + r)));
    -- a function field `y : (h : H) → B` (stage 19f): its hypothesis is a function too
    let fty0 : Tm := match colTyAt fcols l with
      | .some fty => fty
      | .none => .star;
    let hr : Option Tm := match fty0 with
      | .pi H _ => .some (shiftTm (D - l) 0 H)
      | _ => .none;
    let fty : Tm := match fty0 with
      | .pi _ B => B
      | t => t;
    -- the field's index, at depth `D` (a function field's under its binder `h`, a member's
    -- tag)
    let jD : Tm := match headOf fty .tnil with
      | .mk nm as => match Globals.ind gs nm with
        | .some (.mk _ _ _ _ _ (.some f) _) => f
        | _ => lastTm (shiftTms (D - l) as)
      | .none => .star;
    let ID := nfAt D (tApps (tLams np I) (shiftTms (D - L) args));
    let same := Bool.and modeB (conv (Cx.c cx) (eval env ID) (eval env jD) (eval env (shiftTm (D - L) 0 idx)));
    let val : Tm := match hr with
      | .none => match same with
        | .true => .app raw (.eqRefl ID jD)
        | .false => raw
      | .some _ => match same with
        | .true => .lam (.app (.app (shiftTm 1 0 raw) (.var 0)) (.eqRefl (shiftTm 1 0 ID) jD))
        | .false => raw;
    -- `P j y` for the field `y` (at level `l`) and its index `j`; `(h : H) → P j (y h)`
    let ty := match hr with
      | .none => match same with
        | .true => shiftTm (D - md) 0 MB0
        | .false => nfAt D (.app (.app (.lam (.lam (shiftTm (D - (md - 2)) 2 MB))) jD) (.var (D - 1 - l)))
      | .some H => match same with
        | .true => .pi H (shiftTm (D + 1 - md) 0 MB0)
        | .false => .pi H (nfAt (D + 1) (.app (.app (.lam (.lam (shiftTm (D + 1 - (md - 2)) 2 MB))) jD) (.app (.var (D - l)) (.var 0))));
    match ihLetsB gs MB0 MB md d0 F np L args I idx modeB fcols (Cx.define cx (String.append "ih✝" (Nat.toString l)) (eval env val) (eval env ty)) (r + 1) rest with
    | .mk w cx' => .mk (fun b => .letE ty val (w b)) cx'
-- the result of compiling a match: the term and the metavariables
def nonAtoms : List Syntax → List Syntax
  | .nil => .nil
  | .cons s rest => match s with
    | .atom _ => nonAtoms rest
    | _ => .cons s (nonAtoms rest)
def clausesOf : List Syntax → List Clause
  | .nil => .nil
  | .cons a rest => .cons (.mk (nonAtoms (kids (kid a 1))) .nil (kid a 3)) (clausesOf rest)
inductive CE where
  | ok (t : Tm) (es : ES)
  | err (msg : String)
def lastClause : List Clause → Option Clause
  | .nil => .none
  | .cons c rest => match rest with
    | .nil => .some c
    | .cons _ _ => lastClause rest
def one' (c : Clause) : List Clause := .cons c .nil
def replaceLastRhs (r : Syntax) : List Clause → List Clause
  | .nil => .nil
  | .cons (.mk ps bs rhs) rest => match rest with
    | .nil => one' (.mk ps bs r)
    | .cons _ _ => .cons (.mk ps bs rhs) (replaceLastRhs r rest)
def allVarPatsC : List Syntax → Bool
  | .nil => .true
  | .cons p rest => Bool.and (isVarPat p) (allVarPatsC rest)
-- (worth sharing: two clauses or more, the last of variables, with more than a name)
def shareableLast (cls : List Clause) : Bool := match cls with
  | .cons _ (.cons _ _) => match lastClause cls with
    | .some (.mk ps _ rhs) => Bool.and (allVarPatsC ps) (Bool.not (strEq (kindOf rhs) "term.ident"))
    | .none => .false
  | _ => .false
-- the scrutinees of a term `match`, `let`-bound: the context, the columns, the `let`s
inductive SL where
  | ok (cx : Cx) (cols : List Col) (wrap : Tm → Tm) (es : ES)
  | err (msg : String)
inductive BE where
  | ok (bs : Tms) (es : ES)
  | err (msg : String)
def noBE : BE := .ok .tnil ES.empty
-- `fun t => ecase t [D₁, …]`, the description after its tag
def descFn : Tm → Tm
  | .darg _ f => f
  | t => t
mutual
-- infer the type of `s` (an identifier's leading implicit arguments are inserted)
def inferT (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  -- a `match` (or `if`) without an expected type: against a new metavariable, a type
  -- (stage 20a)
  match Bool.or (strEq (kindOf s) "term.match") (match ifMatch s with
    | .some _ => Bool.true
    | .none => .false) with
  | .true => match newMeta es cx (.vsort (.lnum 1)) with
    | .mk mt es1 =>
      let T := eval (TCtx.env (Cx.c cx)) mt;
      match checkT gs es1 cx s T with
      | .ok t _ es2 => .ok t (force es2 T) es2
      | e => e
  | .false => match inferHead gs es cx s with
    | .ok t ty es' m => insertImplicits gs es' cx t ty m
    | .err msg => .err msg
-- an application's head: the term, its type and the implicit mask that remains
def inferHead (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : HE :=
  let k := kindOf s;
  match s with
  | .ident n => identHead gs es cx n
  | _ => match strEq k "term.ident" with
    | .true => identHead gs es cx (identOf s)
    | .false => match strEq k "term.explicit" with
      -- `@f`: no implicit arguments are inserted
      | .true => match kid s 1 with
        | .ident n => match identHead gs es cx n with
          | .ok t ty es' _ => HE.ok t ty es' .nil
          | e => e
        | _ => HE.err "@ needs an identifier"
      | .false => match inferT1 gs es cx s with
        | .ok t ty es' => HE.ok t ty es' .nil
        | .err m => HE.err m
def identHead (gs : Globals) (es : ES) (cx : Cx) (n : String) : HE :=
  let d := Cx.lvl cx;
  match Scope.lookup (Cx.sc cx) n with
  | .none => match splitLast n with
    -- `x.f`: the projection `T.f x`, for `x : T …`
    | .some (.mk base f) => match identHead gs es cx base with
      | .ok bt bty es1 m => match insertImplicits gs es1 cx bt bty m with
        | .ok bt' bty' es2 => match projT gs es2 cx bt' bty' f with
          | .err _ => .err (String.append "unknown identifier " n)
          | r => r
        | .err msg => .err msg
      | e => e
    | .none => match strEq n "Unit" with
      -- (built in, like `Type`)
      | .true => .ok (.unit 0) (.vsort (.lnum 1)) es .nil
      | .false => .err (String.append "unknown identifier " n)
  | .some i => match Nat.lt i d with
    | .true => .ok (.var i) (lookup (TCtx.types (Cx.c cx)) i) es .nil
    | .false => match globalTm .false gs (i - d) with
      | .const nm ps ls v ty => .ok (.const nm ps ls v ty) (eval .nil ty) es (globalMask gs (i - d))
      | t => .err "a global that isn't a constant"
-- the projection `T.f t`, for `t : T …`
def projT (gs : Globals) (es : ES) (cx : Cx) (bt : Tm) (bty : Val) (f : String) : HE := match force es bty with
  | .vglued (.hconst T _ _ _ _) _ _ => match identHead gs es cx (String.append (String.append T ".") f) with
    | .ok pt pty es3 pm => match insertImplicits gs es3 cx pt pty pm with
      | .ok pt' pty' es4 => match whnf (force es4 pty') with
        | .vpi _ dom env cod _ => match unify es4 cx bty dom with
          | .some es5 => .ok (.app pt' bt) (eval (.cons (eval (TCtx.env (Cx.c cx)) bt) env) cod) es5 .nil
          | .none => .err (String.append "cannot apply the projection " f)
        | _ => .err (String.append "not a projection: " f)
      | .err msg => .err msg
    | e => e
  | _ => .err (String.append "no field " f)
-- a numeral `n`: `Nat.succ` applied `n` times to `Nat.zero` (stage 18f; there are no
-- number literals in the kernel)
def numeral (gs : Globals) (es : ES) (cx : Cx) (n : Nat) : TE := match identHead gs es cx "Nat.zero" with
  | .ok z zty _ _ => match identHead gs es cx "Nat.succ" with
    | .ok sc _ _ _ => match identHead gs es cx "Nat.mul" with
      | .ok mul _ _ _ => .ok (binNat sc z mul n) zty es
      | .err _ => .ok (iterApp sc n z) zty es
    | .err m => .err m
  | .err _ => .err "numerals need Nat.zero and Nat.succ"
-- a string literal: `String.mk [Char.mk c₁, …]` (stage 19a)
def charsTm (lcons lnil ch cmk : Tm) (num : Nat → Tm) : List Char → Tm
  | .nil => .app lnil ch
  | .cons c rest => .app (.app (.app lcons ch) (.app cmk (num (Char.code c)))) (charsTm lcons lnil ch cmk num rest)
def stringLit (gs : Globals) (es : ES) (cx : Cx) (v : String) : TE :=
  let get := fun (n : String) => match identHead gs es cx n with
    | .ok t _ _ _ => Option.some t
    | .err _ => .none;
  match get "String.mk" with
  | .some smk => match get "List.cons" with
    | .some lcons => match get "List.nil" with
      | .some lnil => match get "Char" with
        | .some ch => match get "Char.mk" with
          | .some cmk => match get "Nat.succ" with
            | .some sc => match get "Nat.zero" with
              | .some z => match get "String" with
                | .some st =>
                  -- (the codes in binary, like numerals: stage 20b)
                  let num : Nat → Tm := match get "Nat.mul" with
                    | .some mul => fun (n : Nat) => binNat sc z mul n
                    | .none => fun (n : Nat) => iterApp sc n z;
                  match v with
                  | .mk cs => .ok (.app smk (charsTm lcons lnil ch cmk num cs)) (eval .nil st) es
                | .none => .err "strings need the Prelude"
              | .none => .err "strings need the Prelude"
            | .none => .err "strings need the Prelude"
          | .none => .err "strings need the Prelude"
        | .none => .err "strings need the Prelude"
      | .none => .err "strings need the Prelude"
    | .none => .err "strings need the Prelude"
  | .none => .err "strings need the Prelude"
-- apply metavariables for the leading implicit parameters
def insertImplicits (gs : Globals) (es : ES) (cx : Cx) (t : Tm) (ty : Val) (m : List Bool) : TE :=
  match m with
  | .cons .true rest => match whnf ty with
    | .vpi _ dom env cod _ => match newMeta es cx dom with
      | .mk mt es' => insertImplicits gs es' cx (.app t mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) rest
    | _ => .ok t ty es
  | _ => .ok t ty es
-- the other forms
def inferT1 (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE :=
  let k := kindOf s;
  match strEq k "term.paren" with
  | .true => inferT gs es cx (kid s 1)
  | .false => match strEq k "term.num" with
    | .true => numeral gs es cx (numValue s)
    | .false => match strEq k "term.str" with
    | .true => stringLit gs es cx (strValue s)
    | .false => match strEq k "term.unitVal" with
    | .true => .ok .star (.vunit 1) es
    | .false => match strEq k "term.type" with
    | .true => .ok (.univ (univLevel s)) (.vsort (.lnum (univLevel s + 2))) es
    | .false => match strEq k "term.app" with
      | .true => match inferHead gs es cx (kid s 0) with
        | .ok f fty es' m => appArgsT gs es' cx f fty m (kids (kid s 1)) .nil .none
        | .err msg => .err msg
      | .false => match strEq k "term.arrow" with
        | .true => match inferType gs es cx (kid s 0) with
          | .ok a la es1 => match inferType gs es1 (Cx.bind cx "_" (eval (TCtx.env (Cx.c cx)) a)) (kid s 2) with
            | .ok b lb es2 => .ok (piSorted es2 a b la lb) (.vsort (.limax (sortLvl es2 la) (sortLvl es2 lb))) es2
            | e => e
          | e => e
        | .false => match strEq k "term.depArrow" with
          | .true => match binderType (kid s 0) with
            | .some aStx => depPis gs es cx (binderNames (kid s 0)) aStx (kid s 2)
            | .none => .err "a Π needs a binder type"
          | .false => match strEq k "term.ascription" with
            | .true => match inferType gs es cx (kid s 3) with
              | .ok T _ es1 =>
                let Tv := eval (TCtx.env (Cx.c cx)) T;
                match checkT gs es1 cx (kid s 1) Tv with
                | .ok t _ es2 => .ok (.ann t T) Tv es2
                | e => e
              | e => e
            | .false => match strEq k "term.let" with
              | .true => letT gs es cx s .none
              | .false => match strEq k "term.field" with
              | .true => match inferT gs es cx (kid s 0) with
                | .ok t ty es1 => match projT gs es1 cx t ty (match kid s 2 with
                    | .ident f => f
                    | _ => "_") with
                  | .ok t' ty' es2 _ => .ok t' ty' es2
                  | .err m => .err m
                | e => e
              | .false => match strEq k "term.fun" with
                | .true => match Nat.beq (lenL (binders (kids (kid s 1)))) (lenL (fieldsOf (kids (kid s 1)))) with
                  | .true => inferLams gs es cx (fieldsOf (kids (kid s 1))) (kid s 3)
                  | .false => .err "cannot infer the type of a λ; add a type ascription"
                | .false => .err (String.append "unsupported syntax " k)
-- `fun (x : A) … => b` with every binder typed: `(x : A) → B` (stage 20a)
def inferLams (gs : Globals) (es : ES) (cx : Cx) : List Field → Syntax → TE
  | .nil, body => inferT gs es cx body
  | .cons (.mk x aS) rest, body => match strEq (kindOf aS) "" with
    | .true => .err "cannot infer the type of a λ; add a type ascription"
    | .false => match inferType gs es cx aS with
      | .ok A _ es1 =>
        let cx' := Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A);
        match inferLams gs es1 cx' rest body with
        | .ok b bty es2 => .ok (.lam b) (eval (TCtx.env (Cx.c cx)) (.pi A (quote (Cx.lvl cx') (force es2 bty)))) es2
        | e => e
      | e => e
-- a type: its sort is computed again by the kernel later, so any sort is fine here
def inferType (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) : TE := match inferT gs es cx s with
  | .ok t ty es' => match whnf (force es' ty) with
    | .vsort _ => .ok t ty es'
    | _ => .err (String.append "not a type: " (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) t))
  | e => e
-- `(x y : A) → B`
def depPis (gs : Globals) (es : ES) (cx : Cx) (xs : List String) (aStx body : Syntax) : TE := match xs with
  | .nil => inferType gs es cx body
  | .cons x rest => match inferType gs es cx aStx with
    | .ok a la es1 => match depPis gs es1 (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) a)) rest aStx body with
      | .ok b lb es2 => .ok (piSorted es2 a b la lb) (.vsort (.limax (sortLvl es2 la) (sortLvl es2 lb))) es2
      | e => e
    | e => e
-- the arguments of an application, inserting implicit ones by the mask. A `.c`
-- argument whose type isn't known yet is postponed: a metavariable stands for it until
-- the other arguments are done
def appArgsT (gs : Globals) (es : ES) (cx : Cx) (f : Tm) (fty : Val) (m : List Bool) (args : List Syntax) (post : List Post)
    (expected : Option Val) : TE :=
  match args with
  | .nil => match insertImplicits gs es cx f fty m with
    | .ok f' fty' es1 =>
      -- the expected type first: it may fix what the postponed arguments need
      let es2 := match expected with
        | .some T => match unify es1 cx fty' T with
          | .some e => e
          | .none => es1
        | .none => es1;
      match resolvePosts gs es2 cx post with
      | .some es3 => .ok f' fty' es3
      | .none => .err "could not elaborate a constructor argument"
    | e => e
  | .cons a rest => match m with
    | .cons .true m' => match whnf fty with
      | .vpi _ dom env cod _ => match newMeta es cx dom with
        | .mk mt es' => appArgsT gs es' cx (.app f mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) m' args post expected
      | _ => .err "too many implicit arguments"
    | _ => match whnf (force es fty) with
      | .vpi _ dom env cod _ => match Bool.and (postponable a) (isMetaApp es dom) with
        | .true => match newMeta es cx dom with
          | .mk mt es1 => appArgsT gs es1 cx (.app f mt) (eval (.cons (eval (TCtx.env (Cx.c cx)) mt) env) cod) (tailBools m) rest
              (.cons (.mk a dom mt) post) expected
        | .false => match checkT gs es cx a dom with
          | .ok ta _ es1 => appArgsT gs es1 cx (.app f ta) (eval (.cons (eval (TCtx.env (Cx.c cx)) ta) env) cod) (tailBools m) rest post expected
          | e => e
      | ty => .err (String.append "not a function: its type is " (show .nil (Cx.lvl cx) (quote (Cx.lvl cx) ty)))
-- the postponed arguments, each unified with its metavariable (one whose type is
-- still unknown waits longer: `drain`)
def resolvePosts (gs : Globals) (es : ES) (cx : Cx) : List Post → Option ES
  | .nil => .some es
  | .cons (.mk a dom mt) rest => match resolvePosts gs es cx rest with
    | .some es1 => match isMetaApp es1 dom with
      | .true => .some (ES.pend es1 (.mk a dom mt cx))
      | .false => match checkT gs es1 cx a dom with
        | .ok t _ es2 =>
          let env := TCtx.env (Cx.c cx);
          unify es2 cx (eval env mt) (eval env t)
        | .err _ => .none
    | .none => .none
-- the arguments still waiting, while some can be done
def drainList (gs : Globals) : ES → Bool → List Pend → DR
  | es, pr, .nil => .ok es pr
  | es, pr, .cons (.mk a dom mt cx) rest => match isMetaApp es dom with
    | .true => drainList gs (ES.pend es (.mk a dom mt cx)) pr rest
    | .false => match checkT gs es cx a dom with
      | .ok t _ es2 =>
        let env := TCtx.env (Cx.c cx);
        match unify es2 cx (eval env mt) (eval env t) with
        | .some es3 => drainList gs es3 .true rest
        | .none => .err
      | .err _ => .err
def drain (gs : Globals) (es : ES) : Option ES := match es with
  | .mk ms ps => match ps with
    | .nil => .some es
    | .cons _ _ => match drainList gs (.mk ms .nil) .false ps with
      | .ok es' pr => match pr with
        | .true => drain gs es'
        | .false => .none
      | .err => .none
-- `let x : A := v; b`, inferred or checked
def letT (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) (expected : Option Val) : TE :=
  let body := fun (A : Tm) (Av : Val) (v : Tm) (es2 : ES) => (match kid s 2 with
    | .ident x =>
      let cx' := Cx.define cx x (eval (TCtx.env (Cx.c cx)) v) Av;
      match expected with
      | .some T => match checkT gs es2 cx' (kid s 7) T with
        | .ok b _ es3 => TE.ok (.letE A v b) T es3
        | e => e
      | .none => match inferT gs es2 cx' (kid s 7) with
        | .ok b bty es3 => .ok (.letE A v b) bty es3
        | e => e
    | _ => TE.err "let needs a name" : TE);
  match binderType s with
  -- (without a type, the value's inferred type: stage 19c)
  | .none => match inferT gs es cx (kid s 5) with
    | .ok v Av es2 => body (quote (Cx.lvl cx) (force es2 Av)) Av v es2
    | e => e
  | .some tyS => match inferType gs es cx tyS with
    | .ok A _ es1 =>
      let Av := eval (TCtx.env (Cx.c cx)) A;
      match checkT gs es1 cx (kid s 5) Av with
      | .ok v _ es2 => body A Av v es2
      | e => e
    | e => e
-- check `s` against `ty`
def checkT (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) (ty : Val) : TE :=
  let k := kindOf s;
  match strEq k "term.paren" with
  | .true => checkT gs es cx (kid s 1) ty
  | .false => match dotCtor gs es ty s with
    | .some s' => checkT gs es cx s' ty
    | .none => match ifMatch s with
    | .some s' => checkT gs es cx s' ty
    | .none => match strEq k "term.match" with
    | .true => termMatch gs es cx s (force es ty)
    | .false => match strEq k "term.hole" with
    | .true => match newMeta es cx ty with
      | .mk mt es' => .ok mt ty es'
    | .false => match strEq k "term.fun" with
      | .true => checkLams gs es cx (binders (kids (kid s 1))) (kid s 3) ty
      | .false => match strEq k "term.let" with
        | .true => letT gs es cx s (.some ty)
        | .false => match (match strEq k "term.app" with
          | .true => match inferHead gs es cx (kid s 0) with
            | .ok f fty es1 m => appArgsT gs es1 cx f fty m (kids (kid s 1)) .nil (.some ty)
            | .err msg => TE.err msg
          | .false => inferT gs es cx s) with
          | .ok t ty' es' => match unify es' cx ty' ty with
            | .some es2 => .ok t ty es2
            | .none => .err (String.append (String.append "type mismatch: expected " (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) (force es' ty))))
                (String.append ", got " (show (scopeNames (Cx.sc cx)) (Cx.lvl cx) (quote (Cx.lvl cx) (force es' ty')))))
          | e => e
-- a `match` as a term (stage 18g): its scrutinees are `let`-bound, then the clauses are
-- compiled against the expected type (no recursion: that is a definition's)
def termMatch (gs : Globals) (es : ES) (cx : Cx) (s : Syntax) (ty : Val) : TE :=
  match scrutLets gs es cx (nonAtoms (kids (kid s 1))) with
  | .err m => .err m
  | .ok cx' cols wrap es1 =>
    let d := Cx.lvl cx';
    match sortOf (Cx.c cx') ty with
    | .none => .err "the type of a match must be a type"
    | .some l => match lvlClosed l with
      | .none => .err "the universe of a match's type must be a number"
      | .some v =>
        let R := quote d ty;
        let mc := MatchCtx.mk "" .nil 0 d v R R .tnil .tnil .nil;
        match compileM gs mc es1 cx' ty cols .false .nil (clausesOf (kids (kid s 3))) with
        | .ok t es2 => .ok (wrap t) ty es2
        | .err m => .err m
def scrutLets (gs : Globals) (es : ES) (cx : Cx) : List Syntax → SL
  | .nil => .ok cx .nil (fun b => b) es
  | .cons x rest => match inferT gs es cx x with
    | .err m => .err m
    | .ok t xty es1 =>
      let d := Cx.lvl cx;
      let A := quote d (force es1 xty);
      match scrutLets gs es1 (Cx.define cx "x✝" (eval (TCtx.env (Cx.c cx)) t) xty) rest with
      | .ok cx' cols wrap es2 => .ok cx' (.cons (.mk d A A) cols) (fun b => .letE A t (wrap b)) es2
      | e => e
-- `fun x y => b` against a Π type
def checkLams (gs : Globals) (es : ES) (cx : Cx) (xs : List String) (body : Syntax) (ty : Val) : TE := match xs with
  | .nil => checkT gs es cx body ty
  | .cons x rest => match whnf (force es ty) with
    | .vpi q dom env cod _ =>
      let cx' := Cx.bind cx x dom;
      match checkLams gs es cx' rest body (eval (.cons (fresh (Cx.lvl cx)) env) cod) with
      | .ok b _ es' => .ok (.lam b) ty es'
      | e => e
    | _ => .err "a λ against a type that isn't a function type"
-- compile the clauses over the columns in the context `cx`, against `expected`;
-- `top`: the next split is the structural one; `ihLvls`: the fields with hypotheses
def compileM (gs : Globals) (mc : MatchCtx) (es : ES) (cx : Cx) (expected : Val) (cols : List Col)
    (top : Bool) (ihLvls : List Nat) (cls : List Clause) : CE :=
  match cls with
  | .nil => .err "missing case"
  | .cons (.mk pats binds rhs) _ => match firstCtorCol pats 0 with
    | .none =>
      -- a leaf: bind the variables, rewrite the recursive calls, elaborate against the
      -- expected type
      let binds' := List.append binds (varBinds pats cols);
      let rhs' := rewriteRec mc binds' (ihNamesOf ihLvls binds') rhs;
      let cx' := bindCx cx binds';
      match checkT gs es cx' rhs' expected with
      | .err m => .err m
      | .ok b _ es0 => match drain gs es0 with
      | .none => .err "could not elaborate a constructor argument"
      | .some es' => match zonk es' (Cx.lvl cx') b with
        | .none => .err "could not infer an implicit argument"
        | .some b' => .ok (bindLetsT b' cx binds') es'
    | .some k => match Bool.and (Bool.not top) (shareableLast cls) with
      -- a last clause of variables, in case analysis: its body is the same in every
      -- branch it reaches (a variable on the split column stands for the scrutinee), so
      -- it is elaborated once, `let dflt✝ := …`, and the clause refers to it (stage 20b;
      -- a match on a type of 70 constructors copied it 70 times)
      | .true => match lastClause cls with
        | .some (.mk lpats lbinds lrhs) =>
          let binds' := List.append lbinds (varBinds lpats cols);
          let rhs' := rewriteRec mc binds' (ihNamesOf ihLvls binds') lrhs;
          let cx' := bindCx cx binds';
          match checkT gs es cx' rhs' expected with
          | .err m => .err m
          | .ok b _ es0 => match drain gs es0 with
            | .none => .err "could not elaborate a constructor argument"
            | .some es1 => match zonk es1 (Cx.lvl cx') b with
              | .none => .err "could not infer an implicit argument"
              | .some b' =>
                let dv := bindLetsT b' cx binds';
                let d := Cx.lvl cx;
                let nm := String.append "dflt✝" (Nat.toString d);
                let cxD := Cx.define cx nm (eval (TCtx.env (Cx.c cx)) dv) expected;
                match splitCol gs mc es1 cxD expected cols top ihLvls
                    (replaceLastRhs (mkNode "term.ident" (one (.ident nm))) cls) k with
                | .ok body es2 => .ok (.letE (quote d expected) dv body) es2
                | e => e
        | .none => splitCol gs mc es cx expected cols top ihLvls cls k
      | .false =>
        -- the first split is on the structural column
        let k' := match top with
          | .true => match mc with
            | .mk _ _ p _ _ _ _ _ _ _ => colIndex p cols 0 k
          | .false => k;
        splitCol gs mc es cx expected cols top ihLvls cls k'
-- the index of the column at level `l` (else `dflt`)
def colIndex (l : Nat) : List Col → Nat → Nat → Nat
  | .nil, _, dflt => dflt
  | .cons (.mk l' _ _) rest, i, dflt => match Nat.beq l l' with
    | .true => i
    | .false => colIndex l rest (i + 1) dflt
-- a type whose head is a definition, unfolded (at depth `d`) until it is an inductive
-- type's (stage 19d)
def unfoldTy (gs : Globals) (d : Nat) (ty : Tm) : Tm := match headOf ty .tnil with
  | .mk T args => match Globals.ind gs T with
    | .some _ => ty
    | .none => match headTm ty with
      | .const _ _ _ v _ => unfoldTy gs d (nfAt d (tApps v args))
      | _ => ty
  | .none => ty
-- the first column with a constructor pattern
def firstCtorCol : List Syntax → Nat → Option Nat
  | .nil, _ => .none
  | .cons p rest, i => match isVarPat p with
    | .true => firstCtorCol rest (i + 1)
    | .false => .some i
def varBinds : List Syntax → List Col → List Bind
  | .cons p ps, .cons c cs => match strEq (identOf p) "_" with
    | .true => varBinds ps cs
    | .false => .cons (.mk (identOf p) c) (varBinds ps cs)
  | _, _ => .nil
def splitCol (gs : Globals) (mc : MatchCtx) (es : ES) (cx : Cx) (expected : Val) (cols : List Col)
    (top : Bool) (ihLvls : List Nat) (cls : List Clause) (k : Nat) : CE :=
  let d := Cx.lvl cx;
  match nthCol cols k with
  | .mk L ty0 tyI =>
    let ty := unfoldTy gs L ty0;
    match headOf ty .tnil with
    | .none => .err "a pattern on a value that isn't of an inductive type"
    | .mk T args => match Globals.ind gs T with
      | .none => .err (String.append "not an inductive type: " T)
      | .some (.mk np I D _ ctors fixed fam) => match mc with
        | .mk _ params p n v R _ pts _ _ =>
          -- the parameters and the index (`tt` without one) of the scrutinee's type
          let pargs := tmsTake np args;
          let idx := match fixed with
            | .some f => f
            | .none => match tmsDrop np args with
              | .tcons j _ => j
              | .tnil => (.star : Tm);
          let nidxE := match fixed with
            | .some _ => 1
            | .none => tmsLenF (tmsDrop np args);
          -- the description and index type with the parameters, at depth `dd`
          let DAt := fun (dd : Nat) => nfAt dd (tApps (tLams np D) (shiftTms (dd - L) pargs));
          let IAt := fun (dd : Nat) => nfAt dd (tApps (tLams np I) (shiftTms (dd - L) pargs));
          let XAt := fun (dd : Nat) => (.lam (.mu 0 (IAt (dd + 1)) (DAt (dd + 1)) (.var 0)) : Tm);
          -- the family at a size `s` (a term at depth `dd`)
          let XsAt := fun (dd : Nat) (s : Tm) => (.lam (.mus 0 (IAt (dd + 1)) (DAt (dd + 1)) (.var 0) (shiftTm 1 0 s)) : Tm);
          let DtAt := fun (dd t : Nat) => nfAt dd (.app (descFn (DAt dd)) (.var t));
          -- the motive's body (at depth `d + 2`): `R`, or at the structural split
          -- `(q : …) → R` over the parameters after the structural one
          let G := match top with
            | .true => n - 1 - p
            | .false => 0;
          let MB : Tm := match top with
            | .true => piTele (genTys p (d + 2) 0 (tmsDrop (p + 1) pts)) (shiftTm (d + 1 - p) G R)
            | .false => shiftTm (d + 2 - n) 0 R;
          -- a closed index (a tag, say): the motive also takes `e :0 i = idx`, so that the
          -- constructors whose index differs can be ruled out
          let modeB := Bool.and (Nat.beq nidxE 1) (match lowerTm L 0 idx with
            | .some _ => .true
            | .none => .false);
          let MB0 := MB;
          let MB : Tm := match modeB with
            | .true => .piq .qz (.eq (IAt (d + 2)) (.var 1) (shiftTm (d + 2 - L) 0 idx)) (shiftTm 1 0 MB0)
            | .false => MB0;
          -- (the motive's own binders `i`, `y` stay: only the context moves)
          let PAt := fun (dd : Nat) => (.lam (.lam (shiftTm (dd - d) 2 MB)) : Tm);
          -- Only the structural split needs induction (its method runs for the hypotheses
          -- too); the others are case analysis (`scase` at size ∞), whose method has no
          -- hypotheses but a size `j` first: there the method's binders start at `e = d + 1`
          -- and `ih` is `tt` (computing hypotheses nobody uses made nested matches
          -- exponential)
          let b := match top with
            | .true => 0
            | .false => 1;
          let e := d + b;
          -- (in case analysis the payload is at `μ^j`, and the motive is applied to
          -- `y := con (tag, rest) : μ^{↑j} D i`, below `μ D i`)
          let MT : Tm := match top with
            | .true => .pi (nfAt (d + 4) (interpApp 0 (IAt (d + 4)) (DtAt (d + 4) 0) (XAt (d + 4)) (.var 3)))
                (.pi (nfAt (d + 5) (tApps (allTm 0 v) (args6 (IAt (d + 5)) (DtAt (d + 5) 1) (XAt (d + 5)) (PAt (d + 5)) (.var 4) (.var 0))))
                  (shiftTm 4 0 MB))
            | .false => .pi (nfAt (e + 4) (interpApp 0 (IAt (e + 4)) (DtAt (e + 4) 0) (XsAt (e + 4) (.var 4)) (.var 3)))
                (.pi (.unit 0) (.letE (.mus 0 (IAt (e + 6)) (DAt (e + 6)) (.var 5) (.szSuc (.var 6))) (.con (.pair (.var 2) (.var 1)))
                  (nfAt (e + 7) (.app (.app (PAt (e + 7)) (.var 6)) (.var 0)))));
          -- the method's binders (`j`), `i`, `xs`, `ih`, in the context
          let env := TCtx.env (Cx.c cx);
          let cxJ := match top with
            | .true => cx
            | .false => Cx.bind cx "j✝" (.vsizeLt .vszInf);
          let cx1 := Cx.bind cxJ "i✝" (eval (TCtx.env (Cx.c cxJ)) (IAt e));
          let Xm := match top with
            | .true => XAt (e + 1)
            | .false => XsAt (e + 1) (.var 1);
          let cx2 := Cx.bind cx1 "xs✝" (eval (TCtx.env (Cx.c cx1)) (interpApp 0 (IAt (e + 1)) (DAt (e + 1)) Xm (.var 0)));
          let cx3 := match top with
            | .true => Cx.bind cx2 "ih✝" (eval (TCtx.env (Cx.c cx2))
                (tApps (allTm 0 v) (args6 (IAt (d + 2)) (DAt (d + 2)) (XAt (d + 2)) (PAt (d + 2)) (.var 1) (.var 0))))
            | .false => Cx.define cx2 "ih✝" .vtt (.vunit 1);
          -- the motive's body as a value (it doesn't use `i` and `y`)
          let MBv := eval (.cons .vtt (.cons .vtt env)) MB;
          match branches gs mc es cx3 expected cols top ihLvls cls k (.mk L ty tyI) T np pargs nidxE I idx fam modeB MB0 MB MBv MT G b (lenL ctors) 0 ctors with
          | .err m => .err m
          | .ok bs es' =>
            let convoy : Tm := .app (.app (.ecase MT (.fst (.var 1)) bs) (.snd (.var 1))) (.var 0);
            let indT : Tm := match top with
              | .true => .ind 0 (IAt d) (DAt d) v (PAt d) (.lam (.lam (.lam convoy))) (shiftTm (d - L) 0 idx) (.var (d - 1 - L))
              | .false => .scase 0 (IAt d) (DAt d) v (PAt d) (.lam (.lam (.lam (.letE (.unit 0) .star convoy)))) .szInf
                  (shiftTm (d - L) 0 idx) (.var (d - 1 - L));
            let withE : Tm := match modeB with
              | .true => .app indT (.eqRefl (IAt d) (shiftTm (d - L) 0 idx))
              | .false => indT;
            .ok (tApps withE (genVars d G (p + 1))) es'
-- one branch per constructor, in the context of the method's binders (`cx3`, at depth
-- `d + 3`): `fun rest ih => let fields; (let hyps; let cur✝; fun q =>) …`
def branches (gs : Globals) (mc : MatchCtx) (es : ES) (cx3 : Cx) (expected : Val) (cols : List Col)
    (top : Bool) (ihLvls : List Nat) (cls : List Clause) (k : Nat) (col : Col) (T : String) (np : Nat)
    (args : Tms) (nidx : Nat) (I idx fam : Tm) (modeB : Bool) (MB0 MB : Tm) (MBv : Val) (MT : Tm) (G b : Nat) (nc i : Nat) : List Ctor → BE
  | .nil => .ok .tnil es
  | .cons (.mk c fs res) rest =>
    let F := lenL fs;
    let d := Cx.lvl cx3 - 3;
    let d0 := d + 5;
    -- `rest` and `ih`: the convoy's motive at this constructor's tag
    let bt := whnf (eval (.cons (.vtag nc i) (TCtx.env (Cx.c cx3))) MT);
    let cx5 := match bt with
      | .vpi _ restTy e1 c1 _ =>
        let cx4 := Cx.bind cx3 "rest✝" restTy;
        match whnf (eval (.cons (fresh (d + 3)) e1) c1) with
        | .vpi _ ihTy _ _ _ => Cx.bind cx4 "ihs✝" ihTy
        | _ => Cx.bind cx4 "ihs✝" .vtt
      | _ => Cx.bind (Cx.bind cx3 "rest✝" .vtt) "ihs✝" .vtt;
    let next := fun (es1 : ES) => branches gs mc es1 cx3 expected cols top ihLvls cls k col T np args nidx I idx fam modeB MB0 MB MBv MT G b nc (i + 1) rest;
    -- the motive's body at the method's `i` (level `d`; the motive itself is over the
    -- context before the method's binders, and `j`)
    let MBi := eval (.cons .vtt (.cons (fresh d) (dropEnv (3 + b) (TCtx.env (Cx.c cx3))))) MB;
    match col with
    | .mk L _ _ => match fieldCols np L d0 args cx5 0 fs with
      | .mk wrap fcols recs cx6 =>
        let cls' := specialize T c k F col cls;
        match Bool.and modeB (isNilCl cls') with
        | .true =>
          -- no clause: ruled out by the index (else a missing case)
          match absurdBranch cx6 np L d d0 F args I idx res MBi with
          | .some body => match next es with
            | .ok bs es'' => .ok (.tcons (.lam (.lam (wrap body))) bs) es''
            | e => e
          | .none => .err (String.append "missing case " c)
        | .false =>
          let recsT : List Nat := match top with
            | .true => recs
            | .false => .nil;
          let Rc := lenL recsT;
          let ihLvls' := List.append ihLvls recsT;
          match ihLetsB gs MB0 MB (d + 2) d0 F np L args I idx modeB fcols cx6 0 recsT with
          | .mk wrapIH cx7 => match mc with
            | .mk _ params p n _ _ _ pts ptsI _ =>
              let base := d0 + F + Rc;
              let cols' := List.append (takeL k cols) (List.append fcols (dropL (k + 1) cols));
              -- at the structural split, the method also runs for the hypotheses: a
              -- variable for the column is the value at hand, `cur✝ := con (tag, rest)`
              -- (its index is the method's `i✝`, at level `d`); then `e` (with a
              -- closed index) and the later parameters are bound again (`fun q => …`)
              let curTy := match col with
                | .mk L' _ _ => tApps fam (tmsAppend (shiftTms (base - L') args) (match nidx with
                  | .zero => .tnil
                  | .succ _ => .tcons (.var (base - 1 - d)) .tnil));
              let curVal : Tm := .con (.pair (.tag nc i) (.var (F + Rc + 1)));
              let env7 := TCtx.env (Cx.c cx7);
              let top1 := match top with
                | .true => 1
                | .false => 0;
              let eB := match modeB with
                | .true => 1
                | .false => 0;
              let cx8 := match top with
                | .true => Cx.define cx7 "cur✝" (eval env7 curVal) (eval env7 curTy)
                | .false => cx7;
              -- with a closed index at the structural split, `cur✝` (at the method's index)
              -- is moved along `e` to the scrutinee's index: `cur'✝ := coe … cur✝`
              let De := base + 2;
              let tyAt := fun (dd : Nat) (ix : Tm) => match col with
                | .mk L' _ _ => tApps fam (tmsAppend (shiftTms (dd - L') args) (.tcons ix .tnil));
              let idxE := shiftTm (De - L) 0 idx;
              let curTyB := tyAt De idxE;
              -- (`subst` moves propositions: `coe` along `F i = F idx`, from `tyRefl (F i)`)
              let FiE := tyAt De (.var (De - 1 - d));
              let tyEq : Tm := .subst (nfAt De (tApps (tLams np I) (shiftTms (De - L) args))) (.var (De - 1 - d))
                (.lam (.lam (.eqTy (tyAt (De + 2) (.var (De + 1 - d))) (tyAt (De + 2) (.var 1))))) (.tyRefl FiE) idxE (.var 0);
              let curValB : Tm := .coe FiE curTyB tyEq (.var (De - 1 - base));
              let afterE := match modeB with
                | .true => match whnf MBi with
                  | .vpi _ eTy envE codE _ =>
                    let cxe := Cx.bind cx8 "e✝" eTy;
                    let rem := eval (.cons (fresh (Cx.lvl cx8)) envE) codE;
                    match top with
                    | .true =>
                      let enve := TCtx.env (Cx.c cxe);
                      Gen.mk (Cx.define cxe "cur'✝" (eval enve curValB) (eval enve curTyB)) rem
                    | .false => Gen.mk cxe rem
                  | t => Gen.mk cx8 t
                | .false => Gen.mk cx8 (match top with
                  | .true => MBi
                  | .false => expected);
              match afterE with
              | .mk cxE rem =>
                let gen := match top with
                  | .true => genBind es cxE rem (dropL (p + 1) params)
                  | .false => Gen.mk cxE rem;
                match gen with
                | .mk cx9 expected' =>
                  let curCol := match top with
                    | .true => match modeB with
                      | .true => Col.mk (base + 2) curTyB curTyB
                      | .false => Col.mk base curTy curTy
                    | .false => col;
                  let cols'' := match top with
                    | .true => regen p n (base + 1 + eB + eB) pts pts cols'
                    | .false => cols';
                  match compileM gs mc es cx9 expected' cols'' .false ihLvls' (specialize T c k F curCol cls) with
                  | .err m => .err (match strEq m "missing case" with
                    | .true => String.append "missing case " c
                    | .false => m)
                  | .ok body es' =>
                    let inE : Tm := match modeB with
                      | .true => .lam (match top with
                        | .true => .letE curTyB curValB (tLams G body)
                        | .false => tLams G body)
                      | .false => tLams G body;
                    let inner : Tm := match top with
                      | .true => .letE curTy curVal inE
                      | .false => inE;
                    match next es' with
                    | .ok bs es'' => .ok (.tcons (.lam (.lam (wrap (wrapIH inner)))) bs) es''
                    | e => e
end

-- a definition `(binders) : T := v`: its type and value (zonked later)
inductive DefR where
  | ok (ty v : Tm) (es : ES)
  | err (msg : String)
mutual
def defT (gs : Globals) (es : ES) (cx : Cx) (bs : List Syntax) (tyS vS : Syntax) : DefR := match bs with
  | .nil => match inferType gs es cx tyS with
    | .ok R _ es1 => match checkT gs es1 cx vS (eval (TCtx.env (Cx.c cx)) R) with
      | .ok v _ es2 => .ok R v es2
      | .err m => .err m
    | .err m => .err m
  | .cons b rest => match binderType b with
    | .none => .err "the binders of a definition need types"
    | .some aS => defNames gs es cx (binderNames b) aS rest tyS vS
def defNames (gs : Globals) (es : ES) (cx : Cx) (xs : List String) (aS : Syntax) (rest : List Syntax) (tyS vS : Syntax) : DefR :=
  match xs with
  | .nil => defT gs es cx rest tyS vS
  | .cons x xs' => match inferType gs es cx aS with
    | .ok A _ es1 => match defNames gs es1 (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A)) xs' aS rest tyS vS with
      | .ok ty v es2 => .ok (.pi A ty) (.lam v) es2
      | e => e
    | .err m => .err m
end
-- the constants of a term replaced by the globals' inlined values (for `#reduce`, as
-- `quote` doesn't unfold constants)
mutual
def inlineTm (gs : Globals) : Tm → Tm
  | .const n _ _ _ _ => match Scope.lookup (Globals.scope gs) n with
    | .some i => globalTm .true gs i
    | .none => .var 0
  | .pi a b => .pi (inlineTm gs a) (inlineTm gs b)
  | .lam b => .lam (inlineTm gs b)
  | .app f a => .app (inlineTm gs f) (inlineTm gs a)
  | .letE ty v b => .letE (inlineTm gs ty) (inlineTm gs v) (inlineTm gs b)
  | .ann t ty => .ann (inlineTm gs t) (inlineTm gs ty)
  | .sorted l t => .sorted l (inlineTm gs t)
  | .pair a b => .pair (inlineTm gs a) (inlineTm gs b)
  | .fst t => .fst (inlineTm gs t)
  | .snd t => .snd (inlineTm gs t)
  | .con t => .con (inlineTm gs t)
  | .ecase m sc bs => .ecase m (inlineTm gs sc) (inlineTms gs bs)
  | .ind l I D v P m i x => .ind l I D v P (inlineTm gs m) i (inlineTm gs x)
  | .scase l I D v P m sz i x => .scase l I D v P (inlineTm gs m) sz i (inlineTm gs x)
  | t => t
def inlineTms (gs : Globals) : Tms → Tms
  | .tnil => .tnil
  | .tcons t rest => .tcons (inlineTm gs t) (inlineTms gs rest)
end

-- bind `n` parameter types (a Π type's), then the rest
inductive Peeled where
  | mk (c : TCtx) (rest : Val)
def peelCtx : Nat → TCtx → Val → Peeled
  | .zero, c, v => .mk c v
  | .succ k, c, v => match whnf v with
    | .vpi _ dom env cod _ => peelCtx k (TCtx.bind c dom) (eval (.cons (fresh (TCtx.lvl c)) env) cod)
    | v' => .mk c v'
def indexIn : List String → String → Nat → Option Nat
  | .nil, _, _ => .none
  | .cons y ys, x, i => match strEq x y with
    | .true => .some i
    | .false => indexIn ys x (i + 1)
def elabTeleI (gs : Globals) : Scope → Nat → List Field → TmsR
  | _, _, .nil => .ok .tnil
  | sc, d, .cons (.mk x ty) rest => match elab sc ty with
    | .err m => .err m
    | .ok A => match elabTeleI gs (Scope.bind sc x) (d + 1) rest with
      | .ok ts => .ok (.tcons (closeG .true gs d A) ts)
      | e => e
-- the columns for the scrutinees (parameters, by name)
inductive ColsR where
  | ok (cols : List Col)
  | err (msg : String)
def scrutCols (params : List String) (pts ptsI : Tms) : List Syntax → ColsR
  | .nil => .ok .nil
  | .cons s rest => match indexIn params (identOf s) 0 with
    | .none => .err "a match must be on parameters"
    | .some i => match scrutCols params pts ptsI rest with
      | .ok cs => .ok (.cons (.mk i (nthTm pts i) (nthTm ptsI i)) cs)
      | e => e
-- the structural column: the leftmost one any clause has a constructor pattern in
def anyCtorAt (k : Nat) : List Clause → Bool
  | .nil => .false
  | .cons (.mk pats _ _) rest => Bool.or (Bool.not (isVarPat (nthSyntax pats k))) (anyCtorAt k rest)
def structuralCol (cls : List Clause) : Nat → Nat → Option Nat
  | .zero, _ => .none
  | .succ m, k => match anyCtorAt k cls with
    | .true => .some k
    | .false => structuralCol cls m (k + 1)
def colLvl : Col → Nat
  | .mk l _ _ => l
-- bind the parameters (their types a telescope `pts`)
def bindParams : Cx → Nat → List String → Tms → Cx
  | cx, _, .cons x xs, .tcons A rest => bindParams (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A)) 0 xs rest
  | cx, _, _, _ => cx
-- the parameters' types (typed, each over the ones before), and the context with them
inductive PR where
  | ok (tys : Tms) (cx : Cx)
  | err (msg : String)
def elabParams (gs : Globals) : Cx → List Field → PR
  | cx, .nil => .ok .tnil cx
  | cx, .cons (.mk x ty) rest => match inferType gs ES.empty cx ty with
    | .err m => .err m
    | .ok A0 _ es => match drain gs es with
      | .none => .err "could not elaborate a constructor argument"
      | .some es' => match zonk es' (Cx.lvl cx) A0 with
        | .none => .err "could not infer an implicit argument"
        | .some A => match elabParams gs (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A)) rest with
          | .ok tys cx' => .ok (.tcons A tys) cx'
          | e => e
-- does a clause's right-hand side mention `f`?
mutual
def mentionsIdent (f : String) (s : Syntax) : Bool := match s with
  | .ident n => strEq n f
  | .node _ args => mentionsArgs f args
  | _ => .false
def mentionsArgs (f : String) : SyntaxF .false → Bool
  | .nil => .false
  | .cons s rest => Bool.or (mentionsIdent f s) (mentionsArgs f rest)
end
def clausesMention (f : String) : List Clause → Bool
  | .nil => .false
  | .cons (.mk _ _ rhs) rest => Bool.or (mentionsIdent f rhs) (clausesMention f rest)
def matchDefCmd (gs : Globals) (stx : Syntax) : Step := match kid stx 1 with
  | .ident f => match kids (kid stx 4) with
    | .cons _ (.cons rStx _) =>
      let ps := fieldsOf (kids (kid stx 3));
      let params := fieldNames ps;
      let n := lenL params;
      let body := kid stx 6;
      match elabParams gs (Cx.mk empty (Globals.scope gs) .nil) ps with
      | .err m => errStep gs m
      | .ok pts cxP0 => match scrutCols params pts pts (nonAtoms (kids (kid body 1))) with
        | .err m => errStep gs m
        | .ok cols => match inferType gs ES.empty cxP0 rStx with
          | .err m => errStep gs m
          | .ok RE0 _ esR => match zonk esR n RE0 with
          | .none => errStep gs "could not infer an implicit argument"
          | .some RE =>
            let tyT := sortTy (piTele pts RE);
            let sc := bindAll (Globals.scope gs) params;
            match peelCtx n empty (eval .nil tyT) with
              | .mk c Rv => match sortOf c Rv with
                | .none => errStep gs "the result is not a type"
                | .some l => match lvlClosed l with
                  | .none => errStep gs "the result's universe must be a number"
                  | .some v =>
                    let cls := clausesOf (kids (kid body 3));
                    -- the structural parameter: the leftmost one a clause splits
                    let p := match structuralCol cls (lenL cols) 0 with
                      | .some k => colLvl (nthCol cols k)
                      | .none => 0;
                    let R := RE;
                    let mc := MatchCtx.mk f params p n v R R pts pts (paramMask (kids (kid stx 3)));
                    let cxP := bindParams (Cx.mk empty (Globals.scope gs) .nil) 0 params pts;
                    -- induction only for a definition that calls itself (a partial one calls
                    -- its axiom); else every split is case analysis (stage 19e)
                    let useInd := match Scope.lookup (Globals.scope gs) f with
                      | .some _ => Bool.false
                      | .none => clausesMention f cls;
                    match compileM gs mc ES.empty cxP (eval (TCtx.env (Cx.c cxP)) R) cols useInd .nil cls with
                    | .err m => errStep gs m
                    | .ok t _ =>
                      let fn := tLams n t;
                      match check empty fn (eval .nil tyT) with
                      | .err m => errStep gs m
                      | .ok _ _ => .mk (String.append f (String.append " : " (show .nil 0 tyT)))
                          (Globals.add gs (.mk f tyT fn (inlineTm gs fn) (paramMask (kids (kid stx 3)))))
    | _ => errStep gs "a definition needs a type"
  | _ => errStep gs "a definition needs a name"

-- **Exercise 14.5.** One command: elaborate it (`defT`, `inferT`), put the solutions of
-- the metavariables in (`zonk`), and check the result with the kernel, in the empty
-- context (the globals are constants).
def command (gs : Globals) (stx : Syntax) : Step :=
  --<sol
  let cx0 := Cx.mk empty (Globals.scope gs) .nil;
  match strEq (kindOf stx) "command.def" with
  | .true => match kid stx 1 with
    | .ident x => match kids (kid stx 4) with
      | .cons _ (.cons tyStx _) => match defT gs ES.empty cx0 (kids (kid stx 3)) tyStx (kid stx 6) with
        | .err m => errStep gs m
        | .ok ty0 v0 es0 => match drain gs es0 with
        | .none => errStep gs "could not elaborate a constructor argument"
        | .some es => match zonk es 0 ty0 with
          | .none => errStep gs "could not infer an implicit argument"
          | .some tyZ => let tyT := sortTy tyZ; match zonk es 0 v0 with
            | .none => errStep gs "could not infer an implicit argument"
            | .some v => match inferUniv empty tyT with
              | .err m => errStep gs m
              | .ok _ _ => match check empty v (eval .nil tyT) with
                | .err m => errStep gs m
                | .ok _ _ => .mk (String.append x (String.append " : " (show .nil 0 tyT)))
                    (Globals.add gs (.mk x tyT v (inlineTm gs v) (paramMask (kids (kid stx 3)))))
      | _ => errStep gs "a definition needs a type"
    | _ => errStep gs "a definition needs a name"
  | .false =>
    -- (`#check c` shows `c`'s type, without inserting its implicit arguments)
    let r := match inferHead gs ES.empty cx0 (kid stx 1) with
      | .ok t ty es _ => match strEq (kindOf stx) "command.check" with
        | .true => TE.ok t ty es
        | .false => inferT gs ES.empty cx0 (kid stx 1)
      | .err m => TE.err m;
    match r with
    | .err m => errStep gs m
    | .ok t0 _ es0 => match drain gs es0 with
    | .none => errStep gs "could not elaborate a constructor argument"
    | .some es => match zonk es 0 t0 with
      | .none => errStep gs "could not infer an implicit argument"
      | .some t => match infer empty t with
        | .err m => errStep gs m
        | .ok ty _ => match strEq (kindOf stx) "command.check" with
          | .true => .mk (show .nil 0 (quote 0 ty)) gs
          | .false => match strEq (kindOf stx) "command.reduce" with
            | .true => .mk (show .nil 0 (quote 0 (eval .nil (inlineTm gs t)))) gs
            | .false => errStep gs (String.append "unsupported command " (kindOf stx))
  --|ex
  --| errStep gs "not implemented"
  --sol>

-- Mutual inductive types (stages 18c–d): `mutual inductive A (ps) … inductive B (ps) …
-- end` (the members share the parameters `ps`; no indices) is one family
-- `A_B : (ps) → Enum m → Type` indexed by a tag, with every member's constructors; a
-- field whose type is a member applied to the parameters is recursive at that member's
-- tag, and member `j`'s constructors end at tag `j`. Each member is the constant
-- `A := fun ps => A_B ps (tag 0)`, so a match on an `A ps` runs at a closed index: the
-- other members' constructors are ruled out (18b). Constructors take the parameters
-- implicitly.
def indexOfName : List String → String → Nat → Option Nat
  | .nil, _, _ => .none
  | .cons y ys, x, i => match strEq x y with
    | .true => .some i
    | .false => indexOfName ys x (i + 1)
-- the member a field's type is (applied to the parameters), if any
def memberOf (members : List String) (ps : List String) (ty : Syntax) : Option Nat :=
  let head := match strEq (kindOf ty) "term.app" with
    | .true => identOf (kid ty 0)
    | .false => identOf ty;
  match indexOfName members head 0 with
  | .some j => match recField head ps 0 ty with
    | .yes _ => .some j
    | .no => .none
  | .none => .none
-- a field `H → B` with `B` a member: higher-order recursive (stage 19e)
inductive HRec where
  | yes (H : Syntax) (j : Nat)
  | no
def hrecMember (members ps : List String) (ty : Syntax) : HRec := match strEq (kindOf ty) "term.arrow" with
  | .true => match memberOf members ps (kid ty 2) with
    | .some j => .yes (kid ty 0) j
    | .none => .no
  | .false => .no
-- a member constructor's fields: as a description (`m` members, this one `j`)
def mctorDesc (inline : Bool) (gs : Globals) (members ps : List String) (m j : Nat) : Scope → Nat → List Field → Elab
  | _, _, .nil => .ok (.dret (.tag m j))
  | sc, d, .cons (.mk x ty) rest => match memberOf members ps ty with
    | .some j' => match mctorDesc inline gs members ps m j sc d rest with
      | .ok D => .ok (.drec (.tag m j') D)
      | e => e
    | .none => match hrecMember members ps ty with
    | .yes H j' => match elab sc H with
      | .err m' => .err m'
      | .ok Ht => match mctorDesc inline gs members ps m j sc d rest with
        | .ok D => .ok (.dhrec (closeG inline gs d Ht) (.lam (.tag m j')) D)
        | e => e
    | .no => match elab sc ty with
      | .err m' => .err m'
      | .ok A => match mctorDesc inline gs members ps m j (Scope.bind sc x) (d + 1) rest with
        | .ok D => .ok (.darg (closeG inline gs d A) (.lam D))
        | e => e
-- a member constructor: the member's index and the syntax
inductive MCtor where
  | mk (j : Nat) (c : Syntax)
def mctorsOf (j : Nat) : List Syntax → List MCtor
  | .nil => .nil
  | .cons c rest => .cons (.mk j c) (mctorsOf j rest)
def memberCtors : List Syntax → Nat → List MCtor
  | .nil, _ => .nil
  | .cons d rest, j => List.append (mctorsOf j (kids (kid d 6))) (memberCtors rest (j + 1))
def mdescs (inline : Bool) (gs : Globals) (members ps : List String) (m : Nat) : List MCtor → Descs
  | .nil => .ok .tnil
  | .cons (.mk j c) rest => match mctorDesc inline gs members ps m j (Scope.bind (bindAll (Globals.scope gs) ps) "t✝") (List.length ps + 1) (ctorFields c) with
    | .err e => .err e
    | .ok D => match mdescs inline gs members ps m rest with
      | .ok ds => .ok (.tcons D ds)
      | e => e
def identOf' (s : Syntax) : String := match s with
  | .ident n => n
  | _ => "_"
def memberNames : List Syntax → List String
  | .nil => .nil
  | .cons d rest => .cons (identOf' (kid d 1)) (memberNames rest)
def joinUnder : List String → String
  | .nil => ""
  | .cons n rest => match rest with
    | .nil => n
    | .cons _ _ => String.append (String.append n "_") (joinUnder rest)
-- the member types `A := fun ps => F ps (tag j)`
def addMembers (F FI : Tm) (np : Nat) (pts : Tms) (m : Nat) : Globals → Nat → List String → Globals
  | gs, _, .nil => gs
  | gs, j, .cons n rest =>
    let at := fun (f : Tm) => tLams np (.app (tApps f (pvars np np)) (.tag m j));
    addMembers F FI np pts m (Globals.add gs (.mk n (sortTy (piTele pts (.univ 0))) (at F) (at FI) .nil)) (j + 1) rest
-- the member constructors `A.c := fun ps fields => con (tag, fields…, refl, tt)`
inductive MAdded where
  | ok (gs : Globals) (ctors : List Ctor)
  | err (msg : String)
def markRec (members ps : List String) : List Field → List CField → List CField
  | .cons (.mk _ ty) fs, .cons (.mk x _ A AI) cs => .cons (.mk x (match memberOf members ps ty with
      | .some _ => .true
      | .none => match hrecMember members ps ty with
        | .yes _ _ => .true
        | .no => .false) A AI) (markRec members ps fs cs)
  | _, _ => .nil
def addMCtors (members ps : List String) (pts : Tms) (m k : Nat) : Globals → Nat → List MCtor → MAdded
  | gs, _, .nil => .ok gs .nil
  | gs, ci, .cons (.mk j c) rest =>
    let fs0 := ctorFields c;
    let n := List.length fs0;
    let np := List.length ps;
    let T := nthName members j;
    match Scope.lookup (Globals.scope gs) T with
    | .none => .err T
    | .some ti =>
      let Tc := globalTm .false gs ti;
      match ctorFieldTys gs "" .nil 0 Tc Tc (bindAll (Globals.scope gs) ps) np fs0 with
      | .err e => .err e
      | .ok fs1 =>
        -- (a field typed by a member is recursive)
        let fs := markRec members ps fs0 fs1;
        let ty := sortTy (piTele pts (ctorType (tApps Tc (pvars np (np + n))) fs));
        let v := tLams (np + n) (.con (.pair (.tag k ci) (payloadP (.eqRefl (.enum m) (.tag m j)) n (n - 1))));
        match check empty v (eval .nil ty) with
        | .err e => .err e
        | .ok _ _ => match addMCtors members ps pts m k (Globals.add gs (.mk (String.append (String.append T ".") (ctorName c)) ty v v
            (List.append (trues np) (falses n)))) (ci + 1) rest with
          | .ok gs' cs => .ok gs' (.cons (.mk (ctorName c) fs (.tag m j)) cs)
          | e => e
def addMemberInds (np : Nat) (I D DI : Tm) (cs : List Ctor) (fam : Tm) (m : Nat) : Globals → Nat → List String → Globals
  | gs, _, .nil => gs
  | gs, j, .cons n rest => addMemberInds np I D DI cs fam m (Globals.addInd gs n (.mk np I D DI cs (.some (.tag m j)) fam)) (j + 1) rest
def memberLines (ty : String) : List String → String
  | .nil => ""
  | .cons n rest => match rest with
    | .nil => String.append n ty
    | .cons _ _ => String.append (String.append n ty) (String.append "\n" (memberLines ty rest))
def mutualInductiveCmd (gs : Globals) (defs : List Syntax) : Step :=
  let members := memberNames defs;
  let m := List.length members;
  let F := joinUnder members;
  let mcs := memberCtors defs 0;
  let k := List.length mcs;
  let params := fieldsOf (kids (kid (nthSyntax defs 0) 3));
  let ps := fieldNames params;
  let np := List.length ps;
  let I : Tm := .enum m;
  let mkD := fun (ds : Tms) => (.darg (.enum k) (.lam (.ecase (.descr 0 I) (.var 0) ds)) : Tm);
  match elabTele gs (Globals.scope gs) 0 params with
  | .err e => errStep gs e
  | .ok pts => match mdescs .false gs members ps m mcs with
    | .err e => errStep gs e
    | .ok ds => match mdescs .true gs members ps m mcs with
      | .err e => errStep gs e
      | .ok dsI =>
        -- `fun ps i => μ D i` (the description moved under `i`)
        let body := fun (D : Tm) => tLams np (.lam (.mu 0 I (nfAt (np + 1) (tApps (tLams np D) (pvars np (np + 1)))) (.var 0)));
        let fty := sortTy (piTele pts (.pi I (.univ 0)));
        let fval := body (mkD ds);
        match check empty fval (eval .nil fty) with
        | .err e => errStep gs e
        | .ok _ _ =>
          let fvalI := body (mkD dsI);
          let gs1 := Globals.add gs (.mk F fty fval fvalI .nil);
          let Fc : Tm := .const F .nil .nil fval fty;
          let gs2 := addMembers Fc fvalI np pts m gs1 0 members;
          match addMCtors members ps pts m k gs2 0 mcs with
          | .err e => errStep gs e
          | .ok gs3 cs => .mk (memberLines (String.append " : " (show .nil 0 (piTele pts (.univ 0)))) members)
              (addMemberInds np I (mkD ds) (mkD dsI) cs Fc m gs3 0 members)

-- Equations (stages 16d–e): `def f (ps) : A₁ → … → Aₘ → R | p₁, …, pₘ => rhs …` is
-- `def f (ps) (x✝₁ : A₁) … : R := match x✝₁, … with | p₁, …, pₘ => rhs …`
-- (`(x : A) → B` names its parameter)
inductive Peel where
  | mk (binders scruts : List Syntax) (res : Syntax)
  | fail
def peelArrows : Nat → Nat → Syntax → Peel
  | .zero, _, ty => .mk .nil .nil ty
  | .succ k, i, ty =>
    let arrow := strEq (kindOf ty) "term.arrow";
    let dep := strEq (kindOf ty) "term.depArrow";
    match Bool.or arrow dep with
    | .false => .fail
    | .true =>
      let x := match dep with
        | .true => nthName (binderNames (kid ty 0)) 0
        | .false => String.append "x✝" (Nat.toString i);
      let A : Syntax := match dep with
        | .true => match binderType (kid ty 0) with
          | .some a => a
          | .none => .missing
        | .false => kid ty 0;
      let binder := mkNode "binder.explicit" (.cons (.atom "(") (.cons (mkNull .nil)
        (.cons (mkNull (one (.ident x))) (.cons (mkNull (.cons (.atom ":") (one A))) (one (.atom ")"))))));
      match peelArrows k (i + 1) (kid ty 2) with
      | .mk bs xs res => .mk (.cons binder bs) (.cons (mkNode "term.ident" (one (.ident x))) xs) res
      | .fail => .fail
def eqnsToMatch (stx : Syntax) : Option Syntax := match kids (kid stx 4) with
  | .cons colon (.cons ty _) =>
    let m := match kids (kid stx 5) with
      | .cons a _ => lenL (nonAtoms (kids (kid a 1)))
      | .nil => 1;
    match peelArrows m 0 ty with
    | .fail => .none
    | .mk bs xs res =>
      let body := mkNode "term.match" (.cons (.atom "match") (.cons (mkNull xs)
        (.cons (.atom "with") (one (kid stx 5)))));
      .some (mkNode "command.def" (.cons (.atom "def") (.cons (kid stx 1) (.cons (kid stx 2)
        (.cons (mkNull (List.append (kids (kid stx 3)) bs))
          (.cons (mkNull (.cons colon (one res))) (.cons (.atom ":=") (one body))))))))
  | _ => .none

-- (a definition's `match` on its parameters is compiled with recursion; on anything else
-- it is a term)
def scrutsAreParams (ps : List String) : List Syntax → Bool
  | .nil => .true
  | .cons s rest => match strEq (kindOf s) "term.ident" with
    | .true => match indexOfName ps (identOf s) 0 with
      | .some _ => scrutsAreParams ps rest
      | .none => .false
    | .false => .false
-- A shared catch-all (stage 19f, like the Lean side's `dflt✝`): a big last clause of
-- variables would be copied into every leaf of the splits before it (two columns of a
-- type with 70 constructors: 4900 copies). When the match does case analysis only, it
-- becomes a definition `f✝d (params) : R := let x := param; …; rhs`, checked once,
-- and the clause calls it.
mutual
def synSize (s : Syntax) : Nat := match s with
  | .node _ args => synSizeArgs args + 1
  | _ => 1
def synSizeArgs : SyntaxF .false → Nat
  | .nil => 0
  | .cons s rest => synSize s + synSizeArgs rest
end
def allVarPats : List Syntax → Bool
  | .nil => .true
  | .cons p rest => Bool.and (isVarPat p) (allVarPats rest)
def lastSyn : List Syntax → Option Syntax
  | .nil => .none
  | .cons s rest => match rest with
    | .nil => .some s
    | .cons _ _ => lastSyn rest
def replaceLastSyn (v : Syntax) : List Syntax → List Syntax
  | .nil => .nil
  | .cons s rest => match rest with
    | .nil => one v
    | .cons _ _ => .cons s (replaceLastSyn v rest)
def setNthSyn (v : Syntax) : List Syntax → Nat → List Syntax
  | .nil, _ => .nil
  | .cons s rest, i => match i with
    | .zero => .cons v rest
    | .succ j => .cons s (setNthSyn v rest j)
def setKid (s : Syntax) (i : Nat) (v : Syntax) : Syntax := mkNode (kindOf s) (setNthSyn v (kids s) i)
def explicitBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons b rest => .cons (mkNode "binder.explicit" (.cons (.atom "(") (.cons (kid b 1) (.cons (kid b 2)
      (.cons (kid b 3) (one (.atom ")"))))))) (explicitBinders rest)
-- `let x := scrutinee; …` for the clause's variables
def letsFor (body : Syntax) : List Syntax → List Syntax → Syntax
  | .cons p ps, .cons sc scs => match strEq (identOf p) "_" with
    | .true => letsFor body ps scs
    | .false => mkNode "term.let" (.cons (.atom "let") (.cons (mkNull .nil) (.cons (.ident (identOf p))
        (.cons (mkNull .nil) (.cons (.atom ":=") (.cons sc (.cons (mkNull .nil) (one (letsFor body ps scs)))))))))
  | _, _ => body
def identsOf : List String → List Syntax
  | .nil => .nil
  | .cons x rest => .cons (mkNode "term.ident" (one (.ident x))) (identsOf rest)
def withDefault' (gs : Globals) (stx : Syntax) : Step := match kid stx 1 with
  | .ident f =>
    let body := kid stx 6;
    let alts := kids (kid body 3);
    let scruts := nonAtoms (kids (kid body 1));
    let params := fieldNames (fieldsOf (kids (kid stx 3)));
    let useInd := match Scope.lookup (Globals.scope gs) f with
      | .some _ => Bool.false
      | .none => clausesMention f (clausesOf alts);
    match lastSyn alts with
    | .some a =>
      let pats := nonAtoms (kids (kid a 1));
      match Bool.and (Bool.and (Bool.not useInd) (Nat.lt 1 (lenL scruts)))
          (Bool.and (Nat.lt 2 (lenL alts)) (Bool.and (allVarPats pats) (Nat.lt 24 (synSize (kid a 3))))) with
      | .true =>
        let g := String.append f "✝d";
        let dstx := mkNode "command.def" (.cons (.atom "def") (.cons (.ident g) (.cons (kid stx 2)
          (.cons (mkNull (explicitBinders (kids (kid stx 3)))) (.cons (kid stx 4) (.cons (.atom ":=")
            (one (letsFor (kid a 3) pats scruts))))))));
        match command gs dstx with
        | .mk line gs1 => match strEq (String.mk (takeL 6 (match line with
            | .mk cs => cs))) "error:" with
          | .true => .mk line gs
          | .false =>
            let call := mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident g))) (one (mkNull (identsOf params))));
            let body' := setKid body 3 (mkNull (replaceLastSyn (setKid a 3 call) alts));
            matchDefCmd gs1 (setKid stx 6 body')
      | .false => matchDefCmd gs stx
    | .none => matchDefCmd gs stx
  | _ => matchDefCmd gs stx
-- The structural parameter first (stage 19f): a recursive call may change only the
-- parameters after the structural one (they are generalised in the motive), so when
-- the structural parameter's type doesn't mention the earlier ones (and all are
-- explicit, one per binder), `f` is defined by `f✝s` with that parameter moved to the
-- front (the recursive calls permuted too), and `f (ps) := f✝s (ps')`.
def nthSyn : List Syntax → Nat → Syntax
  | .nil, _ => .missing
  | .cons s rest, i => match i with
    | .zero => s
    | .succ j => nthSyn rest j
def dropNthSyn : List Syntax → Nat → List Syntax
  | .nil, _ => .nil
  | .cons s rest, i => match i with
    | .zero => rest
    | .succ j => .cons s (dropNthSyn rest j)
def moveFront (xs : List Syntax) (i : Nat) : List Syntax := .cons (nthSyn xs i) (dropNthSyn xs i)
def singleExplicit : List Syntax → Bool
  | .nil => .true
  | .cons b rest => Bool.and (Bool.and (strEq (kindOf b) "binder.explicit") (Nat.beq (lenL (binderNames b)) 1))
      (singleExplicit rest)
def mentionsAny : List String → Syntax → Bool
  | .nil, _ => .false
  | .cons x rest, s => Bool.or (mentionsIdent x s) (mentionsAny rest s)
mutual
-- `f a₀ … aₙ₋₁` (all `n` arguments) as `g` with the `i`th argument first
def permCalls (f g : String) (n i : Nat) (s : Syntax) : Syntax := match s with
  | .node k args =>
    let s' : Syntax := .node k (permCallsArgs f g n i args);
    match Bool.and (strEq k "term.app") (strEq (identOf (kid s' 0)) f) with
    | .true => match Nat.beq (lenL (kids (kid s' 1))) n with
      | .true => mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident g))) (one (mkNull (moveFront (kids (kid s' 1)) i))))
      | .false => s'
    | .false => s'
  | s => s
def permCallsArgs (f g : String) (n i : Nat) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (permCalls f g n i s) (permCallsArgs f g n i rest)
end
def permAlts (f g : String) (n i : Nat) : List Syntax → List Syntax
  | .nil => .nil
  | .cons a rest => .cons (setKid a 3 (permCalls f g n i (kid a 3))) (permAlts f g n i rest)
inductive Reorder where
  | yes (helper main : Syntax)
  | no
-- `(x y : A)` as `(x : A) (y : A)`
def splitNames (b : Syntax) : List String → List Syntax
  | .nil => .nil
  | .cons x rest => .cons (setKid b 2 (mkNull (one (.ident x)))) (splitNames b rest)
def splitBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons b rest => match strEq (kindOf b) "binder.explicit" with
    | .true => List.append (splitNames b (binderNames b)) (splitBinders rest)
    | .false => .cons b (splitBinders rest)
def reorderStructural (gs : Globals) (stx0 : Syntax) : Reorder := match kid stx0 1 with
  | .ident f =>
    let stx := setKid stx0 3 (mkNull (splitBinders (kids (kid stx0 3))));
    let bs := kids (kid stx 3);
    let params := fieldNames (fieldsOf bs);
    let n := lenL params;
    let body := kid stx 6;
    let alts := kids (kid body 3);
    let scruts := nonAtoms (kids (kid body 1));
    let useInd := match Scope.lookup (Globals.scope gs) f with
      | .some _ => Bool.false
      | .none => clausesMention f (clausesOf alts);
    match Bool.and useInd (singleExplicit bs) with
    | .false => .no
    | .true => match structuralCol (clausesOf alts) (lenL scruts) 0 with
      | .none => .no
      | .some k => match indexOfName params (identOf (nthSyn scruts k)) 0 with
        | .none => .no
        | .some i => match i with
          | .zero => .no
          | .succ _ => match mentionsAny (takeL i params) (match binderType (nthSyn bs i) with
              | .some t => t
              | .none => .missing) with
            | .true => .no
            | .false =>
              let g := String.append f "✝s";
              let alts' := permAlts f g n i alts;
              match clausesMention f (clausesOf alts') with
              | .true => .no
              | .false =>
                let helper := setKid (setKid (setKid stx 1 (.ident g)) 3 (mkNull (moveFront bs i)))
                  6 (setKid body 3 (mkNull alts'));
                let call := mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident g)))
                  (one (mkNull (moveFront (identsOf params) i))));
                .yes helper (setKid stx 6 call)
  | _ => .no
def withDefault (gs : Globals) (stx : Syntax) : Step := match reorderStructural gs stx with
  | .yes helper main => match matchDefCmd gs helper with
    | .mk line gs1 => match strEq (String.mk (takeL 6 (match line with
        | .mk cs => cs))) "error:" with
      | .true => .mk line gs
      | .false => command gs1 main
  | .no => withDefault' gs stx
-- one definition (or inductive type), by its form
def defStep (gs : Globals) (stx : Syntax) : Step := match strEq (kindOf stx) "command.inductive" with
  | .true => inductiveCmd gs stx
  | .false => match Bool.and (strEq (kindOf stx) "command.def") (Bool.and (strEq (kindOf (kid stx 6)) "term.match")
      (scrutsAreParams (fieldNames (fieldsOf (kids (kid stx 3)))) (nonAtoms (kids (kid (kid stx 6) 1))))) with
    | .true => withDefault gs stx
    | .false => match strEq (kindOf stx) "command.defEqns" with
      | .true => match eqnsToMatch stx with
        | .some d => withDefault gs d
        | .none => errStep gs "equations need a function type"
      | .false => command gs stx

-- Partial definitions and mutual blocks (stage 17d): each function is first an axiom of
-- its type, so that the bodies may call any of them (the kernel sees them so: there is
-- no termination check); then each body is checked as usual.
mutual
def teleT (gs : Globals) (es : ES) (cx : Cx) (bs : List Syntax) (tyS : Syntax) : TE := match bs with
  | .nil => inferType gs es cx tyS
  | .cons b rest => match binderType b with
    | .none => .err "the binders of a definition need types"
    | .some aS => teleNames gs es cx (binderNames b) aS rest tyS
def teleNames (gs : Globals) (es : ES) (cx : Cx) (xs : List String) (aS : Syntax) (rest : List Syntax) (tyS : Syntax) : TE :=
  match xs with
  | .nil => teleT gs es cx rest tyS
  | .cons x xs' => match inferType gs es cx aS with
    | .ok A _ es1 => match teleNames gs es1 (Cx.bind cx x (eval (TCtx.env (Cx.c cx)) A)) xs' aS rest tyS with
      | .ok B _ es2 => .ok (.pi A B) (.vsort (.lnum 0)) es2
      | e => e
    | e => e
end
inductive AxR where
  | ok (gs : Globals)
  | err (msg : String)

-- Witnesses for partial definitions (`Witness.lean`): the kernel takes a partial
-- definition `f : T` only with a term of `T` it checks (`checkPartial`), found here by a
-- search over the shape of `T`: a variable of the type's `Π`s, `fun x => w`, a pair,
-- `tt`, a tag, `∞`, `Unit` for a sort, or a global whose type ends in `T`'s head (a
-- constructor, `StrMap.empty`), with the arguments its conclusion fixes taken from `T`
-- and the others found again, to a bounded depth. Each candidate is checked: so `T.mk :
-- T .t` is no witness of `T .f`.
inductive WPeel where
  | bind (dom cod : Tm)
  | done
partial def wPeel : Tm → WPeel
  | .pi a b => .bind a b
  | .piq _ a b => .bind a b
  | .sorted _ t => wPeel t
  | _ => .done
-- a global type's conclusion and its number of binders
inductive Concl where
  | mk (t : Tm) (k : Nat)
partial def tmConcl (t : Tm) (k : Nat) : Concl := match wPeel t with
  | .bind _ b => tmConcl b (k + 1)
  | .done => match t with
    | .sorted _ u => .mk u k
    | _ => .mk t k
partial def tmHeadName : Tm → Option String
  | .app f _ => tmHeadName f
  | .const n _ _ _ _ => .some n
  | .axiomC n _ => .some n
  | _ => .none
partial def tmArgs : Tm → List Tm → List Tm
  | .app f a, acc => tmArgs f (.cons a acc)
  | _, acc => acc
-- the names a type is known by, each with its arguments: the definitions it unfolds
-- through, then its head
inductive HeadArgs where
  | mk (name : String) (args : List Val)
partial def wSpineArgs : Spine → List Val → List Val
  | .sapp sp a, acc => wSpineArgs sp (.cons a acc)
  | _, acc => acc
partial def headsOf (v : Val) : List HeadArgs := match v with
  | .vglued h sp u => match h with
    | .hconst n _ _ _ _ => .cons (.mk n (wSpineArgs sp .nil)) (headsOf (u ()))
    | _ => headsOf (u ())
  | .vne h sp => match h with
    | .haxiom n _ => .cons (.mk n (wSpineArgs sp .nil)) .nil
    | _ => .nil
  | _ => .nil
partial def headArgs (n : String) : List HeadArgs → Option (List Val)
  | .nil => .none
  | .cons h rest => match h with
    | .mk m as => match strEq n m with
      | .true => .some as
      | .false => headArgs n rest
partial def noneList : Nat → List (Option Val)
  | .zero => .nil
  | .succ k => .cons .none (noneList k)
partial def setNth : List (Option Val) → Nat → Val → List (Option Val)
  | .nil, _, _ => .nil
  | .cons x rest, i, v => match i with
    | .zero => .cons (.some v) rest
    | .succ j => .cons x (setNth rest j v)
-- the binders a global's conclusion fixes: an argument that is one of its own binders
partial def matchArgs (k : Nat) (as : List Tm) (vs : List Val) (asg : List (Option Val)) : List (Option Val) :=
  match as with
  | .nil => asg
  | .cons a as' => match vs with
    | .nil => asg
    | .cons v vs' => matchArgs k as' vs' (match a with
      | .var j => match Nat.lt j k with
        | .true => setNth asg (k - 1 - j) v
        | .false => asg
      | _ => asg)
-- a variable of the context of this type
partial def hypWit (c : TCtx) (ty : Val) (tys : Env) (i : Nat) : Option Tm := match tys with
  | .nil => .none
  | .cons t rest => match convTy c t ty with
    | .true => .some (.var i)
    | .false => hypWit c ty rest (i + 1)
def sortWit (l : Lvl) : Option Tm := match l with
  | .lnum n => match n with
    | .zero => .some .ptrue
    | .succ m => .some (.unit m)
  | _ => .none
-- the witness search's view of the globals: all of them, and by the head of their
-- conclusion (built once per partial definition, so the search doesn't scan every
-- global for every type it looks for)
inductive WEnv where
  | mk (all : Array Global) (ix : StrMap (List Nat))
def globalHead (g : Global) : Option String := match g with
  | .mk _ gty _ _ _ => match tmConcl gty 0 with
    | .mk concl _ => tmHeadName concl
-- (from the latest global down, so each list is in declaration order)
partial def headIndex (all : Array Global) (i : Nat) (m : StrMap (List Nat)) : StrMap (List Nat) := match i with
  | .zero => m
  | .succ j => headIndex all j (match globalHead (Array.getD all j (.mk "?" .star .star .star .nil)) with
    | .none => m
    | .some h => StrMap.insert m (Str.ofString h) (.cons j (StrMap.findD m (Str.ofString h) .nil)))
def WEnv.of (gs : Globals) : WEnv := match gs with
  | .mk all _ _ => .mk all (headIndex all (Array.size all) StrMap.empty)
def WEnv.global (we : WEnv) (i : Nat) : Global := match we with
  | .mk all _ => Array.getD all i (.mk "?" .star .star .star .nil)
def WEnv.cands (we : WEnv) (h : HeadArgs) : List Nat := match we with
  | .mk _ ix => match h with
    | .mk n _ => StrMap.findD ix (Str.ofString n) .nil
mutual
def wit (we : WEnv) (c : TCtx) (ty : Val) (fuel : Nat) : Option Tm := match fuel with
  | .zero => .none
  | .succ f => match hypWit c ty (TCtx.types c) 0 with
    | .some t => .some t
    | .none => witShape we c ty (whnf ty) fuel f
def witShape (we : WEnv) (c : TCtx) (ty w : Val) (fuel f : Nat) : Option Tm := match w with
  | .vpi _ dom env cod _ => match wit we (TCtx.bind c dom) (eval (.cons (fresh (TCtx.lvl c)) env) cod) fuel with
    | .some b => .some (.lam b)
    | .none => .none
  | .vsort l => sortWit l
  | .vunit _ => .some .star
  | .venum k => match k with
    | .zero => .none
    | .succ _ => .some (.tag k 0)
  | .vsize => .some .szInf
  | .vsigma _ a env b _ => match wit we c a fuel with
    | .none => .none
    | .some x => match wit we c (eval (.cons (eval (TCtx.env c) x) env) b) fuel with
      | .none => .none
      | .some y => .some (.pair x y)
  | _ => let hs := headsOf ty; byHeads we c ty hs f hs
-- the globals whose conclusion has one of the type's names as its head (`WEnv.ix`)
def byHeads (we : WEnv) (c : TCtx) (ty : Val) (hs : List HeadArgs) (f : Nat) : List HeadArgs → Option Tm
  | .nil => .none
  | .cons h rest => match byGlobals we c ty hs f (WEnv.cands we h) with
    | .some t => .some t
    | .none => byHeads we c ty hs f rest
def byGlobals (we : WEnv) (c : TCtx) (ty : Val) (hs : List HeadArgs) (f : Nat) : List Nat → Option Tm
  | .nil => .none
  | .cons i rest => match tryGlobal we c ty hs f (WEnv.global we i) with
    | .some t => .some t
    | .none => byGlobals we c ty hs f rest
def tryGlobal (we : WEnv) (c : TCtx) (ty : Val) (hs : List HeadArgs) (f : Nat) (g : Global) : Option Tm :=
  match g with
  | .mk n gty v _ _ => match tmConcl gty 0 with
    | .mk concl k => match tmHeadName concl with
      | .none => .none
      | .some h => match headArgs h hs with
        | .none => .none
        | .some vs => applyGlobal we c ty f (matchArgs k (tmArgs concl .nil) vs (noneList k)) gty .nil (.const n .nil .nil v gty)
def applyGlobal (we : WEnv) (c : TCtx) (ty : Val) (f : Nat) (asg : List (Option Val)) (gty : Tm) (env : Env) (acc : Tm) : Option Tm :=
  match wPeel gty with
  | .bind dom cod => match asg with
    | .cons a rest => match a with
      | .some v => applyGlobal we c ty f rest cod (.cons v env) (.app acc (quote (TCtx.lvl c) v))
      | .none => applyFound we c ty f rest dom cod env acc
    | .nil => applyFound we c ty f .nil dom cod env acc
  | .done => match check (TCtx.erase c) acc ty with
    | .ok _ _ => .some acc
    | .err _ => .none
-- an argument the conclusion doesn't fix: found by the search
def applyFound (we : WEnv) (c : TCtx) (ty : Val) (f : Nat) (asg : List (Option Val)) (dom cod : Tm) (env : Env) (acc : Tm) : Option Tm :=
  match wit we c (eval env dom) f with
  | .none => .none
  | .some w => applyGlobal we c ty f asg cod (.cons (eval (TCtx.env c) w) env) (.app acc w)
end
inductive PSigR where
  | ok (f : String) (ty : Tm)
  | err (msg : String)
-- the type of `axiom f (bs) : T` or of a partial `def f (bs) : T`
def sigType (gs : Globals) (d : Syntax) : PSigR := match kid d 1 with
  | .ident f => match kids (kid d 4) with
    | .cons _ (.cons tyS _) => match teleT gs ES.empty (Cx.mk empty (Globals.scope gs) .nil) (kids (kid d 3)) tyS with
      | .err m => .err m
      | .ok ty0 _ es => match zonk es 0 ty0 with
        | .none => .err "could not infer an implicit argument"
        | .some tyZ => let ty := sortTy tyZ; match inferUniv empty ty with
          | .err m => .err m
          | .ok _ _ => .ok f ty
    | _ => .err "a partial definition needs a type"
  | _ => .err "a definition needs a name"
def addAxioms : Globals → List Syntax → AxR
  | gs, .nil => .ok gs
  | gs, .cons d rest => match sigType gs d with
    | .err m => .err m
    | .ok f ty => addAxioms (Globals.add gs (.mk f ty (.axiomC f ty) (.axiomC f ty) (paramMask (kids (kid d 3))))) rest
-- a member of a partial group: `def …`, or `partial (default := w) def …`
def unwrapDef (d : Syntax) : Syntax := match strEq (kindOf d) "command.partial" with
  | .true => kid d 2
  | .false => d
def unwrapDefs : List Syntax → List Syntax
  | .nil => .nil
  | .cons d rest => .cons (unwrapDef d) (unwrapDefs rest)
-- the witness of a partial definition's type: the one written, or one found
def findWit (gs : Globals) (f : String) (ty : Tm) : PSigR := match wit (WEnv.of gs) empty (eval .nil ty) 4 with
  | .some w => .ok f w
  | .none => .err (String.append (String.append "partial definition " f)
      ": no witness found for its type; give one with `partial (default := w) def`")
def witnessOf (gs : Globals) (d : Syntax) (f : String) (ty : Tm) : PSigR := match strEq (kindOf d) "command.partial" with
  | .true => match kids (kid d 1) with
    | .nil => findWit gs f ty
    | .cons _ _ => match checkT gs ES.empty (Cx.mk empty (Globals.scope gs) .nil) (kid (kid d 1) 3) (eval .nil ty) with
      | .err m => .err m
      | .ok w0 _ es0 => match drain gs es0 with
        | .none => .err "could not elaborate the witness"
        | .some es => match zonk es 0 w0 with
          | .none => .err "could not infer an implicit argument of the witness"
          | .some w => .ok f w
  | .false => findWit gs f ty
-- the signatures of a partial group, each with its witness checked by the kernel
def addPartials : Globals → List Syntax → AxR
  | gs, .nil => .ok gs
  | gs, .cons d rest => match sigType gs (unwrapDef d) with
    | .err m => .err m
    | .ok f ty => match witnessOf gs d f ty with
      | .err m => .err m
      | .ok _ w => match checkPartial ty w with
        | .err m => .err (String.append (String.append "the witness of " f) (String.append ": " m))
        | .ok _ _ => addPartials (Globals.add gs (.mk f ty (.axiomC f ty) (.axiomC f ty) (paramMask (kids (kid (unwrapDef d) 3))))) rest
-- `axiom f (bs) : T` (stage 19c), printed like a definition
def axiomCmd (gs : Globals) (stx : Syntax) : Step := match addAxioms gs (one stx) with
  | .err m => errStep gs m
  | .ok gs' => match kid stx 1 with
    | .ident f => match identHead gs' ES.empty (Cx.mk empty (Globals.scope gs') .nil) f with
      | .ok _ ty _ _ => .mk (String.append (String.append f " : ") (show .nil 0 (quote 0 ty))) gs'
      | .err m => errStep gs m
    | _ => errStep gs "an axiom needs a name"
def joinLines : List String → String
  | .nil => ""
  | .cons l rest => match rest with
    | .nil => l
    | .cons _ _ => String.append (String.append l "\n") (joinLines rest)
-- the bodies, in order, each line for its definition
def defsSteps : Globals → List Syntax → Step
  | gs, .nil => .mk "" gs
  | gs, .cons d rest => match defStep gs d with
    | .mk line gs' => match defsSteps gs' rest with
      | .mk lines gs'' => .mk (match rest with
          | .nil => line
          | .cons _ _ => String.append (String.append line "\n") lines) gs''
def partialCmd (gs : Globals) (defs : List Syntax) : Step := match addPartials gs defs with
  | .err m => errStep gs m
  | .ok gs1 => defsSteps gs1 (unwrapDefs defs)

-- Structures (stage 18e): `structure T (ps) where f₁ : A₁ …` is the inductive type
-- `T (ps) where | mk (f₁ : A₁) …` and a projection `T.fᵢ {ps} (s : T ps) : Aᵢ` for each
-- field, by `match s with | .mk f₁ … => fᵢ` (all built as syntax, then checked as
-- usual; a field's type may not mention an earlier field yet).
def identStx (n : String) : Syntax := mkNode "term.ident" (one (.ident n))
def binderStx (ob cb x : String) (A : Syntax) : Syntax :=
  mkNode (match strEq ob "{" with
    | .true => "binder.implicit"
    | .false => "binder.explicit") (.cons (.atom ob) (.cons (mkNull .nil)
    (.cons (mkNull (one (.ident x))) (.cons (mkNull (.cons (.atom ":") (one A))) (one (.atom cb))))))
-- the parameter binders, made implicit
def implicitBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons b rest => .cons (mkNode "binder.implicit" (.cons (.atom "{") (.cons (kid b 1) (.cons (kid b 2)
      (.cons (kid b 3) (one (.atom "}"))))))) (implicitBinders rest)
def fieldName (f : Syntax) : String := identOf' (kid f 1)
def fieldBinders : List Syntax → List Syntax
  | .nil => .nil
  | .cons f rest => .cons (binderStx "(" ")" (fieldName f) (kid f 3)) (fieldBinders rest)
def fieldIdents : List Syntax → List Syntax
  | .nil => .nil
  | .cons f rest => .cons (identStx (fieldName f)) (fieldIdents rest)
def projections (T : String) (bs : List Syntax) (sTy pat : Syntax) : List Syntax → List Syntax
  | .nil => .nil
  | .cons f rest =>
    let alt := mkNode "match.alt" (.cons (.atom "|") (.cons (mkNull (one pat)) (.cons (.atom "=>") (one (identStx (fieldName f))))));
    let body := mkNode "term.match" (.cons (.atom "match") (.cons (mkNull (one (identStx "s✝")))
      (.cons (.atom "with") (one (mkNull (one alt))))));
    let d := mkNode "command.def" (.cons (.atom "def") (.cons (.ident (String.append (String.append T ".") (fieldName f)))
      (.cons (mkNull .nil) (.cons (mkNull (List.append (implicitBinders bs) (one (binderStx "(" ")" "s✝" sTy))))
        (.cons (mkNull (.cons (.atom ":") (one (kid f 3)))) (.cons (.atom ":=") (one body)))))));
    .cons d (projections T bs sTy pat rest)
def strIdents : List String → List Syntax
  | .nil => .nil
  | .cons x rest => .cons (identStx x) (strIdents rest)
def structCmd (gs : Globals) (stx : Syntax) : Step :=
  let T := identOf' (kid stx 1);
  let bs := kids (kid stx 3);
  let fs := kids (kid stx 6);
  let ps := fieldNames (fieldsOf bs);
  let sTy := match ps with
    | .nil => identStx T
    | .cons _ _ => mkNode "term.app" (.cons (identStx T) (one (mkNull (strIdents ps))));
  let ctor := mkNode "inductive.ctor" (.cons (.atom "|") (.cons (.ident "mk") (.cons (mkNull (fieldBinders fs)) (one (mkNull .nil)))));
  let ind := mkNode "command.inductive" (.cons (.atom "inductive") (.cons (kid stx 1) (.cons (kid stx 2) (.cons (kid stx 3)
    (.cons (kid stx 4) (.cons (.atom "where") (one (mkNull (one ctor)))))))));
  let pat := mkNode "term.app" (.cons (mkNode "term.dotIdent" (.cons (.atom ".") (one (.ident "mk")))) (one (mkNull (fieldIdents fs))));
  defsSteps gs (.cons ind (projections T bs sTy pat fs))

-- The self-hosted frontend's Prelude (stage 19a), read by `import Prelude`: numbers,
-- Booleans, lists, options, pairs, characters (by their code) and strings.
def preludeText : String := "inductive Nat where\n  | zero\n  | succ (n : Nat)\ninductive Bool where\n  | false\n  | true\ninductive List (A : Type) where\n  | nil\n  | cons (head : A) (tail : List A)\ninductive Option (A : Type) where\n  | none\n  | some (val : A)\nstructure Prod (A B : Type) where\n  fst : A\n  snd : B\nstructure Char where\n  code : Nat\nstructure String where\n  data : List Char\ndef Nat.add : Nat → Nat → Nat\n  | .zero, n => n\n  | .succ m, n => .succ (Nat.add m n)\ndef Nat.mul : Nat → Nat → Nat\n  | .zero, _ => .zero\n  | .succ m, n => Nat.add n (Nat.mul m n)\ndef Nat.pred : Nat → Nat\n  | .zero => .zero\n  | .succ n => n\ndef Nat.sub : Nat → Nat → Nat\n  | m, .zero => m\n  | m, .succ n => Nat.pred (Nat.sub m n)\ninfixl:65 \" + \" => Nat.add\ninfixl:65 \" - \" => Nat.sub\ninfixl:70 \" * \" => Nat.mul\ndef Nat.beq : Nat → Nat → Bool\n  | .zero, .zero => .true\n  | .succ m, .succ n => Nat.beq m n\n  | _, _ => .false\ndef Nat.blt : Nat → Nat → Bool\n  | _, .zero => .false\n  | .zero, .succ _ => .true\n  | .succ m, .succ n => Nat.blt m n\ndef Nat.lt : Nat → Nat → Bool\n  | _, .zero => .false\n  | .zero, .succ _ => .true\n  | .succ m, .succ n => Nat.lt m n\ndef Nat.le (m n : Nat) : Bool := Nat.lt m (.succ n)\ndef Nat.max (m n : Nat) : Nat := if Nat.lt m n then n else m\ndef Bool.not : Bool → Bool\n  | .true => .false\n  | .false => .true\ndef Bool.and : Bool → Bool → Bool\n  | .true, b => b\n  | .false, _ => .false\ndef Bool.or : Bool → Bool → Bool\n  | .true, _ => .true\n  | .false, b => b\ndef Nat.divGo : Nat → Nat → Nat → Nat\n  | .zero, _, _ => .zero\n  | .succ fuel, n, m => if Nat.lt n m then .zero else .succ (Nat.divGo fuel (Nat.sub n m) m)\ndef Nat.div (n m : Nat) : Nat := match m with\n  | .zero => .zero\n  | .succ _ => Nat.divGo n n m\ndef Nat.mod (n m : Nat) : Nat := Nat.sub n (Nat.mul m (Nat.div n m))\ninfixl:70 \" / \" => Nat.div\ndef Nat.pow : Nat → Nat → Nat\n  | _, .zero => .succ .zero\n  | b, .succ e => Nat.mul b (Nat.pow b e)\ndef Bool.xor : Bool → Bool → Bool\n  | .true, b => Bool.not b\n  | .false, b => b\ndef Nat.isOdd (n : Nat) : Bool := Nat.beq (Nat.mod n 2) 1\ndef Nat.bitwise (f : Bool → Bool → Bool) : Nat → Nat → Nat → Nat\n  | .zero, _, _ => .zero\n  | .succ fuel, a, b =>\n    let rest := Nat.mul 2 (Nat.bitwise f fuel (Nat.div a 2) (Nat.div b 2));\n    if f (Nat.isOdd a) (Nat.isOdd b) then .succ rest else rest\ndef Nat.land (a b : Nat) : Nat := Nat.bitwise Bool.and (Nat.add a b) a b\ndef Nat.lor (a b : Nat) : Nat := Nat.bitwise Bool.or (Nat.add a b) a b\ndef Nat.xor (a b : Nat) : Nat := Nat.bitwise Bool.xor (Nat.add a b) a b\ndef Nat.shiftLeft (a n : Nat) : Nat := Nat.mul a (Nat.pow 2 n)\ndef Nat.shiftRight (a n : Nat) : Nat := Nat.div a (Nat.pow 2 n)\ndef Nat.log2Go : Nat → Nat → Nat\n  | .zero, _ => .zero\n  | .succ fuel, n => if Nat.lt n 2 then .zero else .succ (Nat.log2Go fuel (Nat.div n 2))\ndef Nat.log2 (n : Nat) : Nat := Nat.log2Go n n\ndef Nat.testBit (n i : Nat) : Bool := Nat.isOdd (Nat.shiftRight n i)\ndef List.length {A : Type} : List A → Nat\n  | .nil => .zero\n  | .cons _ t => .succ (List.length t)\ndef List.append {A : Type} : List A → List A → List A\n  | .nil, ys => ys\n  | .cons x xs, ys => .cons x (List.append xs ys)\ninfixr:67 \" ++ \" => List.append\ndef List.map {A B : Type} (f : A → B) : List A → List B\n  | .nil => .nil\n  | .cons x xs => .cons (f x) (List.map f xs)\ndef String.append (a b : String) : String := .mk (List.append a.data b.data)\ndef String.length (s : String) : Nat := List.length s.data\ndef memo {A : Type} (f : Unit → A) : Unit → A := f\naxiom Array : Type → Type\naxiom Array.empty {A : Type} : Array A\naxiom Array.push {A : Type} (a : Array A) (x : A) : Array A\naxiom Array.size {A : Type} (a : Array A) : Nat\naxiom Array.getD {A : Type} (a : Array A) (i : Nat) (d : A) : A\naxiom Array.set {A : Type} (a : Array A) (i : Nat) (x : A) : Array A\naxiom World : Type\ndef IO (A : Type) : Type := World → Prod A World\ndef IO.pure {A : Type} (a : A) : IO A := fun w => .mk a w\ndef IO.bind {A B : Type} (x : IO A) (f : A → IO B) : IO B := fun w =>\n  let r := x w;\n  f r.fst r.snd\naxiom IO.println : String → IO Unit\naxiom IO.print : String → IO Unit\naxiom IO.readFile : String → IO String\naxiom Nat.toString : Nat → String\naxiom Str : Type\naxiom Str.ofString : String → Str\naxiom StrMap : Type → Type\naxiom StrMap.empty {V : Type} : StrMap V\naxiom StrMap.insert {V : Type} (m : StrMap V) (k : Str) (v : V) : StrMap V\naxiom StrMap.findD {V : Type} (m : StrMap V) (k : Str) (d : V) : V\naxiom StrMap.size {V : Type} (m : StrMap V) : Nat\ninductive SyntaxF : Bool → Type where\n  | missing : SyntaxF .true\n  | atom (val : String) : SyntaxF .true\n  | ident (val : String) : SyntaxF .true\n  | node (kind : String) (args : SyntaxF .false) : SyntaxF .true\n  | nil : SyntaxF .false\n  | cons (head : SyntaxF .true) (tail : SyntaxF .false) : SyntaxF .false\ndef Syntax : Type := SyntaxF .true\ndef SyntaxF.nth {b : Bool} : SyntaxF b → Nat → Syntax\n  | .cons x t, n => match n with\n    | .zero => x\n    | .succ m => SyntaxF.nth t m\n  | _, _ => .missing\ndef Syntax.getArg (stx : Syntax) (i : Nat) : Syntax := match stx with\n  | .node _ args => SyntaxF.nth args i\n  | _ => .missing\n"

-- Infix operators (stage 19b): `infixl:p " op " => f` (also `infixr`, `infix`) adds a
-- trailing term parser `a op b` (kind `term.infix op`) and the token `op`; each later
-- command is expanded before it is elaborated, `a op b` standing for `f a b`. The left
-- operand of `infixl` is at precedence `p` and the right one at `p + 1`, and the
-- other way round for `infixr`.
inductive Note where
  | mk (kind : String) (f : Syntax)
def dropSp : List Char → List Char
  | .nil => .nil
  | .cons c rest => match Nat.beq (Char.code c) 32 with
    | .true => dropSp rest
    | .false => .cons c rest
def trimStr (s : String) : String := match s with
  | .mk cs => .mk (List.reverseOf (dropSp (List.reverseOf (dropSp cs) .nil)) .nil)
def addTrailingTo (cat : String) (t : Trailing) : List Cat → List Cat
  | .nil => .nil
  | .cons (.mk n ls ts) rest => match strEq n cat with
    | .true => .cons (.mk n ls (List.append ts (.cons t .nil))) rest
    | .false => .cons (.mk n ls ts) (addTrailingTo cat t rest)
inductive Infix where
  | mk (cats : List Cat) (tokens : List String) (note : Note)
-- **Exercise 19.1.** `infixl:p " op " => f`: the parser tables with the trailing term
-- parser `op` then a term (kind `term.infix op`; left operand at `p`, right at `p + 1`,
-- swapped for `infixr`, both `p + 1` for `infix`), the token `op` (spaces trimmed), and
-- the notation (the kind and `f`, the command's last argument).
def infixCmd (cats : List Cat) (tokens : List String) (stx : Syntax) : Infix :=
  --<sol
  let kw := match kid stx 0 with
    | .atom v => v
    | _ => "infix";
  let p := numValue (kid stx 2);
  let op := trimStr (strValue (kid stx 3));
  let lp := match strEq kw "infixl" with
    | .true => p
    | .false => p + 1;
  let rp := match strEq kw "infixr" with
    | .true => p
    | .false => p + 1;
  let kind := String.append "term.infix " op;
  .mk (addTrailingTo "term" (.mk kind p lp 0 (.seq (.atom op) (.cat "term" rp))) cats) (.cons op tokens) (.mk kind (kid stx 5))
  --|ex
  --| .mk cats tokens (.mk "" (kid stx 5))
  --sol>
def identOf'' (s : Syntax) : String := match s with
  | .ident n => n
  | _ => "_"
def noteFor : List Note → String → Option Syntax
  | .nil, _ => .none
  | .cons (.mk k f) rest, k' => match strEq k k' with
    | .true => .some f
    | .false => noteFor rest k'
-- `do` (stage 19c, for `IO` only: there are no type classes): `do x ← e; rest` is
-- `IO.bind e (fun x => do rest)`, `do e; rest` is `IO.bind e (fun _ => do rest)`,
-- `do let x := v; rest` is `IO.bind (IO.pure v) (fun x => do rest)`, `do e` is `e`
def ioBind (e : Syntax) (x : String) (rest : Syntax) : Syntax :=
  mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident "IO.bind"))) (one (mkNull (.cons e
    (one (mkNode "term.fun" (.cons (.atom "fun") (.cons (mkNull (one (.ident x))) (.cons (.atom "=>") (one rest))))))))))
partial def expandDo (s : Syntax) : Syntax :=
  let k := kindOf s;
  match strEq k "doSeq.bind" with
  | .true => ioBind (kid s 2) (identOf'' (kid s 0)) (expandDo (kid s 4))
  | .false => match strEq k "doSeq.seq" with
    | .true => ioBind (kid s 0) "_" (expandDo (kid s 2))
    | .false => match strEq k "doSeq.let" with
      | .true => ioBind (mkNode "term.app" (.cons (mkNode "term.ident" (one (.ident "IO.pure"))) (one (mkNull (one (kid s 3))))))
          (identOf'' (kid s 1)) (expandDo (kid s 5))
      | .false => kid s 0
mutual
def expandNotes (notes : List Note) (s : Syntax) : Syntax := match s with
  | .node k args =>
    let s' : Syntax := .node k (expandArgs notes args);
    match strEq k "term.do" with
    | .true => expandDo (kid s' 1)
    | .false => match noteFor notes k with
      | .some f => mkNode "term.app" (.cons f (one (mkNull (.cons (kid s' 0) (one (kid s' 2))))))
      | .none => s'
  | s => s
def expandArgs (notes : List Note) : SyntaxF .false → SyntaxF .false
  | .nil => .nil
  | .cons s rest => .cons (expandNotes notes s) (expandArgs notes rest)
end

-- the `do` grammar: a category `doSeq`, and `do doSeq` a term
def addLeadingTo (cat : String) (l : Leading) : List Cat → List Cat
  | .nil => .nil
  | .cons (.mk n ls ts) rest => match strEq n cat with
    | .true => .cons (.mk n (List.append ls (.cons l .nil)) ts) rest
    | .false => .cons (.mk n ls ts) (addLeadingTo cat l rest)
def thenRest (p : PD) : PD := .seq p (.seq (.atom ";") (.cat "doSeq" 0))
def doCats (cats : List Cat) : List Cat :=
  addLeadingTo "term" (.mk "term.do" 1024 0 (.seq (.atom "do") (.cat "doSeq" 0)))
    (List.append cats (.cons (.mk "doSeq" (.cons (.mk "doSeq.last" 1024 0 (.cat "term" 0))
      (.cons (.mk "doSeq.bind" 1024 0 (.seq .ident (.seq (.atom "←") (thenRest (.cat "term" 0)))))
      (.cons (.mk "doSeq.seq" 1024 0 (thenRest (.cat "term" 0)))
      (.cons (.mk "doSeq.let" 1024 0 (.seq (.atom "let") (.seq .ident (.seq (.atom ":=") (thenRest (.cat "term" 0)))))) .nil)))) .nil) .nil))
-- the output so far, the globals, and the parser's tables and notations
inductive Run where
  | mk (out : List String) (gs : Globals) (cats : List Cat) (tokens : List String) (notes : List Note)
-- all the commands of a file, one output line each
-- one command: its output line (none for an import or a notation), and the state after
-- it; `done` at the end of the input
inductive StepR where
  | done
  | next (line : Option String) (stop : Nat) (gs : Globals) (cats : List Cat) (tokens : List String) (notes : List Note)
mutual
def stepCommand (cats : List Cat) (tokens : List String) (notes : List Note) (input : Array Nat) (pos : Nat)
    (gs : Globals) : StepR :=
  match Nat.lt (skipWs input pos) (Array.size input) with
  | .false => .done
  | .true => match parseCommandAt cats tokens input pos with
    | .err m => .next (.some (String.append "parse " m)) (Array.size input) gs cats tokens notes
    | .ok stx0 stop => match strEq (kindOf stx0) "command.import" with
    -- (only the Prelude: its commands are checked, silently)
    | .true => match runCommands (doCats cats) (.cons "←" (.cons "do" tokens)) notes (String.codes preludeText) 0 gs .nil with
      | .mk _ gs' cats' tokens' notes' => .next .none stop gs' cats' tokens' notes'
    | .false => match strEq (kindOf stx0) "command.infix" with
    | .true => match infixCmd cats tokens stx0 with
      | .mk cats' tokens' note => .next .none stop gs cats' tokens' (.cons note notes)
    | .false =>
      let stx := match notes with
        | .nil => stx0
        | _ => expandNotes notes stx0;
      let step := match strEq (kindOf stx) "command.partial" with
        | .true => partialCmd gs (one stx)
        | .false => match strEq (kindOf stx) "command.mutual" with
          | .true => match strEq (kindOf (nthSyntax (nonAtoms (kids (kid stx 1))) 0)) "command.inductive" with
            | .true => mutualInductiveCmd gs (nonAtoms (kids (kid stx 1)))
            | .false => partialCmd gs (nonAtoms (kids (kid stx 1)))
          | .false => match strEq (kindOf stx) "command.structure" with
            | .true => structCmd gs stx
            | .false => match strEq (kindOf stx) "command.axiom" with
              | .true => axiomCmd gs stx
              | .false => match strEq (kindOf stx) "command.extern" with
                -- (to the checker, a foreign function is an axiom)
                | .true => axiomCmd gs (mkNode "command.axiom" (.cons (.atom "axiom") (.cons (kid stx 3)
                    (.cons (mkNull .nil) (.cons (mkNull .nil) (one (mkNull (.cons (.atom ":") (one (kid stx 5))))))))))
                | .false => defStep gs stx;
      match step with
      | .mk line gs' => .next (.some line) stop gs' cats tokens notes
def runCommands (cats : List Cat) (tokens : List String) (notes : List Note) (input : Array Nat) (pos : Nat)
    (gs : Globals) (out : List String) : Run :=
  match stepCommand cats tokens notes input pos gs with
  | .done => .mk out gs cats tokens notes
  | .next line stop gs' cats' tokens' notes' => runCommands cats' tokens' notes' input stop gs' (match line with
    | .some l => .cons l out
    | .none => out)
end

def checkFile (cats : List Cat) (tokens : List String) (text : String) : List String :=
  match runCommands cats tokens .nil (String.codes text) 0 Globals.empty .nil with
  | .mk out _ _ _ _ => List.reverseOf out .nil
