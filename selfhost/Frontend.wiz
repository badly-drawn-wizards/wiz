-- From text to a checked term, all in Wiz (stage 14b): the lexer and parser read the
-- full Wiz grammar, and this scope checker turns the syntax of a few term forms into
-- the kernel's `Tm` (names become de Bruijn indices), which `Kernel.wiz` type checks.
-- Load it after `Lex.wiz`, `Parse.wiz` and `Kernel.wiz`.
--
-- Supported: identifiers, `Type n`, `(x : A) → B`, `A → B`, `fun x (y : A) => b` (the
-- binder types are not kept: a λ is checked against a type), application,
-- `let x : A := v; b`, `(t : T)` and parentheses; and (stage 16) inductive types.

-- the arguments of a node, as a list
def argsOf : SyntaxF .false → List Syntax
  | .nil => .nil
  | .cons s rest => .cons s (argsOf rest)
def kids : Syntax → List Syntax
  | .node _ args => argsOf args
  | _ => .nil
def kid (s : Syntax) (i : Nat) : Syntax := Syntax.getArg s i
def kindOf : Syntax → String
  | .node k _ => k
  | _ => ""
def is (s : Syntax) (k : String) : Bool := strEq (kindOf s) k

def digits : List Char → Nat → Nat
  | .nil, acc => acc
  | .cons c cs, acc => digits cs (Nat.add (Nat.mul acc 10) (Char.code c - 48))

def indexOf : List String → String → Nat → Option Nat
  | .nil, _, _ => .none
  | .cons n ns, x, i => match strEq n x with
    | .true => .some i
    | .false => indexOf ns x (i + 1)

-- the names in scope: the local binders (innermost first, with their number) and the
-- globals, by name (each with its position plus one; there are `count`)
inductive Scope where
  | mk (locals : List String) (depth : Nat) (globals : StrMap Nat) (count : Nat)
def Scope.empty : Scope := .mk .nil 0 StrMap.empty 0
def Scope.bind (sc : Scope) (x : String) : Scope := match sc with
  | .mk ls d gs n => .mk (.cons x ls) (d + 1) gs n
def Scope.addGlobal (sc : Scope) (x : String) : Scope := match sc with
  | .mk ls d gs n => .mk ls d (StrMap.insert gs (Str.ofString x) (n + 1)) (n + 1)
-- a name's index: a local binder's, or past them a global's (the latest is the nearest)
def Scope.lookup (sc : Scope) (x : String) : Option Nat := match sc with
  | .mk ls d gs n => match indexOf ls x 0 with
    | .some i => .some i
    | .none => match StrMap.findD gs (Str.ofString x) 0 with
      | .zero => .none
      | .succ p => .some (d + (n - 1 - p))

inductive Elab where
  | ok (t : Tm)
  | err (msg : String)

-- the names a binder introduces, and its type (if any)
def identNames : List Syntax → List String
  | .nil => .nil
  | .cons s rest => .cons (match s with
      | .ident n => n
      | _ => "_") (identNames rest)
def binderNames (b : Syntax) : List String := match b with
  | .ident n => .cons n .nil
  | _ => identNames (kids (kid b 2))
def binderType (b : Syntax) : Option Syntax := match kids (kid b 3) with
  | .cons _ (.cons t _) => .some t
  | _ => .none

-- all the names of a `fun`'s binders
def binders : List Syntax → List String
  | .nil => .nil
  | .cons b bs => List.append (binderNames b) (binders bs)

def univLevel (s : Syntax) : Nat := match kids (kid s 1) with
  | .cons l _ => match kid l 0 with
    | .node _ args => match argsOf args with
      | .cons (.atom d) _ => match d with
        | .mk cs => digits cs 0
      | _ => 0
    | _ => 0
  | .nil => 0

-- **Exercise 14.4.** Scope checking: names to indices (`Scope.lookup`, `Scope.bind`).
mutual
def elab : Scope → Syntax → Elab
  | _, _ => .err "not implemented"
def both : Scope → Syntax → Syntax → (Tm → Tm → Tm) → Elab
  | names, a, b, k => match elab names a with
    | .ok x => match elab names b with
      | .ok y => .ok (k x y)
      | e => e
    | e => e
-- `(x y : A) → B`: one Π per name, `A` read in each one's context
def pis : Scope → List String → Option Syntax → Syntax → Elab
  | names, .nil, _, body => elab names body
  | names, .cons x xs, ty, body => match ty with
    | .none => .err "a Π needs a binder type"
    | .some a => match elab names a with
      | .ok aT => match pis (Scope.bind names x) xs ty body with
        | .ok b => .ok (.pi aT b)
        | e => e
      | e => e
def lams : Scope → List String → Syntax → Elab
  | names, .nil, body => elab names body
  | names, .cons x xs, body => match lams (Scope.bind names x) xs body with
    | .ok b => .ok (.lam b)
    | e => e
def apps : Scope → Tm → List Syntax → Elab
  | _, f, .nil => .ok f
  | names, f, .cons a rest => match elab names a with
    | .ok aT => apps names (.app f aT) rest
    | e => e
end

-- parse, scope check and type check a closed term
def checkText (cats : List Cat) (tokens : List String) (text : String) : String :=
  match parseSyntax cats tokens "term" text with
  | .err m => String.append "parse " m
  | .ok stx => match elab Scope.empty stx with
    | .err m => String.append "scope error: " m
    | .ok t => typeOf t

-- A file of commands (stage 14c): `def x (binders) : T := v`, `#check t` and
-- `#reduce t`. The global definitions are the kernel's constants.

-- binder groups `(x y : A) …` around a result: Π types, each `A` read in its context
mutual
def groupPis : Scope → List Syntax → Syntax → Elab
  | names, .nil, body => elab names body
  | names, .cons b bs, body => match binderType b with
    | .none => .err "the binders of a definition need types"
    | .some a => piGroup names (binderNames b) a bs body
def piGroup : Scope → List String → Syntax → List Syntax → Syntax → Elab
  | names, .nil, _, bs, body => groupPis names bs body
  | names, .cons x xs, a, bs, body => match elab names a with
    | .ok aT => match piGroup (Scope.bind names x) xs a bs body with
      | .ok b => .ok (.pi aT b)
      | e => e
    | e => e
end

def List.reverseOf {A : Type} : List A → List A → List A
  | .nil, acc => acc
  | .cons x xs, acc => List.reverseOf xs (.cons x acc)

-- a global: its name, type, and value as closed terms (other globals are constants
-- in them), and its value with every global inlined (for `#reduce`, since `quote`
-- doesn't unfold constants)
inductive Global where
  | mk (name : String) (ty val inlined : Tm)
-- the globals so far: by position (the first is `0`), and their names in scope
inductive Globals where
  | mk (all : Array Global) (scope : Scope)
def Globals.empty : Globals := .mk Array.empty Scope.empty
def Globals.scope : Globals → Scope
  | .mk _ sc => sc
def Globals.add (gs : Globals) (g : Global) : Globals := match gs with
  | .mk all sc => match g with
    | .mk x _ _ _ => .mk (Array.push all g) (Scope.addGlobal sc x)
-- the global at index `i` (the latest is `0`): a constant, or its value inlined
def globalTm (inline : Bool) (gs : Globals) (i : Nat) : Tm := match gs with
  | .mk all _ => match Array.getD all (Array.size all - 1 - i) (.mk "?" .star .star .star) with
    | .mk n ty v iv => match inline with
      | .true => iv
      | .false => .const n .nil .nil v ty
-- close a scope-checked term: the variables beyond the `d` binders it is under are
-- globals (each command is checked in the empty context, so usage vectors and lookups
-- don't grow with the number of globals)
def closeG (inline : Bool) (gs : Globals) : Nat → Tm → Tm
  | d, .var i => match Nat.lt i d with
    | .true => .var i
    | .false => globalTm inline gs (i - d)
  | d, .pi a b => .pi (closeG inline gs d a) (closeG inline gs (d + 1) b)
  | d, .lam b => .lam (closeG inline gs (d + 1) b)
  | d, .app f a => .app (closeG inline gs d f) (closeG inline gs d a)
  | d, .letE ty v b => .letE (closeG inline gs d ty) (closeG inline gs d v) (closeG inline gs (d + 1) b)
  | d, .ann t ty => .ann (closeG inline gs d t) (closeG inline gs d ty)
  | _, t => t

-- the output of a command, and the globals after it
inductive Step where
  | mk (out : String) (gs : Globals)

def errStep (gs : Globals) (m : String) : Step := .mk (String.append "error: " m) gs

-- **Exercise 14.5.** One command. Scope-check against the globals' names, close the
-- result over the globals (`closeG`), and check it in the empty context.
def command (gs : Globals) (stx : Syntax) : Step :=
  errStep gs "not implemented"

-- Inductive types (stage 16a): `inductive T where | c (x : A) (y : T) …`, without
-- parameters or indices, in `Type`. `T` is the constant `μ D tt` for the description
--   D := darg (Enum k) (fun t => ecase t [D₁, …, Dₖ])
-- and each constructor `T.c` the constant `fun fields => con (tag, fields…, tt, tt)`.

-- a constructor's field, and whether its type is `T` itself (a recursive field)
inductive Field where
  | mk (name : String) (ty : Syntax)
def fieldsNamed (ty : Syntax) : List String → List Field
  | .nil => .nil
  | .cons x xs => .cons (.mk x ty) (fieldsNamed ty xs)
def fieldsOf : List Syntax → List Field
  | .nil => .nil
  | .cons b bs => match binderType b with
    | .none => fieldsOf bs
    | .some ty => List.append (fieldsNamed ty (binderNames b)) (fieldsOf bs)
def isRecField (T : String) (ty : Syntax) : Bool := match strEq (kindOf ty) "term.ident" with
  | .true => match kid ty 0 with
    | .ident n => strEq n T
    | _ => .false
  | .false => .false
def ctorName (c : Syntax) : String := match kid c 1 with
  | .ident n => n
  | _ => "_"
def ctorFields (c : Syntax) : List Field := fieldsOf (kids (kid c 2))

-- **Exercise 16.1.** The description of a constructor's fields (`ctorDesc` in
-- `Inductive.lean`): a field `(x : A)` is `darg A (fun x => …)`, a recursive one (of
-- type `T`) is `drec tt …`, and the end is `dret tt`. A recursive field binds no
-- variable. `sc` is the scope (the globals, then `t✝` and the fields so far that are
-- bound) and `d` the number of those binders, for closing a field's type over the
-- globals (`closeG inline gs d`).
def ctorDesc (inline : Bool) (gs : Globals) (T : String) : Scope → Nat → List Field → Elab
  | _, _, _ => .err "not implemented"

-- the constructors' descriptions, under the binder `t✝` of the tag
inductive Descs where
  | ok (ds : Tms)
  | err (msg : String)
def ctorDescs (inline : Bool) (gs : Globals) (T : String) : List Syntax → Descs
  | .nil => .ok .tnil
  | .cons c cs => match ctorDesc inline gs T (Scope.bind (Globals.scope gs) "t✝") 1 (ctorFields c) with
    | .err m => .err m
    | .ok D => match ctorDescs inline gs T cs with
      | .ok ds => .ok (.tcons D ds)
      | e => e
-- a constructor's type: `(fields) → T`, every field bound
def ctorType (gs : Globals) (T : String) (Tc : Tm) : Scope → Nat → List Field → Elab
  | _, _, .nil => .ok Tc
  | sc, d, .cons (.mk x ty) rest =>
    let A : Elab := match isRecField T ty with
      | .true => .ok Tc
      | .false => match elab sc ty with
        | .ok A => .ok (closeG .false gs d A)
        | e => e;
    match A with
    | .err m => .err m
    | .ok A => match ctorType gs T Tc (Scope.bind sc x) (d + 1) rest with
      | .ok B => .ok (.pi A B)
      | e => e
-- the payload `(field₁, …, (tt, tt))`, the first field being `var (n - 1)`
def payloadTm : Nat → Nat → Tm
  | .zero, _ => .pair .star .star
  | .succ r, i => .pair (.var i) (payloadTm r (i - 1))
-- add the constructors from the `i`th on
def addCtors (T : String) (Tc : Tm) (k : Nat) : Globals → Nat → List Syntax → Option Globals
  | gs, _, .nil => .some gs
  | gs, i, .cons c cs =>
    let fs := ctorFields c;
    let n := List.length fs;
    match ctorType gs T Tc (Globals.scope gs) 0 fs with
    | .err _ => .none
    | .ok ty =>
      let v := tLams n (.con (.pair (.tag k i) (payloadTm n (n - 1))));
      match check empty v (eval .nil ty) with
      | .err _ => .none
      | .ok _ _ => addCtors T Tc k (Globals.add gs (.mk (String.append (String.append T ".") (ctorName c)) ty v v)) (i + 1) cs
def inductiveCmd (gs : Globals) (stx : Syntax) : Step := match kid stx 1 with
  | .ident T =>
    let ctors := kids (kid stx 6);
    let k := List.length ctors;
    let mkD := fun (ds : Tms) => (.darg (.enum k) (.lam (.ecase (.descr 0 (.unit 0)) (.var 0) ds)) : Tm);
    match ctorDescs .false gs T ctors with
    | .err m => errStep gs m
    | .ok ds => match ctorDescs .true gs T ctors with
      | .err m => errStep gs m
      | .ok dsI =>
        let val : Tm := .mu 0 (.unit 0) (mkD ds) .star;
        match check empty val (.vsort (.lnum 1)) with
        | .err m => errStep gs m
        | .ok _ _ =>
          let gs1 := Globals.add gs (.mk T (.univ 0) val (.mu 0 (.unit 0) (mkD dsI) .star));
          match addCtors T (.const T .nil .nil val (.univ 0)) k gs1 0 ctors with
          | .none => errStep gs "ill-typed constructor"
          | .some gs2 => .mk (String.append T " : U0") gs2
  | _ => errStep gs "an inductive type needs a name"

-- all the commands of a file, one output line each
partial def runCommands (cats : List Cat) (tokens : List String) (input : Array Nat) (pos : Nat)
    (gs : Globals) (out : List String) : List String :=
  match Nat.lt (skipWs input pos) (Array.size input) with
  | .false => out
  | .true => match parseCommandAt cats tokens input pos with
    | .err m => .cons (String.append "parse " m) out
    | .ok stx stop =>
      let step := match strEq (kindOf stx) "command.inductive" with
        | .true => inductiveCmd gs stx
        | .false => command gs stx;
      match step with
      | .mk line gs' => runCommands cats tokens input stop gs' (.cons line out)

def checkFile (cats : List Cat) (tokens : List String) (text : String) : List String :=
  List.reverseOf (runCommands cats tokens (String.codes text) 0 Globals.empty .nil) .nil
