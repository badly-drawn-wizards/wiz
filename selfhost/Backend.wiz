-- The backend, in Wiz (stage 21): from the kernel terms the self-hosted frontend checks
-- to C. Load it after `Frontend.wiz`. A first, minimal version (21a–b): no reference
-- counting (the runtime collects garbage); payloads are nested pairs, though the
-- runtime keeps a chain of them as one object (`chainE`).
--
-- **Erasure** (21a) follows `Wiz/Compiler/Erase.lean`: a checked term becomes an
-- untyped program (`ETm`) without what has no runtime content. Types (anything whose
-- type is a sort), proofs (anything whose type is a proposition) and sizes become `◾`,
-- and so do the arguments and the first components of quantity `0`. Binders are kept
-- (an erased argument is passed as `◾`), so de Bruijn indices don't change. Erasure is
-- type directed: `eraseCheck` knows the expected type, `eraseInfer` computes it.
--
-- **Data.** A value of `μ D i` is its payload, nested pairs `(tag, (f₁, … ◾))`, except
-- for a type shaped like the natural numbers (two constructors, the second with one
-- recursive field, no index): its values are native numbers, and a match on one first
-- unpacks it (`natUnpack`). Descriptions are runtime data (`ret i` is `⟨0 i⟩`, `arg S F`
-- is `⟨1 ◾ F⟩`, `rec j E` is `⟨2 j E⟩`, `hrec H j E` is `⟨3 ◾ j E⟩`): the runtime's `ind`
-- walks them to compute the induction hypotheses.

mutual
inductive ETm where
  | erased
  | var (i : Nat)
  | glob (name : String)
  | lam (body : ETm)
  | app (f a : ETm)
  | letE (val body : ETm)
  -- an object: a tag and fields (a pair is `obj 0 [a, b]`, a tag `obj k []`)
  | obj (tag : Nat) (fields : ETms)
  | proj (i : Nat) (t : ETm)
  -- branch on the tag of a value
  | case (scrut : ETm) (branches : ETms)
  | nat (n : Nat)
  -- a runtime operation: `ind`, `natSucc`, `natUnpack`, `natPack`, `unreachable`
  | prim (op : String) (args : ETms)
inductive ETms where
  | nil
  | cons (t : ETm) (rest : ETms)
end

def etms1 (a : ETm) : ETms := .cons a .nil
def etms2 (a b : ETm) : ETms := .cons a (etms1 b)
def etms4 (a b c d : ETm) : ETms := .cons a (.cons b (etms2 c d))
def epair (a b : ETm) : ETm := .obj 0 (etms2 a b)
def eapps : ETm → ETms → ETm
  | f, .nil => f
  | f, .cons a rest => eapps (.app f a) rest

mutual
def showE : ETm → String
  | .erased => "◾"
  | .var i => String.append "#" (Nat.toString i)
  | .glob n => n
  | .lam b => String.append "(λ " (String.append (showE b) ")")
  | .app f a => String.append "(" (String.append (showE f) (String.append " " (String.append (showE a) ")")))
  | .letE v b => String.append "(let " (String.append (showE v) (String.append "; " (String.append (showE b) ")")))
  | .obj t fs => String.append "⟨" (String.append (Nat.toString t) (String.append (showEs fs) "⟩"))
  | .proj i t => String.append (showE t) (String.append "." (Nat.toString i))
  | .case s bs => String.append "(case " (String.append (showE s) (String.append " [" (String.append (showEs bs) "])")))
  | .nat n => Nat.toString n
  | .prim op as => String.append "(" (String.append op (String.append (showEs as) ")"))
def showEs : ETms → String
  | .nil => ""
  | .cons t rest => String.append " " (String.append (showE t) (showEs rest))
end

-- Has a value of this type no runtime content? (types, proofs, sizes, and their lifts)
partial def erasable (c : TCtx) (ty : Val) : Bool := match whnf ty with
  | .vsort _ => .true
  | .vsize => .true
  | .vsizeLt _ => .true
  | .vulift _ A => erasable c A
  | t => isProp c t

-- Is this `μ` shaped like the natural numbers? Its values are numbers at runtime.
def isNatDesc (D : Val) : Bool := match whnf D with
  | .vdarg S F => match whnf S with
    | .venum k => match Nat.beq k 2 with
      | .true => match whnf (vapp F (.vtag 2 0)) with
        | .vdret _ => match whnf (vapp F (.vtag 2 1)) with
          | .vdrec _ E => match whnf E with
            | .vdret _ => .true
            | _ => .false
          | _ => .false
        | _ => .false
      | .false => .false
    | _ => .false
  | _ => .false
def isNatTy (ty : Val) : Bool := match whnf ty with
  | .vmu _ I D _ _ => match whnf I with
    | .vunit _ => isNatDesc D
    | _ => .false
  | _ => .false

-- (the kernel has accepted the term: nothing to require of its proof markers, `inProof`)
def inferTy (c : TCtx) (t : Tm) : Option Val := match infer (TCtx.inProof c) t with
  | .ok ty _ => .some ty
  | .err _ => .none
-- the type of a term already known to be well typed, without checking it again: along
-- an elimination spine, else by the kernel's `infer` (erasure asks for the type of
-- every subterm; a full `infer` at each would be quadratic in the nesting depth)
partial def quickType (c : TCtx) (t : Tm) : Option Val := match t with
  | .var i => .some (lookup (TCtx.types c) i)
  | .const _ ps ls _ ty => .some (eval .nil (substIfAny ps ls ty))
  | .app f a => match quickType c f with
    | .some fty => match whnf fty with
      -- (the argument evaluated only if the codomain mentions it, as in the kernel)
      | .vpi _ _ env cod _ => .some (eval (.cons (match usesVar 0 cod with
          | .true => eval (TCtx.env c) a
          | .false => .vtt) env) cod)
      | _ => inferTy c t
    | .none => .none
  | .fst p => match quickType c p with
    | .some pty => match whnf pty with
      | .vsigma _ A _ _ _ => .some A
      | _ => inferTy c t
    | .none => .none
  | .snd p => match quickType c p with
    | .some pty => match whnf pty with
      | .vsigma _ _ env B _ => .some (eval (.cons (vfst (eval (TCtx.env c) p)) env) B)
      | _ => inferTy c t
    | .none => .none
  | .ann _ ty => .some (eval (TCtx.env c) ty)
  | .ecase m s _ => .some (eval (.cons (eval (TCtx.env c) s) (TCtx.env c)) m)
  | .ind _ _ _ _ P _ i x => .some (vapp (vapp (eval (TCtx.env c) P) (eval (TCtx.env c) i)) (eval (TCtx.env c) x))
  -- (the forms a match leaves: without these, erasing a match inferred the whole match
  -- again at every nested split)
  | .scase _ _ _ _ P _ _ i x => .some (vapp (vapp (eval (TCtx.env c) P) (eval (TCtx.env c) i)) (eval (TCtx.env c) x))
  | .exfalso m _ => .some (eval (TCtx.env c) m)
  | .coe _ B _ _ => .some (eval (TCtx.env c) B)
  | .tag k _ => .some (.venum k)
  | .star => .some (.vunit 1)
  | .letE A v b => quickType (TCtx.define c (eval (TCtx.env c) v) (eval (TCtx.env c) A)) b
  | .down x => match quickType c x with
    | .some xty => match whnf xty with
      | .vulift _ A => .some A
      | _ => inferTy c t
    | .none => .none
  | _ => inferTy c t

-- the payload of a value of `ty` for a match: unpacked from a number
def payloadOf (ty : Val) (x : ETm) : ETm := match isNatTy ty with
  | .true => .prim "natUnpack" (etms1 x)
  | .false => x

-- the result of erasing: the term, or why it failed
inductive ER where
  | ok (t : ETm)
  | err (msg : String)
inductive ERs where
  | ok (ts : ETms)
  | err (msg : String)

-- a literal payload `(tag k, rest)` of a natural number: `0` or the successor of the
-- field in `rest` (else the generic `natPack`)
def natOf (x : Tm) (x' : ETm) : ETm := match x' with
  | .obj _ fs => match fs with
    | .cons tg rest => match tg with
      | .obj k _ => match k with
        | .zero => .nat 0
        | .succ _ => match rest with
          | .cons r _ => match r with
            | .obj _ gs => match gs with
              | .cons f _ => .prim "natSucc" (etms1 f)
              | .nil => .prim "natPack" (etms1 x')
            | _ => .prim "natPack" (etms1 x')
          | .nil => .prim "natPack" (etms1 x')
      | _ => .prim "natPack" (etms1 x')
    | .nil => .prim "natPack" (etms1 x')
  | _ => .prim "natPack" (etms1 x')

mutual
-- **Exercise 21.1.** Erase `t`, checking it against `ty` (`eraseCheck` in `Erase.lean`):
-- an erasable type gives `◾`; `fun` against a Π erases the body under the binder; a
-- pair against a Σ is `⟨0 a b⟩` (`a` erased for quantity `0`); `con x` against `μ D i`
-- is the erased payload (a number for a type shaped like the naturals: `natOf`); the
-- descriptions are objects (see above); `tt` is `◾`; a `let` keeps its binder;
-- anything else is inferred (`eraseInfer`).
def eraseCheck (c : TCtx) (t : Tm) (ty : Val) : ER := match erasable c ty with
  | .true => .ok .erased
  | .false =>
  --<sol
  match t with
  | .lam b => match whnf ty with
    | .vpi _ dom env cod _ => match eraseCheck (TCtx.bind c dom) b (eval (.cons (fresh (TCtx.lvl c)) env) cod) with
      | .ok b' => .ok (.lam b')
      | e => e
    | _ => eraseInfer c t
  | .pair a b => match whnf ty with
    | .vsigma q A env B _ =>
      let ar : ER := match q with
        | .qz => .ok .erased
        | _ => eraseCheck c a A;
      match ar with
      | .ok a' => match eraseCheck c b (eval (.cons (eval (TCtx.env c) a) env) B) with
        | .ok b' => .ok (epair a' b')
        | e => e
      | e => e
    | _ => eraseInfer c t
  | .con x => match whnf ty with
    | .vmu l I D i sz => match eraseCheck c x (vInterp l I D (muFamilyAt l I D (sizePredOrInf sz)) i) with
      | .ok x' => match isNatTy ty with
        | .true => .ok (natOf x x')
        | .false => .ok x'
      | e => e
    | _ => eraseInfer c t
  | .dret i => match whnf ty with
    | .vdesc _ I => match eraseCheck c i I with
      | .ok i' => .ok (.obj 0 (etms1 i'))
      | e => e
    | _ => eraseInfer c t
  | .darg S D => match whnf ty with
    | .vdesc l I => match eraseCheck c D (.vpi .qw (eval (TCtx.env c) S) (.cons I .nil) (.descr l (.var 1)) .none) with
      | .ok D' => .ok (.obj 1 (etms2 .erased D'))
      | e => e
    | _ => eraseInfer c t
  | .drec j D => match whnf ty with
    | .vdesc _ I => match eraseCheck c j I with
      | .ok j' => match eraseCheck c D ty with
        | .ok D' => .ok (.obj 2 (etms2 j' D'))
        | e => e
      | e => e
    | _ => eraseInfer c t
  | .dhrec H j D => match whnf ty with
    | .vdesc _ I => match eraseCheck c j (.vpi .qw (eval (TCtx.env c) H) (.cons I .nil) (.var 1) .none) with
      | .ok j' => match eraseCheck c D ty with
        | .ok D' => .ok (.obj 3 (.cons .erased (etms2 j' D')))
        | e => e
      | e => e
    | _ => eraseInfer c t
  | .star => .ok .erased
  -- (P2) a marked proof is erased; a marker at another level is transparent
  | .prf l x => match lvlIsZero l with
    | .true => .ok .erased
    | .false => eraseCheck c x ty
  -- (Q4) `ULift` has no runtime content
  | .up a => match whnf ty with
    | .vulift _ A => eraseCheck c a A
    | _ => eraseInfer c t
  | .letE A v b =>
    let vA := eval (TCtx.env c) A;
    match eraseCheck c v vA with
    | .ok v' => match eraseCheck (TCtx.define c (eval (TCtx.env c) v) vA) b ty with
      | .ok b' => .ok (.letE v' b')
      | e => e
    | e => e
  | _ => eraseInfer c t
  --|ex
  --| .err "not implemented"
  --sol>
-- erase `t`, computing its type
def eraseInfer (c : TCtx) (t : Tm) : ER := match quickType c t with
  | .none => .err "erasure: an ill-typed term"
  | .some ty => match erasable c ty with
    | .true => .ok .erased
    | .false => match t with
      | .var i => .ok (.var i)
      | .const n _ _ _ _ => .ok (.glob n)
      | .app _ _ => eraseApp c t
      | .ann x A => eraseCheck c x (eval (TCtx.env c) A)
      | .letE _ _ _ => eraseCheck c t ty
      | .fst p => match eraseInfer c p with
        | .ok p' => .ok (.proj 0 p')
        | e => e
      | .snd p => match eraseInfer c p with
        | .ok p' => .ok (.proj 1 p')
        | e => e
      | .tag _ i => .ok (.obj i .nil)
      | .ecase m s bs => match eraseInfer c s with
        | .ok s' => match eraseBranches c m 0 bs with
          | .ok bs' => .ok (.case s' bs')
          | .err msg => .err msg
        | e => e
      | .coe A _ _ x => eraseCheck c x (eval (TCtx.env c) A)   -- (a function under a cast is checked)
      | .exfalso _ _ => .ok (.prim "unreachable" .nil)
      | .down x => eraseInfer c x
      | .prf _ x => eraseInfer c x
      | .ind l I D v P m i x =>
        let vI := eval (TCtx.env c) I;
        let vD := eval (TCtx.env c) D;
        let vP := eval (TCtx.env c) P;
        match eraseCheck c m (indMethodTy l v vI vD vP) with
        | .ok m' => match eraseCheck c D (.vdesc l vI) with
          | .ok D' => match eraseCheck c i vI with
            | .ok i' => match eraseInfer c x with
              | .ok x' =>
                let nat := match isNatTy (.vmu l vI vD (eval (TCtx.env c) i) .vszInf) with
                  | .true => 1
                  | .false => 0;
                .ok (.prim "ind" (.cons (.nat nat) (etms4 D' m' i' x')))
              | e => e
            | e => e
          | e => e
        | e => e
      | .scase l I D v P m sz i x =>
        -- `m ◾ i payload`
        let vI := eval (TCtx.env c) I;
        let vD := eval (TCtx.env c) D;
        match eraseCheck c m (scaseMethodTy l vI vD (eval (TCtx.env c) P) (eval (TCtx.env c) sz)) with
        | .ok m' => match eraseCheck c i vI with
          | .ok i' => match eraseInfer c x with
            | .ok x' => .ok (eapps m' (.cons .erased (etms2 i' (payloadOf (.vmu l vI vD (eval (TCtx.env c) i) .vszInf) x'))))
            | e => e
          | e => e
        | e => e
      | _ => .err "erasure: unsupported term"
-- the branches of an `ecase` with motive `m` (under the tag's binder), from tag `k`
def eraseBranches (c : TCtx) (m : Tm) (k : Nat) : Tms → ERs
  | .tnil => .ok .nil
  | .tcons b rest => match eraseCheck c b (eval (.cons (.vtag (k + 1 + tmsLen rest) k) (TCtx.env c)) m) with
    | .ok b' => match eraseBranches c m (k + 1) rest with
      | .ok bs => .ok (.cons b' bs)
      | e => e
    | .err msg => .err msg
-- an application: the head and the arguments, each erased against the head's type (an
-- argument of quantity `0`, or of an erasable type, is `◾`)
def eraseApp (c : TCtx) (t : Tm) : ER := match quickType c (spineHead t) with
  | .none => .err "erasure: an ill-typed head"
  | .some hty => match eraseInfer c (spineHead t) with
    | .ok h' => eraseArgs c h' hty (spineArgsTm t .nil)
    | e => e
def eraseArgs (c : TCtx) (f : ETm) (fty : Val) : List Tm → ER
  | .nil => .ok f
  | .cons a rest => match whnf fty with
    | .vpi q dom env cod _ =>
      let ar : ER := match q with
        | .qz => .ok .erased
        | _ => eraseCheck c a dom;
      match ar with
      | .ok a' => eraseArgs c (.app f a') (eval (.cons (match usesVar 0 cod with
          | .true => eval (TCtx.env c) a
          | .false => .vtt) env) cod) rest
      | e => e
    | _ => .err "erasure: applying a non-function"
end


-- **C generation** (21b). Each erased term becomes one C expression (GNU statement
-- expressions `({ … })` for `let` and `case`); a `λ` is lifted to a C function of its
-- captured variables and its argument, and becomes a closure. A global is a value built
-- the first time it is used (`get_g()`), named by its name, so the recursive calls of
-- a partial definition (to its axiom) reach the definition. Some globals are native
-- (`isNative`): the runtime provides them, their Wiz definitions are not compiled.

-- the C name of a global: letters and digits kept, any other character as `_code_`
def mangleChars : List Char → List Char
  | .nil => .nil
  | .cons c rest =>
    let k := Char.code c;
    match Bool.or (Bool.or (between k 48 57) (between k 65 90)) (between k 97 122) with
    | .true => .cons c (mangleChars rest)
    | .false => match Nat.toString k with
      | .mk ds => .cons (Char.mk 95) (List.append ds (.cons (Char.mk 95) (mangleChars rest)))
def mangle (n : String) : String := match n with
  | .mk cs => .mk (mangleChars cs)

-- the globals the runtime provides
def nativeNames : List String :=
  .cons "Nat.zero" (.cons "Nat.succ" (.cons "Nat.add" (.cons "Nat.sub" (.cons "Nat.mul" (.cons "Nat.pred"
  (.cons "Nat.beq" (.cons "Nat.blt" (.cons "Nat.lt" (.cons "Nat.le" (.cons "Nat.toString"
  (.cons "IO.println" (.cons "IO.print" (.cons "IO.readFile" (.cons "IO.argCount" (.cons "IO.arg" (.cons "Str.ofString"
  (.cons "Array.empty" (.cons "Array.push" (.cons "Array.size" (.cons "Array.getD" (.cons "Array.set"
  (.cons "StrMap.empty" (.cons "StrMap.insert" (.cons "StrMap.findD" (.cons "StrMap.size" (.cons "memo"
  (.cons "Nat.div" (.cons "Nat.mod" (.cons "Nat.pow" (.cons "Nat.land" (.cons "Nat.lor" (.cons "Nat.xor"
  (.cons "Nat.shiftLeft" (.cons "Nat.shiftRight" (.cons "Nat.log2" .nil)))))))))))))))))))))))))))))))))))
def elemStr (x : String) : List String → Bool
  | .nil => .false
  | .cons y rest => Bool.or (strEq x y) (elemStr x rest)
def isNative (n : String) : Bool := elemStr n nativeNames

-- the free variables of a term (indices at its top, each once)
def addVar (i : Nat) : List Nat → List Nat
  | .nil => .cons i .nil
  | .cons j rest => match Nat.beq i j with
    | .true => .cons j rest
    | .false => .cons j (addVar i rest)
def dropBound : List Nat → List Nat
  | .nil => .nil
  | .cons i rest => match i with
    | .zero => dropBound rest
    | .succ j => .cons j (dropBound rest)
mutual
def freeE : ETm → List Nat → List Nat
  | .var i, acc => addVar i acc
  | .lam b, acc => mergeVars (dropBound (freeE b .nil)) acc
  | .app f a, acc => freeE a (freeE f acc)
  | .letE v b, acc => mergeVars (dropBound (freeE b .nil)) (freeE v acc)
  | .obj _ fs, acc => freeEs fs acc
  | .proj _ t, acc => freeE t acc
  | .case s bs, acc => freeEs bs (freeE s acc)
  | .prim _ as, acc => freeEs as acc
  | _, acc => acc
def freeEs : ETms → List Nat → List Nat
  | .nil, acc => acc
  | .cons t rest, acc => freeEs rest (freeE t acc)
def mergeVars : List Nat → List Nat → List Nat
  | .nil, acc => acc
  | .cons i rest, acc => mergeVars rest (addVar i acc)
end

-- Code is built as a rope (`Doc`), printed piece by piece at the end: a `String` is a
-- list of characters, and appending copies its left side, so building a deep
-- expression by appending (2600 nested `ap(…)`s for a string literal) was quadratic.
inductive Doc where
  | t (s : String)
  | c (a b : Doc)
infixl:65 " ⧺ " => Doc.c
def Doc.nat (n : Nat) : Doc := .t (Nat.toString n)

-- the code so far: the lifted functions (latest first), a counter for names, and the
-- arity of each global defined by `λ`s (called directly when applied to that many
-- arguments: through curried closures, a call of `n` arguments made `n` closures, each
-- copying the arguments before it), and (reference counting mode) a reuse token wanted
-- by an allocation not yet given one (`Wish`, see `rcE`)
inductive Wish where
  | idle
  | want (w : String) (n : Nat)
inductive CG where
  | mk (fns : List Doc) (n : Nat) (ar : StrMap Nat) (pend : Wish)
inductive CR where
  | mk (code : Doc) (st : CG)
inductive FR where
  | mk (name : String) (st : CG)
def CG.fresh (st : CG) (base : String) : FR := match st with
  | .mk fns n ar p => .mk (String.append base (Nat.toString n)) (.mk fns (n + 1) ar p)
def CG.emit (st : CG) (f : Doc) : CG := match st with
  | .mk fns n ar p => .mk (.cons f fns) n ar p
def CG.arity (st : CG) (g : String) : Nat := match st with
  | .mk _ _ ar _ => StrMap.findD ar (Str.ofString g) 0
def CG.pend (st : CG) : Wish := match st with
  | .mk _ _ _ p => p
def CG.setPend (st : CG) (p : Wish) : CG := match st with
  | .mk fns n ar _ => .mk fns n ar p
-- an application's head and arguments
inductive ESpine where
  | mk (head : ETm) (args : List ETm)
def spineE : ETm → List ETm → ESpine
  | .app f a, acc => spineE f (.cons a acc)
  | t, acc => .mk t acc
def lamsOf : ETm → Nat
  | .lam b => lamsOf b + 1
  | _ => 0
def underLams : Nat → ETm → ETm
  | .zero, t => t
  | .succ k, t => match t with
    | .lam b => underLams k b
    | _ => t

-- the C expression of variable `i`: `names` are the C names of the variables in scope,
-- innermost first
def nthName' : List String → Nat → String
  | .nil, _ => "BOX(0)"
  | .cons x rest, i => match i with
    | .zero => x
    | .succ j => nthName' rest j
def joinC : List String → String
  | .nil => ""
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => x +++ ", " +++ joinC rest
def indexOfNat : Nat → List Nat → Nat → Option Nat
  | _, .nil, _ => .none
  | x, .cons y rest, i => match Nat.beq x y with
    | .true => .some i
    | .false => indexOfNat x rest (i + 1)
-- the captured variables' names inside a lifted function: `env[0]`, `env[1]`, …
def envNames (caps : List Nat) : Nat → Nat → List String
  | _, .zero => .nil
  | k, .succ m => .cons (match indexOfNat k caps 0 with
      | .some j => "env[" +++ Nat.toString j +++ "]"
      | .none => "BOX(0)") (envNames caps (k + 1) m)
def capsCode (names : List String) : List Nat → List String
  | .nil => .nil
  | .cons i rest => .cons (nthName' names i) (capsCode names rest)
-- inside a lifted chain of `k` `λ`s with `nc` captured variables: the parameters
-- (innermost first) are `a[nc+k-1]`, …, `a[nc]`; the captured ones `a[0]`, …
def paramNamesA (nc : Nat) : Nat → Nat → List String
  | _, .zero => .nil
  | k, .succ j => .cons ("a[" +++ Nat.toString (nc + j) +++ "]") (paramNamesA nc k j)
def capNamesA (caps : List Nat) : Nat → Nat → List String
  | _, .zero => .nil
  | i, .succ m => .cons (match indexOfNat i caps 0 with
      | .some j => "a[" +++ Nat.toString j +++ "]"
      | .none => "BOX(0)") (capNamesA caps (i + 1) m)
def dropBoundK : Nat → List Nat → List Nat
  | _, .nil => .nil
  | k, .cons i rest => match Nat.lt i k with
    | .true => dropBoundK k rest
    | .false => .cons (i - k) (dropBoundK k rest)
def maxVar : List Nat → Nat
  | .nil => 0
  | .cons i rest => Nat.max (i + 1) (maxVar rest)

def etmsLen : ETms → Nat
  | .nil => 0
  | .cons _ rest => etmsLen rest + 1

-- a chain of pairs `(e₀, (e₁, … t))` as its elements, at most `k` of them, then its tail
-- (`[t]` when `t` is not a pair): the runtime keeps a chain as one object
def chainE : Nat → ETm → ETms
  | .zero, t => etms1 t
  | .succ k, t => match t with
    | .obj tg fs => match tg with
      | .zero => match fs with
        | .cons a r => match r with
          | .cons b r2 => match r2 with
            | .nil => .cons a (chainE k b)
            | .cons _ _ => etms1 t
          | .nil => etms1 t
        | .nil => etms1 t
      | .succ _ => etms1 t
    | _ => etms1 t

-- **Constants.** A numeral the frontend built from `Nat.zero`, `Nat.succ` and `Nat.mul`
-- (binary numerals), and a string literal (`String.mk` of a list of `Char.mk` codes),
-- are recognised: a string becomes its code points in the C code, built once (strings
-- are immutable). Spelled out, each character was a chain of applications (800 bytes of
-- C), and the text was built again at every evaluation.
partial def natConst (t : ETm) : Option Nat := match t with
  | .nat n => .some n
  | .glob g => match strEq g "Nat.zero" with
    | .true => .some 0
    | .false => .none
  | .app f a => match f with
    | .glob g => match strEq g "Nat.succ" with
      | .true => match natConst a with
        | .some n => .some (n + 1)
        | .none => .none
      | .false => .none
    | .app h x => match h with
      | .glob g => match Bool.or (strEq g "Nat.mul") (strEq g "Nat.add") with
        | .true => match natConst x with
          | .some m => match natConst a with
            | .some n => .some (match strEq g "Nat.mul" with
              | .true => m * n
              | .false => m + n)
            | .none => .none
          | .none => .none
        | .false => .none
      | _ => .none
    | _ => .none
  | _ => .none
-- the codes of a constant `List Char`
partial def charsConst (t : ETm) : Option (List Nat) := match t with
  | .app f a => match f with
    | .glob g => match strEq g "List.nil" with
      | .true => .some .nil
      | .false => .none
    | .app h c => match h with
      | .app k _ => match k with
        | .glob g => match strEq g "List.cons" with
          | .true => match c with
            | .app m code => match m with
              | .glob ch => match strEq ch "Char.mk" with
                | .true => match natConst code with
                  | .some n => match charsConst a with
                    | .some rest => .some (.cons n rest)
                    | .none => .none
                  | .none => .none
                | .false => .none
              | _ => .none
            | _ => .none
          | .false => .none
        | _ => .none
      | _ => .none
    | _ => .none
  | _ => .none
def stringConst (t : ETm) : Option (List Nat) := match t with
  | .app f a => match f with
    | .glob g => match strEq g "String.mk" with
      | .true => charsConst a
      | .false => .none
    | _ => .none
  | _ => .none
def codesC : List Nat → Doc
  | .nil => .t ""
  | .cons n rest => match rest with
    | .nil => Doc.nat n
    | .cons _ _ => Doc.nat n ⧺ .t "," ⧺ codesC rest
mutual
-- **Exercise 21.2.** The C expression of a term (`names`: the variables in scope).
def cgE (st : CG) (names : List String) : ETm → CR
  --<sol
  | .erased => .mk (.t "BOX(0)") st
  | .var i => .mk (.t (nthName' names i)) st
  | .glob n => .mk (.t ("get_" +++ mangle n +++ "()")) st
  | .nat n => .mk (.t "BOX(" ⧺ Doc.nat n ⧺ .t "UL)") st
  | .app f a => match stringConst (.app f a) with
    -- a string literal: `({ static V s; s ? s : (s = wstr_codes(…)); })`
    | .some cs => match CG.fresh st "str" with
      | .mk x st1 => .mk (.t ("({ static V " +++ x +++ " = 0; if (!" +++ x +++ ") " +++ x +++ " = wcodes((uint32_t[]){") ⧺ codesC cs ⧺
          .t ((match cs with
            | .nil => "0"
            | .cons _ _ => "") +++ "}, " +++ Nat.toString (lenL cs) +++ "); " +++ x +++ "; })")) st1
    | .none => match natConst (.app f a) with
    | .some n => .mk (.t "BOX(" ⧺ Doc.nat n ⧺ .t "UL)") st
    | .none => match spineE f (.cons a .nil) with
    | .mk h args => match h with
      | .glob g =>
        let k := CG.arity st g;
        match Bool.and (Nat.lt 0 k) (Nat.le k (lenL args)) with
        -- a saturated call: `d_g(…)`, then the rest applied
        | .true => match cgList st names (takeL k args) with
          | .mk acs st1 => cgApps st1 names (.t ("d_" +++ mangle g +++ "(") ⧺ acs ⧺ .t ")") (dropL k args)
        | .false => cgApps st names (.t ("get_" +++ mangle g +++ "()")) args
      | _ => match cgE st names h with
        | .mk hc st1 => cgApps st1 names hc args
  | .proj i t => match cgE st names t with
    | .mk tc st1 => .mk (.t "fld(" ⧺ tc ⧺ .t ", " ⧺ Doc.nat i ⧺ .t ")") st1
  | .obj k fs => match fs with
    | .nil => .mk (.t "BOX(" ⧺ Doc.nat k ⧺ .t ")") st
    | .cons _ _ =>
      -- a chain of pairs is one object, its elements and then its tail
      let cs : ETms := chainE 8 (.obj k fs);
      match Nat.lt 1 (etmsLen cs) with
      | .true => match cgEs st names cs with
        | .mk fcs st1 => .mk (.t "mkobj(0, " ⧺ Doc.nat (etmsLen cs) ⧺ .t ", (V[]){" ⧺ fcs ⧺ .t "})") st1
      | .false => match cgEs st names fs with
        | .mk fcs st1 => .mk (.t "mkobj(" ⧺ Doc.nat k ⧺ .t ", " ⧺ Doc.nat (etmsLen fs) ⧺ .t ", (V[]){" ⧺ fcs ⧺ .t "})") st1
  | .letE v b => match cgE st names v with
    | .mk vc st1 => match CG.fresh st1 "l" with
      | .mk x st2 => match cgE st2 (.cons x names) b with
        | .mk bc st3 => .mk (.t ("({ V " +++ x +++ " = ") ⧺ vc ⧺ .t "; " ⧺ bc ⧺ .t "; })") st3
  | .case s bs => match cgE st names s with
    | .mk sc st1 => match CG.fresh st1 "s" with
      | .mk x st2 => match cgBranches st2 names 0 bs with
        | .mk bcs st3 => .mk (.t ("({ V " +++ x +++ " = ") ⧺ sc ⧺ .t ("; V r_; switch (tagof(" +++ x +++ ")) { ") ⧺ bcs ⧺
            .t "default: r_ = unreach(); } r_; })") st3
  | .prim op as => match cgEs st names as with
    | .mk acs st1 => .mk (.t ("p_" +++ mangle op +++ "(") ⧺ acs ⧺ .t ")") st1
  | .lam b0 =>
    -- a chain of `k` `λ`s, lifted to one `static V lamN(V *a)` over the captured
    -- variables and the `k` arguments: a function closure (`mkfun`) that collects them
    let k := lamsOf (.lam b0);
    let body := underLams k (.lam b0);
    let caps := dropBoundK k (freeE body .nil);
    let nc := lenL caps;
    match CG.fresh st "lam" with
    | .mk fname st1 =>
      let inner := List.append (paramNamesA nc k k) (capNamesA caps 0 (maxVar caps));
      match cgE st1 inner body with
      | .mk bc st2 =>
        let st3 := CG.emit st2 (.t ("static V " +++ fname +++ "(V *a) { return ") ⧺ bc ⧺ .t "; }");
        match caps with
        | .nil => .mk (.t ("mkfun(" +++ fname +++ ", " +++ Nat.toString k +++ ", 0, NULL)")) st3
        | .cons _ _ => .mk (.t ("mkfun(" +++ fname +++ ", " +++ Nat.toString (nc + k) +++ ", " +++ Nat.toString nc +++
            ", (V[]){" +++ joinC (capsCode names caps) +++ "})")) st3
  --|ex
  --| | _ => .mk (.t "unreach()") st
  --sol>
def cgEs (st : CG) (names : List String) : ETms → CR
  | .nil => .mk (.t "") st
  | .cons t rest => match cgE st names t with
    | .mk tc st1 => match rest with
      | .nil => .mk tc st1
      | .cons _ _ => match cgEs st1 names rest with
        | .mk rc st2 => .mk (tc ⧺ .t ", " ⧺ rc) st2
def cgList (st : CG) (names : List String) : List ETm → CR
  | .nil => .mk (.t "") st
  | .cons t rest => match cgE st names t with
    | .mk tc st1 => match rest with
      | .nil => .mk tc st1
      | .cons _ _ => match cgList st1 names rest with
        | .mk rc st2 => .mk (tc ⧺ .t ", " ⧺ rc) st2
def cgApps (st : CG) (names : List String) (f : Doc) : List ETm → CR
  | .nil => .mk f st
  | .cons a rest => match rest with
    | .nil => match cgE st names a with
      | .mk ac st1 => .mk (.t "ap(" ⧺ f ⧺ .t ", " ⧺ ac ⧺ .t ")") st1
    -- several arguments at once
    | .cons _ _ => match cgList st names (.cons a rest) with
      | .mk acs st1 => .mk (.t "apn(" ⧺ f ⧺ .t (", " +++ Nat.toString (lenL (.cons a rest)) +++ ", (V[]){") ⧺ acs ⧺ .t "})") st1
def cgBranches (st : CG) (names : List String) (k : Nat) : ETms → CR
  | .nil => .mk (.t "") st
  | .cons b rest => match cgE st names b with
    | .mk bc st1 => match cgBranches st1 names (k + 1) rest with
      | .mk rc st2 => .mk (.t "case " ⧺ Doc.nat k ⧺ .t ": r_ = " ⧺ bc ⧺ .t "; break; " ⧺ rc) st2
end


-- **Lazy `let`s.** The match compiler binds with `let`s things only some branches use:
-- a shared catch-all (`dflt✝`), the hypotheses of `ind` (each the result of a recursive
-- call). Evaluated eagerly they cost every call a full walk of its argument, or worse.
-- A cheap value (a variable, a global, projections of a variable) is substituted at its
-- uses; any other is suspended (`memo`) and forced where it is used.
mutual
def liftE (k c : Nat) : ETm → ETm
  | .var i => match Nat.lt i c with
    | .true => .var i
    | .false => .var (i + k)
  | .lam b => .lam (liftE k (c + 1) b)
  | .app f a => .app (liftE k c f) (liftE k c a)
  | .letE v b => .letE (liftE k c v) (liftE k (c + 1) b)
  | .obj t fs => .obj t (liftEs k c fs)
  | .proj i t => .proj i (liftE k c t)
  | .case s bs => .case (liftE k c s) (liftEs k c bs)
  | .prim op as => .prim op (liftEs k c as)
  | t => t
def liftEs (k c : Nat) : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (liftE k c t) (liftEs k c rest)
end
mutual
-- the body of `let` with variable `c` (at this depth) replaced by `v` (a term at the
-- `let`'s depth), and the variables above it moved down
def substE (v : ETm) (c : Nat) : ETm → ETm
  | .var i => match Nat.lt i c with
    | .true => .var i
    | .false => match Nat.beq i c with
      | .true => liftE c 0 v
      | .false => .var (i - 1)
  | .lam b => .lam (substE v (c + 1) b)
  | .app f a => .app (substE v c f) (substE v c a)
  | .letE x b => .letE (substE v c x) (substE v (c + 1) b)
  | .obj t fs => .obj t (substEs v c fs)
  | .proj i t => .proj i (substE v c t)
  | .case s bs => .case (substE v c s) (substEs v c bs)
  | .prim op as => .prim op (substEs v c as)
  | t => t
def substEs (v : ETm) (c : Nat) : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (substE v c t) (substEs v c rest)
end
def cheapE : ETm → Bool
  | .var _ => .true
  | .glob _ => .true
  | .erased => .true
  | .nat _ => .true
  | .proj _ t => cheapE t
  | .obj _ fs => match fs with
    | .nil => .true
    | .cons _ _ => .false
  | _ => .false
-- `f a` with `f` a lambda is a let (strict, as the application was), or `a` put in
-- place when cheap: a `match` is a method applied to the payload (`m ◾ i payload`), and
-- the closure built and called for every match was most of the allocation
def betaE : ETm → ETm → ETm
  | .lam b, a => match cheapE a with
    | .true => substE a 0 b
    | .false => .letE a b
  | .letE v b, a => .letE v (betaE b (liftE 1 0 a))
  | f, a => .app f a
-- **Strict `let`s** (reference counting mode): a `let` whose variable every path of its
-- body evaluates (not under a `λ`) is evaluated where it stands: suspending it costs a
-- thunk and gains nothing. (`unreachable` counts as using everything.)
mutual
def neededE (c : Nat) : ETm → Bool
  | .var i => Nat.beq i c
  | .app f a => match neededE c f with
    | .true => .true
    | .false => neededE c a
  | .letE v b => match neededE c v with
    | .true => .true
    | .false => neededE (c + 1) b
  | .obj _ fs => neededAny c fs
  | .proj _ t => neededE c t
  | .case s bs => match neededE c s with
    | .true => .true
    | .false => neededAll c bs
  | .prim op as => match strEq op "unreachable" with
    | .true => .true
    | .false => neededAny c as
  | _ => .false
def neededAny (c : Nat) : ETms → Bool
  | .nil => .false
  | .cons t rest => match neededE c t with
    | .true => .true
    | .false => neededAny c rest
def neededAll (c : Nat) : ETms → Bool
  | .nil => .true
  | .cons t rest => match neededE c t with
    | .true => neededAll c rest
    | .false => .false
end
-- (`sl`: strict `let`s, in the reference counting mode)
def strictLet (sl : Bool) (b : ETm) : Bool := match sl with
  | .true => neededE 0 b
  | .false => .false
mutual
def lazyLets (sl : Bool) : ETm → ETm
  | .letE v b =>
    let v' := lazyLets sl v;
    let b' := lazyLets sl b;
    match cheapE v' with
    | .true => substE v' 0 b'
    | .false => match strictLet sl b' with
      | .true => .letE v' b'
      -- `let x := memo (λ _. v); b[x ◾ / x]`
      | .false => .letE (.prim "memo" (etms1 (.lam (liftE 1 0 v')))) (substE (.app (.var 0) .erased) 0 (liftE 1 1 b'))
  | .lam b => .lam (lazyLets sl b)
  | .app f a => betaE (lazyLets sl f) (lazyLets sl a)
  | .obj t fs => .obj t (lazyLetsEs sl fs)
  | .proj i t => .proj i (lazyLets sl t)
  | .case s bs => .case (lazyLets sl s) (lazyLetsEs sl bs)
  | .prim op as => .prim op (lazyLetsEs sl as)
  | t => t
def lazyLetsEs (sl : Bool) : ETms → ETms
  | .nil => .nil
  | .cons t rest => .cons (lazyLets sl t) (lazyLetsEs sl rest)
end

-- **Reference counting** (stage 22, the `rc` mode; see `rt.c`). The C is in A-normal
-- form, statements in evaluation order (left to right), each intermediate value in a
-- local, so that every reference is accounted for (Perceus, as `Compiler/RC.lean`):
-- every variable is owned, and consumed exactly once, by its last use (a later use
-- `inc`s it first) or by a `dec` where it dies (a `let` whose body doesn't use it, a
-- parameter the body doesn't use, a `case` branch that doesn't use it). Functions own
-- their arguments and return an owned result; a projection reads its object (`inc`s
-- the field) and only then releases it, if that was its last use.
--
-- Liveness is computed backwards, in one pass: a term is compiled knowing the
-- variables used after it (`live`, by de Bruijn *level*, descending), and returns
-- those used from its start; the arguments of a call are compiled right to left.
def lvIns (x : Nat) : List Nat → List Nat
  | .nil => .cons x .nil
  | .cons y rest => match Nat.beq x y with
    | .true => .cons y rest
    | .false => match Nat.lt y x with
      | .true => .cons x (.cons y rest)
      | .false => .cons y (lvIns x rest)
def lvMem (x : Nat) : List Nat → Bool
  | .nil => .false
  | .cons y rest => match Nat.beq x y with
    | .true => .true
    | .false => match Nat.lt x y with
      | .true => lvMem x rest
      | .false => .false
def lvDel (x : Nat) : List Nat → List Nat
  | .nil => .nil
  | .cons y rest => match Nat.beq x y with
    | .true => rest
    | .false => .cons y (lvDel x rest)
partial def lvUnion (a b : List Nat) : List Nat := match a with
  | .nil => b
  | .cons x xs => match b with
    | .nil => a
    | .cons y ys => match Nat.beq x y with
      | .true => .cons x (lvUnion xs ys)
      | .false => match Nat.lt y x with
        | .true => .cons x (lvUnion xs b)
        | .false => .cons y (lvUnion a ys)
-- the levels in `a` and not in `b`
partial def lvDiff (a b : List Nat) : List Nat := match a with
  | .nil => .nil
  | .cons x xs => match b with
    | .nil => a
    | .cons y ys => match Nat.beq x y with
      | .true => lvDiff xs ys
      | .false => match Nat.lt y x with
        | .true => .cons x (lvDiff xs b)
        | .false => lvDiff a ys

-- the code of a term: its statements, the C expression of its (owned) value (a local
-- or a constant), the variables used from its start
inductive RR where
  | mk (code atom : Doc) (live : List Nat) (st : CG)
inductive RRs where
  | mk (code : Doc) (atoms : List Doc) (live : List Nat) (st : CG)
inductive RB where
  | mk (code atom : Doc) (live : List Nat) (pend : Wish)
-- the branches of a `case`, and the variables any of them uses
inductive RBs where
  | mk (bs : List RB) (live : List Nat) (st : CG)
inductive RU where
  | mk (code : Doc) (live : List Nat)

def joinDocs : List Doc → Doc
  | .nil => .t ""
  | .cons x rest => match rest with
    | .nil => x
    | .cons _ _ => x ⧺ .t ", " ⧺ joinDocs rest
def rangeL : Nat → Nat → List Nat
  | _, .zero => .nil
  | i, .succ m => .cons i (rangeL (i + 1) m)
def addK (k : Nat) : List Nat → List Nat
  | .nil => .nil
  | .cons i rest => .cons (i + k) (addK k rest)
-- `dec` the variables at these levels
def decsOf (names : List String) (d : Nat) : List Nat → Doc
  | .nil => .t ""
  | .cons x rest => .t ("dec(" +++ nthName' names (d - 1 - x) +++ "); ") ⧺ decsOf names d rest
-- at a function's start: `dec` the parameters (these indices) its body doesn't use
def entryDrops (names : List String) (d : Nat) (live : List Nat) : List Nat → Doc
  | .nil => .t ""
  | .cons j rest => match lvMem (d - 1 - j) live with
    | .true => entryDrops names d live rest
    | .false => .t ("dec(" +++ nthName' names j +++ "); ") ⧺ entryDrops names d live rest
-- the context: the **borrowed** variables (by level: parameters of the function being
-- compiled that it never consumes, so its callers keep them alive and it neither
-- releases them nor counts them as live), and each global function's borrowed
-- parameters (`true`: borrowed, first parameter first); and the variables whose cells
-- may be reused here (the owned variables matched on by the enclosing `case`s)
inductive RE where
  | mk (bor : List Nat) (sigs : StrMap (List Bool)) (cands : List Nat)
def RE.bor : RE → List Nat
  | .mk b _ _ => b
def RE.inner : RE → RE
  | .mk _ s _ => .mk .nil s .nil
def RE.sig (re : RE) (g : String) : List Bool := match re with
  | .mk _ s _ => StrMap.findD s (Str.ofString g) .nil
def RE.cands : RE → List Nat
  | .mk _ _ c => c
def RE.withCand (re : RE) (x : Nat) : RE := match re with
  | .mk b s c => .mk b s (lvIns x c)
-- **Reuse** (Perceus' reuse tokens). In a `case` branch on an owned variable `x`, an
-- allocation is compiled first (backwards) and leaves a wish for a cell of its size
-- (`CG.pend`); the place where `x` then dies (going on backwards: its last projection,
-- a lending call, the branch's start) grants it: `w = reset(x, n)` frees `x`'s fields
-- and keeps its cell if `x` was unique and of the same size class, and the allocation
-- `reuseobj(w, …)` writes there (else allocates). A wish not granted by the start of
-- the branch is `w = 0`. Branches and functions are separate: a token never crosses
-- into another branch.
inductive DropR where
  | mk (code : Doc) (st : CG)
-- `x` (C name `nm`) dies here
def dropC (re : RE) (st : CG) (nm : String) (x : Nat) : DropR := match lvMem x (RE.cands re) with
  | .true => match CG.pend st with
    | .want w n => .mk (.t ("V " +++ w +++ " = reset(" +++ nm +++ ", " +++ Nat.toString n +++ "); ")) (CG.setPend st .idle)
    | .idle => .mk (.t ("dec(" +++ nm +++ "); ")) st
  | .false => .mk (.t ("dec(" +++ nm +++ "); ")) st
def dropsCs (re : RE) (names : List String) (d : Nat) : CG → List Nat → DropR
  | st, .nil => .mk (.t "") st
  | st, .cons x rest => match dropC re st (nthName' names (d - 1 - x)) x with
    | .mk c st1 => match dropsCs re names d st1 rest with
      | .mk cs st2 => .mk (c ⧺ cs) st2
def dropsC (re : RE) (st : CG) (names : List String) (d : Nat) (xs : List Nat) : DropR := dropsCs re names d st xs
-- **Drop specialisation**: `x` dies at its projection `r` (a borrowed field): if `x` is
-- unique, `r` takes over `x`'s reference to it and the rest is released (`dropTake`;
-- `resetTake` also keeps the cell for a wish), else `r` is `inc`ed and `x` released
def takeC (re : RE) (st : CG) (nm r : String) (x : Nat) : DropR :=
  let plain : DropR := .mk (.t ("dropTake(" +++ nm +++ ", " +++ r +++ "); ")) st;
  match lvMem x (RE.cands re) with
  | .true => match CG.pend st with
    | .want w n => .mk (.t ("V " +++ w +++ " = resetTake(" +++ nm +++ ", " +++ Nat.toString n +++ ", " +++ r +++ "); ")) (CG.setPend st .idle)
    | .idle => plain
  | .false => plain
-- a branch's drops (`x` in `cands` may grant its wish `p`); a wish left is `w = 0`
def branchDrops (cands : List Nat) (names : List String) (d : Nat) : Wish → List Nat → Doc
  | p, .nil => match p with
    | .want w _ => .t ("V " +++ w +++ " = 0; ")
    | .idle => .t ""
  | p, .cons x rest =>
    let nm := nthName' names (d - 1 - x);
    match p with
    | .want w n => match lvMem x cands with
      | .true => .t ("V " +++ w +++ " = reset(" +++ nm +++ ", " +++ Nat.toString n +++ "); ") ⧺ branchDrops cands names d .idle rest
      | .false => .t ("dec(" +++ nm +++ "); ") ⧺ branchDrops cands names d p rest
    | .idle => .t ("dec(" +++ nm +++ "); ") ⧺ branchDrops cands names d p rest
-- the captured variables (indices) put in a closure: each `inc`ed if used after (or
-- borrowed)
def capUses (bor : List Nat) (names : List String) (d : Nat) (live : List Nat) : List Nat → RU
  | .nil => .mk (.t "") live
  | .cons c rest => match capUses bor names d live rest with
    | .mk rc rl => match Bool.or (lvMem (d - 1 - c) live) (lvMem (d - 1 - c) bor) with
      | .true => .mk (.t ("inc(" +++ nthName' names c +++ "); ") ⧺ rc) rl
      | .false => .mk rc (lvIns (d - 1 - c) rl)
def headB : List Bool → Bool
  | .nil => .false
  | .cons b _ => b
def tailB : List Bool → List Bool
  | .nil => .nil
  | .cons _ rest => rest
-- the owned variables (levels) passed in borrowed positions: lent to the call
def lentVars (bor : List Nat) (d : Nat) : List Bool → List ETm → List Nat
  | _, .nil => .nil
  | sig, .cons t rest => match headB sig with
    | .true => match t with
      | .var i => match Bool.and (Nat.lt i d) (Bool.not (lvMem (d - 1 - i) bor)) with
        | .true => lvIns (d - 1 - i) (lentVars bor d (tailB sig) rest)
        | .false => lentVars bor d (tailB sig) rest
      | _ => lentVars bor d (tailB sig) rest
    | .false => lentVars bor d (tailB sig) rest
-- the arguments of a direct call: their code, values, what to release after the call
inductive RRp where
  | mk (code : Doc) (atoms : List Doc) (posts : Doc) (live : List Nat) (st : CG)
-- a path of projections: its root, and its C text from a root `o`
def projRoot : ETm → ETm
  | .proj _ t => projRoot t
  | t => t
def projC (o : Doc) : ETm → Doc
  | .proj i t => .t "fld(" ⧺ projC o t ⧺ .t ", " ⧺ Doc.nat i ⧺ .t ")"
  | _ => o
-- the C expression applying `f` to `atoms`
def callC (f : Doc) (atoms : List Doc) : Doc := match atoms with
  | .nil => f
  | .cons a rest => match rest with
    | .nil => .t "ap(" ⧺ f ⧺ .t ", " ⧺ a ⧺ .t ")"
    | .cons _ _ => .t "apn(" ⧺ f ⧺ .t (", " +++ Nat.toString (lenL atoms) +++ ", (V[]){") ⧺ joinDocs atoms ⧺ .t "})"
-- `code`, then the value of `e` in a new local
def bindTo (st : CG) (code e : Doc) (live : List Nat) : RR := match CG.fresh st "t" with
  | .mk x st1 => .mk (code ⧺ .t ("V " +++ x +++ " = ") ⧺ e ⧺ .t "; ") (.t x) live st1
def branchesC (cands : List Nat) (names : List String) (d : Nat) (u : List Nat) (r : String) : Nat → List RB → Doc
  | _, .nil => .t ""
  | k, .cons b rest => match b with
    | .mk bc ba bl bp => .t "case " ⧺ Doc.nat k ⧺ .t ": { " ⧺ branchDrops cands names d bp (lvDiff u bl) ⧺ bc ⧺ .t (r +++ " = ") ⧺ ba ⧺
        .t "; break; } " ⧺ branchesC cands names d u r (k + 1) rest
-- the context of a `case`'s branches: the scrutinee's variable, if owned, may be reused
def caseRE (re : RE) (d : Nat) (s : ETm) : RE := match projRoot s with
  | .var j => match Nat.lt j d with
    | .true => match lvMem (d - 1 - j) (RE.bor re) with
      | .true => re
      | .false => RE.withCand re (d - 1 - j)
    | .false => re
  | _ => re
-- **Static objects**: a value of a constructor without fields is `(k, ◾)`, the same
-- every time: the runtime keeps one for each `k < 64` (`nul(k)`, never freed), as for
-- the Bools its natives return
def scalarOf : ETm → Option Nat
  | .nat n => .some n
  | .erased => .some 0
  | .obj k fs => match fs with
    | .nil => .some k
    | .cons _ _ => .none
  | _ => .none
def staticNul (tag : Nat) (items : ETms) : Option Nat := match tag with
  | .zero => match items with
    | .cons a rest => match rest with
      | .cons b more => match more with
        | .nil => match scalarOf a with
          | .some k => match scalarOf b with
            | .some z => match Bool.and (Nat.beq z 0) (Nat.lt k 64) with
              | .true => .some k
              | .false => .none
            | .none => .none
          | .none => .none
        | .cons _ _ => .none
      | .nil => .none
    | .nil => .none
  | .succ _ => .none
-- an object: in a reuse context with no wish open, it wishes for a cell (`w`)
def objC (w : String) (k n : Nat) (atoms : List Doc) : Doc := match strEq w "" with
  | .true => .t "mkobj(" ⧺ Doc.nat k ⧺ .t ", " ⧺ Doc.nat n ⧺ .t ", (V[]){" ⧺ joinDocs atoms ⧺ .t "})"
  | .false => .t ("reuseobj(" +++ w +++ ", ") ⧺ Doc.nat k ⧺ .t ", " ⧺ Doc.nat n ⧺ .t ", (V[]){" ⧺ joinDocs atoms ⧺ .t "})"


mutual
-- the code of `t` in a scope of `d` variables (`names`), `live` used after it
def rcE (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (t : ETm) : RR := match t with
  | .erased => .mk (.t "") (.t "BOX(0)") live st
  | .nat n => .mk (.t "") (.t "BOX(" ⧺ Doc.nat n ⧺ .t "UL)") live st
  | .var i => match Nat.lt i d with
    | .false => .mk (.t "") (.t "BOX(0)") live st
    | .true =>
      let nm := nthName' names i;
      match Bool.or (lvMem (d - 1 - i) live) (lvMem (d - 1 - i) (RE.bor re)) with
      | .true => .mk (.t ("inc(" +++ nm +++ "); ")) (.t nm) live st
      | .false => .mk (.t "") (.t nm) (lvIns (d - 1 - i) live) st
  | .glob n => bindTo st (.t "") (.t ("get_" +++ mangle n +++ "()")) live
  | .app f a => match stringConst t with
    -- a string literal, built once (a constant: released at exit)
    | .some cs => match CG.fresh st "str" with
      | .mk x st1 => .mk (.t ("static V " +++ x +++ " = 0; if (!" +++ x +++ ") { " +++ x +++ " = wcodes((uint32_t[]){") ⧺ codesC cs ⧺
          .t ((match cs with
            | .nil => "0"
            | .cons _ _ => "") +++ "}, " +++ Nat.toString (lenL cs) +++ "); rt_root(&" +++ x +++ "); } inc(" +++ x +++ "); ")) (.t x) live st1
    | .none => match natConst t with
      | .some n => .mk (.t "") (.t "BOX(" ⧺ Doc.nat n ⧺ .t "UL)") live st
      | .none => match spineE f (.cons a .nil) with
        | .mk h args => match h with
          | .glob g =>
            let k := CG.arity st g;
            match Bool.and (Nat.lt 0 k) (Nat.le k (lenL args)) with
            -- a saturated call `d_g(…)`, then the rest applied
            | .true => rcCall re st names d live g k args
            | .false => rcApply re st names d live h args
          | _ => rcApply re st names d live h args
  | .proj _ _ => match projRoot t with
    | .var j => match Nat.lt j d with
      -- a field of a variable: read, `inc`ed, and the variable released if this was its
      -- last use
      | .true =>
        let nm := nthName' names j;
        let x := d - 1 - j;
        match CG.fresh st "t" with
        | .mk r st1 => match lvMem x (RE.bor re) with
          | .true => .mk (.t ("V " +++ r +++ " = ") ⧺ projC (.t nm) t ⧺ .t ("; inc(" +++ r +++ "); ")) (.t r) live st1
          | .false => match lvMem x live with
            | .true => .mk (.t ("V " +++ r +++ " = ") ⧺ projC (.t nm) t ⧺ .t ("; inc(" +++ r +++ "); ")) (.t r) (lvIns x live) st1
            | .false => match takeC re st1 nm r x with
              | .mk tc st2 => .mk (.t ("V " +++ r +++ " = ") ⧺ projC (.t nm) t ⧺ .t "; " ⧺ tc) (.t r) (lvIns x live) st2
      | .false => .mk (.t "") (.t "BOX(0)") live st
    | root => match rcE re st names d live root with
      | .mk oc oa ol st1 => match CG.fresh st1 "t" with
        | .mk r st2 => .mk (oc ⧺ .t ("V " +++ r +++ " = ") ⧺ projC oa t ⧺ .t ("; inc(" +++ r +++ "); dec(") ⧺ oa ⧺ .t "); ") (.t r) ol st2
  | .obj k fs => match fs with
    | .nil => .mk (.t "") (.t "BOX(" ⧺ Doc.nat k ⧺ .t ")") live st
    | .cons _ _ =>
      -- a chain of pairs is one object, its elements and then its tail
      let cs : ETms := chainE 8 t;
      let isChain := Nat.lt 1 (etmsLen cs);
      let items : ETms := match isChain with
        | .true => cs
        | .false => fs;
      let tag := match isChain with
        | .true => 0
        | .false => k;
      let n := etmsLen items;
      let wish : FR := match RE.cands re with
        | .nil => .mk "" st
        | .cons _ _ => match CG.pend st with
          | .idle => match CG.fresh st "w" with
            | .mk w st0 => .mk w (CG.setPend st0 (.want w n))
          | .want _ _ => .mk "" st;
      match staticNul tag items with
      -- (a constant `(k, ◾)`: the runtime's static object, `nul(k)`)
      | .some kk => .mk (.t "") (.t ("nul(" +++ Nat.toString kk +++ ")")) live st
      | .none => match wish with
        | .mk w st0 => match rcEs re st0 names d live items with
          | .mk fc atoms fl st1 => bindTo st1 fc (objC w tag n atoms) fl
  | .letE v b => match CG.fresh st "l" with
    | .mk x st1 => match rcE re st1 (.cons x names) (d + 1) live b with
      | .mk bc ba bl st2 => match rcE re st2 names d (lvDel d bl) v with
        | .mk vc va vl st3 => .mk (vc ⧺ .t ("V " +++ x +++ " = ") ⧺ va ⧺ .t "; " ⧺ (match lvMem d bl with
            | .true => .t ""
            | .false => .t ("dec(" +++ x +++ "); ")) ⧺ bc) ba vl st3
  | .case s bs =>
    let re2 := caseRE re d s;
    match rcBranches re2 st names d live bs with
    | .mk rbs u st1 => match CG.fresh st1 "r" with
      | .mk r st2 => match CG.fresh st2 "k" with
        | .mk k st3 =>
          -- (an owned variable matched on and used by no branch dies in each branch)
          let ux := match projRoot s with
            | .var j => match Nat.lt j d with
              | .true => match lvMem (d - 1 - j) (RE.bor re) with
                | .true => u
                | .false => lvIns (d - 1 - j) u
              | .false => u
            | _ => u;
          let body := branchesC (RE.cands re2) names d ux r 0 rbs ⧺ .t ("default: " +++ r +++ " = unreach(); } ");
          match projRoot s with
          -- (the tag of a variable's field: read in place)
          | .var j => match Nat.lt j d with
            | .true =>
              let nm := nthName' names j;
              let isB := lvMem (d - 1 - j) (RE.bor re);
              .mk (.t ("uint32_t " +++ k +++ " = tagof(") ⧺ projC (.t nm) s ⧺ .t ("); V " +++ r +++ "; switch (" +++ k +++ ") { ") ⧺ body) (.t r) (match isB with
                  | .true => u
                  | .false => lvIns (d - 1 - j) u) st3
            | .false => .mk (.t ("V " +++ r +++ "; switch (0) { ") ⧺ body) (.t r) u st3
          | _ => match rcE re st3 names d u s with
            | .mk sc sa sl st4 => .mk (sc ⧺ .t ("uint32_t " +++ k +++ " = tagof(") ⧺ sa ⧺ .t "); dec(" ⧺ sa ⧺
                .t ("); V " +++ r +++ "; switch (" +++ k +++ ") { ") ⧺ body) (.t r) sl st4
  | .prim op as =>
    -- a suspended `let` (`memo (λ _. v)`, see `lazyLets`): one object, the lifted
    -- function's captured variables and then its value
    match strEq op "memo" with
    | .true => match as with
      | .cons f rest => match rest with
        | .nil => match f with
          | .lam fb => match lamsOf fb with
            | .zero => rcLam re st names d live f .true
            | .succ _ => rcPrim re st names d live op as
          | _ => rcPrim re st names d live op as
        | .cons _ _ => rcPrim re st names d live op as
      | .nil => rcPrim re st names d live op as
    | .false => rcPrim re st names d live op as
  | .lam _ => rcLam re st names d live t .false
def rcPrim (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (op : String) (as : ETms) : RR :=
  match rcEs re st names d live as with
  | .mk ac atoms al st1 => bindTo st1 ac (.t ("p_" +++ mangle op +++ "(") ⧺ joinDocs atoms ⧺ .t ")") al
-- a chain of `λ`s, lifted (as in `cgE`): a function closure, or with `thunk` a
-- suspension (`mkthunk`: a closure computing its value once, then releasing what it
-- captured)
def rcLam (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (t : ETm) (thunk : Bool) : RR :=
    -- a chain of `k` `λ`s, lifted as in `cgE`; the function owns its captured
    -- variables and arguments (`dec`ing those it doesn't use)
    let k := lamsOf t;
    let body := underLams k t;
    let caps := dropBoundK k (freeE body .nil);
    let nc := lenL caps;
    let d2 := k + maxVar caps;
    match CG.fresh st "lam" with
    | .mk fname st1 =>
      let inner := List.append (paramNamesA nc k k) (capNamesA caps 0 (maxVar caps));
      match rcE (RE.inner re) st1 inner d2 .nil body with
      | .mk bc ba bl st2 =>
        let st3 := CG.emit st2 (.t ("static V " +++ fname +++ "(V *a) { ") ⧺ entryDrops inner d2 bl (List.append (rangeL 0 k) (addK k caps)) ⧺
          bc ⧺ .t "return " ⧺ ba ⧺ .t "; }");
        match capUses (RE.bor re) names d live caps with
        | .mk cc cl => match thunk with
          | .true => match caps with
            | .nil => bindTo st3 cc (.t ("mkthunk(" +++ fname +++ ", 0, NULL)")) cl
            | .cons _ _ => bindTo st3 cc (.t ("mkthunk(" +++ fname +++ ", " +++ Nat.toString nc +++
                ", (V[]){" +++ joinC (capsCode names caps) +++ "})")) cl
          | .false => match caps with
            | .nil => bindTo st3 cc (.t ("mkfun(" +++ fname +++ ", " +++ Nat.toString k +++ ", 0, NULL)")) cl
            | .cons _ _ => bindTo st3 cc (.t ("mkfun(" +++ fname +++ ", " +++ Nat.toString (nc + k) +++ ", " +++ Nat.toString nc +++
                ", (V[]){" +++ joinC (capsCode names caps) +++ "})")) cl
-- a saturated call of `d_g`, then the rest applied: a variable in a borrowed position
-- is lent (kept alive across the call, released after it if that was its last use),
-- any other argument there is a temporary released after the call
def rcCall (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (g : String) (k : Nat) (args : List ETm) : RR :=
  let sig := RE.sig re g;
  let lent := lentVars (RE.bor re) d sig args;
  -- (the lent variables dying after the call are released first: compiled backwards)
  match dropsC re st names d (lvDiff lent live) with
  | .mk dc st0 => match rcArgs re st0 names d (lvUnion lent live) sig args with
    | .mk ac atoms posts al st1 => match bindTo st1 ac (.t ("d_" +++ mangle g +++ "(") ⧺ joinDocs (takeL k atoms) ⧺ .t ")") al with
      | .mk cc ca cl st2 =>
        let cc2 := cc ⧺ dc ⧺ posts;
        match dropL k atoms with
        | .nil => .mk cc2 ca cl st2
        | .cons _ _ => bindTo st2 cc2 (callC ca (dropL k atoms)) cl
def rcArgs (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (sig : List Bool) (ts : List ETm) : RRp := match ts with
  | .nil => .mk (.t "") .nil (.t "") live st
  | .cons t rest => match rcArgs re st names d live (tailB sig) rest with
    | .mk rc ras rp rl st1 => match headB sig with
      | .true => match t with
        | .var i => match Nat.lt i d with
          | .true => .mk rc (.cons (.t (nthName' names i)) ras) rp rl st1
          | .false => .mk rc (.cons (.t "BOX(0)") ras) rp rl st1
        | _ => match rcE re st1 names d rl t with
          | .mk tc ta tl st2 => .mk (tc ⧺ rc) (.cons ta ras) (.t "dec(" ⧺ ta ⧺ .t "); " ⧺ rp) tl st2
      | .false => match rcE re st1 names d rl t with
        | .mk tc ta tl st2 => .mk (tc ⧺ rc) (.cons ta ras) rp tl st2
-- a head applied to arguments: the head first, then the arguments
def rcApply (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (h : ETm) (args : List ETm) : RR :=
  match rcList re st names d live args with
  | .mk ac atoms al st1 => match rcE re st1 names d al h with
    | .mk hc ha hl st2 => bindTo st2 (hc ⧺ ac) (callC ha atoms) hl
-- terms evaluated left to right (compiled right to left)
def rcList (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (ts : List ETm) : RRs := match ts with
  | .nil => .mk (.t "") .nil live st
  | .cons t rest => match rcList re st names d live rest with
    | .mk rc ras rl st1 => match rcE re st1 names d rl t with
      | .mk tc ta tl st2 => .mk (tc ⧺ rc) (.cons ta ras) tl st2
def rcEs (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (ts : ETms) : RRs := match ts with
  | .nil => .mk (.t "") .nil live st
  | .cons t rest => match rcEs re st names d live rest with
    | .mk rc ras rl st1 => match rcE re st1 names d rl t with
      | .mk tc ta tl st2 => .mk (tc ⧺ rc) (.cons ta ras) tl st2
def rcBranches (re : RE) (st : CG) (names : List String) (d : Nat) (live : List Nat) (bs : ETms) : RBs := match bs with
  | .nil => .mk .nil live st
  | .cons b rest => match rcBranches re st names d live rest with
    -- (each branch starts with no wish and keeps its own; the one from after the `case`
    -- is put back)
    | .mk rbs u st1 => match rcE re (CG.setPend st1 .idle) names d live b with
      | .mk bc ba bl st2 => .mk (.cons (.mk bc ba bl (CG.pend st2)) rbs) (lvUnion bl u) (CG.setPend st2 (CG.pend st1))
end

-- a whole program: every non-native global (the last of each name), erased; then the
-- code, a global of arity `k` as a C function `d_g` of `k` arguments (and `get_g()`
-- its curried closure), any other as a value built the first time it is used; then
-- `main` run on the world. The runtime is `#include`d.
inductive Erased where
  | mk (name : String) (e : ETm)
inductive EraseR where
  | ok (gs : List Erased)
  | err (msg : String)
partial def eraseGlobals (sl : Bool) (all : Array Global) (seen : List String) (acc : List Erased) : Nat → EraseR
  | .zero => .ok acc
  | .succ k => match Array.getD all k (.mk "?" .star .star .star .nil) with
    | .mk n ty v _ _ => match Bool.or (elemStr n seen) (isNative n) with
      | .true => eraseGlobals sl all seen acc k
      | .false => match v with
        | .axiomC _ _ => eraseGlobals sl all (.cons n seen) acc k
        | _ => match eraseCheck empty v (eval .nil ty) with
          | .err m => .err (n +++ ": " +++ m)
          | .ok e => eraseGlobals sl all (.cons n seen) (.cons (.mk n (lazyLets sl e)) acc) k
def arities : StrMap Nat → List Erased → StrMap Nat
  | ar, .nil => ar
  | ar, .cons (.mk n e) rest => arities (StrMap.insert ar (Str.ofString n) (lamsOf e)) rest
def paramNames (k : Nat) : Nat → List String
  | .zero => .nil
  | .succ i => .cons ("p" +++ Nat.toString i) (paramNames k i)
def paramDecls : Nat → Nat → String
  | _, .zero => ""
  | i, .succ m => match m with
    | .zero => "V p" +++ Nat.toString i
    | .succ _ => "V p" +++ Nat.toString i +++ ", " +++ paramDecls (i + 1) m
def argList : Nat → Nat → String
  | _, .zero => ""
  | i, .succ m => match m with
    | .zero => "a[" +++ Nat.toString i +++ "]"
    | .succ _ => "a[" +++ Nat.toString i +++ "], " +++ argList (i + 1) m
-- the code of each global: its prototypes and its definitions
inductive Code where
  | mk (protos defs : List Doc) (st : CG)
def genCode : CG → List Doc → List Doc → List Erased → Code
  | st, protos, defs, .nil => .mk protos defs st
  | st, protos, defs, .cons (.mk n e) rest =>
    let g := mangle n;
    let k := lamsOf e;
    match k with
    | .zero => match cgE st .nil e with
      | .mk code st1 =>
        genCode st1 (.cons (.t ("V get_" +++ g +++ "(void);")) protos)
          (.cons (.t ("static V g_" +++ g +++ "; static int i_" +++ g +++ "; V get_" +++ g +++
            "(void) { if (!i_" +++ g +++ ") { g_" +++ g +++ " = ") ⧺ code ⧺ .t ("; i_" +++ g +++ " = 1; } return g_" +++ g +++ "; }")) defs) rest
    | .succ _ =>
      -- the parameters: `p0` the first, so the innermost (index 0) is `p(k-1)`
      match cgE st (paramNames k k) (underLams k e) with
      | .mk code st1 =>
        let ps := paramDecls 0 k;
        genCode st1 (.cons (.t ("V d_" +++ g +++ "(" +++ ps +++ "); V get_" +++ g +++ "(void);")) protos)
          (.cons (.t ("V d_" +++ g +++ "(" +++ ps +++ ") { return ") ⧺ code ⧺ .t "; }") (.cons
            (.t ("static V w_" +++ g +++ "(V *a) { return d_" +++ g +++ "(" +++ argList 0 k +++ "); } " +++
             "V get_" +++ g +++ "(void) { static V c = 0; if (!c) c = native(w_" +++ g +++ ", " +++ Nat.toString k +++ "); return c; }")) defs)) rest
-- the program's C text, one `Doc` per line
def genProgram (gs : Globals) : List Doc := match gs with
  | .mk all _ _ => match eraseGlobals .false all .nil .nil (Array.size all) with
    | .err m => .cons (.t ("#error " +++ m)) .nil
    | .ok es => match genCode (.mk .nil 0 (arities StrMap.empty es) .idle) .nil .nil es with
      | .mk protos defs st => match st with
        | .mk fns _ _ _ =>
          .cons (.t "#include \"rt.c\"") (List.append protos
            (List.append (List.reverseOf fns .nil) (List.append defs
              (.cons (.t "int main(int argc, char **argv) { (void)argc; rt_start(argv); ap(get_main(), BOX(0)); return 0; }") .nil))))
-- **Applications pushed into `case`s** (reference counting mode). A match is a method
-- applied to the payload, and the method is chosen by a `case`: `(case s [bᵢ]) a⃗`
-- built a closure for the chosen branch and applied it. With cheap arguments
-- (variables, projections, `◾`), `case s [bᵢ a⃗]` is the same, and each `bᵢ a⃗` is
-- reduced by `betaE` (the arguments put in place): no closure at all.
mutual
def applyIn (b a : ETm) : ETm := match b with
  | .case s bs => .case s (applyInEs bs a)
  | .letE v body => .letE v (applyIn body (liftE 1 0 a))
  | _ => betaE b a
def applyInEs (bs : ETms) (a : ETm) : ETms := match bs with
  | .nil => .nil
  | .cons b rest => .cons (applyIn b a) (applyInEs rest a)
end
mutual
def pushE (t : ETm) : ETm := match t with
  | .app f a =>
    let f' := pushE f;
    let a' := pushE a;
    match f' with
    | .case s bs => match cheapE a' with
      | .true => .case s (applyInEs bs a')
      | .false => .app f' a'
    | _ => .app f' a'
  | .lam b => .lam (pushE b)
  | .letE v b => .letE (pushE v) (pushE b)
  | .obj k fs => .obj k (pushEs fs)
  | .proj i x => .proj i (pushE x)
  | .case s bs => .case (pushE s) (pushEs bs)
  | .prim op as => .prim op (pushEs as)
  | _ => t
def pushEs (ts : ETms) : ETms := match ts with
  | .nil => .nil
  | .cons t rest => .cons (pushE t) (pushEs rest)
end
def pushGlobals : List Erased → List Erased
  | .nil => .nil
  | .cons (.mk n e) rest => .cons (.mk n (pushE e)) (pushGlobals rest)

-- **Constructors inlined** (reference counting mode): a global whose body, under its
-- `λ`s, only builds an object from its parameters and constants (a constructor, as
-- `ETm.app`) is put in place where it is applied to all its arguments (the arguments
-- bound by `let`s, or put in place when cheap: `betaE`), so that the object is built
-- where reuse can see it.
mutual
def leafE : ETm → Bool
  | .var _ => .true
  | .erased => .true
  | .nat _ => .true
  | .obj _ fs => leafEs fs
  | _ => .false
def leafEs : ETms → Bool
  | .nil => .true
  | .cons t rest => match leafE t with
    | .true => leafEs rest
    | .false => .false
end
def isNulE : ETm → Bool
  | .obj k fs => match staticNul k fs with
    | .some _ => .true
    | .none => .false
  | _ => .false
def consMap : StrMap ETm → List Erased → StrMap ETm
  | m, .nil => m
  | m, .cons (.mk n e) rest => match lamsOf e with
    -- (a constant constructor: when it is a static object)
    | .zero => match isNulE e with
      | .true => consMap (StrMap.insert m (Str.ofString n) e) rest
      | .false => consMap m rest
    | .succ _ => match leafE (underLams (lamsOf e) e) with
      | .true => consMap (StrMap.insert m (Str.ofString n) e) rest
      | .false => consMap m rest
def eappsL : ETm → List ETm → ETm
  | f, .nil => f
  | f, .cons a rest => eappsL (.app f a) rest
def betaL : ETm → List ETm → ETm
  | f, .nil => f
  | f, .cons a rest => betaL (betaE f a) rest
-- a global standing alone: a static object put in place
def inlConst (t body : ETm) : ETm := match isNulE body with
  | .true => body
  | .false => t
-- `h args`, `h` a global and `body` its definition if it is put in place (else `◾`)
def inlApp (h : ETm) (args : List ETm) (body : ETm) : ETm :=
  let k := lamsOf body;
  match Nat.lt 0 k with
  | .true => match Nat.le k (lenL args) with
    | .true => eappsL (betaL body (takeL k args)) (dropL k args)
    | .false => eappsL h args
  | .false => eappsL h args
mutual
def inlE (m : StrMap ETm) (t : ETm) : ETm := match t with
  -- (a string literal stays one, for `rcE`)
  | .app f a => match stringConst t with
    | .some _ => t
    | .none => match spineE f (.cons a .nil) with
      | .mk h args =>
        let args2 := inlL m args;
        match h with
        | .glob g => inlApp h args2 (StrMap.findD m (Str.ofString g) .erased)
        | _ => eappsL (inlE m h) args2
  | .lam b => .lam (inlE m b)
  | .letE v b => .letE (inlE m v) (inlE m b)
  | .obj k fs => .obj k (inlEs m fs)
  | .proj i x => .proj i (inlE m x)
  | .case s bs => .case (inlE m s) (inlEs m bs)
  | .prim op as => .prim op (inlEs m as)
  | .glob g => inlConst t (StrMap.findD m (Str.ofString g) .erased)
  | _ => t
def inlEs (m : StrMap ETm) (ts : ETms) : ETms := match ts with
  | .nil => .nil
  | .cons t rest => .cons (inlE m t) (inlEs m rest)
def inlL (m : StrMap ETm) (ts : List ETm) : List ETm := match ts with
  | .nil => .nil
  | .cons t rest => .cons (inlE m t) (inlL m rest)
end
def inlGlobals (m : StrMap ETm) : List Erased → List Erased
  | .nil => .nil
  | .cons (.mk n e) rest => .cons (.mk n (inlE m e)) (inlGlobals m rest)

-- **Borrowed parameters** (as in Lean): a parameter of a global function that its body
-- only reads (projections, a `case`'s tag, borrowed arguments of direct calls) is
-- borrowed: the caller keeps it alive, the function neither `inc`s it for those reads
-- nor releases it. Found as a greatest fixed point: everything borrowed, then a
-- parameter the body consumes (passes to an owned position, returns, stores, captures)
-- made owned, until nothing changes.
-- does `t` build an object (not inside a `λ`)?
mutual
def buildsE : ETm → Bool
  | .obj _ fs => match fs with
    | .nil => .false
    | .cons _ _ => .true
  | .app f a => match buildsE f with
    | .true => .true
    | .false => buildsE a
  | .letE v b => match buildsE v with
    | .true => .true
    | .false => buildsE b
  | .proj _ t => buildsE t
  | .case s bs => match buildsE s with
    | .true => .true
    | .false => buildsEs bs
  | .prim _ as => buildsEs as
  | _ => .false
def buildsEs : ETms → Bool
  | .nil => .false
  | .cons t rest => match buildsE t with
    | .true => .true
    | .false => buildsEs rest
end
mutual
-- the variables (levels) `t` consumes, added to `acc`
def consumed (sigs : StrMap (List Bool)) (d : Nat) (t : ETm) (acc : List Nat) : List Nat := match t with
  | .var i => match Nat.lt i d with
    | .true => lvIns (d - 1 - i) acc
    | .false => acc
  | .app f a => match spineE f (.cons a .nil) with
    | .mk h args => match h with
      | .glob g =>
        let sig := StrMap.findD sigs (Str.ofString g) .nil;
        match Nat.le (lenL sig) (lenL args) with
        | .true => consumedArgs sigs d sig args acc
        | .false => consumedArgs sigs d .nil args acc
      | _ => consumedArgs sigs d .nil args (consumed sigs d h acc)
  | .proj _ _ => match projRoot t with
    | .var _ => acc
    | root => consumed sigs d root acc
  -- (a variable matched on where a branch builds an object is owned: its cell may be
  -- reused, as Lean's borrow inference counts a `reset`)
  | .case s bs => consumedEs sigs d bs (match projRoot s with
    | .var j => match Bool.and (Nat.lt j d) (buildsEs bs) with
      | .true => lvIns (d - 1 - j) acc
      | .false => acc
    | _ => consumed sigs d s acc)
  | .letE v b => consumed sigs (d + 1) b (consumed sigs d v acc)
  | .lam _ => capLevels d (freeE t .nil) acc
  | .obj _ fs => consumedEs sigs d fs acc
  | .prim _ as => consumedEs sigs d as acc
  | _ => acc
def consumedArgs (sigs : StrMap (List Bool)) (d : Nat) (sig : List Bool) (ts : List ETm) (acc : List Nat) : List Nat := match ts with
  | .nil => acc
  | .cons t rest => match headB sig with
    | .true => match t with
      | .var _ => consumedArgs sigs d (tailB sig) rest acc
      | _ => consumedArgs sigs d (tailB sig) rest (consumed sigs d t acc)
    | .false => consumedArgs sigs d (tailB sig) rest (consumed sigs d t acc)
def consumedEs (sigs : StrMap (List Bool)) (d : Nat) (ts : ETms) (acc : List Nat) : List Nat := match ts with
  | .nil => acc
  | .cons t rest => consumedEs sigs d rest (consumed sigs d t acc)
def capLevels (d : Nat) (cs : List Nat) (acc : List Nat) : List Nat := match cs with
  | .nil => acc
  | .cons c rest => match Nat.lt c d with
    | .true => capLevels d rest (lvIns (d - 1 - c) acc)
    | .false => capLevels d rest acc
end
-- parameters `i … k-1` (level `i` is parameter `i`): borrowed unless consumed
def borSig (used : List Nat) : Nat → Nat → List Bool
  | _, .zero => .nil
  | i, .succ m => .cons (Bool.not (lvMem i used)) (borSig used (i + 1) m)
def allTrue : Nat → List Bool
  | .zero => .nil
  | .succ m => .cons .true (allTrue m)
def allFalse : Nat → List Bool
  | .zero => .nil
  | .succ m => .cons .false (allFalse m)
def countTrue : List Bool → Nat
  | .nil => 0
  | .cons b rest => match b with
    | .true => countTrue rest + 1
    | .false => countTrue rest
inductive SigR where
  | mk (sigs : StrMap (List Bool)) (borrowed : Nat)
def sigsInit : StrMap (List Bool) → List Erased → StrMap (List Bool)
  | m, .nil => m
  | m, .cons (.mk n e) rest => sigsInit (StrMap.insert m (Str.ofString n) (allTrue (lamsOf e))) rest
-- **Tail calls kept** (as Lean's `preserveTailCall`): a function calling itself in tail
-- position with a borrowed parameter given something it would release after the call
-- (a variable it owns, or a temporary) makes that parameter owned, so that nothing
-- follows the call. `sig`: the function's signature from this round's `consumed` (not
-- the previous round's, which would make the fixed point oscillate); `k` its arity;
-- the result: the positions to make owned.
def nthB : List Bool → Nat → Bool
  | .nil, _ => .false
  | .cons b rest, n => match n with
    | .zero => b
    | .succ m => nthB rest m
-- the borrowed positions given anything but one of the function's borrowed parameters
def tailArgPos (sig : List Bool) (k d : Nat) : Nat → List ETm → List Nat → List Nat
  | _, .nil, acc => acc
  | i, .cons a rest, acc => tailArgPos sig k d (i + 1) rest (match nthB sig i with
    | .true => match a with
      | .var j => match Bool.and (Nat.lt j d) (Nat.lt (d - 1 - j) k) with
        | .true => match nthB sig (d - 1 - j) with
          | .true => acc
          | .false => lvIns i acc
        | .false => lvIns i acc
      | _ => lvIns i acc
    | .false => acc)
mutual
def tailOwned (sig : List Bool) (f : String) (k : Nat) : Nat → ETm → List Nat → List Nat
  | d, .letE _ b, acc => tailOwned sig f k (d + 1) b acc
  | d, .case _ bs, acc => tailOwnedEs sig f k d bs acc
  | d, .app g0 a0, acc => match spineE (.app g0 a0) .nil with
    | .mk h args => match h with
      | .glob g => match Bool.and (strEq g f) (Nat.beq (lenL args) k) with
        | .true => tailArgPos sig k d 0 args acc
        | .false => acc
      | _ => acc
  | _, _, acc => acc
def tailOwnedEs (sig : List Bool) (f : String) (k : Nat) : Nat → ETms → List Nat → List Nat
  | _, .nil, acc => acc
  | d, .cons t rest, acc => tailOwnedEs sig f k d rest (tailOwned sig f k d t acc)
end
-- `sig` with the positions in `ps` owned
def ownAt : List Bool → Nat → List Nat → List Bool
  | .nil, _, _ => .nil
  | .cons b rest, i, ps => .cons (match lvMem i ps with
      | .true => .false
      | .false => b) (ownAt rest (i + 1) ps)
-- one round: every function's parameters, from the current signatures
def sigsRound (old : StrMap (List Bool)) : StrMap (List Bool) → Nat → List Erased → SigR
  | m, c, .nil => .mk m c
  | m, c, .cons (.mk n e) rest =>
    let k := lamsOf e;
    let sig0 := borSig (consumed old k (underLams k e) .nil) 0 k;
    let sig := ownAt sig0 0 (tailOwned sig0 n k k (underLams k e) .nil);
    sigsRound old (StrMap.insert m (Str.ofString n) sig) (c + countTrue sig) rest
partial def sigsFix (sigs : StrMap (List Bool)) (count : Nat) (es : List Erased) : StrMap (List Bool) :=
  match sigsRound sigs sigs 0 es with
  | .mk s2 c2 => match Nat.beq c2 count with
    | .true => s2
    | .false => sigsFix s2 c2 es
-- the levels of the borrowed parameters, and the indices of the owned ones (as names
-- index them: parameter `i` of `k` is index `k-1-i`)
def borLevels : Nat → List Bool → List Nat
  | _, .nil => .nil
  | i, .cons b rest => match b with
    | .true => lvIns i (borLevels (i + 1) rest)
    | .false => borLevels (i + 1) rest
def ownedIdx (k : Nat) : Nat → List Bool → List Nat
  | _, .nil => .nil
  | i, .cons b rest => match b with
    | .true => ownedIdx k (i + 1) rest
    | .false => .cons (k - 1 - i) (ownedIdx k (i + 1) rest)
-- the wrapper releases the borrowed arguments after the call
def wrapDecs : Nat → List Bool → String
  | _, .nil => ""
  | i, .cons b rest => match b with
    | .true => "dec(a[" +++ Nat.toString i +++ "]); " +++ wrapDecs (i + 1) rest
    | .false => wrapDecs (i + 1) rest

-- the same under reference counting: a constant global is built by `init_g` and kept
-- (a root, released at exit); `get_g()` returns a new reference
def genCodeRC (sigs : StrMap (List Bool)) : CG → List Doc → List Doc → List Erased → Code
  | st, protos, defs, .nil => .mk protos defs st
  | st, protos, defs, .cons (.mk n e) rest =>
    let g := mangle n;
    let k := lamsOf e;
    match k with
    | .zero => match rcE (.mk .nil sigs .nil) st .nil 0 .nil e with
      | .mk code atom _ st1 =>
        genCodeRC sigs st1 (.cons (.t ("V get_" +++ g +++ "(void);")) protos)
          (.cons (.t ("static V g_" +++ g +++ "; static int i_" +++ g +++ "; static V init_" +++ g +++ "(void) { ") ⧺ code ⧺
            .t "return " ⧺ atom ⧺ .t ("; } V get_" +++ g +++ "(void) { if (!i_" +++ g +++ ") { g_" +++ g +++ " = init_" +++ g +++
            "(); i_" +++ g +++ " = 1; rt_root(&g_" +++ g +++ "); } inc(g_" +++ g +++ "); return g_" +++ g +++ "; }")) defs) rest
    | .succ _ =>
      let names := paramNames k k;
      -- (no signature: every parameter owned)
      let sig := match StrMap.findD sigs (Str.ofString n) .nil with
        | .nil => allFalse k
        | sg => sg;
      match rcE (.mk (borLevels 0 sig) sigs .nil) st names k .nil (underLams k e) with
      | .mk code atom live st1 =>
        let ps := paramDecls 0 k;
        genCodeRC sigs st1 (.cons (.t ("V d_" +++ g +++ "(" +++ ps +++ "); V get_" +++ g +++ "(void);")) protos)
          (.cons (.t ("V d_" +++ g +++ "(" +++ ps +++ ") { ") ⧺ entryDrops names k live (ownedIdx k 0 sig) ⧺ code ⧺ .t "return " ⧺ atom ⧺ .t "; }") (.cons
            (.t ("static V w_" +++ g +++ "(V *a) { V r = d_" +++ g +++ "(" +++ argList 0 k +++ "); " +++ wrapDecs 0 sig +++ "return r; } " +++
             "V get_" +++ g +++ "(void) { static V c = 0; if (!c) { c = native(w_" +++ g +++ ", " +++ Nat.toString k +++
             "); rt_root(&c); } inc(c); return c; }")) defs)) rest
def genProgramRC (borrow : Bool) (gs : Globals) : List Doc := match gs with
  | .mk all _ _ => match eraseGlobals .true all .nil .nil (Array.size all) with
    | .err m => .cons (.t ("#error " +++ m)) .nil
    | .ok es0 =>
      let es1 := pushGlobals es0;
      let es := inlGlobals (consMap StrMap.empty es1) es1;
      let sigs : StrMap (List Bool) := match borrow with
        | .true => sigsFix (sigsInit StrMap.empty es) 0 es
        | .false => StrMap.empty;
      match genCodeRC sigs (.mk .nil 0 (arities StrMap.empty es) .idle) .nil .nil es with
      | .mk protos defs st => match st with
        | .mk fns _ _ _ =>
          .cons (.t "#define WIZ_RC 1") (.cons (.t "#include \"rt.c\"") (List.append protos
            (List.append (List.reverseOf fns .nil) (List.append defs
              (.cons (.t "int main(int argc, char **argv) { (void)argc; rt_start(argv); dec(ap(get_main(), BOX(0))); rt_finish(); return 0; }") .nil)))))

-- The backend a program asks for: reference counting if its first line is `-- wiz: rc`,
-- else the garbage collector. (A command-line flag, once programs can read their
-- arguments.)
def charsPrefix : List Char → List Char → Bool
  | .nil, _ => .true
  | .cons c cs, ys => match ys with
    | .nil => .false
    | .cons y rest => match Nat.beq (Char.code c) (Char.code y) with
      | .true => charsPrefix cs rest
      | .false => .false
def wantsRC (text : String) : Bool := match text with
  | .mk cs => match "-- wiz: rc" with
    | .mk ps => charsPrefix ps cs
-- (`-- wiz: rc-owned`: every parameter owned, no borrowing; for comparisons)
def genProgramFor (text : String) (gs : Globals) : List Doc := match wantsRC text with
  | .true => genProgramRC (match text with
    | .mk cs => match "-- wiz: rc-owned" with
      | .mk ps => Bool.not (charsPrefix ps cs)) gs
  | .false => genProgram gs
-- (stage 21k) the backend the command line asks for: `--rc` (reference counting),
-- `--rc-owned` (every parameter owned, no borrowing) or `--gc`; without one, the first
-- line's pragma (`genProgramFor`, kept as a fallback for one release)
def genProgramArgs (args : List String) (text : String) (gs : Globals) : List Doc := match elemStr "--rc-owned" args with
  | .true => genProgramRC .false gs
  | .false => match elemStr "--rc" args with
    | .true => genProgramRC .true gs
    | .false => match elemStr "--gc" args with
      | .true => genProgram gs
      | .false => genProgramFor text gs

-- printing a program: each line's pieces, then a newline
def printDoc : Doc → IO Unit
  | .t s => IO.print s
  | .c a b => do
    printDoc a;
    printDoc b
def printDocs : List Doc → IO Unit
  | .nil => IO.pure ()
  | .cons d rest => do
    printDoc d;
    IO.println "";
    printDocs rest
