import Wiz.Selfhost

/-!
# The playground's parser tables (stage 11ab)

`web/build-playground.sh` feeds `selfhost/*.wiz` to the `wiz` compiler. The self-hosted
frontend's parser needs the tables of the Lean parser (`Wiz.Parser.Builtin.tables`),
which only Lean can make, so `web/selfhost-tables.wiz` is checked in and this script
regenerates it when the grammar changes:

    lake build Wiz.Selfhost            # or `lake build wiz tests`
    lake env lean --run web/gen-selfhost-tables.lean

The tables are 38 KB; keeping them in the tree means the playground needs no Lean step
beyond the `lake build wiz` that every checkout already needs.
-/

open Wiz

def main : IO Unit := do
  IO.FS.writeFile "web/selfhost-tables.wiz"
    ("-- Generated by `lake env lean --run web/gen-selfhost-tables.lean`; do not edit.\n" ++
     Wiz.Selfhost.tablesSource)
