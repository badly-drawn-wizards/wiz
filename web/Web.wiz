import IO
import Infoview
-- The infoview in a browser (stage 11n): this program, compiled to C and then to
-- WebAssembly (`web/build.sh`), is the page's language client. It is a library
-- (stage 9g): `web/infoview.js` makes the state with `wiz_web_init` and hands every
-- event (text from the server, edits, cursor moves, clicks) to `wiz_web_step`, which
-- answers with `js_send` (bytes to the server) and `js_set_html` (a part of the page)
-- and returns the next state (a Wiz value the page holds). The protocol and the HTML
-- are `lib/Infoview.wiz`, shared with the terminal infoview.
-- (11s) The same module runs the documentation's pages (`wiz doc`): `wiz_doc_init` and
-- `wiz_doc_step` (web/scroll.js), whose model is `DocPage` in `lib/Tagged.wiz`, the
-- tagged text both kinds of page share.

-- (9f) the JavaScript side, as Emscripten C (EM_JS)
link_c "js.c"
extern "js_send" Js.send : String → IO Unit
extern "js_set_html" Js.setHtml : String → String → IO Unit
extern "js_go" Js.go : String → IO Unit

structure WSt where
  buf : List Char
  next : Nat
  pending : List (Nat × Nat)
  uri : String
  line : Nat
  col : Nat
  session : Nat
  version : Nat
  goals : Option TacView
  term : Option Goal
  sel : Nat
  -- (11w) what else is at the cursor (`wiz/interactiveInfo`)
  items : List InfoItem

def WSt.empty : WSt := WSt.mk .nil 1 .nil "" 0 0 0 0 .none .none 0 .nil
def WSt.setConn (s : WSt) (buf : List Char) (next : Nat) (pending : List (Nat × Nat)) : WSt :=
  WSt.mk buf next pending s.uri s.line s.col s.session s.version s.goals s.term s.sel s.items
def WSt.setDoc (s : WSt) (uri : String) (line col version : Nat) : WSt :=
  WSt.mk s.buf s.next s.pending uri line col s.session version s.goals s.term s.sel s.items
def WSt.setGoals (s : WSt) (goals : Option TacView) (session : Nat) : WSt :=
  WSt.mk s.buf s.next s.pending s.uri s.line s.col session s.version goals s.term 0 s.items
def WSt.setTerm (s : WSt) (term : Option Goal) : WSt :=
  WSt.mk s.buf s.next s.pending s.uri s.line s.col s.session s.version s.goals term 0 s.items
def WSt.setSel (s : WSt) (sel : Nat) : WSt :=
  WSt.mk s.buf s.next s.pending s.uri s.line s.col s.session s.version s.goals s.term sel s.items

def WSt.setItems (s : WSt) (items : List InfoItem) : WSt :=
  WSt.mk s.buf s.next s.pending s.uri s.line s.col s.session s.version s.goals s.term 0 items
def WSt.view (s : WSt) : View := View.ofInfo 80 s.goals s.term s.items

def WSt.render (s : WSt) : IO Unit := Js.setHtml "goals" (Infoview.htmlInfo s.sel s.goals s.term s.items)

def WSt.send (s : WSt) (method : String) (params : Json) (kind : Nat) : IO WSt := do
  Js.send (Rpc.frame (Rpc.request s.next method params));
  IO.pure (WSt.setConn s s.buf (s.next + 1) (.cons (s.next, kind) s.pending))
def WSt.notify (method : String) (params : Json) : IO Unit :=
  Js.send (Rpc.frame (Json.render (Json.mkObj (.cons (Json.field "jsonrpc" (Json.mkStr "2.0"))
    (.cons (Json.field "method" (Json.mkStr method)) (.cons (Json.field "params" params) .nil))))))
def WSt.refresh (s : WSt) : IO WSt := do
  s1 ← WSt.send s "wiz/interactiveGoals" (Rpc.position s.uri s.line s.col) 1;
  s2 ← WSt.send s1 "wiz/interactiveTermGoal" (Rpc.position s.uri s.line s.col) 2;
  WSt.send s2 "wiz/interactiveInfo" (Rpc.position s.uri s.line s.col) 4

def Web.lookup : List (Nat × Nat) → Nat → Nat
  | .nil, _ => 0
  | .cons p ps, id => match Nat.beq p.1 id with
    | .true => p.2
    | .false => Web.lookup ps id
def Web.remove : List (Nat × Nat) → Nat → List (Nat × Nat)
  | .nil, _ => .nil
  | .cons p ps, id => match Nat.beq p.1 id with
    | .true => ps
    | .false => .cons p (Web.remove ps id)

def WSt.onResponse (s : WSt) (j : Json) : IO WSt :=
  let id := Json.getNat j "id";
  let kind := Web.lookup s.pending id;
  let s1 := WSt.setConn s s.buf s.next (Web.remove s.pending id);
  match Json.get j "error" with
  | .some e => match Rpc.contentModified e with
    | .true => WSt.refresh s1
    | .false => do
      Js.setHtml "status" (String.mk (Tagged.htmlText (Json.getStr e "message") .nil));
      IO.pure s1
  | .none =>
    let r : Json := match Json.get j "result" with
      | .some v => v
      | .none => .null;
    match Nat.beq kind 1 with
    | .true => match Json.isNull r with
      | .true => IO.pure (WSt.setGoals s1 .none s1.session)
      | .false => IO.pure (WSt.setGoals s1 (.some (TacView.ofJson r)) (Json.getNat r "session"))
    | .false => match Nat.beq kind 2 with
      | .true => match Json.get r "goal" with
        | .some g => IO.pure (WSt.setTerm s1 (.some (Goal.ofJson g)))
        | .none => IO.pure (WSt.setTerm s1 .none)
      | .false => match Nat.beq kind 3 with
        | .true => do
          Js.setHtml "info" (Tagged.infoHtml r);
          IO.pure s1
        | .false => match Nat.beq kind 4 with
          | .true => IO.pure (WSt.setItems s1 (Items.ofJson r))
          | .false => IO.pure s1

def WSt.onMessage (s : WSt) (j : Json) : IO WSt := match Json.get j "method" with
  | .some (.str m) => match String.eq m "wiz/elaborated" with
    | .true => WSt.refresh s
    | .false => IO.pure s
  | _ => match Json.get j "id" with
    | .some _ => WSt.onResponse s j
    | .none => IO.pure s

partial def WSt.drain (s : WSt) : IO WSt := match Rpc.unframe s.buf with
  | .none => IO.pure s
  | .some m =>
    let s1 := WSt.setConn s m.2 s.next s.pending;
    match Json.parse m.1 with
    | .error _ => WSt.drain s1
    | .ok j => do
      s2 ← WSt.onMessage s1 j;
      WSt.drain s2

-- select a tag (index + 1) and ask what it is
def WSt.select (s : WSt) (sel : Nat) : IO WSt :=
  let s1 := WSt.setSel s sel;
  match Tagged.nthTag (View.tags (WSt.view s)) (sel - 1) with
  | .none => do Js.setHtml "info" ""; IO.pure s1
  | .some t => WSt.send s1 "wiz/subtermInfo" (Json.mkObj (.cons (Json.field "textDocument" (Json.mkObj (.cons (Json.field "uri" (Json.mkStr s.uri)) .nil)))
      (.cons (Json.field "session" (Json.ofNat s.session)) (.cons (Json.field "ref" (Json.ofNat (TagInfo.ref t))) .nil)))) 3

-- an event: its kind (the first line) and the rest
def Web.splitLine : List Char → List Char → String × List Char
  | .nil, acc => (String.mk (Json.revOnto acc .nil), List.nil)
  | .cons c cs, acc => match Nat.beq (Char.code c) 10 with
    | .true => (String.mk (Json.revOnto acc .nil), cs)
    | .false => Web.splitLine cs (.cons c acc)
def Web.nat (cs : List Char) : Nat := (Json.digits cs 0 0 .nil).1
def Web.textDoc (s : WSt) (text : List Char) : Json :=
  Json.mkObj (.cons (Json.field "uri" (Json.mkStr s.uri)) (.cons (Json.field "languageId" (Json.mkStr "wiz")) (.cons (Json.field "version" (Json.ofNat s.version))
    (.cons (Json.field "text" (Json.mkStr (.mk text))) .nil))))

def WSt.onEvent (s : WSt) (ev : String) : IO WSt :=
  let p := Web.splitLine (String.chars ev) .nil;
  let kind := p.1;
  let rest := p.2;
  match String.eq kind "net" with
  | .true => WSt.drain (WSt.setConn s (List.append s.buf rest) s.next s.pending)
  | .false => match String.eq kind "open" with
    -- `open\nURI\nTEXT`: initialize, open the document
    | .true => do
      let q := Web.splitLine rest .nil;
      let s1 := WSt.setDoc s q.1 s.line s.col 1;
      s2 ← WSt.send s1 "initialize" (Json.mkObj (.cons (Json.field "processId" Json.mkNull) (.cons (Json.field "capabilities"
        (Json.mkObj (.cons (Json.field "experimental" (Json.mkObj (.cons (Json.field "wizElaborated" (Json.mkBool .true)) .nil))) .nil))) .nil))) 0;
      WSt.notify "initialized" (Json.mkObj .nil);
      WSt.notify "textDocument/didOpen" (Json.mkObj (.cons (Json.field "textDocument" (Web.textDoc s1 q.2)) .nil));
      WSt.refresh s2
    | .false => match String.eq kind "follow" with
    -- (11w) `follow\nURI`: show another editor's document (the page follows its cursor,
    -- `wiz/infoview/cursor`, which the page turns into `follow` and `cursor`)
    | .true => IO.pure (WSt.setDoc s (String.mk rest) s.line s.col s.version)
    | .false => match String.eq kind "change" with
      | .true => do
        let s1 := WSt.setDoc s s.uri s.line s.col (s.version + 1);
        WSt.notify "textDocument/didChange" (Json.mkObj (.cons (Json.field "textDocument" (Json.mkObj (.cons (Json.field "uri" (Json.mkStr s.uri))
          (.cons (Json.field "version" (Json.ofNat s1.version)) .nil)))) (.cons (Json.field "contentChanges"
            (Json.mkArr (.cons (Json.mkObj (.cons (Json.field "text" (Json.mkStr (.mk rest))) .nil)) .nil))) .nil)));
        WSt.refresh s1
      | .false => match String.eq kind "cursor" with
        -- `cursor\nLINE COL`, 0-based
        | .true =>
          let l := Json.digits rest 0 0 .nil;
          WSt.refresh (WSt.setDoc s s.uri l.1 (Web.nat (Json.drop1 l.2.2.2)) s.version)
        | .false => match String.eq kind "click" with
          -- `click\nIDX`: the tag with that `data-idx`
          | .true => WSt.select s (Web.nat rest + 1)
          | .false => match String.eq kind "key" with
            | .true =>
              let v := WSt.view s;
              let key := String.mk rest;
              let nav : Nav := match String.eq key "ArrowRight" with
                | .true => Nav.next
                | .false => match String.eq key "ArrowLeft" with
                  | .true => Nav.prev
                  | .false => match String.eq key "ArrowUp" with
                    | .true => Nav.out
                    | .false => match String.eq key "ArrowDown" with
                      | .true => Nav.into
                      | .false => Nav.clear;
              WSt.select s (View.navigate v s.sel nav)
            | .false => IO.pure s

-- One step: State → Event → State, the actions (messages, HTML) done in IO.
def Web.step (s : WSt) (ev : String) : IO WSt := do
  s1 ← WSt.onEvent s ev;
  WSt.render s1;
  IO.pure s1

export "wiz_web_init" WSt.empty
export "wiz_web_step" Web.step

-- (11s) A documentation page: its events (`DocPage.step`), the page's actions done here.
def Doc.act : List DocAct → IO Unit
  | .nil => IO.pure ()
  | .cons a rest => do
    (match a with
      | .html id h => Js.setHtml id h
      | .info h => Js.setHtml "info" h
      | .go u => Js.go u);
    Doc.act rest
def Doc.step (s : DocSt) (ev : String) : IO DocSt :=
  let r := DocPage.step s ev;
  do
    Doc.act r.2;
    IO.pure r.1

export "wiz_doc_init" DocSt.empty
export "wiz_doc_step" Doc.step
