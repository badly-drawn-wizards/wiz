import Prelude
import Word
#print axioms castRefl
def r (A : Type) (e : A = A) (a : A) : (cast e a : A) = a := castRefl e a
#print axioms r
def slow (n : Nat) : Nat := n + 0
def fast (n : Nat) : Nat := n
attribute [implemented_by fast] slow
def use (n : Nat) : Nat := slow n
#print axioms use
#print axioms fast
def w : UIntN 8 := UIntN.add (UIntN.ofNat 8 3) (UIntN.ofNat 8 4)
#print axioms w
def idW (x : UIntN 8) : UIntN 8 := x
#print axioms idW
#print axioms UIntN.add
def t : 2 + 2 = 4 := refl 4
#print axioms t
